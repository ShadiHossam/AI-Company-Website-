---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";

const faqItems = [
  {
    question: "Is it safe to use AI with candidate data?",
    answer: "It can be, but only with clear rules in place. Candidate CVs and personal details shouldn't be pasted into a public AI tool without checking that tool's data handling policy first. The safer pattern is using AI for tasks that don't require exposing full personal details, like drafting a generic screening rubric, or using an enterprise-grade tool with appropriate data agreements when personal information is genuinely involved. This course covers exactly where that line sits.",
  },
  {
    question: "Does this cover UAE labor law compliance tools?",
    answer: "This course teaches general AI skills applicable to HR work, not UAE labor law itself, and it shouldn't replace legal or compliance advice. What it does cover is drafting policies and communications in a way that flags where you likely need a compliance or legal review before something goes out, which is a genuinely useful habit regardless of jurisdiction.",
  },
  {
    question: "Is there a good free HR AI course?",
    answer: "General AI tutorials exist for free and cover the basics of drafting and summarizing. What's harder to find for free is guidance specific to HR's particular risks, like candidate data handling and bias in AI-assisted screening. Those risks are exactly where a generic free course tends to stay silent, which is the gap this page is built to cover.",
  },
  {
    question: "Can this replace our applicant tracking system?",
    answer: "No, and it's not meant to. This is a skills course, not a software product. It teaches you to use AI tools well alongside whatever ATS or HR software your company already runs, not to replace it.",
  },
  {
    question: "Does this cover bilingual job postings for the UAE market?",
    answer: "Yes. Drafting job postings and candidate communications that read naturally in both English and Arabic, rather than one being an obvious machine translation of the other, is a specific skill covered in this course given how common bilingual hiring is across the UAE.",
  },
];

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const courseLdJson = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: "AI Course for HR Professionals",
  description: "An AI course for HR professionals covering CV screening support, job description drafting, interview question generation, policy drafting, and candidate data safety.",
  provider: { '@type': 'Organization', name: 'Lenoo AI', sameAs: 'https://lenooai.com' },
  url: 'https://lenooai.com/services/ai-courses/hr',
};

const breadcrumbLdJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lenooai.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://lenooai.com/services' },
    { '@type': 'ListItem', position: 3, name: 'AI Courses', item: 'https://lenooai.com/services/ai-courses' },
    { '@type': 'ListItem', position: 4, name: 'AI Course for HR', item: 'https://lenooai.com/services/ai-courses/hr' },
  ],
};

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<BaseLayout
  title="AI Course for HR Professionals | Lenoo AI"
  description="An AI course built for HR: CV screening support, job description drafting, interview question generation, policy drafting, and safe candidate data handling."
  canonicalPath="/services/ai-courses/hr"
  ldJson={[faqLdJson, courseLdJson, breadcrumbLdJson]}
>

<!-- ── HERO ── -->
<header class="hero-section" style="padding-top: 10rem; padding-bottom: 5rem; text-align: center;">
  <div class="container" style="position: relative; z-index: 1;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services" style="color:inherit;text-decoration:none;opacity:0.65;">Services</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-courses" style="color:inherit;text-decoration:none;opacity:0.65;">AI Courses</a><span style="opacity:0.4;padding:0 4px;"> / </span>AI Course for HR</div>
    <h1 style="max-width: 46rem; margin: 0 auto 1.5rem;">
      AI Course for <span class="gradient-text">HR Professionals</span>
    </h1>
    <p style="color: rgba(255,255,255,0.72); font-size: 1.125rem; line-height: 1.75; max-width: 40rem; margin: 0 auto 0;">
      HR sits closer to sensitive personal data than almost any other function, which makes generic AI advice risky to follow blindly. This page covers what an AI course for HR should actually teach: where AI genuinely saves time on hiring volume and policy drafting, and where candidate data and compliance mean a human needs to stay firmly in charge.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">Built around candidate data safety</span>
      <span class="tchip">Covers bilingual EN/AR hiring content</span>
      <span class="tchip">No coding required</span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      <button onclick="openModal(this)" data-source="courses_hr_hero" class="btn-primary" style="font-size: 1rem;">Request Training Quote →</button>
      <a href="#curriculum" class="btn-outline" style="font-size: 1rem;">See the Curriculum ↓</a>
    </div>
  </div>
</header>

<!-- ── WHY THIS MATTERS ── -->
<section class="section" aria-labelledby="why-heading">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="why-heading">Why HR Needs AI Skills, and Why the Usual Advice Falls Short</h2>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      HR teams across the UAE handle hiring volumes that have grown faster than headcount in most companies. A single open role can pull in hundreds of applications, and screening them properly, not just skimming for keywords, takes real time that most HR teams don't have to spare. AI genuinely helps here, but most general AI courses don't address the specific risk HR carries: candidate personal data.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      That risk is why a generic "how to use ChatGPT" course isn't quite enough for this role. Pasting a candidate's full CV, including their name, contact details, and employment history, into a consumer AI tool without checking its data policy is a real exposure, not a hypothetical one. This course treats that risk directly instead of glossing over it.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      Beyond screening, HR also produces a steady stream of written material: job descriptions, offer letters, policy documents, internal announcements, and staff-facing FAQs. Nearly all of it benefits from AI-assisted drafting once you know how to do it without introducing new risk, and that volume of writing is exactly where the time savings add up fastest.
    </p>
  </div>
</section>

<!-- ── CURRICULUM ── -->
<section id="curriculum" class="section" style="background: #e7eeff;" aria-labelledby="curriculum-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">What You'll Learn</p>
      <h2 id="curriculum-heading">Core Curriculum</h2>
    </div>
    <div class="path-grid">
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">CV Screening Support</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Using AI to screen against clearly defined criteria with reviewable reasoning, so you can check why a candidate was flagged rather than trusting a black-box decision. Covers what to input safely and what to keep out of any AI tool entirely.</p>
      </div>
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">Job Description Drafting</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Writing job descriptions matched to UAE market tone and expectations, in English and Arabic, that attract the right candidates without the generic, overly corporate phrasing AI tends to default to.</p>
      </div>
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">Interview Question Generation</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Building structured interview question sets tailored to a specific role, so panels ask consistent, relevant questions instead of improvising differently with each candidate.</p>
      </div>
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">Internal Announcement Drafting</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Drafting internal communications, from onboarding welcomes to policy change announcements, in a tone that fits your company rather than a generic corporate voice.</p>
      </div>
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">Onboarding Document Drafting</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Producing first drafts of onboarding packets, role guides, and checklists faster, then editing for accuracy rather than writing each one from a blank page.</p>
      </div>
      <div class="value-card path-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem; color:#00253b;">Policy and FAQ Drafting</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Drafting internal policy documents and staff-facing FAQs about AI use itself, since HR is often the team fielding questions about what's allowed once a company starts adopting AI tools more broadly.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── DATA PRIVACY TRUST NOTE ── -->
<section class="section" aria-labelledby="privacy-heading">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2 id="privacy-heading">Candidate Data: What's Actually Safe</h2>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      The course draws a clear line, and it's simpler than most HR professionals expect. Tasks that don't require exposing a specific candidate's personal details, drafting a generic screening rubric, writing a job description, generating interview questions for a role, are low risk in almost any AI tool.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Tasks that do involve specific candidate data, screening an actual CV, summarizing a specific applicant's background, require more care: checking the tool's data retention policy, using an enterprise-grade product with appropriate agreements rather than a free consumer tool, and, where possible, working with anonymized or redacted information first.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      This isn't a legal compliance course, and it doesn't replace your company's own data protection policy or legal advice. It gives you a working sense of where the real risk sits, so you know when to slow down and check with your compliance or legal team before proceeding.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      A simple test to apply before pasting anything into an AI tool: would you be comfortable if the candidate knew exactly what you typed and where it went? If the honest answer is no, that's a sign to redact the details, use a different tool, or handle that specific step manually instead.
    </p>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;max-width:640px;margin-left:auto;margin-right:auto;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">Covered by our 100% refund guarantee</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">Ready to bring AI to your HR team, safely?</p>
      <button onclick="openModal(this)" data-source="courses_hr_mid" class="btn-primary">Request Training Quote →</button>
    </div>
  </div>
</section>

<!-- ── BIAS AND FAIRNESS ── -->
<section class="section" aria-labelledby="bias-heading">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2 id="bias-heading">Bias and Fairness in AI-Assisted Screening</h2>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      AI tools can reflect the same biases present in the data they were trained on, and screening is exactly the kind of decision where that risk matters most. This course covers practical habits for catching it: reviewing a sample of AI-flagged and AI-rejected candidates side by side to check for patterns that don't relate to job qualifications, and never letting an AI recommendation be the sole basis for a rejection without a human review.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      A useful habit is keeping AI in an advisory role rather than a decision-making one throughout the hiring process. Let it help you screen faster, surface details you might otherwise miss in a large applicant pool, and draft consistent questions. Keep the actual judgment call, whether to advance a candidate, with a person who can weigh context an AI tool can't see.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      This matters practically, not just ethically. A hiring process that can't explain why a candidate was screened out creates real legal and reputational exposure. Being able to say clearly what criteria were used, and that a human reviewed the outcome, protects your company as much as it protects candidates.
    </p>
  </div>
</section>

<!-- ── FOR SMALL HR TEAMS ── -->
<section class="section" style="background: #f0f3ff;" aria-labelledby="small-teams-heading">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2 id="small-teams-heading">For Solo HR Professionals and Small Teams</h2>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      A lot of "AI course for HR" searches come from people who are the entire HR function at a smaller company, not part of a large department. If that's you, the time pressure this course addresses is even more acute: you're likely handling recruitment, onboarding, policy, and staff questions with no one to delegate to.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      The good news is that a solo HR professional often sees the time savings from this course faster than a large team does, simply because every hour saved on drafting is an hour you didn't have to begin with. The curriculum above applies the same way regardless of team size, though a solo practitioner should weigh the data-safety guidance in this course even more carefully, since there's no second reviewer catching a mistake before it happens.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      If you're managing HR alone alongside other responsibilities, which is common at smaller UAE businesses, prioritize the curriculum modules that touch your highest-volume task first, usually screening or job description drafting, rather than trying to absorb everything at once.
    </p>
  </div>
</section>

<!-- ── RELATED PATHS ── -->
<section class="section" style="background: #f0f3ff;" aria-labelledby="related-heading">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2 id="related-heading">Where to Go From Here</h2>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      If you're new to AI tools entirely and want a gentler starting point before the HR-specific material above, our <a href="/services/ai-courses/beginners" style="color:#006875; font-weight:600;">AI Courses for Beginners</a> page covers the absolute basics first.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      If you're the one making the case for AI adoption to leadership, or need to align with department heads on shared policy, our <a href="/services/ai-courses/managers" style="color:#006875; font-weight:600;">AI Course for Managers</a> covers the decision-making side: evaluating tools, setting guidelines, and leading change management, which pairs well with the hands-on skills covered here.
    </p>
  </div>
</section>

<!-- ── FAQ ── -->
<section class="section" style="background: #e7eeff;" aria-labelledby="faq-heading">
  <div class="container" style="max-width: 48rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- ── FINAL CTA ── -->
<section class="section-sm" aria-label="Call to action">
  <div class="container">
    <div class="cta-band">
      <div style="position: relative; z-index: 1; text-align:center;">
        <p class="cta-eyebrow">Free Discovery Call</p>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 1rem;">Ready to Bring AI to Your HR Team, Safely?</h2>
        <p style="font-size: 1.125rem; max-width: 36rem; margin: 0 auto 2rem; line-height: 1.7;">Request a quote for private HR AI training that treats candidate data seriously and fits how your team actually hires.</p>
        <div class="cta-trust-badges">
          <span class="cta-trust-badge">✓ 100% free</span>
          <span class="cta-trust-badge">✓ No commitment</span>
          <span class="cta-trust-badge">✓ Refund guarantee</span>
        </div>
        <button onclick="openModal(this)" data-source="courses_hr" class="btn-primary" style="font-size: 1.125rem; padding: 1.125rem 2.75rem;">Request Training Quote →</button>
        <p style="font-size: .875rem; margin-top: 1rem; color:#94a3b8;">30-min call · No sales pressure</p>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .path-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
</style>
