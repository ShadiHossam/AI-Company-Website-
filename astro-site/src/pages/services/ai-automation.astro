---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../lib/supabase";
import FaqAccordion from "../../components/FaqAccordion.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import StatStrip from "../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "What kinds of processes can you automate with AI?", answer: "We automate any workflow that involves repetitive data handling, approvals, communications, or routing, including email processing, invoice extraction, lead follow-up, report generation, data entry between systems, and multi-step approval chains. If your team does it manually and it follows a pattern, we can automate it." },
  { question: "Do we need to replace our existing software?", answer: "No. We build automation on top of what you already use. Your existing CRM, ERP, email, and business apps stay in place; we add an AI automation layer on top via API. The goal is to make your current tools smarter, not replace them." },
  { question: "How long does an automation project take?", answer: "Each project is scoped individually. We give you a precise timeline after the discovery session, based on the number of workflows, integrations, and data complexity involved." },
  { question: "What if the automation breaks or needs updating?", answer: "All automation projects include 90-day post-launch support. We monitor the workflows, fix any issues, and make small adjustments as your processes evolve. Beyond that, we offer ongoing maintenance retainers." },
  { question: "How is AI automation different from tools like Zapier or Make?", answer: "Zapier and Make are rule-based: they move data from A to B when a specific trigger fires. They break the moment the data is messy, the format changes, or the task requires any judgment. AI automation adds a reasoning layer: it reads and understands unstructured content, handles exceptions, makes decisions based on context, and adapts when inputs vary. You can automate tasks that no Zap could handle." },
  { question: "We're a small team. Is AI automation worth it at our scale?", answer: "Yes, often more so. Small teams feel the pain of repetitive manual work most acutely because there's no one to delegate it to. Automating 3-5 core workflows for a 10-person team can free up the equivalent of a full-time employee. We scope projects to match your budget and prioritize the automations with the fastest payback." },
  { question: "What information do you need to scope an automation project?", answer: "A description of the current workflow (how it's done today, who does it, how often), the tools involved, and what the desired output looks like. You don't need technical documentation or APIs mapped in advance. We gather all of that during the discovery session and translate it into a technical scope for your approval." },
  { question: "Can you automate a workflow that involves a tool without a public API?", answer: "Often, yes. Most modern business tools expose an API even if it isn't advertised, and for the few that don't, there are still reliable ways to connect them, including browser-based automation and scheduled exports. We check this during the discovery session and tell you upfront if a specific tool is going to limit what's possible." },
  { question: "Where does the data go once AI is processing it?", answer: "It moves between the systems you already use, the same as if a person were typing it manually. We don't route your data through consumer AI tools or store copies of it outside your existing infrastructure unless you specifically want an audit log kept, and we agree on that during the design phase before anything is built." },
  { question: "Can we start with one workflow instead of a full automation program?", answer: "Yes, and that's usually how projects start. Most clients automate a single high-value workflow first, see the time savings, and expand from there. We don't require a large upfront commitment to prove the approach works." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ai_automation')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

const processSteps = [
  { icon: "search", step: "Step 1", title: "Process Audit", description: "We map your current workflows, identify the highest-value automation targets, and prioritize them by ROI." },
  { icon: "edit", step: "Step 2", title: "Design & Plan", description: "We design the automation logic, define triggers and outputs, and get your approval before building." },
  { icon: "build", step: "Step 3", title: "Build & Test", description: "We build the automation, run it on real data in a staging environment, and refine until it's reliable." },
  { icon: "rocket_launch", step: "Step 4", title: "Go Live & Monitor", description: "Automation goes live. We monitor it for 90 days, fix any issues, and expand to additional workflows." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'AI Automation',
    url: 'https://lenooai.com/services/ai-automation',
    description: 'AI automation agency in the UAE: intelligent workflow and process automation that eliminates repetitive manual work across sales, operations, and admin.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'AI automation projects: pricing based on workflow complexity and scope. Book a free discovery call for a quote.' },
    serviceType: 'AI Automation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lenooai.com/' },
      { '@type': 'ListItem', position: 2, name: 'AI Automation', item: 'https://lenooai.com/services/ai-automation' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title="AI Automation Agency in the UAE | Lenoo AI"
  description="Lenoo AI is a UAE-based AI automation agency. We design and implement automation workflows that connect your tools, cut manual work, and integrate with your existing stack."
  canonicalPath="/services/ai-automation"
  arPath="/ar/services/ai-automation"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span>AI Automation</div>
    <h1>Stop Doing It Manually. <span class="gradient-text">Let AI Handle the Repetitive Work.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      Lenoo AI is a UAE-based AI automation agency. Every hour your team spends on data entry, email routing, or manual approvals is an hour they're not spending on work that actually moves the business. We design and build automation that eliminates it, integrated with the tools you already use.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">Post-launch monitoring included with every project</span>
      <span class="tchip">Refund guarantee if you're not satisfied with what we deliver</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ai_automation_hero" class="btn-primary">Book a Free Discovery Call</button>
      <a href="#what-we-automate" class="btn-outline">See What We Automate ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="AI workflow automation and process optimization" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "40%", caption: "of work tasks in most businesses are automatable with existing AI. Most teams haven't started." },
      { value: "90 days", caption: "post-launch monitoring included with every project" },
      { value: "100%", caption: "refund guarantee if you're not satisfied with what we deliver" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI AUTOMATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">What Is AI Automation, and Why Does It Beat Traditional Automation?</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        Traditional automation connects systems and moves data between them on a fixed schedule or trigger. It works well when data is clean, formats never change, and nothing unexpected happens. The problem is that most real business workflows involve messy data, human decisions mid-process, and inputs that vary from one case to the next. Those are the workflows that traditional automation can't handle, and where AI changes everything.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        AI automation adds a reasoning layer on top of the connection layer. Instead of "if X, do Y," it's "read this email, understand what the customer is asking, figure out whether it's a return request or a complaint or a product question, and route it accordingly." As a UAE AI automation agency, we build that reasoning layer on top of the tools you already run: it can read unstructured documents, interpret intent, make decisions based on context, and handle exceptions without breaking.
      </p>
    </div>

    <div class="tools-strip">
      <p class="tools-strip-label">We work with the tools you already use</p>
      <div class="tools-strip-row">
        <a href="/services/ai-automation/tools/zapier" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/zapier/FF4A00" alt="Zapier" width="28" height="28" loading="lazy" /></a>
        <a href="/services/ai-automation/tools/make" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/make/6D00CC" alt="Make" width="28" height="28" loading="lazy" /></a>
        <a href="/services/ai-automation/tools/n8n" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/n8n/EA4B71" alt="n8n" width="28" height="28" loading="lazy" /></a>
        <a href="/services/ai-automation/tools/uipath" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/uipath/FA4616" alt="UiPath" width="28" height="28" loading="lazy" /></a>
        <a href="/services/ai-automation/tools/power-automate" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/microsoftpowerautomate/0066FF" alt="Power Automate" width="28" height="28" loading="lazy" /></a>
        <a href="/services/ai-automation/tools" class="tools-strip-logo"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875;">more_horiz</span></a>
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      The business case is straightforward. McKinsey estimates that 60 to 70 percent of work tasks in most businesses are automatable with existing technology. Most companies have automated less than 20 percent of that potential. Every hour an employee spends on data entry, email routing, report generation, or copy-pasting between tools is an hour not spent on sales, service, strategy, or growth. AI automation doesn't replace people; it gives them back the hours that get wasted on work no one actually needs to do manually. See the full <a href="/services/ai-automation/tools">list of tools we implement →</a>
    </p>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="how-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="how-heading" style="margin-bottom:1.5rem;">How This Actually Works, in a Real Example</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        Take a supplier invoice. Before automation, someone on the finance team opens the email, downloads the PDF, reads the invoice number, the amount, the line items, and the supplier name, then types all of it into the accounting system by hand. If the PDF is a scanned image instead of a clean document, or the supplier's layout is different from last month's, the process slows down further because someone has to look closely at the page and work out where each number belongs. A stack of twenty invoices can eat an entire afternoon.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        After automation, the invoice arrives in the same inbox. AI reads it, whatever the layout, pulls out the invoice number, amount, line items, and supplier details, and checks them against the matching purchase order before posting the transaction into the accounting system. If something doesn't match, that one invoice gets flagged for a person to review instead of getting posted blind. The finance team's job shifts from typing to checking exceptions, which is a fraction of the original workload.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        That's the shape of most of the automation work we do: find the repetitive step that eats hours every week, teach a system to read and reason about it the way a person would, and keep a human in the loop for the decisions that genuinely need one. None of it requires replacing the accounting system, the CRM, or the person doing the job. It removes the part of the job that was never worth a person's time in the first place.
      </p>
    </div>
  </div>
</section>

<!-- WHAT WE AUTOMATE -->
<section id="what-we-automate" class="section" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">AI Automation We Commonly Build</h2>
      <p style="color:#42474e; font-size:1.0625rem;">Common types, not an exhaustive list. All built on your existing tools and supported after launch. If your workflow looks different from any of these, we still want to hear it.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">mail</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Email &amp; Communication Automation</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">AI reads, categorizes, and routes emails. It drafts replies, escalates urgent messages, and logs everything automatically.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> A support inbox that used to take a team 2 hours a day to triage now gets sorted and drafted in the background, all day, every day.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">description</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Document &amp; Invoice Processing</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Contracts, invoices, and forms processed in seconds. AI extracts data, validates it, and pushes it into your systems without manual entry.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> An operations team stopped keying in supplier invoices by hand. AI reads each one, matches it to a purchase order, and posts it directly.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">route</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Lead Routing &amp; Follow-Up</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Every inbound lead is scored, assigned to the right rep, and followed up with automatically. No more leads falling through the cracks.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> A sales team went from a 2-day average first response time to under 10 minutes, with zero extra headcount.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Approval &amp; Review Workflows</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Multi-step approvals that move automatically from submission to sign-off, with smart reminders, escalations, and audit trails built in.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> Expense approvals that used to sit in someone's inbox for a week now route, remind, and escalate on their own.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Cross-System Data Sync</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Keep your CRM, ERP, project management, and communication tools in sync automatically. No more copy-pasting between platforms.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> A team that once updated 3 separate systems by hand after every deal now updates one, and the rest sync themselves.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Automated Reporting</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Weekly status reports, pipeline summaries, and performance dashboards that write and send themselves, always up to date, never late.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>Real example:</strong> Leadership gets a pipeline summary in their inbox every Monday at 8am, compiled and written without anyone touching a spreadsheet.</p>
      </div>
    </div>
  </div>
</section>

<!-- SIGNS YOU NEED AUTOMATION -->
<section class="section" aria-labelledby="signs-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="signs-heading">Signs Your Business Needs AI Automation Now</h2>
      <p style="color:#42474e; font-size:1.0625rem;">None of these need to be true at once. If even one sounds like your team, it's worth a conversation.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">schedule</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Someone spends hours a week on copy-paste</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">If a person on your team regularly moves data from one system to another by hand, that's a task built for automation, not a task that needs a more careful person doing it.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_down</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Leads or requests sit for hours before anyone responds</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Response time is one of the strongest predictors of whether a lead converts. If your fastest response depends on who happens to check their inbox first, you're losing deals to speed, not to quality.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">person_off</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">One person's absence stalls a process</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">If a workflow only runs because one specific employee remembers to do it, that's a fragile system. Automating it means the process runs whether that person is at their desk or on leave.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">warning</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">Mistakes keep slipping through manual review</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Manual data entry has an error rate no amount of care fully removes. If wrong numbers or missed fields keep showing up downstream, the fix is usually the process, not the person doing it.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">groups_2</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">You're about to hire for admin work</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">If the next hire on your list exists mostly to handle data entry, routing, or report compilation, it's worth checking whether automation covers most of that role for a fraction of the cost.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">history</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">The same question gets answered the same way, over and over</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Support or sales questions that follow a predictable pattern don't need a person typing the same answer each time. That's exactly the kind of repetition AI handles well.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHO WE HELP -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="who-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="who-heading">AI Automation by City, Industry &amp; Use Case</h2>
      <p style="color:#42474e; font-size:1.0625rem;">Where we operate and who we build for. Each page below goes deeper into the specifics for that city, agency type, or industry.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">location_city</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">AI Automation in Dubai</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0 0 1rem;">Local implementation, on-site discovery calls, and a Dubai-based team for businesses across the emirate.</p>
        <a href="/services/ai-automation/dubai" class="learn-link">Learn more <span class="material-symbols-outlined" aria-hidden="true" style="font-size:16px;">arrow_forward</span></a>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">location_city</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">AI Automation in Abu Dhabi</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0 0 1rem;">Process automation and system integration for Abu Dhabi companies, remote or on-site.</p>
        <a href="/services/ai-automation/abu-dhabi" class="learn-link">Learn more <span class="material-symbols-outlined" aria-hidden="true" style="font-size:16px;">arrow_forward</span></a>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">groups</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">AI Automation Agencies</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0 0 1rem;">What an AI automation agency actually delivers, and what to check before you hire one.</p>
        <a href="/services/ai-automation/agencies" class="learn-link">Learn more <span class="material-symbols-outlined" aria-hidden="true" style="font-size:16px;">arrow_forward</span></a>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">calculate</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">AI Automation for Accounting</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0 0 1rem;">Invoice processing, reconciliation, and reporting automation built for finance teams.</p>
        <a href="/services/ai-automation/accounting" class="learn-link">Learn more <span class="material-symbols-outlined" aria-hidden="true" style="font-size:16px;">arrow_forward</span></a>
