---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";

const faqItems = [
  {
    question: "Do you deliver on-site anywhere in Dubai?",
    answer: "Yes. We deliver on-site across Dubai, including DIFC, Downtown, DMCC and JLT, Dubai Marina, Business Bay, Al Quoz, and Dubai Investment Park. If your office is in a free zone with visitor access rules, let us know when you book and we'll handle the entry requirements ahead of the session.",
  },
  {
    question: "What does an AI training course cost in Dubai?",
    answer: "Most Dubai courses fall between AED 4,500 and AED 18,000, depending on the program, group size, and number of sessions. A half-day Foundations course for one department costs less than a multi-day Power User program for a smaller group. We'll give you an exact number after a short scoping call, not a generic quote.",
  },
  {
    question: "How quickly can you schedule a course after we book?",
    answer: "For a single on-site session, we can usually confirm a date within one to two weeks, sooner if your team's calendar allows. Multi-day or industry-specific programs need a short scoping call first, since the material has to be built around your workflows before the first session runs.",
  },
];

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="AI Training Courses in Dubai | Lenoo AI"
  description="Private on-site AI training courses for Dubai companies, from DIFC and DMCC to Business Bay and Al Quoz. AED pricing, flexible scheduling, built around your team."
  canonicalPath="/services/ai-training-courses-dubai"
  ogImage="/assets/og-ai-training.jpg"
  ldJson={[faqLdJson]}
>

<!-- ── HERO ── -->
<header class="hero-section" style="padding-top: 10rem; padding-bottom: 5rem; text-align: center;">
  <div class="container" style="position: relative; z-index: 1;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services" style="color:inherit;text-decoration:none;opacity:0.65;">Services</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-training" style="color:inherit;text-decoration:none;opacity:0.65;">AI Training</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-training-courses" style="color:inherit;text-decoration:none;opacity:0.65;">AI Training Courses</a><span style="opacity:0.4;padding:0 4px;"> / </span>Dubai</div>
    <h1 style="max-width: 54rem; margin: 0 auto 1.5rem;">
      AI Training Courses<br>
      <span class="gradient-text">in Dubai</span>
    </h1>
    <p style="color: rgba(255,255,255,0.72); font-size: 1.125rem; line-height: 1.75; max-width: 40rem; margin: 0 auto 0;">
      Private, on-site AI training for companies based in Dubai, from DIFC and DMCC to Business Bay and Al Quoz. One company per course, built around your team, your tools, and your industry.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">On-site anywhere in Dubai</span>
      <span class="tchip">AED pricing, no hidden fees</span>
      <span class="tchip">Private courses, your team only</span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      <button onclick="openModal(this)" data-source="training_dubai_hero" class="btn-primary" style="font-size: 1rem;">Request a Dubai Course Quote →</button>
      <a href="#pricing" class="btn-outline" style="font-size: 1rem;">See Pricing ↓</a>
    </div>
  </div>
</header>

<!-- ── WHY DUBAI TEAMS NEED THIS (short, defers to hub) ── -->
<section class="section" aria-labelledby="why-heading">
  <div class="container">
    <div style="max-width: 760px; margin: 0 auto; text-align: center;">
      <h2 id="why-heading" style="margin-bottom: 1.5rem;">AI Tools Only Pay Off When Your Team Actually Uses Them</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        Most Dubai companies we meet already have AI tools sitting in their tech stack, unused or barely touched. The reason isn't the software. It's that nobody showed the team how the tools fit their actual jobs. We cover the full case for why training matters more than the tools themselves on our <a href="/services/ai-training" style="color:#006875; font-weight:600;">AI training and workshops page</a>. This page is about what that looks like specifically for a company operating in Dubai: where we deliver, what it costs, and how fast we can get a course on the calendar.
      </p>
    </div>
  </div>
</section>

<!-- ── DELIVERY LOGISTICS ── -->
<section class="section" style="background: #e7eeff;" aria-labelledby="delivery-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">Delivery in Dubai</p>
      <h2 id="delivery-heading">On-Site Anywhere in the City</h2>
      <p style="color: #42474e; max-width: 38rem; margin: 1rem auto 0; line-height: 1.7;">We travel to your office for on-site sessions across Dubai, no separate travel fee for locations within the city.</p>
    </div>
    <div style="max-width: 760px; margin: 0 auto 2.5rem;">
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Free zones:</strong> DIFC, DMCC and JLT, Dubai South, and Dubai Internet City, including the visitor pass process if your building requires one.</span></div>
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Central Dubai:</strong> Downtown, Business Bay, Sheikh Zayed Road corridor, and Dubai Marina.</span></div>
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Industrial and trade areas:</strong> Al Quoz, Dubai Investment Park, and Jebel Ali.</span></div>
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Remote or hybrid:</strong> if part of your team works from another emirate, we run the session over video call for them while the rest of the room joins in person.</span></div>
    </div>
    <p style="color: #42474e; text-align: center; max-width: 700px; margin: 0 auto; line-height: 1.7;">
      For example, a mid-size trading company registered in DMCC recently booked a half-day AI Foundations course for its 18-person operations team, then followed up with a smaller Power User session for the three staff who now own the company's AI-driven reporting workflows. Group sizes and follow-up sessions like this are common; we scope the exact plan on a call before confirming dates.
    </p>
  </div>
</section>

<!-- ── PROGRAM OPTIONS RECAP ── -->
<section class="section" aria-labelledby="programs-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="programs-heading">Same Programs, Delivered in Dubai</h2>
      <p style="color: #42474e; max-width: 38rem; margin: 1rem auto 0; line-height: 1.7;">Every course format we run is available on-site in Dubai. Full breakdown of group sizes, duration, and what each one covers lives on our <a href="/services/ai-training-courses" style="color:#006875; font-weight:600;">AI training courses page</a>.</p>
    </div>
    <div class="bento-grid" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI Foundations Course</h3>
        <p class="program-price">Up to 20 people · half-day or full-day</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI for Managers Course</h3>
        <p class="program-price">Small group · half-day</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI Power User Course</h3>
        <p class="program-price">Up to 12 people · multi-day</p>
      </div>
      <div class="card" style="border-color: rgba(0,104,117,0.35);">
        <h3 style="margin-bottom: .375rem;">Industry-Specific Course</h3>
        <p class="program-price">Custom group size and dates</p>
      </div>
    </div>
  </div>
</section>

<!-- ── PRICING ── -->
<section id="pricing" class="section" style="background: #e7eeff;" aria-labelledby="pricing-heading">
  <div class="container">
    <div style="max-width: 760px; margin: 0 auto; text-align: center;">
      <h2 id="pricing-heading" style="margin-bottom: 1.5rem;">What a Dubai Course Costs</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        Most Dubai courses run between <strong>AED 4,500 and AED 18,000</strong>. A half-day Foundations course for a single department sits at the lower end. Multi-day Power User programs or fully custom industry-specific courses cost more, since they involve smaller groups and more preparation time. We don't publish a fixed price list because group size, duration, and language requirements all change the number. Tell us roughly what you need and we'll send a written quote after a short call, no obligation.
      </p>
    </div>
  </div>
</section>

<!-- ── FAQ ── -->
<section class="section" aria-labelledby="faq-heading">
  <div class="container" style="max-width: 48rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- ── FINAL CTA ── -->
<section class="section-sm" aria-label="Call to action">
  <div class="container">
    <div class="cta-band">
      <div style="position: relative; z-index: 1; text-align:center;">
        <p class="cta-eyebrow">Free Discovery Call</p>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 1rem;">Ready to Book a Dubai Course?</h2>
        <p style="font-size: 1.125rem; max-width: 36rem; margin: 0 auto 2rem; line-height: 1.7;">Tell us your team size, office location in Dubai, and preferred dates. We'll send back a course plan and a written quote.</p>
        <div class="cta-trust-badges">
          <span class="cta-trust-badge">✓ 100% free</span>
          <span class="cta-trust-badge">✓ No commitment</span>
          <span class="cta-trust-badge">✓ Refund guarantee</span>
        </div>
        <button onclick="openModal(this)" data-source="training_dubai_cta" class="btn-primary" style="font-size: 1.125rem; padding: 1.125rem 2.75rem;">Request a Dubai Course Quote →</button>
        <p style="font-size: .875rem; margin-top: 1rem; color:#94a3b8;">30-min call · No sales pressure</p>
      </div>
    </div>
  </div>
</section>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "AI Training Courses in Dubai",
      "url": "https://lenooai.com/services/ai-training-courses-dubai",
      "description": "Private on-site AI training courses for Dubai companies, from DIFC and DMCC to Business Bay and Al Quoz. AED pricing, flexible scheduling, built around your team.",
      "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
      "areaServed": { "@type": "City", "name": "Dubai" },
      "offers": { "@type": "Offer", "priceCurrency": "AED", "description": "Private group AI training course in Dubai, typically AED 4,500 to AED 18,000 depending on program, group size, and duration." },
      "serviceType": "AI Training"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://lenooai.com/services" },
        { "@type": "ListItem", "position": 3, "name": "AI Training", "item": "https://lenooai.com/services/ai-training" },
        { "@type": "ListItem", "position": 4, "name": "AI Training Courses", "item": "https://lenooai.com/services/ai-training-courses" },
        { "@type": "ListItem", "position": 5, "name": "Dubai", "item": "https://lenooai.com/services/ai-training-courses-dubai" }
      ]
    }
  ]
}
</script>

</BaseLayout>

<style>
    .program-price { color: #006875; font-weight: 700; font-size: .9rem; font-family: 'Inter', sans-serif; margin-bottom: 1rem; }
    .check-row { display: flex; align-items: flex-start; gap: .625rem; margin-bottom: .625rem; }
    .check-row svg { flex-shrink: 0; margin-top: .125rem; }
</style>
