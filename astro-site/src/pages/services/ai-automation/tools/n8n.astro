---
export const prerender = false;
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import { getAutomationTool } from "../../../../data/automationTools";

const tool = getAutomationTool('n8n');

let faqItems = tool.faqFallback;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ai_automation_tools_n8n')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: tool.h1,
    url: 'https://lenooai.com/services/ai-automation/tools/n8n',
    description: tool.metaDescription,
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'n8n automation projects: pricing based on workflow complexity and scope. Book a free discovery call for a quote.' },
    serviceType: 'n8n Automation Implementation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lenooai.com/' },
      { '@type': 'ListItem', position: 2, name: 'AI Automation', item: 'https://lenooai.com/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'Tools', item: 'https://lenooai.com/services/ai-automation/tools' },
      { '@type': 'ListItem', position: 4, name: 'n8n', item: 'https://lenooai.com/services/ai-automation/tools/n8n' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title={tool.metaTitle}
  description={tool.metaDescription}
  canonicalPath="/services/ai-automation/tools/n8n"
  arPath="/ar/services/ai-automation/tools/n8n"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">AI Automation</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-automation/tools" style="color:inherit;text-decoration:none;opacity:0.65;">Tools</a><span style="opacity:0.4;padding:0 4px;"> / </span>n8n</div>
    <div class="tool-logo-hero"><img src={`https://cdn.simpleicons.org/${tool.logoSlug}/${tool.logoColor}`} alt="n8n logo" width="56" height="56" loading="eager" onerror="this.parentElement.style.display='none'" /></div>
    <h1>{tool.h1}</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      {tool.heroSubtext}
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:2rem;">
      <button onclick="openModal(this)" data-source="ai_automation_tools_n8n_hero" class="btn-primary">Book a Free Discovery Call</button>
      <a href="#use-cases" class="btn-outline">See What We Build ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1607799279861-4dd421887fb3?w=1400&q=80&auto=format&fit=crop" alt="Developer building an automation workflow with code on a laptop screen" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHAT IS N8N -->
<section class="section" aria-labelledby="what-is-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="what-is-heading" style="margin-bottom:1.5rem;">What Is n8n?</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        {tool.whatIs}
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        {tool.whatIsExtra}
      </p>
    </div>
  </div>
</section>

<!-- HOW LENOO USES N8N -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="how-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="how-heading" style="margin-bottom:1.5rem;">How Lenoo AI Uses n8n for UAE Automation Builds</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        {tool.integrationAngle}
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.5rem;">
        {tool.integrationAngleExtra}
      </p>
      <div class="ai-agent-callout">
        <p style="color:#00253b; font-size:1.0625rem; line-height:1.85; margin:0;">
          n8n is also how we build <strong>ai agent automation</strong>: workflows where an LLM agent reads the input, makes a decision, and takes the next action mid-pipeline, rather than just moving data from one app to another on a fixed trigger. This is the same workflow engine, but a different kind of build, closer to a small decision-making system than a Zap. See our dedicated <a href="/services/ai-agents/tools/n8n-ai-agent">n8n AI agent builds →</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FREE VS PAID -->
<section class="section" aria-labelledby="n8n-pricing-heading">
  <div class="container" style="max-width:800px;">
    <h2 id="n8n-pricing-heading" style="text-align:center; margin-bottom:1.5rem;">n8n Free vs Paid</h2>
    <div class="n8n-toggle" role="tablist" aria-label="Pricing tier">
      <button type="button" id="n8n-tier-free" class="n8n-toggle-btn active" data-n8n-tier="free" role="tab" aria-selected="true" aria-controls="n8n-panel-free">Free (Self-Hosted)</button>
      <button type="button" id="n8n-tier-paid" class="n8n-toggle-btn" data-n8n-tier="paid" role="tab" aria-selected="false" aria-controls="n8n-panel-paid">Paid (Cloud)</button>
    </div>
    <div class="card" id="n8n-panel-free" data-n8n-tier-panel="free" role="tabpanel" aria-labelledby="n8n-tier-free">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">n8n is open source and free to self-host on your own server or a cloud instance you control, with no cap on workflows or executions. You (or we, on your maintenance retainer) own the server, updates, and uptime. This is the option we reach for when data residency or compliance rules mean your data can't leave infrastructure you control.</p>
    </div>
    <div class="card" id="n8n-panel-paid" data-n8n-tier-panel="paid" role="tabpanel" aria-labelledby="n8n-tier-paid" hidden>
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">n8n Cloud is n8n's own hosted offering: no server to manage, with updates and uptime handled for you. Plans are priced by workflow execution volume rather than a flat seat fee, so cost scales with how much automation you're actually running. We recommend it when self-hosting isn't a genuine requirement for your business.</p>
    </div>
  </div>
</section>

<!-- WHO THIS FITS -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="who-heading" style="margin-bottom:1.5rem;">Is n8n Right for You?</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        {tool.whoItsFor}
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        A few concrete signals we watch for: your compliance or legal team has flagged that customer data can't leave your own infrastructure, your workflow needs a step no drag-and-drop platform expresses cleanly, or you keep describing an automation idea that sounds less like "move data from A to B" and more like "read this, decide, then act." Any of those usually means n8n, not a lighter no-code tool, is where the project should start.
      </p>
    </div>
  </div>
</section>

<!-- TYPICAL PROJECT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="typical-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="typical-heading" style="margin-bottom:1.5rem;">What a Typical n8n Project With Us Looks Like</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        n8n projects carry one extra decision the no-code tools don't: where the workflow actually runs.
      </p>
      <ol style="color:#42474e; font-size:1.0625rem; line-height:1.85; padding-left:1.25rem; margin:0;">
        <li style="margin-bottom:0.75rem;"><strong>Discovery.</strong> We work out whether self-hosting is a genuine requirement (data residency, compliance, cost at volume) or whether it's being assumed by default, and we map the workflow logic your business actually needs.</li>
        <li style="margin-bottom:0.75rem;"><strong>Design and infrastructure.</strong> We decide between your own server, a cloud instance we manage, or n8n's hosted offering, then design the workflow visually, marking which steps need a code node or an AI agent step.</li>
        <li style="margin-bottom:0.75rem;"><strong>Build and test.</strong> We build the workflow node by node, writing custom JavaScript only where the visual builder genuinely can't express the logic, and test each branch against real data before anything touches production.</li>
        <li><strong>Launch and monitor.</strong> We deploy the instance, hand over documentation your team can read, and monitor execution logs for the first weeks so failures get caught and fixed quickly rather than discovered by a customer.</li>
      </ol>
    </div>
  </div>
</section>

<!-- VS ALTERNATIVES -->
<section class="section" aria-labelledby="vs-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="vs-heading" style="margin-bottom:1.5rem;">n8n vs. the Alternatives</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        n8n is more capable than <a href="/services/ai-automation/tools/zapier">Zapier</a> or <a href="/services/ai-automation/tools/make">Make</a> in almost every technical sense: it self-hosts, it takes custom code, and it handles AI agent logic natively. That doesn't make it the right default. If your workflow is a handful of straightforward triggers and actions with no compliance requirement forcing self-hosting, Zapier gets the same result live faster and with less to maintain. If the workflow branches heavily but doesn't need custom code or an AI agent step, Make's visual scenario builder is often a simpler middle ground. We recommend n8n specifically when data residency, custom logic, or agent-style decision-making are genuine requirements, not because it's the most flexible option on paper. Capability that goes unused is just maintenance overhead, and we'd rather hand you a Zap that runs itself than an n8n instance nobody on your team ends up touching.
      </p>
    </div>
  </div>
</section>

<!-- RELIABILITY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="reliability-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="reliability-heading" style="margin-bottom:1.5rem;">Keeping an n8n Workflow Reliable After Launch</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        Self-hosted automation carries a responsibility no-code tools with a managed cloud don't: someone has to keep the instance itself running, patched, and backed up, not just the workflows inside it. When we host n8n for a client, that maintenance sits inside the retainer, covering the server itself, not only the workflow execution logs. Every workflow we build also gets structured error handling at the node level, so a failure in one branch doesn't take down the whole execution, and gets logged with enough detail that we can diagnose it without re-running the entire pipeline against production data. For AI agent workflows specifically, we log the reasoning trail: what the agent read, what it decided, and what action it took, so a decision that looks off can be traced back to the exact input that caused it, rather than treated as a black box nobody can explain.
      </p>
    </div>
  </div>
</section>

<!-- USE CASES -->
<section id="use-cases" class="section" aria-labelledby="use-cases-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="use-cases-heading">What We Build With n8n</h2>
      <p style="color:#42474e; font-size:1.0625rem;">Common n8n projects for UAE clients, from self-hosted data workflows to full AI agent pipelines. Every build is scoped to your actual workflow, not a generic template.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      {tool.useCases.map((uc) => (
        <div class="value-card">
          <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">bolt</span></div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">{uc.title}</h3>
          <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">{uc.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MID-PAGE CTA -->
<section class="section-sm" aria-label="Call to action">
  <div class="container" style="text-align:center;">
    <p style="color:#42474e; font-size:1.0625rem; max-width:560px; margin:0 auto 1.25rem;">Curious whether n8n is the right fit before you commit? Ask us directly.</p>
    <button onclick="openModal(this)" data-source="ai_automation_tools_n8n_mid" class="btn-primary">Book a Free n8n Consultation</button>
  </div>
</section>

<!-- FAQ -->
<section class="section" style="background:#f9f9ff;" aria-labelledby="faq-heading">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- FINAL CTA -->
<section class="section-sm" aria-label="Call to action">
  <div class="container">
    <div class="cta-band">
      <div style="position:relative; z-index:1; text-align:center;">
        <p class="cta-eyebrow">Free Discovery Call</p>
        <h2 style="font-size:clamp(1.75rem,3vw,2.5rem); margin-bottom:1rem;">Ready to Build on n8n?</h2>
        <p style="font-size:1.125rem; max-width:36rem; margin:0 auto 2rem; line-height:1.7;">Book a free discovery call with our Dubai team. We'll look at whether n8n, or something simpler, actually fits what you're trying to automate.</p>
        <div class="cta-trust-badges">
          <span class="cta-trust-badge">✓ 100% free</span>
          <span class="cta-trust-badge">✓ No commitment</span>
          <span class="cta-trust-badge">✓ Refund guarantee</span>
        </div>
        <button onclick="openModal(this)" data-source="ai_automation_tools_n8n_cta" class="btn-primary" style="font-size:1.125rem; padding:1.125rem 2.75rem;">Book Free Discovery Call</button>
        <p style="font-size:.875rem; margin-top:1rem; color:#94a3b8;">30-min call · No sales pressure</p>
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.tool-logo-hero { width:64px; height:64px; border-radius:16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; }
.value-card { display:flex; flex-direction:column; }
.ai-agent-callout { background:#fff; border:1px solid rgba(0,104,117,0.18); border-radius:14px; padding:1.5rem 1.75rem; }
.ai-agent-callout a { color:#006875; font-weight:700; text-decoration:none; }
.ai-agent-callout a:hover { text-decoration:underline; }
.n8n-toggle { display:flex; gap:0; justify-content:center; margin-bottom:1.5rem; background:#fff; border-radius:100px; padding:4px; border:1px solid rgba(0,37,59,0.1); max-width:420px; margin-left:auto; margin-right:auto; }
.n8n-toggle-btn { flex:1; padding:0.625rem 1.25rem; border-radius:100px; border:none; background:transparent; color:#42474e; font-size:0.875rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.n8n-toggle-btn.active { background:#006875; color:#fff; }
.n8n-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const toggleWrap = document.querySelector('.n8n-toggle');
  if (toggleWrap) {
    const btns = toggleWrap.querySelectorAll('.n8n-toggle-btn');
    const panels = document.querySelectorAll('[data-n8n-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-n8n-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-n8n-tier-panel') !== key; });
      });
    });
  }
</script>
