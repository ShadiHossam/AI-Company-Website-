<style>
.tools-strip { max-width:900px; margin:2.5rem auto 0; background:#f7f8fc; border-radius:14px; padding:1.5rem 1.25rem; }
.value-card { display:flex; flex-direction:column; }
.agencies-tabs { display:flex; gap:0.5rem; justify-content:center; margin-bottom:2rem; flex-wrap:wrap; }
.agencies-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.agencies-tab-btn:hover { background:#e7eeff; }
.agencies-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
.agencies-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
[data-agencies-tab-panel][hidden] { display:none; }
</style>

<script>
  const agenciesTabWrap = document.querySelector('.agencies-tabs');
  if (agenciesTabWrap) {
    const btns = agenciesTabWrap.querySelectorAll('.agencies-tab-btn');
    const panels = document.querySelectorAll('[data-agencies-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-agencies-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-agencies-tab-panel') !== key; });
      });
    });
  }
</script>
