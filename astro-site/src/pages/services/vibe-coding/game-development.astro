---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";

const fallbackFaqs = [
  { question: "Can I make a full 3D game with AI alone?", answer: "You can get a working 3D prototype: basic movement, a level, some interaction. A finished, polished 3D game is a different scale of problem, real-time performance tuning, physics edge cases, lighting and rendering optimization, that still benefits heavily from an experienced engineer directing the AI rather than an AI working unsupervised." },
  { question: "Does vibe coding work for Roblox or Unreal specifically?", answer: "Yes, both have real AI-assisted workflows today. In Roblox, AI tools can write and debug Lua scripts for game logic, and Roblox's own Studio has AI-assisted scripting features. In Unreal Engine, AI can help generate Blueprint logic and C++ boilerplate, though Unreal's visual scripting and performance requirements still reward hands-on engine experience." },
  { question: "What are the real limits for game development?", answer: "Real-time rendering performance, physics behavior at scale, and multiplayer networking are the areas where AI-generated code most often needs correction from someone who understands the engine deeply. AI is strong at scaffolding, logic, and repetitive scripting; it's weaker at the kind of performance tuning that only shows up once a lot of players or objects are on screen at once." },
  { question: "Which genre should a beginner start with?", answer: "Puzzle games, card games, and simple turn-based games are the easiest starting point, since their rules translate directly into instructions an AI can implement well. Save fast-paced action or physics-heavy genres for later projects, once you're comfortable describing what needs to change and testing the result yourself." },
  { question: "Can AI generate the art and sound too, not just the code?", answer: "Yes, separate AI tools handle art, sprites, textures, voice, and music, distinct from the coding tools that write gameplay logic. They're good enough for a working prototype's placeholder assets. Whether they're good enough for a finished, shippable product depends on the genre and how much players expect from the visuals." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'vibe_coding_game_development')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<BaseLayout
  title="AI Game Development: Vibe Coding for Games | Lenoo AI"
  description="How vibe coding applies to game development: Roblox scripting, Unreal Engine, mobile games, and where AI still needs an experienced engineer."
  canonicalPath="/services/vibe-coding/game-development"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services" style="color:inherit;text-decoration:none;opacity:0.65;">Services</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/vibe-coding" style="color:inherit;text-decoration:none;opacity:0.65;">Vibe Coding</a><span style="opacity:0.4;padding:0 4px;"> / </span>Game Development</div>
    <h1>Vibe Coding for <span class="gradient-text">Game Development.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      From Roblox scripts to Unreal Engine logic to a mobile game prototype, AI can take on a real share of the build. Here's what it's actually good at, and where it still hits a wall.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="vibe_gamedev_hero" class="btn-primary">Discuss Your Project</button>
      <a href="#platforms" class="btn-outline">See Platform Breakdown ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=1400&q=80&auto=format&fit=crop" alt="Game developer working on a 3D scene with AI-assisted tools" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHY GAMES ARE DIFFERENT -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="explain-heading" style="text-align:left; margin-bottom:1.5rem;">Why Game Development Is a Different Problem</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Most vibe coding examples are web apps: a page loads, a request goes out, a response comes back. Games run continuously, sixty times a second or more, juggling physics, rendering, input, and game logic all at once. That changes what AI assistance is actually good for. Writing a single script, an enemy's movement pattern, an inventory system, a scoring rule, is a task AI handles well, since it's a contained, describable piece of logic. Tuning how that script behaves once there are fifty enemies on screen at 60 frames per second is a different kind of problem, one that depends on engine-specific performance knowledge more than on writing correct code.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      That split, AI strong on scripting and logic, weaker on performance and feel, holds up across every platform below. It's also worth being clear about what "AI game development" actually means in practice today. It's not an AI designing a game concept from nothing and shipping a finished title unsupervised. It's a developer, hobbyist or professional, directing an AI through the mechanical parts of implementation so they can spend more time on design decisions: what makes the game fun, how difficulty should scale, what the player should feel at each moment.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      That distinction matters because it changes what "success" looks like. A first AI-assisted game session succeeds when a mechanic works and feels roughly right, not when the AI has made every creative decision on its own. The creative direction stays with the person building it; the AI speeds up the part where an idea becomes working code.
    </p>
  </div>
</section>

<!-- PLATFORM BREAKDOWN -->
<section id="platforms" class="section" style="background:#f0f3ff;" aria-labelledby="platforms-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="platforms-heading">Platform by Platform</h2>
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">sports_esports</span></div>
        <h3>Roblox</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">AI tools can write and debug Lua scripts for movement, tools, shop systems, and game logic. Roblox Studio's own AI-assisted scripting features make this one of the most beginner-friendly platforms to start on. Complex multiplayer state and monetization systems still benefit from an experienced Roblox developer's review, especially once real players and real transactions are involved.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">view_in_ar</span></div>
        <h3>Unreal Engine</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">AI can generate Blueprint logic and scaffold C++ classes, cutting down the boilerplate that usually slows early development. Unreal's rendering pipeline, lighting setup, and performance profiling still reward direct engine experience, that's where a shallow AI-generated setup tends to show its limits first, particularly once a project moves from a small test level to something with real scale.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">phone_iphone</span></div>
        <h3>Mobile Games</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">Simple 2D mobile games, puzzle games, endless runners, casual arcade formats, are one of the strongest fits for AI-assisted building end to end, since the logic is usually more contained and the performance bar is lower than a full 3D title. Publishing to app stores and handling platform review guidelines is still a separate, non-technical step worth planning for early.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">deployed_code</span></div>
        <h3>2D / Web Games</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">Browser-based 2D games built with frameworks like Phaser or plain JavaScript canvas code are close enough to standard web development that most AI coding tools handle them well, including physics-lite mechanics and simple animation. This is often the easiest starting point for someone brand new to game development specifically.</p>
      </div>
    </div>
  </div>
</section>

<!-- GENRE FIT -->
<section class="section" aria-labelledby="genre-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="genre-heading" style="text-align:left; margin-bottom:1.5rem;">Which Genres Fit Best</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Genre matters more than platform for how well AI assistance works. Puzzle games, card games, turn-based strategy, and simple simulation games have a clear advantage: their rules are describable in plain language, which is exactly what AI tools work from best. "When the player matches three tiles, remove them and add the score" translates directly into working logic.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Fast-paced action games, anything with precise physics, and competitive multiplayer titles are harder, not because AI can't write the code, but because getting the feel right (how a jump arcs, how a hit registers, how lag is hidden from players) takes iteration and playtesting that no amount of AI-generated first drafts replaces. These genres are still buildable with AI assistance. They just need more rounds of human tuning between each AI-generated pass.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      Open-world and sandbox games sit in between. The individual systems, inventory, crafting, dialogue, are describable and buildable with AI help. What's hard is the sheer number of systems that all have to interact correctly at once, which is more a project-management challenge than a coding one, and a large reason why open-world titles take longer to build regardless of which tools are used.
    </p>
  </div>
</section>

<!-- WHAT AI IS GOOD AT VS NOT -->
<section class="section" aria-labelledby="strengths-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="strengths-heading">Where AI Helps, and Where It Doesn't</h2>
      <p style="color:#42474e; font-size:1.0625rem;">A practical way to think about it: anything you could describe precisely in a sentence, AI handles well. Anything that only reveals itself through play testing, timing, feel, the moment a mechanic clicks, still needs a person iterating on it directly.</p>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <div style="background:#fff; border:1px solid rgba(0,104,117,0.2); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#006875; margin-bottom:1rem;">AI handles this well</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> Individual gameplay scripts, movement, inventory systems, scoring rules, that can be described precisely in a sentence</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> UI screens: menus, heads-up displays, settings panels, and inventory layouts</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> Prototyping a game concept quickly, to test whether it's actually fun before investing further</li>
          <li style="padding:0.375rem 0; display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> Debugging scripts against a known, reproducible error message</li>
        </ul>
      </div>
      <div style="background:#fff; border:1px solid rgba(0,37,59,0.1); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#42474e; margin-bottom:1rem;">Still needs an engineer</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> Performance tuning at scale, once many objects and a high frame rate target are both in play at once</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> Physics edge cases and collision reliability under unusual player behavior</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> Multiplayer networking and keeping every player's game state in sync under real network conditions</li>
          <li style="padding:0.375rem 0; display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> Rendering and lighting optimization for the kind of visual polish players notice immediately</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ASSETS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="assets-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="assets-heading" style="text-align:left; margin-bottom:1.5rem;">Code Is Only Half the Game</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Scripting logic is where general-purpose coding tools (see our <a href="/services/vibe-coding/tools" style="color:#006875;">tools guide</a>) do most of the work, but a game also needs art, sound, and level layout, and that's a separate set of AI tools entirely. Image generation tools can produce concept art, textures, and sprite sheets. Voice and sound generation tools can produce placeholder sound effects and music for a prototype. None of these replace a dedicated artist or sound designer for a polished final product, but they remove the "I can't build anything because I can't draw" barrier that used to stop a lot of solo builders before they started.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      The realistic expectation: AI-generated art and audio are good enough for a working prototype that proves the concept and looks presentable while testing. Whether they're good enough for a finished, shippable product depends heavily on the genre and the audience's expectations, a casual mobile puzzle game tolerates placeholder-quality art much better than a premium 3D title does.
    </p>
  </div>
</section>

<!-- REALISTIC WORKFLOW -->
<section class="section" aria-labelledby="workflow-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="workflow-heading" style="text-align:left; margin-bottom:1.5rem;">A Realistic First Project Workflow</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      Start with the smallest version of the core mechanic, not the whole game. If it's a platformer, get one character jumping between two platforms before worrying about levels, enemies, or a scoring system. Describe that single mechanic to the AI, test it yourself immediately, and only move forward once it actually feels right to play, not just correct on paper.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      From there, add one system at a time: enemies, then scoring, then a second level, testing after each addition rather than describing the whole game upfront and hoping it comes out right in one pass. This mirrors how professional game studios build too, vertical slices before full scope, it's just that AI assistance makes each slice faster to produce.
    </p>
  </div>
</section>

<!-- COMMON MISTAKES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="mistakes-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="mistakes-heading" style="text-align:left; margin-bottom:1.5rem;">Mistakes First-Time AI Game Builders Make</h2>
    <ul style="color:#42474e; font-size:1rem; line-height:2; padding-left:1.25rem;">
      <li><strong>Trying to build the whole game in one description.</strong> "Make me a full RPG with an inventory, quests, and combat" gives the AI too much to guess at once. Break it into the smallest playable slice first.</li>
      <li><strong>Skipping playtesting because the code "looks right."</strong> A script that compiles without errors isn't the same as a mechanic that feels good to play. Only playing it tells you which one you have.</li>
      <li><strong>Ignoring performance until it's a real problem.</strong> Adding a hundred enemies to test difficulty before checking whether ten enemies already strain the frame rate is a common way to discover a performance ceiling too late to fix easily.</li>
      <li><strong>Publishing without checking platform rules.</strong> Roblox, mobile app stores, and Steam each have their own content and monetization policies. AI-generated code doesn't know your specific platform's rules unless you check them yourself before submitting.</li>
    </ul>
  </div>
</section>

<!-- BRIDGE / MID CTA -->
<section class="section" aria-labelledby="next-step-heading">
  <div class="container" style="max-width:820px; text-align:center;">
    <h2 id="next-step-heading" style="margin-bottom:1rem;">From Prototype to a Real, Shippable Game</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      A prototype proves a game concept works. Shipping it, on an app store, to real players, with monetization that holds up, is a different job. That gap is exactly where the "still needs an engineer" list above turns from a caveat into a real project: performance at scale, physics reliability, and multiplayer synchronization all need to be solved properly before a game can handle real traffic and real players without falling apart.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:2rem;">
      If you've validated a concept and want it built into something you can actually launch, support, and grow, that's where our engineers take over: closing exactly the gaps this page has been honest about.
    </p>
    <button onclick="openModal(this)" data-source="vibe_gamedev_mid" class="btn-primary">Discuss Your Project</button>
  </div>
</section>

<!-- FAQ -->
<section class="section" style="background:#f9f9ff;" aria-labelledby="faq-heading">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- FINAL CTA -->
<section class="section-sm" aria-label="Call to action">
  <div class="container">
    <div class="cta-band">
      <div style="position:relative; z-index:1; text-align:center;">
        <p class="cta-eyebrow">Free Discovery Call</p>
        <h2 style="font-size:clamp(1.75rem,3vw,2.5rem); margin-bottom:1rem;">Ready to Ship Your Game?</h2>
        <p style="font-size:1.125rem; max-width:36rem; margin:0 auto 2rem; line-height:1.7;">Tell us about your game concept. We'll give you a timeline and cost estimate, free, with no commitment.</p>
        <div class="cta-trust-badges">
          <span class="cta-trust-badge">✓ 100% free</span>
          <span class="cta-trust-badge">✓ No commitment</span>
          <span class="cta-trust-badge">✓ Refund guarantee</span>
        </div>
        <button onclick="openModal(this)" data-source="vibe_gamedev_final" class="btn-primary" style="font-size:1.125rem; padding:1.125rem 2.75rem;">Discuss Your Project</button>
        <p style="font-size:.875rem; margin-top:1rem; color:#94a3b8;">30-min call · No sales pressure</p>
      </div>
    </div>
  </div>
</section>

