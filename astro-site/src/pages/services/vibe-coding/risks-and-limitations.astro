</BaseLayout>

<style>
.builds-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
@media(max-width:900px) { .builds-grid { grid-template-columns:1fr 1fr; } }
@media(max-width:600px) { .builds-grid { grid-template-columns:1fr; } }
.icon-box { width:48px; height:48px; border-radius:14px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; flex-shrink:0; }
.risks-card-toggle { display:flex; justify-content:space-between; align-items:center; width:100%; background:none; border:none; cursor:pointer; text-align:left; padding:0; gap:1rem; }
.risks-card-toggle h3 { margin:0; }
.risks-card-icon { font-size:1.25rem; color:#006875; transition:transform 0.2s; flex-shrink:0; }
.risks-card-toggle[aria-expanded="true"] .risks-card-icon { transform:rotate(45deg); }
.risks-card-toggle:focus-visible { outline:2px solid #006875; outline-offset:2px; }
.risks-card-panel { margin-top:0.75rem; }
</style>

<script>
  document.querySelectorAll('[data-risks-expand]').forEach((card) => {
    const btn = card.querySelector('.risks-card-toggle');
    const panel = card.querySelector('.risks-card-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) (panel as HTMLElement).hidden = expanded;
    });
  });
</script>
