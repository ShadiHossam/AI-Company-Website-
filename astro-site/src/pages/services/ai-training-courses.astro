---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";

const faqItems = [
  {
    question: "Is this an open course I can join individually, or private for my company?",
    answer: "Private only. We do not run open-enrollment classes where individuals from different companies book a seat. Every course is delivered exclusively to your team, built around your tools, your workflows, and your industry.",
  },
  {
    question: "Can you run a course in Dubai and Abu Dhabi both?",
    answer: "Yes. We deliver on-site in both cities, and remotely for teams anywhere in the UAE. If your company has offices in both Dubai and Abu Dhabi, we can schedule separate sessions or combine attendees into one course.",
  },
  {
    question: "How many people can attend?",
    answer: "Group sizes depend on the course. Foundations-level courses fit up to 20 people per session. Hands-on, project-based courses are capped at 12 for quality. Larger teams are split into multiple sessions rather than one oversized room.",
  },
  {
    question: "Do you offer AI training as a service on a recurring basis?",
    answer: "Yes. Many of our clients book quarterly or twice-yearly refresher courses as their teams grow or as new AI tools come out. We can set up a recurring schedule so training stays current instead of being a one-time event.",
  },
];

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="AI Training Courses for UAE Teams | Lenoo AI"
  description="Private group AI training courses for UAE companies, delivered in Dubai and Abu Dhabi or remotely. On-site, remote, and hybrid scheduling for your team, not open enrollment."
  canonicalPath="/services/ai-training-courses"
  ogImage="/assets/og-ai-training.jpg"
  ldJson={[faqLdJson]}
>

<!-- ── HERO ── -->
<header class="hero-section" style="padding-top: 10rem; padding-bottom: 5rem; text-align: center;">
  <div class="container" style="position: relative; z-index: 1;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services" style="color:inherit;text-decoration:none;opacity:0.65;">Services</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services/ai-training" style="color:inherit;text-decoration:none;opacity:0.65;">AI Training</a><span style="opacity:0.4;padding:0 4px;"> / </span>AI Training Courses</div>
    <h1 style="max-width: 54rem; margin: 0 auto 1.5rem;">
      AI Training Courses<br>
      <span class="gradient-text">in the UAE</span>
    </h1>
    <p style="color: rgba(255,255,255,0.72); font-size: 1.125rem; line-height: 1.75; max-width: 40rem; margin: 0 auto 0;">
      Private group AI courses for one company at a time, in Dubai, Abu Dhabi, or remotely. Book a set of dates, pick a group size, and we build the course around your team.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">Private courses for your company only</span>
      <span class="tchip">Dubai, Abu Dhabi, or remote</span>
      <span class="tchip">Flexible dates and group sizes</span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      <button onclick="openModal(this)" data-source="training_courses_hero" class="btn-primary" style="font-size: 1rem;">Request Course Dates →</button>
      <a href="#format" class="btn-outline" style="font-size: 1rem;">See Course Formats ↓</a>
    </div>
  </div>
</header>

<!-- ── PRIVATE, NOT OPEN ENROLLMENT ── -->
<section class="section" aria-labelledby="private-heading">
  <div class="container">
    <div style="max-width: 760px; margin: 0 auto; text-align: center;">
      <h2 id="private-heading" style="margin-bottom: 1.5rem;">These Are Private Courses for Your Company, Not a Public Class</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        If you're looking for a public class where individuals book a single seat alongside strangers from other companies, that's not what we run. Every AI training course we deliver is booked by one company for its own team. The room is your employees, the material is built around your tools and your industry, and the exercises use scenarios from your actual work, not generic examples shared across different businesses.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.25rem;">
        This means a course date is set once your company confirms a group, not on a fixed public calendar you can join alone. If you're an individual looking to build AI skills on your own, this isn't the right fit. If you're hiring on behalf of a team, department, or company, read on.
      </p>
    </div>
  </div>
</section>

<!-- ── COURSE FORMAT ── -->
<section id="format" class="section" style="background: #e7eeff;" aria-labelledby="format-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">Course Format</p>
      <h2 id="format-heading">Group Size, Duration, and Delivery Options</h2>
      <p style="color: #42474e; max-width: 38rem; margin: 1rem auto 0; line-height: 1.7;">Every course is scheduled around your team's calendar and location. Here's how the scheduling works, based on the four course types we run most often (see the full <a href="/services/ai-training" style="color:#006875; font-weight:600;">AI training programs</a> for what each one covers in detail).</p>
    </div>
    <div class="bento-grid" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI Foundations Course</h3>
        <p class="program-price">Up to 20 people · half-day or full-day</p>
        <p style="color: #42474e; line-height: 1.7;">The right starting course for a whole department or company. We schedule this as a single half-day or full-day session, on-site or remote.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI for Managers Course</h3>
        <p class="program-price">Small group · half-day</p>
        <p style="color: #42474e; line-height: 1.7;">Booked separately from the main team course, usually for a leadership group of under 15 people, on-site or remote.</p>
      </div>
      <div class="card">
        <h3 style="margin-bottom: .375rem;">AI Power User Course</h3>
        <p class="program-price">Up to 12 people · multi-day</p>
        <p style="color: #42474e; line-height: 1.7;">Capped smaller for hands-on project work, usually scheduled across two or three shorter sessions rather than one long day.</p>
      </div>
      <div class="card" style="border-color: rgba(0,104,117,0.35);">
        <h3 style="margin-bottom: .375rem;">Industry-Specific Course</h3>
        <p class="program-price">Custom group size and dates</p>
        <p style="color: #42474e; line-height: 1.7;">Built around your industry from the ground up, so group size, duration, and number of sessions are set during a scoping call.</p>
      </div>
    </div>
    <div style="margin-top: 3rem; max-width: 760px; margin-left: auto; margin-right: auto;">
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>On-site:</strong> we come to your office in Dubai, Abu Dhabi, or elsewhere in the UAE.</span></div>
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Remote:</strong> delivered live over video call with the same hands-on exercises, for teams anywhere.</span></div>
      <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;"><strong>Hybrid:</strong> part of your team in the room, part joining remotely, in the same live session.</span></div>
    </div>
  </div>
</section>

<!-- ── LOCATIONS ── -->
<section class="section" aria-labelledby="locations-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="locations-heading">Course Locations</h2>
      <p style="color: #42474e; max-width: 36rem; margin: 1rem auto 0; line-height: 1.7;">On-site delivery in the UAE's two largest business hubs, plus remote for everywhere in between.</p>
    </div>
    <div class="bento-grid" style="grid-template-columns: repeat(2, 1fr);">
      <a href="/services/ai-training-courses-dubai" class="card" style="text-decoration: none; display: block;">
        <h3 style="margin-bottom: .5rem;">AI Training Courses in Dubai</h3>
        <p style="color: #42474e; line-height: 1.7; margin-bottom: 1rem;">On-site courses delivered at your Dubai office, scheduled around your team's availability.</p>
        <span style="color: #006875; font-weight: 700; font-size: .9375rem;">See Dubai course details →</span>
      </a>
      <a href="/services/ai-training-courses-abu-dhabi" class="card" style="text-decoration: none; display: block;">
        <h3 style="margin-bottom: .5rem;">AI Training Courses in Abu Dhabi</h3>
        <p style="color: #42474e; line-height: 1.7; margin-bottom: 1rem;">On-site courses delivered at your Abu Dhabi office, scheduled around your team's availability.</p>
        <span style="color: #006875; font-weight: 700; font-size: .9375rem;">See Abu Dhabi course details →</span>
      </a>
    </div>
  </div>
</section>

<!-- ── FAQ ── -->
<section class="section" style="background: #e7eeff;" aria-labelledby="faq-heading">
  <div class="container" style="max-width: 48rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- ── FINAL CTA ── -->
<section class="section-sm" aria-label="Call to action">
  <div class="container">
    <div class="cta-band">
      <div style="position: relative; z-index: 1; text-align:center;">
        <p class="cta-eyebrow">Free Discovery Call</p>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 1rem;">Ready to Book a Course for Your Team?</h2>
        <p style="font-size: 1.125rem; max-width: 36rem; margin: 0 auto 2rem; line-height: 1.7;">Tell us your team size, location, and preferred dates. We'll send back a course plan and available slots.</p>
        <div class="cta-trust-badges">
          <span class="cta-trust-badge">✓ 100% free</span>
          <span class="cta-trust-badge">✓ No commitment</span>
          <span class="cta-trust-badge">✓ Refund guarantee</span>
        </div>
        <button onclick="openModal(this)" data-source="training_courses_cta" class="btn-primary" style="font-size: 1.125rem; padding: 1.125rem 2.75rem;">Request Course Dates →</button>
        <p style="font-size: .875rem; margin-top: 1rem; color:#94a3b8;">30-min call · No sales pressure</p>
      </div>
    </div>
  </div>
</section>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "AI Training Courses",
      "url": "https://lenooai.com/services/ai-training-courses",
      "description": "Private group AI training courses for UAE companies, delivered in Dubai and Abu Dhabi or remotely. On-site, remote, and hybrid scheduling for your team, not open enrollment.",
      "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
      "areaServed": "United Arab Emirates",
      "offers": { "@type": "Offer", "description": "Private group AI training course: dates and pricing customized to your team size and program." },
      "serviceType": "AI Training"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://lenooai.com/services" },
        { "@type": "ListItem", "position": 3, "name": "AI Training", "item": "https://lenooai.com/services/ai-training" },
        { "@type": "ListItem", "position": 4, "name": "AI Training Courses", "item": "https://lenooai.com/services/ai-training-courses" }
      ]
    }
  ]
}
</script>

</BaseLayout>

<style>
    .program-price { color: #006875; font-weight: 700; font-size: .9rem; font-family: 'Inter', sans-serif; margin-bottom: 1rem; }
    .check-row { display: flex; align-items: flex-start; gap: .625rem; margin-bottom: .625rem; }
    .check-row svg { flex-shrink: 0; margin-top: .125rem; }
</style>
