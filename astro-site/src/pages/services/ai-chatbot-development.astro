---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import StatStrip from "../../components/StatStrip.astro";

const faqItems = [
  { question: "How long does it take to launch an AI chatbot in the UAE?", answer: "A single-purpose bot (website lead qualification or FAQ) usually launches in two to four weeks from kickoff. A WhatsApp sales bot with CRM and calendar integration typically runs four to six weeks. A multi-channel or voice-enabled build with several integrations can take eight weeks or more. The biggest swing factor isn't the AI itself, it's how fast your team can provide the knowledge base content, brand voice guidance, and system access the build depends on." },
  { question: "Can the chatbot actually handle Arabic, including Gulf dialect?", answer: "Modern language models handle Modern Standard Arabic well and increasingly manage common Gulf dialect patterns for everyday requests. Quality is not identical to English yet, so we test the bot against real customer phrasing in your target dialect during build, not just formal Arabic, and set a clear scope for what it answers confidently versus when it hands off to a person." },
  { question: "Can the chatbot actually book appointments, or does it just talk?", answer: "It depends entirely on the build, and this is the single biggest gap between a real chatbot and a scripted one. A properly built bot checks live calendar availability, books the slot, sends a confirmation, and can reschedule or cancel on request. If a vendor's demo only shows conversation and never touches your calendar or CRM, ask directly whether booking is included or an add-on." },
  { question: "Who owns the chatbot and its data after launch?", answer: "You should. Before signing with any developer, confirm in writing that you own the conversation logs, the underlying flow configuration, and the knowledge base content, and that you can export or migrate them if you switch providers later. We build on infrastructure the client controls rather than a closed platform that locks the account to us." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Chatbot Development in the UAE",
    "url": "https://lenooai.com/services/ai-chatbot-development",
    "description": "AI chatbot development for UAE businesses: website lead-qualification bots, WhatsApp sales bots, support bots, and booking bots, built bilingual and integrated with your CRM.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Chatbot Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://lenooai.com/services" },
      { "@type": "ListItem", "position": 3, "name": "AI Chatbot Development", "item": "https://lenooai.com/services/ai-chatbot-development" }
    ]
  }
];
---

<BaseLayout
  title="AI Chatbot Development in the UAE: The Complete Buyer's Guide | Lenoo AI"
  description="AI chatbot development in the UAE: what a real build costs, the six types businesses actually buy, and how to evaluate a development partner before you sign."
  canonicalPath="/services/ai-chatbot-development"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/services" style="color:inherit;text-decoration:none;opacity:0.65;">Services</a><span style="opacity:0.4;padding:0 4px;"> / </span>AI Chatbot Development</div>
    <h1>AI Chatbot Development in the UAE<br><span class="gradient-text">The Complete Buyer's Guide</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:680px; margin:1.5rem auto 2rem; line-height:1.8;">Everything a UAE business owner needs to know before commissioning a chatbot: the six types actually worth buying, what a real build includes, realistic costs, and the questions that separate a serious development partner from a template reseller.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ai-chatbot-development_hero" class="btn-primary">Book a Free Chatbot Scoping Call</button>
      <a href="#chatbot-types" class="btn-outline">See the 6 Chatbot Types ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1600&q=80&auto=format&fit=crop" alt="Team reviewing a chat interface on a laptop in a Dubai office" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "9×", caption: "more likely to convert when a lead is contacted within 5 minutes, not 30 (MIT)" },
      { value: "6", caption: "distinct chatbot types UAE businesses actually buy, not one generic bot" },
      { value: "24/7", caption: "coverage a chatbot adds outside your team's working hours" },
    ]} />
  </div>
</div>

<!-- WHAT AI CHATBOT MEANS IN 2026 -->
<section class="section" aria-labelledby="means-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="means-heading" style="margin-bottom:1.5rem;">What "AI chatbot" actually means in 2026</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>It isn't the scripted bot you're picturing.</strong> If your mental image of a chatbot is a decision tree of button clicks, "type 1 for sales, 2 for support," that's a scripted bot, and it's a different product entirely. A scripted bot can only follow the branches someone pre-wrote. An AI chatbot, built on a language model, reads what the customer actually typed, works out the intent even if it's phrased oddly or in a mix of Arabic and English, and responds in a normal sentence rather than a menu.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>It also isn't the same thing as an "AI agent."</strong> The terms get used loosely in sales pitches, so it's worth being precise: a chatbot holds a conversation and answers or routes it. An agent goes further, it takes actions across systems on its own initiative: checking three different tools before answering, deciding which workflow to trigger, following up without being asked again. Most businesses shopping for "an AI chatbot" actually want a chatbot with a few agent-like abilities bolted on: book this appointment, look up that order, and that's a reasonable, buildable scope.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">Knowing this distinction matters when you're evaluating vendors, because "AI chatbot" gets attached to products that range from a static FAQ widget with a language model wrapped around it, to a fully integrated system that reads your calendar, writes to your CRM, and hands off warm leads to a salesperson mid-conversation. The price difference between those two things is large, and a vendor who doesn't ask what you actually need it to do is selling you the cheaper one by default.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=800&q=80&auto=format&fit=crop" alt="Customer typing a message into a business chat widget on a smartphone" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- 6 CHATBOT TYPES -->
<section id="chatbot-types" class="section" style="background:#e7eeff;" aria-labelledby="types-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="types-heading">The 6 Chatbot Types UAE Businesses Actually Buy</h2>
      <p>Almost every chatbot project in this market falls into one of these six categories. Knowing which one you need before you talk to a vendor keeps the conversation focused and the quote honest.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">language</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Website Lead-Qual Bot</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Sits on your site, opens a conversation with visitors, and asks the same qualifying questions a salesperson would: budget, timeline, need. Routes the qualified ones to your team instead of leaving them to fill out a form nobody checks until tomorrow.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">Leads contacted within 5 minutes are 9× more likely to convert (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">WhatsApp Sales Bot</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Runs inside WhatsApp, where most of your customers already are. Answers product questions, sends catalogs, collects order details, and pushes qualified conversations to a salesperson without the customer ever having to leave the app.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">The channel with the least friction for a UAE customer to actually reply on</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Support/FAQ Bot</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Answers the questions your support team gets asked fifty times a week, in seconds instead of a ticket queue. Trained on your actual help documentation and policies, and hands anything genuinely unusual straight to a human.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">Cuts repetitive ticket volume so support staff handle the cases that need judgment</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">psychology</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Internal Knowledge Bot</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Not customer-facing at all. Sits inside Slack, Teams, or a browser tab and answers staff questions about policy, process, or product by searching your internal documents, so people stop pinging the one colleague who "knows everything."</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">Reduces the time staff spend searching for answers that already exist somewhere</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Booking/Scheduling Bot</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">Checks real calendar availability, books the slot the customer wants, sends confirmations and reminders, and reschedules on request. The difference between this and a generic bot is that it actually writes to your calendar, not just talks about doing it.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">Reduces no-shows through automatic reminders and easy rescheduling</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">record_voice_over</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Voice-Enabled Hybrid</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">The same underlying logic as a chat bot, extended to phone calls. A caller and a website visitor reach the same knowledge base and booking system, so the answer doesn't change depending on which channel someone happens to use.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">One knowledge base, consistent answers across chat and voice</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">Covered by our 100% refund guarantee</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">Every build is bilingual (Arabic and English), scoped to your actual use case, and integrated with the systems you already run.</p>
      <button onclick="openModal(this)" data-source="ai-chatbot-development_mid" class="btn-primary">Book a Free Chatbot Scoping Call</button>
    </div>
  </div>
</section>

<!-- WHAT A REAL BUILD INCLUDES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="build-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="build-heading">What a Real Build Includes</h2>
      <p>A chatbot that actually works is a process, not a plugin install. Here's what should happen between "we agreed to do this" and "it's live."</p>
    </div>
    <ol style="color:#42474e; font-size:1.0625rem; line-height:1.85; padding-left:1.25rem; margin:0;">
      <li style="margin-bottom:1rem;"><strong>Discovery and flow design.</strong> A proper build starts by mapping the actual conversations your customers have today, not a generic template. What do they ask first, where do they get stuck, what does a "qualified" lead look like for your business specifically. The flow gets designed around that, not the other way around.</li>
      <li style="margin-bottom:1rem;"><strong>Platform and model selection.</strong> Which language model, which channel (website widget, WhatsApp, both), and which underlying platform the bot runs on. This decision affects cost, response quality, and how easily you can migrate later, and it should be explained to you in plain terms, not assumed.</li>
      <li style="margin-bottom:1rem;"><strong>CRM, WhatsApp, and calendar integration.</strong> This is where most of the real engineering effort goes, and where a lot of cheap builds cut corners. Connecting the bot to your actual CRM so leads land where your sales team already works, to WhatsApp Business API if that's the channel, and to your calendar so booking is real, not simulated.</li>
      <li style="margin-bottom:1rem;"><strong>Testing and guardrails.</strong> Before it ever talks to a real customer, the bot gets tested against edge cases: rude messages, off-topic questions, attempts to make it say something it shouldn't, and conversations in the dialect your actual customers use, not textbook Arabic. Guardrails define exactly what it will and won't do.</li>
      <li><strong>Handover and training.</strong> You should walk away owning the thing. That means access to the platform, a walkthrough of how to update the knowledge base yourself, and a clear document explaining what the bot handles, what it escalates, and how to change its behavior without calling the developer every time.</li>
    </ol>
  </div>
</section>

<!-- COST -->
<section class="section" aria-labelledby="cost-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="cost-heading">What It Costs in the UAE</h2>
    </div>
    <h3 style="font-weight:700; font-size:1.125rem; color:#00253b; margin-bottom:0.75rem;">Ranges by chatbot type</h3>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">Cost tracks complexity far more than it tracks the chatbot's "intelligence." A support/FAQ bot answering questions from an existing knowledge base is the cheapest build in this list, because there's no integration work: it reads documents and replies. A WhatsApp sales bot or booking bot costs more because it needs to write to your CRM or calendar reliably, in both directions, without breaking when your systems change something on their end. A voice-enabled hybrid or a bot spanning multiple channels with several integrations sits at the top of the range, because every additional system it touches is another thing that has to be tested and maintained.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">Two other factors move the number more than most buyers expect: how many languages and dialects it needs to handle confidently, and how much of your existing content (product catalogs, policies, past conversations) needs to be organized before the bot can be trained on it. A business with clean, existing documentation pays less than one where the developer has to build the knowledge base from scratch by interviewing your staff.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">For a full breakdown of what drives AI project pricing in the UAE, including chatbot builds specifically, see our <a href="/pricing/ai-automation-cost" style="color:#006875; font-weight:600;">AI automation cost guide</a>. We scope and quote every chatbot project after a discovery call rather than publishing a flat number that ignores what your business actually needs.</p>
  </div>
</section>

<!-- BUILD VS BUY -->
<section class="section" style="background:#e7eeff;" aria-labelledby="buyvbuild-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="buyvbuild-heading">Build vs Buy</h2>
      <p>Three real paths to a working chatbot, and where each one tends to fall apart.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">apps</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">Platform Bot</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">A pre-built chatbot product from a SaaS vendor: fast to switch on, cheapest monthly cost, and fine for a narrow use case like an FAQ widget. Falls short when you need real CRM logic or a flow that doesn't fit the platform's template, because you're limited to what the vendor built.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">construction</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">Custom Build</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Built specifically for your business, your systems, and your customers' actual language patterns. Higher upfront cost than a platform subscription, but no ceiling on what it can do, and you own the result rather than renting access to someone else's product.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">handyman</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">No-Code</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">You or an internal team assemble the bot yourselves using a no-code flow builder. Lowest cost if you have the time and someone willing to learn the tool, but integration work, guardrail testing, and Arabic dialect tuning still take real hours that don't disappear just because there's no code involved.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMON FAILURE POINTS -->
<section class="section" aria-labelledby="fail-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="fail-heading">Common Failure Points</h2>
      <p>The same three problems show up in almost every chatbot complaint we hear from businesses that built one elsewhere.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">No human fallback</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">The bot keeps trying to answer a question it clearly can't handle instead of admitting it and passing the customer to a person. This is the fastest way to turn a mildly annoyed customer into a genuinely angry one, and it's almost always a design choice, not a technical limitation.</p>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">No Arabic dialect handling</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">A bot tested only on formal Modern Standard Arabic often stumbles on the way people actually type Gulf Arabic day to day, including mixed Arabic-English messages. If a vendor never tested against your real customers' phrasing, assume it hasn't been handled.</p>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">Breaks on edge cases</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">Demos always look great because they follow the happy path. What matters is how the bot handles a customer who changes their mind mid-conversation, asks two questions at once, or types something completely off-topic. If it wasn't tested against that, it will break on it live.</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATING A PARTNER -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="eval-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="eval-heading">How to Evaluate a Development Partner</h2>
      <p>Questions to ask before signing anything.</p>
    </div>
    <ul style="color:#42474e; font-size:1.0625rem; line-height:1.9; padding-left:1.25rem; margin:0;">
      <li style="margin-bottom:0.75rem;">Will you show me the bot handling a genuinely awkward conversation, not just the demo script?</li>
      <li style="margin-bottom:0.75rem;">Does it write to my actual CRM and calendar, or does it just describe doing that in a mockup?</li>
      <li style="margin-bottom:0.75rem;">Who owns the conversation data and the flow configuration after launch, in writing?</li>
      <li style="margin-bottom:0.75rem;">Have you tested it against Gulf Arabic phrasing specifically, not just formal Arabic?</li>
      <li style="margin-bottom:0.75rem;">What happens when the bot doesn't know the answer, and can I see that behavior?</li>
      <li>What does ongoing support and knowledge base updates cost after the initial build, and who's responsible for them?</li>
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="section" aria-labelledby="faq-heading">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <h2 id="faq-heading">Questions About AI Chatbot Development</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- FINAL CTA -->
<div class="cta-band">
  <div style="position:relative; z-index:1; text-align:center;">
    <p class="cta-eyebrow">Free Scoping Call</p>
    <h2 style="font-size:clamp(1.75rem,3vw,2.5rem); margin-bottom:1rem;">Book a Free Chatbot Scoping Call</h2>
    <p style="font-size:1.125rem; max-width:36rem; margin:0 auto 2rem; line-height:1.7;">Tell us which of the six chatbot types fits your business, and we'll map out exactly what a real build looks like: the integrations it needs, a realistic timeline, and a clear cost range. No obligation.</p>
    <div class="cta-trust-badges">
      <span class="cta-trust-badge">✓ 100% free</span>
      <span class="cta-trust-badge">✓ No commitment</span>
      <span class="cta-trust-badge">✓ Refund guarantee</span>
    </div>
    <button onclick="openModal(this)" data-source="ai-chatbot-development_cta" class="btn-primary" style="font-size:1.125rem; padding:1.125rem 2.75rem;">Book a Free Chatbot Scoping Call</button>
    <p style="font-size:.875rem; margin-top:1rem; color:#94a3b8;">30-min call · No sales pressure</p>
  </div>
</div>

</BaseLayout>

<style>
.icon-box { width:48px; height:48px; border-radius:14px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; flex-shrink:0; }
    .num-circle { width:48px; height:48px; border-radius:50%; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:1.125rem; font-weight:800; color:#006875; }
    .apps-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
    @media(max-width:900px) { .apps-grid { grid-template-columns:1fr 1fr; } }
    @media(max-width:600px) { .apps-grid { grid-template-columns:1fr; } }
</style>
