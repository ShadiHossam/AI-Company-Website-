---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../lib/supabase";
import FaqAccordion from "../../components/FaqAccordion.astro";
import StatStrip from "../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "Can AI underwriting decisions be explained to a regulator?", answer: "They need to be, so that's how we build them. Every underwriting model we deploy produces a documented reason for its output, not just a score, so your team can defend a decision under the UAE Insurance Authority's requirements." },
  { question: "How does AI actually catch insurance fraud?", answer: "Models are trained on historical claims data to spot patterns associated with fraudulent claims: inconsistent details, unusual timing, or claim patterns that match known fraud typologies. Flagged claims go to a human investigator, the AI narrows the pool, it doesn't make the final call." },
  { question: "Will claims automation slow down legitimate claims while checking for fraud?", answer: "No, it speeds them up. The majority of claims are legitimate and straightforward, so automation processes those faster while routing the smaller number of flagged or unusual claims to closer review. Most customers see faster payouts, not slower ones." },
  { question: "Does the customer service chatbot handle policy questions in Arabic?", answer: "Yes. Policy inquiries, renewal reminders, and claims status updates are handled in both Arabic and English, matching how UAE insurers actually communicate with their customer base." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'insurance')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI for Insurance Companies in the UAE",
    "url": "https://lenooai.com/industries/insurance",
    "description": "Custom AI systems for UAE insurers: claims processing automation, AI underwriting, fraud detection, and bilingual customer service chatbots.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Insurance"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://lenooai.com/industries" },
      { "@type": "ListItem", "position": 3, "name": "Insurance AI", "item": "https://lenooai.com/industries/insurance" }
    ]
  }
];
---

<BaseLayout
  title="AI for Insurance Companies in the UAE: Claims & Underwriting Automation | Lenoo AI"
  description="Lenoo AI, a Dubai AI agency, builds custom AI systems for UAE insurers: claims processing automation, AI underwriting, fraud detection, and customer chatbots."
  canonicalPath="/industries/insurance"
