    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="insurance_hero" class="btn-primary">Book Free Insurance AI Audit</button>
      <a href="#what-we-build" class="btn-outline">See What We Build ↓</a>
    </div>
    <StatStrip stats={[
      { value: "Weeks to days", caption: "typical improvement in claims processing time with AI automation" },
      { value: "$300B+", caption: "estimated annual cost of insurance fraud across all lines, industry-wide (Coalition Against Insurance Fraud)" },
      { value: "24/7", caption: "policy and claims status support with a bilingual chatbot" },
    ]} />
  </div>
</header>

<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1642522029686-5485ea7e6042?w=1600&h=320&q=80&auto=format&fit=crop" alt="Insurance claims adjuster reviewing a claim form at a desk" loading="lazy" width="1600" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- WHY INSURANCE & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">Why insurance is one of AI's highest-impact sectors</h2>
