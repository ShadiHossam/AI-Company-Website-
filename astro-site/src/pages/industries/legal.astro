---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../lib/supabase";
import FaqAccordion from "../../components/FaqAccordion.astro";
import StatStrip from "../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "Will AI contract review replace our associates or paralegals?", answer: "No. AI contract review flags clauses that deviate from your playbook and surfaces the sections that need a lawyer's judgment, but every flagged clause still goes to a person for the actual legal decision. It removes the first-pass reading time, not the legal work itself." },
  { question: "Can AI legal research tools be trusted not to fabricate case citations?", answer: "This is the single biggest risk with legal AI, and it's the reason we build citation-checking into any research assistant we deploy: every case reference the system produces is verified against a real source before it's shown to you. A tool that can't guarantee this shouldn't be in a legal workflow at all." },
  { question: "How do you handle client confidentiality and privilege?", answer: "Document processing runs in isolated environments scoped to your firm, and nothing is used to train shared models outside your engagement. We design the data flow around your existing confidentiality obligations before any document touches the system." },
  { question: "Is this built for UAE civil law, or is it a generic Western legal AI tool?", answer: "We train document and research assistants on the jurisdiction you actually practice in. A tool trained purely on U.S. or U.K. case law produces confidently wrong answers in a UAE civil law context, so jurisdiction-specific training is a requirement, not an add-on." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'legal')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI for Law Firms in the UAE",
    "url": "https://lenooai.com/industries/legal",
    "description": "Custom AI systems for UAE law firms and legal departments: contract review, document automation, legal research assistants, and compliance monitoring.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Legal Services"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://lenooai.com/industries" },
      { "@type": "ListItem", "position": 3, "name": "Legal AI", "item": "https://lenooai.com/industries/legal" }
    ]
  }
];
---

<BaseLayout
