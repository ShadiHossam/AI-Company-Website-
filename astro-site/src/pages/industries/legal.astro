</div>

<!-- WHY LEGAL & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">Why legal is one of AI's highest-impact sectors</h2>
