    .eval-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
    .seo-tabs { display:flex; gap:0.5rem; justify-content:center; margin-bottom:2rem; flex-wrap:wrap; }
    .seo-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
    .seo-tab-btn:hover { background:#e7eeff; }
    .seo-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
    .seo-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
    [data-seo-tab-panel][hidden] { display:none; }
    @media(max-width:900px) { .apps-grid { grid-template-columns:1fr 1fr; } .eval-grid { grid-template-columns:1fr 1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr 1fr !important; } }
    @media(max-width:600px) { .apps-grid { grid-template-columns:1fr; } .eval-grid { grid-template-columns:1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr !important; } }
</style>

<script>
  const seoTabWrap = document.querySelector('.seo-tabs');
  if (seoTabWrap) {
    const btns = seoTabWrap.querySelectorAll('.seo-tab-btn');
    const panels = document.querySelectorAll('[data-seo-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-seo-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-seo-tab-panel') !== key; });
      });
    });
  }
</script>
