---
import ArBaseLayout from "../../layouts/ArBaseLayout.astro";
import { COMPANY } from "../../config/company";
import { getSiteConfig } from "../../lib/config";
import FaqAccordion from "../../components/FaqAccordion.astro";
import PageHero from '../../components/PageHero.astro';

export const prerender = false;

const siteConfig = await getSiteConfig();
const calendlyUrl = siteConfig['integration.calendly_url'] || COMPANY.calendlyUrl;

const contactFaqs = [
  { question: "ما سرعة ردكم؟", answer: "رسائل واتساب تحصل على رد خلال ٢٤ ساعة في ساعات العمل. والرسائل الإلكترونية وطلبات النموذج تحصل على رد في نفس يوم العمل. وإذا حجزتم موعداً محدداً عبر النموذج، سنؤكده مباشرة." },
  { question: "ماذا يجب أن أحضّر قبل المكالمة؟", answer: "لا شيء رسمي. يساعد أن تصفوا بشكل تقريبي المهمة أو العملية التي تستهلك وقت فريقكم، لكنكم لا تحتاجون أرقاماً أو عرضاً تقديمياً أو ملخصاً تقنياً. سنطرح الأسئلة الصحيحة خلال المكالمة." },
  { question: "هل الاستشارة مجانية فعلاً ودون أي شروط؟", answer: "نعم. المكالمة لمدة ٣٠ دقيقة لا تكلف شيئاً ولا تترتب عليها أي التزامات. إذا لم يكن الذكاء الاصطناعي منطقياً لعملكم الآن، سنخبركم بذلك مباشرة بدلاً من الضغط لإتمام بيع." },
  { question: "هل يمكننا التحدث بالعربية؟", answer: "نعم. فريقنا متاح بالعربية والإنجليزية. أخبرونا بتفضيلكم عند الحجز، أو راسلونا على واتساب باللغة التي ترتاحون لها." },
  { question: "هل تلتقون حضورياً في دبي؟", answer: "نعم. اذكروا ذلك في حقل الملاحظات عند الحجز، أو أخبرونا على واتساب، وسنرتب موعداً للقاء في مكتبنا في الخليج التجاري، أو نزوركم في مقركم حسب طبيعة المشروع." },
];

const contactFaqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: contactFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const contactLdJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'تواصلوا مع Lenoo AI',
    url: 'https://lenooai.com/ar/contact',
    description: 'احجزوا مكالمة استراتيجية مجانية لمدة ٣٠ دقيقة مع Lenoo AI. متاحة بالعربية والإنجليزية.',
    inLanguage: 'ar',
    mainEntity: {
      '@type': 'Organization',
      name: 'Lenoo AI',
      url: 'https://lenooai.com',
      telephone: '+97143218888',
      email: 'hello@lenooai.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Business Bay',
        addressLocality: 'Dubai',
        addressCountry: 'AE',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
        opens: '09:00',
        closes: '18:00',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+97143218888',
        email: 'hello@lenooai.com',
        availableLanguage: ['English', 'Arabic'],
        areaServed: 'AE',
      },
    },
  },
  contactFaqLdJson,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'تواصلوا معنا', item: 'https://lenooai.com/ar/contact' },
    ],
  },
];
---

<ArBaseLayout
  title="احجزوا مكالمة استراتيجية مجانية للذكاء الاصطناعي في دبي | Lenoo AI"
  description="احجزوا مكالمة استراتيجية مجانية لمدة ٣٠ دقيقة مع Lenoo AI، وكالة ذكاء اصطناعي في دبي. دون ضغط بيعي، فقط وضوح حول ما يستطيع الذكاء الاصطناعي فعله لعملكم في الإمارات."
  canonicalPath="/ar/contact"
  enPath="/contact"
  ogImage="/assets/og-contact.jpg"
  ldJson={contactLdJson}
>

<PageHero image={{ src: "https://images.pexels.com/photos/7792749/pexels-photo-7792749.jpeg", alt: "صاحب عمل يجري مكالمة هاتفية وحاسوبه المحمول مفتوح على مكتبه" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>تواصلوا معنا</div>
  <h1>لنتحدث عن فرصة الذكاء الاصطناعي لديكم.</h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:600px; margin:1.5rem auto 0;">احجزوا مكالمة مجانية لمدة ٣٠ دقيقة. أخبرونا عن عملكم، وسنخبركم بصراحة إن كان الذكاء الاصطناعي يستطيع المساعدة وكيف، وكم سيكلف.</p>
  <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
    <span class="tchip">دون أي التزام</span>
    <span class="tchip">رد خلال ٢٤ ساعة</span>
    <span class="tchip">متاحون بالعربية والإنجليزية</span>
  </div>
  <a href="#book" class="btn-primary">احجزوا استشارتكم المجانية</a>

</PageHero>

<!-- MAIN CONTENT -->
<section class="section" style="background:#f9f9ff;" id="book">
  <div class="container" style="max-width:1000px;">
    <div class="main-grid">

      <!-- RIGHT (RTL start): Contact info -->
      <div style="display:flex; flex-direction:column; gap:1.25rem;">

        <div class="split-media" style="margin-bottom:0.25rem;">
          <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=900&q=80&auto=format&fit=crop" alt="ناطحات سحاب دبي ترتفع فوق السحاب" loading="lazy" width="900" height="240" style="height:200px;" />
        </div>

        <div class="contact-card">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <div style="width:40px; height:40px; border-radius:12px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px;">call</span>
            </div>
            <div>
              <p style="font-weight:700; font-size:0.875rem; color:#00253b; margin-bottom:2px;">واتساب</p>
              <a href={`https://wa.me/${COMPANY.whatsapp}`} target="_blank" rel="noopener" style="color:#006875; font-size:0.875rem;" dir="ltr">{COMPANY.phone}</a>
              <p style="color:#72787e; font-size:0.75rem; margin-top:2px;">العربية + الإنجليزية · رد خلال ٢٤ ساعة</p>
            </div>
          </div>
        </div>

        <div class="contact-card">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <div style="width:40px; height:40px; border-radius:12px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px;">mail</span>
            </div>
            <div>
              <p style="font-weight:700; font-size:0.875rem; color:#00253b; margin-bottom:2px;">البريد الإلكتروني</p>
              <a href={`mailto:${COMPANY.email}`} style="color:#006875; font-size:0.875rem;">{COMPANY.email}</a>
              <p style="color:#72787e; font-size:0.75rem; margin-top:2px;">رد في نفس يوم العمل</p>
            </div>
          </div>
        </div>

        <div class="contact-card">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <div style="width:40px; height:40px; border-radius:12px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px;">location_on</span>
            </div>
            <div>
              <p style="font-weight:700; font-size:0.875rem; color:#00253b; margin-bottom:2px;">الموقع</p>
              <p style="color:#42474e; font-size:0.875rem;">دبي، الإمارات العربية المتحدة</p>
              <p style="color:#72787e; font-size:0.75rem; margin-top:2px;">الأحد إلى الخميس · ٩:٠٠ صباحاً إلى ٦:٠٠ مساءً بتوقيت الخليج</p>
            </div>
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px; padding-top:0.5rem;">
          <div class="trust-pill">
            <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:16px; flex-shrink:0;">star</span>
            استشارة مجانية ١٠٠٪، دون أي التزامات
          </div>
          <div class="trust-pill">
            <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:16px; flex-shrink:0;">translate</span>
            متاحون بالعربية والإنجليزية
          </div>
          <div class="trust-pill">
            <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:16px; flex-shrink:0;">shield</span>
            ضمان رضا ١٠٠٪ على كل أنظمة الذكاء الاصطناعي التي نبنيها
          </div>
        </div>

        <div style="margin-top:0.5rem;">
          <h3 style="font-size:1.0625rem; font-weight:700; color:#00253b; margin-bottom:1rem;">ماذا يحدث في استشارتكم المجانية لمدة ٣٠ دقيقة</h3>
          <div style="display:flex; flex-direction:column; gap:0.875rem;">
            <div style="display:flex; gap:11px; align-items:flex-start;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#0f9d63; font-size:18px; flex-shrink:0; margin-top:2px;">check_circle</span>
              <span style="font-size:0.875rem; color:#42474e; line-height:1.6;"><b style="color:#00253b;">نستمع أولاً.</b> تخبروننا عن عملكم وفريقكم وأكبر مشكلاتكم التشغيلية. دون أي عرض بيعي بعد.</span>
            </div>
            <div style="display:flex; gap:11px; align-items:flex-start;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#0f9d63; font-size:18px; flex-shrink:0; margin-top:2px;">check_circle</span>
              <span style="font-size:0.875rem; color:#42474e; line-height:1.6;"><b style="color:#00253b;">نحدد فرص الذكاء الاصطناعي.</b> بناءً على ما شاركتموه، سنحدد أهم مجالين أو ثلاثة يستطيع فيها الذكاء الاصطناعي توفير وقتكم أو زيادة إيراداتكم.</span>
            </div>
            <div style="display:flex; gap:11px; align-items:flex-start;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#0f9d63; font-size:18px; flex-shrink:0; margin-top:2px;">check_circle</span>
              <span style="font-size:0.875rem; color:#42474e; line-height:1.6;"><b style="color:#00253b;">توصية صريحة.</b> سنخبركم إن كان الأمر منطقياً لعملكم، وسنخبركم إن لم يكن. لن نبيعكم ذكاءً اصطناعياً لا تحتاجونه.</span>
            </div>
            <div style="display:flex; gap:11px; align-items:flex-start;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#0f9d63; font-size:18px; flex-shrink:0; margin-top:2px;">check_circle</span>
              <span style="font-size:0.875rem; color:#42474e; line-height:1.6;"><b style="color:#00253b;">خطوة تالية واضحة.</b> تغادرون بصورة واضحة لما هو ممكن، وكم يكلف، وكم يستغرق. دون عروض غامضة.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- LEFT (RTL end): Booking Form -->
      <div>
        <div class="form-box">
          <h2 style="font-size:1.25rem; font-weight:700; color:#00253b; margin-bottom:0.25rem;">احجزوا استشارتكم المجانية</h2>
          <p style="color:#42474e; font-size:0.875rem; margin-bottom:1.5rem;">٣ خطوات سريعة، تأخذ دقيقتين تقريباً.</p>

          <div class="step-indicator" id="step-indicator">
            <div class="step-dot-sm active" id="ind-1">١</div>
            <div class="step-connector-sm" id="conn-1"></div>
            <div class="step-dot-sm" id="ind-2">٢</div>
            <div class="step-connector-sm" id="conn-2"></div>
            <div class="step-dot-sm" id="ind-3">٣</div>
          </div>

          <form id="contact-form" novalidate>

          <!-- STEP 1 -->
          <div class="form-step active" id="step-1">
            <p style="color:#006875; font-size:0.75rem; font-weight:700; margin-bottom:1rem;">الخطوة ١ من ٣: عنكم</p>
            <div id="step-1-error-summary" role="alert" class="step-error-summary" style="display:none;">يرجى تعبئة الحقول المطلوبة أدناه.</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div>
                <label class="form-label" for="c-name">الاسم الكامل *</label>
                <input class="form-input" id="c-name" type="text" autocomplete="name" placeholder="اسمكم" required />
              </div>
              <div>
                <label class="form-label" for="c-company">اسم الشركة *</label>
                <input class="form-input" id="c-company" type="text" autocomplete="organization" placeholder="شركتكم" required />
              </div>
              <div>
                <label class="form-label" for="c-email">البريد الإلكتروني *</label>
                <input class="form-input" id="c-email" type="email" autocomplete="email" placeholder="you@email.com" dir="ltr" required />
              </div>
              <div>
                <label class="form-label" for="c-whatsapp">رقم واتساب *</label>
                <input class="form-input" id="c-whatsapp" type="tel" autocomplete="tel" placeholder="+971 50 123 4567" dir="ltr" required />
              </div>
              <div style="grid-column:1/-1;">
                <label class="form-label" for="c-title">المسمى الوظيفي / الدور</label>
                <input class="form-input" id="c-title" type="text" autocomplete="organization-title" placeholder="مثلاً: الرئيس التنفيذي، مدير العمليات" />
              </div>
            </div>
            <div style="margin-top:1.5rem; display:flex; justify-content:flex-end;">
              <button type="button" onclick="contactStep(2)" class="btn-primary">التالي: عملكم ←</button>
            </div>
          </div>

          <!-- STEP 2 -->
          <div class="form-step" id="step-2">
            <p style="color:#006875; font-size:0.75rem; font-weight:700; margin-bottom:1rem;">الخطوة ٢ من ٣: عملكم</p>
            <div id="step-2-error-summary" role="alert" class="step-error-summary" style="display:none;">يرجى تعبئة الحقول المطلوبة أدناه.</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
              <div>
                <label class="form-label" for="c-industry">القطاع *</label>
                <select class="form-select" id="c-industry" required>
                  <option value="">اختاروا قطاعكم</option>
                  <option value="Real Estate">العقارات</option>
                  <option value="Retail &amp; E-commerce">التجزئة والتجارة الإلكترونية</option>
                  <option value="Hospitality &amp; Tourism">الضيافة والسياحة</option>
                  <option value="Logistics &amp; Supply Chain">اللوجستيات وسلاسل الإمداد</option>
                  <option value="Healthcare">الرعاية الصحية</option>
                  <option value="Finance &amp; Banking">المالية والخدمات المصرفية</option>
                  <option value="Construction &amp; Property Development">الإنشاءات والتطوير العقاري</option>
                  <option value="Professional Services">الخدمات المهنية</option>
                  <option value="Other">أخرى</option>
                </select>
              </div>
              <div>
                <label class="form-label" for="c-size">حجم الشركة *</label>
                <select class="form-select" id="c-size" required>
                  <option value="">اختاروا الحجم</option>
                  <option value="1–20 employees">١ إلى ٢٠ موظفاً</option>
                  <option value="21–100 employees">٢١ إلى ١٠٠ موظف</option>
                  <option value="101–500 employees">١٠١ إلى ٥٠٠ موظف</option>
                  <option value="500+ employees">أكثر من ٥٠٠ موظف</option>
                </select>
              </div>
            </div>
            <div style="margin-bottom:1rem;">
              <label class="form-label" for="c-challenge">ما التحدي أو الهدف الرئيسي لديكم؟ *</label>
              <textarea class="form-textarea" id="c-challenge" rows="3" placeholder="مثلاً: نقضي وقتاً كبيراً في تأهيل العملاء المحتملين يدوياً، أو نريد أتمتة دعم العملاء على واتساب..." required></textarea>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div>
                <label class="form-label" for="c-budget">نطاق الميزانية</label>
                <select class="form-select" id="c-budget">
                  <option value="">نفضّل عدم الإفصاح</option>
                  <option value="Exploring (no budget set yet)">نستكشف الخيارات (لا ميزانية محددة بعد)</option>
                  <option value="AED 10,000 – 50,000">١٠٬٠٠٠ إلى ٥٠٬٠٠٠ درهم</option>
                  <option value="AED 50,000 – 200,000">٥٠٬٠٠٠ إلى ٢٠٠٬٠٠٠ درهم</option>
                  <option value="AED 200,000+">أكثر من ٢٠٠٬٠٠٠ درهم</option>
                </select>
              </div>
              <div>
                <label class="form-label" for="c-ai-exp">هل جربتم أدوات الذكاء الاصطناعي من قبل؟</label>
                <select class="form-select" id="c-ai-exp">
                  <option value="No, starting from scratch">لا، نبدأ من الصفر</option>
                  <option value="A little, some personal AI tool use">قليلاً، استخدام شخصي لبعض الأدوات</option>
                  <option value="Some team tools in use">فريقنا يستخدم بعض الأدوات</option>
                  <option value="Yes, we have AI systems already">نعم، لدينا أنظمة ذكاء اصطناعي بالفعل</option>
                </select>
              </div>
            </div>
            <div style="margin-bottom:1rem;">
              <label class="form-label" for="c-notes">هل هناك شيء آخر يجب أن نعرفه؟ (اختياري)</label>
              <textarea class="form-textarea" id="c-notes" rows="2" placeholder="أي أسئلة محددة أو سياق يساعدنا على التحضير..."></textarea>
            </div>

            <!-- Honeypot: leave empty — bots fill this -->
            <input type="text" id="c-honeypot" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />

            <div style="margin-top:1.5rem; display:flex; justify-content:space-between;">
              <button type="button" onclick="contactStep(1)" class="btn-outline">→ رجوع</button>
              <button type="button" id="contact-submit-btn" onclick="continueToScheduleContact()" class="btn-primary">التالي: الموعد ←</button>
            </div>
          </div>

          <!-- STEP 3 -->
          <div class="form-step" id="step-3">
            <p style="color:#006875; font-size:0.75rem; font-weight:700; margin-bottom:1rem;">الخطوة ٣ من ٣: حددوا موعد مكالمتكم</p>

            <div class="calendly-inline-widget" data-url={calendlyUrl} style="min-width:280px;height:650px;"></div>

            <div style="background:rgba(0,104,117,0.06); border:1px solid rgba(0,104,117,0.20); border-radius:12px; padding:1rem; margin-top:1.25rem; display:flex; align-items:flex-start; gap:12px;">
              <span class="material-symbols-outlined" aria-hidden="true" style="color:#d97706; font-size:20px; flex-shrink:0; margin-top:2px;">shield</span>
              <p style="color:#42474e; font-size:0.8125rem; line-height:1.6; margin:0;"><strong style="color:#00253b;">دون أي مخاطرة.</strong> المكالمة مجانية. وإذا واصلتم معنا ولم تكونوا راضين عن نظام الذكاء الاصطناعي الذي نبنيه، نردّ ١٠٠٪ من استثماركم. دون شروط.</p>
            </div>

            <div style="margin-top:1.5rem;">
              <button type="button" onclick="contactStep(2)" class="btn-outline">→ رجوع</button>
            </div>
