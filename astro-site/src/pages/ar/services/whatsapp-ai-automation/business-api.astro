---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل نستطيع الاحتفاظ برقم WhatsApp الحالي عند الانتقال للـ API؟", answer: "عادة، نعم. معظم الأعمال تنقل رقمها الحالي من تطبيق WhatsApp Business المجاني للـ API بدلاً من البدء برقم جديد. يُلغى تسجيل الرقم من التطبيق ويُسجَّل على الـ API بدلاً منه، وسجل محادثاتكم الحالي في التطبيق لا ينتقل، لكن رقمكم المنشور، الذي حفظه عملاؤكم أصلاً، يبقى نفسه." },
  { question: "ماذا يحدث إذا رُفِض قالب مرتين؟", answer: "تعطي Meta سبب رفض كل مرة، عادة يشير لصياغة، تنسيق، أو عدم تطابق فئة محدد. رفض ثانٍ عموماً يعني أن الإصلاح الأول لم يعالج المشكلة الفعلية التي علّمتها Meta، لذا يستحق قراءة سبب الرفض بعناية بدلاً من إعادة تقديم نسخة صغيرة معدّلة من نفس القالب. الرفض المستمر قابل للإصلاح دائماً تقريباً بإعادة كتابة القالب ليطابق الفئة بدقة أكبر." },
  { question: "كم صعب الانتقال من تطبيق WhatsApp Business للـ API؟", answer: "الانتقال التقني نفسه مباشر: تُلغون تسجيل الرقم من التطبيق وتُسجّلونه لدى BSP الذي اخترتموه على الـ API. الجهد الأكبر عادة كل ما حوله، الحصول على اعتماد التحقق من العمل واسم العرض، تقديم قوالبكم الأولى، وإعادة بناء أي أتمتة كنتم تشغّلونها يدوياً في التطبيق كتدفقات صحيحة قائمة على الـ API." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "إعداد WhatsApp Business API في الإمارات",
    "url": "https://lenooai.com/ar/services/whatsapp-ai-automation/business-api",
    "description": "إعداد WhatsApp Business API للأعمال الإماراتية: عملية اعتماد Meta، أسباب الرفض الشائعة، التكاليف الحقيقية، وكيف تختارون BSP.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "WhatsApp Business API Setup"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "أتمتة WhatsApp بالذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/whatsapp-ai-automation" },
      { "@type": "ListItem", "position": 4, "name": "واجهة API للأعمال", "item": "https://lenooai.com/ar/services/whatsapp-ai-automation/business-api" }
    ]
  }
];
---

<ArBaseLayout
  title="WhatsApp Business API في الإمارات: الإعداد، التكاليف، الاعتماد | Lenoo AI"
  description="WhatsApp Business API في الإمارات: عملية الاعتماد خطوة بخطوة، لماذا تُرفَض الطلبات، التكاليف الحقيقية، وكيف تختارون BSP."
  canonicalPath="/ar/services/whatsapp-ai-automation/business-api"
  enPath="/services/whatsapp-ai-automation/business-api"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/whatsapp-ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة WhatsApp بالذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>واجهة API للأعمال</div>
    <h1>WhatsApp Business API في الإمارات<br><span class="gradient-text">الإعداد، التكاليف، الاعتماد، والرفض الشائع</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">كل ما يحدث بين قرار حاجتكم للـ API وإرسال رسالتكم الآلية الأولى فعلياً: خطوات الاعتماد، لماذا تُرفَض الطلبات، وكم تكلف فعلياً.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_whatsapp-business-api_hero" class="btn-primary">احصلوا على مساعدة بطلب API الخاص بكم</button>
      <a href="#approval" class="btn-outline">شاهدوا خطوات الاعتماد ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1600&q=80&auto=format&fit=crop" alt="مستندات التحقق من عمل وهاتف يعرض WhatsApp Business" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٤", caption: "خطوات اعتماد بين الطلب ورسالتكم الآلية الأولى" },
      { value: "٣", caption: "الأسباب الأكثر شيوعاً لرفض رسائل القوالب" },
      { value: "٢", caption: "بندا تكلفة يشكّلان الإجمالي الفعلي: رسوم Meta وتكلفة البناء" },
    ]} />
  </div>
</div>

<!-- API VS APP -->
<section class="section" aria-labelledby="apivsapp-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="apivsapp-heading" style="margin-bottom:1.5rem;">API مقابل التطبيق: أيهما تحتاجونه فعلياً</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تطبيق WhatsApp Business المجاني مبني لشخص واحد، يرد يدوياً.</strong> أداة مفيدة فعلياً لعملية صغيرة حيث يتعامل مالك واحد أو موظف مع كل محادثة يدوياً. لا أتمتة فيه، لا يستطيع المشاركة بموثوقية عبر فريق، ولا يتصل بـ CRM أو أي نظام عمل آخر.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>الـ API منتج مختلف، مبني بالضبط للأتمتة التي تغطيها هذه الصفحة.</strong> يسمح بعدة موظفين على رقم واحد، إرسال واستقبال برمجي للرسائل، تكاملاً مع CRM أو نظام طلباتكم، ورسائل القالب التي تتيح الوصول للعملاء خارج نافذة الرد الأربع وعشرين ساعة. إذا كنتم تقرؤون هذه الصفحة، تحتاجون تقريباً حتماً الـ API، لا التطبيق. تمر هذه الصفحة بالضبط بما يشمله ذلك.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=800&q=80&auto=format&fit=crop" alt="عضو فريق يراجع قائمة تحقق من عمل على حاسوب محمول" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- APPROVAL PROCESS -->
<section id="approval" class="section" style="background:#e7eeff;" aria-labelledby="approval-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="approval-heading">عملية الاعتماد، خطوة بخطوة</h2>
    </div>
    <div class="bento-grid bento-grid-4">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem; text-align:center;">التحقق من العمل عبر Meta</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تؤكد Meta شرعية عملكم باستخدام رخصتكم التجارية وتفاصيل العمل. هذه خطوة الأساس، ولا شيء آخر يتقدم حتى تُجتاز.</p>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem; text-align:center;">اعتماد اسم العرض</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الاسم الذي يراه العملاء عندما يراسلهم عملكم يحتاج اعتماداً خاصاً به، ويجب أن يطابق عن كثب اسم عملكم المسجّل وهويته التجارية.</p>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem; text-align:center;">اعتماد رسائل القالب</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">كل رسالة تخططون لإرسالها خارج نافذة الرد الأربع وعشرين ساعة تحتاج اعتماد Meta مقدماً، مُراجَعة مقابل قواعد تنسيق وفئة صارمة.</p>
      </div>
      <div class="card">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem; text-align:center;">تسجيل رقم الهاتف</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">يُسجَّل رقمكم على الـ API، إما رقم جديد أو رقمكم الحالي مُنقَل من التطبيق المجاني، وبعدها لا يستطيع الاستخدام في التطبيق القياسي بعد الآن.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHY REJECTED -->
<section class="section" aria-labelledby="rejected-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="rejected-heading">لماذا تُرفَض الطلبات</h2>
      <p>ثلاثة أسباب تشكّل معظم الرفض الذي نراه.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عدم تطابق اسم العرض</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">اسم العرض الذي تقدمونه يحتاج مطابقة واضحة لعملكم، كما هو مسجّل وكما يتعرف عليه العملاء. اسم عام جداً، يشمل لغة ترويجية، أو لا يطابق رخصتكم التجارية يُعلَّم.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تصنيف فئة خاطئ</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">اختيار فئة عمل خاطئة، أو تقديم قوالب لا تطابق الفئة التي اخترتموها، سبب رفض شائع وقابل للتجنب. يجب أن تعكس الفئة ما يفعله عملكم فعلياً، لا الخيار الأوسع المتاح.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مشاكل نص القالب</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">قوالب تُقرَأ كتسويق بحت عند تقديمها تحت فئة خدمية أو معاملاتية، تستخدم تنسيقاً غير مدعوم، أو تشمل نص عنصر نائب غامضاً دون سياق، تُرفَض على أساس النص أكثر بكثير مما تتوقعه الأعمال.</p>
      </div>
    </div>
  </div>
</section>

<!-- COST -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cost-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="cost-heading">كم يكلف</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="icon-box" style="margin:0 auto 1rem;"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">payments</span></div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">رسوم محادثة Meta</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تُفرَض لكل محادثة، مصنّفة حسب النوع (تسويقية، خدمية، مصادقة، خدمة)، وتُفوتِرها Meta مباشرة بغض النظر عن BSP الذي تستخدمونه.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="icon-box" style="margin:0 auto 1rem;"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">hub</span></div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">رسوم BSP/المنصة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">رسم شهري أو قائم على الاستخدام تفرضه المنصة التي تمنحكم الوصول التقني للـ API، فوق رسوم محادثة Meta نفسها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="icon-box" style="margin:0 auto 1rem;"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">build</span></div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكلفة البناء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تكلفة المشروع لمرة واحدة للأتمتة الفعلية: تصميم التدفق، التكامل، والاختبار.</p>
      </div>
    </div>
  </div>
</section>

<!-- CHOOSING A BSP -->
<section class="section" aria-labelledby="bsp-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="bsp-heading" style="margin-bottom:1.5rem;">اختيار BSP في الإمارات</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        BSP (مزوّد حلول الأعمال) المنصة التي تمنحكم الوصول التقني لـ WhatsApp Business API، لأن Meta لا تبيع وصولاً مباشراً لمعظم الأعمال. ما يهم فعلياً عند اختيار واحد: تسعير شفاف وقابل للتوقع بدلاً من مستويات مجمّعة مربكة، وقت تشغيل موثوق، وصول مباشر للـ API الأساسية فيستطيع مطور بناء أتمتة حقيقية بدلاً من الانحصار في واجهة محادثة BSP المحدودة الخاصة، ودعم سريع الاستجابة أثناء عملية الاعتماد نفسها، لأن ذلك عندما تتعثر الأمور غالباً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        نعمل عبر BSPs الراسخة بدلاً من دفع العملاء نحو منصة محددة واحدة، ونوصي بالتي تناسب حجم، ميزانية، واحتياجات تكامل عملكم أثناء الاكتشاف، لا إجابة واحدة تناسب الجميع.
      </p>
    </div>
  </div>
</section>

<!-- TIMELINE -->
<section class="section" style="background:#e7eeff;" aria-labelledby="timeline-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="timeline-heading" style="margin-bottom:1.5rem;">الجدول الزمني: كم يستغرق الاعتماد واقعياً</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        التحقق من العمل عادة أسرع خطوة عندما تكون مستنداتكم مرتّبة، غالباً تُجتاز خلال بضعة أيام عمل. اعتماد اسم العرض واعتماد القالب يمكن أن يستغرقا كل منهما من يوم لأكثر من أسبوع، حسب طابور مراجعة Meta وهل يحتاج التقديم تعديلات بعد رفض أولي. واقعياً، خططوا لأسبوعين لأربعة من بدء الطلب حتى امتلاك رقم معتمَد يرسل قوالب معتمَدة، وعاملوا أي شيء أسرع كمفاجأة سارة لا التوقع.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        الرافعة الأكبر الوحيدة التي يملكها عمل على هذا الجدول الزمني هي جعل اسم العرض والقوالب الأولى صحيحة في التقديم الأول. الرفض يضيف أياماً كل مرة، لذا يستحق أن يراجع التقديم شخص مرّ بالعملية من قبل بدلاً من التخمين حول ما تريده Meta.
      </p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section" aria-labelledby="faq-heading">
  <div class="container" style="max-width:720px;">
    <div class="section-header">
      <h2 id="faq-heading">أسئلة حول WhatsApp Business API</h2>
    </div>
    <FaqAccordion items={faqItems} />
  </div>
</section>

<!-- FINAL CTA -->
<div class="cta-band">
  <div style="position:relative; z-index:1; text-align:center;">
    <p class="cta-eyebrow">استشارة مجانية</p>
    <h2 style="font-size:clamp(1.75rem,3vw,2.5rem); margin-bottom:1rem;">احصلوا على مساعدة بطلب API الخاص بكم</h2>
    <p style="font-size:1.125rem; max-width:36rem; margin:0 auto 2rem; line-height:1.7;">سنتولى التحقق من العمل، اسم العرض، وتقديم القوالب، ونبني الأتمتة خلفها بمجرد اعتمادكم. دون التزام.</p>
    <div class="cta-trust-badges">
      <span class="cta-trust-badge">✓ مجاني ١٠٠٪</span>
      <span class="cta-trust-badge">✓ دون التزام</span>
      <span class="cta-trust-badge">✓ ضمان استرداد</span>
    </div>
    <button onclick="openModal(this)" data-source="ar_whatsapp-business-api_cta" class="btn-primary" style="font-size:1.125rem; padding:1.125rem 2.75rem;">احصلوا على مساعدة بطلب API الخاص بكم</button>
    <p style="font-size:.875rem; margin-top:1rem; color:#94a3b8;">مكالمة ٣٠ دقيقة · دون ضغط بيعي</p>
  </div>
</div>

</ArBaseLayout>

