---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

const faqItems = [
  { question: "هل يمكنكم إرسال نموذج تقرير مراقبة قبل أن نلتزم بأي شيء؟", answer: "نعم. سنشرح لكم تقريراً حقيقياً من أحد أنظمتنا المُشغّلة فعلياً خلال مكالمة التقييم، مع إخفاء أرقام العميل، لتروا بالضبط ما ينتجه شهر من المراقبة: حجم المحادثات، التكلفة لكل تفاعل، اتجاه الدقة، وما غيّرناه بناءً عليه. معظم الناس يجدونه أكثر إقناعاً من أي عرض تقديمي، لأنه دليل، لا وعد." },
  { question: "كم تستغرق استجابتكم عند إطلاق تنبيه؟", answer: "يعتمد على مستوى العقد وشدة المشكلة. انقطاع كامل، حيث لا يستطيع الوكيل الوصول لنظام يعتمد عليه، يُعامَل كحالة عاجلة ويُعالَج في نفس اليوم، عادة خلال ساعتين في أوقات الدوام. انخفاض بسيط في الجودة، كأن يجيب الوكيل بشكل أضعف قليلاً على موضوع واحد، يُراجَع ويُصلَح في الجولة المجدولة التالية بدلاً من إطلاق حالة طوارئ. نتفق معكم على أوقات استجابة محددة قبل الإطلاق، فلا يخمّن أحد أثناء حادثة فعلية." },
  { question: "ما الذي يُعتبر فعلياً 'فشلاً' يستحق التنبيه؟", answer: "ثلاث فئات: عجز الوكيل عن إنجاز مهمته كلياً (تكامل معطل، استدعاء أداة يفشل)، إعطاء الوكيل إجابة خاطئة أو غير آمنة يُبلّغ عنها عميل أو يلتقطها تقييمنا، أو ارتفاع التكلفة لكل محادثة بشكل ملحوظ عن نطاقها الطبيعي. نحدد العتبات المحددة معكم بناءً على ما يفعله وكيلكم وكم تكلفكم الإجابة الخاطئة فعلياً، لأن خطأ في سؤال عن التسعير أهم من خطأ بسيط في سؤال عام شائع." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "مراقبة وكلاء الذكاء الاصطناعي (AgentOps)",
    "url": "https://lenooai.com/ar/services/agentops",
    "description": "مراقبة وتقييم وتقارير عائد استثمار شهرية لوكلاء الذكاء الاصطناعي المُشغّلة في الإمارات. تتبع الدقة، التكلفة لكل محادثة، رصد الانحراف، والاستجابة للحوادث."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "مراقبة الوكلاء", "item": "https://lenooai.com/ar/services/agentops" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "مراقبة وكلاء الذكاء الاصطناعي (AgentOps)",
    "url": "https://lenooai.com/ar/services/agentops",
    "description": "مراقبة وتقييم وتقارير عائد استثمار شهرية لوكلاء الذكاء الاصطناعي: تتبع الدقة، التكلفة لكل محادثة، رصد الانحراف، والاستجابة للحوادث.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Agent Monitoring"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="مراقبة وكلاء الذكاء الاصطناعي: منظومة المراقبة خلف كل نظام نبنيه | Lenoo AI"
  description="كيف نراقب وكلاء الذكاء الاصطناعي بعد الإطلاق: تتبع الدقة، التكلفة لكل محادثة، رصد الانحراف، وتقرير شهري يُثبت العائد بدلاً من افتراضه."
  canonicalPath="/ar/services/agentops"
  enPath="/services/agentops"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>مراقبة الوكلاء</div>
    <h1>منظومة <span class="gradient-text">مراقبة الذكاء الاصطناعي</span> خلف كل نظام نبنيه</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">"إنه يعمل" ليست مقياساً. نراقب كل وكيل ننشره من حيث الدقة والتكلفة والانحراف، ونرسل تقريراً شهرياً يُظهر بالضبط ماذا يفعل وما قيمته، لا مجرد فاتورة تطلب منكم الثقة بنا.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_agentops_hero" class="btn-primary">شاهد نموذج تقرير مراقبة</button>
      <a href="/ar/services/agentops/what-is-agentops" class="btn-outline">ما هو AgentOps؟ ←</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1600&q=80&auto=format&fit=crop" alt="لوحة تحليلات تعرض مقاييس أداء حية" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">٥</p>
        <p class="stat-lbl">إشارات نتتبعها في كل وكيل: الدقة، التكلفة، زمن الاستجابة، الرضا، الانحراف</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">شهري</p>
        <p class="stat-lbl">معدل التقارير، لتروا الاتجاه لا لقطة واحدة فقط</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١</p>
        <p class="stat-lbl">فريق واحد بنى الوكيل ويراقبه، دون تسليم لطرف غريب</p>
      </div>
    </div>
  </div>
</div>

<!-- INTRO -->
<section class="section" aria-labelledby="intro-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="intro-heading" style="margin-bottom:1.5rem;">لماذا "إنه يعمل" لا تكفي للعمل التجاري</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم مزودي الذكاء الاصطناعي يسلّمونكم بيانات دخول ويختفون.</strong> يُطلق الوكيل، يختبره أحدهم بضع مرات، يبدو جيداً، وهذا آخر تدقيق حتى يشتكي عميل. "إنه يعمل" يصبح شعوراً لا حقيقة، مبنياً على غياب الشكاوى لا على أي قياس فعلي لما يفعله الوكيل عبر مئات المحادثات التي لم يقرأها أحد.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">هذه الفجوة هي حيث تتسرب معظم قيمة نظام الذكاء الاصطناعي بصمت. وكيل دقته ٩٥٪ يبدو جيداً حتى تدركوا أي ٥٪ يخطئ فيها، فإذا كان سؤال تسعير أو سياسة استرداد ضمن هذه الـ٥٪، فتكلفة عدم المعرفة أعلى بكثير من تكلفة اكتشافها. دون مراقبة حقيقية، لا تختارون أي الأخطاء تهم. تكتشفونها في النهاية فقط، عادة من شخص غير راضٍ.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">بنينا منظومة المراقبة لأننا سئمنا سماع عملاء يسألون "هل يعمل فعلاً؟" دون إجابة واثقة سوى "لم يشتكِ أحد". كل وكيل ننشره يُبلّغ: ماذا تعامل معه، بكم كلّف، ماذا أصاب، وماذا أخطأ، فيكون للسؤال إجابة حقيقية كل شهر، لا استغراباً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&q=80&auto=format&fit=crop" alt="فريق يراجع رسوماً بيانية ومقاييس أداء معاً" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE MONITOR -->
<section id="what-we-monitor" class="section" style="background:#e7eeff;" aria-labelledby="monitor-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="monitor-heading">ما الذي نراقبه</h2>
      <p>خمس إشارات، تُفحص على جدول محدد، لا كلما تذكّر أحدهم النظر.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">rule</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الدقة ومعدل التصعيد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">عينة من محادثات حقيقية تُراجَع مقابل إجابات معروفة الصحة، بالإضافة إلى معدل تحويل الوكيل للبشر. ارتفاع معدل التصعيد عادة أول إشارة على تقادم معرفة الوكيل أو منطقه.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">payments</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التكلفة لكل محادثة/مهمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">استهلاك الرموز وتكلفة API مُقسّمة لكل تفاعل، متتبعة عبر الزمن، فيظهر أمر تعليمات متضخم أو استدعاء أداة غير ضروري كرقم محدد وقابل للإصلاح بدلاً من بند غامض في فاتورة الشهر القادم.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">زمن الاستجابة ووقت التشغيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">كم يستغرق الوكيل للرد، وهل يمكن الوصول إليه أصلاً. الوكيل البطيء يخسر عملاء بنفس فعالية الخاطئ، والتكامل الذي يتعطل بصمت يبقي الوكيل يتحدث بينما هو معطل فعلياً.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">sentiment_satisfied</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إشارات الرضا</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حيث تتوفر، ردود الإعجاب وعدمه، الأسئلة المتكررة، المحادثات التي تنتهي بإحباط أو تخلٍّ، تُقرأ كإشارة، لا مجرد رقم في جدول بيانات لا يفتحه أحد.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">show_chart</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الانحراف عبر الزمن</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">دقة هذا الشهر مقارنة بدقة شهر الإطلاق، على نفس مجموعة الاختبار. الانحراف بطيء وصامت بطبيعته؛ الطريقة الوحيدة لرصده مبكراً هي قياس نفس الشيء بنفس الطريقة، كل شهر.</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">المراقبة مدمجة في كل نشر، لا تُباع كإضافة منفصلة بعد أن يحدث خطأ ما.</p>
      <button onclick="openModal(this)" data-source="ar_agentops_mid" class="btn-primary">شاهد نموذج تقرير مراقبة</button>
    </div>
  </div>
</section>

<!-- MONTHLY REPORT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="report-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="report-heading">تقرير عائد الاستثمار الشهري</h2>
      <p>ما يصل فعلياً لبريدكم، مرة كل شهر، سواء حدث خطأ أم لا.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجم والنتائج</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">كم محادثة تعامل معها الوكيل، كم منها حلّها دون بشري، وكم صعّدها بشكل صحيح، فترون بالضبط ما يُزيله فعلياً عن كاهل فريقكم ذلك الشهر.</p>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">اتجاه التكلفة والدقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">التكلفة لكل محادثة ودرجة الدقة، مرسومة مقابل الشهر الماضي، فيظهر أي انحراف بطيء في أي اتجاه قبل أن يصبح مشكلة تسمعون بها من عميل بدلاً من تقرير.</p>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">ماذا غيّرنا، ولماذا</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">الإصلاحات المحددة التي تمت ذلك الشهر، تحديث أمر تعليمات، سؤال شائع جديد، تكامل معطل تم إصلاحه، مرتبطة بالمشكلة المحددة التي دفعت لكل منها. لا "كل شيء بخير" عامة، بل قائمة فعلية.</p>
      </div>
    </div>
  </div>
</section>

<!-- CATCHING FAILURES -->
<section class="section" aria-labelledby="alert-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="alert-heading">رصد الأعطال قبل عملائكم</h2>
      <p>تنبيهات وعتبات محددة قبل الإطلاق، لا مرتجلة بعد أول شكوى.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">عتبات تُحدد معكم، لا لكم</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">قبل إطلاق الوكيل، نتفق على ما يُعتبر عاجلاً لعملكم تحديداً: الانقطاع دائماً عاجل، الإجابة الخاطئة على سؤال تسعير عاجلة، تأخر بسيط في رد على سؤال منخفض المخاطر عادة ليس كذلك. العتبات العامة تفوّت الأعطال التي تهمكم فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">emergency</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استجابة محددة، لا ارتباك</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">لكل تنبيه مسؤول ووقت استجابة محدد مسبقاً، فعندما تتخطى مشكلة عتبة ما، توجد خطة جاهزة بدلاً من محادثة جماعية تحاول معرفة من المسؤول عن النظر فيها.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S IN THE RETAINER -->
<section class="section" style="background:#e7eeff;" aria-labelledby="retainer-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto; text-align:center;">
      <h2 id="retainer-heading" style="margin-bottom:1.25rem;">ما الذي يشمله العقد الشهري</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.5rem;">المراقبة جزء واحد من عقد صيانة أوسع يغطي أيضاً إصلاح الأخطاء، ضبط الأوامر، تحديثات النماذج، ودعماً بأولوية، كلها من نفس الفريق الذي بنى الوكيل أصلاً. إذا أردتم التفصيل الكامل لما يشمله وما لا يشمله وتكلفة كل مستوى، تجدونه في صفحة الصيانة لدينا.</p>
      <a href="/ar/services/ai-maintenance" class="btn-outline" style="border-color:#006875; color:#006875;">شاهد ما يشمله العقد الفعلي ←</a>
    </div>
  </div>
</section>

<!-- TOOLS AND STACK -->
<section class="section" aria-labelledby="stack-heading">
  <div class="container">
    <div class="section-header">
