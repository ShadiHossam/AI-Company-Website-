---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل تستطيعون إرسال نموذج لتقرير المراقبة قبل أن نلتزم بأي شيء؟", answer: "نعم. سنستعرض معكم في مكالمة التقييم تقريراً حقيقياً من أحد أنظمتنا العاملة، مع حجب أرقام العميل، لتروا بالضبط ما ينتجه شهر من المراقبة: حجم المحادثات، وتكلفة كل تفاعل، واتجاه الدقة، وما غيرناه بناءً على ذلك. معظم الناس يجدونه أكثر إقناعاً من أي عرض بيعي نقدمه، لأنه دليل لا وعد." },
  { question: "ما سرعة استجابتكم حين يصدر تنبيه؟", answer: "يعتمد ذلك على مستوى عقد الصيانة وشدة المشكلة. التوقف الكامل، حين لا يستطيع الوكيل الوصول إلى نظام يعتمد عليه، يُعامل كأمر عاجل ويُعالج في نفس اليوم، عادةً خلال ساعتين في ساعات العمل. أما تراجع الجودة، حين تسوء إجابات الوكيل قليلاً في موضوع واحد، فيُراجع ويُصلح في الجولة المجدولة التالية بدلاً من إطلاق حالة طوارئ. نتفق معكم على أوقات استجابة محددة قبل إطلاق أي شيء، فلا يخمّن أحد أثناء حادث فعلي." },
  { question: "ما الذي يُعد فعلاً «فشلاً» يستحق التنبيه؟", answer: "ثلاث فئات: الوكيل لا يستطيع إنجاز عمله إطلاقاً (تكامل متوقف، أو استدعاء أداة يفشل)، أو يعطي إجابة خاطئة أو غير آمنة ينبّه إليها عميل أو يلتقطها تقييمنا، أو ترتفع تكلفة المحادثة كثيراً عن نطاقها المعتاد. نحدد العتبات معكم بناءً على ما يفعله وكيلكم وكم تكلفكم الإجابة السيئة فعلاً، لأن الإجابة الخاطئة عن سؤال تسعير أهم من إجابة غير دقيقة قليلاً عن سؤال عام." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AgentOps ومراقبة وكلاء الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/agentops",
    "description": "مراقبة وتقييم مستمران وتقارير شهرية عن العائد لوكلاء الذكاء الاصطناعي المنشورين في الإمارات. تتبع الدقة، وتكلفة كل محادثة، ورصد الانحراف، والاستجابة للحوادث.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "مراقبة وكلاء الذكاء الاصطناعي"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "AgentOps", "item": "https://lenooai.com/ar/services/agentops" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="مراقبة وكلاء الذكاء الاصطناعي ورصد أدائهم | Lenoo AI"
  description="كيف نراقب وكلاء الذكاء الاصطناعي بعد الإطلاق: تتبع الدقة، وتكلفة كل محادثة، ورصد الانحراف، وتقرير شهري يثبت العائد بدلاً من افتراضه."
  canonicalPath="/ar/services/agentops"
  enPath="/services/agentops"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>AgentOps</div>
    <h1><span class="gradient-text">منظومة مراقبة الذكاء الاصطناعي</span> خلف كل نظام نبنيه</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">«إنه يعمل» ليس مقياساً. نراقب كل وكيل ننشره من حيث الدقة والتكلفة والانحراف، ونرسل تقريراً شهرياً يوضح بالضبط ما يفعله وما قيمته، لا مجرد فاتورة تطلب منكم الثقة بنا.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_agentops_hero" class="btn-primary">شاهدوا نموذجاً لتقرير المراقبة</button>
      <a href="/ar/services/agentops/what-is-agentops" class="btn-outline">ما هو AgentOps؟ ←</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1600&q=80&auto=format&fit=crop" alt="لوحة تحليلات تعرض مؤشرات الأداء الحية" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٥", caption: "مؤشرات نتتبعها في كل وكيل: الدقة، والتكلفة، وزمن الاستجابة، والرضا، والانحراف" },
      { value: "شهرياً", caption: "وتيرة التقارير، لتروا الاتجاه لا لقطة واحدة فقط" },
      { value: "١", caption: "فريق واحد بنى الوكيل ويراقبه، دون تسليمه لطرف غريب" },
    ]} />
  </div>
</div>

<!-- INTRO -->
<section class="section" aria-labelledby="intro-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="intro-heading" style="margin-bottom:1.5rem;">لماذا «إنه يعمل» لا يكفي للعمل</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم موردي الذكاء الاصطناعي يسلمونكم بيانات الدخول ويختفون.</strong> ينطلق الوكيل، ويختبره أحدهم بضع مرات، فيبدو جيداً، وتلك آخر مرة يراجعه أحد حتى يشتكي عميل. تصبح «إنه يعمل» شعوراً لا حقيقة، قائماً على غياب الشكاوى لا على أي قياس فعلي لما يفعله الوكيل عبر مئات المحادثات التي لم يقرأها أحد.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">هذه الفجوة هي حيث تتسرب معظم قيمة نظام الذكاء الاصطناعي بهدوء. وكيل بدقة ٩٥٪ يبدو جيداً حتى تدركوا أي ٥٪ يخطئ فيها. فإذا كان سؤال تسعير أو سياسة استرداد ضمن تلك الـ ٥٪، فتكلفة عدم المعرفة أعلى بكثير من تكلفة الاكتشاف. ودون مراقبة حقيقية، لا تختارون أي الأخطاء مهمة، بل تكتشفونها في النهاية، عادةً من شخص غير راضٍ.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">بنينا منظومة المراقبة لأننا سئمنا من سؤال العملاء «هل يعمل فعلاً؟» دون إجابة واثقة سوى «لم يشتكِ أحد». كل وكيل ننشره يقدم تقريراً: ما تولاه، وما كلفه، وما أصاب فيه، وما أخطأ فيه، فيكون للسؤال إجابة حقيقية كل شهر، لا هزة كتف.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&q=80&auto=format&fit=crop" alt="فريق يراجع الرسوم البيانية ومؤشرات الأداء معاً" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE MONITOR -->
<section id="what-we-monitor" class="section" style="background:#e7eeff;" aria-labelledby="monitor-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="monitor-heading">ما نراقبه</h2>
      <p>خمسة مؤشرات، تُفحص وفق جدول محدد، لا حين يتذكر أحدهم النظر.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">rule</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الدقة ومعدل التصعيد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">عينة من المحادثات الحقيقية تُراجع مقابل إجابات صحيحة معروفة، إضافة إلى عدد مرات تحويل الوكيل إلى شخص. ارتفاع معدل التصعيد عادةً أول علامة على أن شيئاً في معرفة الوكيل أو منطقه قد تقادم.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">payments</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التكلفة لكل محادثة أو مهمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إنفاق الرموز وتكلفة الواجهات البرمجية مفصلة لكل تفاعل، ومتتبعة عبر الزمن، فيظهر التوجيه المتضخم أو استدعاء الأداة الزائد كرقم محدد قابل للإصلاح بدلاً من بند غامض في فاتورة الشهر القادم.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">زمن الاستجابة ووقت التشغيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">كم يستغرق الوكيل للرد، وهل يمكن الوصول إليه أصلاً. الوكيل البطيء يخسر العملاء بنفس فعالية الوكيل المخطئ، والتكامل الذي ينقطع بصمت يبقي الوكيل يتحدث وهو معطل فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">sentiment_satisfied</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مؤشرات الرضا</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حيث توجد: تقييمات الإعجاب وعدمه، والأسئلة المتكررة، والمحادثات التي تنتهي بإحباط أو انسحاب، تُقرأ كإشارة، لا كرقم في جدول بيانات لا يفتحه أحد.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">show_chart</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الانحراف عبر الزمن</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">دقة هذا الشهر مقارنة بدقة شهر الإطلاق، على نفس مجموعة الاختبار. الانحراف بطيء وهادئ بطبيعته، والطريقة الوحيدة لالتقاطه مبكراً هي الاستمرار في قياس نفس الشيء بنفس الطريقة كل شهر.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">المراقبة مدمجة في كل نظام ننشره، لا تُباع كإضافة منفصلة بعد أن يكون شيء قد تعطل.</p>
      <button onclick="openModal(this)" data-source="ar_agentops_mid" class="btn-primary">شاهدوا نموذجاً لتقرير المراقبة</button>
    </div>
  </div>
</section>

<!-- MONTHLY REPORT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="report-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="report-heading">التقرير الشهري للعائد</h2>
      <p>ما يصل فعلاً إلى بريدكم مرة كل شهر، سواء حدث خطأ أم لا.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجم والنتائج</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">كم محادثة تولاها الوكيل، وكم منها حلها دون شخص، وكم صعّدها بشكل صحيح، لتروا ما يرفعه فعلاً عن كاهل فريقكم ذلك الشهر.</p>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">اتجاه التكلفة والدقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">تكلفة المحادثة ودرجة الدقة، مقارنة بالشهر الماضي، فيظهر الانحراف البطيء في أي اتجاه قبل أن يصبح مشكلة تسمعون بها من عميل بدلاً من تقرير.</p>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">ما غيرناه، ولماذا</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">الإصلاحات المحددة التي أُجريت ذلك الشهر، مثل تحديث توجيه، أو إضافة سؤال شائع جديد، أو إصلاح تكامل معطل، مربوطة بالمشكلة المحددة التي استدعت كلاً منها. لا «كل شيء جيد» عامة، بل قائمة فعلية.</p>
      </div>
    </div>
  </div>
</section>

<!-- CATCHING FAILURES -->
<section class="section" aria-labelledby="alert-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="alert-heading">التقاط الأعطال قبل أن يلاحظها عملاؤكم</h2>
      <p>تنبيهات وعتبات تُحدد قبل الإطلاق، لا تُرتجل بعد أول شكوى.</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">عتبات تُحدد معكم، لا نيابة عنكم</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">قبل إطلاق الوكيل، نتفق على ما يُعد عاجلاً لعملكم تحديداً: التوقف عاجل دائماً، والإجابة الخاطئة عن سؤال تسعير عاجلة، والرد الأبطأ قليلاً على سؤال شائع قليل الأهمية ليس عاجلاً عادةً. العتبات العامة تفوّت الأعطال التي تهمكم فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">emergency</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استجابة محددة، لا تخبط</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">لكل تنبيه مسؤول وزمن استجابة محددان مسبقاً، فحين يتجاوز شيء عتبة ما، تكون هناك خطة جاهزة بدلاً من مجموعة محادثة تحاول معرفة من يُفترض أن ينظر في الأمر.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S IN THE RETAINER -->
<section class="section" style="background:#e7eeff;" aria-labelledby="retainer-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto; text-align:center;">
      <h2 id="retainer-heading" style="margin-bottom:1.25rem;">ما يتضمنه عقد الصيانة</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.5rem;">المراقبة جزء من عقد صيانة أوسع يشمل أيضاً إصلاح الأخطاء، وضبط التوجيهات، وتحديثات النماذج، والدعم ذي الأولوية، وكلها يتولاها نفس الفريق الذي بنى الوكيل أصلاً. وإذا أردتم التفصيل الكامل لما هو مشمول وما ليس مشمولاً وتكلفة كل مستوى، فستجدونه في صفحة الصيانة.</p>
      <a href="/ar/services/ai-maintenance" class="btn-outline" style="border-color:#006875; color:#006875;">شاهدوا ما يتضمنه عقد الصيانة الحقيقي ←</a>
    </div>
  </div>
</section>

<!-- TOOLS AND STACK -->
<section class="section" aria-labelledby="stack-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="stack-heading">الأدوات والتقنيات التي نستخدمها</h2>
      <p>طبقة المراقبة تعمل بجانب أي منصة يعمل عليها الوكيل نفسه، بأدوات تسجيل وتقييم وتنبيه تناسب حجم النظام ومستوى مخاطره، من تسجيل خفيف لروبوت واتساب واحد إلى مسار تقييم كامل لنظام متعدد الوكلاء يتعامل مع المدفوعات أو استقبال المرضى. نختار الأدوات لتناسب ما يفعله الوكيل فعلاً، لا العكس.</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section" aria-labelledby="faq-heading">
