---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import PageHero from '../../../components/PageHero.astro';

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "ماذا تتضمن جلسة استراتيجية الذكاء الاصطناعي فعلياً؟", answer: "المرحلة الأولى: نجري مقابلات مع أصحاب القرار الرئيسيين، ونراجع سير عملكم وبياناتكم وأدواتكم الحالية. المرحلة الثانية: نحلل النتائج، نبني وثيقة خارطة الطريق، ونجهّز العرض التنفيذي. تُختتم المهمة بجلسة مدتها ٦٠ دقيقة نعرض فيها خارطة الطريق كاملة." },
  { question: "هل تُخصم تكلفة جلسة الاستراتيجية من تكلفة التنفيذ؟", answer: "نعم. إذا واصلتم معنا في أي باقة تطوير ذكاء اصطناعي مخصص بعد جلسة الاستراتيجية، تُخصم تكلفة الجلسة كاملة من تكلفة مشروعكم. هذا يجعل جلسة الاستراتيجية مجانية فعلياً عند دمجها مع التنفيذ." },
  { question: "هل نحن ملزمون بالتعامل مع شركتكم في التنفيذ؟", answer: "لا. وثيقة خارطة الطريق ملك لكم. أنتم أحرار في استخدامها للبناء معنا، أو التعاقد مع فريق آخر، أو التنفيذ داخلياً. نحن واثقون أن جودة تنفيذنا ستجعل الاختيار واضحاً." },
  { question: "كم شخصاً من شركتنا يجب أن يشارك؟", answer: "من الأفضل ٢ إلى ٤ من أصحاب القرار: صاحب القرار النهائي (الرئيس التنفيذي أو مدير العمليات)، ومدير عمليات، ويُفضَّل رئيس قسم من المجال الذي تهتمون بتحسينه أكثر. المقابلات تأخذ من فريقكم ساعة إلى ساعتين إجمالاً طوال فترة المهمة." },
  { question: "بدأنا فعلاً باستخدام بعض أدوات الذكاء الاصطناعي. هل ما زالت جلسة الاستراتيجية منطقية؟", answer: "غالباً أكثر من ذي قبل. البدء دون استراتيجية يعني أنكم ربما اتخذتم بعض القرارات الجيدة وبعض القرارات المكلفة. جلسة الاستراتيجية تساعدكم على تقييم ما ينجح، وما يجب إيقافه أو استبداله، وكيف تبنون على ما لديكم بخطة متماسكة. كثير من عملائنا يأتون ولديهم بعض الأدوات قيد التشغيل، ويغادرون بصورة واضحة عن كيفية جعلها تعمل معاً." },
  { question: "لأي حجم من الشركات صُممت هذه الخدمة؟", answer: "أجرينا جلسات استراتيجية لشركات تتراوح من فرق من ١٥ شخصاً إلى مؤسسات كبيرة. الصيغة تتكيف مع الحجم: الشركة الأصغر تحصل على توصيات مركّزة ومرتبة حسب الأولوية، والمؤسسة الأكبر تحصل على خارطة طريق كاملة لعدة أقسام. في الحالتين، المخرج وثيقة تستطيعون العمل بها فعلاً، لا إطار عام عليه شعاركم." },
  { question: "ما مدى حداثة معرفتكم بمشهد الذكاء الاصطناعي التي تقدمونها في الجلسة؟", answer: "حديثة جداً. قدرات الذكاء الاصطناعي تتغير بسرعة، ونحن منخرطون بنشاط في هذا المجال. سنخبركم بما أصبح ممكناً حديثاً ولم يكن عملياً قبل ستة أشهر، وما الأدوات التي ظهرت في قطاعكم، وأين ما زالت الضجة تتجاوز الواقع. خارطة الطريق التي نسلّمها تعكس حالة الذكاء الاصطناعي اليوم، لا العام الماضي." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_strategy')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="استشارات استراتيجية الذكاء الاصطناعي في الإمارات: خارطة طريق تبدأ بالعائد"
  description="لا تعرفون من أين تبدؤون مع الذكاء الاصطناعي؟ نحن وكالة ذكاء اصطناعي في دبي نرسم خارطة طريقكم، نحسب العائد، ونسلّمكم خطة واضحة لـ ١٢ شهراً."
  canonicalPath="/ar/services/ai-strategy"
  enPath="/services/ai-strategy"
  ogImage="/assets/og-ai-strategy.jpg"
  ldJson={[faqLdJson]}
>

<!-- ── HERO ── -->
<PageHero image={{ src: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1400&q=80&auto=format&fit=crop", alt: "جلسة استشارات استراتيجية ذكاء اصطناعي مع قادة أعمال", position: "center 35%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>استشارات استراتيجية الذكاء الاصطناعي</div>
  <h1 style="max-width: 52rem; margin: 0 auto 1.5rem;">
    اعرفوا بالضبط أي ذكاء اصطناعي تبنون<br>
    <span class="gradient-text">قبل أن تنفقوا درهماً واحداً.</span>
  </h1>
  <p style="color: rgba(255,255,255,0.72); font-size: 1.125rem; line-height: 1.75; max-width: 38rem; margin: 0 auto 0;">
    جلسة استراتيجية الذكاء الاصطناعي تعطيكم خارطة طريق واضحة ومرتبة حسب الأولوية: استثمارات الذكاء الاصطناعي الصحيحة، بالترتيب الصحيح، مع توقعات عائد واقعية.
  </p>
  <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
    <span class="tchip">تكلفة الجلسة تُخصم بالكامل إذا واصلتم معنا في التنفيذ</span>
    <span class="tchip">أشهر من مبادرات الذكاء الاصطناعي، مرتبة ومتسلسلة</span>
  </div>
  <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
    <button onclick="openModal(this)" data-source="ar_strategy_hero" class="btn-primary" style="font-size: 1rem;">
      احجزوا جلسة استراتيجية الذكاء الاصطناعي ←
    </button>
    <a href="#what-you-get" class="btn-outline" style="font-size: 1rem;">شاهدوا المخرجات ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "١٢", caption: "شهراً من مبادرات الذكاء الاصطناعي، مرتبة ومتسلسلة حتى تعرفوا بالضبط ما تبنونه أولاً" },
    ]} />
  </div>
</PageHero>

<!-- WHY AI STRATEGY MATTERS -->
<section class="section" aria-labelledby="why-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="why-heading" style="margin-bottom:1.5rem;">لماذا استراتيجية الذكاء الاصطناعي ليست خياراً إضافياً</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          معظم الشركات تتعامل مع الذكاء الاصطناعي أداة تلو الأخرى: أحدهم في فريق التسويق يشتري مساعد كتابة، وفريق العمليات يجرّب أداة أتمتة، والرئيس التنفيذي يستخدم روبوت محادثة مختلفاً تماماً. كل اختيار قد يبدو منطقياً بمفرده، لكن دون استراتيجية تكون النتيجة مجموعة أدوات منفصلة لا تتراكم فائدتها، ولا تتكامل، ولا تحقق الأثر الذي يستطيع الذكاء الاصطناعي تحقيقه فعلاً.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          استراتيجية الذكاء الاصطناعي الصحيحة تجيب عن الأسئلة التي يتجاهلها التبنّي أداةً بأداة: أي مشاكل العمل يجب أن نعطيها الأولوية؟ أين سيحقق الذكاء الاصطناعي أسرع عائد؟ ما البيانات المتوفرة لدينا، وهل هي كافية؟ أي سير عمل يجب أتمتته بالكامل وأيها يكفي دعمه؟ أين تحدّ الأنظمة أو متطلبات الامتثال من خياراتنا؟ ماذا نبني وماذا نشتري؟ والأهم: بأي ترتيب ننفذ كل هذا حتى تشكّل الاستثمارات الأولى أساساً لما يليها؟
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=800&q=80&auto=format&fit=crop" alt="فريق قيادة في شركة بدبي يرسم أولويات الذكاء الاصطناعي على لوح أبيض خلال جلسة استراتيجية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      الشركات التي تحصل على قيمة كبيرة من الذكاء الاصطناعي ليست تلك التي تحركت أسرع، بل تلك التي تحركت في الاتجاه الصحيح. الاستراتيجية الواضحة تمنع هدر الاستثمار، والاحتكاك داخل المؤسسة الناتج عن إطلاقات سيئة التخطيط، والنتيجة الشائعة جداً: إنفاق المال على ذكاء اصطناعي لا يستخدمه أحد في النهاية.
    </p>
  </div>
</section>

<!-- ── WHO NEEDS THIS ── -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem;">هل هذه الخدمة مناسبة لكم؟</p>
      <h2 id="who-heading">من يحتاج جلسة استراتيجية الذكاء الاصطناعي</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=1200&q=80&auto=format&fit=crop" alt="منطقة الأعمال في دبي عند الغروب، حيث تخطط شركات الإمارات لاستثمارها القادم في الذكاء الاصطناعي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-3" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: #e7eeff; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تعرفون أن الذكاء الاصطناعي يستحق الاستثمار، لكنكم لستم متأكدين أي مشاكل العمل تعطونها الأولوية أولاً أو كيف تبدو نقطة البداية الواقعية.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(186,26,26,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">جرّبتم أدوات ذكاء اصطناعي وحصلتم على نتائج مخيبة. لستم متأكدين إن كانت المشكلة في الأدوات، أو في النهج، أو في طريقة تطبيقها.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(245,158,11,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تحتاجون لتقديم مبرر استثماري مقنع في الذكاء الاصطناعي للإدارة، بأرقام حقيقية وجداول زمنية وخطة تصمد أمام التدقيق.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(0,104,117,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تقررون أي قدرات ذكاء اصطناعي تبنونها أو تشترونها في العام القادم، وتريدون التأكد أن الميزانية تذهب لما سيحدث فرقاً فعلياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── WHAT YOU GET ── -->
<section id="what-you-get" class="section" style="background: #e7eeff;" aria-labelledby="deliverable-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem;">المخرجات</p>
      <h2 id="deliverable-heading">ما تشمله جلسة الاستراتيجية</h2>
      <p style="color: #42474e; max-width: 36rem; margin: 1rem auto 0; line-height: 1.7;">جلسة استراتيجية الذكاء الاصطناعي مهمة مركّزة ومنظمة. تحصلون على وثيقة كاملة وعرض تنفيذي مباشر.</p>
    </div>
    <div class="bento-grid bento-grid-3" style="margin-bottom: 4rem;">
      <div class="card">
        <div class="deliverable-num">٠١</div>
        <h3 style="margin: .75rem 0 .5rem;">تحليل الوضع الحالي</h3>
        <p style="color: #42474e; line-height: 1.7;">تقييم شامل لسير عملكم، وأصول بياناتكم، وأدواتكم الحالية، وجاهزية فريقكم للذكاء الاصطناعي.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">٠٢</div>
        <h3 style="margin: .75rem 0 .5rem;">خريطة فرص الذكاء الاصطناعي</h3>
        <p style="color: #42474e; line-height: 1.7;">كل فرصة للذكاء الاصطناعي في عملكم، مرتبة حسب العائد وقابلية التنفيذ حتى تعرفوا ما تبنونه أولاً.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">٠٣</div>
        <h3 style="margin: .75rem 0 .5rem;">توصيات البناء مقابل الشراء</h3>
        <p style="color: #42474e; line-height: 1.7;">لكل فرصة: هل تبنون ذكاءً اصطناعياً مخصصاً، أم تشترون أداة موجودة، أم الاثنين؟ نخبركم بالسبب بالضبط.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">٠٤</div>
        <h3 style="margin: .75rem 0 .5rem;">خارطة طريق الذكاء الاصطناعي لـ ١٢ شهراً</h3>
        <p style="color: #42474e; line-height: 1.7;">خطة تنفيذ مرحلية ومرتبة حسب الأولوية تغطي الشهر الأول، والربع الأول، والسنة الأولى.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">٠٥</div>
        <h3 style="margin: .75rem 0 .5rem;">توقعات الميزانية والعائد</h3>
        <p style="color: #42474e; line-height: 1.7;">متطلبات ميزانية وتوقعات عائد واقعية لكل مبادرة، بأرقام فعلية لا نسب مئوية غامضة.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">٠٦</div>
        <h3 style="margin: .75rem 0 .5rem;">مراجعة الامتثال التنظيمي</h3>
        <p style="color: #42474e; line-height: 1.7;">حوكمة البيانات، وأنظمة الخصوصية، ومتطلبات الامتثال، مربوطة بكل نظام ذكاء اصطناعي مخطط له في منطقتكم.</p>
      </div>
    </div>
    <div class="sprint-box">
      <h3 style="color: #ffffff; font-size: 1.75rem; margin-bottom: .5rem;">جلسة استراتيجية الذكاء الاصطناعي</h3>
      <p style="color: rgba(255,255,255,0.55); margin-bottom: 1.5rem;">وثيقة خارطة طريق كاملة · جلسة عرض تنفيذي · مصممة لعملكم</p>
      <p style="color: rgba(255,255,255,0.65); font-size: .9375rem; margin: 0 0 0.5rem;"><strong style="color:#00e3fd;">تسعير مخصص</strong> لكل مهمة · يتناسب مع حجم الشركة والنطاق</p>
      <p style="color: rgba(255,255,255,0.45); font-size: .8125rem; margin: 0 0 2rem;">تُخصم بالكامل من تكلفة التنفيذ إذا واصلتم معنا</p>
      <button onclick="openModal(this)" data-source="ar_strategy_sprint" class="btn-primary" style="font-size: 1rem; padding: 1rem 2.5rem;">احجزوا جلسة الاستراتيجية ←</button>
    </div>
  </div>
</section>

<!-- ── 6 DIMENSIONS ── -->
<section class="section" aria-labelledby="assess-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem;">تقييمنا</p>
      <h2 id="assess-heading">المجالات الرئيسية التي نقيّمها في عملكم</h2>
