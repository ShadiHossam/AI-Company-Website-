---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import StatStrip from '../../../components/StatStrip.astro';

const faqItems = [
  { question: "ما الذي تتضمنه جلسة الاستراتيجية فعلياً؟", answer: "المرحلة 1: نُجري مقابلات مع أصحاب المصلحة الرئيسيين، ونُراجع عملياتك الحالية وبياناتك وأدواتك. المرحلة 2: نُحلل النتائج، نبني وثيقة خارطة الطريق، ونُعدّ العرض التنفيذي. ينتهي الالتزام بجلسة مدتها 60 دقيقة نعرض فيها خارطة الطريق كاملة." },
  { question: "هل تكلفة جلسة الاستراتيجية قابلة للخصم من التنفيذ؟", answer: "نعم. إذا تابعت مع أي باقة تطوير ذكاء اصطناعي مخصصة معنا بعد جلسة الاستراتيجية، تُخصم تكلفة الجلسة بالكامل من تكلفة مشروعك. هذا يجعل جلسة الاستراتيجية مجانية فعلياً عند دمجها مع التنفيذ." },
  { question: "هل نحن ملزمون باستخدام شركتكم للتنفيذ؟", answer: "لا. وثيقة خارطة الطريق مِلك لك. أنت حر في استخدامها للبناء معنا، توظيف فريق آخر، أو التنفيذ داخلياً. نحن واثقون أن جودة تنفيذنا ستجعل الاختيار واضحاً بحد ذاته." },
  { question: "كم عدد الأشخاص من شركتنا الذين يجب أن يشاركوا؟", answer: "الأمثل هو 2 إلى 4 من أصحاب المصلحة: صانع القرار (الرئيس التنفيذي أو رئيس العمليات)، مدير عمليات، ويُفضّل رئيس قسم واحد من المجال الذي تهتم بتحسينه أكثر. تستغرق المقابلات من فريقك ما بين ساعة وساعتين إجمالاً خلال الالتزام." },
  { question: "بدأنا بالفعل استخدام بعض أدوات الذكاء الاصطناعي. هل ما زالت جلسة الاستراتيجية منطقية؟", answer: "غالباً أكثر منطقية. البدء دون استراتيجية يعني أنك ربما اتخذت بعض القرارات الجيدة وبعضها المكلف. جلسة الاستراتيجية تساعدك على تقييم ما ينجح، وما يجب إيقافه أو استبداله، وكيف تبني على ما لديك بخطة متماسكة. كثير من عملائنا يأتون وقد نشروا بالفعل بضع أدوات ويغادرون برؤية واضحة لكيفية جعلها تعمل معاً." },
  { question: "ما حجم الشركة المناسب لهذه الخدمة؟", answer: "أجرينا جلسات استراتيجية لشركات تتراوح من فرق مكوّنة من 15 شخصاً إلى مؤسسات كبيرة. الصيغة تتكيف مع الحجم: الشركة الصغيرة تحصل على توصيات مركّزة ومرتّبة بالأولوية؛ والمؤسسة الكبيرة تحصل على خارطة طريق كاملة متعددة الأقسام. في الحالتين، المخرج وثيقة يمكنك التصرف بناء عليها فعلياً، لا إطاراً عاماً وُضع عليه شعارك." },
  { question: "ما مدى حداثة معرفتكم بمشهد الذكاء الاصطناعي التي تجلبونها للجلسة؟", answer: "حديثة جداً. قدرات الذكاء الاصطناعي تتغير بسرعة، ونحن نبقى نشطين في هذا المجال باستمرار. سنُخبرك بما أصبح ممكناً حديثاً ولم يكن متاحاً قبل ستة أشهر، وما الأدوات التي ظهرت في قطاعك، وأين ما زالت الضجة تتجاوز الواقع. خارطة الطريق التي نُسلّمها تعكس حالة الذكاء الاصطناعي اليوم، لا العام الماضي." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "استشارات استراتيجية الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-strategy",
    "description": "نرسم خارطة طريق الذكاء الاصطناعي لشركتك، نحسب العائد على الاستثمار لكل فرصة، ونُسلّم خطة تنفيذ واضحة لـ 12 شهراً مصممة خصيصاً لعملك.",
    "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "offers": { "@type": "Offer", "description": "جلسة استراتيجية الذكاء الاصطناعي: تدقيق شامل للعمليات، خارطة طريق للذكاء الاصطناعي، وتوقعات العائد على الاستثمار. التسعير مخصص حسب شركتك." },
    "serviceType": "استشارات الذكاء الاصطناعي"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "استراتيجية الذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-strategy" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
  }
];
---

<ArBaseLayout
  title="استشارات استراتيجية الذكاء الاصطناعي للشركات في الإمارات: خارطة طريق قائمة على العائد | Aegis AI"
  description="لا تعرف من أين تبدأ مع الذكاء الاصطناعي؟ نحن وكالة ذكاء اصطناعي في دبي نرسم خارطة طريقك، نحسب العائد على الاستثمار، ونُسلّم خطة واضحة لـ 12 شهراً لشركتك في الإمارات."
  canonicalPath="/ar/services/ai-strategy"
  enPath="/services/ai-strategy"
  ogImage="/assets/og-ai-strategy.jpg"
  ldJson={ldJson}
>

<!-- ── HERO ── -->
<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>استراتيجية الذكاء الاصطناعي</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">bar_chart</span>
      استشارات استراتيجية الذكاء الاصطناعي
    </div>
    <h1 style="max-width:52rem;margin:0 auto;">اعرف بالضبط أي ذكاء اصطناعي تبني<br><span class="gradient-text">قبل أن تُنفق درهماً واحداً.</span></h1>
    <p style="color:rgba(255,255,255,0.72);font-size:1.125rem;line-height:1.75;max-width:38rem;margin:1.5rem auto 2.5rem;">
      جلسة استراتيجية الذكاء الاصطناعي تمنحك خارطة طريق واضحة ومرتّبة بالأولوية: الاستثمارات الصحيحة في الذكاء الاصطناعي، بالترتيب الصحيح، مع توقعات عائد واقعية.
    </p>
    <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;margin-bottom:1.25rem;">
      <button onclick="openModal(this)" data-source="ar_strategy_hero" class="btn-primary" style="font-size:1rem;">احجز جلسة استراتيجية الذكاء الاصطناعي ←</button>
      <a href="#deliverables" class="btn-outline" style="font-size:1rem;">شاهد ما ستحصل عليه ↓</a>
    </div>
    <p style="color:rgba(255,255,255,0.55);font-size:.875rem;">تكلفة جلسة الاستراتيجية قابلة للخصم بالكامل إذا تابعت معنا التنفيذ</p>
  </div>
</header>

<!-- ── IMAGE BANNER + STAT ── -->
<div style="width:100%; height:280px; overflow:hidden; position:relative;">
  <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1400&q=80&auto=format&fit=crop" alt="جلسة استشارية لاستراتيجية الذكاء الاصطناعي مع قادة الأعمال" loading="eager" fetchpriority="high" width="1400" height="280" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="width:100%; height:100%; background:rgba(0,25,42,0.80); display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.08) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "12", caption: "شهراً من مبادرات الذكاء الاصطناعي، مرتّبة ومُسلسلة لتعرف بالضبط ما تبنيه أولاً" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- ── لماذا الاستراتيجية ليست خياراً ── -->
<section class="section" aria-labelledby="why-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="why-heading" style="margin-bottom:1.5rem;">لماذا استراتيجية الذكاء الاصطناعي ليست خياراً</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          معظم الشركات تتعامل مع الذكاء الاصطناعي أداة تلو الأخرى: شخص في فريق التسويق يشتري مساعد كتابة، فريق العمليات يُجرّب أداة أتمتة، والرئيس التنفيذي يستخدم روبوت محادثة مختلفاً تماماً. كل خيار على حدة قد يبدو منطقياً بمعزل عن غيره، لكن دون استراتيجية، تكون النتيجة مجموعة أدوات منفصلة لا تتراكم، لا تتكامل، ولا تُحقق الأثر الذي يستطيع الذكاء الاصطناعي تحقيقه فعلياً.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          استراتيجية الذكاء الاصطناعي الصحيحة تُجيب على الأسئلة التي يتخطاها التبني أداة بأداة: أي مشكلات العمل نُرتّبها أولاً؟ أين يُحقق الذكاء الاصطناعي أسرع عائد؟ ما البيانات المتوفرة لدينا، وهل هي كافية؟ أي مسارات العمل يجب أتمتتها مقابل تعزيزها؟ أين تُقيّد الأنظمة أو الامتثال خياراتنا؟ ماذا نبني وماذا نشتري؟ والأهم: بأي ترتيب ننجز كل هذا حتى تُشكّل الاستثمارات المبكرة أساساً للاستثمارات التالية؟
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=800&q=80&auto=format&fit=crop" alt="فريق قيادي في شركة بدبي يرسم أولويات الذكاء الاصطناعي على لوح أبيض خلال جلسة استراتيجية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      الشركات التي تستخلص قيمة حقيقية من الذكاء الاصطناعي ليست الأسرع حركة، بل الأصح اتجاهاً. الاستراتيجية الواضحة تمنع الاستثمار المهدور، والاحتكاك التنظيمي الناتج عن إطلاق سيء التخطيط، والنتيجة الشائعة المتمثلة في إنفاق المال على ذكاء اصطناعي لا يستخدمه أحد في النهاية.
    </p>
  </div>
</section>

<!-- ── من يحتاج هذه الخدمة ── -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">هل هذه الخدمة لك؟</p>
      <h2 id="who-heading">من يحتاج جلسة استراتيجية الذكاء الاصطناعي</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=1200&q=80&auto=format&fit=crop" alt="الحي التجاري في دبي عند الغسق، موطن الشركات الإماراتية التي تُخطط لاستثمارها القادم في الذكاء الاصطناعي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-3" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: #e7eeff; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تعرف أن الذكاء الاصطناعي يستحق الاستثمار، لكنك غير متأكد أي مشكلات العمل تُرتّبها أولاً أو كيف تبدو نقطة البداية الواقعية.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(186,26,26,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">جرّبت أدوات الذكاء الاصطناعي وحصلت على نتائج مخيبة للآمال. لست متأكداً إن كانت المشكلة في الأدوات، في الأسلوب، أم في طريقة تطبيقها.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(245,158,11,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تحتاج إلى تقديم حالة استثمار مقنعة في الذكاء الاصطناعي للإدارة، بأرقام حقيقية، جداول زمنية، وخطة تصمد أمام التدقيق.</p>
      </div>
      <div class="card text-center">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(0,104,117,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تُقرر أي قدرات ذكاء اصطناعي تبنيها أو تشتريها في العام القادم، وتريد التأكد من أن الميزانية تذهب لما يُحدث فرقاً فعلياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── ما تشمله جلسة الاستراتيجية ── -->
<section id="what-you-get" class="section" style="background: #e7eeff;" aria-labelledby="deliverable-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">المخرجات</p>
      <h2 id="deliverable-heading">المشمول في جلسة الاستراتيجية</h2>
      <p style="color: #42474e; max-width: 36rem; margin: 1rem auto 0; line-height: 1.7;">جلسة استراتيجية الذكاء الاصطناعي التزام مركّز ومنظّم. تحصل على وثيقة كاملة + جلسة عرض تنفيذية مباشرة.</p>
    </div>
    <div class="bento-grid bento-grid-3" style="margin-bottom: 4rem;">
      <div class="card">
        <div class="deliverable-num">01</div>
        <h3 style="margin: .75rem 0 .5rem;">تحليل الوضع الحالي</h3>
        <p style="color: #42474e; line-height: 1.7;">تقييم شامل لعملياتك، أصول بياناتك، أدواتك الحالية، وجاهزية فريقك للذكاء الاصطناعي.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">02</div>
        <h3 style="margin: .75rem 0 .5rem;">خريطة فرص الذكاء الاصطناعي</h3>
        <p style="color: #42474e; line-height: 1.7;">كل فرصة ذكاء اصطناعي في شركتك، مرتّبة حسب العائد والجدوى لتعرف ما تبنيه أولاً.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">03</div>
        <h3 style="margin: .75rem 0 .5rem;">توصيات البناء مقابل الشراء</h3>
        <p style="color: #42474e; line-height: 1.7;">لكل فرصة: هل تبني ذكاءً اصطناعياً مخصصاً، تشتري أداة جاهزة، أم كليهما؟ نُخبرك بالسبب بالضبط.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">04</div>
        <h3 style="margin: .75rem 0 .5rem;">خارطة طريق الذكاء الاصطناعي لـ 12 شهراً</h3>
        <p style="color: #42474e; line-height: 1.7;">خطة تنفيذ مرحلية ومرتّبة بالأولوية تغطي الشهر الأول، الربع الأول، والعام الأول.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">05</div>
        <h3 style="margin: .75rem 0 .5rem;">توقعات الميزانية والعائد</h3>
        <p style="color: #42474e; line-height: 1.7;">متطلبات ميزانية واقعية وتوقعات عائد لكل مبادرة، بأرقام فعلية لا نسب مبهمة.</p>
      </div>
      <div class="card">
        <div class="deliverable-num">06</div>
        <h3 style="margin: .75rem 0 .5rem;">مراجعة الامتثال التنظيمي</h3>
