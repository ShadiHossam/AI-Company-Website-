---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

const faqItems = [
  { question: "هل يمكن اختراق وكيل عبر قناة مثل واتساب؟", answer: "نعم، إذا لم يُبنَ ليقاومه. أي قناة يستطيع فيها المستخدم كتابة نص حر لوكيل، واتساب، دردشة الموقع، أو الصوت، هي مسار محتمل لمحاولات حقن الأوامر أو الهندسة الاجتماعية. القناة نفسها ليست الثغرة، بل غياب تصفية المدخلات والصلاحيات المحددة وفحص المخرجات في الوكيل. الوكيل المبني جيداً يعامل كل رسالة واردة كمدخل غير موثوق بغض النظر عن القناة." },
  { question: "ما البيانات التي يمكن لوكيل ذكاء اصطناعي تسريبها فعلياً؟", answer: "أي شيء يستطيع الوصول إليه عبر استدعاءات أدواته والأنظمة المتصلة به: سجلات العملاء، تاريخ الطلبات، مستندات داخلية، أو أي شيء آخر يستطيع الاستعلام عنه. لهذا تهم صلاحيات الأدوات المحددة كثيراً، فالوكيل الذي يستطيع قراءة فقط البيانات المحددة التي يحتاجها لمهمته ببساطة لا يستطيع تسريب ما لم يُمنح الوصول إليه أصلاً، حتى لو نجح مهاجم في خداعه للمحاولة." },
  { question: "من المسؤول عندما يرتكب وكيل ذكاء اصطناعي خطأً مكلفاً؟", answer: "قانونياً، لا يزال هذا مجالاً متطوراً، والمسؤولية عموماً تعود للعمل الذي نشر الوكيل، لا لمزود نموذج الذكاء الاصطناعي الأساسي. لهذا بالضبط مراجعة البشر للإجراءات عالية الخطورة (الاستردادات، التزامات العقود، أي شيء لا يمكن التراجع عنه) ليست حذراً اختيارياً، بل هي الضابط الذي يمنع تحول خطأ إلى حادثة حرجة للعمل قبل أن يراها أي شخص." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "أمن وكلاء الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-agent-security",
    "description": "أمن وكلاء الذكاء الاصطناعي للشركات الإماراتية: ضوابط ضد حقن الأوامر، تسريب البيانات، والصلاحيات المفرطة، بالإضافة إلى اختبار اختراق قبل الإطلاق."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "أمن وكلاء الذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-agent-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "أمن وكلاء الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-agent-security",
    "description": "أمن وكلاء الذكاء الاصطناعي للشركات الإماراتية: التهديدات الحقيقية، ضوابط تصمد أمام الاختبار الفعلي، اختبار اختراق قبل الإطلاق، وقائمة تحقق أمنية قبل الإطلاق.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Agent Security Review"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="أمن وكلاء الذكاء الاصطناعي: ضوابط الحماية وحقن الأوامر واختبار الاختراق | Lenoo AI"
  description="أمن وكلاء الذكاء الاصطناعي للشركات الإماراتية: التهديدات الحقيقية، ضوابط حماية تصمد فعلياً، اختبار اختراق قبل الإطلاق، وقائمة تحقق أمنية قبل الإطلاق."
  canonicalPath="/ar/services/ai-agent-security"
  enPath="/services/ai-agent-security"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>أمن وكلاء الذكاء الاصطناعي</div>
    <h1>أمن وكلاء الذكاء الاصطناعي<br><span class="gradient-text">ضوابط الحماية، حقن الأوامر، واختبار الاختراق</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:680px; margin:1.5rem auto 2rem; line-height:1.8;">الوكيل الذي يستطيع التصرف نيابة عنكم هو أيضاً سطح هجوم جديد. إليكم ما يهدد فعلياً نشر ذكاء اصطناعي في عمل تجاري، والضوابط التي تصمد أمام محاولات كسرها فعلياً، وكيف تختبرون وكيلكم قبل أن يفعلها عميل، أو مهاجم.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai-agent-security_hero" class="btn-primary">احصل على مراجعة أمنية مجانية للوكيل</button>
      <a href="#threats" class="btn-outline">شاهد التهديدات الحقيقية ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=1600&q=80&auto=format&fit=crop" alt="مهندس أمن يراجع سجلات النظام على عدة شاشات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">٥</p>
        <p class="stat-lbl">فئات هجوم متمايزة يحتاج كل وكيل موجه للعملاء دفاعاً ضدها</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٤</p>
        <p class="stat-lbl">أنواع ضوابط حماية تصمد أمام اختبار اختراق حقيقي</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٠</p>
        <p class="stat-lbl">إجراءات لا رجعة فيها يجب أن يتخذها الوكيل دون مراجعة بشرية</p>
      </div>
    </div>
  </div>
</div>

<!-- WHY DIFFERENT -->
<section class="section" aria-labelledby="different-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="different-heading" style="margin-bottom:1.5rem;">لماذا أمن الوكلاء مختلف عن أمن التطبيقات</h2>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الاستقلالية = سطح هجوم جديد</h3>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">التطبيق التقليدي يفعل بالضبط ما تقوله شيفرته، لا أكثر. وكيل الذكاء الاصطناعي يفكر فيما يجب فعله بناءً على المحادثة والأدوات المتاحة له، مما يعني أن سلوكه غير محدد بالكامل مسبقاً كما هو الحال في تطبيق عادي. هذه المرونة هي بيت القصيد من بناء وكيل، وهي أيضاً بالضبط ما يجعله نوعاً مختلفاً من مشاكل الأمن.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">التطبيق التقليدي له مجموعة ثابتة من المدخلات والمخرجات يمكن لمراجعة أمنية حصرها. الوكيل الذي يستطيع استدعاء أدوات والاستعلام عن قواعد بيانات واتخاذ إجراءات متعددة الخطوات بناءً على تعليمات بلغة طبيعية لديه مساحة أكبر بكثير مما قد يُقنَع بفعله، بما في ذلك أشياء لم يبرمجها أحد صراحة. تأمين وكيل يعني تأمين ما يُسمح له بفعله، لا فقط ما يُطلب منه، لأن هذين الأمرين قد يتباعدان تحت الضغط الصحيح من مستخدم أو محتوى ضار يقرأه.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=800&q=80&auto=format&fit=crop" alt="تصور بصري مجرد لأمن الشبكات على شاشة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- THE REAL THREATS -->
<section id="threats" class="section" style="background:#e7eeff;" aria-labelledby="threats-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="threats-heading">التهديدات الحقيقية</h2>
      <p>خمس فئات مخاطر تظهر في كل نشر وكيل جاد تقريباً، سواء موجهاً للعملاء أو داخلياً.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">warning</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">حقن الأوامر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مستخدم، أو محتوى يقرأه الوكيل (صفحة ويب، مستند، بريد إلكتروني)، يحتوي على تعليمات مخفية مصممة لتجاوز مهمة الوكيل الفعلية. وكيل دعم يقرأ رسالة عميل قد يُتلاعب به ليتجاهل تعليماته كلياً إذا احتوت تلك الرسالة على محاولة حقن مُعدّة.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">upload</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تسريب البيانات عبر استدعاءات الأدوات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوكيل ذو الوصول الواسع للأدوات يمكن التلاعب به لاسترجاع وكشف بيانات لا يجب أن يكشفها، طلب عميل آخر، تسعير داخلي، سجلات موظفين، بمجرد طرحه بالطريقة الصحيحة، إذا لم يمنعه شيء من استدعاء الأداة التي تجلب تلك البيانات.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">psychology_alt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاختراق / الهندسة الاجتماعية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مستخدم مصرّ يجرب سيناريوهات تمثيل أدوار، ادعاءات سلطة كاذبة ("أنا مدير النظام")، أو إعادة صياغة متكررة لجعل الوكيل يتصرف خارج نطاقه المقصود. هذه المحاولات شائعة بما يكفي ليُختبَر أي وكيل موجه للعملاء ضدها قبل الإطلاق، لا بعد حادثة علنية.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">gpp_maybe</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الصلاحيات المفرطة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوكيل لديه صلاحية أكبر مما تتطلبه مهمته الفعلية، فيكون لأي خطأ أو تلاعب نطاق ضرر أكبر بكثير مما يجب. الوكيل الذي يحتاج فقط للتحقق من حالة الطلب لا يجب أن يستطيع أيضاً إصدار استردادات، حتى لو مرّت الاستردادات عبر نفس النظام الأساسي.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">layers</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تسميم قاعدة المعرفة (RAG)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إذا كان الوكيل يسحب إجابات من قاعدة معرفة، فإن من يستطيع التأثير على محتوى تلك القاعدة يستطيع التأثير على ما يقوله الوكيل أو يفعله، سواء كان ذلك جهة خبيثة تزرع محتوى، أو مستندات داخلية قديمة أو خاطئة لم ينظفها أحد.</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل وكيل نبنيه محدد الصلاحيات، مُختبَر ضد فئات التهديد هذه بالضبط، ومُراجَع قبل أن يتحدث مع عميل حقيقي.</p>
      <button onclick="openModal(this)" data-source="ar_ai-agent-security_mid" class="btn-primary">احصل على مراجعة أمنية مجانية للوكيل</button>
    </div>
  </div>
</section>

<!-- GUARDRAILS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="guardrails-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="guardrails-heading">ضوابط حماية تصمد فعلياً</h2>
      <p>ليست قائمة ممارسات جيدة لعرض تقديمي. ضوابط تصمد أمام محاولة حقيقية لكسرها.</p>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تصفية المدخلات والمخرجات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فحوصات على ما يدخل للوكيل (فحص أنماط الحقن المعروفة) وما يخرج منه (منع الردود التي تسرّب تعليمات النظام أو بيانات حساسة)، كطبقة مستقلة لا يستطيع الوكيل نفسه التفكير حولها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">صلاحيات أدوات محددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الضابط الأكثر فعالية المتاح على الإطلاق. الوكيل الذي يُمنح فقط الأدوات ووصول البيانات الذي تتطلبه مهمته لا يستطيع تسريب أو إساءة استخدام ما لم يُمنحه أصلاً، بغض النظر عن كيفية التلاعب به.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">مراجعة بشرية للإجراءات عالية الخطورة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الاستردادات فوق حد معين، التزامات العقود، حذف الحسابات، أي شيء لا يمكن التراجع عنه أو مكلف يحصل على خطوة تأكيد بشرية قبل تنفيذه، بغض النظر عن مدى ثقة منطق الوكيل ظاهرياً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تحديد المعدل ورصد الشذوذ</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">حدود لعدد الإجراءات التي يستطيع الوكيل اتخاذها لكل مستخدم في كل فترة، ومراقبة الأنماط غير المعتادة (ارتفاع مفاجئ في استدعاء أداة معينة، محاولات فاشلة متكررة لنفس الطلب)، فيُلاحَظ هجوم قيد التنفيذ بسرعة.</p>
      </div>
    </div>
  </div>
</section>

<!-- RED TEAMING -->
<section class="section" aria-labelledby="redteam-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="redteam-heading" style="margin-bottom:1.5rem;">اختبار اختراق وكيلكم قبل الإطلاق</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        اختبار الاختراق يعني محاولة كسر وكيلكم عمداً قبل أن يفعلها عميل أو مهاجم نيابة عنكم. هذا يعني اختبار محاولات حقن الأوامر عبر كل قناة مدخلات يقبلها، محاولة جعله يكشف تعليمات نظامه، محاولة جعله يقوم بإجراء خارج نطاقه المحدد، واختبار ما إذا كان يمكن إقناعه بتجاهل ضوابط الحماية الخاصة به عبر الإصرار أو صياغة ذكية.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذا ليس تمريناً لمرة واحدة قبل الإطلاق ثم يُنسى. كل تغيير جوهري على تعليمات الوكيل أو أدواته أو قاعدة معرفته سبب لإعادة تشغيل مجموعة أساسية على الأقل من هذه الاختبارات، لأن إصلاح في منطقة قد يفتح ثغرة بصمت في منطقة أخرى. عاملوها كما يعامل فريق هندسي جاد اختبار الانحدار: روتينية، لا استثنائية.
      </p>
    </div>
  </div>
</section>

