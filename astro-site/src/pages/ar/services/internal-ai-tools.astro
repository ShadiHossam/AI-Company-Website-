---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";

const fallbackFaqs = [
  { question: "على أي بيانات تدرّبون الذكاء الاصطناعي الداخلي؟", answer: "ندرّبه على ما يستخدمه فريقكم فعلاً: ويكي الشركة، وإجراءات التشغيل القياسية، والسياسات، ووثائق المنتجات، والمشاريع السابقة، وتذاكر الدعم، والمستندات الداخلية، وغيرها. يصبح الذكاء الاصطناعي خبيراً حقيقياً بشركتكم، لا خبيراً عاماً." },
  { question: "هل بيانات شركتنا آمنة؟", answer: "نعم. بياناتكم لا تخرج أبداً عن سيطرتكم. ننشر أدوات الذكاء الاصطناعي الداخلية في بيئتكم السحابية الخاصة أو داخل مقركم. ولا تُستخدم البيانات لتدريب أي نماذج ذكاء اصطناعي خارجية. نضبط صلاحيات الوصول بحيث لا يرى الموظفون إلا ما يُسمح لهم برؤيته." },
  { question: "هل يستطيع الموظفون غير التقنيين استخدام هذه الأدوات؟", answer: "نعم، وهذا هو الهدف. أدوات الذكاء الاصطناعي الداخلية مصممة للموظفين غير التقنيين. يطرح الموظفون أسئلتهم بلغة عادية ويحصلون على إجابات مباشرة. لا حاجة لتدريب يتجاوز جلسة تعريفية قصيرة." },
  { question: "كيف تحافظون على تحديث الذكاء الاصطناعي عندما تتغير مستنداتنا؟", answer: "نبني مسارات مزامنة آلية تحدّث الذكاء الاصطناعي باستمرار بالمستندات الجديدة أو المعدّلة. تبقى معرفة الذكاء الاصطناعي حديثة دون أي جهد يدوي من فريقكم." },
  { question: "ما الفرق بين أداة ذكاء اصطناعي داخلية واستخدام البحث في SharePoint؟", answer: "البحث في SharePoint يجد المستندات التي تحتوي كلماتكم المفتاحية. أما أداة الذكاء الاصطناعي الداخلية فتفهم ما تسألون عنه وتعطيكم الإجابة، مع السياق، بلغة واضحة. تجمع المعلومات من عدة مستندات، وتشرح السياسات، وتقارن الخيارات، وتتعامل مع أسئلة المتابعة. إنه الفرق بين أن يُسلَّم إليكم كومة ملفات، وأن يشرح لكم زميل خبير بالضبط ما تحتاجون معرفته." },
  { question: "هل نستطيع تحديد المعلومات التي يصل إليها كل موظف؟", answer: "نعم، صلاحيات الوصول مدمجة من البداية. نضبط الذكاء الاصطناعي بحيث لا يعرض إلا المعلومات المسموح للموظف السائل برؤيتها. الموارد البشرية تصل لبيانات الموارد البشرية. والمالية ترى وثائق المالية. والموظف المبتدئ لن يحصل على بيانات رواتب الإدارة التنفيذية بمجرد السؤال. الصلاحيات تعكس هيكلكم التنظيمي الحالي." },
  { question: "ما سرعة نشر أداة ذكاء اصطناعي داخلية؟", answer: "ذكاء اصطناعي مركّز لقاعدة معرفة قسم واحد يمكن عادةً أن ينتقل من الانطلاق إلى التشغيل خلال أسبوعين إلى أربعة أسابيع. أما عمليات النشر المؤسسية الأكبر التي تغطي عدة أقسام وأنواع مستندات وعمليات ربط فتستغرق وقتاً أطول ويُحدَّد نطاقها لكل حالة. ننشر على مراحل للتحقق من الدقة قبل التشغيل الكامل." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_internal_ai_tools')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "folder_open", step: "الخطوة ١", title: "تدقيق البيانات", description: "نجرد مستنداتكم ومصادر الويكي والبيانات لديكم، ثم نحدد ما يُضمَّن وكيف يُنظَّم." },
  { icon: "settings", step: "الخطوة ٢", title: "البناء والإعداد", description: "ندخل بياناتكم، ونضبط الذكاء الاصطناعي، ونحدد صلاحيات الوصول، ونبني الواجهة التي سيستخدمها فريقكم فعلاً." },
  { icon: "fact_check", step: "الخطوة ٣", title: "الاختبار والضبط", description: "يختبر فريقكم أسئلة حقيقية. نضبط الإجابات، ونسد الفجوات، ونتأكد من الدقة قبل الإطلاق." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "الإطلاق والتحديث", description: "تبدأ الأداة العمل مع مزامنة مستمرة للمستندات. دعم ٩٠ يوماً مشمول للتوسع والتحسين." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="أدوات ذكاء اصطناعي داخلية للشركات في الإمارات | Lenoo AI"
  description="امنحوا فريقكم في الإمارات ذكاءً اصطناعياً يعرف عملكم فعلاً. نبني مساعدين داخليين وقواعد معرفة ولوحات معلومات مدرَّبة على بياناتكم الخاصة."
  canonicalPath="/ar/services/internal-ai-tools"
  enPath="/services/internal-ai-tools"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>أدوات الذكاء الاصطناعي الداخلية</div>
    <h1>امنحوا فريقكم ذكاءً اصطناعياً <span class="gradient-text">يعرف عملكم فعلاً.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      أدوات الذكاء الاصطناعي العامة لا تعرف سياساتكم ولا منتجاتكم ولا إجراءاتكم. نبني أدوات ذكاء اصطناعي مدرَّبة على بيانات شركتكم الخاصة، فيحصل فريقكم على إجابات دقيقة ومرتبطة بالسياق فوراً.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_internal_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80&auto=format&fit=crop" alt="أدوات ذكاء اصطناعي داخلية ولوحات معلومات للأعمال للشركات في دبي والإمارات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
</div>

<!-- WHAT ARE INTERNAL AI TOOLS -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="explain-heading" style="text-align:start; margin-bottom:1.5rem;">ما هي أدوات الذكاء الاصطناعي الداخلية؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          أدوات الذكاء الاصطناعي الداخلية أنظمة تعمل بالذكاء الاصطناعي تُنشر داخل مؤسستكم، وتُدرَّب على بيانات شركتكم الخاصة، ولا يصل إليها إلا فريقكم. على عكس أدوات الذكاء الاصطناعي الاستهلاكية التي تجيب من معرفة الإنترنت العامة، تعرف الأدوات الداخلية بالضبط ما تفعله شركتكم، وكيف تعمل، وما سياساتها، وما المعلومات المرتبطة بدور كل موظف.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          الشكل الأكثر شيوعاً هو ذكاء اصطناعي لقاعدة معرفة الشركة: مساعد يستطيع الإجابة عن أي سؤال حول منتجاتكم أو إجراءاتكم أو سياساتكم أو تاريخكم، بقراءة مستنداتكم الداخلية وتكوين إجابة دقيقة. بدلاً من البحث في مجلد SharePoint لمدة ١٥ دقيقة أو مراسلة زميل خبير للمرة الخامسة هذا الأسبوع، يكتب الموظف سؤاله ويحصل على الإجابة الصحيحة في ثوانٍ، مع إشارة للمستند المصدر.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          إلى جانب استرجاع المعرفة، تستطيع أدوات الذكاء الاصطناعي الداخلية تولّي أعمال تشغيلية: صياغة المستندات بأسلوب شركتكم، وتحليل البيانات الداخلية واستخراج ما فيها من دلالات، وإدارة سير عمل تعيين الموظفين الجدد، أو العمل كمكتب مساعدة داخلي على مدار الساعة لأسئلة الموارد البشرية وتقنية المعلومات. النطاق يحدده ما يحتاجه فريقكم فعلاً، وكل أداة تُنشر في بيئتكم بصلاحيات الوصول الخاصة بكم، فتبقى البيانات حيث يجب أن تكون. وكوكالة ذكاء اصطناعي في دبي، نبني هذه الأدوات بنفس العناية لفرق العمل في كل الإمارات.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&q=80&auto=format&fit=crop" alt="مساحة عمل مكتبية حديثة بأجهزة حاسوب يستخدم فيها فريق أدوات ذكاء اصطناعي داخلية" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- PROBLEM CARDS -->
<section class="section" aria-labelledby="problem-heading">
  <div class="container">
    <div style="text-align:center; margin-bottom:3rem;">
      <h2 id="problem-heading">المشكلة في أدوات الذكاء الاصطناعي العامة</h2>
      <p style="color:#42474e; max-width:36rem; margin:1rem auto 0; line-height:1.7;">فريقكم يستحق ذكاءً اصطناعياً يعرف عملكم، لا ذكاءً اصطناعياً يعطي الجميع نفس الإجابة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(186,26,26,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">أدوات الذكاء الاصطناعي العامة لا تعرف منتجاتكم ولا سير عملكم ولا سياساتكم. تعطي فريقكم نفس المخرجات التي تعطيها لأي شخص، وهذا بلا فائدة لأي شيء يخص طريقة عملكم الفعلية.</p>
      </div>
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(245,158,11,0.10); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">الموظفون الجدد يقضون أسابيع في البحث بين مئات الصفحات من الوثائق للعثور على إجابات أساسية. ومعظمهم يستسلم ويقاطع زميلاً بدلاً من ذلك.</p>
      </div>
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(0,37,59,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#00253b" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">أكثر موظفيكم خبرة يقضون ساعات كل يوم في الإجابة عن نفس الأسئلة الداخلية مراراً، وهو وقت يجب أن يذهب لعمل لا يستطيعه غيرهم.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أدوات الذكاء الاصطناعي الداخلية التي نبنيها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة شائعة، وليست حدود الممكن. كلها تُنشر في بيئتكم، على بياناتكم، بصلاحيات الوصول الخاصة بكم. إذا كانت لديكم أداة محددة في ذهنكم غير مذكورة، أحضروها إلينا.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">menu_book</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لقاعدة معرفة الشركة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">اسألوا أي سؤال واحصلوا على إجابة دقيقة مع ذكر المصادر، مدرَّب على إجراءاتكم وسياساتكم ووثائق منتجاتكم وأسئلتكم الشائعة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">مساعد العمليات الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">زميل ذكاء اصطناعي على مدار الساعة يتولى أسئلة الموارد البشرية، وتذاكر تقنية المعلومات، واستفسارات تعيين الموظفين، والطلبات الداخلية، فوراً وبدقة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">monitoring</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">لوحات تحليلات مخصصة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">رؤية مباشرة لمؤشرات عملكم. اسألوا لوحتكم بلغة عادية واحصلوا على رسوم بيانية وملخصات وتوقعات.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">search</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">بحث في المستندات بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">اعثروا على أي شيء في مستندات شركتكم ورسائلها وملفاتها. ليس بحثاً بالكلمات المفتاحية، بل فهماً دلالياً لما تبحثون عنه فعلاً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">أدوات محتوى وكتابة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">مساعدو كتابة بالذكاء الاصطناعي مدرَّبون على صوت علامتكم. صيغوا العروض والتقارير والرسائل والعروض التقديمية بأسلوب يشبه شركتكم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">school</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لتعيين الموظفين وتدريبهم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">ذكاء اصطناعي للموظفين الجدد يرشدهم خلال إجراءات الشركة، ويجيب عن أسئلتهم، ويعرض المعلومات الصحيحة في الوقت المناسب.</p>
      </div>
    </div>
  </div>
</section>

<!-- ROI SECTION -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="roi-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="roi-heading">التكلفة الحقيقية لغياب الذكاء الاصطناعي الداخلي</h2>
      <p style="color:#42474e; font-size:1.0625rem;">قبل أن تستثمروا في أدوات ذكاء اصطناعي داخلية، فكروا فيما يكلفكم البديل فعلاً.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?w=1200&q=80&auto=format&fit=crop" alt="فريق يستخدم لوحات معلومات داخلية في المكتب" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-3">
