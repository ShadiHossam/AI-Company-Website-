---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';

const faqItems = [
  { question: "ما البيانات التي تُدرَّب عليها الأداة الداخلية؟", answer: "نُدرّبها على كل ما يستخدمه فريقك فعلياً: موسوعات الشركة، إجراءات التشغيل القياسية، السياسات، مستندات المنتج، المشاريع السابقة، تذاكر الدعم، والمستندات الداخلية، وغيرها. تصبح الأداة خبيراً حقيقياً في شركتك، لا أداة عامة." },
  { question: "هل بيانات شركتنا آمنة؟", answer: "نعم. بياناتك لا تغادر نطاق تحكمك أبداً. نُنشر الأدوات الداخلية في بيئتك السحابية الخاصة أو على خوادمك الداخلية. لا تُستخدم بياناتك لتدريب أي نماذج ذكاء اصطناعي خارجية. نُعدّ ضوابط الوصول بحيث يرى كل موظف فقط ما هو مُصرَّح له برؤيته." },
  { question: "هل يمكن للموظفين بدون مهارات تقنية استخدام هذه الأدوات؟", answer: "نعم، هذا بالضبط الهدف منها. الأدوات الداخلية مصممة للموظفين غير التقنيين. يطرح الموظف سؤاله بلغة بسيطة ويحصل على إجابة مباشرة. لا حاجة لأي تدريب سوى جلسة تعريفية قصيرة." },
  { question: "كيف تُبقون الأداة محدَّثة عند تغيّر مستنداتنا؟", answer: "نُعدّ خطوط مزامنة آلية تُحدّث الأداة باستمرار بالمستندات الجديدة أو المعدَّلة. تبقى معرفة الأداة محدَّثة دون أي جهد يدوي من فريقك." },
  { question: "ما الفرق بين أداة ذكاء اصطناعي داخلية واستخدام بحث SharePoint فقط؟", answer: "بحث SharePoint يجد المستندات التي تحتوي على كلماتك المفتاحية. أما الأداة الداخلية فتفهم ما تسأل عنه فعلياً وتُعطيك الإجابة، مع السياق، بلغة بسيطة. تُلخّص من عدة مستندات، تشرح السياسات، تقارن الخيارات، وتتعامل مع الأسئلة التابعة. الفرق أشبه بالفرق بين أن تُسلَّم كومة من الملفات وبين أن يشرح لك زميل مطّلع بالضبط ما تحتاج معرفته." },
  { question: "هل يمكننا تقييد أي موظف يصل لأي معلومات؟", answer: "نعم، ضوابط الوصول مبنية في الأداة منذ البداية. نُعدّ الذكاء الاصطناعي بحيث لا يُظهر إلا المعلومات المُصرَّح للموظف السائل برؤيتها. الموارد البشرية تصل لبيانات الموارد البشرية. المالية ترى مستندات المالية. موظف مبتدئ لن يحصل على بيانات تعويضات الإدارة العليا لمجرد أنه سأل عنها. الصلاحيات تعكس هيكلك التنظيمي الحالي." },
  { question: "كم يستغرق نشر أداة ذكاء اصطناعي داخلية؟", answer: "أداة قاعدة معرفة مُركَّزة لقسم واحد تنتقل عادةً من الانطلاق إلى التشغيل الفعلي خلال أسبوعين إلى أربعة أسابيع. عمليات النشر الأكبر التي تشمل عدة أقسام، وأنواع مستندات، وتكاملات تأخذ وقتاً أطول ويُحدَّد نطاقها بشكل فردي. نُطلق الأداة على مراحل للتحقق من الدقة قبل النشر الكامل." },
];

const processSteps = [
  { icon: "folder_open", step: "الخطوة 1", title: "تدقيق البيانات", description: "نحصر مستنداتك وموسوعاتك الداخلية ومصادر بياناتك، ثم نحدد ما يجب تضمينه وكيف يُنظَّم." },
  { icon: "settings", step: "الخطوة 2", title: "البناء والإعداد", description: "نستوعب بياناتك، نُعدّ الذكاء الاصطناعي، نضبط صلاحيات الوصول، ونبني الواجهة التي سيستخدمها فريقك فعلياً." },
  { icon: "fact_check", step: "الخطوة 3", title: "الاختبار والضبط", description: "يختبر فريقك أسئلة حقيقية. نضبط الإجابات، نُصلح الثغرات، ونتأكد من الدقة قبل الإطلاق." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والتحديث", description: "تنطلق الأداة مع مزامنة مستمرة للمستندات. دعم لمدة 90 يوماً مشمول للتوسيع والتحسين." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "أدوات ذكاء اصطناعي داخلية", "url": "https://lenooai.com/ar/services/internal-ai-tools", "description": "مساعدات ذكاء اصطناعي داخلية، قواعد معرفة، ولوحات تحليلية مخصصة، مدربة على بيانات شركتك الخاصة، وتُنشر في بيئتك بضوابط الوصول التي تحددها.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "serviceType": "تطوير الذكاء الاصطناعي الداخلي" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "أدوات ذكاء اصطناعي داخلية", "item": "https://lenooai.com/ar/services/internal-ai-tools" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="أدوات ذكاء اصطناعي داخلية للشركات في الإمارات: لوحات ومساعدات | Aegis AI"
  description="امنح فريقك في الإمارات ذكاءً اصطناعياً يعرف عملك فعلاً. نبني مساعدات ذكاء اصطناعي داخلية، قواعد معرفة، ولوحات تحليلية مدربة على بياناتك الخاصة."
  canonicalPath="/ar/services/internal-ai-tools"
  enPath="/services/internal-ai-tools"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>أدوات داخلية</div>
    <h1>امنح فريقك ذكاءً اصطناعياً <span class="gradient-text">يعرف عملك فعلاً.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      الأدوات العامة للذكاء الاصطناعي لا تعرف سياساتك، منتجاتك، أو عملياتك. نبني أدوات ذكاء اصطناعي مُدرَّبة على بيانات شركتك الخاصة، ليحصل فريقك على إجابات دقيقة وواعية بالسياق فوراً.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_internal_hero" class="btn-primary">احجز مكالمة استكشافية مجانية</button>
      <a href="#what-we-build" class="btn-outline">اطّلع على ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80&auto=format&fit=crop" alt="أدوات ذكاء اصطناعي داخلية ولوحات ذكاء الأعمال لشركات دبي والإمارات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
</div>

<!-- WHAT ARE INTERNAL AI TOOLS -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هي الأدوات الداخلية؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الأدوات الداخلية هي أنظمة ذكاء اصطناعي تُنشَر داخل مؤسستك، مُدرَّبة على بيانات شركتك الخاصة، ومتاحة فقط لفريقك. على عكس أدوات الذكاء الاصطناعي الاستهلاكية التي تُجيب من معرفة عامة على الإنترنت، تعرف الأدوات الداخلية بالضبط ماذا تفعل شركتك، وكيف تعمل، وما هي سياساتها، وما المعلومات ذات الصلة بدور كل موظف.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الشكل الأكثر شيوعاً هو ذكاء اصطناعي لقاعدة معرفة الشركة: مساعد يستطيع الإجابة على أي سؤال عن منتجاتك، عملياتك، سياساتك، أو تاريخك، عبر قراءة مستنداتك الداخلية وتلخيص إجابة دقيقة. بدلاً من البحث في مجلد SharePoint لمدة 15 دقيقة أو مراسلة زميل أقدم للمرة الخامسة هذا الأسبوع، يكتب الموظف سؤاله ويحصل على الإجابة الصحيحة خلال ثوانٍ، مع الإشارة إلى المستند المصدر.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        بالإضافة إلى استرجاع المعرفة، يمكن للأدوات الداخلية أن تتولى عملاً تشغيلياً: صياغة مستندات بأسلوب شركتك، تحليل البيانات الداخلية واستخراج الرؤى منها، إدارة سير عمل التأهيل الوظيفي، أو العمل كمكتب مساعدة داخلي على مدار الساعة لأسئلة الموارد البشرية وتقنية المعلومات. يُحدَّد النطاق بحسب ما يحتاجه فريقك فعلياً، وتُنشَر كل أداة في بيئتك بضوابط الوصول الخاصة بك، بحيث تبقى بياناتك بالضبط حيث ينبغي أن تكون. بصفتنا وكالة ذكاء اصطناعي في دبي، نبني هذه الأدوات بالعناية نفسها لفرق العمل في جميع أنحاء الإمارات.
      </p>
    </div>
  </div>
</section>

<!-- PROBLEM CARDS -->
<section class="section" aria-labelledby="problem-heading">
  <div class="container">
    <div style="text-align:center; margin-bottom:3rem;">
      <h2 id="problem-heading">مشكلة أدوات الذكاء الاصطناعي العامة</h2>
      <p style="color:#42474e; max-width:36rem; margin:1rem auto 0; line-height:1.7;">فريقك يستحق ذكاءً اصطناعياً يعرف عملك، لا ذكاءً اصطناعياً يُعطي إجابة الجميع نفسها.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(186,26,26,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">الأدوات العامة للذكاء الاصطناعي لا تعرف منتجاتك أو سير عملك أو سياساتك. تُعطي فريقك نفس النتيجة التي تُعطيها لأي شخص آخر، وهي عديمة الفائدة لأي شيء خاص بطريقة عملك الفعلية.</p>
      </div>
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(245,158,11,0.10); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">يقضي الموظفون الجدد أسابيع في البحث بين مئات صفحات التوثيق للعثور على إجابات أساسية. يستسلم معظمهم ويقاطعون زميلاً بدلاً من ذلك.</p>
      </div>
      <div class="card text-center">
        <div style="width:52px; height:52px; border-radius:50%; background:rgba(0,37,59,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#00253b" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color:#42474e; line-height:1.65;">يقضي أكثر موظفيك خبرة ساعات كل يوم في الإجابة على نفس الأسئلة الداخلية المتكررة، وقت كان يجب أن يذهب للعمل الذي لا يستطيع القيام به سواهم.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أدوات الذكاء الاصطناعي الداخلية التي نبنيها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة شائعة، وليست حداً لما هو ممكن. جميعها تُنشَر في بيئتك، على بياناتك، بضوابط الوصول الخاصة بك. إذا كان لديك أداة محددة في ذهنك وغير مذكورة هنا، شاركنا بها.</p>
    </div>
    <div class="feature-ledger">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">menu_book</span></div>
        <h3>ذكاء اصطناعي لقاعدة معرفة الشركة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اطرح أي سؤال واحصل على إجابة دقيقة مع إشارة إلى المصدر، مُدرَّبة على إجراءاتك التشغيلية، سياساتك، مستندات منتجك، والأسئلة الشائعة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3>مساعد العمليات الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">زميل ذكاء اصطناعي متاح على مدار الساعة يتعامل مع أسئلة الموارد البشرية، تذاكر تقنية المعلومات، استفسارات التأهيل الوظيفي، والطلبات الداخلية، بدقة وفورية.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3>لوحات تحليلات مخصصة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">رؤية فورية لمؤشرات أعمالك. اطرح على لوحتك التحليلية أسئلة بلغة بسيطة واحصل على رسوم بيانية وملخصات وتوقعات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3>بحث في المستندات مدعوم بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اعثر على أي شيء في مستندات شركتك، رسائل البريد الإلكتروني، وملفاتها. ليس بحثاً بالكلمات المفتاحية، بل فهماً دلالياً لما تبحث عنه فعلياً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">auto_awesome</span></div>
        <h3>أدوات محتوى وكتابة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مساعدات كتابة بالذكاء الاصطناعي مُدرَّبة على أسلوب علامتك التجارية. اكتب عروضاً، تقارير، رسائل بريد إلكتروني، وعروضاً تقديمية تبدو وكأن شركتك كتبتها.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">school</span></div>
        <h3>ذكاء اصطناعي للتأهيل والتدريب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">ذكاء اصطناعي للموظفين الجدد يُرافقهم عبر عمليات الشركة، يجيب على أسئلتهم، ويُظهر المعلومة الصحيحة في الوقت المناسب.</p>
      </div>
    </div>
  </div>
</section>

<!-- ROI SECTION -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="roi-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="roi-heading">التكلفة الحقيقية لعدم امتلاك ذكاء اصطناعي داخلي</h2>
      <p style="color:#42474e; font-size:1.0625rem;">قبل أن تستثمر في أدوات الذكاء الاصطناعي الداخلية، فكّر في ما يُكلّفك البديل فعلياً.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?w=1200&q=80&auto=format&fit=crop" alt="فريق يستخدم لوحات معلومات داخلية في المكتب" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem;">
      <div style="background:#fff; border:1px solid rgba(186,26,26,0.15); border-radius:16px; padding:1.75rem;">
