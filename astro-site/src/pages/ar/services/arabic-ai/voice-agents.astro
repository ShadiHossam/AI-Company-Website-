---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";

const fallbackFaqs = [
  { question: "هل يبدو وكيل الصوت ثنائي اللغة طبيعياً فعلياً، أم يبدو ذكاءً اصطناعياً بوضوح؟", answer: "نماذج الصوت الحالية أكثر طبيعية بكثير من أنظمة IVR التي يتخيلها معظم الناس عند سماع 'روبوت هاتف'، وتبديل اللغة نفسه لا يبدو آلياً كما كان سيبدو قبل بضع سنوات. ليس غير قابل للتمييز عن موظف بشري ثنائي اللغة في كل مكالمة، ولن ندّعي ذلك. ما يفعله بموثوقية هو خوض محادثة منظّمة، حجز، فحص حالة، سؤال روتيني، وتبديل اللغات في منتصف المكالمة دون كسر التدفق." },
  { question: "ماذا يحدث إذا كانت عربية المتصل لهجة لم يُختبَر الوكيل مقابلها؟", answer: "يعود الوكيل لسؤال توضيحي بدلاً من التخمين، وإذا لم يستطع متابعة المكالمة بثقة، يحوّلها لشخص مع ملخص لما قيل أصلاً. نحدد نطاق ونختبر الوكيل مقابل اللهجات التي يستخدمها متصلوكم الفعليون، أساساً العربية الإماراتية والخليجية الأوسع لعمل إماراتي، ونضبط عتبة التصعيد بحذر بدلاً من دفع مكالمة عبر الوكيل عندما تكون الثقة منخفضة." },
  { question: "هل يستطيع التعامل مع متصل يبدّل من العربية للإنجليزية في منتصف المكالمة، كما في مكالمة حقيقية؟", answer: "نعم، هذا أحد السيناريوهات الأساسية التي نختبرها قبل أن يصبح أي وكيل صوت ثنائي اللغة حياً. متصل يبدأ بالعربية وينتقل للإنجليزية لاسم علامة تجارية، عنوان، أو جملة جانبية محبَطة سلوك مكالمة طبيعي في الإمارات، والوكيل مبني لتتبع اللغة النشطة لكل دور بدلاً من القفل على أياً كانت اللغة التي فتحت المكالمة." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_arabic_ai_voice_agents')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'وكلاء صوت ثنائيو اللغة عربي-إنجليزي بالذكاء الاصطناعي',
    url: 'https://lenooai.com/ar/services/arabic-ai/voice-agents',
    description: 'وكلاء صوت ثنائيو اللغة بالذكاء الاصطناعي للأعمال الإماراتية يتعاملون مع متصلين يبدّلون بين العربية والإنجليزية في منتصف الجملة، بكشف لغة فوري وتحويل بشري احتياطي.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'تطوير وكيل صوت ثنائي اللغة، محدد النطاق ومُسعَّر بعد مكالمة اكتشاف بناءً على حجم المكالمات وتعقيد السيناريو.' },
    serviceType: 'AI Voice Agent Development',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'الخدمات', item: 'https://lenooai.com/ar/services' },
      { '@type': 'ListItem', position: 3, name: 'الذكاء الاصطناعي العربي', item: 'https://lenooai.com/ar/services/arabic-ai' },
      { '@type': 'ListItem', position: 4, name: 'وكلاء الصوت', item: 'https://lenooai.com/ar/services/arabic-ai/voice-agents' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="وكلاء صوت ثنائيو اللغة: متصلون عربي-إنجليزي في منتصف الجملة | Lenoo AI"
  description="وكلاء صوت عربي-إنجليزي بالذكاء الاصطناعي للأعمال الإماراتية: كيف نتعامل مع متصلين يبدّلون اللغات في منتصف الجملة، بكشف فوري وتحويل بشري احتياطي."
  canonicalPath="/ar/services/arabic-ai/voice-agents"
  enPath="/services/arabic-ai/voice-agents"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/arabic-ai" style="color:inherit;text-decoration:none;opacity:0.65;">الذكاء الاصطناعي العربي</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكلاء الصوت</div>
    <h1>وكلاء صوت ثنائيو اللغة: متصلون<br>يبدّلون بين <span class="gradient-text">العربية والإنجليزية</span> في منتصف الجملة</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:660px; margin:1.5rem auto 2rem; line-height:1.8;">مكالمات الهاتف الحقيقية في الإمارات لا تبقى بلغة واحدة. يفتح متصل بالعربية، يبدّل للإنجليزية لاسم علامة تجارية، ثم يعود للعربية لبقية الجملة. إليكم كيف نبني وكلاء صوت يتابعون ذلك التبديل دون تفويت نبضة.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_arabic_ai_voice_hero" class="btn-primary">استمعوا لوكيل صوت ثنائي اللغة يتعامل مع مكالمة حقيقية</button>
      <a href="#how-it-works" class="btn-outline">شاهدوا كيف يعمل ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1400&q=80&auto=format&fit=crop" alt="موظف مركز اتصال بسماعة رأس يتعامل مع مكالمة عميل ثنائية اللغة في الإمارات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- THE MID-SENTENCE SWITCH PROBLEM -->
<section class="section" aria-labelledby="problem-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="problem-heading" style="margin-bottom:1.5rem;">مشكلة التبديل في منتصف الجملة</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>مكالمات الهاتف في الإمارات تعبر اللغات بانتظام داخل جملة واحدة.</strong> قد يقول متصل "أبغى أحجز appointment يوم الخميس"، حاملاً كلمة إنجليزية داخل جملة عربية بنفس الطريقة التي تخرج بها في الحديث الطبيعي. معظم أنظمة الصوت مبنية حول افتراض أن مكالمة تجري بلغة واحدة من البداية للنهاية، تُكتَشف مرة واحدة في البداية وتُقفَل.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>عندما ينكسر ذلك الافتراض، تنكسر المكالمة معه.</strong> وكيل صوت قفل على "العربية" عند الكلمة الأولى إما يفشل في التعرف على الجزء الإنجليزي، يسمعه خطأً كضجيج، أو ينتج نصاً غير منطقي لا تستطيع طبقة التفكير خلفه التصرف عليه. يكرر المتصل نفسه، لا يزال الوكيل يسيء الفهم، وتنتهي المكالمة بتحويل لإنسان على أي حال، إلا أن المتصل الآن محبَط قبل أن يرفع شخص السماعة حتى.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>للنص ميزة هنا لا يملكها الصوت.</strong> يستطيع روبوت محادثة إعادة قراءة رسالة مختلطة اللغة بقدر ما يحتاج قبل الرد. يجب على وكيل صوت تحليل الكلام، في الوقت الفعلي، أثناء نطقه، دون زر إيقاف مؤقت ودون فرصة لسؤال "ماذا تقصد" أكثر من مرة أو اثنتين قبل أن تبدأ المكالمة بالشعور بالانكسار. هذا ما يجعل التبديل في منتصف الجملة مشكلة أصعب للصوت منها للنص، ولماذا يحتاج اختباراً محدداً، لا افتراض أنه يعمل لأن النموذج الأساسي "يدعم" اللغتين.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80&auto=format&fit=crop" alt="شخص في مكالمة هاتفية في بيئة مكتبية" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- HOW BILINGUAL VOICE AGENTS ACTUALLY HANDLE IT -->
<section id="how-it-works" class="section" style="background:#e7eeff;" aria-labelledby="how-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="how-heading">كيف يتعامل معها وكلاء الصوت ثنائيو اللغة فعلياً</h2>
      <p>أربعة أشياء يحتاج وكيل صوت إتقانها لمتابعة محادثة متبدّلة دون فقدان المتصل.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">graphic_eq</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كشف لغة فوري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">بدلاً من كشف اللغة مرة واحدة في بداية المكالمة، يتتبعها الوكيل باستمرار، كلمة بكلمة، فيُلتقَط تبديل في منتصف الجملة وقت حدوثه بدلاً من إرباك تحليل كل ما يليه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">اللغة مُتتبَّعة لكل عبارة، لا ثابتة للمكالمة كاملة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">hearing</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع اللكنة واللهجة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحدث المتصلون العربية باللكنة والإيقاع الخليجي الذي يستخدمونه فعلياً، لا النطق المحايد لنشرة إخبارية. نحدد نطاق ونختبر الوكيل مقابل أنماط اللكنة الإماراتية والخليجية الأوسع تحديداً، لأن نموذجاً مضبوطاً فقط على كلام مصري أو شامي سيسيء سماع نطق خليجي شائع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مُختبَر مقابل لكنة وأنماط كلام خليجية، لا عربية عامة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">tune</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مطابقة النبرة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مكالمة حجز هادئة وروتينية ومكالمة من مريض متوتر أو مستأجر محبَط تحتاجان إيقاعاً ونبرة مختلفين. يلتقط الوكيل إشارات في كيفية حديث المتصل، الإلحاح، الرسمية، الإحباط، ويضبط الإيقاع واختيار الكلمات بدلاً من تقديم كل رد بنفس السيناريو المسطّح.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">نبرة الرد تتكيف مع كيفية حديث المتصل فعلياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحويل احتياطي لإنسان</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">عندما تنخفض ثقة الوكيل فيما سمعه، سواء من لهجة لم يُختبَر مقابلها، ضجيج خلفية، أو طلب معقد فعلياً، يحوّل لشخص مع ملخص للمكالمة حتى الآن، بدلاً من التخمين ومخاطرة حجز خاطئ أو إجابة خاطئة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يصعّد عند الثقة المنخفضة بدلاً من الدفع عبر عدم اليقين</p>
      </div>
    </div>
  </div>
</section>

<!-- WHERE THIS MATTERS MOST -->
<section class="section" aria-labelledby="where-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="where-heading">أين يهم هذا أكثر</h2>
      <p>أي عمل إماراتي يتلقى حجماً عالياً من المكالمات الهاتفية يرى هذه المشكلة. ثلاثة أماكن تظهر فيها بأشد قوة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">headset_mic</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراكز الاتصال</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">الحجم العالي للمكالمات يعني أن وكيل صوت ثنائي اللغة يجب أن يتعامل مع النطاق الكامل من اللكنات ومزيج اللغات التي تستخدمها قاعدة عملائكم فعلياً، باتساق، مكالمة بعد مكالمة، دون أن تنخفض الجودة أثناء ساعات الذروة كما يحدث لفريق بشري مُجهَد.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">medical_services</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">العيادات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">مريض يحجز موعداً غالباً يتحول للإنجليزية لعرض، اسم دواء، أو مصطلح تأمين في منتصف الجملة. إخطاء ذلك التبديل يخاطر بخطأ حجز، وهذا يهم في بيئة عيادة أكثر من أي مكان آخر تقريباً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">home_work</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">العقارات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">مكالمات استفسار العقارات تخلط محادثة عربية بأسماء مباني، أسماء مناطق، وأرقام تسعير إنجليزية باستمرار. وكيل صوت لا يستطيع متابعة التبديل يخسر العميل المحتمل لحظة أن يطلب من المتصل تكرار نفسه.</p>
        <a href="/ar/industries/real-estate/" style="color:#006875; font-weight:600; font-size:0.875rem;">شاهدوا الذكاء الاصطناعي للعقارات ←</a>
      </div>
    </div>
  </div>
</section>

<!-- WHAT TO TEST BEFORE GOING LIVE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="test-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="test-heading">ماذا نختبر قبل الإطلاق</h2>
      <p>وكيل صوت ثنائي اللغة يجب ألا يصبح حياً على مكالمات حقيقية أبداً حتى يُشغَّل عبر سيناريوهات مصمَّمة لكسره، لا الحالات السهلة فقط.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تسجيلات مكالمات حقيقية، لا عروض بسيناريو</h3>
        <ul class="journey-list">
          <li>اختبار مقابل تسجيلات أو نصوص مكالمات فعلية حيث متاحة، لا سيناريو مكتوب نظيف</li>
          <li>تضمين تبديلات حقيقية في منتصف الجملة، لا فقط مكالمات تفتح بلغة ثابتة واحدة</li>
          <li>إضافة ضجيج خلفية وكلام متداخل، لأن المكالمات الحقيقية نادراً ما تحدث في صمت</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سيناريوهات صعبة عمداً</h3>
        <ul class="journey-list">
          <li>متصل يغيّر رأيه أو طلبه في منتصف المكالمة</li>
          <li>لكنة خليجية ثقيلة مقترنة بكلام سريع وعامي</li>
          <li>طلب لا يجب على الوكيل التعامل معه فعلياً، للتأكد أنه يصعّد بدلاً من التخمين</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
