---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';

const processSteps = [
  { icon: "search", step: "الخطوة 1", title: "التشخيص", description: "نُخطط لعملياتك ونُحدد أين يخلق الذكاء الاصطناعي أكبر قيمة." },
  { icon: "edit", step: "الخطوة 2", title: "التصميم", description: "تخطيط البنية، متطلبات البيانات، وتصميم النظام. توافق قبل أن نبدأ البناء." },
  { icon: "code", step: "الخطوة 3", title: "البناء والاختبار", description: "التطوير، التكامل، اختبار الجودة، وفحوصات شاملة للنظام قبل الإطلاق." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والدعم", description: "يُطلق النظام. يشمل دعماً لمدة 90 يوماً. تدريب الفريق مشمول في معظم الباقات." },
];

const faqItems = [
  { question: "كم يستغرق تطوير نظام ذكاء اصطناعي مخصص؟", answer: "يُحدَّد نطاق كل مشروع بشكل فردي. نمنحك جدولاً زمنياً دقيقاً بعد جلسة التشخيص، بناءً على عملياتك وبياناتك ومتطلبات التكامل الخاصة بك." },
  { question: "هل تعملون مع الأنظمة التي نستخدمها حالياً؟", answer: "نعم. نتكامل مع معظم أنظمة CRM وERP ومئات تطبيقات الأعمال الأخرى عبر واجهات برمجية. تحتفظ بالأدوات التي يعرفها فريقك بالفعل؛ نحن نضيف طبقة ذكاء اصطناعي فوقها." },
  { question: "أين تُستضاف بياناتنا؟", answer: "نوفر استضافة مرنة: سحابية أو محلية داخل الشركة. للعملاء الذين لديهم متطلبات إقامة بيانات، نُهيئ عمليات النشر لتلبية متطلبات الامتثال الإقليمية الخاصة بك. تُناقش جميع الخيارات خلال جلسة التشخيص." },
  { question: "ماذا لو احتجنا تعديلات بعد الإطلاق؟", answer: "تشمل جميع الباقات دعماً لمدة 90 يوماً بعد الإطلاق: إصلاح الأخطاء، تعديلات بسيطة، وتحسين الأداء. بعد ذلك، نوفر عقود دعم مستمر. تواصل معنا للتفاصيل." },
  { question: "ما هو ضمان الاسترداد بنسبة 100%؟", answer: "إذا سلّمنا نظام الذكاء الاصطناعي المخصص لك ولم تكن راضياً عن النتائج، نُعيد لك 100% من استثمارك. بدون شروط مخفية وبدون قيود. هذا وعدنا، ولهذا السبب لا نقبل إلا المشاريع التي نعلم أننا قادرون على تنفيذها بشكل ممتاز." },
  { question: "ما الفرق بين الذكاء الاصطناعي المخصص واستخدام أداة ذكاء اصطناعي عامة لفريقنا؟", answer: "أدوات الذكاء الاصطناعي الجاهزة عامة الغرض ولا تعرف شيئاً عن عملك. تطوير الذكاء الاصطناعي المخصص يعني بناء نظام مدرَّب على بياناتك الخاصة، مدمج مع عملياتك الخاصة، ومُهيَّأ بقواعدك وضوابطك الخاصة. يعرف منتجاتك، وأسلوبك، وسياساتك، وعملاءك. يمكنه اتخاذ إجراءات داخل أنظمتك، وليس فقط الإجابة عن الأسئلة. الفرق في جودة النتائج العملية كبير." },
  { question: "أي نوع من الشركات يستفيد أكثر من تطوير الذكاء الاصطناعي المخصص؟", answer: "الشركات التي لديها أعمال متكررة وعالية الحجم تتطلب معرفة متخصصة بالمجال، والشركات ذات تفاعلات العملاء المعقدة التي تحتاج اتساقاً، والشركات التي تُشكّل فيها العمليات اليدوية عائقاً حقيقياً أمام النمو. إذا كنت تُنفق وقتاً كبيراً من فريقك على مهام تتبع نمطاً معيناً لكنها تحتاج حكماً، فإن تطوير الذكاء الاصطناعي المخصص يُحقق عائداً سريعاً في الغالب." },
  { question: "هل نحتاج إلى تجهيز بياناتنا قبل بدء المشروع؟", answer: "لا. تجهيز البيانات جزء مما نقوم به. نُقيّم بياناتك الحالية خلال جلسة التشخيص، نُحدد ما هو مطلوب، نساعدك على جمع أو توليد ما ينقص، ونتولى كل عمليات التنظيف والتنسيق قبل أن نبدأ البناء. لا تحتاج إلى الحضور ببيانات منظمة تنظيماً مثالياً." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "تطوير ذكاء اصطناعي مخصص", "url": "https://lenooai.com/ar/services/custom-ai-development", "description": "نبني أنظمة ذكاء اصطناعي مخصصة حول عمليات عملك بالضبط: روبوتات محادثة، مسارات أتمتة، لوحات تحليل تنبؤية، وتكاملات CRM/ERP.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "offers": { "@type": "Offer", "description": "تطوير ذكاء اصطناعي مخصص: التسعير حسب نطاق مشروعك. احجز مكالمة استكشافية مجانية للحصول على عرض سعر." }, "serviceType": "تطوير الذكاء الاصطناعي", "termsOfService": "ضمان رضا 100%. استرداد كامل إذا لم تكن راضياً." },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "تطوير ذكاء اصطناعي مخصص", "item": "https://lenooai.com/ar/services/custom-ai-development" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];
---

<ArBaseLayout
  title="تطوير ذكاء اصطناعي مخصص لشركات الإمارات: روبوتات محادثة وأنظمة ذكاء اصطناعي | Aegis AI"
  description="بصفتنا وكالة ذكاء اصطناعي في دبي، نبني أنظمة ذكاء اصطناعي مخصصة لشركات الإمارات حول عملياتك: روبوتات محادثة، أتمتة، لوحات تحليل، ووكلاء."
  canonicalPath="/ar/services/custom-ai-development"
  enPath="/services/custom-ai-development"
  ogImage="/assets/og-custom-ai.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير ذكاء اصطناعي مخصص</div>
    <h1>ذكاء اصطناعي مبني حول عملياتك، <span class="gradient-text">لا العكس</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:600px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      الذكاء الاصطناعي الجاهز لا يناسب عملك. نبني أنظمة ذكاء اصطناعي تفعل بالضبط ما يحتاجه فريقك وتتكامل مع الأدوات التي تستخدمها بالفعل.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_custom_ai_hero" class="btn-primary">احجز مكالمة استكشافية مجانية</button>
      <a href="#what-we-build" class="btn-outline">شاهد ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:240px;">
  <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=1400&q=80&auto=format&fit=crop" alt="تطوير ذكاء اصطناعي مخصص وهندسة برمجيات" loading="eager" fetchpriority="high" width="1400" height="240" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
</div>

<!-- WHY CUSTOM -->
<section class="section" aria-labelledby="why-custom-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="why-custom-heading" style="margin-bottom:1.5rem;">لماذا لا يكفي الذكاء الاصطناعي الجاهز</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        أدوات الذكاء الاصطناعي العامة مصممة للجميع، أي أنها في الواقع محسّنة لأحد تحديداً. الذكاء الاصطناعي الجاهز لا يعرف أسعارك، أو إجراءاتك التشغيلية، أو إرشادات علامتك التجارية. عندما تبني باستخدام أدوات عامة، تقضي وقتاً أطول في تصحيح النتائج مما توفره أثناء توليدها، لأن الذكاء الاصطناعي يعمل دائماً من نقطة انطلاق عامة بدلاً من سياقك الفعلي.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        تطوير الذكاء الاصطناعي المخصص يبني النظام حول عملياتك، لا حول فكرة شخص آخر عن شكل الشركة النموذجية. يعرف الذكاء الاصطناعي منتجاتك، وعملاءك، وتنسيقات بياناتك، ومتطلبات الامتثال لديك، وأسلوبك في التواصل. يتكامل مباشرة مع أدواتك الحالية بحيث يستطيع اتخاذ إجراءات داخل أنظمتك، لا مجرد توليد نص لينسخه أحدهم. النتيجة نظام يناسب فعلاً طريقة عمل شركتك.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        الشركات التي تستفيد أكثر هي التي لديها عمليات عالية الحجم ومتخصصة بمجال معين، حيث يقصّر الذكاء الاصطناعي العام: شركات الخدمات المهنية التي تتعامل مع أعمال عملاء معقدة، شركات التجارة الإلكترونية التي تُدير كتالوجات منتجات وعلاقات عملاء كبيرة، شركات اللوجستيات التي تُنسّق بين أطراف وأنظمة متعددة، وأي مؤسسة تكون فيها الدقة والاتساق غير قابلين للتفاوض.
      </p>
    </div>
  </div>
</section>

<!-- OFF-THE-SHELF VS CUSTOM (interactive toggle) -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cad-compare-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="cad-compare-heading">الذكاء الاصطناعي الجاهز مقابل الذكاء الاصطناعي المخصص</h2>
      <p>نفس السؤال، إجابتان مختلفتان. بدّل بينهما لترى الفرق الذي يصنعه السياق.</p>
    </div>
    <div class="cad-compare-grid">
      <div style="border-radius:24px; overflow:hidden; box-shadow:0 24px 56px rgba(0,59,92,0.10); min-height:260px;">
        <img src="https://images.unsplash.com/photo-1611746869696-d09bce200020?w=1200&q=80&auto=format&fit=crop" alt="صاحب عمل يُراجع رد مساعد ذكاء اصطناعي على حاسوب محمول في دبي" loading="lazy" width="1200" height="800" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
      <div class="card" style="padding:2rem;">
        <div class="cad-toggle" role="tablist" aria-label="مقارنة إجابات الذكاء الاصطناعي">
          <button class="cad-toggle-btn is-active" role="tab" id="cad-tab-generic" aria-selected="true" aria-controls="cad-panel-generic" data-cad-toggle="generic">ذكاء اصطناعي جاهز</button>
          <button class="cad-toggle-btn" role="tab" id="cad-tab-custom" aria-selected="false" aria-controls="cad-panel-custom" data-cad-toggle="custom">ذكاء اصطناعي مخصص</button>
        </div>
        <p style="color:#72787e; font-size:0.8125rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; margin:1.5rem 0 0.75rem;">السؤال المطروح</p>
        <p style="color:#00253b; font-size:1rem; font-weight:600; margin-bottom:1.5rem;">«ما سياسة الإرجاع للمنتجات المشتراة أثناء التخفيضات؟»</p>
        <div role="tabpanel" id="cad-panel-generic" aria-labelledby="cad-tab-generic" data-cad-panel="generic">
          <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">«تختلف سياسات الإرجاع حسب المتجر. تسمح معظم المتاجر بالإرجاع خلال 30 يوماً من الشراء، لكن منتجات التخفيضات مستثناة أحياناً. يرجى التحقق من المتجر المحدد لمعرفة سياسته الدقيقة.»</p>
        </div>
        <div role="tabpanel" id="cad-panel-custom" aria-labelledby="cad-tab-custom" data-cad-panel="custom" hidden>
          <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">«يمكن إرجاع منتجات التخفيضات خلال 14 يوماً مع الإيصال، مقابل رصيد في المتجر فقط. المنتجات بالسعر العادي تحصل على استرداد كامل خلال 30 يوماً. بما أن طلبك شُحن في اليوم الثالث، لديك حتى اليوم السابع عشر لإرجاعه. هل تريد أن أبدأ عملية الإرجاع الآن؟»</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var toggles = document.querySelectorAll('[data-cad-toggle]');
  var panels = document.querySelectorAll('[data-cad-panel]');
  toggles.forEach(function (btn) {
    btn.addEventListener('click', function () {
      toggles.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(function (p) { p.hidden = true; });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      var panel = document.querySelector('[data-cad-panel="' + btn.getAttribute('data-cad-toggle') + '"]');
      if (panel) panel.hidden = false;
    });
  });
})();
</script>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">ماذا نبني لك</h2>
      <p style="color:#42474e; font-size:1.0625rem;">فئات شائعة من أنظمة الذكاء الاصطناعي التي نبنيها، وليست قائمة شاملة. كلها مبنية حسب عملياتك ومدمجة مع أدواتك الحالية. إذا لم تُناسب فكرتك أياً من هذه الفئات، أخبرنا بما تحتاجه.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200&q=80&auto=format&fit=crop" alt="مهندس Aegis AI يربط نظام ذكاء اصطناعي مخصص بأدوات عمل العميل عبر واجهة برمجية" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعدون ذكاء اصطناعي داخليون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مدرَّبون على بيانات شركتك ومستنداتك وإجراءاتك التشغيلية. يُجيبون على أسئلة فريقك فوراً وبدقة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوتات محادثة للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يتعاملون مع الاستفسارات والحجوزات والدعم على مدار الساعة عبر موقعك وتطبيقات المراسلة وقنوات أخرى، بأي لغة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة سير العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يُلغي المهام اليدوية المتكررة عبر المبيعات والعمليات والإدارة. اربط تطبيقاتك ودع الذكاء الاصطناعي يتولى إدخال البيانات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحات تحليل تنبؤية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أدوات توقّع للمبيعات، الطلب، التسعير، والمخزون. اتخذ قراراتك بناءً على البيانات، لا التخمين.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">integration_instructions</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">طبقات ذكاء اصطناعي لأنظمة CRM وERP</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أضف ذكاءً اصطناعياً إلى نظام CRM الحالي أو أنظمتك المخصصة دون استبدالها. يستمر فريقك بالعمل بنفس الطريقة؛ والنظام يصبح أذكى.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">معالجة المستندات بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">العقود، الفواتير، والتقارير تُعالَج تلقائياً. يستخرج، يُصنّف، ويُوجّه البيانات خلال ثوانٍ.</p>
      </div>
    </div>
  </div>
</section>

