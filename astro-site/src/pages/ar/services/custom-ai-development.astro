---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "كم يستغرق تطوير ذكاء اصطناعي مخصص؟", answer: "كل مشروع يُحدَّد نطاقه بشكل منفصل. نعطيكم جدولاً زمنياً دقيقاً بعد جلسة الاكتشاف، بناءً على سير عملكم وبياناتكم ومتطلبات الربط الخاصة بكم." },
  { question: "هل تعملون مع أنظمتنا الحالية؟", answer: "نعم. نربط مع معظم أنظمة CRM وERP ومئات تطبيقات الأعمال الأخرى عبر API. تحتفظون بالأدوات التي يعرفها فريقكم، ونضيف طبقة ذكاء اصطناعي فوقها." },
  { question: "أين تُستضاف بياناتنا؟", answer: "نقدم استضافة مرنة: سحابية أو داخل مقركم. للعملاء الذين لديهم متطلبات لإقامة البيانات، نضبط عمليات النشر لتلبية متطلبات الامتثال الإقليمية. نناقش كل الخيارات أثناء الاكتشاف." },
  { question: "ماذا لو احتجنا تعديلات بعد الإطلاق؟", answer: "كل الباقات تشمل دعماً لمدة ٩٠ يوماً بعد الإطلاق: إصلاح الأخطاء، التعديلات الصغيرة، وتحسين الأداء. بعد ذلك، نقدم عقود دعم مستمر. تواصلوا معنا للتفاصيل." },
  { question: "ما هو ضمان الاسترداد ١٠٠٪؟", answer: "إذا سلّمنا نظام الذكاء الاصطناعي المخصص ولم تكونوا راضين عن النتائج، نردّ ١٠٠٪ من استثماركم. دون شروط مخفية ودون قيود. هذا وعدنا، ولهذا لا نقبل إلا المشاريع التي نعرف أننا نستطيع تنفيذها جيداً." },
  { question: "كيف يختلف الذكاء الاصطناعي المخصص عن استخدام أداة ذكاء اصطناعي عامة لفريقنا؟", answer: "أدوات الذكاء الاصطناعي الجاهزة عامة الغرض ولا تعرف شيئاً عن عملكم. تطوير الذكاء الاصطناعي المخصص يعني بناء نظام مدرَّب على بياناتكم، مربوط بسير عملكم، ومضبوط بقواعدكم وضوابط الحماية الخاصة بكم. يعرف منتجاتكم ونبرتكم وسياساتكم وعملاءكم. ويستطيع تنفيذ إجراءات داخل أنظمتكم، لا مجرد الإجابة عن الأسئلة. الفرق في جودة المخرجات العملية كبير." },
  { question: "ما نوع الأعمال الأكثر استفادة من تطوير ذكاء اصطناعي مخصص؟", answer: "الأعمال التي لديها عمل متكرر بحجم كبير يتطلب معرفة متخصصة بالمجال، والأعمال ذات التفاعلات المعقدة مع العملاء التي تحتاج اتساقاً، والأعمال التي تشكّل فيها العمليات اليدوية عائقاً حقيقياً أمام النمو. إذا كان فريقكم يقضي وقتاً كبيراً في مهام تتبع نمطاً لكنها تتطلب تقديراً، فإن تطوير ذكاء اصطناعي مخصص يسترد تكلفته بسرعة في أغلب الحالات." },
  { question: "هل نحتاج لتجهيز بياناتنا قبل بدء المشروع؟", answer: "لا. تجهيز البيانات جزء من عملنا. نقيّم بياناتكم الحالية أثناء الاكتشاف، نحدد ما هو مطلوب، نساعدكم على جمع أو توليد ما ينقص، ونتولى كل عمليات التنظيف والتنسيق قبل أن نبدأ البناء. لا تحتاجون للحضور بمجموعات بيانات منظمة بشكل مثالي." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_custom_ai')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "الاكتشاف", description: "نرسم خريطة سير عملكم ونحدد أين يحقق الذكاء الاصطناعي أكبر قيمة." },
  { icon: "edit", step: "الخطوة ٢", title: "التصميم", description: "تخطيط البنية، متطلبات البيانات، وتصميم النظام. توافقون عليه قبل أن نبدأ البناء." },
  { icon: "code", step: "الخطوة ٣", title: "البناء والاختبار", description: "التطوير، الربط، اختبارات الجودة، وفحوصات شاملة للنظام قبل التشغيل." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "الإطلاق والدعم", description: "يبدأ النظام العمل. دعم ٩٠ يوماً مشمول. تدريب الفريق مشمول في معظم الباقات." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="تطوير ذكاء اصطناعي مخصص للشركات في الإمارات | Lenoo AI"
  description="كوكالة ذكاء اصطناعي في دبي، نبني أنظمة ذكاء اصطناعي مخصصة للشركات في الإمارات حول سير عملكم: روبوتات محادثة، أتمتة، لوحات تحليلية، ووكلاء."
  canonicalPath="/ar/services/custom-ai-development"
  enPath="/services/custom-ai-development"
  ogImage="/assets/og-custom-ai.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير ذكاء اصطناعي مخصص</div>
    <h1>ذكاء اصطناعي مبني حول سير عملكم، <span class="gradient-text">لا العكس</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:600px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      الذكاء الاصطناعي الجاهز لا يناسب عملكم. نبني أنظمة ذكاء اصطناعي تنفذ بالضبط ما يحتاجه فريقكم وتتكامل مع الأدوات التي تستخدمونها أصلاً.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_custom_ai_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div class="container">
  <div style="max-width:960px; margin:-60px auto 3rem; position:relative; z-index:2; border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-card-hover); border:1px solid rgba(255,255,255,0.14);">
    <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=1400&q=80&auto=format&fit=crop" alt="تطوير ذكاء اصطناعي مخصص وهندسة برمجيات" loading="eager" fetchpriority="high" width="1400" height="440" style="width:100%; height:clamp(220px, 32vw, 420px); object-fit:cover; object-position:center 40%; display:block;" />
  </div>
</div>

<!-- WHY CUSTOM -->
<section class="section" aria-labelledby="why-custom-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="why-custom-heading" style="text-align:start; margin-bottom:1.5rem;">لماذا لا يكفي الذكاء الاصطناعي الجاهز</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          أدوات الذكاء الاصطناعي العامة مبنية للجميع، أي أنها ليست مضبوطة لأحد بعينه. الذكاء الاصطناعي الجاهز لا يعرف أسعاركم ولا إجراءات التشغيل القياسية لديكم ولا إرشادات علامتكم التجارية. عندما تبنون بأدوات عامة، تقضون وقتاً في تصحيح المخرجات أكثر مما توفرونه في إنتاجها، لأن الذكاء الاصطناعي يعمل دائماً من قاعدة عامة بدلاً من سياقكم الفعلي.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          تطوير الذكاء الاصطناعي المخصص يبني النظام حول سير عملكم، لا حول تصور شخص آخر لما يبدو عليه العمل النموذجي. يعرف الذكاء الاصطناعي منتجاتكم وعملاءكم وصيغ بياناتكم ومتطلبات الامتثال لديكم ونبرة تواصلكم. ويتكامل مباشرة مع أدواتكم الحالية فيستطيع تنفيذ إجراءات داخل أنظمتكم، لا مجرد توليد نص ينسخه أحدهم ويلصقه. النتيجة نظام يناسب فعلاً طريقة عمل شركتكم.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          الأعمال الأكثر استفادة هي تلك التي لديها سير عمل متخصص بحجم كبير حيث يقصر الذكاء الاصطناعي العام: شركات الخدمات المهنية التي تتولى أعمالاً معقدة للعملاء، ومتاجر التجارة الإلكترونية التي تدير كتالوجات منتجات كبيرة وعلاقات عملاء، وشركات اللوجستيات التي تنسّق بين أطراف وأنظمة متعددة، وأي مؤسسة لا تقبل التهاون في الدقة والاتساق.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=900&q=80&auto=format&fit=crop" alt="شاشة مطوّر تعرض كود نظام ذكاء اصطناعي مخصص" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- OFF-THE-SHELF VS CUSTOM -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cad-compare-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="cad-compare-heading">الذكاء الاصطناعي الجاهز مقابل المخصص</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نفس السؤال، إجابتان. هذا هو الفرق الذي يصنعه السياق.</p>
      <p style="color:#00253b; font-size:1rem; font-weight:600; margin-top:0.75rem;">السؤال: "ما سياسة الإرجاع للمنتجات المشتراة خلال التخفيضات؟"</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">help</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">الذكاء الاصطناعي الجاهز</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.8; margin:0;">"تختلف سياسات الإرجاع من متجر لآخر. معظم المتاجر تسمح بالإرجاع خلال ٣٠ يوماً من الشراء، وأحياناً تُستثنى منتجات التخفيضات. يُرجى التحقق من المتجر المعني لمعرفة سياسته بالضبط."</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">verified</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">الذكاء الاصطناعي المخصص</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.8; margin:0;">"يمكن إرجاع منتجات التخفيضات خلال ١٤ يوماً مع الإيصال، مقابل رصيد في المتجر فقط. المنتجات بالسعر العادي تُسترد قيمتها كاملة خلال ٣٠ يوماً. بما أن طلبكم شُحن يوم ٣، لديكم حتى يوم ١٧ لإرجاعه. هل تريدون أن أبدأ طلب الإرجاع الآن؟"</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">ما نبنيه لكم</h2>
      <p style="color:#42474e; font-size:1.0625rem;">فئات شائعة من أنظمة الذكاء الاصطناعي التي نبنيها، وليست قائمة كاملة. كلها مبنية حسب سير عملكم ومربوطة بأدواتكم الحالية. إذا لم تندرج فكرتكم تحت أي منها، أخبرونا بما تحتاجونه.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200&q=80&auto=format&fit=crop" alt="مهندس من Lenoo AI يربط نظام ذكاء اصطناعي مخصص بأدوات أعمال العميل عبر API" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعدات ذكاء اصطناعي داخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مدرَّبة على بيانات شركتكم ومستنداتها وإجراءات التشغيل القياسية. تجيب عن أسئلة فريقكم فوراً وبدقة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوتات محادثة للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تتولى الاستفسارات والحجوزات والدعم على مدار الساعة عبر موقعكم وتطبيقات المراسلة والقنوات الأخرى، بأي لغة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة سير العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تلغي المهام اليدوية المتكررة في المبيعات والعمليات والإدارة. اربطوا تطبيقاتكم ودعوا الذكاء الاصطناعي يتولى إدخال البيانات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحات تحليلات تنبؤية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أدوات توقّع للمبيعات والطلب والتسعير والمخزون. اتخذوا قراراتكم بناءً على البيانات، لا التخمين.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">integration_instructions</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">طبقات ذكاء اصطناعي لأنظمة CRM وERP</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أضيفوا الذكاء الاصطناعي إلى نظام CRM الحالي أو أنظمتكم المخصصة دون استبدالها. يستمر فريقكم في العمل بنفس الطريقة، ويصبح النظام أذكى.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لمعالجة المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">العقود والفواتير والتقارير تُعالَج تلقائياً. يستخرج البيانات ويصنّفها ويوجّهها خلال ثوانٍ.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="included-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="included-heading">ما يشمله كل مشروع ذكاء اصطناعي مخصص</h2>
      <p style="color:#42474e; font-size:1.0625rem;">ليس نظام الذكاء الاصطناعي فقط. كل مشروع يشمل الدعم والتنظيم الذي يحتاجه فريقكم لاستخدامه فعلياً.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1200&q=80&auto=format&fit=crop" alt="مساحة عمل تطوير برمجيات أثناء بناء نظام ذكاء اصطناعي مخصص" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3>تقييم الاحتياجات وتحديد النطاق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">جلسة اكتشاف منظمة لرسم خريطة سير عملكم، وتحديد أين يحقق الذكاء الاصطناعي أكبر قيمة، ووضع نطاق دقيق دون مفاجآت.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">dataset</span></div>
        <h3>تجهيز البيانات</h3>
