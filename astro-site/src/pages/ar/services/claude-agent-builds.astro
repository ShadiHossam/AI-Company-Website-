---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "لماذا نبني على نماذج الذكاء الاصطناعي الرائدة؟", answer: "وكلاء الذكاء الاصطناعي لدينا مبنيون على نماذج صُممت مع تركيز على الأمان، والالتزام بالتعليمات، والاستدلال على سياق طويل. في تطبيقات الأعمال، يعني ذلك وكلاء يتبعون القواعد بموثوقية، وينفذون مهام معقدة متعددة الخطوات دون الخروج عن النص، ويتعاملون بهدوء مع المواقف الغامضة. يؤدون بشكل ممتاز خصوصاً في المهام التي تتطلب قراءة مستندات كبيرة والاستدلال عليها، والحفاظ على سلوك ثابت عبر محادثات طويلة، والعمل ضمن ضوابط حماية صارمة." },
  { question: "كيف يختلف وكيل الذكاء الاصطناعي عن روبوت المحادثة العادي؟", answer: "روبوت المحادثة ينتظر الأسئلة ويجيب عنها. أما هؤلاء الوكلاء فلديهم أهداف وأدوات وقدرة على تنفيذ الإجراءات. يستطيعون تصفح أنظمتكم الداخلية، وقراءة الرسائل، وكتابة الردود وإرسالها، وتحديث السجلات، واستدعاء واجهات API، وربط عشرات الخطوات معاً لإتمام مهمة معقدة دون انتظار توجيهكم في كل خطوة. فكروا في روبوت المحادثة كأداة مرجعية، وفي الوكيل كموظف مبتدئ يستطيع إنجاز العمل فعلاً." },
  { question: "ما الأدوات التي يستطيع هؤلاء الوكلاء استخدامها؟", answer: "نبني وكلاء يستطيعون البحث في الويب، وقراءة الملفات وكتابتها، والاستعلام من قواعد البيانات، واستدعاء واجهات REST API، وإرسال البريد الإلكتروني والرسائل، والتعامل مع نظام CRM لديكم، وتشغيل الكود، واستدعاء وكلاء آخرين. مجموعة الأدوات يحددها ما يحتاجه سير عملكم. نحدد ذلك في جلسة الاكتشاف ولا نضيف إلا ما هو مفيد فعلاً." },
  { question: "كيف تمنعون الوكلاء من فعل شيء خاطئ؟", answer: "نبني ضوابط حماية على كل مستوى: تعليمات نظام واضحة تحدد ما يستطيع الوكيل فعله وما لا يستطيع، ونقاط موافقة للإجراءات عالية المخاطر، وتسجيل للإجراءات بحيث تكون كل خطوة قابلة للتدقيق، وحدود لمعدل التنفيذ تمنع الحلقات الخارجة عن السيطرة. للإجراءات التي لا يمكن التراجع عنها، مثل إرسال الرسائل أو تحديث السجلات أو تحويل الأموال، نصمم خطوات بإشراف بشري تتطلب تأكيداً قبل التنفيذ." },
  { question: "كيف يبدو النشر؟", answer: "نسلّم وكلاء الذكاء الاصطناعي كأنظمة جاهزة للإنتاج، مستضافة على بنيتكم التحتية أو بنيتنا، ومتاحة عبر API، أو واجهة ويب، أو أدوات المراسلة لدى فريقكم، أو أينما يعمل فريقكم. نقدم معها التوثيق، وأدوات التحكم الإدارية، ولوحات المراقبة، ودعماً لمدة ٩٠ يوماً بعد الإطلاق كمعيار أساسي." },
  { question: "هل يستطيع الوكيل العمل عبر عدة أنظمة في وقت واحد؟", answer: "نعم. معظم الوكلاء الذين نبنيهم يتصلون بعدة أنظمة في آن واحد. وكيل المبيعات قد يستعلم من نظام CRM، ويبحث في الويب عن بيانات العميل المحتمل، ويكتب رسالة مخصصة، ويسجل النشاط، كل ذلك في مرة واحدة. نطاق الوصول إلى الأدوات يُحدد أثناء الاكتشاف ويُبنى بدقة وفق ما يحتاجه سير العمل. لا نربط أنظمة دون حاجة، لكننا لا نقيّد القدرات بشكل مصطنع أيضاً." },
  { question: "كيف نتعامل مع الأمر إذا أخطأ الوكيل؟", answer: "كل وكيل نبنيه لديه تسجيل كامل للإجراءات، فترون بالضبط ما فعله ومتى ولماذا. للإجراءات التي لا يمكن التراجع عنها (إرسال الرسائل، تحديث السجلات، تقديم الطلبات)، نبني خطوات موافقة بشرية. وللإجراءات القابلة للاسترداد، ينبّه الوكيل إلى الاستثناءات بدلاً من التخمين. بعد الإطلاق، تغطي فترة الدعم لمدة ٩٠ يوماً أي مشكلات سلوكية تظهر في الاستخدام الفعلي، ونستمر في التحسين حتى يعمل الوكيل بموثوقية." },
  { question: "كيف يختلف هذا عن التعاقد مع وكالة أتمتة لبناء مسارات عمل على Zapier أو Make؟", answer: "Zapier وMake قائمان على القواعد: يتبعان منطق \"إذا حدث هذا فافعل ذاك\" الصارم وينهاران لحظة ظهور شيء لا يطابق النمط المتوقع. أما وكيل الذكاء الاصطناعي فيستدل. يستطيع قراءة النصوص غير المنظمة، واتخاذ قرارات تقديرية، والتعامل مع الاستثناءات، والتكيف مع مدخلات قد يفشل فيها النظام القائم على القواعد. في المهام التي تتضمن اللغة أو المستندات أو الرسائل أو أي شيء فيه تنوع واقعي، يتعامل وكيل الذكاء الاصطناعي مع كامل نطاق المدخلات حيث تحتاج أدوات الأتمتة إلى معالجة لا تنتهي للاستثناءات." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_claude_agents')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "target", step: "الخطوة ١", title: "تحديد المهمة", description: "نحدد أهداف الوكيل، والأدوات التي يحتاجها، وأين يبقى البشر في الحلقة للقرارات عالية المخاطر." },
  { icon: "extension", step: "الخطوة ٢", title: "البناء والربط", description: "نبني الوكيل، ونربطه بأدواتكم ومصادر بياناتكم، ونكتب تعليمات النظام، ونضبط ضوابط الحماية." },
  { icon: "science", step: "الخطوة ٣", title: "اختبار صارم", description: "نختبره تحت الضغط بحالات استثنائية ومدخلات عدائية وسيناريوهات سير عمل حقيقية قبل أن يلمس أي شيء في بيئة الإنتاج." },
  { icon: "monitoring", step: "الخطوة ٤", title: "النشر والمراقبة", description: "سجلات تدقيق كاملة، ولوحات أداء، ودعم لمدة ٩٠ يوماً. يستمر وكيلكم في التحسن بعد الإطلاق." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="بناء وكلاء ذكاء اصطناعي مستقلين للشركات في الإمارات | Lenoo AI"
  description="نحن وكالة ذكاء اصطناعي في دبي نبني وكلاء ذكاء اصطناعي جاهزين للإنتاج للشركات في الإمارات، مع ذاكرة واستخدام للأدوات واستدلال متعدد الخطوات."
  canonicalPath="/ar/services/claude-agent-builds"
  enPath="/services/claude-agent-builds"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>بناء وكلاء ذكاء اصطناعي مستقلين</div>
    <h1>أذكى وكلاء الذكاء الاصطناعي. <span class="gradient-text">مبنيون لعملكم.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      وكلاء الذكاء الاصطناعي لدينا لا يكتفون بالإجابة. يستدلون ويخططون وينفذون. نبني وكلاء جاهزين للإنتاج على نماذج ذكاء اصطناعي رائدة، يتولون سير عمل معقداً باستقلالية، ويتبعون قواعدكم بموثوقية، وينجزون عملاً قابلاً للقياس.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_claude_agents_hero" class="btn-primary">ابنوا وكيل الذكاء الاصطناعي الخاص بكم</button>
      <a href="#agent-types" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=1400&q=80&auto=format&fit=crop" alt="بناء وكلاء ذكاء اصطناعي وأنظمة ذكاء اصطناعي مستقلة" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "٢٠٠ ألف", caption: "رمز في نافذة السياق. وكلاؤنا يستدلون على مستندات كاملة دفعة واحدة" },
      { value: "متعدد الخطوات", caption: "الوكلاء يربطون عشرات الإجراءات لإتمام مهام معقدة من البداية للنهاية" },
      { value: "قابل للتدقيق", caption: "كل إجراء مسجّل وقابل للمراجعة، مع شفافية كاملة حول ما فعله الوكيل" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS AN AI AGENT -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما الذي يميّز وكيل الذكاء الاصطناعي الجاهز للإنتاج؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        معظم الشركات تتعرف على وكلاء الذكاء الاصطناعي من خلال العروض التوضيحية: روبوت محادثة يحجز اجتماعاً، أو مساعد يبحث في الويب. هذه العروض تُظهر إمكانات حقيقية، لكن وكيل العرض التوضيحي ووكيل الإنتاج شيئان مختلفان. العرض التوضيحي يعمل على مدخلات ثابتة ومضبوطة. أما وكيل الإنتاج فيتعامل مع مستخدمين حقيقيين، وبيانات غير مرتبة، وحالات استثنائية، وطلبات غامضة، وإجراءات لها عواقب، كل يوم، وعلى نطاق واسع.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        وكيل الذكاء الاصطناعي الجاهز للإنتاج يملك خصائص تفتقدها وكلاء العروض التوضيحية عادةً. يتبع التعليمات بموثوقية تحت المدخلات العدائية، لا النظيفة فقط. يعرف ما لا يستطيع فعله فيصعّد بدلاً من الارتجال. كل إجراء ينفذه مسجّل وقابل للتدقيق، فعندما يحدث شيء غير متوقع ترون بالضبط ما فعله الوكيل ولماذا وفي أي لحظة. لديه ضوابط حماية تمنع السلوك الخارج عن السيطرة. ويتصل بسلاسة بالأنظمة الفعلية التي يعمل عليها عملكم، لا بنسخ محاكاة منها.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذا ما نبنيه. أخذنا الوقت لفهم ما يجعل الوكلاء يفشلون في الإنتاج، وصممنا حلولاً لتلك الأعطال تحديداً. النتيجة وكلاء تثق بهم الفرق التي تستخدمهم: ليس لأنهم لا يخطئون أبداً، بل لأن أخطاءهم عندما تحدث تكون مرئية ومحصورة وقابلة للتصحيح. الشركات لا تتبنى وكلاء الذكاء الاصطناعي لأنهم مثيرون للاهتمام. تتبناهم لأن عملاً محدداً وقابلاً للقياس يُنجز ولم يكن يُنجز من قبل.
      </p>
    </div>
  </div>
</section>

<!-- WHAT SETS OUR BUILDS APART -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="architecture-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="architecture-heading">ما يشمله كل وكيل نبنيه</h2>
      <p style="color:#42474e; font-size:1.0625rem;">هذه ليست إضافات اختيارية. إنها الحد الأدنى لأي وكيل نطلقه في بيئة الإنتاج.</p>
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified_user</span></div>
        <h3>ضوابط حماية مدروسة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">قيود واضحة على مستوى النظام تحدد ما يستطيع الوكيل فعله وما لا يستطيع. لا يرتجل الوكيل خارج صلاحياته، حتى عندما يواجه مدخلات غير متوقعة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">receipt_long</span></div>
        <h3>تسجيل كامل للإجراءات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">كل إجراء ينفذه الوكيل مسجّل مع منطقه. تستطيعون فحص ما فعله بالضبط ومتى ولماذا: مفيد لتتبع الأخطاء والامتثال وبناء الثقة داخل المؤسسة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_check</span></div>
        <h3>خطوات بإشراف بشري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">للإجراءات عالية المخاطر أو التي لا يمكن التراجع عنها، نبني نقاط موافقة. ينجز الوكيل العمل لكنه ينتظر تأكيد إنسان قبل تنفيذ أي شيء له عواقب.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">cable</span></div>
        <h3>ربط بأنظمة حقيقية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">متصل بنظام CRM والبريد الإلكتروني وقواعد البيانات وواجهات API الفعلية لديكم، لا بنسخ تجريبية معزولة. يعمل الوكيل في بيئتكم الحقيقية من اليوم الأول.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3>لوحات الأداء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">رؤية مباشرة لأداء الوكيل: المهام المنجزة، ونسب النجاح، وأنماط الأخطاء، واتجاهات الاستخدام. تعرفون دائماً إن كان الوكيل يؤدي عمله.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support</span></div>
        <h3>دعم ٩٠ يوماً بعد الإطلاق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الاستخدام الفعلي يكشف حالات استثنائية لا يكشفها الاختبار. نبقى معكم ٩٠ يوماً بعد الإطلاق لإصلاح المشكلات، وتحسين السلوك، والتأكد من أن الوكيل يعمل بموثوقية على نطاق واسع.</p>
      </div>
    </div>
  </div>
</section>

<!-- AGENT TYPES -->
<section id="agent-types" class="section" aria-labelledby="agents-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="agents-heading">وكلاء الذكاء الاصطناعي الذين نبنيهم للشركات</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة شائعة لما نبنيه، وليست قائمة ثابتة. كل وكيل مبني خصيصاً لسير عملكم. إذا لم تطابق حالتكم أي شيء مذكور هنا، ما زلنا نرغب في سماعها.</p>
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">manage_search</span></div>
        <h3>وكلاء البحث والتحليل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يقرأ المستندات، ويبحث في الويب، ويجمع النتائج، ويسلّم تقارير منظمة. ساعات من عمل المحللين تُنجز في دقائق.</p>
      </div>
