---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import StatStrip from '../../../components/StatStrip.astro';

const faqItems = [
  { question: "لماذا البناء على أحدث نماذج الذكاء الاصطناعي؟", answer: "وكلاؤنا مبنيون على نماذج مصمَّمة مع تركيز على السلامة، اتباع التعليمات، والتفكير طويل السياق. بالنسبة لتطبيقات الأعمال، يعني هذا وكلاء يتبعون القواعد بثبات، يُنجزون مهاماً متعددة الخطوات دون الخروج عن المسار، ويتعاملون بمرونة مع المواقف الغامضة. يتفوقون تحديداً في المهام التي تتطلب قراءة وتحليل مستندات ضخمة، الحفاظ على سلوك ثابت عبر محادثات طويلة، والعمل ضمن حدود صارمة." },
  { question: "ما الفرق بين وكيل الذكاء الاصطناعي وروبوت المحادثة العادي؟", answer: "روبوت المحادثة ينتظر الأسئلة ويجيب عليها. هؤلاء الوكلاء لديهم أهداف، أدوات، وقدرة على اتخاذ إجراءات فعلية. يمكنهم تصفح أنظمتك الداخلية، قراءة رسائل البريد، كتابة الردود وإرسالها، تحديث السجلات، استدعاء الواجهات البرمجية، وربط عشرات الخطوات معاً لإنجاز مهمة معقدة دون انتظارك لتوجيه كل خطوة. فكّر بروبوت المحادثة كأداة مرجعية، وبالوكيل كموظف مبتدئ قادر فعلاً على إنجاز العمل." },
  { question: "ما الأدوات التي يمكن لهؤلاء الوكلاء استخدامها؟", answer: "نبني وكلاء يستخدمون البحث عبر الإنترنت، قراءة وكتابة الملفات، الاستعلام عن قواعد البيانات، استدعاء واجهات REST البرمجية، إرسال البريد والرسائل، التفاعل مع CRM، تشغيل الأكواد، واستدعاء وكلاء آخرين. مجموعة الأدوات تُحدَّد حسب ما يحتاجه سير عملك. نحدّد هذا في جلسة الاستكشاف ولا نضيف إلا ما هو مفيد فعلاً." },
  { question: "كيف تمنعون الوكيل من فعل شيء خاطئ؟", answer: "نبني حواجز أمان على كل مستوى: تعليمات نظام واضحة تحدّد ما يستطيع الوكيل فعله وما لا يستطيع، نقاط موافقة للإجراءات عالية المخاطر، تسجيل كامل للإجراءات بحيث تكون كل خطوة قابلة للمراجعة، وحدود معدل تمنع الحلقات المتكررة الخارجة عن السيطرة. للإجراءات التي لا يمكن التراجع عنها، مثل إرسال بريد إلكتروني، تحديث سجلات، أو تحريك أموال، نصمّم خطوات تتطلب تدخلاً بشرياً وتأكيداً قبل التنفيذ." },
  { question: "كيف يبدو النشر؟", answer: "نُسلّم وكلاءنا كأنظمة جاهزة للإنتاج، مُستضافة على بنيتك التحتية أو بنيتنا، ويمكن الوصول إليها عبر واجهة برمجية، واجهة ويب، أدوات المراسلة التي يستخدمها فريقك، أو أي مكان يعمل فيه فريقك. نُضمّن التوثيق، لوحات تحكم إدارية، لوحات مراقبة، و90 يوماً من الدعم بعد الإطلاق كجزء أساسي." },
  { question: "هل يمكن للوكيل العمل عبر أنظمة متعددة في آن واحد؟", answer: "نعم. معظم الوكلاء الذين نبنيهم يتصلون بعدة أنظمة في وقت واحد. وكيل مبيعات مثلاً قد يستعلم من CRM، يبحث في الإنترنت عن بيانات العميل المحتمل، يكتب بريداً مخصصاً، ويسجّل النشاط، كل ذلك في تمريرة واحدة. نطاق الوصول للأدوات يُحدَّد أثناء الاستكشاف ويُبنى بدقة حسب ما يحتاجه سير العمل. لا نربط أنظمة دون داعٍ، لكننا لا نُقيّد القدرة بشكل مصطنع أيضاً." },
  { question: "كيف نتعامل مع الأمر إذا أخطأ الوكيل؟", answer: "كل وكيل نبنيه لديه تسجيل كامل للإجراءات، فترى بالضبط ماذا فعل، متى، ولماذا. للإجراءات التي لا يمكن التراجع عنها (إرسال بريد، تحديث سجلات، تنفيذ طلبات)، نبني خطوات موافقة تتطلب تدخلاً بشرياً. أما الإجراءات القابلة للتصحيح، فيُبلّغ الوكيل عن الاستثناءات بدلاً من التخمين. بعد الإطلاق، تغطي فترة الدعم لمدة 90 يوماً أي مشاكل سلوكية تظهر في الاستخدام الفعلي، ونُكرّر التحسين حتى يعمل الوكيل بثبات." },
  { question: "ما الفرق بين هذا وتوظيف وكالة أتمتة لبناء سير عمل على Zapier أو Make؟", answer: "أدوات مثل Zapier و Make قائمة على قواعد صارمة: تتبع منطق \"إذا حدث هذا فافعل ذلك\" وتتعطل بمجرد أن يخرج شيء عن النمط المتوقع. وكيل الذكاء الاصطناعي يُفكّر. يمكنه قراءة نص غير مُهيكل، اتخاذ أحكام، التعامل مع الاستثناءات، والتكيّف مع مدخلات كان النظام القائم على القواعد سيفشل معها. للمهام التي تتضمن لغة، مستندات، رسائل بريد، أو أي شيء فيه تنوّع من الواقع، يتعامل وكيل الذكاء الاصطناعي مع كامل نطاق المدخلات حيث تحتاج أدوات الأتمتة إلى معالجة استثناءات لا نهائية." },
];

const processSteps = [
  { icon: "target", step: "الخطوة 1", title: "تحديد المهمة", description: "نُحدد أهداف الوكيل، الأدوات التي يحتاجها، والنقاط التي يبقى فيها الإنسان جزءاً من القرار في المهام عالية المخاطر." },
  { icon: "extension", step: "الخطوة 2", title: "البناء والربط", description: "نبني الوكيل، نربطه بأدواتك ومصادر بياناتك، نكتب تعليمات النظام، ونُهيّئ حواجز الأمان." },
  { icon: "science", step: "الخطوة 3", title: "اختبار دقيق", description: "نختبره بحالات استثنائية، مدخلات معاكسة، وسيناريوهات سير عمل حقيقية، قبل أن يلمس الإنتاج." },
  { icon: "monitoring", step: "الخطوة 4", title: "نشر ومراقبة", description: "سجلات تدقيق كاملة، لوحات أداء، ودعم لمدة 90 يوماً. وكيلك يستمر بالتحسّن بعد الإطلاق." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "بناء وكلاء ذكاء اصطناعي مستقلين",
    "url": "https://lenooai.com/ar/services/claude-agent-builds",
    "description": "وكلاء ذكاء اصطناعي مستقلون وجاهزون للإنتاج، مبنيون على أحدث النماذج، بذاكرة، واستخدام أدوات، وتفكير متعدد الخطوات، وحواجز أمان بمستوى المؤسسات.",
    "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير وكلاء الذكاء الاصطناعي"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "بناء وكلاء ذكاء اصطناعي مستقلين", "item": "https://lenooai.com/ar/services/claude-agent-builds" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
  }
];
---

<ArBaseLayout
  title="بناء وكلاء ذكاء اصطناعي جاهزين للإنتاج للشركات في الإمارات | Aegis AI"
  description="Aegis AI، وكالة الذكاء الاصطناعي في دبي، تبني وكلاء ذكاء اصطناعي مستقلين وجاهزين للإنتاج لشركات الإمارات، بذاكرة، واستخدام أدوات، وتفكير متعدد الخطوات."
  canonicalPath="/ar/services/claude-agent-builds"
  enPath="/services/claude-agent-builds"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>بناء وكلاء ذكاء اصطناعي مستقلين</div>
    <h1>أذكى وكلاء الذكاء الاصطناعي. <span class="gradient-text">مبنيّون خصيصاً لشركتك.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      وكلاؤنا لا يجيبون فحسب. يُفكرون، يُخطّطون، ويتصرفون. نبني وكلاء جاهزين للإنتاج على أحدث نماذج الذكاء الاصطناعي، يُنجزون سير عمل معقداً بشكل مستقل، يتبعون قواعدك بثبات، ويُنجزون عملاً حقيقياً قابلاً للقياس.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_claude_agents_hero" class="btn-primary">ابنِ وكيلك الآن</button>
      <a href="#agent-types" class="btn-outline">شاهد ما نبنيه ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=1400&q=80&auto=format&fit=crop" alt="بناء وكلاء Claude للذكاء الاصطناعي وأنظمة مستقلة" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "200K", caption: "رمز في نافذة السياق. وكلاؤنا يُحلّلون مستندات كاملة دفعة واحدة" },
      { value: "متعدد الخطوات", caption: "يربط الوكيل عشرات الإجراءات لإنجاز مهام معقدة من البداية للنهاية" },
      { value: "قابل للتدقيق", caption: "كل إجراء مُسجَّل وقابل للمراجعة، بشفافية كاملة عمّا فعله الوكيل" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما الذي يجعل وكيل ذكاء اصطناعي جاهزاً للإنتاج مختلفاً؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        معظم الشركات تتعرّف على وكلاء الذكاء الاصطناعي من خلال العروض التوضيحية: روبوت محادثة يحجز اجتماعاً، مساعد يبحث في الإنترنت. تُظهر هذه العروض إمكانات حقيقية، لكن الوكيل التجريبي والوكيل الإنتاجي أمران مختلفان. العرض التوضيحي يعمل على مدخل ثابت ومضبوط. الوكيل الإنتاجي يتعامل مع مستخدمين حقيقيين، بيانات فوضوية، حالات استثنائية، طلبات غامضة، وإجراءات ذات تبعات، كل يوم، على نطاق واسع.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        وكيل الذكاء الاصطناعي الجاهز للإنتاج يمتلك خصائص عادة ما تفتقر إليها الوكلاء التجريبية. يتبع التعليمات بثبات تحت مدخلات معاكسة، لا النظيفة فقط. يعرف ما لا يستطيع فعله ويُصعّد الأمر بدلاً من الارتجال. كل إجراء يتخذه مُسجَّل وقابل للمراجعة، فعندما يحدث شيء غير متوقع، ترى بالضبط ماذا فعل الوكيل، ولماذا، وعند أي نقطة. لديه حواجز أمان تمنع السلوك الخارج عن السيطرة. ويتصل بشكل نظيف بالأنظمة الفعلية التي تُدير بها شركتك، لا نسخاً محاكاة منها.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذا ما نبنيه. أخذنا الوقت الكافي لفهم أسباب فشل الوكلاء في الإنتاج، وهندسنا حلولاً ضد نقاط الفشل هذه تحديداً. النتيجة وكلاء تثق بهم الفرق التي تستخدمهم: ليس لأنهم لا يخطئون أبداً، بل لأنه حين يخطئون، يكون الخطأ مرئياً ومحصوراً وقابلاً للتصحيح. الشركات لا تتبنى وكلاء الذكاء الاصطناعي لأنهم مثيرون للاهتمام. تتبناهم لأن عملاً محدداً وقابلاً للقياس يُنجَز فعلاً، لم يكن يُنجَز من قبل.
      </p>
    </div>
  </div>
</section>

<section class="section" style="background:#f0f3ff;" aria-labelledby="architecture-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="architecture-heading">ما يشمله كل وكيل نبنيه</h2>
      <p style="color:#42474e; font-size:1.0625rem;">هذه ليست إضافات اختيارية. إنها الحد الأدنى لأي وكيل نُطلقه للإنتاج.</p>
    </div>
    <div class="feature-ledger">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified_user</span></div>
        <h3>حواجز أمان مُهندَسة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حدود واضحة على مستوى النظام تُحدّد ما يستطيع الوكيل فعله وما لا يستطيع. لا يرتجل خارج نطاق مهمته حتى عند مواجهة مدخلات غير متوقعة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">receipt_long</span></div>
        <h3>تسجيل كامل للإجراءات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">كل إجراء يتخذه الوكيل مُسجَّل مع تفسيره. يمكنك معاينة ما فعله بالضبط، متى، ولماذا: مفيد للتدقيق، الامتثال، وبناء الثقة الداخلية.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_check</span></div>
        <h3>خطوات تتطلب تدخلاً بشرياً</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">للإجراءات عالية المخاطر أو التي لا يمكن التراجع عنها، نبني نقاط موافقة. ينجز الوكيل العمل لكن ينتظر تأكيد إنسان قبل تنفيذ أي شيء ذي تبعات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">cable</span></div>
        <h3>ربط بأنظمة حقيقية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">متصل بأنظمة CRM والبريد وقواعد البيانات والواجهات البرمجية الفعلية لديك، لا بنسخ تجريبية محاكاة. يعمل الوكيل في بيئتك الحقيقية من أول يوم.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3>لوحات أداء مباشرة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">رؤية مباشرة لأداء الوكيل: المهام المُنجزة، معدلات النجاح، أنماط الأخطاء، واتجاهات الاستخدام. تعرف دائماً إن كان الوكيل يؤدي عمله.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support</span></div>
        <h3>دعم 90 يوماً بعد الإطلاق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الاستخدام الفعلي في الإنتاج يكشف حالات استثنائية لا يكشفها الاختبار. نبقى معك 90 يوماً بعد الإطلاق لإصلاح المشاكل، ضبط السلوك، وضمان أداء ثابت على نطاق واسع.</p>
      </div>
    </div>
  </div>
</section>

<section id="agent-types" class="section" aria-labelledby="agents-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="agents-heading">وكلاء الذكاء الاصطناعي التي نبنيها للشركات</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة شائعة لما نبنيه، لا كتالوج ثابت. كل وكيل مبني خصيصاً لسير عملك. إذا كانت حالتك لا تطابق أي مما هنا، نودّ سماعها منك.</p>
