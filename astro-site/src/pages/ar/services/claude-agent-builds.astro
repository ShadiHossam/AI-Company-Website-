<script is:inline>
(function () {
  document.querySelectorAll('[data-cab-tabs]').forEach(function (root) {
    var tabs = root.querySelectorAll('[data-cab-tab]');
    var panels = root.querySelectorAll('[data-cab-panel]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
        panels.forEach(function (p) { p.hidden = true; });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        var panel = root.querySelector('[data-cab-panel="' + tab.getAttribute('data-cab-tab') + '"]');
        if (panel) panel.hidden = false;
      });
    });
  });
})();
</script>

