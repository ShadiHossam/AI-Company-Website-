---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

const faqItems = [
  { question: "هل يتعامل مع اللهجة السعودية بشكل مختلف عن اللهجة الإماراتية؟", answer: "يجب أن يفعل، وهنا حيث ينهار الكثير من الذكاء الاصطناعي \"المفعّل عربياً\" بصمت. اللهجة السعودية والإماراتية تشتركان في أساس خليجي لكنهما تتباعدان في المفردات، بعض تصريفات الأفعال، والتعبيرات الشائعة. النظام المضبوط فقط على العربية الخليجية العامة، أو أسوأ، على العربية الفصحى الحديثة، سيبدو مختلفاً بشكل ملحوظ لعميل إماراتي حتى لو كان صحيحاً تقنياً. نُوجّه ونختبر تحديداً لأنماط الكلام الإماراتي والإماراتي الأوسع بدلاً من إعداد \"عربي\" عام، ونسأل كيف يبدو كلام عملائكم فعلياً قبل ضبط أي شيء." },
  { question: "هل يستطيع نفس المساعد التبديل بين العربية الفصحى والعامية حسب من يتحدث معه؟", answer: "نعم، ويجب أن يفعل. استفسار في بوابة حكومية ومحادثة واتساب مع عميل توصيل يتطلبان مستويين مختلفين من العربية، بنفس الطريقة التي يختلف بها بريد إلكتروني لبنك عن رسالة نصية لصديق. نحدد قواعد النبرة لكل قناة ونوع عميل، فيلجأ المساعد افتراضياً لمستوى أكثر رسمية لاستفسار أول مرة أو موضوع حساس للامتثال، ويسترخي للخليجية العامية للمحادثات المستمرة على واتساب، دون أن يبدو وكأنه يقرأ من نصين مختلفين." },
  { question: "كم يستغرق جعل الذكاء الاصطناعي العربي يعمل بشكل جيد، لا مجرد يعمل تقنياً؟", answer: "تشغيل بوت ناطق بالعربية تقنياً قد يحدث خلال أيام. جعل اللهجة والنبرة وسلوك التبديل بين اللغات في نقطة لا تبدو فيها غريبة لعميل خليجي يتطلب اختباراً حقيقياً، عادة بضعة أسابيع من تشغيله ضد أنماط محادثة حقيقية، مراجعة النصوص، والتعديل. نعامل مرحلة الاختبار هذه كجزء من البناء، لا فكرة لاحقة." },
  { question: "هل تبنون هذا فقط لبوتات المحادثة، أم ينطبق على أنظمة ذكاء اصطناعي أخرى أيضاً؟", answer: "عمل اللهجة والعربيزي والتبديل بين اللغات ينطبق على أي شيء يتحدث مع عميل بالعربية: بوتات محادثة، وكلاء صوتيون، أتمتة واتساب، وحتى محتوى مولّد بالذكاء الاصطناعي وردود بريد إلكتروني. المشكلة الأساسية، والحل، متماثلان عبر القنوات، رغم أن الاختبار المحدد يتغير: الصوت يضيف اللهجة النطقية والسرعة فوق كل ما يجب أن يتعامل معه بوت نصي." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "تطوير الذكاء الاصطناعي العربي",
    "url": "https://lenooai.com/ar/services/arabic-ai",
    "description": "وكلاء ذكاء اصطناعي مبنيون ومختبرون للعربية الخليجية الحقيقية: اللهجة، العربيزي، التبديل بين اللغات، وتنسيق RTL، لا مجرد ترجمة فصحى."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي العربي", "item": "https://lenooai.com/ar/services/arabic-ai" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "تطوير الذكاء الاصطناعي العربي",
    "url": "https://lenooai.com/ar/services/arabic-ai",
    "description": "وكلاء ذكاء اصطناعي مبنيون للعربية الخليجية الحقيقية: اللهجة، العربيزي، التبديل بين اللغات، وتنسيق RTL.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Agent Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي العربي: بناء وكلاء يتحدثون العربية الخليجية فعلياً | Lenoo AI"
  description="معظم الذكاء الاصطناعي «المفعّل عربياً» يتعامل فقط مع الفصحى الرسمية. نبني ونختبر بوتات محادثة ووكلاء صوتيين للعربية الخليجية الحقيقية، العربيزي، والتبديل بين اللغات."
  canonicalPath="/ar/services/arabic-ai"
  enPath="/services/arabic-ai"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الذكاء الاصطناعي العربي</div>
    <h1>الذكاء الاصطناعي العربي: بناء وكلاء<br>يتحدثون <span class="gradient-text">العربية الخليجية</span> فعلياً</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:660px; margin:1.5rem auto 2rem; line-height:1.8;">معظم أدوات الذكاء الاصطناعي التي تدّعي "دعم العربية" تعني أنها تستطيع ترجمة العربية الفصحى الحديثة بشكل معقول. هذا ليس ما يتحدثه عملاؤكم. نبني ونختبر وكلاء ذكاء اصطناعي للعربية التي يستخدمها الناس فعلياً في الإمارات: اللهجة الخليجية، العربيزي، والتبديل لإنجليزية في منتصف الجملة.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_arabic_ai_hero" class="btn-primary">شاهد عرض محادثة عربية حية</button>
      <a href="#real-challenges" class="btn-outline">شاهد التحديات الحقيقية ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1600&q=80&auto=format&fit=crop" alt="فريق يراجع نص محادثة باللغة العربية على حاسوب محمول في دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">٢٢</p>
        <p class="stat-lbl">دولة ناطقة بالعربية، لكل منها لهجتها الخاصة، لا لغة منطوقة واحدة مشتركة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢</p>
        <p class="stat-lbl">لغة تجري بها محادثة إماراتية واحدة غالباً، أحياناً في منتصف الجملة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند الرد على عميل خلال أقل من ٥ دقائق، باللغة التي استخدمها أولاً (MIT)</p>
      </div>
    </div>
  </div>
</div>

<!-- WHY SUPPORTS ARABIC USUALLY MEANS IT DOESN'T -->
<section class="section" aria-labelledby="why-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="why-heading" style="margin-bottom:1.5rem;">لماذا "يدعم العربية" عادة يعني أنه لا يدعمها</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>"يدعم العربية" تعني تقريباً دائماً العربية الفصحى الحديثة (MSA).</strong> الفصحى هي العربية الرسمية والموحدة المستخدمة في نشرات الأخبار والوثائق الحكومية والكتب المدرسية. ليست اللغة المنطوقة الأم لأحد. لا أحد في دبي يطلب طعاماً، يراسل صديقاً، أو يشتكي لخدمة العملاء بالفصحى. عندما يجيب بوت محادثة على رسالة واتساب عادية بعربية فصحى رسمية كالكتب المدرسية، يبدو الأمر كما لو أن بوت خدمة عملاء رد على رسالة نصية بإنجليزية قانونية: صحيح تقنياً، خاطئ اجتماعياً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم المزودين يختبرون هذا مرة واحدة، بجملة بسيطة، ويعتبرونه منجزاً.</strong> سؤال تجريبي مثل "ما ساعات عملكم" يُترجَم بشكل نظيف للفصحى ويبدو جيداً في عرض تسويقي. الفشل يظهر لاحقاً، عندما يكتب عميل حقيقي بالعربيزي، يبدّل للإنجليزية في منتصف الجملة، أو يستخدم كلمة تعني شيئاً مختلفاً في العربية الإماراتية عما تعنيه في المصرية أو الشامية. المزودون الذين يبيعون "دعم العربية" كميزة صندوق اختيار نادراً ما يختبرون أياً من ذلك.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>لعمل إماراتي، هذه الفجوة ليست تجميلية.</strong> حصة معتبرة من عملائكم ستلجأ افتراضياً للعربية، أو مزيج من العربية والإنجليزية، بمجرد أن تصبح المحادثة أقل رسمية أو أكثر إلحاحاً. إذا كان الذكاء الاصطناعي يصمد فقط بفصحى منمقة، فإنه يفشل بصمت في خدمة العملاء بالضبط الذين كان يُفترض أن يخدمهم، فيتحولون للإنجليزية، أو يُحبَطون، أو يتوقفون عن الرد. لا شيء من هذه النتائج يظهر كـ"خطأ" واضح في لوحة تحكم. تظهر فقط كتفاعل أضعف لا يستطيع أحد تفسيره.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&q=80&auto=format&fit=crop" alt="شخص يكتب رسالة نصية بالعربية والإنجليزية على هاتف ذكي في الإمارات" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- THE REAL CHALLENGES -->
<section id="real-challenges" class="section" style="background:#e7eeff;" aria-labelledby="challenges-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="challenges-heading">التحديات الحقيقية</h2>
      <p>خمسة أمور يجب أن يتعامل معها نظام ذكاء اصطناعي عربي فعلياً بكفاءة، لا يظهر أي منها إذا اختبرتم فقط بجملة رسمية واحدة.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">record_voice_over</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">اللهجة: الخليجية/الإماراتية مقابل الفصحى</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العربية الخليجية، عائلة اللهجات التي تنتمي إليها الإماراتية، تختلف عن الفصحى في المفردات، أنماط النطق المنعكسة في الكتابة، والتعبيرات اليومية. النموذج الطليق بالفصحى قد لا يزال يبدو متصلباً أو غريباً لأذن خليجية، بنفس الطريقة التي تبدو بها الإنجليزية الرسمية المثالية غريبة في محادثة نصية عادية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">النموذج يحتاج ضبطاً خليجياً محدداً، لا "عربي" كصندوق اختيار فقط</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">keyboard</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">العربيزي (عربي بحروف لاتينية)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كثير من المقيمين في الإمارات يكتبون العربية بحروف لاتينية وأرقام تمثل أصواتاً لا تملكها الإنجليزية، مثل "٣" لحرف ع أو "٧" لحرف ح. رسالة مثل "leish ta5ir el order" مفهومة تماماً كعربية لقارئ بشري وغير قابلة للقراءة لنموذج يتوقع فقط الكتابة العربية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحتاج رصداً ومعالجة صريحين، ليس تلقائياً في معظم النماذج</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">swap_horiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التبديل بين اللغات في منتصف الجملة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">"أبغى أعمل reschedule للموعد" جملة طبيعية تماماً في الإمارات: قواعد عربية تحمل فعلاً إنجليزياً في المنتصف. الأنظمة المدرَّبة لتوقع لغة واحدة لكل رسالة إما تتجاهل الجزء الإنجليزي أو تنهار كلياً عندما تتغير اللغة في منتصف الفكرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">أكثر نقطة فشل شيوعاً في البوتات "المفعّلة عربياً"</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">format_align_right</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تنسيق RTL</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العربية تُقرأ من اليمين لليسار، لكن الأرقام والتواريخ والأسعار وأي إنجليزية أو عربيزي مضمّنة تُقرأ من اليسار لليمين ضمن السطر. الخطأ في هذا ينتج رسائل ينعكس فيها رقم هاتف أو مبلغ بالدرهم بصرياً، أو قائمة نقطية تُعرَض بالاتجاه الخاطئ على واتساب أو أداة محادثة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تفصيل عرض يكسر الثقة بصمت عندما يكون خاطئاً</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">tune</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">النبرة الثقافية والرسمية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العربية تحمل علامات رسمية أوضح من الإنجليزية: كيف تخاطبون عميلاً أكبر سناً يختلف عن نظير، واستفسار متصل بالحكومة يتطلب مستوى مختلفاً عن محادثة واتساب حول توصيل. الخطأ في مستوى الرسمية يبدو بارداً أو غير محترم، لا مجرد "قليلاً خاطئ".</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">قواعد النبرة يجب تحديدها لكل قناة ونوع عميل</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل بناء عربي يُختبَر ضد أنماط كلام خليجية حقيقية قبل الإطلاق، لا نص مترجم فقط.</p>
      <button onclick="openModal(this)" data-source="ar_arabic_ai_mid" class="btn-primary">شاهد عرض محادثة عربية حية</button>
    </div>
  </div>
</section>

<!-- WHAT "ACTUALLY WORKS" LOOKS LIKE -->
<section class="section" aria-labelledby="before-after-heading">
  <div class="container" style="max-width:900px;">
    <div class="section-header">
      <h2 id="before-after-heading">كيف يبدو "يعمل فعلاً"</h2>
      <p>ثلاثة أمثلة توضيحية قبل/بعد: نوع الرسالة التي يخطئ فيها بوت "مفعّل عربياً" عام، وما يفعله بدلاً منه نظام مضبوط للعربية الخليجية.</p>
    </div>

    <div class="ba-example">
      <p class="ba-label">مثال ١: عربيزي بعامية</p>
      <p class="ba-customer">العميل: "wain el order? ta5art wayed 3ala el promised time"</p>
      <div class="ba-row">
        <div class="ba-card ba-before">
          <p class="ba-tag ba-tag-before">قبل (بوت فصحى عام)</p>
          <p class="ba-text">"عذرًا، لم أتمكن من فهم استفسارك. هل يمكنك إعادة صياغته؟"</p>
