---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

const faqItems = [
  { question: "ما اتفاقية مستوى الخدمة الفعلية للاستجابة في العقد الشهري؟", answer: "يعتمد على المستوى، لكن كل عقد نبيعه يحمل وقت استجابة مكتوب مرفق به، عادة في نفس يوم العمل لانقطاع كامل أو إجابة خاطئة حرجة، وخلال بضعة أيام عمل لمشاكل الجودة الأصغر أو طلبات سير عمل جديد. نتفق على الأرقام المحددة معكم كتابياً قبل التوقيع، فلا غموض عندما ينكسر شيء فعلياً." },
  { question: "ماذا يحدث إذا أردنا الإلغاء؟", answer: "العقود تعمل شهرياً بعد مدة دنيا أولية، عادة ثلاثة أشهر، طويلة بما يكفي لنتعلم فعلياً النظام ولتروا إن كانت القيمة موجودة. بعدها، تستطيعون الإلغاء بإشعار، دون التزام طويل، دون عقوبة على المغادرة. نفضّل كسب التجديد كل شهر على حبسكم في عقد غير راضين عنه." },
  { question: "ما الذي يُعتبر إصلاح خلل مشمولاً مقابل ميزة جديدة مدفوعة؟", answer: "الخلل هو أن الوكيل لا يفعل ما بُني واتُّفق عليه: تكامل معطل، إجابة خاطئة على شيء دُرِّب ليصيبه، سير عمل توقف عن التشغيل. هذا مشمول ضمن العقد. الميزة الجديدة هي طلب فعل شيء لم يُبنَ ليفعله أصلاً: سير عمل جديد، قناة جديدة، تكامل جديد لم يكن لديه من قبل. هذا يُحدَّد نطاقه ويُسعَّر منفصلاً، وسنخبركم دائماً بوضوح أي فئة ينتمي إليها شيء قبل القيام بالعمل." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "عقد صيانة ودعم الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-maintenance",
    "description": "عقود صيانة ودعم مستمرة لوكلاء الذكاء الاصطناعي والأتمتة المُشغّلة في الإمارات: المراقبة، إصلاح الأخطاء، ضبط الأوامر، تحديثات النماذج، وتقارير شهرية."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "صيانة الذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-maintenance" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "عقد صيانة ودعم الذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-maintenance",
    "description": "عقود صيانة ودعم مستمرة لوكلاء الذكاء الاصطناعي والأتمتة: المراقبة، إصلاح الأخطاء، ضبط الأوامر، تحديثات النماذج، وتقارير شهرية.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Maintenance and Support"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="عقد صيانة الذكاء الاصطناعي في الإمارات: ما يشمله فعلياً وتكلفته | Lenoo AI"
  description="ما يشمله عقد صيانة ذكاء اصطناعي حقيقي: المراقبة، إصلاح الأخطاء، ضبط الأوامر، تحديثات النماذج، وتقارير شهرية. مستويات وأسعار صادقة للشركات الإماراتية."
  canonicalPath="/ar/services/ai-maintenance"
  enPath="/services/ai-maintenance"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>صيانة الذكاء الاصطناعي</div>
    <h1>ما يشمله <span class="gradient-text">عقد صيانة</span> ذكاء اصطناعي حقيقي</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">نظام ذكاء اصطناعي لا تلمسونه مرة أخرى بعد الإطلاق هو نظام يتوقف عن العمل بصمت. إليكم ما يغطيه عقد صيانة حقيقي، ما لا يغطيه، وتكلفته الفعلية في الإمارات.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai_maintenance_hero" class="btn-primary">شاهدوا خطط عقودنا</button>
      <a href="#tiers" class="btn-outline">شاهدوا مستويات الأسعار ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1560472354-b33ff0c44a43?w=1600&q=80&auto=format&fit=crop" alt="مطور يراجع صحة النظام وتذاكر الدعم" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">٣ أشهر</p>
        <p class="stat-lbl">المدة الدنيا المعتادة لعقودنا، ثم شهرياً بعدها</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٦</p>
        <p class="stat-lbl">أمور يغطيها عقد حقيقي، من المراقبة إلى الدعم بأولوية</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٠</p>
        <p class="stat-lbl">نطاق مفاجئ، كل عقد يحدد كتابياً ما هو مشمول وما ليس كذلك</p>
      </div>
    </div>
  </div>
</div>

<!-- INTRO -->
<section class="section" aria-labelledby="intro-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="intro-heading" style="margin-bottom:1.5rem;">لماذا تحتاج أنظمة الذكاء الاصطناعي صيانة مستمرة</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>البرمجيات التي تُبنى مرة ولا تُلمس مرة أخرى نادرة، وأنظمة الذكاء الاصطناعي أسوأ مرشح لذلك من معظمها.</strong> الموقع الإلكتروني يمكن أن يبقى ثابتاً لسنوات ويظل يعرض بشكل صحيح. وكيل الذكاء الاصطناعي لا يستطيع، لأن ثلاثة أمور تحته تستمر بالتحرك سواء راقبتموها أم لا.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>النماذج تتغير.</strong> المزود خلف وكيلكم يحدّث النموذج الأساسي، أحياناً دون تحذير كبير، وسلوك كان موثوقاً الشهر الماضي قد يتحول قليلاً هذا الشهر. <strong>الأعمال تتغير.</strong> منتجات جديدة، تسعير جديد، عرض ترويجي جديد، سياسة جديدة، ويحتاج الوكيل معرفة كل ذلك وإلا بدأ يعطي إجابات خاطئة بثقة. <strong>البيانات تنحرف.</strong> الأسئلة التي يطرحها العملاء فعلياً تتحول عبر الزمن، حسب الموسم، الحملة، أياً كان الرائج، والوكيل المضبوط لأسئلة الربع الماضي يتعامل بشكل أسوأ مع أسئلة هذا الربع.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">لا شيء من هذا يظهر كرسالة خطأ. يظهر كتراجع بطيء لا يلاحظه أحد حتى يلاحظه عميل. عقد الصيانة هو الآلية التي ترصده أولاً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&q=80&auto=format&fit=crop" alt="فريق يعمل معاً على عملية دعم وصيانة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section class="section" style="background:#e7eeff;" aria-labelledby="included-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="included-heading">ما يشمله عقد حقيقي</h2>
      <p>ستة أمور، كلها مستمرة، لا واحدة منها تسليم لمرة واحدة تشطبونه وتنسونه.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">المراقبة والتنبيهات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تتبع مستمر للدقة والتكلفة ووقت التشغيل، مع تنبيهات مضبوطة على العتبات المهمة لنظامكم تحديداً. مغطى بالكامل في <a href="/ar/services/agentops" style="color:#006875;">صفحة مراقبة الوكلاء</a>.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إصلاح الأخطاء وضبط الأوامر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">عندما يخطئ الوكيل في شيء بُني ليصيبه، نصلحه. يشمل ذلك تعديلات الأوامر، تصحيحات قاعدة المعرفة، وإصلاحات التكامل عندما يتغير شيء من الطرف الآخر.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">system_update</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات النموذج/الإصدار</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">عندما يُحدَّث النموذج الأساسي من مزوده، نختبر وكيلكم ضد التغيير ونضبطه قبل أن يؤثر على عملائكم، بدلاً من اكتشافه بنفس الطريقة التي كنتم ستكتشفونها بها.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير شهرية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقرير مكتوب كل شهر: الحجم المُتعامَل معه، اتجاه التكلفة، اتجاه الدقة، وما غيّرناه بالضبط ولماذا. دليل على أن النظام يعمل، لا مجرد فاتورة.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">add_task</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إضافات سير عمل جديدة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">المستويات الأعلى تشمل قدراً محدداً من عمل سير العمل الجديد كل شهر، إضافات صغيرة لما يتعامل معه الوكيل، دون عرض سعر وفاتورة منفصلة لكل تغيير بسيط.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">اتفاقية دعم بأولوية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">وقت استجابة مكتوب للمشاكل، مُتفق عليه قبل الإطلاق، فعندما ينكسر شيء تعرفون بالضبط كم يجب أن نستجيب سريعاً، لا الانتظار على بريد دعم عام.</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">مبني ومدعوم من نفس الفريق، دون تسليم لطرف غريب بعد اكتمال البناء.</p>
      <button onclick="openModal(this)" data-source="ar_ai_maintenance_mid" class="btn-primary">شاهدوا خطط عقودنا</button>
    </div>
  </div>
</section>

<!-- WHAT'S NOT INCLUDED -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="excluded-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="excluded-heading">ما لا يشمله</h2>
      <p>العقد يبقي ما لديكم فعلاً يعمل. ليس شيكاً على بياض لعمل جديد.</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بناءات جديدة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">وكيل جديد تماماً، قناة جديدة لا يلمسها النظام الحالي (صوت، إذا كان لديكم محادثة فقط)، أو مشروع بحجم ملموس يُحدَّد نطاقه ويُسعَّر بشكل منفصل، بنفس طريقة البناء الأصلي. العقد يبقي النظام الحالي بصحة جيدة، لا يموّل بناء نظام ثانٍ.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تغييرات نطاق كبرى</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">إعادة هيكلة كيفية عمل الوكيل، إضافة مجموعة كبيرة جديدة من سير العمل، أو دمج نظام جديد بالكامل لم يلمسه من قبل يُعامَل كمشروع، لا مهمة صيانة. سنخبركم دائماً بوضوح عندما يتجاوز شيء ذلك الحد قبل القيام بالعمل.</p>
      </div>
    </div>
  </div>
</section>

<!-- TIERS -->
<section id="tiers" class="section" aria-labelledby="tiers-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="tiers-heading">مستويات العقود وتكلفتها</h2>
      <p>نطاقات تقريبية نراها عادة لوكالة مقرها دبي تقوم بهذا العمل، لا بطاقة أسعار ثابتة، لأن النطاق يختلف حسب عدد الوكلاء الذين تشغّلونهم وحجم الحركة التي يتعاملون معها. سنعطيكم رقماً دقيقاً بمجرد معرفة إعدادكم.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أساسي</h3>
        <p style="color:#006875; font-weight:700; font-size:1.25rem; margin-bottom:0.75rem;">١٬٥٠٠–٣٬٠٠٠ درهم/شهرياً</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">مراقبة، إصلاح أخطاء، وتقارير شهرية لوكيل واحد يتعامل مع حجم معتدل. دون ميزانية سير عمل جديد مشمولة.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">قياسي</h3>
        <p style="color:#006875; font-weight:700; font-size:1.25rem; margin-bottom:0.75rem;">٣٬٠٠٠–٦٬٠٠٠ درهم/شهرياً</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">كل ما في المستوى الأساسي، بالإضافة لمخصص شهري لإضافات سير عمل صغيرة جديدة واتفاقية دعم أسرع. المستوى الأكثر شيوعاً لعمل يشغّل وكيلاً إلى وكيلين.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أولوية</h3>
        <p style="color:#006875; font-weight:700; font-size:1.25rem; margin-bottom:0.75rem;">+٦٬٠٠٠ درهم/شهرياً</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">لأنظمة متعددة الوكلاء، حجم أعلى، أو أنظمة حيث تعطل الخدمة مكلف: استجابة في نفس اليوم، تقارير شهرية أعمق، وميزانية سير عمل جديد أكبر.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT HAPPENS WITHOUT -->
<section class="section" style="background:#e7eeff;" aria-labelledby="without-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="without-heading">ماذا يحدث إذا لم يكن لديكم واحد</h2>
      <p>سيناريوهات حقيقية، لا افتراضية، نراها عندما يتخطى عمل الصيانة لتوفير الرسم الشهري.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديث تسعير لا يصل للوكيل أبداً</h3>
