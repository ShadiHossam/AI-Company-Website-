---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

const faqItems = [
  { question: "كم يستغرق إطلاق بوت محادثة بالذكاء الاصطناعي في الإمارات؟", answer: "بوت أحادي الغرض (تأهيل عملاء الموقع أو الأسئلة الشائعة) يُطلق عادة خلال أسبوعين إلى أربعة أسابيع من الانطلاق. بوت مبيعات واتساب مع تكامل CRM وتقويم عادة يستغرق أربعة إلى ستة أسابيع. بناء متعدد القنوات أو مفعّل صوتياً بعدة تكاملات قد يستغرق ثمانية أسابيع أو أكثر. العامل الأكبر ليس الذكاء الاصطناعي نفسه، بل مدى سرعة تقديم فريقكم لمحتوى قاعدة المعرفة، توجيهات صوت العلامة التجارية، ووصول الأنظمة التي يعتمد عليها البناء." },
  { question: "هل يستطيع البوت فعلاً التعامل مع العربية، بما في ذلك اللهجة الخليجية؟", answer: "نماذج اللغة الحديثة تتعامل جيداً مع العربية الفصحى الحديثة وتدير بشكل متزايد أنماط اللهجة الخليجية الشائعة للطلبات اليومية. الجودة ليست مطابقة للإنجليزية بعد، لذا نختبر البوت مقابل عبارات عملاء حقيقية بلهجتكم المستهدفة أثناء البناء، لا العربية الفصحى فقط، ونحدد نطاقاً واضحاً لما يجيب عليه بثقة مقابل متى يحوّله لشخص." },
  { question: "هل يستطيع البوت فعلاً حجز مواعيد، أم يتحدث فقط؟", answer: "يعتمد كلياً على البناء، وهذه أكبر فجوة بين بوت حقيقي وآخر مبني على نص جامد. البوت المبني بشكل صحيح يتحقق من توفر التقويم الفعلي، يحجز الموعد، يرسل تأكيداً، ويستطيع إعادة الجدولة أو الإلغاء عند الطلب. إذا كان عرض المزود التوضيحي يُظهر محادثة فقط دون لمس تقويمكم أو نظام CRM، اسألوا مباشرة إن كان الحجز مشمولاً أم إضافة منفصلة." },
  { question: "من يملك البوت وبياناته بعد الإطلاق؟", answer: "يجب أن تملكوه أنتم. قبل التوقيع مع أي مطور، تأكدوا كتابياً أنكم تملكون سجلات المحادثة، إعدادات سير العمل الأساسية، ومحتوى قاعدة المعرفة، وأنكم تستطيعون تصديرها أو نقلها إذا غيّرتم المزود لاحقاً. نبني على بنية تحتية يتحكم فيها العميل بدلاً من منصة مغلقة تحبس الحساب معنا." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "تطوير بوتات المحادثة بالذكاء الاصطناعي في الإمارات",
    "url": "https://lenooai.com/ar/services/ai-chatbot-development",
    "description": "تطوير بوتات المحادثة بالذكاء الاصطناعي للشركات الإماراتية: بوتات تأهيل عملاء الموقع، بوتات مبيعات واتساب، بوتات دعم، وبوتات حجز، مبنية ثنائية اللغة ومتكاملة مع نظام CRM."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "تطوير بوتات المحادثة", "item": "https://lenooai.com/ar/services/ai-chatbot-development" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "تطوير بوتات المحادثة بالذكاء الاصطناعي في الإمارات",
    "url": "https://lenooai.com/ar/services/ai-chatbot-development",
    "description": "تطوير بوتات محادثة بالذكاء الاصطناعي للشركات الإماراتية: بوتات موقع، واتساب، دعم، وحجز، ثنائية اللغة ومتكاملة مع أنظمتكم.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Chatbot Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="تطوير بوتات المحادثة بالذكاء الاصطناعي في الإمارات: دليل المشتري الكامل | Lenoo AI"
  description="تطوير بوتات المحادثة بالذكاء الاصطناعي في الإمارات: تكلفة البناء الحقيقي، الأنواع الستة التي تشتريها الشركات فعلاً، وكيف تُقيّمون شريك تطوير قبل التوقيع."
  canonicalPath="/ar/services/ai-chatbot-development"
  enPath="/services/ai-chatbot-development"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير بوتات المحادثة</div>
    <h1>تطوير بوتات المحادثة بالذكاء الاصطناعي في الإمارات<br><span class="gradient-text">دليل المشتري الكامل</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:680px; margin:1.5rem auto 2rem; line-height:1.8;">كل ما يحتاج صاحب عمل إماراتي معرفته قبل تكليف بناء بوت محادثة: الأنواع الستة التي تستحق الشراء فعلاً، ما يشمله البناء الحقيقي، تكاليف واقعية، والأسئلة التي تميز شريك تطوير جاد عن بائع قالب جاهز.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai-chatbot-development_hero" class="btn-primary">احجز مكالمة تحديد نطاق مجانية</button>
      <a href="#chatbot-types" class="btn-outline">شاهد الأنواع الستة ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1600&q=80&auto=format&fit=crop" alt="فريق يراجع واجهة محادثة على حاسوب محمول في مكتب بدبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند التواصل مع العميل المحتمل خلال ٥ دقائق لا ٣٠ (MIT)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٦</p>
        <p class="stat-lbl">أنواع بوتات محادثة متمايزة تشتريها الشركات الإماراتية فعلاً، لا بوت عام واحد</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية يضيفها البوت خارج ساعات عمل فريقكم</p>
      </div>
    </div>
  </div>
</div>

<!-- WHAT AI CHATBOT MEANS -->
<section class="section" aria-labelledby="means-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="means-heading" style="margin-bottom:1.5rem;">ماذا يعني "بوت محادثة ذكاء اصطناعي" فعلياً في ٢٠٢٦</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>ليس البوت الجامد الذي تتخيلونه.</strong> إذا كانت صورتكم الذهنية لبوت المحادثة هي شجرة قرارات بأزرار، "اكتب ١ للمبيعات، ٢ للدعم"، فهذا بوت جامد، ومنتج مختلف تماماً. البوت الجامد يستطيع فقط اتباع الفروع المكتوبة مسبقاً. بوت المحادثة بالذكاء الاصطناعي، المبني على نموذج لغوي، يقرأ ما كتبه العميل فعلياً، يفهم القصد حتى لو صيغ بشكل غريب أو بمزيج من العربية والإنجليزية، ويرد بجملة عادية لا قائمة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>وهو أيضاً ليس نفس "وكيل الذكاء الاصطناعي".</strong> المصطلحات تُستخدم بتساهل في العروض التسويقية، لذا يستحق الأمر الدقة: بوت المحادثة يجري محادثة ويجيب أو يوجّهها. الوكيل يذهب أبعد، يتخذ إجراءات عبر أنظمة بمبادرته الخاصة: يتحقق من ثلاث أدوات مختلفة قبل الإجابة، يقرر أي سير عمل يُشغّل، يتابع دون أن يُطلب منه مرة أخرى. معظم الشركات التي تبحث عن "بوت محادثة ذكاء اصطناعي" تريد فعلياً بوتاً بقدرات شبيهة بالوكيل مضافة: احجز هذا الموعد، ابحث عن ذلك الطلب، وهذا نطاق معقول وقابل للبناء.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">معرفة هذا التمييز تهم عند تقييم المزودين، لأن "بوت محادثة ذكاء اصطناعي" يُطلق على منتجات تتراوح من أداة أسئلة شائعة ثابتة ملفوفة بنموذج لغوي، إلى نظام متكامل بالكامل يقرأ تقويمكم، يكتب على نظام CRM، ويحوّل العملاء المهتمين لموظف مبيعات في منتصف المحادثة. فارق السعر بين هذين الأمرين كبير، والمزود الذي لا يسألكم ماذا تحتاجون فعلياً يبيعكم الأرخص افتراضياً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=800&q=80&auto=format&fit=crop" alt="عميل يكتب رسالة في أداة محادثة تجارية على هاتف ذكي" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- 6 CHATBOT TYPES -->
<section id="chatbot-types" class="section" style="background:#e7eeff;" aria-labelledby="types-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="types-heading">الأنواع الستة التي تشتريها الشركات الإماراتية فعلاً</h2>
      <p>معظم مشاريع بوتات المحادثة في هذا السوق تقع ضمن إحدى هذه الفئات الست. معرفة أيها تحتاجونه قبل التحدث مع مزود يبقي المحادثة مركزة والعرض السعري صادقاً.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">language</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت تأهيل عملاء الموقع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجلس على موقعكم، يبدأ محادثة مع الزوار، ويطرح نفس أسئلة التأهيل التي يطرحها موظف مبيعات: الميزانية، الجدول الزمني، الحاجة. يوجّه المؤهلين لفريقكم بدلاً من تركهم يملؤون نموذجاً لا يفحصه أحد حتى الغد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المتصل بهم خلال ٥ دقائق أكثر عرضة للتحويل بـ ٩ أضعاف (MIT)</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت مبيعات واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعمل داخل واتساب، حيث يتواجد معظم عملائكم أصلاً. يجيب عن أسئلة المنتجات، يرسل الكتالوجات، يجمع تفاصيل الطلب، ويدفع المحادثات المؤهلة لموظف مبيعات دون أن يضطر العميل لمغادرة التطبيق.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">القناة الأقل احتكاكاً لرد العميل الإماراتي فعلياً</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت الدعم والأسئلة الشائعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن الأسئلة التي يُسألها فريق دعمكم خمسين مرة أسبوعياً، خلال ثوانٍ بدلاً من طابور تذاكر. مدرّب على وثائق مساعدتكم وسياساتكم الفعلية، ويحوّل أي شيء غير معتاد فعلياً مباشرة لبشري.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل حجم التذاكر المتكررة فيتفرغ فريق الدعم للحالات التي تحتاج حكماً</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">psychology</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت المعرفة الداخلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ليس موجهاً للعملاء إطلاقاً. يعمل داخل Slack أو Teams أو تبويب متصفح ويجيب عن أسئلة الموظفين حول السياسة أو العملية أو المنتج عبر البحث في مستنداتكم الداخلية، فيتوقف الجميع عن مراسلة الزميل الوحيد "الذي يعرف كل شيء".</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل الوقت الذي يقضيه الموظفون في البحث عن إجابات موجودة أصلاً في مكان ما</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت الحجز والجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحقق من توفر التقويم الفعلي، يحجز الموعد الذي يريده العميل، يرسل تأكيدات وتذكيرات، ويعيد الجدولة عند الطلب. الفرق بين هذا وبوت عام هو أنه يكتب فعلياً على تقويمكم، لا يتحدث عن فعل ذلك فقط.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل الحجوزات الفائتة عبر تذكيرات آلية وإعادة جدولة سهلة</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">record_voice_over</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">هجين مفعّل صوتياً</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نفس منطق بوت المحادثة الأساسي، ممتد للمكالمات الهاتفية. المتصل وزائر الموقع يصلان لنفس قاعدة المعرفة ونظام الحجز، فلا تتغير الإجابة حسب القناة التي يستخدمها أحدهم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">قاعدة معرفة واحدة، إجابات متسقة عبر المحادثة والصوت</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل بناء ثنائي اللغة (عربي وإنجليزي)، محدد النطاق لحالة استخدامكم الفعلية، ومتكامل مع الأنظمة التي تديرونها بالفعل.</p>
      <button onclick="openModal(this)" data-source="ar_ai-chatbot-development_mid" class="btn-primary">احجز مكالمة تحديد نطاق مجانية</button>
    </div>
  </div>
</section>

<!-- WHAT A REAL BUILD INCLUDES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="build-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="build-heading">ما يشمله البناء الحقيقي</h2>
      <p>بوت المحادثة الذي يعمل فعلياً هو عملية، لا تثبيت إضافة. إليكم ما يجب أن يحدث بين "اتفقنا على فعل هذا" و"إنه مباشر".</p>
    </div>
    <ol class="journey-list" style="gap:1rem;">
      <li><strong style="color:#00253b;">الاكتشاف وتصميم سير المحادثة.</strong> البناء الصحيح يبدأ برسم خريطة للمحادثات الفعلية التي يجريها عملاؤكم اليوم، لا قالب عام. ماذا يسألون أولاً، أين يتعثرون، كيف يبدو العميل "المؤهل" لعملكم تحديداً. يُصمَّم سير المحادثة بناءً على ذلك، لا العكس.</li>
      <li><strong style="color:#00253b;">اختيار المنصة والنموذج.</strong> أي نموذج لغوي، أي قناة (أداة موقع، واتساب، أو كليهما)، وأي منصة أساسية يعمل عليها البوت. هذا القرار يؤثر على التكلفة، جودة الاستجابة، وسهولة النقل لاحقاً، ويجب أن يُشرح لكم بلغة واضحة، لا أن يُفترَض.</li>
      <li><strong style="color:#00253b;">تكامل CRM وواتساب والتقويم.</strong> هنا يذهب معظم الجهد الهندسي الفعلي، وحيث تختصر البناءات الرخيصة كثيراً. ربط البوت بنظام CRM الفعلي لديكم فتحط العملاء المحتملون حيث يعمل فريق مبيعاتكم أصلاً، بواتساب للأعمال إذا كانت تلك القناة، وبتقويمكم فيكون الحجز حقيقياً لا محاكاة.</li>
      <li><strong style="color:#00253b;">الاختبار وضوابط الحماية.</strong> قبل أن يتحدث مع عميل حقيقي، يُختبَر البوت ضد حالات حدية: رسائل فظة، أسئلة خارج الموضوع، محاولات لجعله يقول شيئاً لا يجب أن يقوله، ومحادثات باللهجة التي يستخدمها عملاؤكم فعلياً، لا العربية الفصحى الكتابية. ضوابط الحماية تحدد بالضبط ما يفعله وما لا يفعله.</li>
      <li><strong style="color:#00253b;">التسليم والتدريب.</strong> يجب أن تخرجوا مالكين للأداة. هذا يعني الوصول للمنصة، شرحاً لكيفية تحديث قاعدة المعرفة بأنفسكم، ووثيقة واضحة تشرح ما يتعامل معه البوت، ما يصعّده، وكيف تغيّرون سلوكه دون الاتصال بالمطور في كل مرة.</li>
    </ol>
  </div>
</section>

<!-- COST -->
<section class="section" aria-labelledby="cost-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="cost-heading">كم تكلفته في الإمارات</h2>
    </div>
    <h3 style="font-weight:700; font-size:1.125rem; color:#00253b; margin-bottom:0.75rem;">النطاقات حسب نوع البوت</h3>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">التكلفة تتبع التعقيد أكثر بكثير من "ذكاء" البوت. بوت الدعم/الأسئلة الشائعة الذي يجيب من قاعدة معرفة موجودة هو الأرخص في هذه القائمة، لأنه لا يوجد عمل تكامل: يقرأ مستندات ويرد. بوت مبيعات واتساب أو بوت حجز يكلف أكثر لأنه يحتاج الكتابة على نظام CRM أو التقويم بشكل موثوق، باتجاهين، دون أن ينكسر عندما تغيّر أنظمتكم شيئاً من طرفها. الهجين المفعّل صوتياً أو البوت الممتد عبر قنوات متعددة بعدة تكاملات يقع في أعلى النطاق، لأن كل نظام إضافي يلمسه شيء آخر يجب اختباره وصيانته.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">عاملان آخران يحركان الرقم أكثر مما يتوقع معظم المشترين: كم لغة ولهجة يحتاج التعامل معها بثقة، وكم من محتواكم الحالي (كتالوجات المنتجات، السياسات، محادثات سابقة) يحتاج تنظيماً قبل أن يُدرَّب البوت عليه. الشركة ذات الوثائق الموجودة والمنظمة تدفع أقل من تلك التي يجب على المطور فيها بناء قاعدة المعرفة من الصفر بمقابلة موظفيكم.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">نحدد نطاق وسعر كل مشروع بوت محادثة بعد مكالمة اكتشاف بدلاً من نشر رقم ثابت يتجاهل ما يحتاجه عملكم فعلياً.</p>
  </div>
</section>

<!-- BUILD VS BUY -->
<section class="section" style="background:#e7eeff;" aria-labelledby="buyvbuild-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="buyvbuild-heading">البناء مقابل الشراء</h2>
      <p>ثلاثة مسارات حقيقية لبوت محادثة يعمل، وأين يتعثر كل منها عادة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">apps</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بوت منصة جاهزة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">منتج بوت محادثة جاهز من مزود SaaS: سريع التفعيل، أرخص تكلفة شهرية، ومناسب لحالة استخدام ضيقة مثل أداة أسئلة شائعة. يقصر عندما تحتاجون منطق CRM حقيقياً أو سير عمل لا يناسب قالب المنصة، لأنكم محدودون بما بناه المزود.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">construction</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بناء مخصص</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">مبني خصيصاً لعملكم، أنظمتكم، وأنماط لغة عملائكم الفعلية. تكلفة أولية أعلى من اشتراك منصة، لكن دون سقف لما يستطيع فعله، وتملكون النتيجة بدلاً من استئجار وصول لمنتج شخص آخر.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">handyman</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بلا كود</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">أنتم أو فريق داخلي تجمّعون البوت بأنفسكم باستخدام أداة بناء سير عمل بلا كود. أقل تكلفة إذا كان لديكم الوقت وشخص مستعد لتعلم الأداة، لكن عمل التكامل، اختبار ضوابط الحماية، وضبط اللهجة العربية لا يزال يستغرق ساعات حقيقية لا تختفي لمجرد غياب الكود.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMON FAILURE POINTS -->
<section class="section" aria-labelledby="fail-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="fail-heading">نقاط الفشل الشائعة</h2>
      <p>نفس ثلاث مشاكل تظهر في كل شكوى بوت محادثة تقريباً نسمعها من شركات بنت واحداً في مكان آخر.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">لا يوجد تحويل بشري احتياطي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">يستمر البوت بمحاولة الإجابة عن سؤال لا يستطيع التعامل معه بوضوح بدلاً من الاعتراف بذلك وتحويل العميل لشخص. هذه أسرع طريقة لتحويل عميل منزعج قليلاً إلى غاضب فعلياً، وهي دائماً تقريباً خيار تصميم، لا قيداً تقنياً.</p>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">لا يوجد تعامل مع اللهجة العربية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">البوت المُختبَر فقط على العربية الفصحى الرسمية غالباً يتعثر في الطريقة التي يكتب بها الناس اللهجة الخليجية فعلياً يومياً، بما في ذلك الرسائل المختلطة عربي-إنجليزي. إذا لم يختبره المزود يوماً مقابل عبارات عملائكم الحقيقية، افترضوا أنه لم يُعالَج.</p>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">ينهار في الحالات الحدية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">العروض التوضيحية تبدو رائعة دائماً لأنها تتبع المسار السعيد. ما يهم هو كيف يتعامل البوت مع عميل يغيّر رأيه في منتصف المحادثة، يسأل سؤالين دفعة واحدة، أو يكتب شيئاً خارج الموضوع تماماً. إذا لم يُختبَر ضد ذلك، سينهار مباشرة.</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATING A PARTNER -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="eval-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="eval-heading">كيف تُقيّمون شريك تطوير</h2>
      <p>أسئلة يجب طرحها قبل توقيع أي شيء.</p>
    </div>
    <ul class="journey-list" style="gap:1rem;">
      <li>هل ستُروني البوت يتعامل مع محادثة محرجة فعلياً، لا نص العرض التوضيحي فقط؟</li>
      <li>هل يكتب فعلياً على نظام CRM والتقويم الخاصين بي، أم يصف فعل ذلك فقط في نموذج تجريبي؟</li>
      <li>من يملك بيانات المحادثة وإعدادات سير العمل بعد الإطلاق، كتابياً؟</li>
      <li>هل اختبرتموه ضد عبارات اللهجة الخليجية تحديداً، لا العربية الفصحى فقط؟</li>
      <li>ماذا يحدث عندما لا يعرف البوت الإجابة، وهل يمكنني رؤية ذلك السلوك؟</li>
      <li>كم تكلفة الدعم المستمر وتحديثات قاعدة المعرفة بعد البناء الأولي، ومن المسؤول عنها؟</li>
    </ul>
  </div>
</section>

