---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { isReleased } from '../../../lib/arRollout';
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const faqItems = [
  { question: "كم يستغرق إطلاق روبوت محادثة بالذكاء الاصطناعي في الإمارات؟", answer: "الروبوت أحادي الغرض (تأهيل العملاء المحتملين على الموقع أو الأسئلة الشائعة) ينطلق عادةً خلال أسبوعين إلى أربعة أسابيع من البدء. وروبوت مبيعات واتساب المتكامل مع نظام إدارة العملاء والتقويم يستغرق عادةً أربعة إلى ستة أسابيع. أما البناء متعدد القنوات أو المدعوم بالصوت مع عدة تكاملات فقد يستغرق ثمانية أسابيع أو أكثر. العامل الأكثر تأثيراً ليس الذكاء الاصطناعي نفسه، بل سرعة فريقكم في توفير محتوى قاعدة المعارف وإرشادات صوت العلامة وصلاحيات الأنظمة التي يعتمد عليها البناء." },
  { question: "هل يستطيع روبوت المحادثة التعامل فعلاً مع العربية، بما فيها اللهجة الخليجية؟", answer: "نماذج اللغة الحديثة تتعامل جيداً مع العربية الفصحى، وتتحسن باستمرار في أنماط اللهجة الخليجية الشائعة في الطلبات اليومية. الجودة ليست مطابقة للإنجليزية بعد، لذلك نختبر الروبوت أثناء البناء على صياغات العملاء الحقيقية باللهجة المستهدفة، لا على العربية الرسمية فقط، ونضع نطاقاً واضحاً لما يجيب عنه بثقة ومتى يحوّل إلى شخص." },
  { question: "هل يستطيع روبوت المحادثة حجز المواعيد فعلاً، أم أنه يتحدث فقط؟", answer: "يعتمد ذلك كلياً على طريقة البناء، وهذه أكبر فجوة بين روبوت محادثة حقيقي وروبوت بنص ثابت. الروبوت المبني جيداً يتحقق من التوافر الحي في التقويم، ويحجز الموعد، ويرسل تأكيداً، ويستطيع إعادة الجدولة أو الإلغاء عند الطلب. وإذا كان العرض التوضيحي لدى المورد يُظهر المحادثة فقط ولا يلمس تقويمكم أو نظام إدارة العملاء، فاسألوا مباشرة إن كان الحجز مشمولاً أم إضافة." },
  { question: "من يملك روبوت المحادثة وبياناته بعد الإطلاق؟", answer: "يجب أن تملكوه أنتم. قبل التوقيع مع أي مطوّر، تأكدوا كتابياً أنكم تملكون سجلات المحادثات، وإعدادات المسارات الأساسية، ومحتوى قاعدة المعارف، وأنكم تستطيعون تصديرها أو نقلها إذا غيرتم المزود لاحقاً. نحن نبني على بنية تحتية يتحكم بها العميل، لا على منصة مغلقة تربط الحساب بنا." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "تطوير روبوتات المحادثة بالذكاء الاصطناعي في الإمارات",
    "url": "https://lenooai.com/ar/services/ai-chatbot-development",
    "description": "تطوير روبوتات المحادثة بالذكاء الاصطناعي للشركات في الإمارات: روبوتات تأهيل العملاء المحتملين على الموقع، وروبوتات مبيعات واتساب، وروبوتات الدعم، وروبوتات الحجز، ثنائية اللغة ومتكاملة مع نظام إدارة العملاء لديكم.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير روبوتات المحادثة بالذكاء الاصطناعي"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "تطوير روبوتات المحادثة", "item": "https://lenooai.com/ar/services/ai-chatbot-development" }
    ]
  }
];
---

<ArBaseLayout
  title="تطوير روبوتات المحادثة بالذكاء الاصطناعي في الإمارات: دليل المشتري"
  description="تطوير روبوتات المحادثة بالذكاء الاصطناعي في الإمارات: كم يكلف البناء الحقيقي، والأنواع الستة التي تشتريها الشركات فعلاً، وكيف تقيّمون شريك التطوير قبل التوقيع."
  canonicalPath="/ar/services/ai-chatbot-development"
  enPath="/services/ai-chatbot-development"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1600&q=80&auto=format&fit=crop", alt: "فريق يراجع واجهة محادثة على حاسوب محمول في مكتب في دبي", position: "center 45%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير روبوتات المحادثة</div>
  <h1>تطوير روبوتات المحادثة بالذكاء الاصطناعي في الإمارات<span class="h1-sep">: </span><br><span class="gradient-text">دليل المشتري الكامل</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:680px; margin:1.5rem auto 2rem; line-height:1.8;">كل ما يحتاج صاحب العمل في الإمارات إلى معرفته قبل طلب روبوت محادثة: الأنواع الستة التي تستحق الشراء فعلاً، وما يتضمنه البناء الحقيقي، والتكاليف الواقعية، والأسئلة التي تميّز شريك تطوير جاداً عن بائع قوالب.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_ai-chatbot-development_hero" class="btn-primary">احجزوا مكالمة مجانية لتحديد نطاق روبوت المحادثة</button>
    <a href="#chatbot-types" class="btn-outline">شاهدوا الأنواع الستة ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى للتحويل عند التواصل مع العميل المحتمل خلال ٥ دقائق، لا ٣٠ (MIT)" },
      { value: "٦", caption: "أنواع مختلفة من روبوتات المحادثة تشتريها الشركات في الإمارات فعلاً، لا روبوت عام واحد" },
      { value: "24/7", caption: "تغطية يضيفها روبوت المحادثة خارج ساعات عمل فريقكم" },
    ]} />
  </div>
</PageHero>

<!-- WHAT AI CHATBOT MEANS IN 2026 -->
<section class="section" aria-labelledby="means-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="means-heading" style="margin-bottom:1.5rem;">ما الذي يعنيه «روبوت المحادثة بالذكاء الاصطناعي» فعلاً في ٢٠٢٦</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>ليس الروبوت ذا النص الثابت الذي تتخيلونه.</strong> إذا كانت صورة روبوت المحادثة في أذهانكم شجرة قرارات من الأزرار، «اكتب ١ للمبيعات، ٢ للدعم»، فذلك روبوت بنص ثابت، وهو منتج مختلف تماماً. الروبوت ذو النص الثابت لا يتبع إلا الفروع التي كتبها أحدهم مسبقاً. أما روبوت المحادثة بالذكاء الاصطناعي، المبني على نموذج لغوي، فيقرأ ما كتبه العميل فعلاً، ويفهم القصد حتى لو صيغ بطريقة غريبة أو بخليط من العربية والإنجليزية، ويرد بجملة عادية لا بقائمة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>وهو أيضاً ليس نفس «وكيل الذكاء الاصطناعي».</strong> المصطلحان يُستخدمان بتساهل في عروض البيع، لذلك يستحق الأمر الدقة: روبوت المحادثة يدير محادثة ويجيب عنها أو يوجهها. أما الوكيل فيذهب أبعد، إذ ينفذ إجراءات عبر الأنظمة بمبادرة منه: يراجع ثلاث أدوات مختلفة قبل الإجابة، ويقرر أي مسار عمل يطلقه، ويتابع دون أن يُطلب منه مجدداً. معظم الشركات التي تبحث عن «روبوت محادثة بالذكاء الاصطناعي» تريد فعلاً روبوت محادثة مع بعض قدرات الوكيل: احجز هذا الموعد، ابحث عن ذلك الطلب، وهذا نطاق معقول وقابل للبناء.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">معرفة هذا الفرق مهمة عند تقييم الموردين، لأن وصف «روبوت محادثة بالذكاء الاصطناعي» يُلصق بمنتجات تتراوح بين نافذة أسئلة شائعة ثابتة ملفوفة بنموذج لغوي، ونظام متكامل بالكامل يقرأ تقويمكم ويكتب في نظام إدارة العملاء ويسلّم العملاء المهتمين إلى مندوب مبيعات في منتصف المحادثة. فرق السعر بين الاثنين كبير، والمورد الذي لا يسأل عما تحتاجونه فعلاً يبيعكم الأرخص افتراضياً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=800&q=80&auto=format&fit=crop" alt="عميل يكتب رسالة في نافذة محادثة شركة على هاتف ذكي" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- 6 CHATBOT TYPES -->
<section id="chatbot-types" class="section" style="background:#e7eeff;" aria-labelledby="types-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="types-heading">أنواع روبوتات المحادثة الستة التي تشتريها الشركات في الإمارات فعلاً</h2>
      <p>كل مشروع روبوت محادثة تقريباً في هذا السوق يقع في إحدى هذه الفئات الست. معرفة ما تحتاجونه منها قبل التحدث مع مورد تبقي المحادثة مركزة وعرض السعر صادقاً.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">language</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تأهيل العملاء على الموقع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعمل على موقعكم، ويفتح محادثة مع الزوار، ويطرح نفس أسئلة التأهيل التي يطرحها مندوب المبيعات: الميزانية، والإطار الزمني، والحاجة. ويوجه المؤهلين إلى فريقكم بدلاً من تركهم يملؤون نموذجاً لن يراجعه أحد حتى الغد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المحتملون الذين يُتواصل معهم خلال ٥ دقائق أعلى احتمالاً للتحويل بـ ٩ مرات (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت مبيعات واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعمل داخل واتساب، حيث يوجد معظم عملائكم أصلاً. يجيب عن أسئلة المنتجات، ويرسل الكتالوجات، ويجمع تفاصيل الطلبات، ويدفع المحادثات المؤهلة إلى مندوب مبيعات دون أن يضطر العميل لمغادرة التطبيق.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">القناة الأقل احتكاكاً ليرد عليها العميل في الإمارات فعلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الدعم والأسئلة الشائعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن الأسئلة التي يُسأل عنها فريق الدعم خمسين مرة أسبوعياً، خلال ثوانٍ بدلاً من طابور تذاكر. مدرَّب على وثائق المساعدة وسياساتكم الفعلية، ويسلّم أي أمر غير معتاد فعلاً إلى شخص مباشرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل حجم التذاكر المتكررة فيتولى موظفو الدعم الحالات التي تحتاج تقديراً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">psychology</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت المعرفة الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ليس موجهاً للعملاء إطلاقاً. يعمل داخل Slack أو Teams أو تبويب في المتصفح، ويجيب عن أسئلة الموظفين حول السياسات أو الإجراءات أو المنتجات بالبحث في مستنداتكم الداخلية، فيتوقف الناس عن مراسلة الزميل الوحيد الذي «يعرف كل شيء».</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل الوقت الذي يقضيه الموظفون في البحث عن إجابات موجودة أصلاً في مكان ما</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الحجز والجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحقق من التوافر الفعلي في التقويم، ويحجز الموعد الذي يريده العميل، ويرسل التأكيدات والتذكيرات، ويعيد الجدولة عند الطلب. الفرق بينه وبين الروبوت العام أنه يكتب في تقويمكم فعلاً، لا يتحدث عن فعل ذلك فقط.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل التغيب عبر التذكيرات التلقائية وسهولة إعادة الجدولة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">record_voice_over</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت هجين مدعوم بالصوت</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نفس المنطق الأساسي لروبوت المحادثة، ممتداً إلى المكالمات الهاتفية. المتصل وزائر الموقع يصلان إلى نفس قاعدة المعارف ونظام الحجز، فلا تتغير الإجابة حسب القناة التي يستخدمها الشخص.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">قاعدة معارف واحدة، وإجابات متسقة عبر المحادثة والصوت</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل بناء ثنائي اللغة (العربية والإنجليزية)، ومحدد النطاق وفق حالة الاستخدام الفعلية لديكم، ومتكامل مع الأنظمة التي تعملون عليها.</p>
      <button onclick="openModal(this)" data-source="ar_ai-chatbot-development_mid" class="btn-primary">احجزوا مكالمة مجانية لتحديد نطاق روبوت المحادثة</button>
    </div>
  </div>
</section>

<!-- WHAT A REAL BUILD INCLUDES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="build-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="build-heading">ما يتضمنه البناء الحقيقي</h2>
      <p>روبوت المحادثة الذي يعمل فعلاً عملية، لا تثبيت إضافة. إليكم ما يجب أن يحدث بين «اتفقنا على التنفيذ» و«أصبح يعمل».</p>
    </div>
    <ol style="color:#42474e; font-size:1.0625rem; line-height:1.85; padding-inline-start:1.25rem; margin:0;">
      <li style="margin-bottom:1rem;"><strong>الاستكشاف وتصميم المسارات.</strong> البناء السليم يبدأ برسم المحادثات الفعلية التي يجريها عملاؤكم اليوم، لا بقالب عام. ماذا يسألون أولاً، وأين يتعثرون، وكيف يبدو العميل المحتمل «المؤهل» لعملكم تحديداً. ويُصمم المسار حول ذلك، لا العكس.</li>
      <li style="margin-bottom:1rem;"><strong>اختيار المنصة والنموذج.</strong> أي نموذج لغوي، وأي قناة (نافذة على الموقع، أو واتساب، أو كلاهما)، وأي منصة أساسية يعمل عليها الروبوت. هذا القرار يؤثر في التكلفة وجودة الردود وسهولة النقل لاحقاً، ويجب أن يُشرح لكم بلغة واضحة، لا أن يُفترض.</li>
      <li style="margin-bottom:1rem;"><strong>التكامل مع نظام إدارة العملاء وواتساب والتقويم.</strong> هنا يذهب معظم الجهد الهندسي الحقيقي، وهنا تختصر كثير من الأبنية الرخيصة. ربط الروبوت بنظام إدارة العملاء الفعلي لديكم ليصل العملاء المحتملون حيث يعمل فريق المبيعات أصلاً، وبواجهة WhatsApp Business إن كانت هي القناة، وبتقويمكم ليكون الحجز حقيقياً لا محاكاة.</li>
      <li style="margin-bottom:1rem;"><strong>الاختبار وضوابط الحماية.</strong> قبل أن يتحدث مع أي عميل حقيقي، يُختبر الروبوت على الحالات الحدّية: الرسائل الفظة، والأسئلة الخارجة عن الموضوع، ومحاولات جعله يقول ما لا ينبغي، والمحادثات باللهجة التي يستخدمها عملاؤكم فعلاً، لا عربية الكتب. وتحدد الضوابط بالضبط ما سيفعله وما لن يفعله.</li>
      <li><strong>التسليم والتدريب.</strong> يجب أن تخرجوا وأنتم تملكون النظام. هذا يعني الوصول إلى المنصة، وشرحاً لكيفية تحديث قاعدة المعارف بأنفسكم، ومستنداً واضحاً يوضح ما يتولاه الروبوت، وما يصعّده، وكيف تغيرون سلوكه دون الاتصال بالمطوّر في كل مرة.</li>
    </ol>
  </div>
</section>

<!-- COST -->
<section class="section" aria-labelledby="cost-heading">
  <div class="container" style="max-width:840px;">
    <div class="section-header">
      <h2 id="cost-heading">كم يكلف في الإمارات</h2>
    </div>
    <h3 style="font-weight:700; font-size:1.125rem; color:#00253b; margin-bottom:0.75rem;">النطاقات حسب نوع الروبوت</h3>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">التكلفة تتبع التعقيد أكثر بكثير مما تتبع «ذكاء» الروبوت. روبوت الدعم والأسئلة الشائعة الذي يجيب من قاعدة معارف موجودة هو الأرخص في هذه القائمة، لأنه لا يتطلب عمل تكامل: يقرأ المستندات ويرد. وروبوت مبيعات واتساب أو روبوت الحجز يكلف أكثر لأنه يحتاج إلى الكتابة في نظام إدارة العملاء أو التقويم بموثوقية، في الاتجاهين، دون أن يتعطل حين تغير أنظمتكم شيئاً من جهتها. أما الروبوت الهجين المدعوم بالصوت أو الروبوت الممتد عبر قنوات متعددة مع عدة تكاملات فيقع في أعلى النطاق، لأن كل نظام إضافي يلمسه شيء آخر يجب اختباره وصيانته.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">عاملان آخران يحركان الرقم أكثر مما يتوقع معظم المشترين: عدد اللغات واللهجات التي يحتاج أن يتعامل معها بثقة، وحجم المحتوى الحالي لديكم (كتالوجات المنتجات، والسياسات، والمحادثات السابقة) الذي يحتاج إلى تنظيم قبل تدريب الروبوت عليه. الشركة التي لديها وثائق مرتبة أصلاً تدفع أقل من شركة يضطر فيها المطوّر لبناء قاعدة المعارف من الصفر بمقابلة موظفيها.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">للاطلاع على تفصيل كامل لما يحدد تسعير مشاريع الذكاء الاصطناعي في الإمارات، بما فيها بناء روبوتات المحادثة تحديداً، راجعوا {isReleased('/ar/pricing/ai-automation-cost') ? <a href="/ar/pricing/ai-automation-cost" style="color:#006875; font-weight:600;">دليل تكلفة الأتمتة بالذكاء الاصطناعي</a> : 'دليل تكلفة الأتمتة بالذكاء الاصطناعي'}. نحدد نطاق كل مشروع روبوت محادثة ونسعّره بعد مكالمة استكشافية بدلاً من نشر رقم ثابت يتجاهل ما يحتاجه عملكم فعلاً.</p>
  </div>
</section>

<!-- BUILD VS BUY -->
<section class="section" style="background:#e7eeff;" aria-labelledby="buyvbuild-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="buyvbuild-heading">البناء أم الشراء</h2>
      <p>ثلاثة مسارات حقيقية للوصول إلى روبوت محادثة يعمل، وأين يميل كل منها إلى التعثر.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">apps</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">روبوت منصة جاهزة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">منتج روبوت محادثة جاهز من مورد برمجيات كخدمة: سريع التشغيل، وأرخص تكلفة شهرية، ومناسب لحالة استخدام ضيقة مثل نافذة الأسئلة الشائعة. يقصر حين تحتاجون منطقاً حقيقياً لنظام إدارة العملاء أو مساراً لا يناسب قالب المنصة، لأنكم مقيدون بما بناه المورد.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">construction</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بناء مخصص</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">مبني خصيصاً لعملكم وأنظمتكم وأنماط لغة عملائكم الفعلية. تكلفته المبدئية أعلى من اشتراك منصة، لكن لا سقف لما يستطيع فعله، وأنتم تملكون النتيجة بدلاً من استئجار الوصول إلى منتج غيركم.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">handyman</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">بدون برمجة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">أنتم أو فريق داخلي تجمعون الروبوت بأنفسكم باستخدام أداة بناء مسارات بدون برمجة. أقل تكلفة إن كان لديكم الوقت وشخص مستعد لتعلم الأداة، لكن عمل التكامل واختبار الضوابط وضبط اللهجة العربية لا تزال تحتاج ساعات حقيقية لا تختفي لمجرد غياب البرمجة.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMON FAILURE POINTS -->
<section class="section" aria-labelledby="fail-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="fail-heading">نقاط الفشل الشائعة</h2>
      <p>نفس المشكلات الثلاث تظهر في كل شكوى تقريباً نسمعها من شركات بنت روبوت محادثة في مكان آخر.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">لا تحويل إلى شخص</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">يواصل الروبوت محاولة الإجابة عن سؤال لا يستطيع التعامل معه بوضوح بدلاً من الاعتراف بذلك وتحويل العميل إلى شخص. هذه أسرع طريقة لتحويل عميل منزعج قليلاً إلى عميل غاضب فعلاً، وهي دائماً تقريباً خيار تصميمي لا قيد تقني.</p>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">لا تعامل مع اللهجات العربية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">الروبوت المختبر على العربية الفصحى الرسمية فقط يتعثر كثيراً أمام الطريقة التي يكتب بها الناس اللهجة الخليجية يومياً، بما فيها الرسائل المختلطة بين العربية والإنجليزية. وإذا لم يختبره المورد أبداً على صياغات عملائكم الحقيقية، فافترضوا أن الأمر لم يُعالج.</p>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">يتعطل في الحالات الحدّية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7;">العروض التوضيحية تبدو رائعة دائماً لأنها تتبع المسار المثالي. المهم هو كيف يتعامل الروبوت مع عميل يغير رأيه في منتصف المحادثة، أو يسأل سؤالين معاً، أو يكتب شيئاً خارج الموضوع تماماً. وإذا لم يُختبر على ذلك، فسيتعطل فيه أثناء التشغيل الفعلي.</p>
      </div>
    </div>
  </div>
</section>

