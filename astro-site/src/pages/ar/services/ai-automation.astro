---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import StatStrip from '../../../components/StatStrip.astro';

const faqItems = [
  { question: "ما أنواع العمليات التي يمكنكم أتمتتها بالذكاء الاصطناعي؟", answer: "نُؤتمت أي سير عمل يتضمن معالجة بيانات متكررة، موافقات، مراسلات، أو توجيهاً، مثل معالجة البريد الإلكتروني، استخراج بيانات الفواتير، متابعة العملاء المحتملين، إعداد التقارير، إدخال البيانات بين الأنظمة، وسلاسل الموافقات متعددة الخطوات. إذا كان فريقك يقوم بها يدوياً وتتبع نمطاً ثابتاً، يمكننا أتمتتها." },
  { question: "هل نحتاج لاستبدال برامجنا الحالية؟", answer: "لا. نبني الأتمتة فوق ما تستخدمه بالفعل. نظام CRM، وERP، والبريد الإلكتروني، وتطبيقات العمل الحالية لديك تبقى كما هي؛ نُضيف طبقة أتمتة ذكية فوقها عبر واجهة برمجية. الهدف هو جعل أدواتك الحالية أذكى، لا استبدالها." },
  { question: "كم يستغرق مشروع الأتمتة؟", answer: "كل مشروع يُحدد نطاقه بشكل فردي. نُعطيك جدولاً زمنياً دقيقاً بعد جلسة التشخيص، بناءً على عدد سير العمل، التكاملات، وتعقيد البيانات المعنية." },
  { question: "ماذا لو تعطلت الأتمتة أو احتاجت لتحديث؟", answer: "تشمل جميع مشاريع الأتمتة دعماً لمدة 90 يوماً بعد الإطلاق. نُراقب سير العمل، نُصلح أي مشكلات، ونُجري تعديلات صغيرة مع تطور عملياتك. بعد ذلك، نُقدّم عقود صيانة مستمرة." },
  { question: "ما الفرق بين الأتمتة بالذكاء الاصطناعي وأدوات مثل Zapier أو Make؟", answer: "أدوات مثل Zapier وMake تعمل بقواعد ثابتة: تنقل البيانات من نقطة إلى أخرى عند حدوث محفّز معين. تتعطل بمجرد أن تصبح البيانات غير منظمة، أو يتغيّر التنسيق، أو تحتاج المهمة لأي حكم. الأتمتة بالذكاء الاصطناعي تُضيف طبقة تفكير: تقرأ وتفهم المحتوى غير المنظم، تتعامل مع الاستثناءات، تتخذ قرارات بناءً على السياق، وتتكيّف عندما تتغيّر المدخلات. يمكنك أتمتة مهام لا يستطيع أي Zap التعامل معها." },
  { question: "فريقنا صغير. هل تستحق الأتمتة بالذكاء الاصطناعي الاستثمار على نطاقنا؟", answer: "نعم، وغالباً أكثر. الفرق الصغيرة تشعر بألم العمل اليدوي المتكرر أكثر من غيرها لأنه لا يوجد من يُفوَّض له. أتمتة 3 إلى 5 عمليات أساسية لفريق من 10 أشخاص يمكن أن تُحرر ما يعادل موظفاً بدوام كامل. نُحدد نطاق المشاريع بما يناسب ميزانيتك ونُعطي الأولوية للأتمتة الأسرع عائداً." },
  { question: "ما المعلومات التي تحتاجونها لتحديد نطاق مشروع أتمتة؟", answer: "وصف لسير العمل الحالي (كيف يتم اليوم، من يقوم به، وبأي وتيرة)، الأدوات المستخدمة، وشكل النتيجة المطلوبة. لا تحتاج لتوثيق تقني أو واجهات برمجية مُحددة مسبقاً. نجمع كل ذلك خلال جلسة التشخيص ونُترجمه إلى نطاق تقني لموافقتك." },
];

const processSteps = [
  { icon: "search", step: "الخطوة 1", title: "تدقيق العمليات", description: "نرسم خريطة سير عملك الحالي، نُحدد أهداف الأتمتة الأعلى قيمة، ونُرتّبها حسب العائد على الاستثمار." },
  { icon: "edit", step: "الخطوة 2", title: "التصميم والتخطيط", description: "نُصمم منطق الأتمتة، نُحدد المحفّزات والمخرجات، ونحصل على موافقتك قبل البدء بالبناء." },
  { icon: "build", step: "الخطوة 3", title: "البناء والاختبار", description: "نبني الأتمتة، نُشغّلها على بيانات حقيقية في بيئة تجريبية، ونُحسّنها حتى تصبح موثوقة." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والمراقبة", description: "الأتمتة تُطلَق فعلياً. نُراقبها لمدة 90 يوماً، نُصلح أي مشكلات، ونُوسّعها لتشمل سير عمل إضافي." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "أتمتة الأعمال بالذكاء الاصطناعي", "url": "https://lenooai.com/ar/services/ai-automation", "description": "أتمتة ذكية لسير العمل والعمليات تُلغي العمل اليدوي المتكرر عبر المبيعات والعمليات والإدارة.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "offers": { "@type": "Offer", "description": "مشاريع الأتمتة بالذكاء الاصطناعي: التسعير بحسب تعقيد سير العمل والنطاق. احجز مكالمة استكشافية مجانية للحصول على عرض سعر." }, "serviceType": "AI Automation" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "أتمتة الأعمال بالذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-automation" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];
---

<ArBaseLayout
  title="خدمات أتمتة الأعمال بالذكاء الاصطناعي للشركات في الإمارات | Aegis AI"
  description="توقف عن العمل اليدوي. بصفتنا وكالة ذكاء اصطناعي في دبي، نبني أتمتة ذكية للشركات في الإمارات تُلغي العمل المتكرر عبر المبيعات والعمليات والإدارة."
  canonicalPath="/ar/services/ai-automation"
  enPath="/services/ai-automation"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>أتمتة الأعمال بالذكاء الاصطناعي</div>
    <h1>توقف عن العمل اليدوي. <span class="gradient-text">دع الذكاء الاصطناعي يتولى المهام المتكررة.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      كل ساعة يقضيها فريقك في إدخال البيانات، توجيه البريد الإلكتروني، أو الموافقات اليدوية هي ساعة لا يقضيها في عمل يُحرّك الشركة فعلاً. نُؤتمت سير العمل هذا حتى لا يحدث ذلك.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_automation_hero" class="btn-primary">احجز مكالمة استكشافية مجانية</button>
      <a href="#what-we-automate" class="btn-outline">اطّلع على ما نُؤتمته ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="أتمتة سير العمل بالذكاء الاصطناعي وتحسين العمليات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "40%", caption: "من مهام العمل في معظم الشركات قابلة للأتمتة بالذكاء الاصطناعي المتاح حالياً. معظم الفرق لم تبدأ بعد." },
      { value: "90 يوماً", caption: "مراقبة بعد الإطلاق مشمولة في كل مشروع" },
      { value: "100%", caption: "ضمان استرداد إذا لم تكن راضياً عما نُسلّمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI AUTOMATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هي الأتمتة بالذكاء الاصطناعي، ولماذا تتفوق على الأتمتة التقليدية؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          الأتمتة التقليدية تربط الأنظمة وتنقل البيانات بينها بجدول زمني ثابت أو محفّز معين. تعمل جيداً عندما تكون البيانات نظيفة، والتنسيقات لا تتغيّر، ولا يحدث أي أمر غير متوقع. المشكلة أن معظم سير العمل الفعلي في الشركات يتضمن بيانات غير منظمة، وقرارات بشرية في منتصف العملية، ومدخلات تختلف من حالة لأخرى. هذه هي سير العمل التي لا تستطيع الأتمتة التقليدية التعامل معها، وحيث يُغيّر الذكاء الاصطناعي كل شيء.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          تُضيف الأتمتة بالذكاء الاصطناعي طبقة تفكير فوق طبقة الربط. بدلاً من "إذا حدث X، افعل Y"، تصبح "اقرأ هذا البريد الإلكتروني، افهم ما يطلبه العميل، حدد إن كان طلب إرجاع أو شكوى أو سؤالاً عن منتج، ووجّهه وفقاً لذلك." يمكنها قراءة المستندات غير المنظمة، تفسير النوايا، اتخاذ قرارات بناءً على السياق، والتعامل مع الاستثناءات دون تعطّل.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80&auto=format&fit=crop" alt="محلل عمليات يُراجع نتائج سير عمل آلي على الشاشة في مكتب بدبي" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      الجدوى التجارية واضحة. تُقدّر شركة McKinsey أن 60 إلى 70 بالمئة من مهام العمل في معظم الشركات قابلة للأتمتة بالتقنية المتاحة حالياً. معظم الشركات أتمتت أقل من 20 بالمئة من تلك الإمكانية. كل ساعة يقضيها موظف في إدخال البيانات، توجيه البريد الإلكتروني، إعداد التقارير، أو النسخ واللصق بين الأدوات، هي ساعة لا تُقضى في المبيعات، الخدمة، الاستراتيجية، أو النمو. الأتمتة بالذكاء الاصطناعي لا تُلغي الموظفين؛ بل تُعيد لهم الساعات التي تُهدَر في عمل لا يحتاج أحد لأدائه يدوياً أصلاً.
    </p>
  </div>
</section>

<!-- WHAT WE AUTOMATE -->
<section id="what-we-automate" class="section" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">الأتمتة بالذكاء الاصطناعي التي نبنيها عادةً</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع شائعة، وليست قائمة نهائية. جميعها تُبنى فوق أدواتك الحالية وتُدعم بعد الإطلاق. إذا كان سير عملك مختلفاً عن أي من هذه الأمثلة، نُريد أن نسمع به.</p>
    </div>
    <div class="builds-grid">
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">mail</span></div>
            <h3>أتمتة البريد الإلكتروني والمراسلات</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الذكاء الاصطناعي يقرأ ويُصنّف ويُوجّه رسائل البريد الإلكتروني. يُعدّ الردود، يُصعّد الرسائل العاجلة، ويُسجّل كل شيء تلقائياً.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>صندوق دعم كان يستغرق من الفريق ساعتين يومياً لفرزه أصبح يُفرَز ويُعدّ ردوده في الخلفية، طوال اليوم، كل يوم.</p>
          </div>
        </div>
      </div>
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
            <h3>معالجة المستندات والفواتير</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">العقود، الفواتير، والنماذج تُعالَج خلال ثوانٍ. الذكاء الاصطناعي يستخرج البيانات، يتحقق منها، ويُدخلها في أنظمتك دون إدخال يدوي.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>فريق عمليات توقف عن إدخال فواتير الموردين يدوياً. الذكاء الاصطناعي يقرأ كل فاتورة، يُطابقها مع أمر الشراء، ويُرحّلها مباشرة.</p>
          </div>
        </div>
      </div>
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">route</span></div>
            <h3>توجيه العملاء المحتملين والمتابعة</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">كل عميل محتمل وارد يُصنَّف، يُوزَّع على المندوب المناسب، ويُتابَع تلقائياً. لا مزيد من العملاء الضائعين.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>فريق مبيعات انتقل من متوسط استجابة أولى مدته يومان إلى أقل من 10 دقائق، دون أي موظف إضافي.</p>
          </div>
        </div>
      </div>
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">task_alt</span></div>
            <h3>سير عمل الموافقات والمراجعة</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">موافقات متعددة الخطوات تنتقل تلقائياً من التقديم إلى الاعتماد، مع تذكيرات ذكية، تصعيد، وسجل تدقيق مدمج.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>موافقات المصاريف التي كانت تبقى في صندوق بريد أحدهم لأسبوع أصبحت الآن تُوجَّه، تُذكّر، وتُصعَّد من تلقاء نفسها.</p>
          </div>
        </div>
      </div>
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">sync_alt</span></div>
            <h3>مزامنة البيانات بين الأنظمة</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حافظ على تزامن CRM، ERP، إدارة المشاريع، وأدوات التواصل تلقائياً. لا مزيد من النسخ واللصق بين المنصات.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>فريق كان يُحدّث 3 أنظمة منفصلة يدوياً بعد كل صفقة أصبح يُحدّث نظاماً واحداً فقط، والبقية تتزامن من تلقاء نفسها.</p>
          </div>
        </div>
      </div>
      <div class="flip-card" tabindex="0">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bar_chart</span></div>
            <h3>التقارير الآلية</h3>
            <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقارير الحالة الأسبوعية، ملخصات المسار، ولوحات الأداء تُكتَب وتُرسَل من تلقاء نفسها، دائماً محدّثة، ولا تتأخر أبداً.</p>
          </div>
          <div class="flip-card-back">
            <p class="flip-eyebrow">مثال حقيقي</p>
            <p>الإدارة تستلم ملخص مسار المبيعات في بريدها كل اثنين الساعة 8 صباحاً، مُعدّاً ومكتوباً دون أن يلمس أحد جدول بيانات.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY EXAMPLES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="examples-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="examples-heading">ما تُؤتمته الشركات الآن</h2>
