---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "ما أنواع العمليات التي يمكن أتمتتها بالذكاء الاصطناعي؟", answer: "نؤتمت أي مهمة متكررة تتضمن معالجة بيانات أو موافقات أو تواصل أو توجيه طلبات، مثل معالجة البريد الإلكتروني، استخراج بيانات الفواتير، متابعة العملاء المحتملين، إعداد التقارير، ونقل البيانات بين الأنظمة. إذا كان فريقك ينفّذ المهمة يدويًا وتتبع نمطًا ثابتًا، يمكننا أتمتتها." },
  { question: "هل نحتاج إلى استبدال برامجنا الحالية؟", answer: "لا. نبني الأتمتة فوق الأدوات التي تستخدمها بالفعل. نظام إدارة العملاء والفوترة والبريد الإلكتروني وبقية أنظمتك تبقى كما هي، ونضيف طبقة أتمتة بالذكاء الاصطناعي فوقها عبر واجهات برمجية. الهدف أن نجعل أدواتك الحالية أكثر ذكاءً، لا أن نستبدلها." },
  { question: "كم يستغرق مشروع الأتمتة؟", answer: "نحدد كل مشروع على حدة. نعطيك جدولاً زمنيًا دقيقًا بعد جلسة الاستكشاف، بناءً على عدد سير العمل والتكاملات وتعقيد البيانات." },
  { question: "ماذا لو تعطلت الأتمتة أو احتاجت تحديثًا؟", answer: "كل مشاريع الأتمتة تتضمن دعمًا لمدة 90 يومًا بعد الإطلاق. نراقب سير العمل، ونصلح أي مشاكل، ونجري تعديلات بسيطة مع تطور عملياتك. بعد هذه المدة، نقدم عقود صيانة مستمرة." },
  { question: "ما الفرق بين أتمتة الذكاء الاصطناعي وأدوات مثل Zapier أو Make؟", answer: "تعمل Zapier و Make بمنطق ثابت: تنقل البيانات من نقطة إلى أخرى عند تفعيل شرط محدد. تتعطل هذه الأدوات فور اختلاط البيانات أو تغيّر الصيغة أو الحاجة لأي حكم بشري. أما أتمتة الذكاء الاصطناعي فتضيف طبقة تفكير: تقرأ محتوى غير منظم وتفهمه، وتتعامل مع الاستثناءات، وتتخذ قرارات حسب السياق، وتتكيف عند اختلاف المدخلات. يمكنك أتمتة مهام لا تستطيع أي أداة Zap التعامل معها." },
  { question: "فريقنا صغير، هل تستحق أتمتة الذكاء الاصطناعي الاستثمار في حالتنا؟", answer: "غالبًا نعم، وأحيانًا أكثر من الفرق الكبيرة. الفرق الصغيرة تشعر بعبء العمل اليدوي المتكرر أكثر لأنه لا يوجد من يفوَّض إليه. أتمتة 3 إلى 5 عمليات أساسية لفريق من 10 أشخاص قد توفر ما يعادل موظفًا بدوام كامل. نصمم المشاريع بما يتناسب مع ميزانيتك ونعطي الأولوية للأتمتة الأسرع في تحقيق العائد." },
  { question: "ما المعلومات التي تحتاجونها لتحديد نطاق مشروع الأتمتة؟", answer: "وصف لسير العمل الحالي (كيف يتم اليوم، من ينفذه، وبأي معدل)، الأدوات المستخدمة، وشكل النتيجة المطلوبة. لست بحاجة لتوثيق تقني أو ربط واجهات برمجية مسبقًا. نجمع كل ذلك خلال جلسة الاستكشاف ونترجمه إلى نطاق تقني تعتمده قبل البدء." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ai_automation')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

const processSteps = [
  { icon: "search", step: "الخطوة 1", title: "تدقيق العمليات", description: "نرسم سير عملك الحالي، نحدد أعلى فرص الأتمتة قيمة، ونرتبها حسب العائد على الاستثمار." },
  { icon: "edit", step: "الخطوة 2", title: "التصميم والتخطيط", description: "نصمم منطق الأتمتة، نحدد المشغلات والمخرجات، ونحصل على موافقتك قبل البناء." },
  { icon: "build", step: "الخطوة 3", title: "البناء والاختبار", description: "نبني الأتمتة، ونختبرها على بيانات حقيقية في بيئة تجريبية، ونطورها حتى تصبح موثوقة." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والمراقبة", description: "تنطلق الأتمتة فعليًا. نراقبها لمدة 90 يومًا، نصلح أي مشاكل، ونوسعها لتشمل عمليات إضافية." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'أتمتة الذكاء الاصطناعي',
    url: 'https://lenooai.com/ar/services/ai-automation',
    description: 'وكالة أتمتة بالذكاء الاصطناعي في الإمارات: أتمتة ذكية لسير العمل والعمليات تلغي الأعمال اليدوية المتكررة في المبيعات والعمليات والإدارة.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'الإمارات العربية المتحدة',
    offers: { '@type': 'Offer', description: 'مشاريع أتمتة الذكاء الاصطناعي: التسعير حسب تعقيد ونطاق سير العمل. احجز مكالمة استكشافية مجانية للحصول على عرض سعر.' },
    serviceType: 'AI Automation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="وكالة أتمتة الذكاء الاصطناعي في الإمارات | Lenoo AI"
  description="Lenoo AI وكالة أتمتة بالذكاء الاصطناعي مقرها الإمارات. نصمم وننفذ سير عمل آلي يربط أدواتك، يقلل العمل اليدوي، ويتكامل مع أنظمتك الحالية."
  canonicalPath="/ar/services/ai-automation"
  enPath="/services/ai-automation"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>أتمتة الذكاء الاصطناعي</div>
    <h1>توقف عن العمل اليدوي. <span class="gradient-text">دع الذكاء الاصطناعي يتولى المهام المتكررة.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      Lenoo AI وكالة أتمتة بالذكاء الاصطناعي مقرها الإمارات. كل ساعة يقضيها فريقك في إدخال البيانات أو توجيه البريد الإلكتروني أو الموافقات اليدوية هي ساعة لا يقضيها في عمل يحرك أعمالك فعليًا. نصمم ونبني الأتمتة التي تلغي هذا العبء، متكاملة مع الأدوات التي تستخدمها بالفعل.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">مراقبة ما بعد الإطلاق مشمولة في كل مشروع</span>
      <span class="tchip">ضمان استرداد إذا لم تكن راضيًا عما نقدمه</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ai_automation_hero_ar" class="btn-primary">احجز مكالمة استكشافية مجانية</button>
      <a href="#what-we-automate" class="btn-outline">اطّلع على ما نؤتمته ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="أتمتة سير العمل بالذكاء الاصطناعي وتحسين العمليات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "40%", caption: "من المهام في معظم الشركات قابلة للأتمتة بأدوات الذكاء الاصطناعي المتاحة حاليًا. معظم الفرق لم تبدأ بعد." },
      { value: "90 يومًا", caption: "مراقبة ما بعد الإطلاق مشمولة في كل مشروع" },
      { value: "100%", caption: "ضمان استرداد إذا لم تكن راضيًا عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI AUTOMATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هي أتمتة الذكاء الاصطناعي، ولماذا تتفوق على الأتمتة التقليدية؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الأتمتة التقليدية تربط الأنظمة وتنقل البيانات بينها وفق جدول أو مشغّل ثابت. تعمل جيدًا عندما تكون البيانات نظيفة والصيغ لا تتغير ولا يحدث شيء غير متوقع. المشكلة أن معظم عمليات الأعمال الحقيقية تتضمن بيانات غير منظمة وقرارات بشرية في منتصف العملية ومدخلات تختلف من حالة لأخرى. هذه هي العمليات التي تعجز الأتمتة التقليدية عن التعامل معها، وهنا يحدث الذكاء الاصطناعي الفرق.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        تضيف أتمتة الذكاء الاصطناعي طبقة تفكير فوق طبقة الربط. بدلاً من "إذا حدث كذا، افعل كذا"، تصبح "اقرأ هذا البريد الإلكتروني، افهم ما يطلبه العميل، حدد إن كان طلب إرجاع أو شكوى أو استفسار عن منتج، ووجّهه وفقًا لذلك." بصفتنا وكالة أتمتة بالذكاء الاصطناعي في الإمارات، نبني هذه الطبقة فوق الأدوات التي تستخدمها بالفعل: تقرأ مستندات غير منظمة، وتفسر النية، وتتخذ قرارات حسب السياق، وتتعامل مع الاستثناءات دون أن تتعطل.
      </p>
    </div>

    <div class="tools-strip">
      <p class="tools-strip-label">نعمل مع الأدوات التي تستخدمها بالفعل</p>
      <div class="tools-strip-row">
        <a href="/ar/services/ai-automation/tools/zapier" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/zapier/FF4A00" alt="Zapier" width="28" height="28" loading="lazy" /></a>
        <a href="/ar/services/ai-automation/tools/make" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/make/6D00CC" alt="Make" width="28" height="28" loading="lazy" /></a>
        <a href="/ar/services/ai-automation/tools/n8n" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/n8n/EA4B71" alt="n8n" width="28" height="28" loading="lazy" /></a>
        <a href="/ar/services/ai-automation/tools/uipath" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/uipath/FA4616" alt="UiPath" width="28" height="28" loading="lazy" /></a>
        <a href="/ar/services/ai-automation/tools/power-automate" class="tools-strip-logo"><img src="https://cdn.simpleicons.org/microsoftpowerautomate/0066FF" alt="Power Automate" width="28" height="28" loading="lazy" /></a>
        <a href="/ar/services/ai-automation/tools" class="tools-strip-logo"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875;">more_horiz</span></a>
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      المنطق التجاري واضح. تقدّر ماكنزي أن 60 إلى 70 بالمئة من مهام العمل في معظم الشركات قابلة للأتمتة بالتقنيات المتاحة حاليًا. معظم الشركات لم تؤتمت أكثر من 20 بالمئة من هذه الإمكانية. كل ساعة يقضيها موظف في إدخال البيانات أو توجيه البريد الإلكتروني أو إعداد التقارير أو نسخ البيانات بين الأدوات هي ساعة لا تُصرف على المبيعات أو الخدمة أو الاستراتيجية أو النمو. أتمتة الذكاء الاصطناعي لا تستبدل الموظفين، بل تعيد لهم الساعات التي تُهدر في عمل لا يحتاجه أحد يدويًا. اطّلع على <a href="/ar/services/ai-automation/tools">القائمة الكاملة للأدوات التي ننفذها ←</a>
    </p>
  </div>
</section>

<!-- WHAT WE AUTOMATE -->
<section id="what-we-automate" class="section" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">أتمتة الذكاء الاصطناعي التي نبنيها غالبًا</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع شائعة، وليست قائمة شاملة. جميعها مبنية على أدواتك الحالية ومدعومة بعد الإطلاق. إن كانت عمليتك مختلفة عن هذه، ما زلنا نريد سماعها.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">mail</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">أتمتة البريد الإلكتروني والتواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقرأ الذكاء الاصطناعي رسائل البريد، يصنّفها، ويوجهها. يصيغ الردود، ويصعّد الرسائل العاجلة، ويسجل كل شيء تلقائيًا.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> صندوق دعم كان يستغرق فرزه ساعتين يوميًا أصبح يُفرز وتُصاغ ردوده تلقائيًا، طوال اليوم، كل يوم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">description</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">معالجة المستندات والفواتير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تُعالج العقود والفواتير والنماذج خلال ثوانٍ. يستخرج الذكاء الاصطناعي البيانات، يتحقق منها، وينقلها إلى أنظمتك دون إدخال يدوي.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق عمليات توقف عن إدخال فواتير الموردين يدويًا. يقرأ الذكاء الاصطناعي كل فاتورة، يطابقها مع أمر الشراء، وينشرها مباشرة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">route</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">توجيه العملاء المحتملين والمتابعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كل عميل محتمل وارد يُقيَّم، يُسند إلى المندوب المناسب، ويُتابَع تلقائيًا. لا مزيد من الفرص الضائعة.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق مبيعات انتقل من متوسط استجابة أولى يستغرق يومين إلى أقل من 10 دقائق، دون أي موظف إضافي.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">سير عمل الموافقات والمراجعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">موافقات متعددة المراحل تنتقل تلقائيًا من التقديم حتى الاعتماد، مع تذكيرات وتصعيدات ذكية وسجل تدقيق كامل.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> موافقات المصاريف التي كانت تبقى في صندوق وارد شخص ما لأسبوع، أصبحت تُوجَّه وتُذكِّر وتُصعَّد تلقائيًا.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">مزامنة البيانات بين الأنظمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">حافظ على تزامن نظام إدارة العملاء وتخطيط الموارد وإدارة المشاريع وأدوات التواصل تلقائيًا. لا مزيد من النسخ اليدوي بين المنصات.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق كان يحدّث 3 أنظمة منفصلة يدويًا بعد كل صفقة، أصبح يحدّث نظامًا واحدًا فقط، والباقي يتزامن تلقائيًا.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></div>
