---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "ما أنواع العمليات التي تستطيعون أتمتتها بالذكاء الاصطناعي؟", answer: "نؤتمت أي سير عمل يتضمن معالجة بيانات متكررة، أو موافقات، أو تواصل، أو توجيه، بما في ذلك معالجة البريد الإلكتروني، واستخراج بيانات الفواتير، ومتابعة العملاء المحتملين، وإعداد التقارير، وإدخال البيانات بين الأنظمة، وسلاسل الموافقة متعددة الخطوات. إذا كان فريقكم يؤديه يدوياً ويتبع نمطاً، نستطيع أتمتته." },
  { question: "هل نحتاج لاستبدال برامجنا الحالية؟", answer: "لا. نبني الأتمتة فوق ما تستخدمونه أصلاً. يبقى نظام CRM وERP والبريد الإلكتروني وتطبيقات الأعمال لديكم كما هي، ونضيف فوقها طبقة أتمتة بالذكاء الاصطناعي عبر API. الهدف جعل أدواتكم الحالية أذكى، لا استبدالها." },
  { question: "كم يستغرق مشروع الأتمتة؟", answer: "كل مشروع يُحدَّد نطاقه بشكل منفصل. نعطيكم جدولاً زمنياً دقيقاً بعد جلسة الاكتشاف، بناءً على عدد سير العمل، وعمليات الربط، وتعقيد البيانات." },
  { question: "ماذا لو تعطلت الأتمتة أو احتاجت تحديثاً؟", answer: "كل مشاريع الأتمتة تشمل دعماً لمدة ٩٠ يوماً بعد الإطلاق. نراقب سير العمل، ونصلح أي مشكلات، ونجري تعديلات بسيطة مع تطور عملياتكم. بعد ذلك، نقدم عقود صيانة مستمرة." },
  { question: "كيف تختلف الأتمتة بالذكاء الاصطناعي عن أدوات مثل Zapier أو Make؟", answer: "Zapier وMake قائمان على القواعد: ينقلان البيانات من (أ) إلى (ب) عند حدوث محفز معين. وينهاران لحظة أن تكون البيانات غير مرتبة، أو يتغير التنسيق، أو تتطلب المهمة أي تقدير. الأتمتة بالذكاء الاصطناعي تضيف طبقة استدلال: تقرأ المحتوى غير المنظم وتفهمه، وتتعامل مع الاستثناءات، وتتخذ قرارات حسب السياق، وتتكيف عندما تتغير المدخلات. تستطيعون أتمتة مهام لا يستطيع أي مسار في Zapier التعامل معها." },
  { question: "نحن فريق صغير. هل تستحق الأتمتة بالذكاء الاصطناعي العناء بحجمنا؟", answer: "نعم، وغالباً أكثر. الفرق الصغيرة تشعر بعبء العمل اليدوي المتكرر أكثر من غيرها لأنه لا يوجد من تفوّضه إليه. أتمتة ٣ إلى ٥ سير عمل أساسية لفريق من ١٠ أشخاص يمكن أن توفر ما يعادل موظفاً بدوام كامل. نحدد نطاق المشاريع لتناسب ميزانيتكم، ونعطي الأولوية للأتمتة التي تسترد تكلفتها أسرع." },
  { question: "ما المعلومات التي تحتاجونها لتحديد نطاق مشروع أتمتة؟", answer: "وصف لسير العمل الحالي (كيف يُنفَّذ اليوم، ومن ينفذه، وكم مرة)، والأدوات المستخدمة، وشكل المخرجات المطلوبة. لا تحتاجون وثائق تقنية أو خريطة لواجهات API مسبقاً. نجمع كل ذلك أثناء جلسة الاكتشاف ونحوّله إلى نطاق تقني للموافقة عليه." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "تدقيق العمليات", description: "نرسم خريطة سير عملكم الحالي، ونحدد أعلى فرص الأتمتة قيمة، ونرتبها حسب العائد." },
  { icon: "edit", step: "الخطوة ٢", title: "التصميم والتخطيط", description: "نصمم منطق الأتمتة، ونحدد المحفزات والمخرجات، ونحصل على موافقتكم قبل البناء." },
  { icon: "build", step: "الخطوة ٣", title: "البناء والاختبار", description: "نبني الأتمتة، ونشغّلها على بيانات حقيقية في بيئة تجريبية، ونحسّنها حتى تصبح موثوقة." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "التشغيل والمراقبة", description: "تبدأ الأتمتة العمل. نراقبها ٩٠ يوماً، ونصلح أي مشكلات، ونتوسع إلى سير عمل إضافي." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="خدمات الأتمتة بالذكاء الاصطناعي للشركات في الإمارات | Lenoo AI"
  description="توقفوا عن العمل اليدوي. كوكالة ذكاء اصطناعي في دبي، نبني أتمتة بالذكاء الاصطناعي للشركات في الإمارات تلغي العمل المتكرر في المبيعات والعمليات والإدارة."
  canonicalPath="/ar/services/ai-automation"
  enPath="/services/ai-automation"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الأتمتة بالذكاء الاصطناعي</div>
    <h1>توقفوا عن العمل اليدوي. <span class="gradient-text">دعوا الذكاء الاصطناعي يتولى العمل المتكرر.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 0; line-height:1.8;">
      كل ساعة يقضيها فريقكم في إدخال البيانات، أو توجيه الرسائل، أو الموافقات اليدوية، هي ساعة لا يقضيها في عمل يدفع الشركة للأمام فعلاً. نؤتمت هذا النوع من سير العمل حتى لا يضطروا لذلك.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">مراقبة بعد الإطلاق مشمولة في كل مشروع</span>
      <span class="tchip">ضمان استرداد إذا لم تكونوا راضين عما نقدمه</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_automation_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-automate" class="btn-outline">شاهدوا ما نؤتمته ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="أتمتة سير العمل وتحسين العمليات بالذكاء الاصطناعي" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "٤٠٪", caption: "من مهام العمل في معظم الشركات قابلة للأتمتة بالذكاء الاصطناعي المتاح حالياً. ومعظم الفرق لم تبدأ بعد." },
      { value: "٩٠ يوماً", caption: "من المراقبة بعد الإطلاق مشمولة في كل مشروع" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI AUTOMATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هي الأتمتة بالذكاء الاصطناعي، ولماذا تتفوق على الأتمتة التقليدية؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الأتمتة التقليدية تربط الأنظمة وتنقل البيانات بينها وفق جدول ثابت أو محفز محدد. تعمل جيداً عندما تكون البيانات نظيفة، والتنسيقات لا تتغير، ولا يحدث شيء غير متوقع. المشكلة أن معظم سير العمل الحقيقي في الشركات يتضمن بيانات غير مرتبة، وقرارات بشرية في منتصف العملية، ومدخلات تختلف من حالة لأخرى. هذه بالضبط سير العمل التي لا تستطيع الأتمتة التقليدية التعامل معها، وحيث يغيّر الذكاء الاصطناعي المعادلة بالكامل.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        الأتمتة بالذكاء الاصطناعي تضيف طبقة استدلال فوق طبقة الربط. بدلاً من "إذا حدث (أ) فافعل (ب)"، تصبح: "اقرأ هذه الرسالة، وافهم ما يطلبه العميل، وحدد إن كان طلب إرجاع أو شكوى أو سؤالاً عن منتج، ثم وجّهه بناءً على ذلك." تستطيع قراءة المستندات غير المنظمة، وفهم المقصود، واتخاذ القرارات حسب السياق، والتعامل مع الاستثناءات دون أن تتعطل.
      </p>
    </div>

    <div class="tools-strip">
      <p class="tools-strip-label">نعمل مع الأدوات التي تستخدمونها أصلاً</p>
      <div class="tools-strip-row">
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/zapier/FF4A00" alt="Zapier" width="28" height="28" loading="lazy" /></div>
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/make/6D00CC" alt="Make" width="28" height="28" loading="lazy" /></div>
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/n8n/EA4B71" alt="n8n" width="28" height="28" loading="lazy" /></div>
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/uipath/FA4616" alt="UiPath" width="28" height="28" loading="lazy" /></div>
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/ifttt/000000" alt="IFTTT" width="28" height="28" loading="lazy" /></div>
        <div class="tools-strip-logo"><img src="https://cdn.simpleicons.org/appian/2322F2" alt="Appian" width="28" height="28" loading="lazy" /></div>
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      المبرر التجاري واضح. تقدّر McKinsey أن ٦٠ إلى ٧٠ بالمئة من مهام العمل في معظم الشركات قابلة للأتمتة بالتقنيات المتاحة حالياً. ومعظم الشركات أتمتت أقل من ٢٠ بالمئة من هذه الإمكانية. كل ساعة يقضيها موظف في إدخال البيانات، أو توجيه الرسائل، أو إعداد التقارير، أو النسخ واللصق بين الأدوات، هي ساعة لا تُقضى في المبيعات أو الخدمة أو الاستراتيجية أو النمو. الأتمتة بالذكاء الاصطناعي لا تحل محل الموظفين، بل تعيد لهم الساعات التي تضيع في عمل لا يحتاج أحد لأدائه يدوياً.
    </p>
  </div>
</section>

<!-- WHAT WE AUTOMATE -->
<section id="what-we-automate" class="section" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">الأتمتة بالذكاء الاصطناعي التي نبنيها عادةً</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع شائعة، وليست قائمة كاملة. كلها مبنية على أدواتكم الحالية ومدعومة بعد الإطلاق. إذا كان سير عملكم مختلفاً عن أي منها، ما زلنا نرغب في سماعه.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">mail</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">أتمتة البريد الإلكتروني والتواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقرأ الذكاء الاصطناعي الرسائل ويصنفها ويوجهها. يصيغ الردود، ويصعّد الرسائل العاجلة، ويسجل كل شيء تلقائياً.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> صندوق بريد للدعم كان يأخذ من الفريق ساعتين يومياً لفرزه، أصبح يُفرز وتُصاغ ردوده في الخلفية، طوال اليوم، كل يوم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">description</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">معالجة المستندات والفواتير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العقود والفواتير والنماذج تُعالَج في ثوانٍ. يستخرج الذكاء الاصطناعي البيانات، ويتحقق منها، ويدفعها إلى أنظمتكم دون إدخال يدوي.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق عمليات توقف عن إدخال فواتير الموردين يدوياً. يقرأ الذكاء الاصطناعي كل فاتورة، ويطابقها مع أمر الشراء، ويرحّلها مباشرة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">route</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">توجيه العملاء المحتملين ومتابعتهم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كل عميل محتمل وارد يُقيَّم، ويُسند إلى المندوب المناسب، ويُتابَع تلقائياً. لا مزيد من العملاء المحتملين الضائعين.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق مبيعات انتقل من متوسط يومين لأول رد إلى أقل من ١٠ دقائق، دون أي موظف إضافي.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">سير عمل الموافقات والمراجعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">موافقات متعددة الخطوات تنتقل تلقائياً من التقديم إلى الاعتماد، مع تذكيرات ذكية وتصعيدات وسجلات تدقيق مدمجة.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> موافقات المصروفات التي كانت تبقى في بريد أحدهم أسبوعاً، أصبحت تُوجَّه وتُذكِّر وتُصعَّد بنفسها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">مزامنة البيانات بين الأنظمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">حافظوا على تزامن نظام CRM وERP وأدوات إدارة المشاريع والتواصل تلقائياً. لا مزيد من النسخ واللصق بين المنصات.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق كان يحدّث ٣ أنظمة منفصلة يدوياً بعد كل صفقة، أصبح يحدّث نظاماً واحداً، والباقي يتزامن تلقائياً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">التقارير التلقائية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تقارير حالة أسبوعية، وملخصات مسار المبيعات، ولوحات أداء تُكتب وتُرسل بنفسها، محدّثة دائماً ولا تتأخر أبداً.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> تصل الإدارة ملخص مسار المبيعات إلى بريدها كل يوم اثنين الساعة ٨ صباحاً، مُجمَّعاً ومكتوباً دون أن يلمس أحد جدول بيانات.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY EXAMPLES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="examples-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="examples-heading">ما تؤتمته الشركات الآن</h2>
      <p style="color:#42474e; font-size:1.0625rem;">هذه أنواع أتمتة حقيقية بنيناها في قطاعات مختلفة. التفاصيل تختلف من شركة لأخرى، لكن الفئات ثابتة.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
