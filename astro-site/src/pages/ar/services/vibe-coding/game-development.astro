<style>
.gamedev-tabs { display:flex; gap:0.5rem; justify-content:center; margin-bottom:2rem; flex-wrap:wrap; }
.gamedev-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.gamedev-tab-btn:hover { background:#e7eeff; }
.gamedev-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
.gamedev-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
[data-gamedev-tab-panel][hidden] { display:none; }
#gamedev-panel-3d, #gamedev-panel-nocode { grid-template-columns:1fr; max-width:600px; margin:0 auto; }
</style>

<script>
  const gamedevTabWrap = document.querySelector('.gamedev-tabs');
  if (gamedevTabWrap) {
    const btns = gamedevTabWrap.querySelectorAll('.gamedev-tab-btn');
    const panels = document.querySelectorAll('[data-gamedev-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-gamedev-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-gamedev-tab-panel') !== key; });
      });
    });
  }
</script>
