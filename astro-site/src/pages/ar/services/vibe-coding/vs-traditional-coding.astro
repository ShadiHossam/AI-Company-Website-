<style>
.vc-week-row { display:flex; align-items:center; gap:1rem; padding:0.875rem 0; border-bottom:1px solid rgba(0,37,59,0.08); color:#42474e; font-size:0.9375rem; }
.vc-week-row:last-child { border-bottom:none; }
.vc-week-tag { flex-shrink:0; width:110px; font-weight:700; font-size:0.8125rem; color:#72787e; }
.vc-week-tag-fast { color:#006875; }
.vscoding-toggle { display:flex; gap:0; justify-content:center; margin-bottom:1.5rem; background:#fff; border-radius:100px; padding:4px; border:1px solid rgba(0,37,59,0.1); max-width:420px; margin-left:auto; margin-right:auto; }
.vscoding-toggle-btn { flex:1; padding:0.625rem 1.25rem; border-radius:100px; border:none; background:transparent; color:#42474e; font-size:0.875rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.vscoding-toggle-btn.active { background:#006875; color:#fff; }
.vscoding-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const vscodingToggleWrap = document.querySelector('.vscoding-toggle');
  if (vscodingToggleWrap) {
    const vscodingBtns = vscodingToggleWrap.querySelectorAll('.vscoding-toggle-btn');
    const vscodingPanels = document.querySelectorAll('[data-vscoding-tier-panel]');
    vscodingBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-vscoding-tier');
        vscodingBtns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        vscodingPanels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-vscoding-tier-panel') !== key; });
      });
    });
  }
</script>
