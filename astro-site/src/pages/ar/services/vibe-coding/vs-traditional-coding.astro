---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";

const fallbackFaqs = [
  { question: "هل اخترع أندريه كارباثي البرمجة الحدسية؟", answer: "صاغ المصطلح في منشور بفبراير ٢٠٢٥، يصف أسلوب بناء برمجيات بالتحدث لذكاء اصطناعي وقبول مُخرَجه دون قراءة كل سطر بعناية. ممارسة استخدام الذكاء الاصطناعي لكتابة كود وُجِدت قبل ذلك، لكن منشور كارباثي هو من أين يعود الاسم والنقاش الحالي حوله." },
  { question: "هل البرمجة الحدسية مجرد دورة ضجيج؟", answer: "المصطلح والخطاب حوله على الأرجح سيتلاشيان بالطريقة التي تتلاشى بها معظم الاتجاهات المُسمّاة. التحول الأساسي، حصة متنامية من الكود تولّدها الذكاء الاصطناعي بتوجيه بشري، ليس موضة؛ إنه أصلاً كيف يعمل حصة كبيرة من المطورين المحترفين يومياً، سواء سمّاه أحد \"برمجة حدسية\" بعد سنة أم لا." },
  { question: "أي نهج يفوز فعلياً للبرمجيات الإنتاجية؟", answer: "لا أحد يفوز صراحة، ليسا فعلياً يتنافسان على نفس المهمة. البرمجة اليدوية بالكامل دون أي مساعدة ذكاء اصطناعي هي الآن الخيار الأبطأ والأغلى لمعظم مهام البرمجيات القياسية. البرمجة الحدسية غير المراجَعة كلياً خطر حقيقي لأي شيء جاد. النهج الذي يفوز فعلياً تطوير مُسرَّع بالذكاء الاصطناعي مع مراجعة واختبار بشريين فوقه، أسرع من البرمجة التقليدية وأكثر أماناً من مُخرَج ذكاء اصطناعي غير مراجَع." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_vibe_coding_vs_traditional')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="البرمجة الحدسية مقابل البرمجة التقليدية: هل انتهت أم حقيقية؟ | Lenoo AI"
  description="من أين جاء مصطلح البرمجة الحدسية، النقاش الحقيقي حوله، ومقارنة صادقة جنباً إلى جنب مع البرمجة التقليدية."
  canonicalPath="/ar/services/vibe-coding/vs-traditional-coding"
  enPath="/services/vibe-coding/vs-traditional-coding"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/vibe-coding" style="color:inherit;text-decoration:none;opacity:0.65;">البرمجة الحدسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>البرمجة الحدسية مقابل التقليدية</div>
    <h1>البرمجة الحدسية مقابل <span class="gradient-text">البرمجة التقليدية.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      من أين جاء المصطلح، عمّاذا النقاش فعلياً، ونظرة صادقة على أين يفوز كل نهج.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_vibe_vstraditional_hero" class="btn-primary">ناقشوا مشروعكم</button>
      <a href="#comparison" class="btn-outline">شاهدوا المقارنة ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1765561667528-28e39c6174dd?w=1400&h=260&q=80&auto=format&fit=crop" alt="مطوران ينظران عن كثب لشاشة مشتركة، يقارنان نهجَي برمجة جنباً إلى جنب" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- ORIGIN -->
<section class="section" aria-labelledby="origin-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="origin-heading" style="margin-bottom:1.5rem;">من أين جاء المصطلح</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          صاغ أندريه كارباثي، عضو مؤسس في OpenAI ورئيس سابق للذكاء الاصطناعي في Tesla، مصطلح "البرمجة الحدسية" في منشور بفبراير ٢٠٢٥ يصف طريقة بناء برمجيات بالتحدث لذكاء اصطناعي، قبول ما يولّده، والمضي قدماً بالإحساس بدلاً من قراءة كل سطر بعناية. علق الاسم لأنه التقط شيئاً كان كثير من المطورين يفعلونه أصلاً دون كلمة له. الممارسة، توجيه ذكاء اصطناعي لكتابة كود ومراجعة النتيجة بدلاً من كتابة كل حرف يدوياً، وُجِدت قبل المصطلح. ما فعله منشور كارباثي هو إعطاء النقاش الأوسع، حول السرعة، الجودة، وما يُتبادَل فعلياً، اسماً للجدال حوله.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          يستحق ملاحظة أن إطار كارباثي الأصلي كان أضيق من كيفية استخدام المصطلح غالباً اليوم. كان يصف نمطاً محدداً وعرضياً للبناء، مشاريع جانبية، تجارب نهاية أسبوع، حيث الصحة تهم أقل من السرعة والكود لم يكن ذاهباً لمكان مهم. مع انتشار المصطلح، طُبِّق بشكل أوسع بكثير، على برمجيات إنتاجية جادة بالإضافة لتجارب قابلة للتجاهل، وهذا جزء كبير من سبب وجود النقاش الحالي: الناس غالباً يجادلون حول أشياء مختلفة باستخدام نفس الكلمة.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1695891689981-0be360e84d3f?w=800&h=600&q=80&auto=format&fit=crop" alt="مطوران يتعاونان على مكتب فوق حاسوب محمول، يمثلان عملية تطوير البرمجيات التقليدية" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- THE DEBATE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="debate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="debate-heading">النقاش، كلا الجانبين بإنصاف</h2>
      <p style="color:#42474e; font-size:1.0625rem;">خيوط Reddit ومنتديات المطورين تنقسم تقريباً لمعسكرين. كلاهما يطرح نقطة حقيقية.</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div class="value-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:1rem;">الحجة المؤيدة</h3>
        <p style="color:#42474e; font-size:0.9rem; line-height:1.8;">تُبنى وتُشحَن البرمجيات أسرع بشكل هائل. الهيكل الأساسي، الاختبارات، وعمل التنفيذ المتكرر الذي كان يستهلك معظم الجدول الزمني لمشروع الآن يستغرق جزءاً بسيطاً من الوقت. تُختبَر الأفكار مع مستخدمين حقيقيين بدلاً من الجلوس في قائمة انتظار لأشهر. لحصة هائلة من مهام البرمجيات القياسية، كود صحيح مولَّد بالذكاء الاصطناعي ومراجَع من مهندس كفء ببساطة اقتصاد أفضل من نفس المهمة منفَّذة يدوياً بالكامل. يشير المؤيدون أيضاً أن معظم البرمجيات ليست جديدة، إنها تنويعة على أنماط موجودة أصلاً، وهذا بالضبط نوع العمل الذي يتعامل معه الذكاء الاصطناعي جيداً.</p>
      </div>
      <div class="value-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:1rem;">الحجة المعارضة</h3>
        <p style="color:#42474e; font-size:0.9rem; line-height:1.8;">كود لا يفهمه أحد كلياً كود لا يستطيع أحد صيانته بأمان، تصحيحه تحت ضغط، أو الثقة به مع بيانات حساسة. يشير النقاد لحوادث حقيقية، أخطاء أمنية، بنية غير قابلة للصيانة، منتجات "عملت في العرض التوضيحي" انهارت تحت الاستخدام الحقيقي، كلها تعود لتخطي المراجعة والاختبار التي تحتاجها أي قاعدة كود جادة. النقد ليس للذكاء الاصطناعي الذي يكتب كوداً؛ إنه للذكاء الاصطناعي الذي يكتب كوداً دون أن يتحقق منه أحد. يقلق النقاد أيضاً حول تشكّل فجوة مهارات، مطورون لا يتعلمون أبداً ماذا يفعل الذكاء الاصطناعي تحته، ويعانون عندما ينكسر شيء بطريقة لا يستطيع الذكاء الاصطناعي إصلاحها بنفسه.</p>
      </div>
    </div>
  </div>
</section>

<!-- COMMON OBJECTIONS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="objections-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="objections-heading" style="text-align:right; margin-bottom:1.5rem;">الاعتراضات الأكثر شيوعاً، مُجابة بصدق</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      <strong>"إنه مجرد إكمال تلقائي بخطوات إضافية."</strong> كان هذا أقرب للصحة قبل بضع سنوات. الأدوات الحالية تستطيع تخطيط تغييرات متعددة الملفات، تشغيل اختبارات، وتصحيح أخطائها الخاصة عبر جلسة، أقرب لتوجيه مطور مبتدئ من قبول اقتراح واحد. المقارنة بالإكمال التلقائي تقلل من شأن ما تغيّر في السنتين الأخيرتين تحديداً.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      <strong>"لا تستطيعون الثقة بكود لم تكتبوه بأنفسكم."</strong> معظم البرمجيات المحترفة أصلاً تعمل على كود لم يكتبه المشرف الحالي شخصياً، مكتبات مفتوحة المصدر، كود من موظفين سابقين، هيكل مولَّد. الثقة دائماً جاءت من الاختبار والمراجعة، لا من التأليف الشخصي. ذلك المعيار لا يتغير للكود المولَّد بالذكاء الاصطناعي؛ فقط يحتاج تطبيقه فعلياً.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      <strong>"هذا سيُخرِج المطورين من العمل."</strong> أوضح دليل حتى الآن يشير للعكس: الطلب على مطورين يستطيعون توجيه أدوات الذكاء الاصطناعي جيداً، مراجعة مُخرَجها نقدياً، والتعامل مع قرارات الحكم التي لا يستطيعها الذكاء الاصطناعي يرتفع، لا ينخفض. ما يتغيّر هو شكل الوظيفة، وقت أقل في كتابة الصياغة، وقت أكثر في البنية والمراجعة، لا هل الوظيفة موجودة.
    </p>
  </div>
</section>

<!-- COMPARISON -->
<section id="comparison" class="section" aria-labelledby="comparison-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="comparison-heading">جنباً إلى جنب</h2>
      <p style="color:#42474e; font-size:1.0625rem;">ليستا فلسفتين متنافستين، نقطتان على نفس الطيف. معظم المشاريع الحقيقية اليوم تجلس في مكان ما بينهما.</p>
    </div>
    <div style="max-width:820px; margin:0 auto;">
      <div class="vscoding-toggle" role="tablist" aria-label="نهج البرمجة">
        <button type="button" id="vscoding-tab-traditional" class="vscoding-toggle-btn active" data-vscoding-tier="traditional" role="tab" aria-selected="true" aria-controls="vscoding-panel-traditional">البرمجة التقليدية</button>
        <button type="button" id="vscoding-tab-vibe" class="vscoding-toggle-btn" data-vscoding-tier="vibe" role="tab" aria-selected="false" aria-controls="vscoding-panel-vibe">البرمجة الحدسية</button>
      </div>
      <div class="card" id="vscoding-panel-traditional" data-vscoding-tier-panel="traditional" role="tabpanel" aria-labelledby="vscoding-tab-traditional">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:1rem;">البرمجة التقليدية (دون ذكاء اصطناعي)</h3>
        <div class="vc-week-row"><span class="vc-week-tag">السرعة</span><span>الأبطأ بين النهج الثلاثة للمهام القياسية</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">التكلفة</span><span>الأعلى، لأن كل سطر يُكتَب يدوياً</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">الجودة</span><span>تعتمد كلياً على مهارة ووقت المطور الفردي</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">قابلية الصيانة</span><span>قوية عموماً، لأن الكاتب يفهم كل جزء كتبه</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">الأنسب لـ</span><span>مشاكل متخصصة جداً وجديدة دون نمط موجود للاستناد إليه</span></div>
      </div>
      <div class="card" id="vscoding-panel-vibe" data-vscoding-tier-panel="vibe" role="tabpanel" aria-labelledby="vscoding-tab-vibe" hidden>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:1rem;">البرمجة الحدسية غير المراجَعة</h3>
        <div class="vc-week-row"><span class="vc-week-tag vc-week-tag-fast">السرعة</span><span>الأسرع لعرض توضيحي عامل</span></div>
        <div class="vc-week-row"><span class="vc-week-tag vc-week-tag-fast">التكلفة</span><span>أدنى تكلفة مقدمة</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">الجودة</span><span>غير متوقعة؛ خطر حقيقي على أي شيء يتعامل مع بيانات أو تحكم وصول</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">قابلية الصيانة</span><span>غالباً ضعيفة بمجرد ألا يتابع الباني عن كثب ما وُلِّد</span></div>
        <div class="vc-week-row"><span class="vc-week-tag">الأنسب لـ</span><span>مشاريع شخصية، نماذج أولية، تجارب منخفضة المخاطر</span></div>
      </div>
    </div>
    <p style="color:#42474e; font-size:0.9375rem; line-height:1.8; margin-top:1.5rem;">
      لا يصف أي من الخيارين كيف تُبنى معظم البرمجيات المحترفة فعلياً اليوم. البرمجة التقليدية أبطأ من اللازم لحصة كبيرة من المهام التي تتبع أنماطاً مألوفة. البرمجة الحدسية غير المراجَعة خطرة جداً لأي شيء وراءه مستخدمون حقيقيون أو بيانات حقيقية. النهج الذي يكسب أرضاً فعلياً في الصناعة يجلس بينهما.
    </p>
    <div style="text-align:center; margin-top:2rem; padding:1.75rem; background:#f0f3ff; border-radius:16px;">
      <p style="color:#42474e; font-size:0.95rem; line-height:1.8; margin:0;"><strong>ما يفوز فعلياً للبرمجيات الإنتاجية:</strong> تطوير مُسرَّع بالذكاء الاصطناعي مع مراجعة مهندس أول واختبار آلي فوقه. يحتفظ بميزة سرعة البرمجة الحدسية مع إزالة الجودة غير المتوقعة التي يشير إليها النقاد بحق، وهو الفرضية الكاملة لكيفية بنائنا. شاهدوا تفصيل <a href="/ar/services/vibe-coding/risks-and-limitations" style="color:#006875;">المخاطر والحدود</a> لدينا لبالضبط ماذا تلتقط تلك المراجعة.</p>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.5rem;">
      فكروا فيه أقل كخيار ثالث وأكثر كأخذ صفَّي "التكلفة" و"السرعة" من البرمجة الحدسية غير المراجَعة وصفَّي "الجودة" و"قابلية الصيانة" من البرمجة التقليدية، دون وراثة عيب أي منهما. هذا وصف مقصود، لا ادعاء تسويقي؛ إنه بالضبط ما تفعله إضافة خطوة مراجعة واختبار ثابتة لسير عمل مُسرَّع بالذكاء الاصطناعي بنيوياً، بغض النظر عمن يفعله.
    </p>
  </div>
</section>

<!-- REDDIT DEBATE -->
<section class="section" aria-labelledby="reddit-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="reddit-heading" style="text-align:right; margin-bottom:1.5rem;">عمّاذا تجادل خيوط Reddit فعلياً</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      مجتمعات المطورين على Reddit تنقسم تقريباً حسب خطوط الخبرة. خيوط من مطورين أحدث وبانين غير تقنيين تميل للتركيز على ما هو ممكن الآن، شحن شيء حقيقي دون سنوات من التدريب المسبق، وتعامل مكسب السرعة كالعنوان الرئيسي. خيوط من مهندسين خبراء تميل للتركيز على ما يحدث بعد الإطلاق، من يصون هذا بعد سنة، ماذا يحدث أول مرة يحتاج ميزة لم يتوقعها الأمر الأصلي أبداً، وتعامل سؤال قابلية الصيانة كالسؤال الذي يهم فعلياً.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      كلا المجموعتين عادة تتحدثان عن مشاريع مختلفة فعلياً دون إدراك ذلك. باني أحدث يشحن مشروع نهاية أسبوع شخصياً ومهندس خبير يصون نظام إنتاج عمره خمس سنوات ليس بينهما تقريباً أي قاسم مشترك سوى كلمة "برمجة حدسية"، وهذا سبب قراءة نفس الخيط غالباً كجدالين منفصلين يحدثان دفعة واحدة بدلاً من خلاف واحد.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      الخيوط الأكثر إنتاجية تميل للتقارب حول نسخة من نفس الاستنتاج الذي تجادل له هذه الصفحة مباشرة: البرمجة الحدسية طريقة بناء شرعية، بشرط أن تتوسع خطوة المراجعة والاختبار مع مقدار ما على المحك. الخيوط الأقل إنتاجية هي تلك التي تتجادل جنباً إلى جنب دون أن يسمّي أحد أي نوع مشروع، وأي نوع مخاطر، يتحدثون عنه فعلياً.
    </p>
  </div>
</section>

<!-- IS IT DYING -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="dying-heading">
  <div class="container" style="max-width:820px;">
    <h2 id="dying-heading" style="text-align:right; margin-bottom:1.5rem;">هل البرمجة الحدسية تحتضر أم مبالغ في الترويج لها؟</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      العبارة المحددة على الأرجح ستتلاشى، معظم الاتجاهات المُسمّاة تفعل، وهناك أصلاً رد فعل مرئي ضد المصطلح نفسه في مجتمعات المطورين. لكن التحول الأساسي الذي يصفه، حصة متنامية من الكود يولّدها الذكاء الاصطناعي بتوجيه بشري، ليس موضة. إنه أصلاً أسلوب العمل الافتراضي لحصة كبيرة من شركات البرمجيات، سواء لا يزال أحد يسمّيه "برمجة حدسية" بعد سنة أم لا.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
      ما يحدث فعلياً ليس ذكاءً اصطناعياً يستبدل مطورين أو مطورين يرفضون الذكاء الاصطناعي كلياً. إنه الصناعة تتقارب على موقف وسط: يولّد الذكاء الاصطناعي المسودة الأولى، يراجعها شخص، تؤكدها الاختبارات، ثم فقط تُشحَن. هذه ليست دورة ضجيج. إنها فقط كيف يبدو تطوير البرمجيات المحترف الآن.
    </p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
      توقع معقول: خلال عامين أو ثلاثة، سيشعر هذا الجدال بأكمله بأنه قديم، بنفس الطريقة التي شعر فيها الجدال حول هل يجب على المطورين استخدام إكمال محرر الكود التلقائي مرة بأنه سؤال حقيقي. ليس لأن القلق الأساسي حول الجودة يختفي، بل لأن سير عمل المراجعة والاختبار الذي يجيب عليه يصبح معيارياً جداً فلا يكلف أحد نفسه تسميته منفصلاً بعد الآن. المصطلح على الأرجح سيُتذكَّر كما تُتذكَّر "السحابة" أو "Web 2.0" الآن، تسمية مفيدة للحظتها، لا فئة دائمة.
    </p>
  </div>
</section>

