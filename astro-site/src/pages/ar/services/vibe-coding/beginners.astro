<script>
  document.querySelectorAll('[data-beginners-expand]').forEach((card) => {
    const btn = card.querySelector('.beginners-card-toggle');
    const panel = card.querySelector('.beginners-card-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) (panel as HTMLElement).hidden = expanded;
    });
  });
</script>
