---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "ما الفرق بين وكيل الذكاء الاصطناعي وروبوت المحادثة؟", answer: "روبوت المحادثة يجيب عن الأسئلة. وكيل الذكاء الاصطناعي ينفذ إجراءات. يستطيع الوكلاء تصفح الويب، وكتابة الرسائل وإرسالها، وتحديث نظام CRM، وحجز الاجتماعات، وإجراء عمليات البحث، واستدعاء واجهات API، وربط خطوات متعددة معاً دون انتظار من يخبرهم بالخطوة التالية. إنهم يحلون المشكلات باستقلالية، لا مجرد آلات إجابة." },
  { question: "ما مدى موثوقية وكلاء الذكاء الاصطناعي في اتخاذ القرارات؟", answer: "نصمم الوكلاء بضوابط حماية واضحة، ونقاط موافقة للإجراءات عالية المخاطر، وتحكم بشري حيث يلزم. يتولى الوكلاء القرارات كثيرة التكرار ومنخفضة المخاطر تلقائياً، وأي شيء يتطلب تقديراً بشرياً يُحوَّل إلى شخص للموافقة. وتزداد الموثوقية مع الوقت كلما تعلم الوكلاء من الملاحظات." },
  { question: "هل يستطيع الوكلاء العمل مع أدواتنا الحالية؟", answer: "نعم. نبني وكلاء يتصلون بأنظمتكم الحالية عبر API: نظام CRM، والبريد الإلكتروني، والتقويم، وقواعد البيانات، وأدوات تواصل الفريق، وغيرها. يعمل الوكيل كطبقة ذكية فوق أدواتكم الحالية، لا بديلاً عنها." },
  { question: "هل هناك خطر أن يفعل الوكلاء شيئاً خاطئاً؟", answer: "نبني في كل وكيل تسجيلاً شاملاً، وقدرة على التراجع، وحدوداً للإجراءات. كل إجراء ينفذه الوكيل مسجّل وقابل للمراجعة. وفي سير العمل الحرج، نضيف خطوة موافقة بشرية قبل تنفيذ الإجراءات التي لا يمكن التراجع عنها." },
  { question: "ما الفرق بين الأتمتة البسيطة ووكيل الذكاء الاصطناعي؟", answer: "الأتمتة التقليدية تتبع نصاً ثابتاً: إذا حدث (أ) فافعل (ب). وتتعطل لحظة حدوث شيء غير متوقع. أما وكيل الذكاء الاصطناعي فيفكر في الموقف، ويقرر أفضل مسار، ويتكيف عندما لا تسير الأمور كما خُطط لها. الأتمتة ممتازة للمهام المتوقعة والمتكررة. والوكلاء للمهام التي تتطلب تقديراً، أو مدخلات غير منظمة، أو خطوات متغيرة." },
  { question: "هل يستطيع وكيل واحد تولي مهام مختلفة متعددة؟", answer: "يمكن منح الوكيل قدرات وأدوات متعددة، لكننا عادةً نصمم وكلاء مركّزين يؤدون مهمة واحدة بإتقان. أما سير العمل المعقد الذي يمتد عبر عدة مجالات، فنبني له أنظمة متعددة الوكلاء: فريق من الوكلاء المتخصصين ينسّق بينهم وكيل منظِّم. هذا يعطي نتائج أكثر موثوقية من وكيل عام واحد مثقل بالمهام." },
  { question: "كم تكلف مشاريع وكلاء الذكاء الاصطناعي عادةً؟", answer: "يعتمد ذلك على تعقيد سير العمل، وعدد الأدوات التي يحتاج الوكيل لاستخدامها، وما إذا كنتم تحتاجون واجهة مستخدم مخصصة أو API فقط. الوكلاء البسيطون لسير عمل واحد يبدؤون من بضعة آلاف. والأنظمة متعددة الوكلاء للعمليات المعقدة يُحدَّد نطاقها لكل حالة. كل المشاريع تبدأ بمكالمة اكتشاف مجانية نعطيكم فيها تقديراً واضحاً قبل أن تلتزموا بأي شيء." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_agents')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "target", step: "الخطوة ١", title: "تحديد المهمة", description: "نحدد بالضبط ما يحتاج وكيلكم فعله، وأي أدوات يحتاج الوصول إليها، وأين يبقى البشر في الحلقة." },
  { icon: "extension", step: "الخطوة ٢", title: "البناء والربط", description: "نبني الوكيل، ونربطه بأدواتكم، وندربه على سياقكم، ونحدد ضوابط الحماية للتشغيل الآمن." },
  { icon: "science", step: "الخطوة ٣", title: "اختبار صارم", description: "نختبره تحت الضغط بحالات استثنائية ومدخلات عدائية وسيناريوهات حقيقية للتأكد من أن الوكيل يتصرف كما هو متوقع قبل الإطلاق." },
  { icon: "monitoring", step: "الخطوة ٤", title: "المراقبة والتحسين", description: "سجلات تدقيق كاملة، ولوحات أداء، ودعم لمدة ٩٠ يوماً تضمن استمرار تحسن وكيلكم بعد الإطلاق." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="وكلاء الذكاء الاصطناعي والأنظمة الوكيلية للشركات في الإمارات"
  description="ذكاء اصطناعي لا يكتفي بالإجابة، بل ينفذ. كوكالة ذكاء اصطناعي في دبي، نبني وكلاء مستقلين للشركات في الإمارات يستدلون ويقررون وينفذون."
  canonicalPath="/ar/services/ai-agents"
  enPath="/services/ai-agents"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكلاء الذكاء الاصطناعي</div>
    <h1>ذكاء اصطناعي يفكر ويقرر وينفذ <span class="gradient-text">دون انتظار التعليمات.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      معظم الذكاء الاصطناعي يكتفي بالرد. أما الوكلاء فيبادرون. يفكرون في المشكلات المعقدة، ويستخدمون الأدوات، ويتخذون القرارات، وينجزون مهام متعددة الخطوات باستقلالية، على نطاق واسع، وعلى مدار الساعة.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">يعمل على مدار الساعة، دون استراحات أو أيام إجازة</span>
      <span class="tchip">يربط عشرات الإجراءات لإنجاز مهام معقدة</span>
      <span class="tchip">يعدّل أسلوبه حسب ما يجده</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_agents_hero" class="btn-primary">ابنوا وكيلكم الأول</button>
      <a href="#agent-types" class="btn-outline">شاهدوا أنواع الوكلاء ↓</a>
    </div>
  </div>
</header>

<!-- IMAGE BANNER -->
<div style="width:100%; height:280px; overflow:hidden; position:relative;">
  <img src="https://images.unsplash.com/photo-1535378917042-10a22c95931a?w=1400&q=80&auto=format&fit=crop" alt="وكلاء ذكاء اصطناعي وأنظمة اتخاذ قرار مستقلة" loading="eager" fetchpriority="high" width="1400" height="280" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center;" />
  <div style="width:100%; height:100%; background:rgba(0,25,42,0.78); display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "٢٤/٧", caption: "الوكلاء يعملون على مدار الساعة، دون استراحات أو أيام إجازة" },
      { value: "متعدد الخطوات", caption: "الوكلاء يربطون عشرات الإجراءات لإنجاز مهام معقدة" },
      { value: "متكيّف", caption: "الوكلاء يعدّلون أسلوبهم حسب ما يجدونه" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT ARE AI AGENTS -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هو وكيل الذكاء الاصطناعي بالضبط؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          وكيل الذكاء الاصطناعي نظام برمجي يستطيع إدراك بيئته، والتفكير في المشكلة، وتنفيذ إجراءات لتحقيق هدف، دون حاجة لإنسان يوجّه كل خطوة. على عكس روبوت المحادثة الذي ينتظر الأسئلة ويجيب عنها واحداً تلو الآخر، يُعطى الوكيل مهمة ويكتشف بنفسه كيف ينجزها: ما المعلومات التي يحتاجها، وأي أدوات يستدعي، وبأي ترتيب، وكيف يتعامل مع ما يعود إليه.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          الفرق العملي كبير. اطلبوا من روبوت محادثة "اعثر على أفضل ٢٠ عميلاً محتملاً لدينا، وتحقق من آخر تحديثاتهم على LinkedIn، وصِغ رسائل تواصل مخصصة"، وستحصلون على قائمة مهام كرد. أعطوا نفس المهمة لوكيل ذكاء اصطناعي مبني جيداً، فيبحث عن العملاء المحتملين، ويقرأ بيانات LinkedIn، ويصيغ ٢٠ رسالة مخصصة، ويضعها في نظام CRM جاهزة للمراجعة. الوكيل يتولى العمل، وأنتم تتولون القرارات التي تحتاج تقديركم فعلاً.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop" alt="فريق في دبي يراجع قائمة مهام وكيل ذكاء اصطناعي على حاسوب محمول" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      بالنسبة للشركات، هذه الفجوة في القدرات هائلة. في معظم الشركات، يقضي الموظفون ٢٠ إلى ٤٠ بالمئة من وقتهم في مهام منظمة ومتكررة ومدعومة بالأدوات: توجيه الرسائل، وتحديث السجلات، ونقل البيانات من نظام لآخر، والجدولة، والمتابعات، والمراقبة. هذه بالضبط المهام التي صُمم لها وكلاء الذكاء الاصطناعي. تشغيل الوكلاء على هذا النوع من سير العمل لا يقلل عدد الموظفين، بل يفرّغ فريقكم للعمل الذي يعتمد على التقدير والعلاقات ويحتاج إنساناً فعلاً.
    </p>
  </div>
</section>

<!-- AGENT DEMO TABS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="demo-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="demo-heading">شاهدوا وكيلاً أثناء العمل</h2>
      <p style="color:#42474e; font-size:1.0625rem;">اختاروا دوراً أدناه لتروا ما يفعله الوكيل فعلياً، خطوة بخطوة، من لحظة استلام المهمة حتى لحظة تسليم النتيجة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">المبيعات والتواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>المهمة المستلمة:</strong> "اعثر على ٢٠ عميلاً محتملاً مهتماً في قطاع العقارات وصِغ رسائل تواصل مخصصة."</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>ما ينفذه الوكيل:</strong> يسحب جهات الاتصال المطابقة من نظام CRM، ويتحقق من آخر نشاط لكل منها على LinkedIn، ويصيغ رسالة مخصصة تشير إلى أمر محدد يخص كل عميل محتمل.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>النتيجة المسلّمة:</strong> ٢٠ رسالة مصاغة في نظام CRM، جاهزة ليراجعها مندوب المبيعات ويرسلها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">manage_search</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">البحث والتحليل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>المهمة المستلمة:</strong> "لخّص ما غيّره أكبر ٥ منافسين لنا في أسعارهم هذا الربع."</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>ما ينفذه الوكيل:</strong> يبحث في المصادر العامة، ويقرأ صفحات الأسعار والتغطية الصحفية، ويتحقق من التواريخ، وينظم النتائج حسب كل منافس.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>النتيجة المسلّمة:</strong> تقرير منظم من صفحة واحدة مع ذكر المصادر، يُسلَّم خلال دقائق.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">خدمة العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>المهمة المستلمة:</strong> عميل يرسل بريداً يسأل أين طلبه وهل ما زال بالإمكان تعديله.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>ما ينفذه الوكيل:</strong> يبحث عن حالة الطلب، ويتحقق مما إذا كان قد شُحن، ويرد بالإجابة، أو بتأكيد التعديل إذا كان ما زال ممكناً.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>النتيجة المسلّمة:</strong> يحصل العميل على إجابة خلال ثوانٍ، في أي وقت من اليوم.</p>
      </div>
    </div>
  </div>
</section>

<!-- AGENT TYPES -->
<section id="agent-types" class="section" aria-labelledby="agents-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="agents-heading">أنواع وكلاء الذكاء الاصطناعي التي نبنيها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة شائعة، وليست قائمة ثابتة. كل وكيل مبني خصيصاً لحالتكم، ومدرَّب على سياقكم، ومربوط بأدواتكم الحالية. إذا لم تندرج فكرتكم تحت أي منها، أحضروها إلينا.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">وكلاء المبيعات والتواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يبحث عن العملاء المحتملين، ويخصص رسائل التواصل، ويرسل المتابعات، ويحدّث نظام CRM، ويتولى مئات المحادثات في وقت واحد.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">manage_search</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">وكلاء البحث والتحليل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يبحث في الويب، ويقرأ المستندات، ويجمع النتائج، ويسلّم تقارير منظمة. ساعات من البحث تُنجز في دقائق.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">وكلاء خدمة العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يتولى الدعم من المستوى الأول والثاني باستقلالية: يتحقق من حالة الطلبات، ويعالج المبالغ المستردة، ويصعّد الحالات الاستثنائية، ولا يترك عميلاً ينتظر أبداً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">وكلاء الجدولة والعمليات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">ينسّق التقاويم، ويحجز الاجتماعات، ويدير المواعيد المتاحة، ويتولى الترتيبات اللوجستية، فيحرر فريقكم من التنسيق المتبادل الذي لا ينتهي.</p>
      </div>
