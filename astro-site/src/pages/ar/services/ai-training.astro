---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import StatStrip from '../../../components/StatStrip.astro';

const faqItems = [
  { question: "كم عدد الأشخاص الذين يمكنهم حضور ورشة واحدة؟", answer: "ورشة أسس الذكاء الاصطناعي تستوعب حتى 20 مشاركاً. للفرق الأكبر، نُنظم جلسات متعددة. البرامج العملية (تدريب المستخدم المتقدم) محدودة بـ12 مشاركاً للحفاظ على الجودة. يمكننا جدولة مجموعات إضافية للفرق الأكبر." },
  { question: "هل يحتاج المشاركون لأي معرفة مسبقة بالذكاء الاصطناعي؟", answer: "لا. ورشة أسس الذكاء الاصطناعي مُصمَّمة للمبتدئين تماماً. نُجري تقييماً قبل التدريب حتى نبدأ دائماً من المستوى الصحيح لفريقك. لا تحتاج لمعرفة أي شيء عن الذكاء الاصطناعي مسبقاً." },
  { question: "هل يمكننا الحصول على المواد بلغتنا المفضلة؟", answer: "نعم. جميع المواد قابلة للتخصيص بالكامل حسب اللغة. نُقدّم الإنجليزية كلغة افتراضية ويمكننا التكيف مع لغات أخرى عند الطلب. سنُؤكد لغة التسليم خلال مكالمة الإعداد." },
  { question: "هل يمكن دمج التدريب مع تطوير نظام ذكاء اصطناعي؟", answer: "نعم، وهذا هو النهج الذي نُوصي به. عندما نبني لك نظام ذكاء اصطناعي مخصصاً، يكون تدريب الفريق مشمولاً ضمن باقتي النظام الأساسي والتحول الشامل. هذا يضمن تبنياً عالياً من اليوم الأول." },
  { question: "كيف تقيسون ما إذا كان التدريب قد نجح؟", answer: "نُجري تقييماً بعد التدريب لمقارنة مستويات الثقة والقدرة في استخدام الذكاء الاصطناعي قبل وبعد. نتابع أيضاً بعد 30 يوماً لنرى مدى استخدام الفرق الفعلي للذكاء الاصطناعي في عملها اليومي. إذا كان التبني بطيئاً، نُحدد السبب ونُنظم جلسات متابعة موجهة. الهدف هو التغيير السلوكي، لا مجرد الحضور." },
  { question: "ما الفرق بين تدريبكم ومشاهدة دروس يوتيوب؟", answer: "دروس يوتيوب عامة. تدريبنا مبني حول أدوار فريقك المحددة، أدوات شركتك ومساراتها، وسيناريوهات حقيقية من قطاعك. يتدرب المشاركون على مهام سيؤدونها فعلياً في العمل، لا أمثلة افتراضية. التمارين تستخدم أدوات الذكاء الاصطناعي الفعلية لديكم، محتواكم الفعلي، وتُنتج مخرجات يمكن لفريقكم استخدامها فوراً." },
  { question: "نحن خارج الإمارات. هل يمكنكم تدريب فريقنا عن بُعد؟", answer: "نعم. جميع البرامج متاحة بالكامل عن بُعد عبر مكالمة فيديو، بنفس التمارين العملية والأسئلة والأجوبة الفورية كالتسليم الحضوري. دربنا فرقاً في الشرق الأوسط، أوروبا، وآسيا. المواد تُسلَّم رقمياً، ودعم المتابعة لمدة 30 يوماً يعمل بنفس الطريقة بغض النظر عن الموقع." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "التدريب على الذكاء الاصطناعي والورش",
    "url": "https://lenooai.com/ar/services/ai-training",
    "description": "ورش عمل تدريبية عملية على الذكاء الاصطناعي لفرق العمل حول العالم. برامج مخصصة لكل دور، مصممة لقطاعك ومسارات عملك وفريقك، حضورياً أو عن بُعد.",
    "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "offers": { "@type": "Offer", "description": "ورشة أسس الذكاء الاصطناعي: التسعير مخصص حسب حجم فريقك والبرنامج." },
    "serviceType": "التدريب على الذكاء الاصطناعي"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
      { "@type": "ListItem", "position": 3, "name": "التدريب على الذكاء الاصطناعي والورش", "item": "https://lenooai.com/ar/services/ai-training" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
  }
];
---

<ArBaseLayout
  title="تدريب فرق العمل على الذكاء الاصطناعي للشركات في الإمارات | Aegis AI"
  description="ورش عمل عملية على الذكاء الاصطناعي من وكالة ذكاء اصطناعي في دبي تخدم فرق العمل في جميع أنحاء الإمارات. برامج مخصصة لكل دور، حضورياً أو عن بُعد، مع ضمان رضا 100%."
  canonicalPath="/ar/services/ai-training"
  enPath="/services/ai-training"
  ogImage="/assets/og-ai-training.jpg"
  ldJson={ldJson}
>

<!-- ── HERO ── -->
<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التدريب على الذكاء الاصطناعي والورش</div>
    <div class="badge badge-amber" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">groups</span>
      تدريب الموظفين على الذكاء الاصطناعي
    </div>
    <h1 style="max-width:54rem;margin:0 auto 1.5rem;">فريقك يحتاج لاستخدام الذكاء الاصطناعي.<br><span class="gradient-text">نحن نتأكد من أنه يفعل.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; line-height:1.75; max-width:40rem; margin:0 auto 2.5rem;">
      معظم مشاريع الذكاء الاصطناعي تفشل لأن الفرق لا تتبناها، لا لأن التقنية لا تعمل. نُدرّب فريقك على استخدام الذكاء الاصطناعي بثقة في عمله اليومي، حتى تُحقق الأدوات التي تستثمر فيها نتائج فعلية.
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:1rem; justify-content:center;">
      <button onclick="openModal(this)" data-source="ar_training_hero" class="btn-primary" style="font-size:1rem;">اطلب عرض سعر التدريب ←</button>
      <a href="#programs" class="btn-outline" style="font-size:1rem;">شاهد البرامج ↓</a>
    </div>
  </div>
</header>

<!-- ── IMAGE / STAT BANNER ── -->
<div style="width: 100%; height: 380px; overflow: hidden; position: relative;">
  <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1400&q=80&auto=format&fit=crop" alt="ورشة تدريب على الذكاء الاصطناعي لفرق العمل" loading="eager" fetchpriority="high" width="1400" height="380" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="width: 100%; height: 100%; background: rgba(0,30,55,0.78); display: flex; align-items: center; justify-content: center;">
    <div style="position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <StatStrip stats={[
      { value: "#1", caption: "سبب فشل الذكاء الاصطناعي: ضعف تبني الفريق، لا سوء التقنية" },
      { value: "أسرع", caption: "الفرق المدربة تستخدم أدوات الذكاء الاصطناعي يومياً، لا أحياناً" },
      { value: "متضمن", caption: "دعم متابعة متضمن بعد كل ورشة" },
    ]} />
  </div>
  <div style="position: absolute; inset: 0; background: linear-gradient(to top, #f9f9ff 0%, transparent 100%); pointer-events: none;"></div>
</div>

<!-- WHY TRAINING MATTERS -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">لماذا تدريب الفريق هو الحلقة المفقودة في معظم تطبيقات الذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          السبب الأكثر شيوعاً لضعف عائد استثمارات الذكاء الاصطناعي ليس التقنية. التقنية تعمل بشكل جيد. المشكلة هي التبني. الفرق التي لم تُدرَّب على استخدام أدوات الذكاء الاصطناعي بفعالية تستخدمها أحياناً، بشكل سيء، أو لا تستخدمها إطلاقاً. التراخيص تبقى دون استخدام، ومكاسب الكفاءة لا تتحقق أبداً، وتخلص الشركة إلى أن الذكاء الاصطناعي لا يناسبها، بينما في الواقع كانت الأداة جيدة لكن الفريق لم يتعلم كيفية استخدامها.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&q=80&auto=format&fit=crop" alt="زملاء في شركة إماراتية يتدربون معاً على كتابة أوامر الذكاء الاصطناعي خلال ورشة عملية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <div style="max-width:800px; margin:2rem auto 0;">
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        التدريب الفعّال على الذكاء الاصطناعي ليس محاضرة مدتها ساعة عن ماهية الذكاء الاصطناعي. إنه تعليم عملي مخصص لكل دور، يُعلّم كل شخص في مؤسستك كيف يساعده الذكاء الاصطناعي على أداء عمله بشكل أفضل. موظف المبيعات يحتاج أن يتعلم كيف يستخدم الذكاء الاصطناعي للبحث عن العملاء المحتملين وصياغة المتابعات. مدير العمليات يحتاج أن يفهم كيف يستخدم الذكاء الاصطناعي لتحليل البيانات وإعداد التقارير. أخصائي الموارد البشرية يحتاج أن يعرف كيف يستخدم الذكاء الاصطناعي لصياغة الوصف الوظيفي وفرز المتقدمين. التدريب العام الذي يغطي "ما هو الذكاء الاصطناعي" يُنتج فرقاً تعلّمت شيئاً لكنها لم تُغيّر شيئاً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        عائد التدريب الصحيح على الذكاء الاصطناعي واضح: الموظفون الذين يعرفون كيفية استخدام الذكاء الاصطناعي بفعالية يوفرون ساعات كل أسبوع. على مستوى فريق من 20 شخصاً، هذا يعني عشرات الساعات المُستعادة كل أسبوع. على مدار عام، هذا مكسب إنتاجية كبير، دون زيادة عدد الموظفين أو استبدال أي أدوات حالية.
      </p>
    </div>
  </div>
</section>

<!-- ── THE PROBLEM ── -->
<section class="section" aria-labelledby="problem-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h2 id="problem-heading">لماذا لا تُحقق معظم استثمارات الذكاء الاصطناعي نتائج</h2>
      <p style="color: #42474e; max-width: 36rem; margin: 1rem auto 0; line-height: 1.7;">ثلاثة أنماط تتكرر باستمرار عندما يفشل تبني الذكاء الاصطناعي.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(186,26,26,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">يتم شراء البرنامج، وتُخصَّص التراخيص، ثم لا يتغير شيء. الفرق تستمر بالعمل كما اعتادت دائماً.</p>
      </div>
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(245,158,11,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">نشر الأداة هو الجزء السهل. جعل الناس يُغيّرون طريقة عملهم فعلياً هو حيث تتعثر معظم عمليات الإطلاق ولا تتعافى أبداً.</p>
      </div>
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(0,37,59,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#00253b" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">عندما يصل الذكاء الاصطناعي دون تفسير، يملأ الناس الفجوة بالخوف. القلق بشأن الأمان الوظيفي يقتل التبني قبل أن تُتاح له أي فرصة للترسخ.</p>
      </div>
    </div>
    <div style="background: #e7eeff; border-radius: 16px; padding: 1.5rem 2rem; max-width: 680px; margin: 2.5rem auto 0; text-align: center;">
      <p style="color: #00253b; font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem;">لنكون واضحين: هدفنا هو العكس تماماً.</p>
      <p style="color: #42474e; font-size: 0.9375rem; line-height: 1.7; margin: 0;">نُدرّب فريقك على استخدام الذكاء الاصطناعي كأداة تجعله أفضل في عمله. لا أسرع في تسريحه. كل ورشة نُقدّمها تبدأ بهذا: الذكاء الاصطناعي هنا ليساعدك على إنجاز المزيد، لا ليحل محلك.</p>
    </div>
    <p style="color: #006875; text-align: center; font-weight: 700; font-size: 1.125rem; margin-top: 2rem;">ورشنا تحل المشكلات الثلاث: تطبيق عملي، مخصص لكل دور، ومصمم لقطاعك.</p>
  </div>
</section>

<!-- ── PROGRAMS ── -->
<section id="programs" class="section" style="background: #e7eeff;" aria-labelledby="programs-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-family: 'Inter', sans-serif; margin-bottom: 1rem;">برامج التدريب</p>
      <h2 id="programs-heading">اختر البرنامج المناسب لفريقك</h2>
      <p style="color: #42474e; max-width: 38rem; margin: 1rem auto 0; line-height: 1.7;">جميع البرامج متاحة في مكتبك، عبر الإنترنت بمكالمة فيديو، أو بشكل مختلط، في أي مكان في العالم.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=1200&q=80&auto=format&fit=crop" alt="جلسة تدريب عملية على الذكاء الاصطناعي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem;">
          <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(0,104,117,0.10); display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
        </div>
        <h3 style="margin-bottom: .375rem;">أسس الذكاء الاصطناعي</h3>
        <p class="program-price">لجميع الموظفين · حتى 20 شخصاً</p>
        <p style="color: #42474e; line-height: 1.7; margin-bottom: 1.25rem;">كل موظف يتعلم ما هو الذكاء الاصطناعي، الأدوات التي تساعد عمله اليومي، كيفية كتابة أوامر فعالة، وكيفية البقاء آمناً مع الذكاء الاصطناعي.</p>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">ما هو الذكاء الاصطناعي (وما ليس هو)، بشرح مبسط</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أفضل أدوات الذكاء الاصطناعي لدورك</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أساسيات كتابة الأوامر</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أمان الذكاء الاصطناعي، الخصوصية، والامتثال في البيانات</span></div>
        <p style="color: #72787e; font-size: .85rem; margin-top: 1rem; font-style: italic;">النتيجة: كل موظف يستخدم الذكاء الاصطناعي بثقة في مساره اليومي</p>
      </div>
      <div class="card">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem;">
