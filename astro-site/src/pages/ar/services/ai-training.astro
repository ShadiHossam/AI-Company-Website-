---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "كم شخصاً يمكنه حضور ورشة واحدة؟", answer: "ورشة أسس الذكاء الاصطناعي تتسع لعشرين مشاركاً كحد أقصى. للفرق الأكبر، ننظّم عدة جلسات. البرامج العملية (تدريب المستخدمين المتقدمين) محدودة باثني عشر مشاركاً للحفاظ على الجودة، وننظّم دفعات إضافية للفرق الأكبر." },
  { question: "هل يحتاج المشاركون لمعرفة سابقة بالذكاء الاصطناعي؟", answer: "لا. ورشة أسس الذكاء الاصطناعي مصممة للمبتدئين تماماً. نُجري تقييماً قبل التدريب حتى نبدأ دائماً من المستوى المناسب لفريقكم. لا تحتاجون لمعرفة أي شيء عن الذكاء الاصطناعي مسبقاً." },
  { question: "هل يمكن الحصول على المواد باللغة التي نفضّلها؟", answer: "نعم. كل المواد قابلة للتخصيص بالكامل حسب اللغة. نقدّم التدريب بالعربية أو الإنجليزية أو بكلتيهما، ويمكننا استيعاب لغات أخرى عند الطلب. نؤكد لغة التقديم خلال مكالمة الانطلاق." },
  { question: "هل يمكن الجمع بين التدريب وتطوير نظام ذكاء اصطناعي؟", answer: "نعم، وهذا هو النهج الذي نوصي به. عندما نبني لكم نظام ذكاء اصطناعي مخصصاً، يكون تدريب الفريق مشمولاً في باقتي النظام الأساسي والتحوّل الشامل. هذا يضمن تبنّياً عالياً من اليوم الأول." },
  { question: "كيف تقيسون نجاح التدريب؟", answer: "نُجري تقييماً بعد التدريب لمقارنة مستوى الثقة والقدرة على استخدام الذكاء الاصطناعي قبل التدريب وبعده. ونتابع بعد ٣٠ يوماً لنرى مدى استخدام الفرق للذكاء الاصطناعي في عملها اليومي. إذا كان التبنّي متأخراً، نحدد السبب وننظّم جلسات متابعة موجّهة. الهدف تغيير في السلوك، لا مجرد حضور." },
  { question: "ما الفرق بين تدريبكم ومشاهدة دروس على يوتيوب؟", answer: "دروس يوتيوب عامة. تدريبنا مبني حول أدوار فريقكم بالتحديد، أدوات شركتكم وسير عملها، وسيناريوهات حقيقية من قطاعكم. المشاركون يتدربون على مهام سيؤدونها فعلياً في عملهم، لا أمثلة افتراضية. التمارين تستخدم أدوات الذكاء الاصطناعي التي تستخدمونها فعلياً ومحتواكم الفعلي، وتُنتج مخرجات يستطيع فريقكم استخدامها فوراً." },
  { question: "شركتنا خارج الإمارات. هل يمكنكم تدريب فريقنا عن بُعد؟", answer: "نعم. جميع البرامج متاحة بالكامل عن بُعد عبر مكالمة فيديو، بنفس التمارين العملية والأسئلة والأجوبة الفورية كما في التدريب الحضوري. درّبنا فرقاً في الشرق الأوسط وأوروبا وآسيا. المواد تُسلَّم رقمياً، ودعم المتابعة لمدة ٣٠ يوماً يعمل بنفس الطريقة بغض النظر عن موقعكم." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_training')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="تدريب وورش ذكاء اصطناعي لفرق العمل في الإمارات | Lenoo AI"
  description="ورش تدريب عملية على الذكاء الاصطناعي من وكالة في دبي تخدم الفرق في كل الإمارات. برامج حسب الدور الوظيفي، حضورياً أو عن بُعد، مع ضمان رضا ١٠٠٪."
  canonicalPath="/ar/services/ai-training"
  enPath="/services/ai-training"
  ogImage="/assets/og-ai-training.jpg"
  ldJson={[faqLdJson]}
>

<!-- ── HERO ── -->
<header class="hero-section" style="padding-top: 10rem; padding-bottom: 5rem; text-align: center;">
  <div class="container" style="position: relative; z-index: 1;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تدريب وورش الذكاء الاصطناعي</div>
    <h1 style="max-width: 54rem; margin: 0 auto 1.5rem;">
      فريقكم يحتاج لاستخدام الذكاء الاصطناعي.<br>
      <span class="gradient-text">ونحن نضمن أنه يستخدمه فعلاً.</span>
    </h1>
    <p style="color: rgba(255,255,255,0.72); font-size: 1.125rem; line-height: 1.75; max-width: 40rem; margin: 0 auto 0;">
      معظم مشاريع الذكاء الاصطناعي تفشل لأن الفرق لا تتبنّاها، لا لأن التقنية لا تعمل. ندرّب موظفيكم على استخدام الذكاء الاصطناعي بثقة في عملهم اليومي، حتى تحقق الأدوات التي تستثمرون فيها نتائج فعلية.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">سبب فشل الذكاء الاصطناعي: ضعف التبنّي، لا سوء التقنية</span>
      <span class="tchip">الفرق المدرّبة تستخدم أدوات الذكاء الاصطناعي يومياً، لا أحياناً</span>
      <span class="tchip">دعم متابعة مشمول بعد كل ورشة</span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
      <button onclick="openModal(this)" data-source="ar_training_hero" class="btn-primary" style="font-size: 1rem;">اطلبوا عرض سعر للتدريب ←</button>
      <a href="#programs" class="btn-outline" style="font-size: 1rem;">شاهدوا البرامج ↓</a>
    </div>
  </div>
</header>

<!-- ── IMAGE / STAT BANNER ── -->
<div style="width: 100%; height: 380px; overflow: hidden; position: relative;">
  <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1400&q=80&auto=format&fit=crop" alt="ورشة تدريب على الذكاء الاصطناعي لفرق العمل" loading="eager" fetchpriority="high" width="1400" height="380" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="width: 100%; height: 100%; background: rgba(0,30,55,0.78); display: flex; align-items: center; justify-content: center;">
    <div style="position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <StatStrip stats={[
      { value: "السبب الأول", caption: "لفشل الذكاء الاصطناعي: ضعف تبنّي الفريق، لا سوء التقنية" },
      { value: "أسرع", caption: "الفرق المدرّبة تستخدم أدوات الذكاء الاصطناعي يومياً، لا أحياناً" },
      { value: "مشمول", caption: "دعم المتابعة مشمول بعد كل ورشة" },
    ]} />
  </div>
  <div style="position: absolute; inset: 0; background: linear-gradient(to top, #f9f9ff 0%, transparent 100%); pointer-events: none;"></div>
</div>

<!-- WHY TRAINING MATTERS -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">لماذا تدريب الفريق هو الحلقة المفقودة في معظم مشاريع الذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          السبب الأكثر شيوعاً لضعف عائد استثمارات الذكاء الاصطناعي ليس التقنية. التقنية تعمل. المشكلة هي التبنّي. الفرق التي لم تتدرب على استخدام أدوات الذكاء الاصطناعي بفعالية تستخدمها أحياناً، أو بشكل سيئ، أو لا تستخدمها إطلاقاً. تبقى التراخيص دون استخدام، ولا تتحقق مكاسب الكفاءة، وتستنتج الشركة أن الذكاء الاصطناعي لا يناسبها، بينما الحقيقة أن الأداة كانت جيدة لكن الفريق لم يتعلم استخدامها.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&q=80&auto=format&fit=crop" alt="زملاء في شركة إماراتية يتدربون معاً على كتابة أوامر الذكاء الاصطناعي خلال ورشة عملية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <div style="max-width:800px; margin:2rem auto 0;">
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        التدريب الفعّال على الذكاء الاصطناعي ليس نظرة عامة لمدة ساعة عمّا هو الذكاء الاصطناعي. إنه تدريب عملي حسب الدور الوظيفي، يعلّم كل شخص في مؤسستكم كيف يساعده الذكاء الاصطناعي على أداء عمله المحدد بشكل أفضل. مندوب المبيعات يحتاج لتعلم استخدام الذكاء الاصطناعي في البحث عن العملاء المحتملين وصياغة رسائل المتابعة. مدير العمليات يحتاج لفهم كيفية استخدامه في تحليل البيانات وإعداد التقارير. أخصائي الموارد البشرية يحتاج لمعرفة كيفية استخدامه في صياغة الأوصاف الوظيفية وفرز الطلبات. التدريب العام الذي يشرح "ما هو الذكاء الاصطناعي" ينتج فرقاً تعلمت شيئاً لكنها لم تغيّر شيئاً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        العائد من التدريب الصحيح على الذكاء الاصطناعي واضح: الموظفون الذين يعرفون كيف يستخدمونه بفعالية يوفرون ساعات كل أسبوع. في فريق من عشرين شخصاً، هذا يعني عشرات الساعات المستعادة أسبوعياً. وعلى مدار عام، هذا مكسب كبير في الإنتاجية، دون زيادة عدد الموظفين أو استبدال أي أدوات حالية.
      </p>
    </div>
  </div>
</section>

<!-- ── THE PROBLEM ── -->
<section class="section" aria-labelledby="problem-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h2 id="problem-heading">لماذا لا تحقق معظم استثمارات الذكاء الاصطناعي نتائجها</h2>
      <p style="color: #42474e; max-width: 36rem; margin: 1rem auto 0; line-height: 1.7;">ثلاثة أنماط تتكرر مراراً عندما يتعثر تبنّي الذكاء الاصطناعي.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(186,26,26,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#ba1a1a" stroke-width="2"><path d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تُشترى البرمجيات، وتُوزَّع التراخيص، ثم لا يتغير شيء. تستمر الفرق في العمل بالطريقة التي اعتادت عليها دائماً.</p>
      </div>
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(245,158,11,0.10); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#92400e" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">تشغيل الأداة هو الجزء السهل. جعل الناس يغيّرون طريقة عملهم فعلاً هو المكان الذي تتوقف فيه معظم عمليات الإطلاق ولا تتعافى أبداً.</p>
      </div>
      <div class="card text-center">
        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(0,37,59,0.08); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
          <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#00253b" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        </div>
        <p style="color: #42474e; line-height: 1.65;">عندما يصل الذكاء الاصطناعي دون شرح، يملأ الناس الفراغ بالخوف. القلق على الأمان الوظيفي يقضي على التبنّي قبل أن تتاح له أي فرصة.</p>
      </div>
    </div>
    <div style="background: #e7eeff; border-radius: 16px; padding: 1.5rem 2rem; max-width: 680px; margin: 2.5rem auto 0; text-align: center;">
      <p style="color: #00253b; font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem;">للتوضيح: هدفنا هو العكس تماماً.</p>
      <p style="color: #42474e; font-size: 0.9375rem; line-height: 1.7; margin: 0;">ندرّب فريقكم على استخدام الذكاء الاصطناعي كأداة تجعلهم أفضل في عملهم، لا أسرع في فقدان وظائفهم. كل ورشة نقدمها تبدأ بهذه الفكرة: الذكاء الاصطناعي موجود ليساعدكم على إنجاز المزيد، لا ليحل محلكم.</p>
    </div>
    <p style="color: #006875; text-align: center; font-weight: 700; font-size: 1.125rem; margin-top: 2rem;">ورشنا تعالج الأنماط الثلاثة: عملية، حسب الدور الوظيفي، ومصممة لقطاعكم.</p>
  </div>
</section>

<!-- ── PROGRAMS ── -->
<section id="programs" class="section" style="background: #e7eeff;" aria-labelledby="programs-heading">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <p style="color: #006875; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem;">برامج التدريب</p>
      <h2 id="programs-heading">اختاروا البرنامج المناسب لفريقكم</h2>
      <p style="color: #42474e; max-width: 38rem; margin: 1rem auto 0; line-height: 1.7;">كل البرامج متاحة حضورياً في مكتبكم، عبر مكالمة فيديو، أو بشكل مختلط، في أي مكان في العالم.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=1200&q=80&auto=format&fit=crop" alt="جلسة تدريب عملية على الذكاء الاصطناعي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid" style="grid-template-columns: repeat(2, 1fr);">
      <div class="card">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem;">
          <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(0,104,117,0.10); display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
        </div>
        <h3 style="margin-bottom: .375rem;">أسس الذكاء الاصطناعي</h3>
        <p class="program-price">لكل الموظفين · حتى ٢٠ شخصاً</p>
        <p style="color: #42474e; line-height: 1.7; margin-bottom: 1.25rem;">كل موظف يتعلم ما هو الذكاء الاصطناعي، أي الأدوات تساعد عمله اليومي، كيف يكتب أوامر فعالة، وكيف يبقى آمناً عند استخدام الذكاء الاصطناعي.</p>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">ما هو الذكاء الاصطناعي (وما ليس هو)، بشرح مبسّط</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أفضل أدوات الذكاء الاصطناعي لدوركم</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أساسيات كتابة الأوامر</span></div>
        <div class="check-row"><svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="#006875" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span style="color: #42474e; font-size: .9rem;">أمان الذكاء الاصطناعي، الخصوصية، والامتثال في التعامل مع البيانات</span></div>
        <p style="color: #72787e; font-size: .85rem; margin-top: 1rem; font-style: italic;">النتيجة: كل موظف يستخدم الذكاء الاصطناعي بثقة في سير عمله اليومي</p>
      </div>
      <div class="card">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem;">
          <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(0,104,117,0.10); display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#006875" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
        </div>
