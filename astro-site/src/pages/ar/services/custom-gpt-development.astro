---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import StatStrip from '../../../components/StatStrip.astro';

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const faqItems = [
  { question: "ما هو المساعد الذكي المخصص بالضبط؟", answer: "المساعد الذكي المخصص هو نموذج لغوي مُهيّأ خصيصاً لشركتك. تُحدد أنت هدفه، وتُزوّده بملفات المعرفة (وثائقك، إجراءاتك التشغيلية، معلومات منتجاتك)، ويمكن اختيارياً ربطه بأنظمة خارجية عبر API. يتصرف وفق قواعدك، ويعرف محتواك، ويمكن مشاركته مع فريقك أو عملائك، كل ذلك دون أن يكتب فريقك سطراً واحداً من الكود." },
  { question: "هل يمكن ربط مساعدنا الذكي بأنظمتنا؟", answer: "نعم. نربط مساعدك الذكي بواجهات API خارجية: نظام CRM، قاعدة بياناتك، موقعك الإلكتروني، نظام الدعم الفني، أو أي نظام يملك واجهة API. هذا يعني أنه يستطيع الاطلاع على بيانات لحظية، وإنشاء سجلات، وإرسال رسائل، واتخاذ إجراءات، لا مجرد الإجابة عن الأسئلة." },
  { question: "من يستطيع الوصول إليه بعد بنائه؟", answer: "أنت من يقرر. يمكننا إعداده للوصول الخاص (فقط من تدعوهم)، أو مشاركته عبر مساحة عمل فريقك الداخلي، أو فتحه للعملاء. تبدأ معظم الشركات العميلة بالوصول الداخلي فقط ثم تُوسّعه لاحقاً." },
  { question: "هل يبقى مُحدَّثاً بالمعلومات الجديدة؟", answer: "نُعدّ سير عمل يُحدّث قاعدة معرفة مساعدك الذكي تلقائياً، بحيث يعكس دائماً أحدث أسعارك وسياساتك ووثائقك. أما بالنسبة للبيانات اللحظية، فنربطه بأنظمتك ليسحب المعلومات الحيّة وقت كل محادثة." },
  { question: "ما هو ضمان الـ100%؟", answer: "إذا لم تكن راضياً عمّا نُسلّمه، لا تدفع شيئاً. هذا ليس كلاماً تسويقياً، بل شروطنا القياسية. نقبل فقط المشاريع التي نعرف أننا قادرون على تسليمها، ولهذا لم نضطر يوماً لردّ أي مبلغ." },
  { question: "ما الفرق بين هذا واستخدام أداة ذكاء اصطناعي عامة في العمل؟", answer: "أدوات الذكاء الاصطناعي العامة غير مُهيّأة ولا تعرف شيئاً عن شركتك. المساعد الذكي المخصص مُدرَّب على منتجاتك وسياساتك ونبرتك وسياقك. يُقدّم إجابات متسقة تتماشى مع قواعد شركتك، لا الإجابة المتوسطة التي تعلّمها من الإنترنت. يمكن أيضاً تقييده: فلا يُقدّم نصائح خارج نطاقه، ولا يناقش المنافسين، ولا يقول أشياء تتعارض مع سياساتك." },
  { question: "على أي منصات يمكنكم نشر المساعد؟", answer: "ننشر على واجهات الويب، ومنصات الفريق الداخلية، وتطبيقات المراسلة، وأدوات الدردشة على المواقع الإلكترونية، والتطبيقات المخصصة. يمكن لمساعدك العمل على قناة واحدة أو عدة قنوات في آن واحد. نبني التكامل بناءً على المكان الذي يقضي فيه فريقك أو عملاؤك وقتهم فعلياً." },
  { question: "ماذا لو أردنا توسيع قدرات المساعد بعد الإطلاق؟", answer: "هذا أمر شائع جداً. يبدأ معظم العملاء بمساعد مُركّز ثم يُوسّعون قدراته مع الوقت، بإضافة معرفة جديدة، أو أدوات جديدة، أو قنوات إضافية. البنية التي نبنيها معيارية (modular)، لذا إضافة قدرات بعد الإطلاق عادة ما تكون بسيطة ولا تتطلب إعادة البناء من الصفر." },
];

const processSteps = [
  { icon: "description", step: "الخطوة 1", title: "الموجز والنطاق", description: "نُحدد هدف المساعد، والجمهور المستهدف، والمعرفة التي يحتاجها لأداء مهمته." },
  { icon: "upload_file", step: "الخطوة 2", title: "البناء والتدريب", description: "نُهيّئ موجّه النظام، نرفع ملفات معرفتك، نُعدّ أي اتصالات API، ونُطبّق قواعد علامتك التجارية." },
  { icon: "science", step: "الخطوة 3", title: "الاختبار والتحسين", description: "نُشغّله عبر سيناريوهات حقيقية، وحالات استثنائية، وأسئلة معقدة، ثم نُحسّنه حتى يعمل تماماً كما هو مطلوب." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "النشر والتسليم", description: "نُطلقه لفريقك أو عملائك، نُدرّب المشرفين لديك على كيفية تحديثه، ونُسلّمك الملكية الكاملة." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "تطوير مساعدات ذكاء اصطناعي مخصصة", "url": "https://lenooai.com/ar/services/custom-gpt-development", "description": "نبني مساعدات ذكاء اصطناعي مخصصة مُدرَّبة على منتجاتك ووثائقك وسير عملك، ليحصل فريقك على ذكاء اصطناعي يعرف عملك فعلياً.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "serviceType": "تطوير نماذج ذكاء اصطناعي مخصصة" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "تطوير الذكاء الاصطناعي المخصص", "item": "https://lenooai.com/ar/services/custom-gpt-development" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];
---

<ArBaseLayout
  title="تطوير مساعدات ذكاء اصطناعي مخصصة للشركات في الإمارات | Aegis AI"
  description="بصفتنا وكالة ذكاء اصطناعي في دبي، نبني مساعدات ذكاء اصطناعي مخصصة للشركات في الإمارات، مُدرَّبة على منتجاتك وقاعدة معرفتك وسير عملك. تحمل هويتك وتُشغَّل ببياناتك."
  canonicalPath="/ar/services/custom-gpt-development"
  enPath="/services/custom-gpt-development"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير الذكاء الاصطناعي المخصص</div>
    <h1>عملك. ذكاؤك الاصطناعي. <span class="gradient-text">مبني حول بياناتك.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      أدوات الذكاء الاصطناعي العامة لا تعرف منتجاتك ولا نبرتك ولا عملاءك. نبني مساعدات ذكاء اصطناعي مخصصة تعرف كل ذلك، مُدرَّبة على بياناتك، تحمل اسم علامتك التجارية، وتُنشر حيث يعمل فريقك فعلياً.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_custom_gpt_hero" class="btn-primary">ابنِ ذكاءك الاصطناعي المخصص</button>
      <a href="#what-we-build" class="btn-outline">اكتشف ما هو ممكن ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=1400&q=80&auto=format&fit=crop" alt="تطوير مساعدات ذكاء اصطناعي مخصصة (Custom GPT) لشركات دبي والإمارات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "بياناتك", caption: "مُدرَّب على مستنداتك وسياساتك ومعرفتك، لا على الإنترنت" },
      { value: "بدون برمجة", caption: "نتولى كل شيء. فريقك يستخدمه فقط، دون أي مهارات تقنية" },
      { value: "أي فريق", caption: "المبيعات، الدعم، العمليات، الموارد البشرية، يُبنى لمن يحتاجه أكثر" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS A CUSTOM AI ASSISTANT -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هو المساعد الذكي المخصص؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        المساعد الذكي المخصص هو نظام ذكاء اصطناعي محادثاتي مُدرَّب خصيصاً على بيانات شركتك، ومُهيّأ ليتصرف وفق قواعدك. يعرف منتجاتك، وأسعارك، وسياساتك، ونبرة صوتك. يُقدّم إجابات دقيقة لشركتك تحديداً، لا إجابات عامة مستقاة من الإنترنت.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الفرق الجوهري عن أدوات الذكاء الاصطناعي الجاهزة هو السياق. أداة الذكاء الاصطناعي العامة تبدأ كل محادثة من الصفر: لا تعرف شركتك، ولا عملاءك، ولا خصوصيات قطاعك. أما المساعد المخصص فيبدأ من معرفة عميقة بعملك. فقد قرأ وثائقك، وتعلّم تفاصيل منتجاتك، وتلقّى تعليمات حول كيفية التعامل مع المواقف التي يواجهها فريقك فعلياً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        بحسب احتياجات شركتك، يمكن نشر المساعد المخصص كأداة داخلية لفريقك، أو بوت محادثة يتفاعل مع العملاء على موقعك أو واتساب، أو حلاً مُهجّناً يخدم الجمهورين بمستويات وصول مختلفة. يمكن أن يقتصر على الإجابة عن الأسئلة، أو أن يُربط بأنظمتك عبر واجهة برمجية (API) ليتمكن من الاطلاع على بيانات حيّة، وإنشاء سجلات، وإرسال رسائل، واتخاذ إجراءات أخرى نيابة عن المستخدمين. بصفتنا وكالة ذكاء اصطناعي في دبي نعمل مع شركات في جميع أنحاء الإمارات، نتولى البناء بالكامل بأنفسنا، من التصميم إلى النشر.
      </p>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">المساعدات الذكية المخصصة التي نبنيها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع شائعة، وليست قائمة شاملة. كل واحد منها مُدرَّب على محتواك، ومُهيّأ وفق قواعدك، ومُتصل بأنظمتك. إذا كانت فكرتك مختلفة عن أي شيء هنا، ما زلنا نريد بناءها.</p>
    </div>
    <div class="feature-ledger">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3>ذكاء اصطناعي لدعم العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يتعامل مع أسئلة المستوى الأول والثاني باستخدام وثائقك الفعلية، والأسئلة الشائعة، وسياسات الإرجاع، دون توجيه العملاء إلى أداة ذكاء اصطناعي عامة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">trending_up</span></div>
        <h3>مساعد ذكاء اصطناعي للمبيعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يعرف منتجاتك وأسعارك وأدلة التعامل مع الاعتراضات. يساعد فريق المبيعات على كتابة العروض، والاستعداد للمكالمات، والرد على أسئلة العملاء المحتملين خلال ثوانٍ.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">school</span></div>
        <h3>ذكاء اصطناعي للمعرفة الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">دليل شركتك، وإجراءاتك التشغيلية، ووثائقك الداخلية، قابلة للبحث عبر محادثة. الموظفون الجدد يحصلون على إجابات فورية، ويتوقف كبار الموظفين عن تكرار الإجابة على الأسئلة نفسها.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">draw</span></div>
        <h3>ذكاء اصطناعي لمحتوى العلامة التجارية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يكتب بأسلوبك. مُدرَّب على نصوصك السابقة، ودليل أسلوبك، وقواعد علامتك التجارية. يُنشئ رسائل بريد إلكتروني، ومنشورات على مواقع التواصل، وإعلانات تبدو فعلاً وكأنها بصوتك.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gavel</span></div>
        <h3>ذكاء اصطناعي قانوني وامتثالي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">مبني للقطاعات الخاضعة للتنظيم. يُجيب عن أسئلة تتعلق بالسياسات الداخلية، والعقود، وإجراءات الامتثال، مع ضوابط تمنعه من تقديم استشارات قانونية لا ينبغي له تقديمها.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">hub</span></div>
        <h3>ذكاء اصطناعي مُتصل عبر API</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يتجاوز حدود المستندات. يسحب بيانات حيّة من نظام CRM، ويتحقق من حالة الطلبات، وينشئ التذاكر، ويُحدّث السجلات، كل ذلك من واجهة محادثة واحدة.</p>
      </div>
    </div>
  </div>
</section>

<!-- SEE IT IN ACTION (flip cards) -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="action-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="action-heading">شاهده أثناء العمل</h2>
      <p>مرّر المؤشر أو اضغط على بطاقة لرؤية سؤال حقيقي يتعامل معه المساعد لهذا الدور.</p>
    </div>
    <div class="cgd-flip-grid">
      <div class="cgd-flip" tabindex="0">
        <div class="cgd-flip-inner">
          <div class="cgd-flip-face cgd-flip-front">
            <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:28px;">support_agent</span>
            <h3 style="font-size:1.0625rem; margin-top:0.75rem;">فريق الدعم</h3>
            <p style="color:#72787e; font-size:0.8125rem; margin-top:0.5rem;">مرّر المؤشر لرؤية سؤال حقيقي</p>
          </div>
          <div class="cgd-flip-face cgd-flip-back">
            <p style="font-size:0.8125rem; color:rgba(255,255,255,0.6); margin-bottom:0.5rem;">العميل يسأل:</p>
            <p style="font-size:0.9375rem; font-weight:600; margin-bottom:0.75rem;">"هل يمكنني استبدال هذا بمقاس مختلف؟"</p>
            <p style="font-size:0.8125rem; color:rgba(255,255,255,0.75); line-height:1.6;">يتحقق المساعد من مهلة الاستبدال والمخزون المتوفر، ثم يؤكد الاستبدال في رد واحد.</p>
          </div>
        </div>
      </div>
      <div class="cgd-flip" tabindex="0">
        <div class="cgd-flip-inner">
          <div class="cgd-flip-face cgd-flip-front">
            <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:28px;">trending_up</span>
            <h3 style="font-size:1.0625rem; margin-top:0.75rem;">فريق المبيعات</h3>
            <p style="color:#72787e; font-size:0.8125rem; margin-top:0.5rem;">مرّر المؤشر لرؤية سؤال حقيقي</p>
          </div>
          <div class="cgd-flip-face cgd-flip-back">
            <p style="font-size:0.8125rem; color:rgba(255,255,255,0.6); margin-bottom:0.5rem;">المندوب يسأل:</p>
