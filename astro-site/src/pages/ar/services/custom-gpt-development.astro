---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "ما هو مساعد الذكاء الاصطناعي المخصص بالضبط؟", answer: "مساعد الذكاء الاصطناعي المخصص نموذج لغوي مضبوط خصيصاً لعملكم. تحددون هدفه، وتزودونه بملفات المعرفة (مستنداتكم، وإجراءاتكم، ومعلومات منتجاتكم)، ويمكن اختيارياً ربطه بأنظمة خارجية عبر API. يتصرف وفق قواعدكم، ويعرف محتواكم، ويمكن مشاركته مع فريقكم أو عملائكم، دون أن يكتب فريقكم سطر كود واحد." },
  { question: "هل يستطيع مساعد الذكاء الاصطناعي الاتصال بأنظمتنا؟", answer: "نعم. نربط مساعدكم بواجهات API خارجية: نظام CRM، وقاعدة بياناتكم، وموقعكم، ونظام الدعم، أو أي نظام لديه API. هذا يعني أنه يستطيع البحث عن بيانات مباشرة، وإنشاء السجلات، وإرسال الرسائل، وتنفيذ الإجراءات، لا مجرد الإجابة عن الأسئلة." },
  { question: "من يستطيع الوصول إليه بعد بنائه؟", answer: "أنتم تختارون. نستطيع ضبطه للوصول الخاص (فقط من تدعونهم)، أو مشاركته عبر مساحة عمل فريقكم الداخلية، أو فتحه للعملاء. معظم عملائنا من الشركات يبدؤون بوصول داخلي فقط ثم يتوسعون." },
  { question: "هل يبقى محدّثاً بالمعلومات الجديدة؟", answer: "نبني سير عمل يحدّث قاعدة معرفة المساعد تلقائياً، فيعكس دائماً أحدث أسعاركم وسياساتكم ووثائقكم. وللبيانات المباشرة، نربطه ليسحب المعلومات الحية من أنظمتكم وقت كل محادثة." },
  { question: "ما هو ضمان ١٠٠٪؟", answer: "إذا لم تكونوا راضين عما نسلّمه، لا تدفعون شيئاً. هذا ليس تسويقاً، بل شروطنا المعتادة. لا نقبل إلا المشاريع التي نعرف أننا نستطيع تنفيذها، ولهذا لم نضطر أبداً لرد أي مبلغ." },
  { question: "كيف يختلف هذا عن استخدام أداة ذكاء اصطناعي عامة في العمل؟", answer: "أدوات الذكاء الاصطناعي العامة غير مضبوطة ولا تعرف شيئاً عن عملكم. أما مساعد الذكاء الاصطناعي المخصص فمدرَّب على منتجاتكم وسياساتكم ونبرتكم وسياقكم. يعطي إجابات ثابتة متوافقة مع قواعد عملكم، لا الإجابة المتوسطة التي تعلمها من الإنترنت. ويمكن تقييده أيضاً: لن يقدم نصائح خارج نطاقه، ولن يناقش المنافسين، ولن يقول ما يتعارض مع سياساتكم." },
  { question: "على أي منصات تستطيعون نشر المساعد؟", answer: "ننشره على واجهات الويب، ومنصات الفرق الداخلية، وتطبيقات المراسلة، ونوافذ الدردشة على المواقع، والتطبيقات المخصصة. يمكن أن يعمل مساعدكم على قناة واحدة أو عدة قنوات في وقت واحد. نبني الربط حسب المكان الذي يقضي فيه فريقكم أو عملاؤكم وقتهم فعلاً." },
  { question: "ماذا لو أردنا توسيع قدرات المساعد بعد الإطلاق؟", answer: "هذا شائع جداً. معظم العملاء يبدؤون بمساعد مركّز ويوسعون قدراته مع الوقت، بإضافة معرفة أكثر، أو أدوات جديدة، أو قنوات إضافية. البنية التي نبنيها مقسمة إلى وحدات، فتكون إضافة القدرات بعد الإطلاق عادةً سهلة ولا تتطلب إعادة البناء من الصفر." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_custom_gpt')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "description", step: "الخطوة ١", title: "الموجز والنطاق", description: "نحدد هدف المساعد، وجمهوره، والمعرفة التي يحتاجها لأداء عمله." },
  { icon: "upload_file", step: "الخطوة ٢", title: "البناء والتدريب", description: "نضبط أمر النظام، ونرفع ملفات المعرفة، ونعد أي اتصالات API، ونطبق قواعد علامتكم التجارية." },
  { icon: "science", step: "الخطوة ٣", title: "الاختبار والتحسين", description: "نشغّله على سيناريوهات حقيقية وحالات استثنائية وأسئلة مصممة لإرباكه، ثم نضبطه حتى يؤدي بالضبط كما هو مطلوب." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "النشر والتسليم", description: "ننشره لفريقكم أو عملائكم، وندرّب مسؤولي النظام لديكم على تحديثه، ونسلّمكم الملكية الكاملة." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="تطوير مساعدين ذكاء اصطناعي مخصصين للشركات في الإمارات"
  description="نبني مساعدين ذكاء اصطناعي مخصصين للشركات في الإمارات، مدرَّبين على منتجاتكم وقاعدة معرفتكم وسير عملكم. وكالة ذكاء اصطناعي في دبي تنشر علامتكم وبياناتكم."
  canonicalPath="/ar/services/custom-gpt-development"
  enPath="/services/custom-gpt-development"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=1400&q=80&auto=format&fit=crop", alt: "تطوير مساعدين ذكاء اصطناعي مخصصين للشركات في دبي والإمارات", position: "center 30%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تطوير ذكاء اصطناعي مخصص</div>
  <h1>عملكم. ذكاؤكم الاصطناعي. <span class="gradient-text">مبني حول بياناتكم.</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
    أدوات الذكاء الاصطناعي العامة لا تعرف منتجاتكم ولا نبرتكم ولا عملاءكم. نبني مساعدين ذكاء اصطناعي مخصصين يعرفونها، مدرَّبين على بياناتكم، ويحملون اسمكم، ومنشورين حيث يعمل فريقكم فعلاً.
  </p>
  <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_custom_gpt_hero" class="btn-primary">ابنوا ذكاءكم الاصطناعي المخصص</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما هو ممكن ↓</a>
  </div>

</PageHero>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "بياناتكم", caption: "مدرَّب على مستنداتكم وسياساتكم ومعرفتكم، لا على الإنترنت" },
      { value: "دون كود", caption: "نتولى كل شيء. فريقكم يستخدمه فقط، دون أي مهارات تقنية" },
      { value: "أي فريق", caption: "المبيعات، والدعم، والعمليات، والموارد البشرية، مبني لمن يحتاجه أكثر" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS A CUSTOM AI ASSISTANT -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="explain-heading" style="text-align:start; margin-bottom:1.5rem;">ما هو مساعد الذكاء الاصطناعي المخصص؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          مساعد الذكاء الاصطناعي المخصص نظام ذكاء اصطناعي محادثي مدرَّب تحديداً على بيانات عملكم ومضبوط ليتصرف وفق قواعدكم. يعرف منتجاتكم وأسعاركم وسياساتكم ونبرة تواصلكم. يعطي إجابات دقيقة بالنسبة لعملكم، لا إجابات عامة مستقاة من الإنترنت.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          الفرق الجوهري عن أدوات الذكاء الاصطناعي الجاهزة هو السياق. الأداة العامة تبدأ كل محادثة من الصفر: لا تعرف شركتكم ولا عملاءكم ولا تفاصيل قطاعكم. أما المساعد المخصص فيبدأ من معرفة عميقة بعملكم. قرأ وثائقكم، وتعلم تفاصيل منتجاتكم، وتلقى تعليمات حول كيفية التعامل مع المواقف التي يواجهها فريقكم فعلاً.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          حسب احتياجات عملكم، يمكن نشر مساعد الذكاء الاصطناعي المخصص كأداة داخلية لفريقكم، أو روبوت محادثة للعملاء على موقعكم أو واتساب، أو نسخة مختلطة تخدم الجمهورين بمستويات وصول مختلفة. يمكن أن يقتصر على الإجابة عن الأسئلة، أو يُربط بأنظمتكم عبر API ليبحث عن البيانات المباشرة، وينشئ السجلات، ويرسل الرسائل، وينفذ إجراءات أخرى نيابة عن المستخدمين. وكوكالة ذكاء اصطناعي في دبي تعمل مع الشركات في كل الإمارات، نتولى البناء بالكامل بأنفسنا، من البنية إلى النشر.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=900&q=80&auto=format&fit=crop" alt="شاشة مطوّر تعرض الكود وراء مساعد ذكاء اصطناعي مخصص" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">مساعدو الذكاء الاصطناعي المخصصون الذين نبنيهم</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع شائعة، وليست قائمة كاملة. كل واحد مدرَّب على محتواكم، ومضبوط وفق قواعدكم، ومربوط بأنظمتكم. إذا كانت فكرتكم مختلفة عن أي شيء هنا، ما زلنا نرغب في بنائها.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لدعم العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يتولى أسئلة المستوى الأول والثاني باستخدام وثائقكم الفعلية وأسئلتكم الشائعة وسياسات الإرجاع لديكم، دون إرسال العملاء إلى أداة ذكاء اصطناعي عامة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">مساعد مبيعات بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يعرف منتجاتكم وأسعاركم وأدلة التعامل مع الاعتراضات. يساعد فريق المبيعات في كتابة العروض، والتحضير للمكالمات، والرد على أسئلة العملاء المحتملين في ثوانٍ.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">school</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي للمعرفة الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">دليل شركتكم وإجراءاتها ووثائقها الداخلية، قابلة للبحث عبر محادثة. الموظفون الجدد يحصلون على إجابات فوراً. وكبار الموظفين يتوقفون عن الإجابة عن نفس الأسئلة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">draw</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لمحتوى العلامة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يكتب بصوتكم. مدرَّب على نصوصكم السابقة، ودليل أسلوبكم، وقواعد علامتكم. يولّد رسائل ومنشورات وإعلانات تبدو فعلاً كأنها منكم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">gavel</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي للشؤون القانونية والامتثال</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">مبني للقطاعات الخاضعة للتنظيم. يجيب عن الأسئلة حول السياسات الداخلية والعقود وإجراءات الامتثال، مع ضوابط حماية تمنعه من تقديم مشورة قانونية لا يجب أن يقدمها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">hub</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي مربوط عبر API</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يتجاوز المستندات. يسحب بيانات مباشرة من نظام CRM، ويتحقق من حالة الطلبات، وينشئ التذاكر، ويحدّث السجلات، كل ذلك من واجهة محادثة.</p>
      </div>
    </div>
  </div>
</section>

<!-- SEE IT IN ACTION -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="action-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="action-heading">شاهدوه أثناء العمل</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أسئلة حقيقية يتولاها المساعد لكل دور.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">support_agent</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">فريق الدعم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>العميل يسأل:</strong> "هل أستطيع استبدال هذا بمقاس مختلف؟"</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يتحقق المساعد من فترة الاستبدال والمخزون، ثم يؤكد الاستبدال في رد واحد.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">فريق المبيعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>المندوب يسأل:</strong> "ما أفضل رد لدينا على اعتراض سعر منافس؟"</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يسحب المساعد الرد المعتمد من دليل المبيعات ويكيّفه مع وضع العميل المحتمل بالضبط.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">school</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.75rem;">موظف جديد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.625rem;"><strong>الموظف الجديد يسأل:</strong> "كيف أقدّم مصروفاً لعميل للموافقة عليه؟"</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يشرح المساعد الخطوات بالضبط من دليلكم الداخلي، دون مقاطعة أي زميل خبير.</p>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="process-heading">من الموجز إلى ذكاء اصطناعي يعمل</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1200&q=80&auto=format&fit=crop" alt="فريق يتعاون على بناء مساعد ذكاء اصطناعي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
