<!-- BEFORE / AFTER (interactive toggle) -->
<section class="section" style="background:#e7eeff;" aria-labelledby="ba-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="ba-heading">المهمة نفسها، بأمر معاد صياغته</h2>
      <p>بدّل بين أمر أولي نموذجي والنسخة المُهندَسة التي سنستخدمها بدلاً منه.</p>
    </div>
    <div class="pe-ba-grid">
      <div style="border-radius:24px; overflow:hidden; box-shadow:0 24px 56px rgba(0,59,92,0.10); min-height:260px;">
        <img src="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1200&q=80&auto=format&fit=crop" alt="لقطة مقرّبة لنتائج اختبار الأوامر على شاشة مطوّر أثناء التحسين" loading="lazy" width="1200" height="800" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
      <div class="card" style="padding:2rem;">
        <div class="pe-ba-toggle" role="tablist" aria-label="مقارنة نسخ الأمر">
          <button class="pe-ba-btn is-active" role="tab" id="pe-tab-before" aria-selected="true" aria-controls="pe-panel-before" data-pe-toggle="before">قبل</button>
          <button class="pe-ba-btn" role="tab" id="pe-tab-after" aria-selected="false" aria-controls="pe-panel-after" data-pe-toggle="after">بعد</button>
        </div>
        <p style="color:#72787e; font-size:0.8125rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; margin:1.5rem 0 0.75rem;">المهمة: تلخيص تذكرة دعم</p>
        <div role="tabpanel" id="pe-panel-before" aria-labelledby="pe-tab-before" data-pe-panel="before">
          <p class="pe-ba-prompt">«لخّص هذه التذكرة.»</p>
          <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-top:1rem;">لا صيغة محددة، لا حد لطول النص، لا إشارة للأولوية. يتفاوت طول ونبرة المخرج في كل مرة، فلا يستطيع الوكلاء مسح الملخصات بسرعة.</p>
        </div>
        <div role="tabpanel" id="pe-panel-after" aria-labelledby="pe-tab-after" data-pe-panel="after" hidden>
          <p class="pe-ba-prompt">«لخّص تذكرة الدعم هذه في جملتين: اذكر مشكلة العميل، ثم النتيجة المطلوبة. صنّفها كـ"عاجلة" إذا ذكرت استرداد مبلغ، إلغاء، أو شكوى قانونية. استخدم لغة بسيطة، دون مصطلحات متخصصة.»</p>
          <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-top:1rem;">طول ثابت، بنية محددة، وقاعدة تصعيد واضحة. كل ملخص يُقرأ بنفس الطريقة، فيستطيع الوكلاء الفرز خلال ثوانٍ.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var toggles = document.querySelectorAll('[data-pe-toggle]');
  var panels = document.querySelectorAll('[data-pe-panel]');
  toggles.forEach(function (btn) {
    btn.addEventListener('click', function () {
      toggles.forEach(function (t) { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
      panels.forEach(function (p) { p.hidden = true; });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      var panel = document.querySelector('[data-pe-panel="' + btn.getAttribute('data-pe-toggle') + '"]');
      if (panel) panel.hidden = false;
    });
  });
})();
</script>

