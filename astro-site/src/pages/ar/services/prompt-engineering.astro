---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "كيف يبدو مشروع هندسة الأوامر فعلياً؟", answer: "يعتمد على نقطة انطلاقكم. للفرق التي تستخدم الذكاء الاصطناعي بكثافة، نبدأ بتدقيق الأوامر: نراجع أوامركم الحالية، ونحدد أين تتذبذب جودة المخرجات، ونعيد كتابة أسوأها. وللفرق التي تبني ميزات أو سير عمل بالذكاء الاصطناعي، ننضم لعملية التصميم مبكراً ونكتب أوامر النظام من الصفر. في الحالتين، تحصلون على مكتبة أوامر موثقة يسهل صيانتها وتحديثها." },
  { question: "مع أي نماذج ذكاء اصطناعي تعملون؟", answer: "نصمم الأوامر لكل نماذج الذكاء الاصطناعي الرئيسية، المغلقة منها ومفتوحة المصدر. لكل نموذج نقاط قوة وخصائص وأنماط كتابة أوامر مثالية مختلفة. نعرفها جميعاً ونصمم وفقها، فتحصلون على أفضل أداء من أي نموذج تستخدمونه." },
  { question: "كم تكلف الأوامر السيئة فعلياً؟", answer: "أكثر مما تدرك معظم الفرق. الأوامر السيئة تنتج مخرجات متذبذبة تتطلب تحريراً يدوياً، وهذا يلغي الهدف من استخدام الذكاء الاصطناعي أصلاً. كما تجعل النماذج تستهلك رموزاً أكثر من اللازم، فترتفع تكاليف API. وتخلق سلوكاً غير متوقع يضعف ثقة فريقكم بأدوات الذكاء الاصطناعي. مكتبة الأوامر المصممة جيداً تقلل وقت التحرير عادةً بنسبة ٦٠ إلى ٨٠٪ واستهلاك رموز API بنسبة ٢٠ إلى ٤٠٪." },
  { question: "هل تستطيعون كتابة أوامر لقطاعنا أو مجالنا تحديداً؟", answer: "نعم، وهنا تكون هندسة الأوامر المتخصصة أكثر قيمة. الأوامر العامة تنتج مخرجات عامة. ندرس مصطلحات قطاعكم، ومعايير النبرة لديكم، وقيود الامتثال، ومتطلبات تنسيق المخرجات، ثم نصمم أوامر تأخذها جميعاً في الاعتبار. القانون، والرعاية الصحية، والمالية، والعقارات، والتجارة الإلكترونية: عملنا فيها جميعاً." },
  { question: "هل تقدمون تحسيناً مستمراً؟", answer: "نعم. نماذج الذكاء الاصطناعي تتحدث باستمرار، والأمر الذي يعمل بشكل مثالي اليوم قد يحتاج تعديلاً بعد تحديث النموذج. نقدم عقوداً شهرية تغطي الاختبار المستمر، والتحسين مع تطور النماذج، ودعماً ذا أولوية عندما يتعطل شيء. معظم العملاء يجدون ذلك مفيداً بمجرد أن يروا التحسن في مخرجات أوامرهم." },
  { question: "كم يستغرق مشروع هندسة الأوامر؟", answer: "تدقيق الأوامر مع إعادة كتابتها لنظام قائم يستغرق عادةً أسبوعاً إلى أسبوعين. وبناء مكتبة أوامر كاملة من الصفر لمنتج أو سير عمل جديد بالذكاء الاصطناعي يستغرق ٢ إلى ٤ أسابيع حسب النطاق. معظم العملاء يلاحظون تحسناً قابلاً للقياس في جودة المخرجات خلال الأسبوع الأول من العمل بالأوامر المحسّنة. والعقود المستمرة شهرية، دون حد أدنى للمدة." },
  { question: "نستخدم أداة أو أداتين فقط للذكاء الاصطناعي. هل ما زال الأمر يستحق؟", answer: "غالباً نعم، خصوصاً إذا كانت هذه الأدوات موجهة للعملاء أو تنتج محتوى يحرره فريقكم بكثافة. العائد من هندسة الأوامر يتناسب مباشرة مع الوقت الذي يقضيه فريقكم في تصحيح مخرجات الذكاء الاصطناعي. إذا كنتم تقضون أكثر من بضع ساعات أسبوعياً في تحرير محتوى مولَّد بالذكاء الاصطناعي، يسترد الاستثمار تكلفته بسرعة. أمر نظام واحد مصمم جيداً لاستخدام موجه للعملاء يمكن أن يلغي ساعات من التصحيحات الأسبوعية." },
  { question: "هل تستطيعون مساعدتنا في بناء إرشادات داخلية لكتابة الأوامر حتى يكتب فريقنا أوامر أفضل بنفسه؟", answer: "نعم، وهذا جزء من كل مشروع. نسلّم مجموعة إرشادات موثقة لكتابة الأوامر خاصة بفريقكم وأدواتكم، تغطي البنية، وتحديد السياق، وتعليمات التنسيق، والأخطاء الشائعة التي يجب تجنبها. وننظم جلسة تدريب نشرح فيها المبادئ لفريقكم. الهدف أن يصبح فريقكم بعد العمل معنا أفضل بشكل ملموس في كتابة الأوامر وتحسينها بنفسه." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_prompt_engineering')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "التدقيق", description: "نراجع أوامركم وسير عملكم ومخرجاتكم الحالية، ونقيّم بالضبط ما هو معطل ولماذا." },
  { icon: "edit", step: "الخطوة ٢", title: "الهندسة", description: "نعيد كتابة أوامركم وهيكلتها وبناءها بأساليب هندسية مجرّبة مصممة لنموذجكم وحالة استخدامكم." },
  { icon: "science", step: "الخطوة ٣", title: "الاختبار والتحسين", description: "اختبارات A/B منظمة عبر سيناريوهات حقيقية. نقيس ونقارن ونحسّن حتى يصل الأداء إلى المستوى الذي نحدده معاً." },
  { icon: "library_books", step: "الخطوة ٤", title: "التسليم والتدريب", description: "تحصلون على مكتبة الأوامر كاملة، والتوثيق، وجلسة تدريب للفريق حتى تتمكنوا من صيانتها والبناء عليها بأنفسكم." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="هندسة الأوامر وتحسينها للشركات في الإمارات"
  description="الأوامر السيئة تكلفكم الوقت والمال والثقة بالذكاء الاصطناعي. وكالتنا في دبي تدقق الأوامر وتحسّنها لأي نموذج، لتحصل فرق الإمارات على مخرجات ثابتة."
  canonicalPath="/ar/services/prompt-engineering"
  enPath="/services/prompt-engineering"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<PageHero image={{ src: "https://images.pexels.com/photos/326522/pexels-photo-326522.jpeg", alt: "يدان تكتبان رسالة في تطبيق محادثة على حاسوب محمول" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>هندسة الأوامر</div>
  <h1>ذكاؤكم الاصطناعي جيد بقدر <span class="gradient-text">الأوامر التي تقف خلفه.</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
    معظم الفرق التي تستخدم الذكاء الاصطناعي تخسر جزءاً كبيراً من الأداء الممكن. المخرجات متذبذبة، والتحرير لا يتوقف، ولا أحد يعرف لماذا ينجح أحياناً ويفشل أحياناً أخرى. هذه مشكلة في هندسة الأوامر، ونحن نصلحها.
  </p>
  <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_prompt_eng_hero" class="btn-primary">احصلوا على تدقيق للأوامر</button>
    <a href="#what-we-do" class="btn-outline">شاهدوا ما يشمله العمل ↓</a>
  </div>

</PageHero>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "٦٠-٨٠٪", caption: "انخفاض في وقت التحرير اليدوي بعد التحسين" },
      { value: "٢٠-٤٠٪", caption: "انخفاض في استهلاك رموز API مع أوامر أقصر وأدق" },
      { value: "كل النماذج", caption: "كل نماذج الذكاء الاصطناعي الرئيسية. نعرف خصائصها ونصمم وفقها" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS PROMPT ENGINEERING -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="explain-heading" style="text-align:start; margin-bottom:1.5rem;">ما هي هندسة الأوامر؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          هندسة الأوامر هي تصميم التعليمات التي تعطونها لنموذج الذكاء الاصطناعي واختبارها وتحسينها، حتى ينتج باستمرار المخرجات التي تحتاجونها فعلاً. طريقة بناء الأمر، والسياق الذي يقدمه، والتنسيق الذي يطلبه، والأمثلة التي يتضمنها، كلها تؤثر بشكل قابل للقياس على جودة مخرجات الذكاء الاصطناعي وثباتها وكفاءة تكلفتها.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          معظم الشركات التي تستخدم الذكاء الاصطناعي تعمل بأوامر كُتبت على عجل، ولم تُختبر بشكل صحيح، ولم تُوثَّق أبداً. النتيجة مخرجات متذبذبة تتطلب تحريراً يدوياً مستمراً، واستهلاك مرتفع للرموز بسبب أوامر مطولة تملأ السياق دون داعٍ، وسلوك للذكاء الاصطناعي لا يمكن توقعه: ممتاز أحياناً، وخاطئ أحياناً، دون فهم واضح للسبب.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          هندسة الأوامر الاحترافية تتعامل مع الأوامر كأدوات دقيقة، لا كمسودات أولية. الأمر المصمم جيداً يحدد دور النموذج، ويضبط السياق بكفاءة، ويقيّد تنسيق المخرجات، ويتعامل مع الحالات الاستثنائية صراحةً، وقد اختُبر على مدخلات حقيقية للتحقق من أدائه. الفرق في جودة المخرجات بين أمر مكتوب على عجل وآخر مصمم هندسياً غالباً ما يكون كبيراً جداً، والتوفير في التكلفة من الأوامر الأدق حقيقي وقابل للقياس على نطاق واسع.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=900&q=80&auto=format&fit=crop" alt="تعليمات أوامر منظمة وكود على شاشة مطوّر" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE DO -->
<section id="what-we-do" class="section" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="services-heading">ما نقدمه في مشروع هندسة الأوامر</h2>
      <p style="color:#42474e; font-size:1.0625rem;">لا نكتفي بإعادة كتابة الأوامر. نبني نظاماً يستطيع فريقكم صيانته وتحسينه بنفسه.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1509228468518-180dd4864904?w=1200&q=80&auto=format&fit=crop" alt="معايير تقييم الأوامر مرسومة على لوح أبيض خلال جلسة تدقيق مع Lenoo AI" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">search</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تدقيق الأوامر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">نراجع كل أمر يستخدمه فريقكم حالياً، ونقيّمه من حيث الجودة والثبات، ونحدد الأخطاء المحددة التي تكلفكم الوقت والمال.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">edit</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تصميم أوامر النظام</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">في منتجات الذكاء الاصطناعي والوكلاء، أمر النظام هو الأساس. نكتب أوامر النظام ونختبرها لتحدد السلوك، وتفرض النبرة، وتمنع المخرجات التي لا تريدونها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">library_books</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">إنشاء مكتبة الأوامر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">مكتبة موثقة ومنظمة من الأوامر المختبرة لكل حالة استخدام لدى فريقكم. مكتوبة، ومرقّمة الإصدارات، وجاهزة للاستخدام. لا مزيد من المعرفة المحبوسة في رأس شخص واحد.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">science</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">اختبارات A/B والتقييم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">نجري اختبارات منظمة تقارن نسخ الأوامر عبر سيناريوهات حقيقية، ونقيس جودة المخرجات بشكل منهجي، ونختار الأفضل بناءً على البيانات، لا الحدس.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">school</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تدريب الفريق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">يتعلم فريقكم كيف يكتب الأوامر ويختبرها ويطوّرها بنفسه. ننقل المعرفة حتى لا تعتمدوا علينا في كل مرة يحتاج فيها شيء للتحديث.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">refresh</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تحسين مستمر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">النماذج تتحدث. واحتياجات العمل تتغير. نقدم عقوداً تحافظ على مكتبة أوامركم محدّثة ومختبرة ومحسّنة مع تطور مشهد الذكاء الاصطناعي.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHERE IT MATTERS MOST -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="usecases-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="usecases-heading">أين تُحدث هندسة الأوامر أكبر فرق</h2>
      <p style="color:#42474e; font-size:1.0625rem;">هذه نقاط البداية الأعلى أثراً، وليست قائمة كاملة بما نستطيع تحسينه. إذا لم تكن حالتكم هنا، تواصلوا معنا.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=1200&q=80&auto=format&fit=crop" alt="كتابة الأوامر وتحسينها على حاسوب محمول" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3>ذكاء اصطناعي لدعم العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">وكلاء الدعم الذين يعطون إجابات مختلفة لنفس السؤال يهدمون ثقة العملاء. نصمم أوامر تنتج ردوداً ثابتة ومتوافقة مع علامتكم التجارية في كل مرة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">draw</span></div>
        <h3>توليد المحتوى</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إذا كان المحتوى الذي يكتبه الذكاء الاصطناعي لديكم يبدو دائماً كأنه من كتابة آلة، فأوامركم لا تؤدي عملها. نصمم أوامر تنتج نصوصاً تبدو بشرية فعلاً وتطابق صوت علامتكم.</p>
      </div>
