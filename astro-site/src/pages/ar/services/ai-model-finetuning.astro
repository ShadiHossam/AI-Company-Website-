---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ProcessSteps from '../../../components/ProcessSteps.astro';
import StatStrip from '../../../components/StatStrip.astro';

const processSteps = [
  { icon: "dataset", step: "الخطوة 1", title: "جمع البيانات", description: "نُحدّد نطاق المهمة، نُحدّد مصادر بيانات التدريب، ونبني أو ننقّي مجموعة البيانات، مع التنظيف والتنسيق والتصنيف حسب الحاجة." },
  { icon: "model_training", step: "الخطوة 2", title: "التدريب المخصص", description: "نُشغّل عملية التدريب على بياناتك، مع مراقبة منحنيات الخسارة وتعديل المعاملات الفائقة لمنع الإفراط في التخصيص." },
  { icon: "science", step: "الخطوة 3", title: "التقييم", description: "نُقارن أداء النموذج المدرَّب مع النموذج الأساسي على بيانات اختبار محجوزة، لتشاهد بدقة مقدار التحسّن." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "النشر", description: "نُدمج نموذجك المدرَّب في منتجك أو سير عملك، مع توثيق ودعم بعد الإطلاق." },
];

const faqItems = [
  { question: "ما الفرق بين التدريب المخصص واستخدام الأوامر (Prompt)؟", answer: "الأمر (Prompt) يُخبر نموذجاً عاماً كيف يتصرف في موقف محدد. التدريب المخصص يُدرّب النموذج على مئات أو آلاف الأمثلة حتى يصبح هذا السلوك افتراضياً لديه، دون الحاجة لأي أمر. النتيجة استجابة أسرع، تكلفة أقل لكل طلب (لأن الأمر يصبح أقصر أو يُلغى تماماً)، واتساق أعلى بشكل ملحوظ في المخرجات. يستحق التدريب المخصص الاستثمار عندما يكون لديك استخدام عالي الحجم وتحتاج النموذج ليؤدي مهمة محددة بثبات، على نطاق واسع." },
  { question: "ما النماذج التي يمكنكم تدريبها؟", answer: "نُدرّب نماذج تأسيسية مملوكة ومفتوحة المصدر على حد سواء. النماذج المملوكة توفّر سهولة وتكلفة بنية تحتية أقل. النماذج مفتوحة المصدر يمكن تدريبها على بنيتك التحتية الخاصة، فتبقى بياناتك بالكامل داخل بيئتك. نوصي بالخيار الأنسب بناءً على حالة استخدامك وحساسية بياناتك ومتطلبات التكلفة." },
  { question: "كم من البيانات أحتاج لتدريب نموذج؟", answer: "يعتمد على المهمة. لمعظم استخدامات الأعمال (تصنيف المستندات، توليد ردود بصيغة محددة، أو الكتابة بنبرة العلامة التجارية بثبات)، يمكننا تحقيق نتائج قوية بـ200 إلى 500 مثال عالي الجودة. المهام الأكثر تعقيداً تستفيد من بيانات أكثر، لكن الجودة أهم بكثير من الكمية. نساعدك في بناء وتنقية مجموعة بيانات التدريب كجزء من المشروع." },
  { question: "هل بياناتنا آمنة أثناء عملية التدريب؟", answer: "نعم. تُستخدم بياناتك التدريبية حصرياً لتدريب نموذجك الخاص، ولا تُستخدم لتدريب أي نماذج مشتركة أو عامة. للشركات ذات السياسات الصارمة في التعامل مع البيانات، يمكننا تدريب نماذج مفتوحة المصدر على بنيتك السحابية الخاصة بحيث لا تغادر بياناتك بيئتك إطلاقاً. نناقش ونوثّق متطلبات التعامل مع بياناتك قبل مشاركة أي بيانات." },
  { question: "ماذا يشمل التسليم بعد تدريب النموذج؟", answer: "نُسلّمك النموذج المدرَّب مع نتائج تقييم توضّح أداءه مقارنة بالنموذج الأساسي، وثائق دمج لفريق المطورين لديك، ودعم لمدة 60 يوماً بعد الإطلاق. للمهام المستمرة، يمكننا إعادة التدريب على بيانات جديدة مع تطور احتياجاتك. تكلفة إعادة التدريب عادة أقل بكثير من المشروع الأولي." },
  { question: "هل يمكن تدريب نموذج على بيانات خاصة أو سرية؟", answer: "نعم، وهذا أحد الأسباب الرئيسية التي تدفع الشركات لاختيار التدريب المخصص بدلاً من مقاربات أخرى. للشركات ذات السياسات الصارمة في التعامل مع البيانات، يمكننا تدريب نماذج مفتوحة المصدر بالكامل على بنيتك السحابية الخاصة، فلا تغادر بياناتك بيئتك أبداً. أما للنماذج المملوكة، فتنطبق سياسات مزوّد الواجهة البرمجية في التعامل مع البيانات، ونستعرض هذه السياسات بالتفصيل قبل بدء المشروع لتتخذ قراراً مدروساً." },
  { question: "كم يستغرق مشروع التدريب المخصص من البداية للنهاية؟", answer: "مشروع التدريب المخصص المعتاد يستغرق 3 إلى 6 أسابيع من الانطلاق إلى نموذج منشور ومُقيَّم. التوزيع الزمني: أسبوع إلى أسبوعين لجمع البيانات وتحضيرها، أسبوع إلى أسبوعين لجولات التدريب والتقييم، وأسبوع للدمج والنشر. المشاريع التي تملك بيانات تدريب جيدة مسبقاً تتحرك أسرع. المشاريع التي تحتاج بناء مجموعة بيانات من الصفر تأخذ وقتاً أطول، لأن جودة البيانات تؤثر مباشرة على جودة النموذج." },
  { question: "ماذا لو لم يُلبِّ النموذج المدرَّب توقعاتنا؟", answer: "نحدّد مقاييس النجاح قبل بدء المشروع، فتكون هناك عتبة واضحة يجب تجاوزها. إذا لم تصل جولة التدريب الأولى لهذه العتبة، نُكرّر المحاولة: بيانات أكثر، بيانات مختلفة، تعديل المعاملات الفائقة، أو نموذج أساسي مختلف. لا نُسلّم نموذجاً لا يجتاز التقييم. فترة الدعم لمدة 60 يوماً بعد الإطلاق تغطي أيضاً مشاكل الأداء التي تظهر فقط عندما يبدأ النموذج بمعالجة بيانات إنتاج حقيقية." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "تدريب نماذج الذكاء الاصطناعي المخصص", "url": "https://lenooai.com/ar/services/ai-model-finetuning", "description": "نُدرّب النماذج التأسيسية على بياناتك الخاصة، فنقدّم أداء ذكاء اصطناعي ثابتاً ومخصصاً لمجالك على نطاق واسع.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "serviceType": "تدريب نماذج الذكاء الاصطناعي المخصص" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "تدريب نماذج الذكاء الاصطناعي المخصص", "item": "https://lenooai.com/ar/services/ai-model-finetuning" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];
---

<ArBaseLayout
  title="تدريب نماذج الذكاء الاصطناعي المخصص للشركات في الإمارات | Aegis AI"
  description="Aegis AI، وكالة الذكاء الاصطناعي في دبي، تُدرّب النماذج التأسيسية على بيانات شركتك الخاصة، فيتعلّم ذكاؤك الاصطناعي لغة عملك ويُنتج مخرجات ثابتة."
  canonicalPath="/ar/services/ai-model-finetuning"
  enPath="/services/ai-model-finetuning"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تدريب نماذج الذكاء الاصطناعي المخصص</div>
    <h1>توقف عن استخدام ذكاء اصطناعي عام. <span class="gradient-text">ابدأ باستخدام ذكائك الخاص.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      النماذج الجاهزة تعرف كل شيء عن الإنترنت ولا شيء عن شركتك. التدريب المخصص يُغيّر هذا. نُدرّب النماذج التأسيسية على بياناتك ونبرتك ومجالك، فيؤدي ذكاؤك الاصطناعي فعلاً كأنه ملكك.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_finetuning_hero" class="btn-primary">ناقش تدريب النموذج</button>
      <a href="#what-we-do" class="btn-outline">شاهد ما هو ممكن ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1400&q=80&auto=format&fit=crop" alt="ضبط نماذج الذكاء الاصطناعي وتدريب التعلم الآلي" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "200+", caption: "مثال تدريبي قد يكفي لنموذج مخصص قوي" },
      { value: "40–60%", caption: "انخفاض في تكلفة الاستدلال مقارنة باستخدام أوامر نظام طويلة" },
      { value: "بياناتك", caption: "لا تُستخدم أبداً لتدريب نماذج مشتركة. معزولة بالكامل لحسابك" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS FINE-TUNING -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هو تدريب نماذج الذكاء الاصطناعي المخصص؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          تدريب النموذج المخصص هو أخذ نموذج تأسيسي مُدرَّب مسبقاً وتدريبه أكثر على مجموعة بياناتك الخاصة، حتى يتعلّم الأنماط والمصطلحات والنبرة والسلوك الذي تحتاجه حالتك تحديداً. النتيجة نموذج يؤدي كأنه بُني لشركتك، لأنه فعلاً كذلك.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          تخيّل النموذج التأسيسي كموظف عام مثقف جداً: يعرف الكثير عن كل شيء، لكنه لم يعمل يوماً في مجالك ولم يقرأ مستندات شركتك. التدريب المخصص أشبه بإخضاع هذا الموظف لبرنامج تدريب مكثف باستخدام مئات الأمثلة من العمل الذي تحتاجه بالضبط. بعدها، لن يحتاج أمراً طويلاً ليُنتج المخرج الصحيح؛ هذا المخرج يصبح سلوكه الافتراضي.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=800&q=80&auto=format&fit=crop" alt="مهندسو تعلم آلي يُجهّزون بيانات تدريب لنموذج مُدرَّب مخصصاً لمستندات شركة إماراتية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      التدريب المخصص أكثر قيمة في المهام عالية الحجم والمتكررة حيث يهم الاتساق: كتابة محتوى بصوت علامتك التجارية، تصنيف المستندات حسب تصنيفك الخاص، استخراج حقول محددة من نوع مستنداتك، أو توليد ردود بأسلوب دعم عملائك. على نطاق واسع، النموذج المدرَّب مخصصاً أدق من نموذج عام مع أمر طويل، وعادة أرخص تشغيلاً، لأن الأمر يصبح أقصر أو يُلغى تماماً.
    </p>
  </div>
</section>

<!-- FINE-TUNING VS PROMPTING -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="vs-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="vs-heading">التدريب المخصص مقابل الأوامر: متى تستخدم كل منهما</h2>
      <p style="color:#42474e; font-size:1.0625rem;">كلاهما نهج صحيح. يعتمد الاختيار الأنسب على حجم الاستخدام، متطلبات الاتساق، وتوفّر البيانات.</p>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <div style="background:#fff; border:1px solid rgba(0,37,59,0.08); border-radius:16px; padding:1.75rem;">
        <h3 style="font-size:1rem; color:#00253b; margin-bottom:1rem;">استخدم الأوامر عندما:</h3>
        <ul style="color:#42474e; font-size:0.875rem; line-height:1.8; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">الحجم منخفض (أقل من بضعة آلاف طلب شهرياً)</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">المهام متنوعة ويصعب تقديم أمثلة ثابتة لها</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">ما زلت تُحدد شكل المخرج الجيد</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">سرعة النشر أهم من تحسين التكلفة على المدى الطويل</li>
          <li style="padding:0.375rem 0;">حالة الاستخدام تتغيّر باستمرار</li>
        </ul>
      </div>
      <div style="background:#fff; border:2px solid rgba(0,104,117,0.3); border-radius:16px; padding:1.75rem;">
        <h3 style="font-size:1rem; color:#006875; margin-bottom:1rem;">درّب النموذج مخصصاً عندما:</h3>
        <ul style="color:#42474e; font-size:0.875rem; line-height:1.8; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">الحجم مرتفع وتكلفة الأوامر مصدر قلق فعلي</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">الاتساق غير قابل للتفاوض (قانوني، امتثال، مواجهة للعميل)</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">مصطلحات مجالية محددة تتعامل معها النماذج العامة بضعف</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">النموذج يحتاج أن يتصرف بطريقة محددة في كل مرة، دون أوامر</li>
          <li style="padding:0.375rem 0;">لديك 200 مثال عالي الجودة على الأقل من المخرج المطلوب</li>
        </ul>
      </div>
    </div>

    <!-- OUTPUT COMPARISON DEMO -->
    <div class="ft-demo" data-ft-demo>
      <p style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#006875; margin-bottom:0.5rem;">جرّب الفرق</p>
      <p style="color:#00253b; font-weight:700; font-size:1.0625rem; margin-bottom:1.25rem;">نفس الطلب، نموذجان مختلفان. المهمة: "الرد على عميل يسأل لماذا تأخرت شحنته من مستودعنا في جبل علي."</p>
      <div class="tab-buttons" role="tablist" aria-label="مثال على مخرجات النموذج">
        <button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="generic">نموذج عام</button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="tuned">نموذج مدرَّب مخصصاً</button>
      </div>
      <div class="tab-panel" data-panel="generic">
        <p class="ft-output">"عزيزنا العميل، نعتذر بصدق عن أي إزعاج قد يكون سبّبه هذا الأمر. نؤكد لك أن فريقنا يعمل بجد لحل المشكلة. رضاكم يمثل أولويتنا القصوى، ونشكركم على صبركم وتفهمكم خلال هذه الفترة..."</p>
        <ul class="ft-notes">
          <li>احتاج أمر نظام طويلاً فقط للوصول لهذا الرد</li>
          <li>النبرة تتغيّر بين الردود؛ يبدو كأي شركة أخرى</li>
          <li>لا تفاصيل عن الطلب، لا سياق عن المستودع، لا خطوة تالية</li>
        </ul>
      </div>
      <div class="tab-panel hidden" data-panel="tuned">
        <p class="ft-output">"مرحباً عمر، غادرت شحنتك مستودع جبل علي هذا الصباح بعد انتهاء إجراء جمركي. موعد التسليم الجديد: يوم الخميس قبل الساعة السادسة مساءً، ويمكنك تتبعها عبر الرابط أدناه. بما أنها تأخرت، طبّقنا خصم طلبك القادم تلقائياً. إن احتجت أي شيء آخر، فقط رُدّ هنا."</p>
        <ul class="ft-notes">
          <li>لا حاجة لأمر نظام؛ هذه النبرة هي سلوك النموذج الافتراضي</li>
          <li>يطابق أفضل ردود فريقك البشري لأنه تدرّب عليها</li>
