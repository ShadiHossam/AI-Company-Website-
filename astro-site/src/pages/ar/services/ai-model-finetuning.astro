---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "ما الفرق بين الضبط الدقيق واستخدام الأوامر؟", answer: "الأمر يخبر نموذجاً عام الغرض كيف يتصرف في موقف محدد. أما الضبط الدقيق فيدرّب النموذج على مئات أو آلاف الأمثلة حتى يصبح هذا السلوك افتراضياً للنموذج، دون الحاجة لأي أمر. النتيجة استجابات أسرع، وتكلفة رموز أقل (أمر نظام أقصر أو دون أمر إطلاقاً)، ومخرجات أكثر ثباتاً بشكل ملحوظ. يستحق الضبط الدقيق العناء عندما تكون لديكم حالة استخدام بحجم كبير وتحتاجون أن ينفذ النموذج مهمة محددة بموثوقية وعلى نطاق واسع." },
  { question: "ما النماذج التي تستطيعون ضبطها؟", answer: "نضبط النماذج الأساسية المغلقة ومفتوحة المصدر على حد سواء. النماذج المغلقة توفر سهولة وعبئاً منخفضاً على البنية التحتية. والنماذج مفتوحة المصدر يمكن ضبطها على بنيتكم التحتية الخاصة، فتبقى بياناتكم بالكامل داخل بيئتكم. سنوصي بالخيار المناسب حسب حالة استخدامكم وحساسية بياناتكم ومتطلبات التكلفة." },
  { question: "كم أحتاج من البيانات لضبط نموذج؟", answer: "يعتمد على المهمة. في معظم حالات استخدام الأعمال (تصنيف المستندات، أو توليد ردود بتنسيق محدد، أو الكتابة بنبرة علامة تجارية ثابتة)، نستطيع تحقيق نتائج قوية بـ ٢٠٠ إلى ٥٠٠ مثال عالي الجودة. المهام الأكثر تعقيداً تستفيد من بيانات أكثر، لكن الجودة أهم بكثير من الكمية. نساعدكم في بناء مجموعة بيانات التدريب وتنقيحها كجزء من المشروع." },
  { question: "هل بياناتنا آمنة أثناء عملية الضبط الدقيق؟", answer: "نعم. بيانات التدريب لديكم تُستخدم فقط لضبط نموذجكم ولا تُستخدم لتدريب أي نماذج مشتركة أو عامة. وللمؤسسات ذات سياسات البيانات الصارمة، نستطيع ضبط نماذج مفتوحة المصدر على بنيتكم السحابية الخاصة فلا تغادر بياناتكم بيئتكم أبداً. نناقش متطلبات التعامل مع بياناتكم ونوثقها قبل مشاركة أي بيانات." },
  { question: "ماذا يشمل العمل بعد تدريب النموذج؟", answer: "نسلّم النموذج المضبوط مع نتائج تقييم توضح بالضبط أداءه مقارنة بالنموذج الأساسي، ووثائق ربط لمطوريكم، ودعماً لمدة ٦٠ يوماً. وللمهام المستمرة، نستطيع إعادة التدريب على بيانات جديدة مع تطور احتياجاتكم. وتكلفة إعادة التدريب عادةً أقل بكثير من المشروع الأول." },
  { question: "هل نستطيع ضبط نموذج على بيانات خاصة أو سرية؟", answer: "نعم، وهذا من الأسباب الرئيسية لاختيار الشركات للضبط الدقيق بدلاً من أساليب الذكاء الاصطناعي الأخرى. للمؤسسات ذات سياسات البيانات الصارمة، نستطيع ضبط نماذج مفتوحة المصدر بالكامل على بنيتكم السحابية الخاصة، فلا تغادر بياناتكم بيئتكم أبداً. أما النماذج المغلقة فتنطبق عليها سياسات مزود الخدمة في التعامل مع البيانات، ونشرحها بالتفصيل قبل بدء المشروع حتى تتخذوا قراراً مدروساً." },
  { question: "كم يستغرق مشروع الضبط الدقيق من البداية إلى النهاية؟", answer: "مشروع الضبط الدقيق النموذجي يستغرق ٣ إلى ٦ أسابيع من الانطلاق إلى نموذج منشور ومقيَّم. يتوزع الجدول الزمني كالتالي: أسبوع إلى أسبوعين لجمع البيانات وتجهيزها، وأسبوع إلى أسبوعين لجولات التدريب والتقييم، وأسبوع للربط والنشر. المشاريع التي تتوفر فيها بيانات تدريب جيدة مسبقاً تتحرك أسرع. والمشاريع التي تتطلب بناء مجموعة بيانات من الصفر تأخذ وقتاً أطول، لأن جودة البيانات تؤثر مباشرة على جودة النموذج." },
  { question: "ماذا يحدث إذا لم يرقَ النموذج المضبوط إلى توقعاتنا؟", answer: "نحدد مؤشرات النجاح قبل بدء المشروع، فيكون هناك معيار واضح يجب بلوغه. إذا لم تصل جولة التدريب الأولى إلى هذا المعيار، نكرر: بيانات أكثر، أو بيانات مختلفة، أو معاملات تدريب معدّلة، أو نموذج أساسي مختلف. لا نسلّم نموذجاً لم يجتز التقييم. وتغطي فترة الدعم لمدة ٦٠ يوماً بعد الإطلاق أيضاً مشكلات الأداء التي لا تظهر إلا عندما يعالج النموذج بيانات إنتاج حقيقية." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_finetuning')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "dataset", step: "الخطوة ١", title: "جمع البيانات", description: "نحدد نطاق المهمة، ونحدد مصادر بيانات التدريب، ونبني مجموعة البيانات أو ننقحها، مع التنظيف والتنسيق والتصنيف حسب الحاجة." },
  { icon: "model_training", step: "الخطوة ٢", title: "الضبط الدقيق", description: "نشغّل عملية التدريب ببياناتكم، ونراقب منحنيات الخطأ، ونعدّل معاملات التدريب لمنع الحفظ الزائد." },
  { icon: "science", step: "الخطوة ٣", title: "التقييم", description: "نقارن النموذج المضبوط بالنموذج الأساسي على بيانات اختبار منفصلة، فترون بالضبط مقدار التحسن." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "النشر", description: "ندمج نموذجكم المضبوط في منتجكم أو سير عملكم، مع التوثيق ودعم ما بعد الإطلاق." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="الضبط الدقيق لنماذج الذكاء الاصطناعي للشركات في الإمارات | Lenoo AI"
  description="نضبط النماذج الأساسية على بياناتكم ليعرف ذكاؤكم الاصطناعي عملكم ويقدم مخرجات ثابتة على نطاق واسع. وكالة ذكاء اصطناعي في دبي لشركات الإمارات."
  canonicalPath="/ar/services/ai-model-finetuning"
  enPath="/services/ai-model-finetuning"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<PageHero image={{ src: "https://images.pexels.com/photos/8442379/pexels-photo-8442379.jpeg", alt: "باحث يعمل على الحاسوب في مختبر" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الضبط الدقيق لنماذج الذكاء الاصطناعي</div>
  <h1>توقفوا عن استخدام ذكاء اصطناعي عام. <span class="gradient-text">ابدؤوا باستخدام ذكائكم الخاص.</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 2.5rem; line-height:1.8;">
    النماذج الجاهزة تعرف كل شيء عن الإنترنت ولا شيء عن عملكم. الضبط الدقيق يغيّر ذلك. ندرّب النماذج الأساسية على بياناتكم ونبرتكم ومجالكم، فيؤدي ذكاؤكم الاصطناعي فعلاً كأنه ملك لكم.
  </p>
  <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_finetuning_hero" class="btn-primary">ناقشوا الضبط الدقيق معنا</button>
    <a href="#what-we-do" class="btn-outline">شاهدوا ما هو ممكن ↓</a>
  </div>

</PageHero>

<!-- STATS BANNER -->
<div style="width:100%; overflow:hidden; position:relative;">
  <div style="width:100%; background:linear-gradient(135deg,#001e30,#00253b,#006875); padding:3.5rem 2rem; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <StatStrip stats={[
      { value: "+٢٠٠", caption: "مثال تدريب قد يكفي لنموذج مضبوط قوي" },
      { value: "٤٠-٦٠٪", caption: "انخفاض في تكلفة التشغيل مقارنة باستخدام أوامر نظام طويلة" },
      { value: "بياناتكم", caption: "لا تُستخدم أبداً لتدريب نماذج مشتركة. معزولة بالكامل في حسابكم" },
    ]} />
  </div>
  <div style="position:absolute; inset:0; background:linear-gradient(to top,#f9f9ff 0%,transparent 100%); pointer-events:none;"></div>
</div>

<!-- WHAT IS FINE-TUNING -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هو الضبط الدقيق لنماذج الذكاء الاصطناعي؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          الضبط الدقيق للذكاء الاصطناعي هو أخذ نموذج أساسي مدرَّب مسبقاً وتدريبه أكثر على مجموعة بياناتكم الخاصة، حتى يتعلم الأنماط والمصطلحات والنبرة والسلوك المحدد الذي تتطلبه حالة استخدامكم. النتيجة نموذج يؤدي كأنه بُني لعملكم، لأنه بُني له فعلاً.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          فكروا في النموذج الأساسي كشخص عام المعرفة بتعليم عالٍ: يعرف الكثير عن كل شيء لكنه لم يعمل أبداً في قطاعكم ولم يقرأ مستندات شركتكم. الضبط الدقيق يشبه إخضاعه لبرنامج تدريب عميق ومركّز باستخدام مئات الأمثلة على العمل الذي تحتاجونه بالضبط. بعد ذلك، لا يحتاج لأمر نظام طويل لإنتاج المخرجات الصحيحة، فهذه المخرجات تصبح سلوكه الافتراضي.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?w=800&q=80&auto=format&fit=crop" alt="مهندسو تعلم آلة يجهزون بيانات تدريب لنموذج مضبوط على مستندات شركة إماراتية" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      الضبط الدقيق أكثر قيمة في المهام المتكررة بحجم كبير حيث يهم الثبات: صياغة المحتوى بصوت علامتكم، وتصنيف المستندات وفق تصنيفاتكم، واستخراج حقول محددة من أنواع مستنداتكم، أو توليد ردود بأسلوب دعم العملاء لديكم. على نطاق واسع، يكون النموذج المضبوط أدق من نموذج عام بأمر طويل، وأرخص تشغيلاً عادةً، لأن أمر النظام يمكن أن يكون أقصر أو يُلغى تماماً.
    </p>
  </div>
</section>

<!-- FINE-TUNING VS PROMPTING -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="vs-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="vs-heading">الضبط الدقيق مقابل الأوامر: متى تستخدمون كلاً منهما</h2>
      <p style="color:#42474e; font-size:1.0625rem;">كلا النهجين صالح. الاختيار الصحيح يعتمد على حجم الاستخدام، ومتطلبات الثبات، وتوفر البيانات.</p>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <div style="background:#fff; border:1px solid rgba(0,37,59,0.08); border-radius:16px; padding:1.75rem;">
        <h3 style="font-size:1rem; color:#00253b; margin-bottom:1rem;">استخدموا الأوامر عندما:</h3>
        <ul style="color:#42474e; font-size:0.875rem; line-height:1.8; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">يكون الحجم منخفضاً (أقل من بضعة آلاف طلب شهرياً)</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">تكون المهام متنوعة ويصعب تقديم أمثلة ثابتة لها</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">ما زلتم تحددون كيف تبدو المخرجات الجيدة</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">تكون سرعة النشر أهم من تحسين التكلفة على المدى الطويل</li>
          <li style="padding:0.375rem 0;">تتغير حالة الاستخدام كثيراً</li>
        </ul>
      </div>
      <div style="background:#fff; border:2px solid rgba(0,104,117,0.3); border-radius:16px; padding:1.75rem;">
        <h3 style="font-size:1rem; color:#006875; margin-bottom:1rem;">اضبطوا النموذج عندما:</h3>
        <ul style="color:#42474e; font-size:0.875rem; line-height:1.8; list-style:none; padding:0; margin:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">يكون الحجم كبيراً وتكاليف الأوامر مصدر قلق حقيقي</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">يكون الثبات غير قابل للتفاوض (قانوني، امتثال، موجه للعملاء)</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">توجد مصطلحات متخصصة تتعامل معها النماذج العامة بشكل ضعيف</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07);">يحتاج النموذج أن يتصرف بطريقة محددة في كل مرة، دون أوامر</li>
          <li style="padding:0.375rem 0;">لديكم ٢٠٠ مثال عالي الجودة على الأقل للمخرجات المطلوبة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- TRY THE DIFFERENCE -->
<section class="section" aria-labelledby="difference-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="difference-heading">جرّبوا الفرق</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نفس الطلب، نموذجان. المهمة: "الرد على عميل يسأل لماذا تأخرت شحنته من مستودعنا في جبل علي."</p>
    </div>
    <div class="ft-demo">
      <div class="duo-grid">
        <div class="duo-card">
          <h3 style="font-size:1rem; color:#00253b; margin-bottom:1rem;">نموذج عام</h3>
          <p class="ft-output">"عزيزنا العميل، نعتذر بشدة عن أي إزعاج قد يكون حدث. نؤكد لكم أن فريقنا يعمل بجد لحل المسألة. رضاكم هو أولويتنا القصوى، ونشكركم على صبركم وتفهمكم خلال هذا الوقت..."</p>
          <ul class="ft-notes">
            <li>احتاج أمر نظام طويلاً فقط للوصول إلى هذا المستوى</li>
            <li>النبرة تتغير بين الردود، ويبدو مثل أي شركة أخرى</li>
            <li>لا تفاصيل للطلب، ولا سياق للمستودع، ولا خطوة تالية</li>
          </ul>
        </div>
        <div class="duo-card">
          <h3 style="font-size:1rem; color:#006875; margin-bottom:1rem;">نموذج مضبوط</h3>
          <p class="ft-output">"مرحباً عمر، غادر طلبك جبل علي صباح اليوم بعد انتهاء تعليق جمركي. موعد التسليم الجديد: الخميس قبل الساعة ٦ مساءً، ويمكنك تتبعه عبر الرابط أدناه. وبما أنه تأخر، طبّقنا خصم طلبك القادم تلقائياً. لأي شيء آخر، رد هنا فقط."</p>
          <ul class="ft-notes">
            <li>لا حاجة لأمر نظام، فهذه النبرة هي السلوك الافتراضي للنموذج</li>
            <li>يطابق أفضل ردود فريقكم البشري لأنه تدرّب عليها</li>
            <li>يعرف سياساتكم ومواقعكم وصوتكم</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE DO -->
<section id="what-we-do" class="section" aria-labelledby="use-cases-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="use-cases-heading">المهام التي يحقق فيها الضبط الدقيق أكبر قيمة</h2>
      <p style="color:#42474e; font-size:1.0625rem;">هذه أكثر حالات الاستخدام شيوعاً، وليست حدود ما نضبطه. يعمل الضبط الدقيق بشكل أفضل في المهام المتكررة بحجم كبير حيث يهم الثبات والدقة. إذا كانت مهمتكم مختلفة، أخبرونا بما تحاولون فعله.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
