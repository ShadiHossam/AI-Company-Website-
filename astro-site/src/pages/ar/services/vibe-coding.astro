---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "ما هو Vibe Coding بالضبط؟", answer: "Vibe Coding هو تطوير برمجيات مُسرَّع بالذكاء الاصطناعي. بدلاً من كتابة كل سطر يدوياً، يعمل المطورون مع الذكاء الاصطناعي كشريك برمجة باستخدام أحدث أدوات البرمجة بالذكاء الاصطناعي. النتيجة تسليم أسرع دون التضحية بالجودة." },
  { question: "هل الجودة بمستوى التطوير التقليدي؟", answer: "نعم، وغالباً أفضل. أدوات الذكاء الاصطناعي تكتشف أخطاء أكثر، وتقترح أنماطاً محسّنة، وتفرض الاتساق عبر قواعد الكود الكبيرة. نقرن الكود المولَّد بالذكاء الاصطناعي بمراجعة بشرية صارمة، واختبارات آلية، ودورات ضمان جودة. تحصلون على السرعة والجودة معاً." },
  { question: "ما أنواع المشاريع الأنسب لـ Vibe Coding؟", answer: "تطبيقات الويب، ومنتجات SaaS، والأدوات الداخلية، وواجهات API، ولوحات المعلومات، وتطبيقات الهاتف، والسكربتات. يعمل بشكل ممتاز خصوصاً في المنتجات الأولية حيث تهم سرعة الوصول للسوق، وفي تحديث قواعد الكود القديمة التي تحتاج إعادة كتابة بكفاءة." },
  { question: "هل تسلّمون الكود والتوثيق؟", answer: "نعم. تحصلون على ملكية كاملة لكل الكود والتوثيق وإعدادات البنية التحتية. لا نقيّدكم بنا. يشمل التسليم جولة تقنية حتى يستطيع فريقكم صيانة المنتج وتطويره باستقلالية." },
  { question: "هل يستطيع مطورونا الداخليون صيانة الكود بعد التسليم؟", answer: "نعم، وهذا شرط أساسي في طريقة بنائنا. نكتب كوداً نظيفاً ومنظماً مع توثيق. التطوير بمساعدة الذكاء الاصطناعي لا يعني كوداً فوضوياً، بل يعني إنتاجاً أسرع لنفس الكود النظيف الذي كان مطوروكم سيكتبونه بأنفسهم. ونعقد أيضاً جلسة جولة تقنية حتى يفهم فريقكم البنية قبل أن يتسلم الملكية." },
  { question: "كيف يعمل ادعاء السرعة المضاعفة ١٠ مرات عملياً؟", answer: "أدوات البرمجة بالذكاء الاصطناعي تسرّع بشكل كبير أكثر أجزاء التطوير استهلاكاً للوقت: كتابة الكود المتكرر، وتوليد الاختبارات، وبناء هياكل المكونات، وتنفيذ الأنماط المتكررة. يركز كبار المهندسين على البنية والمنطق والمراجعة. هذا المزيج ينتج بوتيرة مستحيلة مع التطوير اليدوي وحده. المشاريع الفعلية تختلف، لكن منتجاً أولياً في ٣ إلى ٥ أسابيع كان سيستغرق تقليدياً ٣ إلى ٥ أشهر توقع واقعي." },
  { question: "ما التقنيات التي تبنون بها؟", answer: "نعمل عبر أبرز التقنيات الحديثة: React وNext.js وVue وNode.js وPython وTypeScript وPostgreSQL وSupabase وغيرها. نوصي بالتقنيات المناسبة لمتطلباتكم تحديداً، آخذين في الاعتبار معرفة فريقكم الحالية، وبيئة النشر، واحتياجات الصيانة على المدى الطويل." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_vibe_coding')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "description", step: "الخطوة ١", title: "المواصفات والبنية", description: "نحدد نطاق المنتج، ونختار التقنيات، ونعدّ مواصفات تفصيلية توافقون عليها قبل كتابة سطر كود واحد." },
  { icon: "code", step: "الخطوة ٢", title: "البناء بالذكاء الاصطناعي", description: "نبني بأدوات الذكاء الاصطناعي بأقصى سرعة. كل سطر يراجعه كبار المهندسين من حيث الجودة والأمان." },
  { icon: "bug_report", step: "الخطوة ٣", title: "الاختبار والمراجعة", description: "اختبارات مولَّدة بالذكاء الاصطناعي + ضمان جودة يدوي + مراجعة فريقكم. لا شيء يُطلق دون اجتياز كل فحص." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "النشر والتسليم", description: "يُطلق المنتج. تسليم كامل للكود مع التوثيق وجولة تقنية لفريقكم، أينما كنتم في دبي أو باقي الإمارات." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="Vibe Coding للشركات في الإمارات: تطوير مُسرَّع بالذكاء الاصطناعي"
  description="أطلقوا البرمجيات أسرع بالتطوير المُسرَّع بالذكاء الاصطناعي. وكالتنا في دبي تبني منتجات للشركات في الإمارات دون التضحية بالجودة."
  canonicalPath="/ar/services/vibe-coding"
  enPath="/services/vibe-coding"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1400&q=80&auto=format&fit=crop", alt: "Vibe Coding وتطوير البرمجيات بمساعدة الذكاء الاصطناعي", position: "center 40%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>Vibe Coding</div>
  <h1>أطلقوا منتجاتكم أسرع ١٠ مرات <span class="gradient-text">بالتطوير المدعوم بالذكاء الاصطناعي.</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
    تطوير البرمجيات التقليدي بطيء. Vibe Coding يغيّر ذلك. نستخدم أحدث أدوات البرمجة بالذكاء الاصطناعي لبناء منتجكم أسرع، دون التهاون في الجودة أو الأمان أو قابلية الصيانة.
  </p>
  <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_vibe_hero" class="btn-primary">ناقشوا مشروعكم معنا</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>

</PageHero>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#003b5c,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "١٠×", caption: "أسرع من التطوير التقليدي في المتوسط، مقاساً عبر مشاريع عملائنا" },
      { value: "ملكية كاملة", caption: "للكود. تحصلون على كل شيء: الكود المصدري، والتوثيق، وإعدادات البنية التحتية، ودون أي تقييد" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS VIBE CODING -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="explain-heading" style="text-align:start; margin-bottom:1.5rem;">ما هو Vibe Coding؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          Vibe Coding أسلوب تطوير يستخدم فيه المهندسون الذكاء الاصطناعي كشريك برمجة فعّال طوال عملية البناء. بدلاً من كتابة كل سطر من الصفر، يصف المطورون ما يحتاجونه، ويراجعون ما يولّده الذكاء الاصطناعي ويحسّنونه، ويوجّهون قرارات البنية، ويركزون جهدهم على الأجزاء التي تتطلب خبرة حقيقية: الأمان، والأداء، ونمذجة البيانات، ومنطق الربط.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          ميزة السرعة حقيقية وقابلة للقياس. المهام التي تستهلك ٨٠٪ من وقت التطوير التقليدي، مثل بناء هياكل المكونات، وكتابة الاختبارات، وتوليد الكود المتكرر، وتنفيذ الأنماط القياسية، تُنجز في جزء صغير من الوقت بمساعدة الذكاء الاصطناعي. ويعيد كبار المهندسين توجيه ذلك الوقت نحو البنية وضبط الجودة، فتكون النتيجة كوداً أفضل في وقت أقل.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          هذا ليس ذكاءً اصطناعياً يكتب برمجياتكم دون إشراف. كل سطر يُنتج يمر بمراجعة بشرية من مهندسين يعرفون كيف يبدو الكود الجيد. وتجتاز المخرجات نفس معايير الاختبار الآلي وضمان الجودة المطبقة على أي منتج مطوَّر تقليدياً. ما يغيّره Vibe Coding هو نسبة الوقت المخصص لحل المشكلات الإبداعي مقابل التنفيذ المتكرر، وهذا التحول في النسبة هو ما يحقق تسليماً أسرع بكثير دون التضحية بالجودة.
        </p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=900&q=80&auto=format&fit=crop" alt="كود برمجي بمساعدة الذكاء الاصطناعي على شاشة مطوّر" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">ما تستطيعون إطلاقه مع Vibe Coding</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نقاط بداية شائعة. إذا كان في ذهنكم شيء مختلف، نبنيه أيضاً. من المنتجات الأولية إلى المنتجات الكاملة إلى تحديث الأنظمة القديمة. بناء سريع وصحيح في كل الحالات.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1200&q=80&auto=format&fit=crop" alt="مهندسة من Lenoo AI تعمل مع أدوات البرمجة بالذكاء الاصطناعي على عدة شاشات في دبي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">web</span></div>
        <h3>تطبيقات الويب ومنتجات SaaS</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تطبيقات ويب متكاملة مبنية بأطر حديثة، تُطلق أسرع من التطوير التقليدي دون التهاون في الجودة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">speed</span></div>
        <h3>النماذج الأولية السريعة والمنتجات الأولية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">لديكم فكرة؟ سنبني منتجاً أولياً يعمل بسرعة كافية لاختباره مع مستخدمين حقيقيين قبل أن تنفقوا ميزانية كبيرة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">dashboard</span></div>
        <h3>الأدوات الداخلية ولوحات الإدارة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">لوحات معلومات وواجهات إدارة وأدوات داخلية مخصصة تنفذ بالضبط ما يحتاجه فريقكم، دون تضخم برمجيات المؤسسات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">api</span></div>
        <h3>واجهات API والأنظمة الخلفية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">واجهات REST وGraphQL، وخدمات مصغّرة، ومسارات بيانات مبنية للتوسع، مع توثيق واختبارات مدمجة من اليوم الأول.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">transform</span></div>
        <h3>تحديث الكود القديم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">نستخدم الذكاء الاصطناعي لتحليل قواعد الكود القديمة وإعادة هيكلتها وتحديثها، فنتخلص من الديون التقنية ونقلل تكاليف الصيانة دون إعادة كتابة كاملة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3>حزم اختبارات مولَّدة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اختبارات وحدات وتكامل واختبارات شاملة يولّدها الذكاء الاصطناعي، فيُطلق كودكم بثقة ويبقى مستقراً مع نموه.</p>
      </div>
    </div>
  </div>
</section>

<!-- IS IT RIGHT FOR YOU -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="right-for-you-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="right-for-you-heading">هل Vibe Coding مناسب لمشروعكم؟</h2>
      <p style="color:#42474e; font-size:1.0625rem;">Vibe Coding هو النهج المناسب لمعظم مشاريع البرمجيات، لكنه مناسب بشكل خاص لحالات معينة.</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div style="background:#fff; border:1px solid rgba(0,104,117,0.2); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; color:#006875; margin-bottom:1rem;">مناسب جداً</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; margin:0; list-style:none; padding:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> تحتاجون منتجاً أولياً يُختبر بسرعة قبل الالتزام ببناء كامل</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> لديكم نطاق محدد وتريدون إطلاقه في جدول زمني ضيق</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> لديكم قاعدة كود قديمة تحتاج تحديثاً دون إعادة كتابة كاملة</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> الميزانية مهمة وتريدون أقصى إنتاج مقابل كل درهم تنفقونه</li>
          <li style="padding:0.375rem 0; display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> تريدون تغطية اختبارات شاملة مدمجة من اليوم الأول</li>
        </ul>
      </div>
      <div style="background:#fff; border:1px solid rgba(0,37,59,0.1); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; color:#42474e; margin-bottom:1rem;">يستحق النقاش أولاً</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; margin:0; list-style:none; padding:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">←</span> المتطلبات ما زالت قيد التحديد وقد تتغير كثيراً</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">←</span> المشروع يتطلب أجهزة متخصصة جداً أو أنظمة تعمل في الوقت الفعلي</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">←</span> متطلبات الامتثال تفرض منهجية تطوير أو سجل تدقيق محدداً</li>
          <li style="padding:0.375rem 0; display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">←</span> لديكم تفضيلات قوية لتقنيات محددة لم نعمل بها من قبل</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- TIMELINE COMPARISON -->
<section class="section" style="background:#fff;" aria-labelledby="timeline-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="timeline-heading">الفرق في الجدول الزمني</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نفس نطاق المنتج الأولي، بطريقتين للبناء.</p>
    </div>
    <div class="bento-grid bento-grid-2">
      <div class="value-card">
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:1rem;">التطوير التقليدي</h3>
        <div class="vc-week-row"><span class="vc-week-tag">الأسابيع ١-٣</span><span>المتطلبات، والبنية، واعتماد التصميم</span></div>
