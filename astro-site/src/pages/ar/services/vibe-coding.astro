---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "ما هو فايب كودينج بالضبط؟", answer: "فايب كودينج هو تطوير برمجيات مُسرّع بالذكاء الاصطناعي. بدلاً من كتابة كل سطر يدوياً، يعمل المطورون مع الذكاء الاصطناعي كمبرمج مساعد باستخدام أحدث أدوات البرمجة بالذكاء الاصطناعي. النتيجة تسليم أسرع دون التضحية بالجودة." },
  { question: "هل الجودة بنفس مستوى التطوير التقليدي؟", answer: "نعم، وغالباً أفضل. أدوات الذكاء الاصطناعي تكتشف أخطاء أكثر، تقترح أنماطاً محسّنة، وتفرض اتساقاً عبر قواعد الكود الكبيرة. نُقرن الكود المُولّد بالذكاء الاصطناعي بمراجعة بشرية دقيقة، اختبارات آلية، ودورات ضمان جودة. تحصل على السرعة والجودة معاً." },
  { question: "ما أنواع المشاريع الأنسب لفايب كودينج؟", answer: "تطبيقات الويب، منتجات SaaS، الأدوات الداخلية، واجهات برمجية، لوحات تحكم، تطبيقات جوال، والسكربتات. يعمل بشكل ممتاز خاصة للنسخ الأولية (MVP) حيث تُهم سرعة الوصول للسوق، ولتحديث الأكواد القديمة التي تحتاج إعادة كتابة بكفاءة." },
  { question: "هل تُسلّموننا الكود والتوثيق؟", answer: "نعم. تحصل على ملكية كاملة لكل الكود والتوثيق وإعدادات البنية التحتية. لا نُقيّدك بأي التزام. يشمل التسليم جلسة شرح تقني ليتمكن فريقك من صيانة المنتج وتوسيعه باستقلالية." },
  { question: "هل يمكن لمطورينا الداخليين صيانة الكود بعد التسليم؟", answer: "نعم، هذا شرط أساسي في طريقة بنائنا. نكتب كوداً نظيفاً ومنظماً جيداً مع توثيق كامل. التطوير بمساعدة الذكاء الاصطناعي لا يعني كوداً فوضوياً؛ بل يعني إنتاجاً أسرع لنفس الكود النظيف الذي كان مطوروك سيكتبونه بأنفسهم. نعقد أيضاً جلسة شرح تقني ليفهم فريقك البنية المعمارية قبل تسلّم الملكية." },
  { question: "كيف تتحقق سرعة الـ10 أضعاف عملياً؟", answer: "أدوات البرمجة بالذكاء الاصطناعي تُسرّع بشكل كبير الأجزاء الأكثر استهلاكاً للوقت في التطوير: كتابة الكود المتكرر، توليد الاختبارات، بناء هيكلية المكونات، والتعامل مع أنماط التنفيذ المتكررة. يركّز المهندسون كبار الخبرة على البنية المعمارية والمنطق والمراجعة. هذا المزيج يُنتج وتيرة عمل يستحيل تحقيقها بالتطوير اليدوي وحده. تختلف المشاريع الحقيقية، لكن نسخة أولية تستغرق 3-5 أسابيع، بينما كانت تستغرق تقليدياً 3-5 أشهر، هو توقع واقعي." },
  { question: "ما التقنيات التي تبنون بها؟", answer: "نعمل عبر التقنيات الحديثة الرئيسية: React، وNext.js، وVue، وNode.js، وPython، وTypeScript، وPostgreSQL، وSupabase، وغيرها. نُوصي بالتقنية المناسبة لمتطلباتك المحددة، مع مراعاة معرفة فريقك الحالية، بيئة النشر، واحتياجات الصيانة طويلة المدى." },
];

const processSteps = [
  { icon: "description", step: "الخطوة 1", title: "المواصفات والبنية المعمارية", description: "نُحدد نطاق المنتج، نختار التقنيات، ونُعدّ مواصفات تفصيلية تُوافق عليها قبل كتابة أي سطر كود." },
  { icon: "code", step: "الخطوة 2", title: "بناء مدعوم بالذكاء الاصطناعي", description: "نبني باستخدام أدوات الذكاء الاصطناعي بأقصى سرعة. كل سطر كود تتم مراجعته من قبل مهندسين متمرسين للتأكد من الجودة والأمان." },
  { icon: "bug_report", step: "الخطوة 3", title: "الاختبار والمراجعة", description: "اختبارات مُولّدة بالذكاء الاصطناعي + فحص جودة يدوي + مراجعة فريقك. لا شيء يُطلق دون اجتياز كل الفحوصات." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والتسليم", description: "المنتج يُطلق فعلياً. تسليم كامل للكود مع التوثيق وجلسة شرح تقني لفريقك، أينما كنتم في دبي أو باقي الإمارات." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "فايب كودينج", "url": "https://lenooai.com/ar/services/vibe-coding", "description": "تطوير برمجيات مُسرّع بالذكاء الاصطناعي: تطبيقات ويب، منتجات SaaS، واجهات برمجية، وأدوات داخلية، تُسلَّم بسرعة 10 أضعاف باستخدام أحدث أدوات البرمجة بالذكاء الاصطناعي.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "serviceType": "تطوير البرمجيات" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "فايب كودينج", "item": "https://lenooai.com/ar/services/vibe-coding" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="فايب كودينج لشركات الإمارات: تطوير مُسرّع بالذكاء الاصطناعي | Aegis AI"
  description="أطلق برمجياتك أسرع بتطوير مُسرّع بالذكاء الاصطناعي. وكالتنا للذكاء الاصطناعي في دبي تبني منتجات لشركات الإمارات دون التضحية بالجودة."
  canonicalPath="/ar/services/vibe-coding"
  enPath="/services/vibe-coding"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>فايب كودينج</div>
    <h1>أطلق منتجك <span class="gradient-text">أسرع بـ10 أضعاف بتطوير مدعوم بالذكاء الاصطناعي.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      التطوير التقليدي للبرمجيات بطيء. فايب كودينج يُغيّر ذلك. نستخدم أحدث أدوات البرمجة بالذكاء الاصطناعي لبناء منتجك بشكل أسرع، دون التضحية بالجودة أو الأمان أو قابلية الصيانة.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_vibe_hero" class="btn-primary">ناقش مشروعك</button>
      <a href="#what-we-build" class="btn-outline">اكتشف ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1400&q=80&auto=format&fit=crop" alt="فايب كودينج وتطوير برمجيات بمساعدة الذكاء الاصطناعي" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#003b5c,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "10×", caption: "أسرع من التطوير التقليدي في المتوسط، مقاساً عبر مشاريع عملائنا" },
      { value: "ملكية كاملة", caption: "للكود المصدري. تحصل على كل شيء: الكود، التوثيق، إعدادات البنية التحتية، وبدون أي قيود" },
      { value: "100%", caption: "ضمان استرداد إذا لم تكن راضياً عمّا نُسلّمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS VIBE CODING -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما هو فايب كودينج؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        فايب كودينج هو منهج تطوير يستخدم فيه المهندسون الذكاء الاصطناعي كمبرمج مساعد نشط طوال عملية البناء بأكملها. بدلاً من كتابة كل سطر من الصفر، يصف المطورون ما يحتاجونه، يراجعون ويُحسّنون ما يُولّده الذكاء الاصطناعي، يوجّهون قرارات البنية المعمارية، ويُركّزون طاقتهم على الأجزاء التي تتطلب خبرة حقيقية: الأمان، الأداء، نمذجة البيانات، ومنطق التكامل.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        ميزة السرعة حقيقية وقابلة للقياس. المهام التي تستهلك 80% من وقت التطوير التقليدي، مثل بناء هيكلية المكونات، كتابة الاختبارات، توليد الكود المتكرر، وتنفيذ الأنماط القياسية، تحدث في جزء صغير من الوقت بمساعدة الذكاء الاصطناعي. يُعيد المهندسون كبار الخبرة توجيه ذلك الوقت نحو البنية المعمارية ومراقبة الجودة، مما يُنتج كوداً أفضل في وقت أقل.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذا ليس ذكاءً اصطناعياً يكتب برمجياتك دون إشراف. كل سطر يُنتَج يمر بمراجعة بشرية من مهندسين يعرفون شكل الكود الجيد. المخرجات تجتاز نفس معايير الاختبار الآلي وضمان الجودة التي يجتازها أي منتج مُطوَّر بالطريقة التقليدية. ما يُغيّره فايب كودينج هو نسبة الوقت المُخصص لحل المشكلات الإبداعي مقابل التنفيذ المتكرر، وهذا التغيّر في النسبة هو ما يُنتج تسليماً أسرع بشكل كبير دون التضحية بالجودة.
      </p>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">ما الذي يمكنك إطلاقه بفايب كودينج</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نقاط بداية شائعة. إذا كان لديك شيء مختلف في ذهنك، نبنيه أيضاً. من النسخ الأولية إلى المنتجات الكاملة إلى تحديث الأنظمة القديمة. يُبنى بسرعة، ويُبنى بشكل صحيح في كل الحالات.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1200&q=80&auto=format&fit=crop" alt="مهندس من Aegis AI يعمل مع أدوات البرمجة بالذكاء الاصطناعي على شاشات متعددة في دبي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="builds-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">web</span></div>
        <h3>تطبيقات الويب ومنتجات SaaS</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تطبيقات ويب متكاملة مبنية بأطر عمل حديثة، تُسلَّم أسرع من التطوير التقليدي دون التضحية بالجودة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">speed</span></div>
        <h3>نماذج أولية سريعة ونسخ MVP</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">لديك فكرة؟ نبني نسخة أولية عاملة بسرعة كافية لاختبارها مع مستخدمين حقيقيين قبل إنفاق ميزانية كبيرة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">dashboard</span></div>
        <h3>أدوات داخلية ولوحات إدارة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">لوحات تحكم مخصصة، واجهات إدارة، وأدوات داخلية تفعل بالضبط ما يحتاجه فريقك، دون تضخم برمجيات المؤسسات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">api</span></div>
        <h3>واجهات برمجية وأنظمة خلفية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">واجهات برمجية من نوع RESTful وGraphQL، خدمات مصغّرة، وخطوط بيانات مبنية للتوسّع، مع توثيق واختبارات مدمجة منذ اليوم الأول.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">transform</span></div>
        <h3>تحديث الأكواد القديمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">نستخدم الذكاء الاصطناعي لتحليل وإعادة هيكلة وتحديث الأكواد القديمة، للتخلص من الديون التقنية وخفض تكاليف الصيانة دون الحاجة لإعادة كتابة كاملة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3>مجموعات اختبار مُولّدة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اختبارات وحدة وتكامل واختبارات شاملة (end-to-end) مُولّدة بالذكاء الاصطناعي، لتُسلَّم قاعدة الكود بثقة وتبقى مستقرة مع نموّها.</p>
      </div>
    </div>
  </div>
</section>

<!-- IS IT RIGHT FOR YOU -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="right-for-you-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="right-for-you-heading">هل فايب كودينج مناسب لمشروعك؟</h2>
      <p style="color:#42474e; font-size:1.0625rem;">فايب كودينج هو النهج الصحيح لمعظم مشاريع البرمجيات، لكنه مناسب بشكل خاص لحالات معينة.</p>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
      <div style="background:#fff; border:1px solid rgba(0,104,117,0.2); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#006875; margin-bottom:1rem;">مناسب تماماً</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; margin:0; list-style:none; padding:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> تحتاج نسخة أولية يتم التحقق منها بسرعة قبل الالتزام ببناء كامل</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> لديك نطاق عمل محدد وتريد تسليمه ضمن جدول زمني ضيق</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> لديك كود قديم يحتاج تحديثاً دون إعادة كتابة كاملة</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> الميزانية مهمة وتريد أقصى نتيجة مقابل كل دولار يُنفق</li>
          <li style="padding:0.375rem 0; display:flex; gap:0.625rem;"><span style="color:#006875; flex-shrink:0;">✓</span> تريد تغطية اختبارات شاملة منذ اليوم الأول</li>
        </ul>
      </div>
      <div style="background:#fff; border:1px solid rgba(0,37,59,0.1); border-radius:16px; padding:1.75rem;">
        <p style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#42474e; margin-bottom:1rem;">يستحق النقاش أولاً</p>
        <ul style="color:#42474e; font-size:0.9rem; line-height:1.9; margin:0; list-style:none; padding:0;">
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> المتطلبات لا تزال قيد التحديد وقد تتغير بشكل متكرر</li>
          <li style="padding:0.375rem 0; border-bottom:1px solid rgba(0,37,59,0.07); display:flex; gap:0.625rem;"><span style="color:#42474e; flex-shrink:0;">→</span> يتطلب المشروع عتاداً متخصصاً جداً أو أنظمة زمن حقيقي</li>
