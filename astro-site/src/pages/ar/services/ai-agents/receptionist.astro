---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل يبدو موظف الاستقبال بالذكاء الاصطناعي آلياً فعلياً؟", answer: "نماذج الصوت الحالية تبدو أكثر طبيعية بكثير من قوائم IVR التي يربطها معظم الناس بأنظمة الهاتف الآلية. لن يكون مطابقاً تماماً لشخص في كل مكالمة، ولن ندّعي عكس ذلك. ما يفعله بموثوقية هو إجراء محادثة مباشرة، التحقق من التوفر، أخذ رسالة، الإجابة عن سؤال شائع، دون أن يشعر المتصل بأنه عالق في شجرة هاتفية." },
  { question: "ماذا يحدث عندما لا يستطيع الإجابة عن سؤال متصل؟", answer: "يحوّل لشخص، مع سياق. بدلاً من التخمين أو تدوير المتصل عبر خيارات قائمة، يدرك موظف الاستقبال متى يقع طلب خارج نطاقه المحدد ويحوّله لفريقكم، مع ملخص قصير لما قاله المتصل أصلاً فلا يضطر لتكرار نفسه من الصفر." },
  { question: "هل يعمل مع رقم هاتفنا الحالي؟", answer: "في معظم الحالات، نعم. عادة نحوّل رقم عملكم الحالي لموظف الاستقبال بالذكاء الاصطناعي، أو نُعِدّه للإجابة على المكالمات الفائضة وخارج ساعات العمل بينما يتعامل فريقكم مع الباقي، فلا تضطرون لنشر رقم جديد، تحديث موقعكم، أو إعادة طباعة أي شيء." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "موظف الاستقبال بالذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-agents/receptionist",
    "description": "موظف استقبال بالذكاء الاصطناعي للشركات الإماراتية يجيب على كل مكالمة، يوجّهها، يحجز مواعيد، ويأخذ رسائل مفصلة، بالعربية والإنجليزية، دون توظيف أحد."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "وكلاء الذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-agents" },
      { "@type": "ListItem", "position": 3, "name": "موظف الاستقبال", "item": "https://lenooai.com/ar/services/ai-agents/receptionist" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "موظف الاستقبال بالذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/services/ai-agents/receptionist",
    "description": "موظف استقبال بالذكاء الاصطناعي يجيب على كل مكالمة، يوجّهها، يحجز مواعيد، ويأخذ رسائل مفصلة، بالعربية والإنجليزية.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Voice Agent Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="موظف الاستقبال بالذكاء الاصطناعي: الإجابة على كل مكالمة دون توظيف أحد | Lenoo AI"
  description="موظف استقبال بالذكاء الاصطناعي للشركات الإماراتية يجيب على كل مكالمة، يحجز مواعيد، يأخذ رسائل، ويتحدث بالعربية والإنجليزية، دون توظيف أحد."
  canonicalPath="/ar/services/ai-agents/receptionist"
  enPath="/services/ai-agents/receptionist"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-agents" style="color:inherit;text-decoration:none;opacity:0.65;">وكلاء الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>موظف الاستقبال</div>
    <h1>موظف الاستقبال بالذكاء الاصطناعي<br><span class="gradient-text">الإجابة على كل مكالمة، دون توظيف مطلوب</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">كل مكالمة لا يستطيع فريقكم الوصول إليها هي عميل يجرّب العمل التالي في القائمة. موظف استقبال بالذكاء الاصطناعي يجيب، يوجّه، يحجز، ويأخذ رسائل، بالعربية والإنجليزية، عند كل رنين، في أي ساعة.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai-agents-receptionist_hero" class="btn-primary">استمعوا إليه يجيب على مكالمة حقيقية</button>
      <a href="#what-it-does" class="btn-outline">شاهدوا ما يفعله ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=1600&q=80&auto=format&fit=crop" alt="هاتف استقبال يرن دون إجابة في مكتب إماراتي مزدحم" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٢٤/٧", caption: "تغطية، بما في ذلك خارج ساعات العمل والعطلات الرسمية" },
      { value: "٢", caption: "لغتان يتعامل معهما نفس موظف الاستقبال: العربية والإنجليزية" },
      { value: "٠", caption: "مكالمات تُرسَل للبريد الصوتي لأن الخط مشغول" },
    ]} />
  </div>
</div>

<!-- THE CALL YOU'RE MISSING -->
<section class="section" aria-labelledby="missing-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="missing-heading" style="margin-bottom:1.5rem;">المكالمة التي يفوّتها فريقكم الآن</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تكلفة المكالمة الفائتة أكبر مما تبدو.</strong> المتصل الذي يصل لنغمة انشغال، رنين دون رد، أو بريد صوتي نادراً ما يعاود الاتصال. في معظم الأحيان، يتصل بالعمل التالي في قائمته بدلاً من ذلك، ولا تكتشفون أبداً أنكم فقدتم ذلك العميل. اضربوا هذا بكل مكالمة لا يستطيع استقبالكم الوصول إليها خلال الغداء، عصر مزدحم، أو الساعتين بعد الإغلاق، والإيرادات الفائتة تتراكم بصمت في خلفية عمل يبدو صحياً في كل شيء آخر.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>توظيف موظف استقبال بدوام كامل لتغطيتها لا يحل المشكلة كلياً أيضاً.</strong> موظف استقبال واحد لا يزال لديه استراحة غداء، يوم مرضي، ومناوبة تنتهي الساعة السادسة، وخط واحد يستطيع التعامل مع متصل واحد فقط في كل مرة. حجم مكالمات الإمارات ثنائي اللغة، مما يعني أن موظف الاستقبال الذي توظفونه يجب أن يكون طليقاً فعلياً في العربية والإنجليزية معاً، في نفس الساعات التي يتصل فيها عملاؤكم فعلياً، وهو نطاق توظيف أضيق مما يبدو.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=800&q=80&auto=format&fit=crop" alt="مكتب استقبال بهاتف دون رد في المقدمة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT IT ACTUALLY DOES -->
<section id="what-it-does" class="section" style="background:#e7eeff;" aria-labelledby="does-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="does-heading">ما يفعله موظف الاستقبال بالذكاء الاصطناعي فعلياً</h2>
      <p>ليس بريداً صوتياً بآداب أفضل. موظف استقبال يتخذ إجراءً حقيقياً في كل مكالمة.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">call_split</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">يجيب ويوجّه المكالمات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يرد عند الرنة الأولى، يفهم ما يحتاجه المتصل، ويوجّه للقسم أو الشخص الصحيح، أو يتعامل مع الطلب بنفسه إذا كان روتينياً.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">يحجز المواعيد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">يتحقق من التوفر الفعلي مقابل تقويمكم، يحجز الموعد الذي يريده المتصل، ويرسل تأكيداً، دون أن يتعامل شخص مع التقويم في منتصف المكالمة.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">note_alt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">يأخذ رسائل بسياق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الرسالة لا تقول فقط "اتصل أحدهم". تلتقط من اتصل، لماذا، ماذا يحتاج، وكم هو ملّح، فيستطيع فريقكم إعطاء الأولوية بدلاً من التخمين من اسم ورقم معاودة اتصال.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">quiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">يتعامل مع الأسئلة الشائعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">ساعات العمل، الموقع، أساسيات التسعير، مواقف السيارات، أياً كان ما يجيب عنه استقبالكم مراراً. يُجاب فوراً، محرراً الموظفين من نفس الأسئلة الخمسة طوال اليوم.</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">يصعّد لبشري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أي شيء ملّح فعلياً، حساس، أو خارج نطاقه يُحوَّل فوراً، مع ملخص لما قاله المتصل أصلاً، فلا يضطر أحد للبدء من جديد.</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">ثنائي اللغة، مُختبَر مقابل سيناريوهات مكالماتكم الحقيقية، ومتصل بتقويمكم ونظام CRM قبل أن يتلقى مكالمة حية.</p>
      <button onclick="openModal(this)" data-source="ar_ai-agents-receptionist_mid" class="btn-primary">استمعوا إليه يجيب على مكالمة حقيقية</button>
    </div>
  </div>
</section>

<!-- VOICE NOT JUST CHAT -->
<section class="section" aria-labelledby="voice-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="voice-heading" style="margin-bottom:1.5rem;">صوت، لا محادثة نصية فقط: لماذا لا يزال الهاتف يهم هنا</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        من المغري افتراض أن كل تفاعل عميل انتقل للمحادثة النصية وواتساب، ولكثير من الأسئلة الروتينية هذا صحيح. لكن الهاتف لم يختفِ للحظات الأكثر أهمية: شخص يريد التحدث حول مشكلة عاجلة، متصل لأول مرة يقيّم إن كان يثق بعملكم، أو عميل أكبر سناً يفضّل الاتصال ببساطة. العيادات، أعمال الخدمات، وأي من يتعامل مع حجوزات أو حالات طوارئ لا يزالون يحصلون على تدفق ثابت من المكالمات لا يراه بوت محادثة أبداً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذه بالضبط الفجوة التي يسدها موظف الاستقبال بالذكاء الاصطناعي. لا يستبدل بوت واتساب أو محادثة موقعكم، بل يغطي القناة التي لا تستطيع تلك الأدوات رؤيتها: الهاتف الذي يرن، في اللحظة التي قرر فيها أحدهم أن الاتصال أسرع من الكتابة.
      </p>
    </div>
  </div>
</section>

<!-- BILINGUAL -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="bilingual-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="bilingual-heading" style="margin-bottom:1.5rem;">ثنائي اللغة افتراضياً</h2>
      <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">نفس موظف الاستقبال للمتصلين بالعربية والإنجليزية</h3>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        حجم مكالمات الإمارات ينقسم فعلياً بين اللغتين، وأحياناً يتبدل في منتصف المكالمة. بدلاً من توجيه المتصلين بالعربية لخط وبالإنجليزية لآخر، أو توظيف شخصين لتغطية كلتيهما، نفس موظف الاستقبال بالذكاء الاصطناعي يتعامل مع أي منهما، ويتبدل بشكل طبيعي عندما يفعل المتصل ذلك. يُختبَر مقابل عبارات خليجية حقيقية أثناء الإعداد، لا العربية الفصحى الرسمية فقط، لأن ذلك ما يستخدمه معظم المتصلين فعلياً.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        هذا يهم أكثر مما يبدو. المتصل الذي يضطر لتكرار نفسه بلغة بالكاد يفهمها موظف الاستقبال يكوّن انطباعاً عن العمل بسرعة، وليس انطباعاً جيداً. فعل ذلك بشكل صحيح في كل مكالمة، في أي ساعة، إحدى أوضح الميزات مقارنة بتوظيف بشري واحد يحاول تغطية كلتا اللغتين وحده.
      </p>
    </div>
  </div>
</section>

<!-- WHAT IT REPLACES VS WHAT IT CAN'T -->
<section class="section" aria-labelledby="replace-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="replace-heading">ما يستبدله مقابل ما لا يستطيع</h2>
    </div>
    <div class="bento-grid bento-grid-2" style="max-width:900px; margin:0 auto;">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">ما يستبدله</h3>
        <ul class="journey-list">
          <li>كل مكالمة تذهب حالياً للبريد الصوتي خلال ساعات الذروة، الغداء، أو بعد الإغلاق</li>
          <li>العمل اليدوي المتكرر للإجابة عن نفس الأسئلة الشائعة القليلة طوال اليوم</li>
          <li>مكالمات جدولة متبادلة تستهلك صباح موظف الاستقبال</li>
          <li>رسائل هاتفية غامضة ونصف مكتوبة لا تخبر فريقكم بما يكفي للتصرف عليه</li>
        </ul>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">ما لا يستطيع استبداله</h3>
        <ul class="journey-list">
          <li>أحكام حقيقية: متصل مكروب، شكوى غير معتادة، تفاوض حساس</li>
          <li>بناء العلاقات الذي يوفره صوت بشري مألوف لعملاء VIP أو طويلي الأمد</li>
          <li>مهام حضورية مثل استقبال زائر عند مكتب الاستقبال الفعلي</li>
          <li>قرارات لم يحدد عملكم سياسة لها بعد</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- SETUP -->
<section class="section" style="background:#e7eeff;" aria-labelledby="setup-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="setup-heading" style="margin-bottom:1.5rem;">الإعداد: خط الهاتف، التقويم، ونظام CRM</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الإعداد عادة يمر بثلاثة أجزاء. أولاً، خط الهاتف: رقم عملكم الحالي يُحوَّل لموظف الاستقبال بالذكاء الاصطناعي، إما لكل المكالمات أو فقط للتغطية الفائضة وخارج ساعات العمل، فلا يتغير شيء في تفاصيل تواصلكم المنشورة. ثانياً، التقويم: مُتَّصل ليتحقق موظف الاستقبال من التوفر الفعلي ويحجز مباشرة، بدلاً من الوعد بموعد يجب التحقق منه لاحقاً مع أحدهم. ثالثاً، نظام CRM، فتحط الرسائل، تفاصيل المتصلين، ونتائج الحجز حيث يتتبع فريقكم معلومات العملاء أصلاً بدلاً من الجلوس في صندوق وارد منفصل لا يفحصه أحد.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        قبل أن يجيب على متصل حقيقي، نختبره مقابل سيناريوهات مكالماتكم الفعلية، بما في ذلك المحرجة منها: شخص يريد ثلاثة أشياء في مكالمة واحدة، متصل محبَط بوضوح، ضوضاء خلفية، كلام بلكنة. الهدف موظف استقبال جاهز فعلياً لحجم مكالماتكم من اليوم الأول، لا واحد لا يزال يتعلم على عملائكم.
      </p>
    </div>
  </div>
</section>

