---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../../components/ProcessSteps.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "ماذا تبني وكالة أتمتة ذكاء اصطناعي فعلياً؟", answer: "برمجيات عاملة، لا عروضاً تقديمية. الوكالة الجيدة تبني سير عمل آلياً يعمل داخل الأدوات التي تستخدمونها أصلاً: فرز بريد إلكتروني يقرأ ويوجّه الرسائل، معالجة فواتير تستخرج وترحّل البيانات تلقائياً، تسلسلات متابعة عملاء محتملين، سلاسل موافقة، ومزامنة بيانات بين الأنظمة. المُخرَج أتمتة عاملة، مُختبَرة على بياناتكم الحقيقية، تستمر بالعمل بعد انتهاء المشروع." },
  { question: "كم تكلف الاستعانة بوكالة أتمتة ذكاء اصطناعي؟", answer: "يعتمد على عدد سير العمل، الأنظمة المعنية، وكم تنظيف بيانات مطلوب. سير عمل واحد محدد جيداً، مثل معالجة الفواتير الآلية، عادة يكلف أقل من تكامل متعدد الأنظمة يلمس نظام CRM وERP وصندوق الدعم في آن واحد. الوكالات ذات السمعة الجيدة تحدد نطاق السعر بعد مكالمة اكتشاف، لا قبلها. احذروا من أي شخص يعرض رقماً قبل رؤية سير عملكم الفعلي." },
  { question: "ما الفرق بين وكالة أتمتة ذكاء اصطناعي ومستقل؟", answer: "المستقل شخص واحد بمجموعة مهارات محدودة ودون احتياط إذا مرض، انشغل، أو انتقل. الوكالة تجلب فريقاً يغطي الاكتشاف، البناء، والدعم المستمر، بالإضافة لعملية للتعامل مع تغييرات النطاق ومشاكل ما بعد الإطلاق. لسكربت صغير واحد، قد يكون مستقل مناسباً. لأي شيء يلمس عدة أنظمة عمل يحتاج الاستمرار بالعمل لسنوات، الوكالة تحمل مخاطرة أقل." },
  { question: "كم يستغرق تعامل نموذجي مع وكالة؟", answer: "معظم المشاركات تستغرق من بضعة أسابيع لشهرين، حسب النطاق. سير عمل واحد بتكامل واحد يمكن أن يعمل خلال أقل من شهر. مشاريع متعددة سير العمل تلمس عدة أنظمة تستغرق أطول، بشكل أساسي بسبب رسم البيانات والاختبار على بيانات حقيقية وفوضوية لا مجموعة بيانات عرض توضيحي نظيفة." },
  { question: "هل أحتاج استبدال برمجياتنا الحالية للعمل مع وكالة أتمتة ذكاء اصطناعي؟", answer: "لا، ويجب أن تكونوا متشككين من أي وكالة تخبركم بعكس ذلك. الوكالة الكفؤة تؤتمت فوق نظام CRM وERP والبريد الإلكتروني وأدوات العمل الحالية لديكم عبر API. استبدال منظومتكم مشروع أكبر بكثير وأكثر مخاطرة من أتمتة العمل اليدوي الجالس داخلها." },
  { question: "هل تستطيع وكالة أتمتة ذكاء اصطناعي العمل مع فريق صغير أو شركة ناشئة؟", answer: "نعم. الوكالات تحدد نطاق المشاريع لسير عمل واحد بنفس تكرار طرح متعدد الأنظمة. شركة بخمسة أشخاص تؤتمت متابعة عملاء محتملين لا تحتاج نفس المشاركة كعملية بـ٢٠٠ شخص تؤتمت المالية عبر ثلاثة أنظمة. النطاق والسعر يجب أن يطابقا ما تحتاجونه فعلياً، لا حزمة ثابتة مبنية لعمل أكبر." },
  { question: "ماذا يحدث للأتمتة إذا توقفنا عن العمل مع الوكالة؟", answer: "مع وكالة جيدة، تستمر بالعمل. الأتمتة تعيش داخل أنظمتكم الخاصة، نظام CRM لديكم، حساب منصة الأتمتة لديكم، تكاملاتكم، لا على بنية تحتية تتحكم بها الوكالة وتستطيع إيقافها. اسألوا هذا مباشرة قبل التوقيع: إذا انسحبنا غداً، هل ستستمر الأتمتة بالعمل؟" },
  { question: "هل يجب أن تملك الوكالة خبرة في قطاعنا المحدد؟", answer: "يساعد، لكنه ليس العامل الحاسم. المهارة الأساسية، رسم سير عمل، التعامل مع حالات حدية، تكامل أنظمة عبر API، تنتقل عبر القطاعات. الأهم هو ما إذا كانوا يطرحون أسئلة جيدة حول كيفية عمل عملكم فعلياً، بدلاً من افتراض أن عمليتكم تطابق قالباً عاماً." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_agencies')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "مكالمة اكتشاف", description: "نسأل عن سير عملكم الحالي، أدواتكم، وأين يعيش العمل اليدوي فعلياً. دون تحضير تقني مطلوب من جانبكم." },
  { icon: "edit", step: "الخطوة ٢", title: "عرض محدد النطاق", description: "تحصلون على نطاق مكتوب: أي سير عمل، أي أنظمة، كم يكلف، وكيف يبدو 'الإنجاز'، قبل بدء أي عمل." },
  { icon: "build", step: "الخطوة ٣", title: "البناء والاختبار", description: "نبني مقابل بياناتكم الحقيقية في بيئة تجريبية ونصلح الحالات الحدية قبل أن يلمس أي شيء الإنتاج." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "الإطلاق والدعم", description: "تُطلَق الأتمتة. نراقبها لمدة ٩٠ يوماً ونبقى متاحين إذا احتاج شيء تعديلاً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'خدمات وكالة أتمتة الذكاء الاصطناعي',
    url: 'https://lenooai.com/ar/services/ai-automation/agencies',
    description: 'ماذا تفعل وكالة أتمتة الذكاء الاصطناعي، كيف تُقيّمون واحدة، وكيف تدير Lenoo AI الاكتشاف والبناء والدعم بعد الإطلاق لمشاريع الأتمتة في الإمارات.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'مشاركات وكالة أتمتة الذكاء الاصطناعي: محددة النطاق ومُسعَّرة بعد مكالمة اكتشاف مجانية.' },
    serviceType: 'AI Automation Agency',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'الوكالات', item: 'https://lenooai.com/ar/services/ai-automation/agencies' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="وكالات أتمتة الذكاء الاصطناعي: ماذا تفعل وكيف تختارون واحدة | Lenoo AI"
  description="ماذا تُسلِّم وكالة أتمتة الذكاء الاصطناعي فعلياً، كيف تعمل عملية Lenoo AI، وما يجب تقييمه قبل توظيف واحدة في الإمارات."
  canonicalPath="/ar/services/ai-automation/agencies"
  enPath="/services/ai-automation/agencies"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>الوكالات</div>
    <h1>وكالات أتمتة الذكاء الاصطناعي: <span class="gradient-text">ماذا تفعل وكيف تختارون واحدة</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      تبحثون عن وكالة أتمتة ذكاء اصطناعي وغير متأكدين ما يميز الجيدة عن السيئة؟ إليكم ماذا يتضمن العمل فعلياً، ماذا تتحققون منه قبل التوقيع على أي شيء، وكيف تدير Lenoo AI، وكالة أتمتة ذكاء اصطناعي مقرها الإمارات، العملية من البداية للنهاية.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">محدد النطاق ومُسعَّر بعد الاكتشاف، أبداً قبله</span>
      <span class="tchip">دعم ٩٠ يوماً بعد الإطلاق في كل مشروع</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_agencies_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-agencies-do" class="btn-outline">شاهدوا ماذا تفعل الوكالة ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1400&q=80&auto=format&fit=crop" alt="فريق يراجع نطاق أتمتة أثناء مكالمة اكتشاف وكالة" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "٤٠٪", caption: "من مهام العمل في معظم الشركات قابلة للأتمتة بالذكاء الاصطناعي المتاح حالياً، وفقاً لبحث McKinsey." },
      { value: "٩٠ يوماً", caption: "مراقبة بعد الإطلاق مشمولة في كل مشروع Lenoo AI" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHAT AGENCIES DO -->
<section id="what-agencies-do" class="section" aria-labelledby="what-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="what-heading">ماذا تفعل وكالة أتمتة ذكاء اصطناعي فعلياً</h2>
      <p style="color:#42474e; font-size:1.0625rem;">التسمية تغطي مساحة واسعة. إليكم كيف يبدو العمل يومياً، مقسماً لخمس مراحل تمر بها معظم المشاريع.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">search</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">الاكتشاف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">فهم كيف يعمل سير عمل فعلياً اليوم: من يلمسه، أي أدوات معنية، وأين يتراكم الجهد اليدوي.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">account_tree</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">رسم سير العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">تحويل عملية موصوفة لتسلسل محدد من المحفزات، القرارات، والمخرجات التي تستطيع البرمجيات التصرف عليها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">build</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">البناء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">كتابة واختبار منطق الأتمتة نفسه، بما يشمل كيفية تعامله مع الحالات الفوضوية وغير المعتادة، لا الأمثلة النظيفة فقط.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">integration_instructions</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">التكامل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">ربط الأتمتة بنظام CRM وERP والبريد الإلكتروني أو جداول البيانات الحالية عبر API، فتعمل داخل الأدوات التي يستخدمها فريقكم أصلاً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">monitoring</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">المراقبة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">مراقبة الأتمتة بمجرد إطلاقها، إصلاح ما ينكسر، وتعديلها مع تغيّر عمليتكم أو بياناتكم عبر الزمن.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">extension</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تعمل عبر أدوات عديدة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">الوكالة الجيدة ليست مقيدة بمنصة واحدة. شاهدوا <a href="/ar/services/ai-automation/tools">القائمة الكاملة للأدوات التي نبني بها</a>، من Zapier وMake إلى n8n وPower Automate.</p>
      </div>
    </div>
  </div>
</section>

<!-- DIY VS AGENCY DECISION -->
<section id="agencies-operations" class="section" style="background:#f9f9ff;" aria-labelledby="agencies-operations-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="agencies-operations-heading">ليس كل مشروع أتمتة يحتاج وكالة خارجية</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">بعض عمل الأتمتة بسيط بما يكفي للتعامل معه بأداة جاهزة وعصر أحد أيام العمل. مشاريع أخرى تتضمن منطقاً مخصصاً كافياً، تكامل أنظمة، أو صيانة مستمرة كافية أن إدخال وكالة ينتهي أسرع وأرخص من الساعات التي كانت ستكلفها داخلياً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">معرفة أي فئة يقع فيها مشروع قبل بدء تقييم المزودين توفر وقتاً على الجانبين. الوكالة الجيدة تفضّل تحديد نطاق عمل حقيقي على إقناعكم بترك شيء تستطيعون إنهاءه بأنفسكم في عطلة نهاية أسبوع.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1758518731462-d091b0b4ed0d?w=800&q=80&auto=format&fit=crop" alt="رجلا أعمال يوقعان عقداً على طاولة بينما يراقب زميل في مكتب حديث" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- AGENCY PRESENTATION IMAGE BAND -->
<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=1400&q=80&auto=format&fit=crop" alt="استشاري يعرض خطة على شاشة لفريق يجلس حول طاولة بحواسيب محمولة" loading="lazy" width="1400" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- DIY VS AGENCY TABS -->
<section class="section" aria-labelledby="agencies-tabs-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="agencies-tabs-heading">افعلوها بأنفسكم مقابل إدخال وكالة</h2>
      <p style="color:#42474e; font-size:1.0625rem;">دليل تقريبي لأي مشاريع أتمتة تستحق البناء داخلياً، وأيها تستحق التسليم لوكالة.</p>
    </div>
    <div class="agencies-tabs" role="tablist" aria-label="إرشاد افعلوها بأنفسكم مقابل الوكالة">
      <button type="button" id="agencies-tab-diy" class="agencies-tab-btn active" data-agencies-tab="diy" role="tab" aria-selected="true" aria-controls="agencies-panel-diy">افعلوها بأنفسكم</button>
      <button type="button" id="agencies-tab-agency" class="agencies-tab-btn" data-agencies-tab="agency" role="tab" aria-selected="false" aria-controls="agencies-panel-agency">أدخلوا وكالة</button>
    </div>
    <div class="bento-grid bento-grid-3" id="agencies-panel-diy" data-agencies-tab-panel="diy" role="tabpanel" aria-labelledby="agencies-tab-diy">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">handyman</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">أداة جاهزة تناسب أصلاً</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">أداة بلا كود مثل Zapier أو Make تفعل بالفعل ما تحتاجونه، دون منطق مخصص أو حالات حدية خاصة بالنظام للتعامل معها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">shield</span></div>
