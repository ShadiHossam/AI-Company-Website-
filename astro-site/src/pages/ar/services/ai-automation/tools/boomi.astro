<style>
.value-card { display:flex; flex-direction:column; }
.boomi-toggle { display:flex; gap:0; justify-content:center; margin-bottom:1.5rem; background:#fff; border-radius:100px; padding:4px; border:1px solid rgba(0,37,59,0.1); max-width:420px; margin-left:auto; margin-right:auto; }
.boomi-toggle-btn { flex:1; padding:0.625rem 1.25rem; border-radius:100px; border:none; background:transparent; color:#42474e; font-size:0.875rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.boomi-toggle-btn.active { background:#006875; color:#fff; }
.boomi-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const boomiToggleWrap = document.querySelector('.boomi-toggle');
  if (boomiToggleWrap) {
    const boomiBtns = boomiToggleWrap.querySelectorAll('.boomi-toggle-btn');
    const boomiPanels = document.querySelectorAll('[data-boomi-tier-panel]');
    boomiBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-boomi-tier');
        boomiBtns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        boomiPanels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-boomi-tier-panel') !== key; });
      });
    });
  }
</script>
