---
export const prerender = false;
import ArBaseLayout from "../../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../../lib/supabase";
import FaqAccordion from "../../../../../components/FaqAccordion.astro";

const h1 = 'شريك تكامل Dell Boomi في الإمارات';
const metaTitle = 'شريك تكامل Dell Boomi في الإمارات | Lenoo AI';
const metaDescription = 'تنفذ Lenoo AI تكاملات Dell Boomi للمؤسسات الإماراتية التي تربط أنظمة محلية قديمة بتطبيقات سحابية حديثة.';
const heroSubtext = 'يتخصص Boomi في ربط الأنظمة القديمة المحلية بالتطبيقات السحابية الحديثة. نصمم ونبني التكاملات التي تجعل الأنظمة القديمة والجديدة تتحدث مع بعضها.';

const useCases = [
  { title: 'تكامل ERP قديم مع السحابة', description: 'ربط ERP أو قاعدة بيانات محلية عملت لسنوات بأدوات CRM أو مالية أو تقارير سحابية حديثة دون استبدال النظام بالكامل.' },
  { title: 'مزامنة بيانات هجينة', description: 'إبقاء الأنظمة المحلية والسحابية متزامنة في وقت شبه فعلي، مع تحقق ومعالجة أخطاء مبنية في كل عملية تكامل.' },
  { title: 'إدارة API للأنظمة القديمة', description: 'تغليف الأنظمة القديمة بواجهات API مُدارة عبر Boomi فتستطيع التطبيقات الأحدث الاتصال بها بأمان واتساق.' },
];

const faqFallback = [
  { question: 'هل Boomi الخيار الصحيح إذا كانت منظومتنا حديثة وسحابية بالكامل؟', answer: 'قوة Boomi تحديداً في الاتصال الهجين والقديم. إذا كانت منظومتكم أصلاً سحابية أصلياً بالكامل، iPaaS أخف مثل Make أو Workato عادة ملاءمة أفضل، وسنوصي بذلك بصدق بدلاً من دفع Boomi حيث ليس الأداة الأفضل.' },
  { question: 'هل يستطيع Boomi الاتصال بـ ERP محلي دون تعريضه للإنترنت؟', answer: 'نعم، عبر وقت تشغيل Atom المحلي الخاص بـ Boomi، تستطيع التكاملات العمل ضمن شبكتكم الخاصة، تتصل بالأنظمة المحلية دون تطلّب تعريض خارجي مباشر.' },
  { question: 'كم يستغرق مشروع تكامل Boomi نموذجي؟', answer: 'تكامل واحد بين نظامين يمكن أن يصبح حياً خلال بضعة أسابيع. البرامج الأكبر التي تربط عدة أنظمة قديمة وسحابية معاً تُحدَّد نطاقها على مراحل، فيصبح الاتصال الأعلى قيمة حياً أولاً بينما يستمر الباقي بالتوازي.' },
];

let faqItems = faqFallback;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_tools_boomi')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    url: 'https://lenooai.com/ar/services/ai-automation/tools/boomi',
    description: metaDescription,
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'مشاريع أتمتة مؤسسية: التسعير حسب النطاق، الأنظمة المتورطة، ومتطلبات الحوكمة. احجزوا استشارة للحصول على عرض سعر.' },
    serviceType: 'Dell Boomi',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'الأدوات', item: 'https://lenooai.com/ar/services/ai-automation/tools' },
      { '@type': 'ListItem', position: 4, name: 'Dell Boomi', item: 'https://lenooai.com/ar/services/ai-automation/tools/boomi' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath="/ar/services/ai-automation/tools/boomi"
  enPath="/services/ai-automation/tools/boomi"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;" aria-label="مسار التصفح">
      <a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      <a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      <a href="/ar/services/ai-automation/tools" style="color:inherit;text-decoration:none;opacity:0.65;">الأدوات</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      Dell Boomi
    </div>
    <div style="margin-bottom:1.5rem;">
      <img src="https://cdn.simpleicons.org/boomi/CB333B" alt="شعار Dell Boomi" width="56" height="56" loading="eager" fetchpriority="high" style="background:#fff;border-radius:16px;padding:10px;box-shadow:0 8px 24px rgba(0,59,92,0.18);" onerror="this.style.display='none'" />
    </div>
    <h1>{h1}</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      {heroSubtext}
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:2rem;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_tools_boomi_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1526628953301-3e589a6a8b74?w=1400&q=80&auto=format&fit=crop" alt="لقطة مقرّبة لشاشة لوحة تحكم منصة تكامل تعرض مربعات مقاييس أداء حية" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHAT IS -->
<section class="section" aria-labelledby="what-is-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="what-is-heading" style="margin-bottom:1.5rem;">ما هو Dell Boomi؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        Dell Boomi منصة تكامل كخدمة (iPaaS) بجذور قوية في اتصال الأنظمة الهجينة والقديمة، تستخدمها عادة المؤسسات التي تحتاج ربط أنظمة ERP أو قواعد بيانات محلية أقدم بتطبيقات سحابية أحدث.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.25rem;">
        وقت تشغيل Atom المحلي لدى Boomi هو القطعة التي تجعل التكامل الهجين عملياً: يعمل داخل شبكتكم الخاصة كعميل خفيف، فتستطيع عملية تكامل القراءة من قاعدة بيانات محلية أو ERP قديم دون أن يحتاج ذلك النظام أبداً للتعرض مباشرة للإنترنت. هذا يهم لكثير من المؤسسات الإماراتية التي لا تزال تشغّل أنظمة أساسية على بنية تحتية لم تُصمَّم أبداً لتكون مواجهة للإنترنت، ويتيح لتلك الأنظمة الاتصال بأدوات سحابية حديثة دون مشروع استبدال كامل.
      </p>
    </div>
  </div>
</section>

<!-- INTEGRATION ANGLE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="angle-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="angle-heading" style="margin-bottom:1.5rem;">كيف تستخدم Lenoo AI منصة Boomi لأتمتة المؤسسات الإماراتية</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        نحن شريك تنفيذ Boomi للمؤسسات الإماراتية ذات البيئات الهجينة، أنظمة ERP قديمة أو قواعد بيانات محلية تحتاج الاتصال بموثوقية بأدوات سحابية حديثة. دورنا تصميم وبناء عمليات التكامل، لا بيع تراخيص Boomi.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.25rem;">
        مشروع Boomi عادة يبدأ برسم بالضبط أي بيانات تعيش أين وأي الأنظمة مصدر الحقيقة لكل قطعة منها، لأن البيئات الهجينة تميل لتراكم تناقضات بمرور السنين سيقوم تكامل مباشر بنسخها للأمام فحسب. نصمم عمليات التكامل لحل تلك التناقضات مع انتقال البيانات، نبني بوقت تشغيل Atom المحلي حيث يحتاج نظام محلي البقاء داخل شبكتكم، ونضع تحققاً ومعالجة أخطاء في كل خطوة فيُعلَّم سجل سيء بدلاً من إفساد بيانات بصمت على الطرف الآخر.
      </p>
    </div>
  </div>
</section>

<!-- FREE VS PAID -->
<section class="section" aria-labelledby="boomi-pricing-heading">
  <div class="container" style="max-width:800px;">
    <h2 id="boomi-pricing-heading" style="text-align:center; margin-bottom:1.5rem;">Boomi مجاني مقابل مدفوع</h2>
    <div class="boomi-toggle" role="tablist" aria-label="مستوى التسعير">
      <button type="button" id="boomi-tier-free" class="boomi-toggle-btn active" data-boomi-tier="free" role="tab" aria-selected="true" aria-controls="boomi-panel-free">مجاني (تجربة)</button>
      <button type="button" id="boomi-tier-paid" class="boomi-toggle-btn" data-boomi-tier="paid" role="tab" aria-selected="false" aria-controls="boomi-panel-paid">مدفوع (اشتراك)</button>
    </div>
    <div class="card" id="boomi-panel-free" data-boomi-tier-panel="free" role="tabpanel" aria-labelledby="boomi-tier-free">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">لا يشغّل Boomi نسخة مجتمعية مجانية دائمة بالطريقة التي تفعلها بعض أدوات بلا كود. ما يقدّمه تجربة مجانية محدودة الوقت لمنصة Enterprise الكاملة، عادة مذكورة بحوالي ٣٠ يوماً، تكفي لبناء واختبار عملية تكامل حقيقية، بما فيها وقت تشغيل Atom المحلي، قبل الالتزام بأي شيء. نستخدم نافذة التجربة تلك أثناء الاكتشاف للتحقق من نهج مقابل أنظمتكم الفعلية قبل تحديد نطاق التعاون المدفوع.</p>
    </div>
    <div class="card" id="boomi-panel-paid" data-boomi-tier-panel="paid" role="tabpanel" aria-labelledby="boomi-tier-paid" hidden>
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">استخدام الإنتاج يتطلب نسخة اشتراك مدفوعة (Integration Professional أو Enterprise أو Enterprise Plus، بالإضافة لإضافات مثل API Management وData Hub)، ولا ينشر Boomi أسعاراً قياسية لهذه المستويات، كل عرض سعر يُحدَّد نطاقه مقابل عدد موصلاتكم الفعلي، حجم الرسائل، والبيئات. المستويات المدفوعة تفتح دعم إنتاج مستمر، موصلات أكثر، وضوابط الحوكمة التي تحتاجها مؤسسة إماراتية منظمة قبل أن يلمس تكامل بيانات حية. نحصل على عرض سعر مقابل نطاقكم بدلاً من تخمين رقم.</p>
    </div>
  </div>
</section>

<!-- WHO IT'S FOR -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="who-heading" style="margin-bottom:1.5rem;">هل Boomi مناسب لمؤسستكم؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        يناسب Boomi المؤسسات الإماراتية التي تشغّل ERP محلياً أو قاعدة بيانات قديمة تحتاج الاتصال بأدوات سحابية حديثة، دون تعريض ذلك النظام القديم مباشرة للإنترنت أو استبداله كلياً.
      </p>
    </div>
  </div>
</section>

<!-- ENGAGEMENT PHASES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="engagement-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="engagement-heading" style="margin-bottom:1.5rem;">كيف يبدو تعاون Boomi مؤسسي نموذجي</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.75rem;">
        تعاون Boomi فعلياً تمرين في رسم بيئة هجينة قبل بناء أي شيء، لأن الأنظمة المحلية المتورطة عادة راكمت سنوات من التناقضات الصغيرة سيقوم تكامل مباشر بنسخها للأمام إلى النظام الجديد.
      </p>
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">١. الاكتشاف ورسم البيانات</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">نبدأ بتحديد بالضبط أي بيانات تعيش أين، أي نظام مصدر الحقيقة لكل قطعة منها، وأين انحرف نفس الحقل عن التزامن عبر الأنظمة بمرور الوقت. لـ ERP قديم عمل لعقد أو أكثر، هذه المرحلة وحدها غالباً تكشف مخاطر تكامل لم يكن أحد في الفريق الحالي يدركها.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٢. تكامل تجريبي</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">نبني عملية التكامل الأولى مقابل الاتصال الأعلى قيمة، عادة الذي يسبب أكثر العمل اليدوي اليوم، باستخدام وقت تشغيل Atom المحلي لـ Boomi حيث يحتاج نظام محلي البقاء داخل شبكتكم بدلاً من التعرض مباشرة للإنترنت.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٣. مراجعة البنية والامتثال</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">قبل توسيع النمط أكثر، نراجع بنية التكامل مقابل متطلبات امتثالكم: أين يجلس وقت تشغيل Atom، ماذا يُسجَّل، وكيف يُعلَّم سجل سيء بدلاً من إفساد بيانات بصمت على الطرف الآخر. للمؤسسات الإماراتية بمتطلبات إقامة بيانات، هنا نؤكد أن البنية تلبيها فعلياً، لا فقط أن التكامل يعمل تقنياً.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٤. طرح مرحلي عبر الأنظمة</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">مع التحقق من البنية، نربط أنظمة إضافية بترتيب الأولوية، نعيد استخدام نفس أنماط التحقق ومعالجة الأخطاء المؤسَّسة في التجربة فيستغرق كل اتصال جديد وقتاً أقل من السابق.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٥. الإدارة المستمرة</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">نراقب وقت تشغيل Atom وعمليات التكامل بعد الإطلاق، ونقدّم عقود صيانة لإضافة اتصالات جديدة أو تعديل منطق الربط مع تغيّر الأنظمة المصدر نفسها بمرور الوقت.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VS ALTERNATIVES -->
<section class="section" aria-labelledby="vs-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="vs-heading" style="margin-bottom:1.5rem;">Boomi مقابل MuleSoft</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        كلاهما منصتا iPaaS مؤسسيتان بمصداقية تكامل قوية، لكن مبنيتان لمقاييس مشاكل مختلفة. وقت تشغيل Atom المحلي لـ Boomi وإعداده الأخف يجعلانه طريقاً أسرع لربط حفنة من الأنظمة المحلية بتطبيقات سحابية، دون حاجة لتصميم بنية API كاملة مقدماً. نهج <a href="/ar/services/ai-automation/tools/mulesoft">MuleSoft</a> القائم على API، بتطبيق طبقات نظام وعملية وتجربة، يثمر عندما تربط مؤسسة عشرات الأنظمة على خارطة طريق متعددة السنوات، لأن كل تكامل جديد بعد الأول يعيد استخدام واجهات API موجودة أصلاً بدلاً من البدء من الصفر. إذا احتجتم ربط ERP قديم بأداتين أو ثلاث سحابية، Boomi عادة يصل هناك أسرع وبتكلفة أقل. إذا كنتم تبنون برنامج تكامل عبر مؤسسة منظمة كاملة للسنوات القادمة، بنية MuleSoft مبنية تحديداً لذلك المقياس.
      </p>
    </div>
  </div>
</section>

<!-- UAE CONTEXT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="uae-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="uae-heading" style="margin-bottom:1.5rem;">أين يناسب Boomi في المؤسسات الإماراتية</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
