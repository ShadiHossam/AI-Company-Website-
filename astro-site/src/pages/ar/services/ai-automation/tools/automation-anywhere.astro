---
export const prerender = false;
import ArBaseLayout from "../../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../../lib/supabase";
import FaqAccordion from "../../../../../components/FaqAccordion.astro";

const h1 = 'تنفيذ Automation Anywhere في الإمارات';
const metaTitle = 'تنفيذ Automation Anywhere في الإمارات | Lenoo AI';
const metaDescription = 'تنفذ Lenoo AI روبوتات Automation Anywhere RPA للمؤسسات الإماراتية الموحّدة أصلاً على المنصة، أو التي تقيّمها مقابل UiPath.';
const heroSubtext = 'Automation Anywhere بديل أصيل السحابة لـ UiPath، مبني للمؤسسات التي تريد RPA مُسلَّمة ومُدارة عبر السحابة من اليوم الأول.';

const useCases = [
  { title: 'نشر روبوتات أصيل السحابة', description: 'تُبنى الروبوتات، تُنشَر، وتُدار مركزياً عبر Automation 360، دون حاجة لبنية تحتية محلية لتشغيلها.' },
  { title: 'توحيد العمليات عبر الأقسام', description: 'نساعد المؤسسات على طرح أتمتة متسقة ومحكومة عبر أقسام متعددة باستخدام إطار روبوت مشترك.' },
  { title: 'نقل UiPath مقابل Automation Anywhere', description: 'للأعمال التي تبدّل المنصات، نعيد بناء منطق الأتمتة الحالي في Automation Anywhere ونتحقق منه مقابل الأصلي قبل التحويل.' },
];

const faqFallback = [
  { question: 'هل نختار Automation Anywhere أم UiPath؟', answer: 'كلاهما منصة RPA مؤسسية قادرة؛ الخيار الصحيح عادة يعود لبنيتكم التحتية الحالية، علاقات الترخيص، وهل تريدون نشراً أصيل السحابة أو أولوية محلية. نعطي مقارنة صادقة خاصة ببيئتكم أثناء مكالمة الاكتشاف بدلاً من الترويج لمنصة واحدة.' },
  { question: 'هل تستطيعون نقل روبوتات UiPath الحالية لدينا إلى Automation Anywhere؟', answer: 'نعم. نعيد بناء منطق الأتمتة أصلياً في Automation Anywhere، نختبره مقابل سلوك الروبوت الأصلي، وندير التحويل فلا ينكسر شيء في منتصف العملية.' },
  { question: 'هل يعمل Automation Anywhere جيداً لعمليات إماراتية متعددة المكاتب؟', answer: 'بنيته أصيلة السحابة ومُدارة مركزياً تميل لملاءمة الطرح متعدد المكاتب جيداً، لأن الروبوتات تُنشَر وتُراقَب من وحدة تحكم واحدة بدلاً من الحاجة لبنية تحتية محلية منفصلة في كل موقع.' },
];

let faqItems = faqFallback;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_tools_automation_anywhere')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    url: 'https://lenooai.com/ar/services/ai-automation/tools/automation-anywhere',
    description: metaDescription,
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'مشاريع أتمتة مؤسسية: التسعير حسب النطاق، الأنظمة المتورطة، ومتطلبات الحوكمة. احجزوا استشارة للحصول على عرض سعر.' },
    serviceType: 'Automation Anywhere',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'الأدوات', item: 'https://lenooai.com/ar/services/ai-automation/tools' },
      { '@type': 'ListItem', position: 4, name: 'Automation Anywhere', item: 'https://lenooai.com/ar/services/ai-automation/tools/automation-anywhere' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath="/ar/services/ai-automation/tools/automation-anywhere"
  enPath="/services/ai-automation/tools/automation-anywhere"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;flex-wrap:wrap;justify-content:center;" aria-label="مسار التصفح">
      <a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      <a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      <a href="/ar/services/ai-automation/tools" style="color:inherit;text-decoration:none;opacity:0.65;">الأدوات</a><span style="opacity:0.4;padding:0 4px;"> / </span>
      Automation Anywhere
    </div>
    <div style="margin-bottom:1.5rem;">
      <img src="https://cdn.simpleicons.org/automationanywhere/D22630" alt="شعار Automation Anywhere" width="56" height="56" loading="eager" fetchpriority="high" style="background:#fff;border-radius:16px;padding:10px;box-shadow:0 8px 24px rgba(0,59,92,0.18);" onerror="this.style.display='none'" />
    </div>
    <h1>{h1}</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      {heroSubtext}
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:2rem;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_tools_automation_anywhere_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1686061593213-98dad7c599b9?w=1400&q=80&auto=format&fit=crop" alt="لقطة مقرّبة للوحة تحكم أتمتة على شاشة تعرض رسوماً بيانية للنشاط ومقاييس العمليات" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHAT IS -->
<section class="section" aria-labelledby="what-is-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="what-is-heading" style="margin-bottom:1.5rem;">ما هو Automation Anywhere؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        Automation Anywhere منصة RPA مؤسسية، موضوعة كبديل أصيل السحابة لـ UiPath، ببنية Bot Store وAutomation 360 مبنية لروبوتات مُدارة مركزياً ومنشورة عبر السحابة بدلاً من نشر أولوية محلية.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.25rem;">
        التصميم أصيل السحابة يعني أن الروبوتات تُبنى، تُنسَّق، وتُراقَب من وحدة تحكم ويب مركزية بدلاً من حاجة غرفة تحكم مثبتة محلياً، ما يميل لتبسيط الطرح عبر مكاتب أو أقسام متعددة مقارنة ببُنى RPA الأقدم أولوية المحلي. Bot Store الخاص به أيضاً يشحن بمكتبة مكوّنات أتمتة جاهزة للمهام المؤسسية الشائعة، ما يمكن أن يقصّر وقت البناء للعمليات القياسية كاستخراج الفواتير أو ترحيل البيانات، رغم أن معظم الطروحات الحقيقية لا تزال تحتاج منطقاً مخصصاً فوقها.
      </p>
    </div>
  </div>
</section>

<!-- INTEGRATION ANGLE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="angle-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="angle-heading" style="margin-bottom:1.5rem;">كيف تستخدم Lenoo AI منصة Automation Anywhere لأتمتة المؤسسات الإماراتية</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        نحن شريك تنفيذ للمؤسسات الموحّدة أصلاً على Automation Anywhere، أو التي تقيّمها وجهاً لوجه مقابل UiPath. دورنا تصميم منطق الروبوت، دمجه مع أنظمتكم الحالية، وصيانته بعد الإطلاق، لا نبيع تراخيص Automation Anywhere.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-top:1.25rem;">
        للعملاء الموجودين أصلاً على Automation Anywhere، ندخل ضمن أياً كان نموذج الحوكمة الذي وضعته تقنية المعلومات أصلاً، نبني روبوتات تتبع اصطلاحات التسمية الحالية، ضوابط الوصول، وعمليات إدارة التغيير بدلاً من إدخال معاييرنا الخاصة. للعملاء الذين لا يزالون يقررون بين المنصات، نجري تقييماً قصيراً مقابل متطلبات عمليتكم الفعلية، لأن الإجابة الصحيحة تعتمد أكثر على بنيتكم التحتية الحالية ومجموعة مهارات فريقكم من أي ادعاء عام حول أي المنصات أفضل.
      </p>
    </div>
  </div>
</section>

<!-- FREE VS PAID -->
<section class="section" aria-labelledby="aa-pricing-heading">
  <div class="container" style="max-width:800px;">
    <h2 id="aa-pricing-heading" style="text-align:center; margin-bottom:1.5rem;">Automation Anywhere مجاني مقابل مدفوع</h2>
    <div class="aa-toggle" role="tablist" aria-label="مستوى التسعير">
      <button type="button" id="aa-tier-free" class="aa-toggle-btn active" data-aa-tier="free" role="tab" aria-selected="true" aria-controls="aa-panel-free">مجاني (النسخة المجتمعية)</button>
      <button type="button" id="aa-tier-paid" class="aa-toggle-btn" data-aa-tier="paid" role="tab" aria-selected="false" aria-controls="aa-panel-paid">مدفوع (Automation 360)</button>
    </div>
    <div class="card" id="aa-panel-free" data-aa-tier-panel="free" role="tabpanel" aria-labelledby="aa-tier-free">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">النسخة المجتمعية من Automation Anywhere تمنح الأفراد، الطلاب، والفرق الصغيرة وصولاً مجانياً لمنصة Automation 360 السحابية: Bot Creator لبناء الروبوتات، Bot Store للمكوّنات الجاهزة، ودعم المجتمع. مستخدم واحد فقط، بتنفيذ روبوت مراقَب فقط، ولا تشمل ضوابط الوصول القائمة على الأدوار أو تسجيل التدقيق التي تتطلبها مراجعة حوكمة مؤسسية، لذا نعاملها كمكان لبناء نموذج أولي وتقييم المنصة، لا حيث ينتهي روبوت مؤسسي إنتاجي.</p>
    </div>
    <div class="card" id="aa-panel-paid" data-aa-tier-panel="paid" role="tabpanel" aria-labelledby="aa-tier-paid" hidden>
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">Automation 360 المدفوعة (من Cloud Starter إلى Enterprise) تضيف ما يحتاجه فعلياً طرح متعدد الأقسام: مستخدمون متعددون، تنفيذ روبوت غير مراقَب يعمل دون أن يشاهده أحد، ضوابط وصول قائمة على الأدوار، ومسار التدقيق الذي سيطلبه فريق الامتثال لديكم قبل أن يلمس روبوت الإنتاج. التسعير يتصاعد حسب كم روبوتاً تشغّلونه وهل مراقَبة أو غير مراقَبة، ولا ينشر Automation Anywhere أسعاراً دقيقة، لذا نحصل على عرض سعر مقابل نطاقكم الفعلي بدلاً من تخمين رقم.</p>
    </div>
  </div>
</section>

<!-- WHO IT'S FOR -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="who-heading" style="margin-bottom:1.5rem;">هل Automation Anywhere مناسب لمؤسستكم؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        يناسب Automation Anywhere المؤسسات الإماراتية التي تريد RPA مُدارة مركزياً عبر السحابة من البداية، أو المؤسسات الموحّدة أصلاً على المنصة والتي تحتاج شريك تنفيذ لا موزّع تراخيص.
      </p>
    </div>
  </div>
</section>

<!-- ENGAGEMENT PHASES -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="engagement-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="engagement-heading" style="margin-bottom:1.5rem;">كيف يبدو تعاون Automation Anywhere مؤسسي نموذجي</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.75rem;">
        يتبع تعاون Automation Anywhere مساراً مشابهاً لأي برنامج RPA مؤسسي: اكتشاف، تجربة، حوكمة، ثم طرح. البنية أصيلة السحابة تغيّر كيف تعمل بعض تلك المراحل فعلياً.
      </p>
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">١. اكتشاف الأنظمة القديمة وتقييم العملية</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">نبدأ بنفس الطريقة التي نبدأ بها مع أي منصة RPA: رسم التطبيقات القديمة والخطوات اليدوية التي تلمسها العملية المستهدفة فعلياً، لأن روبوتات Automation Anywhere لا تزال تتفاعل مع نفس الواجهات القديمة التي تتفاعل معها روبوتات UiPath. الفرق يظهر لاحقاً، في كيفية نشر الروبوت وإدارته، لا في كيفية اكتشافه.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٢. تجربة على عملية واحدة</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">نبني الروبوت الأول داخل Automation 360 مقابل عملية واحدة، نختبره مقابل بيانات حقيقية قبل أن يقترب من الإنتاج. لأن Automation 360 يعمل من وحدة تحكم سحابية مركزية، التجربة مرئية لأصحاب المصلحة من اليوم الأول بدلاً من أن تعيش على جهاز مطور واحد.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٣. مراجعة الحوكمة والأمان</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">يمر الروبوت بعدها بمراجعة حوكمة وأمان: ضوابط وصول، مسارات تدقيق، وإدارة تغيير، مطابقة لأياً كانت المعايير التي يشغّلها فريق تقنية المعلومات لديكم أصلاً. للمؤسسات ذات أولوية سحابية أصلاً، هذه المراجعة تميل للتحرك أسرع مع Automation Anywhere من منصة أولوية محلية، لأن طبقة التحكم مركزية أصلاً.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٤. طرح مرحلي عبر الأقسام</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">من هناك نطرح الأتمتة لأقسام إضافية باستخدام نفس إطار الروبوت المشترك، فيتبع كل روبوت جديد نفس اصطلاحات التسمية، قواعد الوصول، وإعداد المراقبة كالأول. وحدة التحكم المُدارة مركزياً لـ Automation Anywhere هي ما يجعل طرحاً متعدد المكاتب أسهل إدارة فعلياً من مجموعة تركيبات محلية منفصلة.</p>
        </div>
        <div>
          <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.375rem;">٥. الإدارة المستمرة</h3>
          <p style="color:#42474e; font-size:1rem; line-height:1.75; margin:0;">بعد الإطلاق، نراقب أداء الروبوت وتغييرات واجهة التطبيقات من نفس وحدة التحكم المركزية المستخدمة لنشرها، ونصون مكوّنات Bot Store والمنطق المخصص معاً كنظام واحد بدلاً من رقعة من نصوص مُصانة فردياً.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VS ALTERNATIVES -->
<section class="section" aria-labelledby="vs-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="vs-heading" style="margin-bottom:1.5rem;">Automation Anywhere مقابل UiPath</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        المنصتان تتداخلان أكثر مما تختلفان. ميزة Automation Anywhere بنية أصيلة السحابة مبنية للإدارة المركزية من اليوم الأول: دون غرفة تحكم محلية لتركيبها، دون Orchestrator محلي لصيانته، ما يميل لتسهيل إدارة الطرح متعدد المكاتب والأقسام. ميزة <a href="/ar/services/ai-automation/tools/uipath">UiPath</a> قاعدة مُثبَّتة أكبر، نموذج نشر محلي أكثر نضجاً، وقاعدة أعمق من المطورين والشركاء المعتمدين. إذا أرادت مؤسستكم RPA مُدارة مركزياً عبر السحابة ببنية تحتية محلية أدنى، Automation Anywhere عادة نقطة البداية الأفضل. إذا كنتم تشغّلون أصلاً بكثافة محلياً، أو فريقكم لديه أصلاً خبرة UiPath، البقاء مع UiPath غالباً يكلف أقل من التبديل. ننفّذ كليهما ونستطيع إجراء تقييم قصير مقابل بيئتكم الفعلية قبل الالتزام بأي طريق.
      </p>
    </div>
  </div>
</section>

<!-- UAE CONTEXT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="uae-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="uae-heading" style="margin-bottom:1.5rem;">أين يناسب Automation Anywhere في الإمارات</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
