---
export const prerender = false;
import ArBaseLayout from "../../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../../lib/supabase";
import FaqAccordion from "../../../../../components/FaqAccordion.astro";

const h1 = 'وكالة أتمتة Zapier في الإمارات';
const metaTitle = 'وكالة أتمتة Zapier في الإمارات | Lenoo AI';
const metaDescription = 'تصمم وتبني Lenoo AI أتمتة Zapier للأعمال الإماراتية، تربط أدواتكم الحالية وتضيف طبقة ذكاء اصطناعي حيث تعجز المحفزات البسيطة.';
const heroSubtext = 'يربط Zapier تطبيقاتكم. نحن نصمم سير العمل، نُوصِّل الذكاء الاصطناعي حيث لا يستطيع محفز بسيط التعامل مع قرارات الحكم، ونصون كل شيء بعد الإطلاق.';

const useCases = [
  { title: 'أتمتة توجيه العملاء المحتملين', description: 'العملاء المحتملون الجدد من موقعكم أو إعلاناتكم أو WhatsApp يُقيَّمون ويُوجَّهون تلقائياً للمندوب الصحيح، مع قراءة الذكاء الاصطناعي لمحتوى الرسالة للحكم على النية قبل أن يحرّك Zapier البيانات.' },
  { title: 'سلاسل موافقة متعددة الخطوات', description: 'تقارير المصاريف، طلبات الشراء، وطلبات العقود تنتقل عبر الموافقة تلقائياً، مع تذكيرات وتصعيدات مبنية فوق حساب Zapier الحالي لديكم.' },
  { title: 'مزامنة CRM والبيانات', description: 'تبقى أداة CRM، أداة الفوترة، ومكتب الدعم لديكم متزامنة دون إعادة إدخال يدوي، مع خطوة ذكاء اصطناعي تنظّف وتتحقق من البيانات قبل وصولها للتطبيق الوجهة.' },
  { title: 'فرز صندوق الوارد والصياغة', description: 'رسائل الدعم والمبيعات الواردة تُصنَّف، تُرتَّب حسب الأولوية، وتُصاغ برد مقترح، فيراجع فريقكم ويرسل بدلاً من الكتابة من الصفر.' },
];

const faqFallback = [
  { question: 'هل نحتاج اشتراك Zapier قبل العمل معكم؟', answer: 'كلا الطريقين تعمل. إذا كان لديكم حساب Zapier أصلاً، نبني ضمنه. إذا لم يكن، نساعدكم على اختيار مستوى الخطة الصحيح بناءً على عدد الـ Zaps والمهام التي يحتاجها سير عملكم، ثم نبني من هناك.' },
  { question: 'ماذا تستطيعون فعله لا يستطيعه Zap وحده؟', answer: 'يحرّك Zapier البيانات بين التطبيقات عندما يُطلَق محفز. يعاني لحظة أن تحتاج مهمة حكماً: قراءة بريد إلكتروني لمعرفة النية، تحديد أي فئة من عدة فئات ينتمي إليها مستند، أو التعامل مع صيغة تختلف من حالة لأخرى. نضيف خطوة ذكاء اصطناعي داخل الـ Zap تتعامل بالضبط مع ذلك التفكير، ثم تترك Zapier يُنهي المهمة.' },
  { question: 'هل تستطيعون إصلاح أو تولّي Zaps بنيناها أصلاً؟', answer: 'نعم. نراجع Zaps الحالية بانتظام، نصلح ما ينكسر عند الحالات الحدية، وندمج الأتمتة المتناثرة في إعداد أكثر موثوقية مع مراقبة وتنبيهات.' },
  { question: 'كم يستغرق مشروع أتمتة Zapier نموذجي؟', answer: 'Zaps بسيطة متعددة الخطوات يمكن أن تُطلَق خلال أسبوع. المشاريع التي تشمل خطوات ذكاء اصطناعي، مراحل موافقة متعددة، أو عدة أنظمة متصلة تُحدَّد نطاقها فردياً بعد مكالمة اكتشاف.' },
  { question: 'ماذا يحدث عندما يغيّر Zapier طريقة عمل تكامل تطبيق ما؟', answer: 'تكاملات التطبيقات تتغير أحياناً من طرف Zapier، وهذا أحد أسباب بنائنا للمراقبة من اليوم الأول بدلاً من ترككم تكتشفون عطلاً بأنفسكم. كل مشروع نسلّمه يشمل نافذة مراقبة بعد الإطلاق، ونقدّم عقود صيانة للتغطية المستمرة بعد ذلك.' },
  { question: 'هل بياناتنا آمنة عبر Zapier وخطوة ذكاء اصطناعي؟', answer: 'نمرر فقط البيانات التي تحتاجها كل خطوة فعلياً، ونشرح لكم بالضبط ماذا يغادر أنظمتكم وإلى أين قبل أن يذهب أي شيء مباشراً. إذا كان سير عملكم يلمس بيانات حساسة، نستطيع أيضاً تحديد نطاق نسخة تبقي تفكير الذكاء الاصطناعي مستضافاً ذاتياً بدلاً من الاعتماد على إجراءات ذكاء اصطناعي Zapier.' },
];

let faqItems = faqFallback;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_tools_zapier')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    url: 'https://lenooai.com/ar/services/ai-automation/tools/zapier',
    description: metaDescription,
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'مشاريع أتمتة Zapier: التسعير حسب تعقيد سير العمل ونطاقه. احجزوا مكالمة اكتشاف مجانية للحصول على عرض سعر.' },
    serviceType: 'Zapier Automation Implementation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'الأدوات', item: 'https://lenooai.com/ar/services/ai-automation/tools' },
      { '@type': 'ListItem', position: 4, name: 'Zapier', item: 'https://lenooai.com/ar/services/ai-automation/tools/zapier' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath="/ar/services/ai-automation/tools/zapier"
  enPath="/services/ai-automation/tools/zapier"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation/tools" style="color:inherit;text-decoration:none;opacity:0.65;">الأدوات</a><span style="opacity:0.4;padding:0 4px;"> / </span>Zapier</div>
    <div class="tool-logo-hero"><img src="https://cdn.simpleicons.org/zapier/FF4A00" alt="شعار Zapier" width="56" height="56" loading="eager" /></div>
    <h1>{h1}</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      {heroSubtext}
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:2rem;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_tools_zapier_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#use-cases" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1760360059358-d5885a1d735c?w=1400&q=80&auto=format&fit=crop" alt="يد تحمل هاتفاً ذكياً يعرض شاشة رئيسية مليئة بأيقونات تطبيقات ملونة، تمثل التطبيقات التي يربطها Zapier معاً" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHAT IS ZAPIER -->
<section class="section" aria-labelledby="what-is-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="what-is-heading" style="margin-bottom:1.5rem;">ما هو Zapier؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        Zapier منصة أتمتة بلا كود تربط آلاف التطبيقات عبر محفزات وإجراءات: عندما يحدث شيء في أداة، تفعل شيئاً في أخرى. إنها المنصة الأكثر استخداماً في العالم للأتمتة، ومعظم الأعمال في الإمارات لديها أصلاً بضعة Zaps تعمل في مكان ما، غالباً بناها من في الفريق لديه الوقت لاكتشاف الأمر.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        جاذبيتها هي السرعة. يمكن لـ Zap أن ينتقل من فكرة إلى تشغيل حي خلال بعد ظهر واحد، دون مطور، لأن Zapier يتولى المصادقة، محفزات الاستطلاع أو webhook، وإعادة المحاولة عند الخطأ خلف الكواليس. تلك البساطة نفسها حدّها أيضاً: يتبع Zap مساراً ثابتاً من محفز إلى إجراء، مع حفنة من المرشحات ومنسّقات الصياغة المدمجة للمنطق الشرطي البسيط. لحظة أن يحتاج سير عمل قراءة فقرة نص وتقرير معناها، ينفد طريق Zapier وحده.
      </p>
    </div>
  </div>
</section>

<!-- HOW LENOO USES ZAPIER -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="how-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="how-heading" style="margin-bottom:1.5rem;">كيف تستخدم Lenoo AI منصة Zapier لبناءات الأتمتة الإماراتية</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        نحن شريك تنفيذ، لا موزّع Zapier. معظم الفرق التي تأتينا جرّبت بناء Zaps بنفسها واصطدمت بحائط: يحتاج سير العمل قراءة بريد إلكتروني غير منظّم، الحكم على ما إذا كانت فاتورة تبدو صحيحة، أو تحديد أي من عشر نتائج ممكنة ينطبق. هنا نأتي، نصمم المنطق الأساسي، نضيف خطوة ذكاء اصطناعي حيث لا تستطيع محفزات Zapier الأصلية التعامل معها، ونبني الأجزاء التي تحتاج كوداً مخصصاً عبر webhooks وإجراءات API الخاصة بـ Zapier.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        عادة يبدأ التعاون بمراجعتنا لأياً كانت الـ Zaps الموجودة أصلاً، لأن معظم الأعمال التي تتواصل معنا لديها على الأقل حفنة تعمل دون توثيق ودون أحد متأكد تماماً ماذا يحدث إذا انكسرت واحدة. نرسم ما تفعله كل واحدة فعلياً، نعلّم الهشة منها، ثم نصمم الأتمتة الجديدة حول سير عملكم الفعلي بدلاً من إجبار عمليتكم على ملاءمة إعدادات Zapier الافتراضية. حيث تحتاج خطوة حكماً، إجراء ذكاء اصطناعي يقرأ المدخل، يتخذ القرار، ويعيد نتيجة نظيفة إلى الـ Zap فيعمل بقية الأتمتة كأي خطوة أخرى. تنتهون بنظام يستطيع فريقكم رؤيته وفهمه في لوحة Zapier، لا صندوقاً أسود.
      </p>
    </div>
  </div>
</section>

<!-- FREE VS PAID -->
<section class="section" aria-labelledby="zapier-pricing-heading">
  <div class="container" style="max-width:800px;">
    <h2 id="zapier-pricing-heading" style="text-align:center; margin-bottom:1.5rem;">Zapier مجاني مقابل مدفوع</h2>
    <div class="zapier-toggle" role="tablist" aria-label="مستوى التسعير">
      <button type="button" id="zapier-tier-free" class="zapier-toggle-btn active" data-zapier-tier="free" role="tab" aria-selected="true" aria-controls="zapier-panel-free">مجاني</button>
      <button type="button" id="zapier-tier-paid" class="zapier-toggle-btn" data-zapier-tier="paid" role="tab" aria-selected="false" aria-controls="zapier-panel-paid">مدفوع</button>
    </div>
    <div class="card" id="zapier-panel-free" data-zapier-tier-panel="free" role="tabpanel" aria-labelledby="zapier-tier-free">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">خطة Zapier المجانية طريقة حقيقية لتشغيل أتمتة فعلية، لا مجرد تجربة. تشمل ١٠٠ مهمة شهرياً وسير عمل Zap غير محدود، رغم أن كل Zap محدد بخطوتين: محفز واحد وإجراء واحد. هذا يغطي اتصالاً واحداً واضحاً، كإدخال نموذج جديد يهبط في جدول بيانات، لكن لحظة أن يحتاج سير عمل أكثر من إجراء واحد لكل محفز، أو خطوة ذكاء اصطناعي مضافة، تصلون للسقف. نبني على المجانية عندما يناسب حجم مهام العميل الفعلي وشكل سير العمل تلك الحدود فعلياً، ونقول ذلك بصراحة عندما لا يناسب.</p>
    </div>
    <div class="card" id="zapier-panel-paid" data-zapier-tier-panel="paid" role="tabpanel" aria-labelledby="zapier-tier-paid" hidden>
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">الخطط المدفوعة تبدأ بـ Professional، مسعّرة من ١٩.٩٩ دولاراً شهرياً على خطة سنوية (أو ٢٩.٩٩ دولاراً بفوترة شهرية) مقابل ٧٥٠ مهمة، وتتصاعد من هناك مع نمو حجم مهامكم. هذا المستوى الذي يفتح Zaps متعددة الخطوات، فيستطيع محفز واحد إطلاق عدة إجراءات بالتسلسل، إلى جانب تطبيقات مميزة غير محدودة، webhooks للتكاملات المخصصة، والمرشحات وخطوات الذكاء الاصطناعي التي تعتمد عليها معظم بناءاتنا. نحدد المستوى الصحيح لحجم مهامكم الفعلي أثناء الاكتشاف بدلاً من الافتراض للخطة التي تبدو الأكثر أماناً، ولا نضيف هامش ربح فوق فاتورة Zapier الخاصة بكم.</p>
    </div>
  </div>
</section>

<!-- WHO THIS FITS -->
<section class="section" aria-labelledby="who-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="who-heading" style="margin-bottom:1.5rem;">هل Zapier مناسب لكم؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        Zapier عادة نقطة البداية الصحيحة للأعمال الإماراتية الصغيرة والمتوسطة التي تحتاج سير عمل حياً بسرعة، ليس لديها مطورون داخليون، وتؤتمت حفنة من العمليات الواضحة والمتكررة بدلاً من عشرات الأنظمة المترابطة.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        بضع إشارات ملموسة نراقبها: تدفعون أصلاً مقابل Zapier لكنكم غير متأكدين أنه يُستخدَم جيداً، لديكم خمس أو ست Zaps تعمل دون أحد متأكد تماماً لماذا بُنيت بتلك الطريقة، أو فريقكم يصطدم بنفس الخطوة اليدوية التي لا يبدو أن أي محفز بسيط يلتقطها. أي من هذه عادة إشارة تستحق مكالمة مراجعة قصيرة قبل أن نضيف أي شيء جديد.
      </p>
    </div>
  </div>
</section>

<!-- TYPICAL PROJECT -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="typical-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="typical-heading" style="margin-bottom:1.5rem;">كيف يبدو مشروع Zapier نموذجي معنا</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        معظم تعاونات Zapier تتبع نفس الشكل التقريبي، رغم أن الخطوات الدقيقة تتغير حسب ما تؤتمتونه وكم Zap يعمل أصلاً.
      </p>
      <ol class="journey-list" style="gap:1rem;">
        <li><strong style="color:#00253b;">الاكتشاف.</strong> نتحدث لفهم ما يبطئ فريقكم، أي تطبيقات متورطة، وهل أي Zaps لديكم أصلاً تستحق الاحتفاظ بها. إذا وُجدت Zaps، نطلب رؤيتها قبل تصميم أي شيء جديد.</li>
        <li><strong style="color:#00253b;">التصميم.</strong> نرسم سير العمل محفزاً بمحفز، نعلّم أين يؤدي إجراء بسيط المهمة وأين تحتاج خطوة إجراء ذكاء اصطناعي لقراءة المحتوى واتخاذ قرار.</li>
        <li><strong style="color:#00253b;">البناء والاختبار.</strong> نبني الـ Zap، أو مجموعة الـ Zaps، داخل حسابكم ونختبر مقابل بيانات حقيقية مسحوبة من عملكم لا سجلات نموذجية، فتظهر الحالات الحدية قبل الإطلاق لا بعده.</li>
        <li><strong style="color:#00253b;">الإطلاق والمراقبة.</strong> بمجرد الإطلاق، نراقب الـ Zap للأسابيع الأولى، نلتقط التشغيلات الفاشلة ونصلح أي شيء ينكسر مقابل مدخلات العالم الحقيقي التي لم تغطها بيانات الاختبار.</li>
      </ol>
    </div>
  </div>
</section>

<!-- VS ALTERNATIVES -->
<section class="section" aria-labelledby="vs-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="vs-heading" style="margin-bottom:1.5rem;">Zapier مقابل البدائل</h2>
