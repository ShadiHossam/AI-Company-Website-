<style>
.tool-logo-hero { width:64px; height:64px; border-radius:16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem; }
.value-card { display:flex; flex-direction:column; }
.journey-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; }
.journey-list li { position:relative; padding-right:1.75rem; color:#42474e; font-size:1.0625rem; line-height:1.85; }
.journey-list li::before { content:''; position:absolute; right:0; top:0.6em; width:9px; height:9px; border-radius:50%; background:#00e3fd; }
.make-toggle { display:flex; gap:0; justify-content:center; margin-bottom:1.5rem; background:#fff; border-radius:100px; padding:4px; border:1px solid rgba(0,37,59,0.1); max-width:420px; margin-left:auto; margin-right:auto; }
.make-toggle-btn { flex:1; padding:0.625rem 1.25rem; border-radius:100px; border:none; background:transparent; color:#42474e; font-size:0.875rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.make-toggle-btn.active { background:#006875; color:#fff; }
.make-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const makeToggleWrap = document.querySelector('.make-toggle');
  if (makeToggleWrap) {
    const makeBtns = makeToggleWrap.querySelectorAll('.make-toggle-btn');
    const makePanels = document.querySelectorAll('[data-make-tier-panel]');
    makeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-make-tier');
        makeBtns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        makePanels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-make-tier-panel') !== key; });
      });
    });
  }
</script>
