<style>
.tool-logo-wrap { background:#fff; border:1px solid #e6e9f0; border-radius:12px; width:56px; height:56px; display:flex; align-items:center; justify-content:center; margin-bottom:1rem; }
.value-card { display:flex; flex-direction:column; }
.automation-tools-tabs { display:flex; gap:0.5rem; justify-content:center; margin-bottom:2rem; flex-wrap:wrap; }
.automation-tools-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.automation-tools-tab-btn:hover { background:#e7eeff; }
.automation-tools-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
.automation-tools-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
[data-automation-tools-tab-panel][hidden] { display:none; }
</style>

<script>
  const automationToolsTabWrap = document.querySelector('.automation-tools-tabs');
  if (automationToolsTabWrap) {
    const btns = automationToolsTabWrap.querySelectorAll('.automation-tools-tab-btn');
    const panels = document.querySelectorAll('[data-automation-tools-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-automation-tools-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-automation-tools-tab-panel') !== key; });
      });
    });
  }
</script>
