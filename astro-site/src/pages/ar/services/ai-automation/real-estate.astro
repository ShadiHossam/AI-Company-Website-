.realestate-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.realestate-tab-btn:hover { background:#e7eeff; }
.realestate-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
.realestate-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
[data-realestate-tab-panel][hidden] { display:none; }
</style>

<script>
  const realestateTabWrap = document.querySelector('.realestate-tabs');
  if (realestateTabWrap) {
    const btns = realestateTabWrap.querySelectorAll('.realestate-tab-btn');
    const panels = document.querySelectorAll('[data-realestate-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-realestate-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-realestate-tab-panel') !== key; });
      });
    });
  }
</script>
