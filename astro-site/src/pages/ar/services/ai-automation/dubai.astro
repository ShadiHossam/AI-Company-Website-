---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../../components/ProcessSteps.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل تعملون في دبي حضورياً أم عن بُعد فقط؟", answer: "كلاهما. مقرنا في الخليج التجاري، فيمكننا الالتقاء شخصياً لجلسة الاكتشاف الأولى، ومراجعة سير عملك على أرض الواقع، والمتابعة في المحطات المهمة من المشروع. بعد إطلاق الأتمتة، يتم معظم الدعم عن بُعد لأنه أسرع للجميع، لكن الزيارة الحضورية متاحة دائماً إذا فضّلت اللقاء المباشر." },
  { question: "ما هي قطاعات دبي التي تتعاملون معها أكثر؟", answer: "العقارات وإدارة الممتلكات، التجارة واللوجستيات، الخدمات المهنية (المحاماة، المحاسبة، الاستشارات)، الضيافة، والتجزئة. مزيج دبي من الشركات الناشئة في المناطق الحرة والشركات الأكبر على البر الرئيسي يعني أننا نرى نطاقاً واسعاً من سير العمل، لكن النمط عادة واحد: إدخال بيانات متكرر، ومعالجة بريد إلكتروني، وموافقات تستهلك ساعات كل أسبوع." },
  { question: "هل تعملون مع الشركات المسجلة في مناطق حرة؟", answer: "نعم. سواء كانت شركتك مسجلة في DMCC أو JAFZA أو DIFC أو على البر الرئيسي، فعمل الأتمتة نفسه: يرتبط بالأدوات التي تستخدمها بالفعل، وليس بنوع الرخصة. بنينا حلول أتمتة لفرق صغيرة في مناطق حرة وعمليات أكبر على البر الرئيسي على حد سواء." },
  { question: "أين يقع فريقكم فعلياً؟", answer: "الخليج التجاري، دبي. لسنا وكالة عن بُعد تضع عنوان دبي للمظهر فقط. إذا أردت الجلوس معنا قبل الالتزام بأي شيء، يمكننا ترتيب ذلك." },
  { question: "كم يستغرق البدء بعد مكالمة الاكتشاف؟", answer: "عادة خلال أسبوع. مكالمة الاكتشاف تعطينا ما يكفي لتحديد نطاق أول أتمتة وإعطائك جدولاً زمنياً محدداً. من هناك، يعتمد وقت البناء على عدد الأنظمة المعنية، لكن معظم أول سير عمل يُطلق خلال 2 إلى 4 أسابيع." },
  { question: "هل تؤتمتون التواصل عبر واتساب للأعمال؟", answer: "نعم. ربط واجهة واتساب للأعمال البرمجية من أكثر الطلبات شيوعاً التي نتلقاها من عملاء دبي، خاصة في العقارات والضيافة والتجزئة، لأن الكثير من التواصل اليومي مع العملاء هنا يحدث عبر واتساب بدلاً من البريد الإلكتروني. نربطه بنفس طريقة ربط البريد الإلكتروني: نقرأ الرسائل الواردة، نُعدّ أو نُرسل الردود، ونسجّل المحادثة في نظام CRM لديك تلقائياً." },
  { question: "هل يمكنكم أتمتة عمليات تلمس بوابات حكومية إماراتية، مثل تجديد الرخصة التجارية أو إيجاري؟", answer: "حيثما تتيح البوابة شيئاً يمكننا العمل معه، تسجيل دخول، رفع مستند، واجهة برمجية، نستطيع أتمتة ما حولها. البوابات الحكومية وشبه الحكومية تختلف في مدى إمكانية أتمتتها؛ بعضها يدعم وصولاً برمجياً حقيقياً، وبعضها يتطلب خطوة يدوية لا يمكن تجاوزها كلياً. نخبرك خلال الاكتشاف بالضبط إلى أي مدى يمكن أتمتة بوابة محددة، بدلاً من افتراض أنها مرتبطة بالكامل." },
  { question: "كيف تتعاملون مع سير العمل المرتبط بضريبة القيمة المضافة في الأتمتة التي تبنونها؟", answer: "نحن لا نقدّم إقرارات ضريبة القيمة المضافة نيابة عنك، هذا يبقى مهمة محاسبك أو فريقك المالي. ما نؤتمته هو العمل اليدوي الذي يغذي ذلك: استخراج بيانات الفواتير، تصنيف المعاملات، وتجميع الأرقام التي يحتاجها محاسبك كل ربع سنة، فيصبح التقديم نفسه يتطلب بحثاً أقل في صناديق البريد وجداول البيانات." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ai_automation_dubai')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const processSteps = [
  { icon: "search", step: "الخطوة 1", title: "الاكتشاف، حضورياً أو عن بُعد", description: "نلتقي في الخليج التجاري أو عبر مكالمة فيديو لرسم سير عملك الحالي وتحديد الأتمتة الأسرع عائداً." },
  { icon: "edit", step: "الخطوة 2", title: "التصميم والتخطيط", description: "نصمم منطق الأتمتة، ونحدد المحفزات والمخرجات، ونحصل على موافقتك قبل كتابة أي كود." },
  { icon: "build", step: "الخطوة 3", title: "البناء والاختبار", description: "نبني الأتمتة ونختبرها على بياناتك الحقيقية قبل أن تلمس أي سير عمل فعلي." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "الإطلاق والمراقبة", description: "يتم إطلاق الأتمتة. نراقبها لمدة 90 يوماً، ونصلح أي شيء يحتاج إصلاحاً، ونحدد سير العمل التالي." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'AI Automation in Dubai',
    url: 'https://lenooai.com/services/ai-automation/dubai',
    description: 'AI automation implementation for Dubai businesses: workflow design, tool integration, and ongoing support from a Dubai-based team.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'Dubai, United Arab Emirates',
    offers: { '@type': 'Offer', description: 'AI automation projects for Dubai businesses: pricing based on workflow complexity and scope. Book a free discovery call for a quote.' },
    serviceType: 'AI Automation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'دبي', item: 'https://lenooai.com/ar/services/ai-automation/dubai' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="وكالة أتمتة الذكاء الاصطناعي في دبي | لينو إيه آي"
  description="تنفيذ أتمتة الذكاء الاصطناعي لشركات دبي: تصميم سير العمل، ربط الأدوات، ودعم مستمر من فريق مقيم في دبي."
  canonicalPath="/ar/services/ai-automation/dubai"
  enPath="/services/ai-automation/dubai"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>دبي</div>
    <h1>وكالة أتمتة الذكاء الاصطناعي في <span class="gradient-text">دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      لينو إيه آي فريق مقيم في الخليج التجاري، دبي. سواء كانت شركتك مؤسسة على البر الرئيسي أو في منطقة حرة مثل DMCC أو JAFZA أو DIFC، يمكننا الجلوس مع فريقك شخصياً لرسم سير العمل الذي يستحق الأتمتة، ثم بناءه على الأدوات التي تستخدمها بالفعل. بلا مدير حساب خارجي ينقل الرسائل ذهاباً وإياباً.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">مكالمات اكتشاف حضورية متاحة في دبي</span>
      <span class="tchip">ضمان استرداد الأموال إذا لم تكن راضياً عمّا نقدمه</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ai_automation_dubai_hero" class="btn-primary">احجز مكالمة اكتشاف مجانية</button>
      <a href="#what-we-automate" class="btn-outline">شاهد ما نقوم بأتمتته ↓</a>
    </div>
  </div>
</header>

<!-- صورة الغلاف -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="أتمتة سير العمل بالذكاء الاصطناعي لفريق أعمال في دبي" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- شريط الإحصاءات -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "40%", caption: "من المهام في معظم شركات الإمارات قابلة للأتمتة باستخدام الذكاء الاصطناعي المتاح حالياً. معظمها لم يبدأ بعد." },
      { value: "90 يوم", caption: "مراقبة ما بعد الإطلاق مشمولة في كل مشروع في دبي" },
      { value: "100%", caption: "ضمان استرداد الأموال إذا لم تكن راضياً عمّا نقدمه" },
    ]} />
  </div>
</div>

<!-- لماذا فريق محلي -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">لماذا تعمل مع وكالة أتمتة ذكاء اصطناعي مقيمة في دبي؟</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الكثير من مزودي الأتمتة يبيعون في دبي من مكان آخر. هذا يعمل جيداً حتى يتعطل شيء ما في الساعة الرابعة عصراً يوم أربعاء وأنت تنتظر رداً من منطقة زمنية مختلفة. نحن في الخليج التجاري. إذا أردت مناقشة مشكلة وجهاً لوجه، أو استضافتنا لجلسة عمل مع فريقك، فالأمر لا يتطلب أكثر من قيادة قصيرة، لا رحلة طيران.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        كوننا محليين يعني أيضاً أننا نفهم كيف تسير الأعمال هنا فعلياً: أسبوع العمل من الأحد إلى الخميس، الفرق بين معاملات المناطق الحرة والبر الرئيسي، دورات تقديم ضريبة القيمة المضافة، وحقيقة أن كثيراً من شركات دبي تعمل بفرق صغيرة لا تقدر على توظيف شخص مخصص فقط لإبقاء الأنظمة متصلة ببعضها. للاطلاع على شرح كامل لما هي أتمتة الذكاء الاصطناعي وكيف تختلف عن أدوات مثل Zapier أو Make، راجع <a href="/ar/services/ai-automation">الصفحة الرئيسية لأتمتة الذكاء الاصطناعي</a>. هذه الصفحة تركز على ما يعنيه ذلك لشركة تعمل في دبي تحديداً.
      </p>
    </div>
  </div>
</section>

<!-- الأدوات التي نربطها -->
<section class="section" aria-labelledby="stack-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="stack-heading">الأدوات التي نربطها عادة بشركات دبي</h2>
      <p style="color:#42474e; font-size:1.0625rem;">لمحة عما نربط به الأتمتة غالباً عبر شركات دبي. إذا لم تكن أدواتك مذكورة هنا، اسألنا؛ نبني فوق ما تستخدمه بالفعل.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">contacts</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">إدارة علاقات العملاء والمبيعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Zoho CRM وHubSpot وSalesforce وPipedrive تظهر عبر معظم القطاعات هنا، من وسطاء العقارات إلى شركات التجارة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">receipt_long</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">المحاسبة والمالية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Zoho Books وQuickBooks وXero وTally هي الأنظمة الأكثر شيوعاً التي نربط بها أتمتة الفواتير والتسويات.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">chat</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">التواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">واتساب للأعمال وGmail وOutlook وMicrosoft Teams هي حيث يحدث معظم تواصل العملاء والفريق فعلياً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">apartment</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">منصات العقارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">خلاصات إعلانات Property Finder وBayut، أوراق الإيجار، ومصادر العملاء المحتملين القادمة من المنصات، لوسطاء ومديري عقارات دبي.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">المشاريع والعمليات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Monday.com وAsana وNotion وGoogle Workspace، مربوطة حتى تتوقف تحديثات الحالة والتسليمات عن العيش في ذهن أحدهم فقط.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">storefront</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">التجزئة والتجارة الإلكترونية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">Shopify وSalla وأنظمة نقاط البيع الشائعة، مُزامَنة مع بيانات المخزون والطلبات فلا يحتاج شيء تحديثاً مرتين.</p>
      </div>
    </div>
  </div>
</section>

<!-- ما نقوم بأتمتته -->
<section id="what-we-automate" class="section" style="background:#f0f3ff;" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">أتمتة الذكاء الاصطناعي التي نبنيها لشركات دبي</h2>
      <p style="color:#42474e; font-size:1.0625rem;">نفس فئات الأتمتة التي نبنيها لأي عميل، مُكيّفة مع ما يظهر فعلياً في شركات دبي يومياً.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">home_work</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">العقارات وإدارة الممتلكات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">متابعة العملاء المحتملين، ومزامنة الإعلانات عبر المنصات، ومعالجة مستندات المستأجرين، مؤتمتة بدلاً من ملاحقتها يدوياً.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> وسيط عقاري في دبي كان يفقد عملاء محتملين خلال عطلة نهاية الأسبوع، أصبح الآن كل استفسار وارد مؤهلاً ومتابَعاً خلال دقائق، أي يوم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">التجارة واللوجستيات والمستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">بوليصات الشحن، أوراق الجمارك، وفواتير الموردين تُقرأ وتُتحقق منها وتُرحّل إلى نظامك دون إدخال يدوي.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> شركة تجارية اختصرت وقت مطابقة الفواتير بأوامر الشراء من يوم كامل أسبوعياً إلى أقل من ساعة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">business_center</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">الإدارة للمناطق الحرة والبر الرئيسي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تذكيرات تجديد الرخص، وتوليد العقود، وقوائم الامتثال التي تعمل بنفسها بدلاً من أن تبقى في صندوق بريد أحدهم.</p>
