<style>
.value-card { display:flex; flex-direction:column; }
.business-tabs { display:flex; gap:0.5rem; justify-content:center; margin-bottom:2rem; flex-wrap:wrap; }
.business-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.business-tab-btn:hover { background:#f0f3ff; }
.business-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
.business-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
[data-business-tab-panel][hidden] { display:none; }
</style>

<script>
  const businessTabWrap = document.querySelector('.business-tabs');
  if (businessTabWrap) {
    const btns = businessTabWrap.querySelectorAll('.business-tab-btn');
    const panels = document.querySelectorAll('[data-business-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-business-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-business-tab-panel') !== key; });
      });
    });
  }
</script>
