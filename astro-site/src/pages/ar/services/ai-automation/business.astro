---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../../components/ProcessSteps.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل أتمتة الذكاء الاصطناعي للشركات الكبيرة فقط؟", answer: "لا. الفرق الأصغر غالباً ترى العائد أسرع، لأنه لا يوجد من تفوّض له العمل اليدوي عندما يتراكم. شركة بعشرة أشخاص تؤتمت حفنة من سير العمل الأساسي تستطيع تحرير ما يعادل توظيفاً بدوام كامل دون إضافة موظفين. النطاق والسعر يتناسبان مع حجم المشروع، لا حجم شركتكم." },
  { question: "كيف نعرف أي العمليات نؤتمت أولاً؟", answer: "ابدؤوا بما يستهلك أكثر الساعات أو يسبب أكثر الأخطاء حالياً: فرز البريد الوارد، إدخال الفواتير، متابعة العملاء المحتملين، وكتابة التقارير هي المرشحون المعتادون. مكالمة اكتشاف قصيرة كافية لتحديد أفضل ٢-٣ فرص لديكم وترتيبها حسب الوقت المتوقع توفيره مقابل جهد البناء." },
  { question: "ما الجدول الزمني الواقعي لعائد الاستثمار؟", answer: "سير العمل البسيط، مثل توجيه البريد الإلكتروني الآلي أو تسجيل العملاء المحتملين، غالباً يُظهر توفيراً ملموساً في الوقت خلال الأسابيع الأولى من الإطلاق. المشاريع الأكبر متعددة الأنظمة تستغرق وقتاً أطول للبناء لكن عادة تسترد تكلفتها خلال بضعة أشهر بمجرد تشغيلها، لأن التوفير يتراكم كل أسبوع تبقى فيه الأتمتة عاملة." },
  { question: "هل نحتاج موظفين تقنيين داخليين لصيانتها؟", answer: "لا. نتولى البناء، التكامل، و٩٠ يوماً من المراقبة بعد الإطلاق. لا تحتاجون مطوراً داخلياً لإبقائها عاملة. إذا أردتم إجراء تعديلات صغيرة بأنفسكم لاحقاً، نوثّق الأتمتة بوضوح كافٍ ليفهمها عضو فريق غير تقني." },
  { question: "هل ستستبدل الأتمتة وظائف في فريقنا؟", answer: "في معظم المشاركات، لا. الهدف إزالة الأجزاء المتكررة من وظيفة، مثل إدخال البيانات أو التوجيه اليدوي، فيقضي من يؤديها وقته في الأحكام، العلاقات، والعمل الذي يحتاج فعلياً بشراً. معظم الأعمال تعيد توظيف ذلك الوقت المُحرَّر بدلاً من إلغاء الدور." },
  { question: "كم تكلف أتمتة الذكاء الاصطناعي عادة لعمل بحجمنا؟", answer: "تتناسب مع عدد سير العمل والأنظمة المعنية، لا سعر ثابت حسب حجم الشركة. سير عمل واحد محدد جيداً يكلف أقل من مشروع يلمس عدة أنظمة بعدة نقاط قرار. الطريقة الوحيدة للحصول على رقم صادق مكالمة اكتشاف حيث يُحدَّد نطاق سير العمل الفعلي، كونوا متشككين من أي شخص يعرض سعراً قبل رؤيتها." },
  { question: "هل نستطيع أتمتة سير عمل واحد الآن وإضافة المزيد لاحقاً؟", answer: "نعم، وعادة هذا النهج الأفضل. البدء بسير عمل واحد محصور يتيح لكم رؤية الأتمتة تعمل على بيانات حقيقية قبل الالتزام بميزانية لطرح أكبر. معظم المشاركات مُنظَّمة بهذه الطريقة: إثبات سير العمل الأول، ثم التوسع للتالي بمجرد أن يعمل ويُراقَب." },
  { question: "ما أكبر سبب لفشل مشاريع الأتمتة؟", answer: "عادة نطاق غير واضح، لا التقنية. المشروع الذي يبدأ دون تعريف مكتوب لأي سير عمل، أي أنظمة، وكيف يبدو 'الإنجاز' يميل للانحراف، تفويت المشكلة الفعلية، أو التوقف. الجزء التقني نادراً ما يكون الصعب؛ الاتفاق على ماذا يُبنى بالضبط هو الصعب." },
  { question: "هل يجب أن نؤتمت كل شيء دفعة واحدة أم نعمل عبر مراحل؟", answer: "مراحل، دائماً تقريباً. أتمتة سير عمل واحد، مراقبته يعمل على بيانات حقيقية لبضعة أسابيع، ثم الانتقال للتالي يعطيكم نقطة مرجعية عاملة ويتيح لكم رصد المشاكل بينما لا تزال المخاطر صغيرة. الأعمال التي تحاول أتمتة كل شيء في طرح واحد تميل لأصعب وقت في عزل ما يعمل فعلياً." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_business')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "تدقيق العملية", description: "ننظر إلى أين يذهب وقت فريقكم فعلياً ونرتب فرص الأتمتة حسب العائد المتوقع." },
  { icon: "edit", step: "الخطوة ٢", title: "التصميم والتخطيط", description: "نصمم منطق الأتمتة ونحصل على موافقتكم على النطاق والتكلفة قبل بدء أي عمل بناء." },
  { icon: "build", step: "الخطوة ٣", title: "البناء والاختبار", description: "نبني مقابل بياناتكم الحقيقية ونختبرها في بيئة تجريبية حتى تصمد تحت الاستخدام العادي." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "الإطلاق والمراقبة", description: "تُطلَق الأتمتة. نراقبها لمدة ٩٠ يوماً ونتوسع لسير العمل التالي بمجرد إثباتها." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'أتمتة الذكاء الاصطناعي للأعمال',
    url: 'https://lenooai.com/ar/services/ai-automation/business',
    description: 'كيف تستخدم الشركات الإماراتية أتمتة الذكاء الاصطناعي لتقليل العمل اليدوي عبر المبيعات والعمليات والمالية والدعم، مع أمثلة سير عمل حقيقية وإرشادات عائد استثمار.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'United Arab Emirates',
    offers: { '@type': 'Offer', description: 'أتمتة الذكاء الاصطناعي للأعمال: محددة النطاق ومُسعَّرة بعد مكالمة اكتشاف مجانية.' },
    serviceType: 'AI Automation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'الأعمال', item: 'https://lenooai.com/ar/services/ai-automation/business' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="أتمتة الذكاء الاصطناعي للأعمال | Lenoo AI"
  description="كيف تستخدم الشركات الإماراتية أتمتة الذكاء الاصطناعي لتقليل العمل اليدوي عبر المبيعات والعمليات والدعم، مع أمثلة سير عمل حقيقية."
  canonicalPath="/ar/services/ai-automation/business"
  enPath="/services/ai-automation/business"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>الأعمال</div>
    <h1>أتمتة الذكاء الاصطناعي <span class="gradient-text">للأعمال</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      العمل اليدوي يكلف عملاً أكثر مما يبدو على الورق: ساعات في إدخال البيانات، متابعات متأخرة، وأخطاء يجب إصلاحها لاحقاً. إليكم أين تُثمر أتمتة الذكاء الاصطناعي فعلياً عبر المبيعات والعمليات والمالية والدعم، وكيف تجدون نقطة بدايتكم.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">محدد النطاق لميزانيتكم بعد مكالمة اكتشاف مجانية</span>
      <span class="tchip">ضمان استرداد إذا لم تكونوا راضين</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_business_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#by-function" class="btn-outline">شاهدوا أين تبدؤون ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=1400&q=80&auto=format&fit=crop" alt="فريق عمل يراجع بيانات العمليات وسير العمل" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "٤٠٪", caption: "من مهام العمل في معظم الشركات قابلة للأتمتة بالذكاء الاصطناعي المتاح حالياً، وفقاً لبحث McKinsey." },
      { value: "٩٠ يوماً", caption: "مراقبة بعد الإطلاق مشمولة في كل مشروع، فلا ينكسر شيء بصمت" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHY IT MATTERS -->
<section class="section" aria-labelledby="why-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="why-heading" style="margin-bottom:1.5rem;">لماذا تهم أتمتة الذكاء الاصطناعي للأعمال</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        الحجة لصالح أتمتة الذكاء الاصطناعي تعود لثلاثة أمور: الوقت، الدقة، وعدد الموظفين. كل ساعة يقضيها فريق في إدخال بيانات، متابعة يدوية، أو نسخ ولصق بين أنظمة هي ساعة لا تُقضى في المبيعات، الخدمة، أو عمل يحتاج فعلياً حكماً. العمليات اليدوية أيضاً تحمل أخطاء أكثر من الآلية، لأن الإرهاق وعدم الاتساق يتسللان عبر يوم طويل.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        جانب عدد الموظفين يهم أكثر مع نمو العمل. دون أتمتة، طلبات أكثر، عملاء محتملون أكثر، أو تذاكر دعم أكثر عادة تعني توظيف المزيد من الأشخاص لمعالجتها. مع الأتمتة الصحيحة، الحجم يستطيع النمو دون أن ينمو كل وظيفة بنفس المعدل. تلك الحجة المالية الحقيقية: ليست استبدال الناس، بل السماح للعمل بالتوسع دون أن يتوسع العمل اليدوي معه بنفس الوتيرة.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        طريقة بسيطة للتفكير في تكلفة العمل اليدوي هي ضرب الساعات المُنفَقة بما تساويه فعلياً للعمل. ساعة يقضيها مندوب مبيعات في إدخال بيانات هي ساعة لا يقضيها في مكالمات تتحول لإيرادات. ساعة يقضيها فريق مالية في تسوية جداول بيانات يدوياً هي ساعة تؤخر الأرقام التي ينتظرها الجميع. لا شيء من هذا يظهر كبند في ميزانية، وهذا بالضبط سبب ميله للتجاهل حتى يجمعه أحدهم فعلياً. الأتمتة لا تُزيل الحاجة للحكم، الإشراف، أو العلاقات. تُزيل الأجزاء من الوظيفة التي لم تكن تستخدم أياً من ذلك أصلاً.
      </p>
    </div>
  </div>
</section>

<!-- ROI BY BUSINESS SIZE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="roi-size-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="roi-size-heading">كيف يختلف عائد استثمار الأتمتة حسب حجم العمل</h2>
      <p style="color:#42474e; font-size:1.0625rem;">فترة استرداد التكلفة ليست نفسها لفريق بخمسة أشخاص وشركة بمئتين. إليكم كيف تسير الأمور عادة بأحجام مختلفة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">groups</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">فريق صغير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">الفرق الصغيرة غالباً ترى أسرع استرداد للتكلفة، لأنه لا يوجد من تُسلَّم له الأعمال الفائضة. عندما يكون من يتعامل مع العملاء المحتملين، الفواتير، أو تذاكر الدعم مثقلاً أصلاً، أتمتة حتى سير عمل واحد تُزيل ساعات من شخص يغطي عدة أدوار في آن واحد، غالباً خلال الشهر أو الشهرين الأولين من الإطلاق.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">apartment</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">عملية متوسطة الحجم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">الأعمال متوسطة الحجم عادة لديها سير عمل أكثر يستحق الأتمتة، لكن أيضاً أنظمة أكثر موجودة أصلاً: نظام CRM، أداة مالية منفصلة، مكتب دعم. الاسترداد هنا يميل للحدوث من ربط تلك الأنظمة، لأن مزامنة البيانات بين CRM وأداة مالية تُزيل عمل تسوية كان سيحتاج منسّقاً مخصصاً مع نمو العمل.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">domain</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">عملية أكبر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">بهذا الحجم، الحجة تتحول من "توفير الوقت" إلى "تجنب التوظيف". الحجم، عملاء محتملون أكثر، معاملات أكثر، تذاكر دعم أكثر، ينمو سواء نما عدد الموظفين معه أم لا. فترة الاسترداد غالباً أطول، لأن التكاملات تميل للتعقيد أكثر، لكن التوفير الإجمالي يتراكم عبر قاعدة أكبر بكثير من العمل المتكرر.</p>
      </div>
    </div>
  </div>
</section>

<!-- STRATEGY MEETING IMAGE BAND -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1758873268998-2f77c2d38862?w=1400&q=80&auto=format&fit=crop" alt="أعضاء فريق يناقشون خطة على لوح ورقي أثناء اجتماع استراتيجي" loading="lazy" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 25%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- BUILD VS BUY VS AGENCY -->
<section class="section" aria-labelledby="build-buy-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-buy-heading">ابنوها بأنفسكم، اشتروا أداة جاهزة، أو وظّفوا وكالة</h2>
      <p style="color:#42474e; font-size:1.0625rem;">توجد ثلاثة مسارات حقيقية لأتمتة سير عمل. لكل منها مفاضلة حقيقية. إليكم كيف تفكرون في أيها يناسب.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">engineering</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ابنوها بأنفسكم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">استخدام الموظفين الحاليين، ربما شخص مرتاح مع أدوات بلا كود، لبناء الأتمتة داخلياً. هذا يكلف الأقل نقداً لكن الأكثر وقتاً، ويعتمد على بقاء ذلك الشخص في الشركة وامتلاكه للسعة لصيانة ما يبنيه. يعمل جيداً لسير عمل واحد وبسيط بمحفز واحد وإجراء واحد، ويميل للانهيار بمجرد تدخل عدة أنظمة وحالات حدية.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span></div>
