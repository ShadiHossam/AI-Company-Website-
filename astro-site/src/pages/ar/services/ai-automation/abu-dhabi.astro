---
export const prerender = false;
import ArBaseLayout from "../../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../../lib/supabase";
import FaqAccordion from "../../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../../components/ProcessSteps.astro";
import StatStrip from "../../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل لديكم مكتب في أبوظبي؟", answer: "لا، مقرنا في الخليج التجاري، دبي. نخدم شركات أبوظبي عن بُعد افتراضياً ونحضر حضورياً لجلسات الاكتشاف أو المحطات الرئيسية عندما يكون ذلك مفيداً، وهو لمعظم مشاريع الأتمتة نادراً أكثر من مرة أو مرتين. أبوظبي تبعد أقل من ساعتين، فالزيارة الحضورية ليست مستبعدة أبداً." },
  { question: "هل تعملون مع جهات إماراتية متصلة بالحكومة أو منظمة؟", answer: "نعم، ضمن حدود معقولة. بنينا أتمتة لشركات تعمل تحت متطلبات امتثال قطاعية محددة. سنخبركم مسبقاً إذا كان طلب يقع خارج ما نستطيع دعمه، لكن معظم أتمتة سير العمل، معالجة المستندات، وعمل تكامل الأنظمة لا يتطلب تصريحاً خاصاً." },
  { question: "كيف تتعاملون مع الامتثال وحماية البيانات لمؤسسات أبوظبي؟", answer: "نصمم الأتمتة لتعمل ضمن قانون حماية البيانات الشخصية الإماراتي (PDPL). هذا يعني رسم أين تنتقل البيانات قبل بناء أي شيء، إبقاء البيانات الحساسة داخل أنظمة تتحكمون بها أصلاً حيث ممكن، وتجنب توجيه بيانات شخصية عبر أدوات لا تلبي متطلبات التعامل مع البيانات الإماراتية." },
  { question: "هل التسليم عن بُعد جيد فعلياً كوجود فريق محلي؟", answer: "لمعظم عمل الأتمتة، نعم. البناء نفسه يحدث بنفس الطريقة سواء كنا حضوريين أم لا: نصمم سير العمل، نحصل على موافقتكم، نبنيه مقابل أنظمتكم الحقيقية، ونختبره قبل إطلاقه. ما يتغير هو كيف ندير مكالمات الاكتشاف والمتابعة، ونحن مرنون في ذلك بناءً على ما يناسب فريقكم." },
  { question: "هل تتعاملون مع متطلبات إقامة البيانات لمنظمات أبوظبي المنظمة؟", answer: "حيث ينطبق متطلب إقامة بيانات محدد، بيانات يجب أن تبقى على بنية تحتية موجودة فعلياً في الإمارات مثلاً، نبني الأتمتة حول بنية تحتية تلبي ذلك بدلاً من معاملته كفكرة لاحقة. هذا يظهر أكثر مع العملاء المتصلين بالحكومة والقطاع المالي، ونعالجه أثناء جلسة الاكتشاف قبل بدء أي تصميم سير عمل." },
  { question: "هل تستطيعون العمل ضمن عملية مشتريات رسمية؟", answer: "نعم. نستطيع العمل ببيانات عمل محددة النطاق، محطات ثابتة، والتوثيق الذي تتطلبه عادة المنظمات الأكبر والمتصلة بالحكومة قبل إدخال مزود. أخبرونا بمتطلبات مشترياتكم أثناء المكالمة الأولى وسنبني المشاركة حولها بدلاً من مطالبتكم بالتكيف مع عملية غير رسمية." },
  { question: "ماذا يحدث إذا احتاجت منظمتنا مراجعة أمنية أو مراجعة مزود قبل التعاقد معكم؟", answer: "نكمل استبيانات الأمن ووثائق العناية الواجبة للمزود كجزء من الإدخال عند الحاجة. يضيف وقتاً لبداية المشروع، لا للبناء نفسه، ونأخذ ذلك بعين الاعتبار في الجدول الزمني الذي نعطيكم إياه مسبقاً بدلاً من معاملته كتأخير مفاجئ." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_automation_abu_dhabi')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "مكالمة اكتشاف", description: "نرسم سير عملكم الحالي عبر مكالمة فيديو، أو حضورياً إذا فضّلتم اللقاء شخصياً، ونحدد الأتمتة التي تستحق البناء أولاً." },
  { icon: "edit", step: "الخطوة ٢", title: "التصميم والتخطيط", description: "نصمم منطق الأتمتة، نرسم أي متطلبات امتثال، ونحصل على موافقتكم قبل البناء." },
  { icon: "build", step: "الخطوة ٣", title: "البناء والاختبار", description: "نبني الأتمتة ونختبرها مقابل بياناتكم الحقيقية قبل أن تلمس سير عمل فعلياً." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "الإطلاق والمراقبة", description: "تُطلَق الأتمتة. نراقبها لمدة ٩٠ يوماً ونصلح أي شيء يحتاج إصلاحاً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'أتمتة الذكاء الاصطناعي في أبوظبي',
    url: 'https://lenooai.com/ar/services/ai-automation/abu-dhabi',
    description: 'خدمات أتمتة الذكاء الاصطناعي لشركات أبوظبي: أتمتة العمليات، تكامل الأنظمة، ونشر متوافق مع PDPL.',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'Abu Dhabi, United Arab Emirates',
    offers: { '@type': 'Offer', description: 'مشاريع أتمتة ذكاء اصطناعي لشركات أبوظبي: التسعير حسب تعقيد سير العمل والنطاق. احجزوا مكالمة اكتشاف مجانية للحصول على عرض سعر.' },
    serviceType: 'AI Automation',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'أتمتة الذكاء الاصطناعي', item: 'https://lenooai.com/ar/services/ai-automation' },
      { '@type': 'ListItem', position: 3, name: 'أبوظبي', item: 'https://lenooai.com/ar/services/ai-automation/abu-dhabi' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArBaseLayout
  title="أتمتة الذكاء الاصطناعي في أبوظبي | Lenoo AI"
  description="خدمات أتمتة الذكاء الاصطناعي لشركات أبوظبي: أتمتة العمليات، تكامل الأنظمة، ونشر متوافق مع PDPL."
  canonicalPath="/ar/services/ai-automation/abu-dhabi"
  enPath="/services/ai-automation/abu-dhabi"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services/ai-automation" style="color:inherit;text-decoration:none;opacity:0.65;">أتمتة الذكاء الاصطناعي</a><span style="opacity:0.4;padding:0 4px;"> / </span>أبوظبي</div>
    <h1>أتمتة الذكاء الاصطناعي في <span class="gradient-text">أبوظبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:640px; margin:1.5rem auto 0; line-height:1.8;">
      Lenoo AI فريق أتمتة مقره دبي يخدم شركات أبوظبي، عن بُعد افتراضياً وحضورياً عندما يكون منطقياً. نصمم ونبني أتمتة تربط الأدوات التي تشغّلونها أصلاً، تتعامل مع متطلبات حماية بيانات PDPL منذ البداية، وتُزيل العمل اليدوي من سير العمل الذي يكرره فريقكم كل يوم.
    </p>
    <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
      <span class="tchip">تعامل مع البيانات مراعٍ لـ PDPL مبني في كل مشروع</span>
      <span class="tchip">ضمان استرداد إذا لم تكونوا راضين عما نقدمه</span>
    </div>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_ai_automation_abu_dhabi_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
      <a href="#what-we-automate" class="btn-outline">شاهدوا ما نؤتمته ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1400&q=80&auto=format&fit=crop" alt="أتمتة سير عمل بالذكاء الاصطناعي لعمل في أبوظبي" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#00253b,#006875); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "٤٠٪", caption: "من مهام العمل في معظم شركات الإمارات قابلة للأتمتة بالذكاء الاصطناعي المتاح حالياً. معظمها لم يبدأ بعد." },
      { value: "٩٠ يوماً", caption: "مراقبة ما بعد الإطلاق مشمولة في كل مشروع" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- EXPLAINER -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto;">
      <h2 id="explain-heading" style="margin-bottom:1.5rem;">أتمتة الذكاء الاصطناعي لشركات أبوظبي، مُسلَّمة عن بُعد أو حضورياً</h2>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        لا نملك مبنى في أبوظبي، ولن نتظاهر بعكس ذلك. ما لدينا فريق مقره دبي يبني الأتمتة بنفس الطريقة لعملاء أبوظبي كأي شخص آخر: رسم سير العمل، تصميمه، بناؤه مقابل أنظمتكم الحقيقية، اختباره، ودعمه بعد الإطلاق. معظم ذلك يحدث عبر مكالمة فيديو. إذا وصل مشروع لنقطة تستحق فيها الجلسة في غرفة واحدة القيادة، نقود.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
        أبوظبي لديها تركيز أثقل من جهات متصلة بالحكومة ومنظمة من معظم الإمارات، فالتعامل مع البيانات يهم أكثر هنا، لا أقل. نبني مع وضع قانون حماية البيانات الشخصية الإماراتي (PDPL) في الاعتبار منذ البداية: رسم أين تنتقل البيانات، إبقاء المعلومات الحساسة داخل أنظمة تتحكمون بها أصلاً حيث ممكن، وتعليم أي شيء يحتاج نظرة أقرب قبل أن نلمسه. للشرح الكامل لماهية أتمتة الذكاء الاصطناعي وكيف تقارن بأدوات قائمة على القواعد مثل Zapier، راجعوا <a href="/ar/services/ai-automation">صفحة أتمتة الذكاء الاصطناعي الرئيسية</a>.
      </p>
      <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
        العملاء الذين نعمل معهم هنا عادة مزيج من بضعة أنواع: شركات طاقة وصناعية بطبقات موافقة داخلية مبنية في كل شيء، جهات شبه حكومية ومرتبطة بالسيادة بمتطلبات مزودين ومشتريات رسمية، وعدد متنامٍ من شركات الخدمات المهنية والاستشارية التي تخدم تلك المنظومة نفسها وترث توقعاتها حول التوثيق والتعامل مع البيانات. كل من هذه يجلب نقطة بداية مختلفة للأتمتة، لكن العمل الأساسي واحد: رسم سير العمل، التصميم حول القيود التي تنطبق فعلياً على منظمتكم، وبناء شيء يصمد أمام مراجعة داخلية بدلاً من شيء يبدو جيداً في عرض توضيحي فقط.
      </p>
    </div>
  </div>
</section>

<!-- ABU DHABI SKYLINE BAND -->
<div style="position:relative; overflow:hidden; height:260px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1613835579153-9bfe32e50da6?w=1400&q=80&auto=format&fit=crop" alt="أفق أبوظبي عند الغروب، مع أبراج الاتحاد والكورنيش" loading="lazy" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- WHAT WE AUTOMATE -->
<section id="what-we-automate" class="section" style="background:#f0f3ff;" aria-labelledby="automate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="automate-heading">أتمتة الذكاء الاصطناعي التي نبنيها لشركات أبوظبي</h2>
      <p style="color:#42474e; font-size:1.0625rem;">فئات شائعة، لا قائمة شاملة. كلها مبنية على أدواتكم الحالية ومدعومة بعد الإطلاق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">description</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">معالجة المستندات والفواتير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العقود، الفواتير، والنماذج تُعالَج تلقائياً. الذكاء الاصطناعي يستخرج البيانات، يتحقق منها، ويرحّلها لأنظمتكم.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق عمليات توقف عن إدخال فواتير الموردين يدوياً؛ الذكاء الاصطناعي الآن يطابق كل واحدة مع أمر شراء ويرحّلها مباشرة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">سير عمل الموافقات والامتثال</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">موافقات متعددة الخطوات تنتقل من التقديم للاعتماد تلقائياً، بتذكيرات وتصعيدات ومسار تدقيق مبني فيها.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> موافقات المصاريف التي كانت تجلس في بريد أحدهم لأسبوع الآن تُوجَّه، تذكّر، وتصعّد بنفسها.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">sync_alt</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">مزامنة بيانات عبر الأنظمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أبقوا نظام CRM وERP وأدوات التواصل متزامنة تلقائياً، دون أن ينسخ أحد بيانات بين المنصات يدوياً.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق كان يحدّث ثلاثة أنظمة منفصلة يدوياً بعد كل صفقة الآن يحدّث واحداً، والباقي يتزامن بنفسه.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">mail</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">أتمتة البريد الإلكتروني والمراسلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الذكاء الاصطناعي يقرأ، يصنّف، ويوجّه المراسلات الواردة، يصيغ ردوداً، ويصعّد أي شيء يحتاج حكم شخص قبل وصوله لصندوق وارد.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> صندوق امتثال مشترك كان يستهلك معظم صباح فريق لفرزه يومياً الآن يُرتَّب ويُصاغ تلقائياً، مع استثناءات حقيقية فقط للمراجعة.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">route</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">توجيه العملاء المحتملين والاستفسارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الاستفسارات الواردة تُسجَّل، تُسنَد للشخص الصحيح، وتُتابَع تلقائياً، سواء وصلت عبر نموذج، بريد إلكتروني، أو إحالة.</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;"><strong>مثال حقيقي:</strong> فريق مبيعات مؤسسي انتقل من متوسط استجابة اليوم التالي لأقل من ١٥ دقيقة، دون إضافة موظفين.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">تقارير آلية</h3>
