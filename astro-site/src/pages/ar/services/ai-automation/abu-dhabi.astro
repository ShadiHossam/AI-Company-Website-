<style>
.value-card { display:flex; flex-direction:column; }
.abudhabi-toggle { display:flex; gap:0; justify-content:center; margin-bottom:1.5rem; background:#fff; border-radius:100px; padding:4px; border:1px solid rgba(0,37,59,0.1); max-width:420px; margin-left:auto; margin-right:auto; }
.abudhabi-toggle-btn { flex:1; padding:0.625rem 1.25rem; border-radius:100px; border:none; background:transparent; color:#42474e; font-size:0.875rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
.abudhabi-toggle-btn.active { background:#006875; color:#fff; }
.abudhabi-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const abudhabiToggleWrap = document.querySelector('.abudhabi-toggle');
  if (abudhabiToggleWrap) {
    const btns = abudhabiToggleWrap.querySelectorAll('.abudhabi-toggle-btn');
    const panels = document.querySelectorAll('[data-abudhabi-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-abudhabi-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-abudhabi-tier-panel') !== key; });
      });
    });
  }
</script>
