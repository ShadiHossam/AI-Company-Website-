---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "لدينا CRM بالفعل. هل يمكنكم إضافة الذكاء الاصطناعي إليه دون استبداله؟", answer: "نعم، هذا بالضبط ما يخدمه تكامل الذكاء الاصطناعي. نُضيف طبقة ذكاء اصطناعي فوق نظام CRM الحالي أو النظام المخصص لديك. يواصل فريقك العمل في النظام نفسه الذي يعرفه؛ الفرق أنه يصبح أذكى: يُثري جهات الاتصال تلقائياً، يتوقع صحة الصفقات، ويُظهر إجراءات المتابعة الصحيحة." },
  { question: "ما الأنظمة التي تدمجون الذكاء الاصطناعي معها؟", answer: "أي نظام يملك واجهة برمجية (API). نعمل بانتظام مع أنظمة CRM وERP ومنصات التواصل وأدوات إدارة المشاريع ومستودعات البيانات ومنصات التجارة الإلكترونية. إذا كان نظامك يملك API، يمكننا إضافة الذكاء الاصطناعي إليه. سنُخبرك مسبقاً إذا كان أي أمر غير ممكن." },
  { question: "كم يستغرق مشروع تكامل الذكاء الاصطناعي؟", answer: "يُحدَّد نطاق كل مشروع بشكل فردي. نُعطيك جدولاً زمنياً دقيقاً بعد جلسة التحليل الأولى، بناءً على عدد الأنظمة المعنية، تعقيد البيانات، وإعداد API الحالي لديك." },
  { question: "هل ستتعطل سير عملنا الحالي أثناء التكامل؟", answer: "لا. نبني ونختبر تكاملات الذكاء الاصطناعي في بيئة اختبار أولاً. تبقى أنظمة الإنتاج لديك دون أي تعديل حتى يتم التحقق الكامل من التكامل. آلية التراجع مدمجة كشبكة أمان." },
  { question: "نظام CRM لدينا مبني داخلياً بشكل مخصص. هل يمكنكم دمج الذكاء الاصطناعي معه؟", answer: "نعم، طالما أن نظامك يُتيح واجهة API أو وصولاً لقاعدة البيانات. دمجنا الذكاء الاصطناعي مع أنظمة مخصصة كثيرة لا تملك توثيقاً جاهزاً. نُراجع الـ API خلال جلسة التحليل الأولى، نُؤكد إمكانية التنفيذ، ونبني اتصالاً آمناً. إذا لم يكن لدى نظامك أي API إطلاقاً، يمكننا مناقشة خيارات لإنشاء واحد." },
  { question: "ماذا يحدث لطبقة الذكاء الاصطناعي إذا استبدلنا برنامجنا الرئيسي لاحقاً؟", answer: "تكامل الذكاء الاصطناعي مبني كطبقة وسيطة، بمعنى أنه يتصل بنظامك الرئيسي عبر API بدلاً من أن يكون مدمجاً بداخله. إذا انتقلت إلى CRM أو ERP جديد، نُحدّث اتصالات API في جانب الذكاء الاصطناعي لتُشير إلى النظام الجديد. في معظم الحالات، تحتاج طبقة الذكاء الاصطناعي نفسها فقط تعديلات طفيفة أثناء الترحيل." },
  { question: "كيف يختلف تكامل الذكاء الاصطناعي عن مجرد شراء إضافة برمجية (plugin)؟", answer: "الإضافة البرمجية تُضيف مجموعة ثابتة من الميزات صمّمها المورّد للعميل المتوسط. أما تكامل الذكاء الاصطناعي فيُبنى حول بنية بياناتك المحددة وسير عملك ومنطق عملك التجاري. إنه يفهم معنى بياناتك، لا مجرد تنسيقها. النتيجة نظام يعكس فعلياً طريقة عمل شركتك، لا طريقة عمل شركة أخرى." },
];

const processSteps = [
  { icon: "search", step: "الخطوة 1", title: "تدقيق الأنظمة", description: "نُقيّم أنظمتك الحالية وواجهات البرمجة وتدفقات البيانات، ثم نُحدد بالضبط أين يخلق تكامل الذكاء الاصطناعي أعلى قيمة." },
  { icon: "architecture", step: "الخطوة 2", title: "التصميم والربط", description: "نُصمم طبقة الذكاء الاصطناعي، نُنشئ اتصالات API آمنة، ونبني التكاملات في بيئة اختبار." },
  { icon: "fact_check", step: "الخطوة 3", title: "اختبار على بيانات حقيقية", description: "نتحقق من صحة التكامل باستخدام بياناتك الفعلية والحالات الاستثنائية والحمل، دون أي تأثير على أنظمتك الحية." },
  { icon: "rocket_launch", step: "الخطوة 4", title: "النشر والمراقبة", description: "يُطلق التكامل فعلياً. تشمل الخدمة مراقبة ودعماً لمدة 90 يوماً. نلتقط المشكلات قبل أن تصل إلى فريقك." },
];

const ldJson = [
  { "@context": "https://schema.org", "@type": "Service", "name": "خدمات تكامل الذكاء الاصطناعي", "url": "https://lenooai.com/ar/services/ai-integration", "description": "نُضيف طبقة ذكاء اصطناعي إلى CRM وERP وأنظمتك البرمجية الحالية، لنجعل أدواتك الحالية أذكى بشكل ملحوظ دون استبدالها.", "provider": { "@type": "Organization", "name": "Aegis AI", "url": "https://lenooai.com" }, "areaServed": "United Arab Emirates", "serviceType": "تكامل الذكاء الاصطناعي" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
    { "@type": "ListItem", "position": 2, "name": "الخدمات", "item": "https://lenooai.com/ar/services" },
    { "@type": "ListItem", "position": 3, "name": "خدمات تكامل الذكاء الاصطناعي", "item": "https://lenooai.com/ar/services/ai-integration" }
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })) }
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="خدمات تكامل الذكاء الاصطناعي لشركات الإمارات | Aegis AI"
  description="لا تحتاج لاستبدال برمجياتك، فقط اجعلها أذكى. بصفتنا وكالة ذكاء اصطناعي في دبي، نُضيف طبقة ذكاء اصطناعي إلى CRM وERP وأدواتك الحالية لشركات الإمارات."
  canonicalPath="/ar/services/ai-integration"
  enPath="/services/ai-integration"
  ogImage="/assets/og-services.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>خدمات تكامل الذكاء الاصطناعي</div>
    <h1>برمجياتك الحالية، <span class="gradient-text">أذكى بالذكاء الاصطناعي.</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 2.5rem; line-height:1.8;">
      لا تحتاج إلى استبدال CRM أو ERP أو أي أداة أخرى. تحتاج إلى جعلها أذكى. نُضيف طبقة ذكاء اصطناعي دقيقة فوق ما تستخدمه بالفعل، فيحصل نفس الفريق على نتائج أفضل بكثير.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_integration_hero" class="btn-primary">احجز مكالمة استكشافية مجانية</button>
      <a href="#what-we-integrate" class="btn-outline">اكتشف ما ندمجه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1400&q=80&auto=format&fit=crop" alt="دمج الذكاء الاصطناعي مع الأنظمة الحالية وواجهات البرمجة" loading="eager" fetchpriority="high" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.25),rgba(0,37,59,0.40));"></div>
</div>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#001e30,#00253b,#003b5c); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "بدون استبدال", caption: "نُحسّن أدواتك الحالية. لن نطلب منك التخلي عمّا ينجح." },
      { value: "API أولاً", caption: "أي نظام يملك واجهة برمجية يمكن تحسينه: CRM وERP وقواعد البيانات وأكثر" },
      { value: "100%", caption: "ضمان استرداد كامل إذا لم تكن راضياً عمّا نُسلّمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI INTEGRATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ما الذي يعنيه تكامل الذكاء الاصطناعي فعلياً؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          تكامل الذكاء الاصطناعي يعني إضافة طبقة ذكاء اصطناعي فوق برمجياتك الحالية، بحيث تصبح أدواتك الحالية أذكى بشكل ملحوظ دون استبدالها. يواصل فريقك استخدام الأنظمة التي يعرفها. الفرق أن هذه الأنظمة الآن تفهم البيانات بدلاً من مجرد تخزينها، تتوقع النتائج بدلاً من مجرد عرض التاريخ، وتتخذ إجراءات بدلاً من مجرد إظهار المعلومات.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          فكّر بالأمر هكذا: نظام CRM عادي يُسجّل ما حدث في مسار مبيعاتك. أما CRM بطبقة ذكاء اصطناعي فيُخبرك بالصفقات المعرّضة للخطر، ولماذا يُرجَّح إغلاق كل صفقة أو عدم إغلاقها، وما الخطوة التالية الأفضل لكل مندوب، وأي الحسابات على وشك المغادرة، كل ذلك في الوقت الفعلي. النظام الأساسي هو نفسه. طبقة الذكاء فوقه هي ما يُغيّر النتيجة.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80&auto=format&fit=crop" alt="مديرة مبيعات في شركة بدبي تُراجع لوحات مسار مُثراة بالذكاء الاصطناعي داخل نظام CRM الذي يستخدمه فريقها بالفعل" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      السبب الذي يجعل الشركات تختار التكامل بدلاً من الاستبدال واضح: عمليات ترحيل البرمجيات المؤسسية مكلفة، مُربكة، وغالباً ما تستغرق من 12 إلى 24 شهراً. معظم الشركات استثمرت سنوات في تهيئة أنظمتها الحالية وتدريب فرقها عليها. تكامل الذكاء الاصطناعي يحصل على معظم قيمة الذكاء الاصطناعي الحديث، بجزء بسيط من التكلفة والإرباك، من خلال العمل مع ما لديك بالفعل.
    </p>
  </div>
</section>

<!-- WHAT WE INTEGRATE -->
<section id="what-we-integrate" class="section" aria-labelledby="integrate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="integrate-heading">تكاملات الذكاء الاصطناعي التي نُقدّمها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع تكامل شائعة، كل منها مُصمم خصيصاً لنظامك ومدعوم بعد الإطلاق. إذا لم يكن نظامك أو حالة استخدامك مذكورة هنا، على الأرجح لا نزال نبنيها. أخبرنا بما تعمل عليه.</p>
    </div>
    <div class="feature-ledger">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">contacts</span></div>
        <h3>تكامل CRM مع الذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أضف الذكاء الاصطناعي إلى CRM لإثراء جهات الاتصال تلقائياً، تقييم العملاء المحتملين، توقع صحة الصفقات، وإظهار الخطوة التالية الصحيحة لكل مندوب، كل ذلك دون مغادرة نظامك الحالي.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">inventory_2</span></div>
        <h3>تحليلات ERP الذكية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حوّل بيانات ERP الخام إلى تحليلات تنبؤية: توقع الطلب، تحسين المخزون، تقييم مخاطر الموردين، واكتشاف الشذوذات قبل أن تتفاقم المشكلات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3>ذكاء اصطناعي لمنصات التواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">ذكاء اصطناعي مُضاف لأدوات التواصل لديك لتلخيص المحادثات الطويلة، استخراج بنود الإجراءات، صياغة الردود، وتوجيه الرسائل للشخص المناسب تلقائياً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">shopping_cart</span></div>
        <h3>طبقة ذكاء اصطناعي للتجارة الإلكترونية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">توصيات ذكاء اصطناعي، تسعير ديناميكي، بحث مخصص، وتوقع مغادرة العملاء، مُضافة فوق منصة تجارتك الإلكترونية أو متجرك المخصص.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">storage</span></div>
        <h3>ذكاء اصطناعي لمستودعات البيانات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اطرح أسئلة على مستودع بياناتك بلغة طبيعية. يُترجمها الذكاء الاصطناعي إلى SQL، يُنفّذ الاستعلامات، ويُعيد التحليلات دون حاجة فريقك لمعرفة SQL.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">webhook</span></div>
        <h3>اتصالات API مخصصة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">نبني وسيطاً ذكياً مُخصصاً يربط أنظمتك الخاصة، بحيث تتدفق البيانات بذكاء بين أدوات لم تُصمَّم أصلاً للتواصل مع بعضها.</p>
      </div>
    </div>
  </div>
</section>

<!-- INTEGRATION SCENARIOS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="scenarios-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="scenarios-heading">كيف يبدو تكامل الذكاء الاصطناعي على أرض الواقع</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة ملموسة لما قبل وبعد، توضح ما تكسبه الشركات عند إضافة طبقة ذكاء اصطناعي إلى أنظمتها الحالية.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1200&q=80&auto=format&fit=crop" alt="مهندس يربط أنظمة الذكاء الاصطناعي عبر شاشات متعددة" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="scenario-tabs" data-scenario-tabs>
      <div class="tab-buttons" role="tablist" aria-label="اختر النظام الذي تستخدمه">
        <button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="crm">CRM</button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="erp">ERP</button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="ecom">التجارة الإلكترونية</button>
      </div>
      <div class="tab-panel ba-grid" data-panel="crm">
        <div>
          <p class="ba-label ba-before">قبل: CRM عادي</p>
          <p class="ba-copy">يُسجّل المندوبون ملاحظات المكالمات يدوياً. يُحدَّث المسار عندما يتذكر أحدهم ذلك. تقارير الفوز والخسارة تستغرق يوماً كاملاً لإعدادها. لا أحد يعرف أي الصفقات سليمة فعلياً حتى فوات الأوان.</p>
        </div>
        <div>
          <p class="ba-label ba-after">بعد: CRM بطبقة ذكاء اصطناعي</p>
          <p class="ba-copy">يُثري الذكاء الاصطناعي كل جهة اتصال تلقائياً. يُقيّم صحة الصفقات يومياً، يُحدد الفرص المعرّضة للخطر، ويُظهر أفضل خطوة تالية لكل مندوب. واجهة CRM لديك لم تتغيّر. لكن الذكاء الذي تحتها تغيّر.</p>
        </div>
      </div>
      <div class="tab-panel ba-grid hidden" data-panel="erp">
        <div>
          <p class="ba-label ba-before">قبل: ERP عادي</p>
          <p class="ba-copy">تجديد المخزون يعتمد على نقاط إعادة طلب ثابتة. مفاجآت الطلب تُباغت الفريق. يُراجع القسم المالي التقارير شهرياً، ويتفاعل مع مشكلات كان يمكن اكتشافها قبل أسابيع.</p>
        </div>
        <div>
          <p class="ba-label ba-after">بعد: ERP بطبقة ذكاء اصطناعي</p>
