---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "لدينا نظام CRM بالفعل. هل تستطيعون إضافة الذكاء الاصطناعي إليه دون استبداله؟", answer: "نعم، وهذا بالضبط هدف ربط الذكاء الاصطناعي. نضيف طبقة ذكاء اصطناعي فوق نظام CRM أو نظامكم المخصص الحالي. يستمر فريقكم في العمل على نفس النظام الذي يعرفه، لكنه يصبح أذكى: يُثري بيانات جهات الاتصال تلقائياً، ويتوقع سلامة الصفقات، ويعرض إجراءات المتابعة المناسبة." },
  { question: "مع أي أنظمة تربطون الذكاء الاصطناعي؟", answer: "أي نظام لديه API. نعمل بانتظام مع أنظمة CRM وERP، ومنصات التواصل، وأدوات إدارة المشاريع، ومستودعات البيانات، ومنصات التجارة الإلكترونية. إذا كان لنظامكم API، نستطيع إضافة الذكاء الاصطناعي إليه. وسنخبركم من البداية إذا كان شيء ما غير ممكن." },
  { question: "كم يستغرق مشروع ربط الذكاء الاصطناعي؟", answer: "كل مشروع يُحدَّد نطاقه بشكل منفصل. نعطيكم جدولاً زمنياً دقيقاً بعد جلسة الاكتشاف، بناءً على عدد الأنظمة المعنية، وتعقيد البيانات، وإعداد واجهات API الحالي لديكم." },
  { question: "هل سيتعطل سير عملنا الحالي أثناء الربط؟", answer: "لا. نبني عمليات ربط الذكاء الاصطناعي ونختبرها في بيئة تجريبية أولاً. تبقى أنظمة الإنتاج لديكم دون أي تغيير حتى يتم التحقق من الربط بالكامل. وخيارات التراجع مدمجة كشبكة أمان." },
  { question: "نظام CRM لدينا مبني داخلياً. هل ما زال بإمكانكم ربط الذكاء الاصطناعي به؟", answer: "نعم، ما دام نظامكم يوفر API أو يسمح بالوصول إلى قاعدة البيانات. ربطنا الذكاء الاصطناعي بكثير من الأنظمة المبنية خصيصاً التي ليس لها توثيق جاهز. نراجع الـ API أثناء جلسة الاكتشاف، ونتأكد من الإمكانية، ونبني اتصالاً آمناً. وإذا لم يكن لنظامكم أي API، نستطيع مناقشة خيارات إنشاء واحد." },
  { question: "ماذا يحدث لطبقة الذكاء الاصطناعي إذا غيّرنا برنامجنا الرئيسي لاحقاً؟", answer: "يُبنى ربط الذكاء الاصطناعي كطبقة وسيطة، أي أنه يتصل بنظامكم الرئيسي عبر API بدلاً من أن يكون مدمجاً فيه. إذا انتقلتم إلى نظام CRM أو ERP جديد، نحدّث اتصالات API من جهة الذكاء الاصطناعي لتشير إلى النظام الجديد. في معظم الحالات، لا تحتاج طبقة الذكاء الاصطناعي نفسها إلا لتغييرات بسيطة أثناء الانتقال." },
  { question: "كيف يختلف ربط الذكاء الاصطناعي عن شراء إضافة برمجية جاهزة؟", answer: "الإضافة الجاهزة تضيف مجموعة ثابتة من الميزات صممها المورد للعميل المتوسط. أما ربط الذكاء الاصطناعي فيُبنى حول هيكل بياناتكم تحديداً، وسير عملكم، ومنطق عملكم. يفهم معنى بياناتكم، لا شكلها فقط. النتيجة نظام يعكس فعلاً طريقة عمل شركتكم، لا طريقة عمل شركة أخرى." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_ai_integration')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const processSteps = [
  { icon: "search", step: "الخطوة ١", title: "تدقيق الأنظمة", description: "نقيّم أنظمتكم وواجهات API وتدفقات البيانات الحالية، ثم نحدد بالضبط أين يحقق ربط الذكاء الاصطناعي أكبر قيمة." },
  { icon: "architecture", step: "الخطوة ٢", title: "التصميم والربط", description: "نصمم طبقة الذكاء الاصطناعي، ونؤسس اتصالات API آمنة، ونبني عمليات الربط في بيئة تجريبية." },
  { icon: "fact_check", step: "الخطوة ٣", title: "الاختبار على بيانات حقيقية", description: "نتحقق من الربط مقابل بياناتكم الفعلية والحالات الاستثنائية والأحمال، دون أي تأثير على أنظمتكم العاملة." },
  { icon: "rocket_launch", step: "الخطوة ٤", title: "النشر والمراقبة", description: "يبدأ الربط العمل. مراقبة ودعم لمدة ٩٠ يوماً مشمولان. نكتشف المشكلات قبل أن تصل إلى فريقكم." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="خدمات ربط الذكاء الاصطناعي للشركات في الإمارات | Lenoo AI"
  description="لا تحتاجون لاستبدال برامجكم، بل لجعلها أذكى. كوكالة ذكاء اصطناعي في دبي، نضيف طبقة ذكاء اصطناعي إلى نظام CRM وERP وأدواتكم الحالية للشركات في الإمارات."
  canonicalPath="/ar/services/ai-integration"
  enPath="/services/ai-integration"
  ogImage="/assets/og-services.jpg"
  ldJson={[faqLdJson]}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1400&q=80&auto=format&fit=crop", alt: "ربط الذكاء الاصطناعي بأنظمة الأعمال الحالية وواجهات API" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/services" style="color:inherit;text-decoration:none;opacity:0.65;">الخدمات</a><span style="opacity:0.4;padding:0 4px;"> / </span>خدمات ربط الذكاء الاصطناعي</div>
  <h1>برامجكم الحالية، <span class="gradient-text">أذكى بالذكاء الاصطناعي.</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 0; line-height:1.8;">
    لا تحتاجون لاقتلاع نظام CRM أو ERP أو أدواتكم. تحتاجون لجعلها أذكى. نضيف طبقة ذكاء اصطناعي دقيقة فوق ما تستخدمونه أصلاً، فيحقق نفس الفريق نتائج أفضل بكثير.
  </p>
  <div class="trust-chips" style="justify-content:center; margin:1.75rem 0 2rem;">
    <span class="tchip">نحسّن أدواتكم الحالية، ولا نلغي ما يعمل أبداً</span>
    <span class="tchip">أي نظام لديه API: أنظمة CRM وERP وقواعد البيانات وغيرها</span>
    <span class="tchip">ضمان استرداد إذا لم تكونوا راضين عما نقدمه</span>
  </div>
  <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_integration_hero" class="btn-primary">احجزوا مكالمة اكتشاف مجانية</button>
    <a href="#what-we-integrate" class="btn-outline">شاهدوا ما نربطه ↓</a>
  </div>

</PageHero>

<!-- STAT BANNER -->
<div style="background:linear-gradient(135deg,#001e30,#00253b,#003b5c); padding:4rem 0;">
  <div class="container">
    <StatStrip stats={[
      { value: "دون استبدال", caption: "نحسّن أدواتكم الحالية. لا نطلب منكم أبداً إلغاء ما يعمل." },
      { value: "API أولاً", caption: "أي نظام لديه API يمكن تحسينه: أنظمة CRM وERP وقواعد البيانات وغيرها" },
      { value: "١٠٠٪", caption: "ضمان استرداد إذا لم تكونوا راضين عما نقدمه" },
    ]} />
  </div>
</div>

<!-- WHAT IS AI INTEGRATION -->
<section class="section" aria-labelledby="explain-heading">
  <div class="container">
    <div class="explain-split">
      <div>
        <h2 id="explain-heading" style="margin-bottom:1.5rem;">ماذا يعني ربط الذكاء الاصطناعي فعلياً؟</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">
          ربط الذكاء الاصطناعي يعني إضافة طبقة ذكاء اصطناعي فوق برامجكم الحالية حتى تصبح أدواتكم الحالية أذكى بكثير، دون استبدالها. يستمر فريقكم في استخدام الأنظمة التي يعرفها. الفرق أن هذه الأنظمة أصبحت تفهم البيانات بدلاً من مجرد تخزينها، وتتوقع النتائج بدلاً من مجرد عرض التاريخ، وتنفذ إجراءات بدلاً من مجرد عرض المعلومات.
        </p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">
          فكروا في الأمر هكذا: نظام CRM العادي يسجل ما حدث في مسار مبيعاتكم. أما نظام CRM مع طبقة ذكاء اصطناعي فيخبركم أي الصفقات معرضة للخطر، ولماذا يُرجَّح أن تُغلق كل صفقة أو لا، وما أفضل إجراء تالٍ لكل مندوب، وأي الحسابات على وشك المغادرة، كل ذلك في الوقت الفعلي. النظام الأساسي هو نفسه. طبقة الذكاء فوقه هي ما يغيّر النتيجة.
        </p>
      </div>
      <div class="explain-img-wrap">
        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80&auto=format&fit=crop" alt="مديرة مبيعات في شركة بدبي تراجع لوحات مسار مبيعات معززة بالذكاء الاصطناعي داخل نظام CRM الذي يستخدمه فريقها أصلاً" loading="lazy" width="800" height="600" />
      </div>
    </div>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; max-width:800px; margin:2rem auto 0;">
      سبب اختيار الشركات للربط بدلاً من الاستبدال واضح: الانتقال بين برمجيات المؤسسات مكلف ومربك ويستغرق غالباً ١٢ إلى ٢٤ شهراً. معظم الشركات استثمرت سنوات في إعداد أنظمتها الحالية وتدريب فرقها عليها. ربط الذكاء الاصطناعي يحقق معظم قيمة الذكاء الاصطناعي الحديث، بجزء بسيط من التكلفة والإرباك، من خلال العمل مع ما لديكم أصلاً.
    </p>
  </div>
</section>

<!-- WHAT WE INTEGRATE -->
<section id="what-we-integrate" class="section" aria-labelledby="integrate-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="integrate-heading">عمليات ربط الذكاء الاصطناعي التي ننفذها</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أنواع ربط شائعة، يُحدَّد نطاق كل منها لنظامكم بالضبط وتُدعم بعد الإطلاق. إذا لم يكن نظامكم أو حالة استخدامكم مذكوراً هنا، فمن شبه المؤكد أننا نبنيه. أخبرونا بما تعملون عليه.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">contacts</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">إثراء نظام CRM بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">أضيفوا الذكاء الاصطناعي إلى نظام CRM لإثراء جهات الاتصال تلقائياً، وتقييم العملاء المحتملين، وتوقع سلامة الصفقات، وعرض الإجراء التالي المناسب لكل مندوب، دون مغادرة نظامكم الحالي.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لنظام ERP</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">حوّلوا بيانات ERP الخام إلى توقعات: توقع الطلب، وتحسين المخزون، وتقييم مخاطر الموردين، ورصد الحالات غير الطبيعية الذي يتحرك قبل أن تتفاقم المشكلات.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">forum</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لمنصات التواصل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">ذكاء اصطناعي مضاف إلى أدوات التواصل لديكم لتلخيص المحادثات الطويلة، واستخراج المهام المطلوبة، وصياغة الردود، وتوجيه الرسائل إلى الشخص المناسب تلقائياً.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">shopping_cart</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">طبقة ذكاء اصطناعي للتجارة الإلكترونية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">توصيات بالذكاء الاصطناعي، وتسعير ديناميكي، وبحث مخصص، وتوقع مغادرة العملاء، مضافة فوق منصة التجارة الإلكترونية أو متجركم المخصص.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">storage</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">ذكاء اصطناعي لمستودع البيانات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">اسألوا مستودع بياناتكم بلغة عادية. يحوّل الذكاء الاصطناعي السؤال إلى SQL، وينفذ الاستعلامات، ويعيد النتائج دون أن يحتاج فريقكم لمعرفة SQL.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">webhook</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.625rem;">اتصالات API مخصصة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin:0;">نبني طبقة وسيطة مخصصة بالذكاء الاصطناعي تربط أنظمتكم الخاصة، فتتدفق البيانات بذكاء بين أدوات لم تُصمم أصلاً للتواصل مع بعضها.</p>
      </div>
    </div>
  </div>
</section>

<!-- INTEGRATION SCENARIOS -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="scenarios-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="scenarios-heading">كيف يبدو ربط الذكاء الاصطناعي عملياً</h2>
      <p style="color:#42474e; font-size:1.0625rem;">أمثلة ملموسة لما قبل وما بعد، توضح ما تكسبه الشركات عندما تضيف طبقة ذكاء اصطناعي إلى أنظمتها الحالية.</p>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:3rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1200&q=80&auto=format&fit=crop" alt="مهندسة تربط أنظمة ذكاء اصطناعي عبر عدة شاشات" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="scenario-wrap">
      <div class="ba-grid">
        <div class="ba-card ba-before">
          <p class="ba-label ba-before">قبل: نظام CRM عادي</p>
          <p class="ba-copy">المندوبون يسجلون ملاحظات المكالمات يدوياً. مسار المبيعات يُحدَّث عندما يتذكر أحدهم. تقارير الفوز والخسارة تأخذ يوماً لإعدادها. لا أحد يعرف أي الصفقات سليمة فعلاً حتى فوات الأوان.</p>
        </div>
        <div class="ba-card ba-after">
          <p class="ba-label ba-after">بعد: نظام CRM مع طبقة ذكاء اصطناعي</p>
          <p class="ba-copy">يُثري الذكاء الاصطناعي كل جهة اتصال تلقائياً. يقيّم سلامة الصفقات يومياً، وينبّه إلى الفرص المعرضة للخطر، ويعرض أفضل إجراء تالٍ لكل مندوب. واجهة CRM لديكم لم تتغير. الذكاء تحتها هو ما تغيّر.</p>
        </div>
        <div class="ba-card ba-before">
          <p class="ba-label ba-before">قبل: نظام ERP عادي</p>
          <p class="ba-copy">إعادة تعبئة المخزون حسب نقاط طلب ثابتة. مفاجآت الطلب تباغت الفريق. والمالية تراجع التقارير شهرياً، فتتعامل مع مشكلات كان يمكن رصدها قبل أسابيع.</p>
        </div>
        <div class="ba-card ba-after">
          <p class="ba-label ba-after">بعد: نظام ERP مع طبقة ذكاء اصطناعي</p>
          <p class="ba-copy">يتنبأ الذكاء الاصطناعي بالطلب الموسمي، وينبّه إلى الحالات غير الطبيعية في المخزون فوراً، ويولّد توصيات إعادة التعبئة قبل نفاد المخزون. وترى المالية توقعات التدفق النقدي، لا التقارير التاريخية فقط.</p>
        </div>
        <div class="ba-card ba-before">
          <p class="ba-label ba-before">قبل: منصة تجارة إلكترونية عادية</p>
          <p class="ba-copy">نفس المنتجات تُعرض لكل العملاء. تحديثات الأسعار يدوية. ولا رؤية لأي العملاء على وشك المغادرة مقابل من يُرجَّح أن يشتري مجدداً قريباً.</p>
        </div>
