---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import { isReleased, unreleasedResponse } from "../../../lib/arRollout";
import PageHero from '../../../components/PageHero.astro';

// Published on its day in the staged Arabic rollout; a real 404 until then.
if (!isReleased('/ar/pricing/ai-automation-cost')) return unreleasedResponse('/ar/pricing/ai-automation-cost');

const faqItems = [
  { question: "هل يوجد خيار أرخص نبنيه بأنفسنا بدل التعاقد مع وكالة؟", answer: "نعم، منصات البناء دون كود تتيح لشخص مرتاح تقنياً بناء روبوت محادثة بسيط أو سير عمل بسيط بنفسه مقابل اشتراك شهري، غالباً بضع مئات من الدراهم شهرياً. هذا يصلح للروبوتات البسيطة فعلاً ذات الغرض الواحد. ويتوقف عن العمل حين تحتاجون ربطاً حقيقياً مع أنظمتكم، أو عربية تبدو طبيعية فعلاً، أو منطقاً متعدد الخطوات، أو أي شيء يجب أن يكون موثوقاً بما يكفي ليمثل عملكم دون إشراف. معظم الشركات التي تبدأ بنفسها تنتهي بطلب المساعدة عندما تصل إلى هذا السقف، لذلك من المفيد أن تكونوا صريحين مع أنفسكم حول موقعكم منه قبل أن تخصصوا أسابيع لبناء دون كود." },
  { question: "هل نحتاج ميزانية كبيرة للبدء، أم يمكن أن نبدأ صغاراً؟", answer: "يمكنكم البدء صغاراً. سير عمل واحد مختار جيداً، الذي يكلّفكم أكثر عدد من العملاء المحتملين الضائعين أو أكثر ساعات العمل اليدوي، كثيراً ما يكلّف أقل من بناء روبوت محادثة متوسط، ويثبت الفكرة قبل أن تلتزموا بأي شيء أكبر. معظم عملائنا يبدؤون بنظام واحد، يرونه يعمل، ثم يتوسعون، بدل محاولة أتمتة كل شيء دفعة واحدة. البدء بنطاق ضيق وإثبات القيمة هو عادة الترتيب الأفضل، مالياً وعملياً." },
  { question: "ما شروط الدفع المعتادة؟", answer: "معظم المشاريع تُبنى على دفعة مقدمة للبدء (عادة ٤٠–٥٠٪)، والباقي يُستحق عند التسليم أو يُقسَّم على مراحل في المشاريع الأكبر متعددة الوكلاء. اتفاقيات الدعم الشهري تُفوتَر شهرياً. نوضح الجدول الدقيق في عرض سعر مكتوب قبل بدء أي عمل، فلا يبقى أي غموض حول ما يُستحق ومتى." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "تسعير الأتمتة بالذكاء الاصطناعي",
    "url": "https://lenooai.com/ar/pricing/ai-automation-cost",
    "description": "نطاقات تكلفة صريحة لمشاريع الأتمتة بالذكاء الاصطناعي في الإمارات حسب نوع المشروع: روبوتات المحادثة، أتمتة واتساب، وكلاء الذكاء الاصطناعي، الأنظمة متعددة الوكلاء، الوكلاء الصوتيون، والتطوير المخصص.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Automation Development"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الأسعار", "item": "https://lenooai.com/ar/pricing/ai-automation-cost" },
      { "@type": "ListItem", "position": 3, "name": "تكلفة الأتمتة بالذكاء الاصطناعي", "item": "https://lenooai.com/ar/pricing/ai-automation-cost" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="تكلفة الأتمتة بالذكاء الاصطناعي في الإمارات | Lenoo AI"
  description="كم تكلّف الأتمتة بالذكاء الاصطناعي فعلاً في الإمارات: نطاقات حقيقية بالدرهم لروبوتات المحادثة، أتمتة واتساب، وكلاء الذكاء الاصطناعي، الأنظمة متعددة الوكلاء، والوكلاء الصوتيين."
  canonicalPath="/ar/pricing/ai-automation-cost"
  enPath="/pricing/ai-automation-cost"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>


<PageHero image={{ src: "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1600&q=80&auto=format&fit=crop", alt: "آلة حاسبة وأوراق تخطيط مالي على مكتب", position: "center 50%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/pricing/ai-automation-cost" style="color:inherit;text-decoration:none;opacity:0.65;">الأسعار</a><span style="opacity:0.4;padding:0 4px;"> / </span>تكلفة الأتمتة بالذكاء الاصطناعي</div>
  <h1>كم تكلّف الأتمتة بالذكاء الاصطناعي <span class="gradient-text">فعلاً في الإمارات</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">نطاقات حقيقية بالدرهم حسب نوع المشروع، وما الذي يحرّك السعر فعلاً، والتكاليف التي تغفلها معظم عروض الأسعار. لا "تواصلوا معنا لمعرفة السعر"، بل أرقام صريحة.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_pricing_cost_hero" class="btn-primary">احصلوا على عرض سعر مجاني ومفصّل</button>
    <a href="#by-type" class="btn-outline">شاهدوا التكلفة حسب نوع المشروع ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "٦", caption: "أنواع مشاريع أدناه، لكل منها نطاق حقيقي بالدرهم، لا رقم واحد مبهم" },
      { value: "٤٠–٥٠٪", caption: "الدفعة المقدمة المعتادة لبدء المشروع، والباقي عند التسليم أو على مراحل" },
      { value: "٣", caption: "تكاليف خفية تغفلها معظم عروض الأسعار تقريباً، نشرحها في الأسفل" },
    ]} />
  </div>
</PageHero>

<!-- INTRO -->
<section class="section" aria-labelledby="intro-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="intro-heading" style="margin-bottom:1.5rem;">لماذا لا يوجد جواب واحد لسؤال "كم يكلّف الذكاء الاصطناعي"</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>"الذكاء الاصطناعي" يشمل كل شيء من نافذة أسئلة شائعة بخمسة أسئلة إلى نظام متعدد الوكلاء يدير كل عملياتكم الداخلية.</strong> السؤال عن تكلفة الذكاء الاصطناعي يشبه السؤال عن سعر السيارة: الجواب الصريح يعتمد كلياً على ما تبنونه فعلاً، ومن يعطيكم رقماً واحداً دون أن يسأل عن احتياجكم إما يخمّن أو يعرض سعراً منخفضاً ليضمن المكالمة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">ما نستطيع تقديمه بدلاً من ذلك هو نطاقات حقيقية حسب نوع المشروع، مبنية على ما نتقاضاه نحن والوكالات الأخرى في هذا السوق فعلاً مقابل عمل مماثل. ليست قائمة أسعار تفترض أن كل المشاريع متطابقة، لكنها تكفي لتدخلوا أي نقاش مع مزوّد وأنتم تعرفون تقريباً ما يجب أن تتوقعوا دفعه، ولتكتشفوا عرض سعر بعيداً جداً عن المعقول في أي اتجاه.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">النطاقات أدناه معتادة لوكالة متخصصة في دبي تنفذ عملاً مخصصاً، لا لشركة استشارات عالمية كبرى ولا لمستقل يعمل وحده. رقمكم الفعلي يعتمد على التفاصيل التي نشرحها في الأسفل.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=800&q=80&auto=format&fit=crop" alt="شخص يراجع مستندات الأسعار والميزانية" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- COST BY TYPE -->
<section id="by-type" class="section" style="background:#e7eeff;" aria-labelledby="type-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="type-heading">التكلفة حسب نوع المشروع</h2>
      <p>النطاقات المعتادة التي نراها في هذا السوق. تكلفة البناء لمرة واحدة، دون احتساب الدعم الشهري أو استهلاك الواجهات البرمجية، ونشرح الاثنين في الأسفل.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة بسيط</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">٨٬٠٠٠–٢٥٬٠٠٠ درهم</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">روبوت على الموقع أو واتساب يجيب عن الأسئلة الشائعة ويجمع العملاء المحتملين، بقاعدة معرفة صغيرة ومحددة وربط أو اثنين.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة واتساب</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">١٥٬٠٠٠–٤٠٬٠٠٠ درهم</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إعداد واجهة Business API، جمع العملاء المحتملين، مسارات الحجز، والربط مع نظام إدارة العملاء، ويُحدَّد الحجم حسب عدد مسارات العمل التي يتولاها الروبوت.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">وكيل ذكاء اصطناعي لسير عمل واحد</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">٢٠٬٠٠٠–٦٠٬٠٠٠ درهم</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">وكيل يتولى مهمة واحدة محددة من البداية إلى النهاية، معالجة الفواتير أو تأهيل العملاء المحتملين أو جدولة المواعيد، مع ربط حقيقي بالأدوات، لا مجرد محادثة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">hub</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام متعدد الوكلاء</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">٥٠٬٠٠٠–١٥٠٬٠٠٠ درهم وأكثر</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">عدة وكلاء ينسّقون بين الأقسام أو مسارات العمل، غالباً بمنطق تنسيق مخصص. السعر يرتفع مع عدد الوكلاء وعمليات الربط المطلوبة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">record_voice_over</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">وكيل صوتي/موظف استقبال</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">١٥٬٠٠٠–٤٥٬٠٠٠ درهم</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">ذكاء اصطناعي يرد على الهاتف مع توجيه المكالمات والحجز وتسجيل الرسائل، ويرتفع السعر إذا احتاج تعاملاً حقيقياً باللغتين العربية والإنجليزية.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">construction</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تطوير ذكاء اصطناعي مخصص</h3>
        <p style="color:#006875; font-weight:700; font-size:1.125rem; margin-bottom:0.5rem;">+٤٠٬٠٠٠ درهم</p>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">أنظمة تُبنى من الصفر لاستخدام محدد: أدوات خاصة، نماذج مضبوطة بالتدريب، أو ربط عميق مع أنظمة قديمة. يُحدَّد النطاق لكل مشروع على حدة.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل عرض سعر مفصّل بنداً بنداً، فترون بالضبط ما تدفعون مقابله قبل الالتزام بأي شيء.</p>
      <button onclick="openModal(this)" data-source="ar_pricing_cost_mid" class="btn-primary">احصلوا على عرض سعر مجاني ومفصّل</button>
    </div>
  </div>
</section>

<!-- WHAT DRIVES PRICE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="drivers-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="drivers-heading">ما الذي يرفع السعر أو يخفضه</h2>
      <p>خمسة عوامل تفسر لماذا قد يختلف سعر "روبوتي محادثة" بخمسة أضعاف.</p>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تعقيد الربط</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الروبوت الذي يجيب عن الأسئلة فقط رخيص. أما الروبوت الذي يقرأ ويكتب في نظام إدارة العملاء والتقويم ونظام المخزون لحظياً فيكلّف أكثر بشكل ملموس، لأن كل ربط عمل هندسي مستقل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">جاهزية البيانات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إذا كانت معلومات منتجاتكم وسياساتكم وإجراءاتكم موجودة أصلاً في مكان نظيف ومنظم، يكون البناء أسرع. وإذا كانت موزعة بين ملفات PDF وجداول بيانات وذاكرة أحد الموظفين، فتجهيز البيانات مرحلة عمل قائمة بذاتها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">عدد مسارات العمل</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مهمة واحدة واضحة تكلّف أقل من خمس مهام متقاربة مجمّعة في الوكيل نفسه. كل مسار عمل إضافي يعني منطقاً إضافياً واختباراً إضافياً وحالات حدية إضافية يجب التعامل معها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تغطية اللغة العربية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">النظام الذي يتعامل فعلاً بشكل جيد مع اللهجة الخليجية والعربيزي والتنقل بين اللغتين يحتاج اختباراً حقيقياً ليصبح صحيحاً، لا مجرد تعليمات مترجمة. ووقت ضمان الجودة الإضافي هذا يظهر في السعر.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٥</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">متطلبات الالتزام</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الرعاية الصحية والمالية وأي نظام يتعامل مع بيانات حساسة يحتاج عناية إضافية بموقع تخزين البيانات والموافقة وصلاحيات الوصول، وهذا يضيف نطاقاً يتجاوز البناء الأساسي نفسه.</p>
      </div>
    </div>
  </div>
</section>

<!-- BUILD VS RETAINER -->
<section class="section" aria-labelledby="build-vs-retainer-heading">
  <div class="container">
    <div style="max-width:800px; margin:0 auto; text-align:center;">
      <h2 id="build-vs-retainer-heading" style="margin-bottom:1.25rem;">تكلفة البناء لمرة واحدة مقابل الدعم الشهري المستمر</h2>
