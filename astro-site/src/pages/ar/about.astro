---
export const prerender = false;
import ArBaseLayout from "../../layouts/ArBaseLayout.astro";
import PageHero from '../../components/PageHero.astro';

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const aboutFaqs = [
  { question: "هل تبنون الذكاء الاصطناعي، أم تدرّبون فريقنا؟", answer: "الاثنين معاً، في مشروع واحد. نبني النظام حول سير عملكم الفعلي، ثم ندرّب الأشخاص الذين سيستخدمونه كل يوم. معظم مشاريع الذكاء الاصطناعي تفشل عند نقطة التسليم، لذلك لا نسلّم ونغادر. يكون فريقكم قد بدأ استخدام النظام بثقة قبل أن نعتبر المشروع منتهياً." },
  { question: "هل تعملون مع شركات دبي فقط؟", answer: "مقرنا في دبي ومعظم عملائنا في الإمارات، لكننا نعمل مع شركات في أسواق أخرى أيضاً. مكالمات الاكتشاف والبناء والتدريب كلها تعمل عن بُعد. وإذا كنتم في دبي، يسعدنا اللقاء حضورياً." },
  { question: "ما الحجم الذي يجب أن تكون عليه شركتنا؟", answer: "لا يوجد حد أدنى. نعمل مع شركات من بضعة موظفين إلى عدة مئات. كل مشروع يُحدَّد نطاقه ويُسعَّر حسب حجمكم وأهدافكم، فالشركة المكونة من ١٠ أشخاص تحصل على مشروع يناسب ١٠ أشخاص، لا عقد مؤسسي مُختصَر." },
  { question: "ماذا يحدث في المكالمة الأولى؟", answer: "أنتم تتحدثون، ونحن نستمع. خلال ٣٠ دقيقة سنفهم عملكم، ونشير إلى مكانين أو ثلاثة يحقق فيها الذكاء الاصطناعي عائداً فعلياً، ونخبركم بصراحة إذا لم يكن كذلك. المكالمة مجانية ولا يوجد أي ضغط للمتابعة في الحالتين." },
  { question: "كيف يعمل ضمان الاسترداد؟", answer: "إذا لم تكونوا راضين عن نظام الذكاء الاصطناعي الذي نبنيه، نردّ ١٠٠٪ من استثماركم. دون شروط، ودون استرداد جزئي، ودون بنود مخفية. نستطيع تقديم ذلك لأننا نحدد النطاق بعناية ولا نقبل إلا المشاريع التي نثق أنها ستحقق النتائج." },
];

const aboutSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: aboutFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'عن Lenoo AI',
    url: 'https://lenooai.com/ar/about',
    description: 'تساعد Lenoo AI الشركات من كل الأحجام على بناء الذكاء الاصطناعي وتبنّيه، من خلال التطوير المخصص والتدريب العملي للفرق.',
    inLanguage: 'ar',
    mainEntity: {
      '@type': 'Organization',
      name: 'Lenoo AI',
      url: 'https://lenooai.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'من نحن', item: 'https://lenooai.com/ar/about' },
    ],
  },
];
---

<ArBaseLayout
  title="عن Lenoo AI: فريق الذكاء الاصطناعي وراء الشركات في الإمارات"
  description="Lenoo AI وكالة ذكاء اصطناعي في دبي. نبني حلول ذكاء اصطناعي مخصصة وندرّب الفرق على استخدامها، ونعمل مع شركات الإمارات من كل الأحجام وفي كل القطاعات."
  canonicalPath="/ar/about"
  enPath="/about"
  ogImage="/assets/og-about.jpg"
  ldJson={aboutSchema}
>

<PageHero image={{ src: "https://images.pexels.com/photos/7108454/pexels-photo-7108454.jpeg", alt: "فريق من المهنيين في اجتماع حول طاولة مكتب" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>من نحن</div>
  <h1 style="max-width:780px; margin-left:auto; margin-right:auto;">
    معظم مشاريع الذكاء الاصطناعي تفشل. أسسنا شركة لإصلاح ذلك.
  </h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:620px; margin:1.5rem auto 0;">
    لسنا منصة عامة. ولسنا مورداً للمؤسسات الكبرى. نحن شريك حقيقي يبني الذكاء الاصطناعي حول طريقة عمل شركتكم الفعلية، ويدرّب فريقكم على استخدامه من اليوم الأول.
  </p>

</PageHero>

<!-- WHY WE EXIST -->
<section class="section" style="padding-bottom:0;" aria-label="لماذا وُجدت Lenoo AI">
  <div class="container">
    <div class="bento-grid bento-grid-3">
      <div class="value-card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:0.75rem;">٧٠٪</p>
        <p style="color:#42474e; font-size:0.9375rem; margin:0; line-height:1.65;">من مشاريع الذكاء الاصطناعي حول العالم لا تصل إلى مرحلة التشغيل الفعلي، ليس بسبب سوء التقنية، بل لأن الفرق لم تكن مستعدة</p>
      </div>
      <div class="value-card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:0.75rem;">٤٫٤ تريليون $</p>
        <p style="color:#42474e; font-size:0.9375rem; margin:0; line-height:1.65;">القيمة السنوية المقدّرة التي يمكن أن يضيفها الذكاء الاصطناعي للاقتصاد العالمي، ومعظمها لم تحصل عليه الشركات الصغيرة والمتوسطة بعد</p>
      </div>
      <div class="value-card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:0.75rem;">٣ إلى ٥ أضعاف</p>
        <p style="color:#42474e; font-size:0.9375rem; margin:0; line-height:1.65;">فجوة الأداء بين الشركات التي تبنّت الذكاء الاصطناعي وتلك التي ما زالت تنتظر، مقاسةً بالسرعة والتكلفة ووقت الاستجابة</p>
      </div>
    </div>
  </div>
</section>

<!-- MISSION & VISION -->
<section class="section" aria-labelledby="mission-heading">
  <div class="container" style="max-width:900px;">
    <div class="section-header">
      <h2 id="mission-heading">أسسنا هذه الشركة لسبب.</h2>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;" class="about-mv-grid">
      <div style="background:#00253b; border-radius:20px; padding:2.25rem; position:relative; overflow:hidden;">
        <div style="position:absolute;top:-40px;left:-40px;width:160px;height:160px;border-radius:50%;background:rgba(0,227,253,0.06);"></div>
        <p style="color:#00e3fd; font-size:0.75rem; font-weight:700; margin-bottom:1rem;">مهمتنا</p>
        <p style="color:#fff; font-size:1.125rem; font-weight:700; line-height:1.6; margin-bottom:1rem;">مساعدة كل شركة على تبنّي الذكاء الاصطناعي والحصول على نتائج حقيقية منه.</p>
        <p style="color:rgba(255,255,255,0.60); font-size:0.9375rem; line-height:1.7; margin:0;">ليس فقط الشركات التي لديها ميزانيات مؤسسية وفرق علوم بيانات. كل شركة تستحق أن تستخدم الذكاء الاصطناعي بطريقة تجعل فريقها أقدر ونتائجها أفضل. نساعدكم على الوصول إلى ذلك، دون الاستغناء عن موظفيكم.</p>
      </div>
      <div style="background:#f0f3ff; border:1px solid rgba(0,37,59,0.08); border-radius:20px; padding:2.25rem; position:relative; overflow:hidden;">
        <div style="position:absolute;top:-40px;left:-40px;width:160px;height:160px;border-radius:50%;background:rgba(0,227,253,0.08);"></div>
        <p style="color:#006875; font-size:0.75rem; font-weight:700; margin-bottom:1rem;">رؤيتنا</p>
        <p style="color:#00253b; font-size:1.125rem; font-weight:700; line-height:1.6; margin-bottom:1rem;">عالم يستطيع فيه أي صاحب عمل استخدام الذكاء الاصطناعي للحصول على نتائج أفضل من فريقه.</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin:0;">أي قطاع. أي سوق. ذكاء اصطناعي يجعل الفرق الجيدة ممتازة، دون الاستغناء عن الأشخاص الذين بنوا الشركة من الأساس.</p>
      </div>
    </div>
  </div>
</section>

<!-- OUR STORY -->
<section class="section" aria-labelledby="story-heading">
  <div class="container" style="max-width:1080px;">
    <div class="split-grid">
      <div>
        <h2 id="story-heading" style="text-align:start; font-size:2rem; margin-bottom:1.25rem;">تأسست بعد مشاهدة مشاريع ذكاء اصطناعي تفشل</h2>
        <p style="color:#42474e; line-height:1.8; margin-bottom:1rem;">أسسنا Lenoo AI بعد أن شاهدنا عشرات مشاريع الذكاء الاصطناعي الواعدة تفشل، ليس لأن التقنية كانت خاطئة، بل لأن الأشخاص الذين يستخدمونها لم يكونوا مستعدين، ولأن الأنظمة بُنيت لعمل شركة أخرى.</p>
        <p style="color:#42474e; line-height:1.8; margin-bottom:1rem;">رأينا موردي الذكاء الاصطناعي للمؤسسات يتقاضون الملايين من المؤسسات الكبيرة، بينما بقيت الشركات الصغيرة والمتوسطة في كل القطاعات خارج الصورة تماماً، ما زالت تعمل بجداول البيانات والحدس في ٢٠٢٥.</p>
        <p style="color:#42474e; line-height:1.8;">قررنا أن نعمل بطريقة مختلفة. كوكالة ذكاء اصطناعي مقرها دبي، نبني ذكاءً اصطناعياً مخصصاً لسير عملكم، وندرّب فريقكم على استخدامه فعلاً. هذا وعدنا، مدعوماً باسترداد كامل إذا لم نفِ به.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=900&q=80&auto=format&fit=crop" alt="أفق مدينة عالمي يمثل عمل Lenoo AI مع الشركات في أسواق حول العالم" loading="lazy" width="900" height="620" />
      </div>
    </div>
  </div>
</section>

<!-- WHY WE'RE DIFFERENT -->
<section class="section" style="padding-top:0;" aria-labelledby="different-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="different-heading">لماذا نحن مختلفون</h2>
    </div>
    <div style="border-radius:20px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 20px 48px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=1200&q=80&auto=format&fit=crop" alt="فريق Lenoo AI يعرض خطة مشروع على شركة في دبي خلال جلسة بناء وتدريب" loading="lazy" width="1200" height="320" style="width:100%; height:clamp(180px, 26vw, 320px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-4">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">construction</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.5rem;">البناء والتدريب في شراكة واحدة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin:0;">لا يجب أن تختاروا بين بناء الذكاء الاصطناعي وتدريب فريقكم. نحن نقدم الاثنين.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">storefront</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.5rem;">مبني للشركات الحقيقية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin:0;">لا عقود مؤسسية متضخمة. كل مشروع يُحدَّد نطاقه ويُسعَّر خصيصاً لعملكم وحجمكم وأهدافكم.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">translate</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.5rem;">متعدد اللغات من اليوم الأول</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin:0;">نقدم العمل باللغة التي يعمل بها فريقكم. مواد التدريب والدعم والتوثيق، مكيّفة لموظفيكم من البداية.</p>
      </div>
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">verified</span></div>
        <h3 style="font-size:1.0625rem; font-weight:700; margin-bottom:0.5rem;">ضمان استرداد كامل دون بنود مخفية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin:0;">إذا لم تكونوا راضين عما نبنيه، نردّ ١٠٠٪ من استثماركم. نقطة.</p>
      </div>
    </div>
  </div>
</section>

<!-- BUSINESS OWNER MESSAGE -->
<section class="section" style="background:#00253b; padding:5rem 0;" aria-labelledby="owner-heading">
  <div class="container" style="max-width:820px;">
    <div style="text-align:center; margin-bottom:2.5rem;">
      <p style="color:#00e3fd; font-size:0.75rem; font-weight:700; margin-bottom:0.75rem;">لأصحاب الأعمال</p>
      <h2 id="owner-heading" style="color:#fff; font-size:clamp(1.375rem,2.5vw,1.75rem); font-weight:800; margin-bottom:0;">إذا كنتم تديرون شركة الآن، فأنتم تشعرون بذلك بالفعل.</h2>
    </div>
    <div style="border-radius:20px; overflow:hidden; margin-bottom:2rem; box-shadow:0 20px 48px rgba(0,0,0,0.25);">
      <img src="https://images.unsplash.com/photo-1573497620053-ea5300f94f21?w=1200&q=80&auto=format&fit=crop" alt="صاحبة عمل تناقش تبنّي الذكاء الاصطناعي مع مستشار من Lenoo AI" loading="lazy" width="1200" height="320" style="width:100%; height:clamp(180px, 26vw, 320px); object-fit:cover; display:block;" />
    </div>
    <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(0,227,253,0.15); border-radius:20px; padding:2rem 2.5rem;">
      <p style="color:rgba(255,255,255,0.80); font-size:0.9375rem; line-height:1.8; margin-bottom:1rem;">قرارات كانت تأخذ يوماً أصبحت تحتاج أن تُتخذ خلال ساعة. عملاؤكم يتوقعون ردوداً أسرع، وتسليماً أسرع، وكل شيء أسرع. هوامش أرباحكم أضيق مما كانت عليه قبل ثلاث سنوات. وفي مكان ما في قطاعكم، بدأ منافس للتو باستخدام الذكاء الاصطناعي، وفريقه ينجز أكثر دون أن يُستنزف.</p>
      <p style="color:rgba(255,255,255,0.80); font-size:0.9375rem; line-height:1.8; margin-bottom:1rem;">هذه ليست مشكلة تقنية. إنها مشكلة عمل. ولها حل.</p>
      <p style="color:rgba(255,255,255,0.80); font-size:0.9375rem; line-height:1.8; margin-bottom:1.5rem;">نعمل مع أصحاب أعمال يريدون استخدام الذكاء الاصطناعي لتنمية شركاتهم، لا للاستغناء عن موظفيهم. نساعدكم على تحديد أين يناسب الذكاء الاصطناعي، ونبنيه حول طريقة عمل فريقكم الفعلية، ونتأكد أن موظفيكم يعرفون كيف يستخدمونه جيداً. الهدف دائماً واحد: نتائج أفضل بالفريق الذي لديكم أصلاً.</p>
      <p style="color:#00e3fd; font-size:0.9375rem; font-weight:700; margin:0;">تبنّي الذكاء الاصطناعي بالطريقة الصحيحة. هذا ما نحن هنا من أجله.</p>
    </div>
    <div class="bento-grid bento-grid-3" style="margin-top:2rem;">
      <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(0,227,253,0.12); border-radius:14px; padding:1.25rem; text-align:center;">
        <span class="material-symbols-outlined" aria-hidden="true" style="color:#00e3fd; font-size:28px; margin-bottom:0.75rem; display:block;">trending_up</span>
        <p style="color:#fff; font-weight:700; font-size:0.9375rem; margin-bottom:0.25rem;">إيرادات أكثر</p>
        <p style="color:rgba(255,255,255,0.50); font-size:0.8125rem; margin:0; line-height:1.5;">متابعة وتعامل مع العملاء المحتملين بالذكاء الاصطناعي يعمل وأنتم نائمون</p>
      </div>
      <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(0,227,253,0.12); border-radius:14px; padding:1.25rem; text-align:center;">
        <span class="material-symbols-outlined" aria-hidden="true" style="color:#00e3fd; font-size:28px; margin-bottom:0.75rem; display:block;">schedule</span>
        <p style="color:#fff; font-weight:700; font-size:0.9375rem; margin-bottom:0.25rem;">وقت مهدر أقل</p>
        <p style="color:rgba(255,255,255,0.50); font-size:0.8125rem; margin:0; line-height:1.5;">أتمتوا المهام المتكررة التي تستنزف فريقكم كل يوم</p>
      </div>
      <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(0,227,253,0.12); border-radius:14px; padding:1.25rem; text-align:center;">
        <span class="material-symbols-outlined" aria-hidden="true" style="color:#00e3fd; font-size:28px; margin-bottom:0.75rem; display:block;">insights</span>
        <p style="color:#fff; font-weight:700; font-size:0.9375rem; margin-bottom:0.25rem;">قرارات أفضل</p>
        <p style="color:rgba(255,255,255,0.50); font-size:0.8125rem; margin:0; line-height:1.5;">استخدموا البيانات التي لديكم أصلاً لتروا ما ينجح وما لا ينجح</p>
      </div>
    </div>
  </div>
</section>


<!-- VALUES -->
<section class="section" style="background:#e7eeff;" aria-labelledby="values-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="values-heading">أربعة أمور لن نتنازل عنها.</h2>
    </div>
    <div style="border-radius:20px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 20px 48px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1200&q=80&auto=format&fit=crop" alt="أعضاء فريق يضعون أيديهم معاً تعبيراً عن شراكة Lenoo AI مع فرق العملاء" loading="lazy" width="1200" height="320" style="width:100%; height:clamp(180px, 26vw, 320px); object-fit:cover; display:block;" />
    </div>
    <div class="bento-grid bento-grid-4">
      <div class="value-card">
        <div class="service-icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
        <h3 style="font-weight:700; color:#00253b; font-size:1.0625rem; margin-bottom:0.5rem;">النتائج قبل الإيرادات</h3>
