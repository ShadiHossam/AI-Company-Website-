---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "كم من بيانات المستشعرات أو إنترنت الأشياء نحتاج قبل أن تعمل الصيانة التنبؤية؟", answer: "أقل مما يفترضه معظم المصنّعين. نموذج بداية مفيد يمكن غالباً أن يعمل على ٦ إلى ١٢ شهراً من سجلات الصيانة التاريخية إضافة إلى أي بيانات مستشعرات تنتجها معداتكم الحالية أصلاً. نبدأ بتدقيق البيانات المتوفرة لديكم قبل التوصية بأي أجهزة جديدة." },
  { question: "هل يستطيع فحص الجودة بالرؤية الحاسوبية أن يحل محل فريق ضمان الجودة لدينا؟", answer: "يحل محل الفحص الأولي المتكرر، لا الفريق. نظام الكاميرات ينبّه إلى العيوب المحتملة بسرعة خط الإنتاج، ويحوّل الحالات الحدية إلى مفتش بشري للحكم النهائي. يقضي موظفو ضمان الجودة وقتهم في الحالات التي تحتاج فعلاً عيناً مدرَّبة." },
  { question: "هل يعمل هذا على خط الإنتاج الحالي لدينا، أم نحتاج معدات جديدة؟", answer: "في معظم الحالات، الكاميرات والمستشعرات الحالية كافية للمرحلة التجريبية. نقيّم إعدادكم الحالي أولاً ولا نوصي بترقية الأجهزة إلا حيث تتطلب جودة البيانات ذلك فعلاً." },
  { question: "ما الجدول الزمني المعتاد لرؤية نتائج الصيانة التنبؤية؟", answer: "المرحلة التجريبية العاملة على خط إنتاج واحد تستغرق عادةً ٦ إلى ١٠ أسابيع، بما فيها فترة جمع البيانات اللازمة لتدريب نموذج دقيق. أما الجداول الزمنية للتعميم على كامل المنشأة فتعتمد على عدد الخطوط وأنواع الآلات المعنية." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_manufacturing')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للتصنيع في الإمارات",
    "url": "https://lenooai.com/ar/industries/manufacturing",
    "description": "أنظمة ذكاء اصطناعي مخصصة للمصنّعين في الإمارات: الصيانة التنبؤية، وفحص الجودة بالرؤية الحاسوبية، وجدولة الإنتاج، وتوقع الطلب.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Manufacturing"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للتصنيع", "item": "https://lenooai.com/ar/industries/manufacturing" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للتصنيع في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة للمصنّعين في الإمارات: الصيانة التنبؤية، وفحص الجودة بالرؤية الحاسوبية."
  canonicalPath="/ar/industries/manufacturing"
  enPath="/industries/manufacturing"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التصنيع</div>
    <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">للتصنيع في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة للمصنّعين في الإمارات: مراقبة الصيانة التنبؤية، وفحص الجودة بالرؤية الحاسوبية، وجدولة الإنتاج، وتوقع الطلب. مبنية حول آلاتكم وبيانات إنتاجكم.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="ar_manufacturing_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التصنيع</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
    <StatStrip stats={[
      { value: "٥٠ مليار $", caption: "التكلفة السنوية المقدّرة للتوقف غير المخطط على المصنّعين (Deloitte)" },
      { value: "٣٠-٥٠٪", caption: "انخفاض معتاد في التوقف مع برامج الصيانة التنبؤية" },
      { value: "+٩٠٪", caption: "دقة كشف العيوب الممكنة مع فحص مدرَّب بالرؤية الحاسوبية" },
    ]} />
  </div>
</header>

<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1717386255773-1e3037c81788?w=1400&h=280&q=80&auto=format&fit=crop" alt="خط إنتاج آلي في أرضية مصنع" loading="lazy" width="1400" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- WHY MANUFACTURING & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا التصنيع من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>التوقف غير المخطط هو أكبر تكلفة خفية في أرضية معظم المصانع.</strong> تقدّر Deloitte أنه يكلف المصنّعين نحو ٥٠ مليار دولار سنوياً. نماذج الصيانة التنبؤية المدرَّبة على بيانات الاهتزاز والحرارة والاستخدام تكتشف المعدات المتعطلة قبل أن توقف الخط.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>فحص الجودة اليدوي لا يواكب سرعة الخط.</strong> المفتشون البشريون يتعبون ويفوتون العيوب عند الإنتاجية العالية. أنظمة الرؤية الحاسوبية تفحص كل وحدة بسرعة الخط الكاملة دون أي تراجع في التركيز.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>قرارات الطلب والجدولة ما زالت تُتخذ بالحدس في كثير من المصانع.</strong> نماذج التوقع التي تستوعب الطلبات التاريخية والموسمية ومدد توريد الموردين تنتج جداول إنتاج تقلل نفاد المخزون وفائضه معاً.</p>
      </div>
      <div class="split-media" style="display:flex; align-items:stretch;">
        <div class="card" style="display:flex; flex-direction:column; justify-content:center; text-align:center; width:100%; padding:2.5rem;">
          <p class="stat-number" style="font-size:3rem; margin-bottom:0.75rem;">٥٠ مليار $</p>
          <p style="color:#42474e; font-size:1rem; line-height:1.7;">هي التكلفة السنوية المقدّرة للتوقف غير المخطط على المصنّعين (Deloitte)، ومعظمها يمكن تفاديه بإشارات إنذار مبكرة.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للمصنّعين في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي للمصنّعين، مربوطة بأنظمة MES وERP ومعدات أرضية المصنع الحالية لديكم.</p>
    </div>
    <div class="manufacturing-tabs" role="tablist" aria-label="فئات التطبيقات">
      <button type="button" id="manufacturing-tab-production" class="manufacturing-tab-btn active" data-manufacturing-tab="production" role="tab" aria-selected="true" aria-controls="manufacturing-panel-production">الإنتاج</button>
      <button type="button" id="manufacturing-tab-supplychain" class="manufacturing-tab-btn" data-manufacturing-tab="supplychain" role="tab" aria-selected="false" aria-controls="manufacturing-panel-supplychain">سلسلة الإمداد</button>
    </div>
    <div class="apps-grid" id="manufacturing-panel-production" data-manufacturing-tab-panel="production" role="tabpanel" aria-labelledby="manufacturing-tab-production">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة الصيانة التنبؤية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحلل بيانات المستشعرات من معداتكم لينبّه إلى الأعطال المحتملة قبل أن تسبب توقف الخط، فتتم الصيانة وفق جدولكم، لا في حالة طوارئ.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على أنماط الأعطال التاريخية لمعداتكم نفسها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">visibility</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الفحص البصري للجودة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كشف العيوب بالكاميرات يفحص كل وحدة بسرعة الخط، وينبّه إلى العيوب المحتملة، ويحوّل الحالات الحدية إلى مفتش بشري للحكم النهائي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يعمل على كاميراتكم الحالية في معظم التطبيقات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحسين جدولة الإنتاج</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني جداول إنتاج تأخذ في الاعتبار أولوية الطلبات، وتوفر المعدات، ووقت التبديل، فتقل الطاقة المعطلة والطلبات المتأخرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتكامل مع وحدة الجدولة في نظام MES أو ERP الحالي لديكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">report</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد الإبلاغ عن التوقف والحوادث</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يلتقط أحداث التوقف وتقارير الحوادث من موظفي أرضية المصنع عبر إدخال صوتي أو رسائل بسيطة، وينظم البيانات لتحليل الأسباب الجذرية تلقائياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل السجلات الورقية المتفرقة إلى بيانات منظمة قابلة للبحث</p>
      </div>
    </div>
    <div class="apps-grid" id="manufacturing-panel-supplychain" data-manufacturing-tab-panel="supplychain" role="tabpanel" aria-labelledby="manufacturing-tab-supplychain" hidden>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقع الطلب وتخطيط المخزون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتوقع الطلب من بيانات الطلبات التاريخية والموسمية، فيساعدكم على تخطيط شراء المواد الخام دون تكديس أو نقص.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل فائض المخزون والتأخيرات الناتجة عن نفاده معاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة مستندات الموردين والمشتريات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج البيانات ويتحقق منها من أوامر الشراء والفواتير وشهادات الموردين، وينبّه إلى الاختلافات قبل أن تتحول إلى تأخير في الإنتاج.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل إدخال البيانات اليدوي في سير عمل المشتريات</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة مصممة مع مراعاة سهولة الاستخدام في أرضية المصنع، ومربوطة بأنظمة MES وERP والمعدات الحالية لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_manufacturing_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التصنيع</button>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في التصنيع</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الصيانة التنبؤية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج قائمة على المستشعرات تتوقع أعطال المعدات قبل حدوثها، فتتدخل فرق الصيانة وفق جدول مخطط بدلاً من الاستجابة لعطل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تشير التقارير إلى خفض التوقف بنسبة ٣٠ إلى ٥٠٪ في التطبيقات الناضجة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">visibility</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ضبط الجودة بالرؤية الحاسوبية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أنظمة الكاميرات المدرَّبة على أمثلة العيوب تكتشف عدم الاتساق بسرعة الخط، وهو ما قد يفوت المفتشين البشريين خلال المناوبات الطويلة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">متبناة على نطاق واسع في خطوط تجميع الإلكترونيات والسيارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">جدولة الإنتاج وتحسينه</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج التحسين توازن بين أولوية الطلبات وتوفر الآلات وتكلفة التبديل أسرع بكثير من الجدولة اليدوية، خصوصاً عبر خطوط منتجات متعددة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقلل الطاقة المعطلة وتحسن معدلات التسليم في الموعد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقع الطلب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج التوقع تدمج الموسمية وسجل الطلبات والمؤشرات الاقتصادية الكبرى لتخطيط الإنتاج وشراء المواد الخام بمفاجآت أقل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقلل نفاد المخزون وتكاليف الاحتفاظ بفائضه معاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">view_in_ar</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التوائم الرقمية والمحاكاة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">النماذج الافتراضية لخطوط الإنتاج تتيح للمهندسين اختبار تغييرات العمليات وتعديلات التخطيط قبل الالتزام برأس مال في تغيير فعلي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقلل مخاطر تغييرات العمليات وتكلفتها</p>
      </div>
      <div class="card">
