---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للتصنيع في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/manufacturing",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "التصنيع", "item": "https://lenooai.com/ar/industries/manufacturing" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للتصنيع في الإمارات",
    "description": "صيانة تنبؤية، فحص جودة برؤية حاسوبية، جدولة إنتاج، وتوقع طلب لمصانع الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "كم من بيانات المستشعرات نحتاج قبل أن تعمل الصيانة التنبؤية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "أقل مما يفترضه معظم المصنّعين. نموذج بداية مفيد يعمل غالباً على ٦ إلى ١٢ شهراً من سجلات الصيانة التاريخية مع بيانات المستشعرات التي تُنتجها معداتكم بالفعل. نبدأ بتدقيق ما لديكم من بيانات قبل التوصية بأي عتاد جديد." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع فحص الجودة بالرؤية الحاسوبية أن يحل محل فريق ضبط الجودة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يحل محل المرور الأول المتكرر، لا الفريق. نظام الكاميرا يُنبّه للعيوب المحتملة بسرعة الخط ويُوجّه الحالات الحدّية لمفتش بشري للحكم النهائي." }
      },
      {
        "@type": "Question",
        "name": "هل يعمل هذا على خط إنتاجنا الحالي، أم نحتاج معدات جديدة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "في معظم الحالات، الكاميرات والمستشعرات الحالية كافية لتجربة أولية. نُقيّم إعدادكم الحالي أولاً ونوصي بترقية العتاد فقط حين تحتاج جودة البيانات ذلك فعلياً." }
      },
      {
        "@type": "Question",
        "name": "ما الجدول الزمني النموذجي لرؤية نتائج من الصيانة التنبؤية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "تجربة عاملة على خط إنتاج واحد تستغرق عادة ٦ إلى ١٠ أسابيع، شاملة فترة جمع البيانات اللازمة لتدريب نموذج دقيق." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للتصنيع في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني صيانة تنبؤية، فحص جودة بالرؤية الحاسوبية، وجدولة إنتاج لمصانع الإمارات، متصلة بأنظمة MES وERP لديكم."
  canonicalPath="/ar/industries/manufacturing"
  enPath="/industries/manufacturing"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التصنيع</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">precision_manufacturing</span>
      التصنيع
    </div>
    <h1>ذكاء اصطناعي للتصنيع في الإمارات<br><span class="gradient-text">التوقف غير المخطط أكبر تكلفة خفية في المصنع</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      نماذج صيانة تنبؤية مُدرَّبة على بيانات معداتكم تلتقط الأعطال قبل توقف الخط. نبني لك فحص جودة برؤية حاسوبية، جدولة إنتاج مُحسَّنة، وتوقع طلب، متصلة بأنظمة MES وERP لديكم.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_manufacturing_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1717386255773-1e3037c81788?w=1600&q=80&auto=format&fit=crop" alt="خط إنتاج آلي في أرضية مصنع تصنيع" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">٥٠ مليار$</p>
        <p class="stat-lbl">تكلفة سنوية مقدّرة للتوقف غير المخطط (Deloitte)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٣٠-٥٠٪</p>
        <p class="stat-lbl">تخفيض توقف نموذجي مع برامج الصيانة التنبؤية</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">+٩٠٪</p>
        <p class="stat-lbl">دقة كشف عيوب قابلة للتحقيق برؤية حاسوبية مُدرَّبة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في مصنعك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بأنظمة MES وERP ومعدات أرضية المصنع لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">build</span>
        <h3>مراقبة صيانة تنبؤية</h3>
        <p style="color:#42474e;line-height:1.7;">يُحلّل بيانات مستشعرات معداتكم لينبّه لأعطال محتملة قبل توقف الخط، فتحدث الصيانة حسب جدولكم لا كطارئ.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">visibility</span>
        <h3>فحص جودة بصري</h3>
        <p style="color:#42474e;line-height:1.7;">كشف عيوب بالكاميرا يفحص كل وحدة بسرعة الخط، مُنبّهاً للعيوب المحتملة ومُوجّهاً الحالات الحدّية لمفتش بشري.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">calendar_month</span>
        <h3>تحسين جدولة الإنتاج</h3>
        <p style="color:#42474e;line-height:1.7;">يبني جداول إنتاج تراعي أولوية الطلب وتوفر المعدات ووقت التبديل، مُقلّلة الطاقة الخاملة والطلبات المتأخرة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">report</span>
        <h3>مساعد الإبلاغ عن التوقف والحوادث</h3>
        <p style="color:#42474e;line-height:1.7;">يلتقط أحداث التوقف وتقارير الحوادث من طاقم أرضية المصنع عبر إدخال صوتي بسيط، مُنظِّماً البيانات لتحليل السبب الجذري.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">inventory_2</span>
        <h3>توقع طلب وتخطيط مخزون</h3>
        <p style="color:#42474e;line-height:1.7;">يتوقع الطلب من بيانات الطلبات التاريخية والموسمية، مساعداً في تخطيط شراء المواد الخام دون فائض أو نقص.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">description</span>
        <h3>أتمتة مستندات الموردين والمشتريات</h3>
        <p style="color:#42474e;line-height:1.7;">يستخرج ويتحقق من بيانات أوامر الشراء والفواتير وشهادات الموردين، مُنبّهاً للتناقضات قبل أن تصبح تأخيراً بالإنتاج.</p>
      </div>
    </div>
  </div>
</section>

<!-- QUALITY CONTROL -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="manufacturing-qc-heading">
  <div class="container" style="max-width:900px; text-align:center;">
    <h2 id="manufacturing-qc-heading" style="margin-bottom:1.5rem;">فحص يواكب سرعة الخط، لا العكس</h2>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">مفتشو الجودة لا يزالون يتخذون القرار النهائي على كل وحدة مُنبَّه لها. ما يتغيّر هو ما يصلهم: بدل فحص كل قطعة تخرج من الخط، يراجعون المجموعة الأصغر التي رصدها نظام الرؤية الحاسوبية بالفعل كعيب محتمل.</p>
    <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">هذا التحول مهم لأن الفحص اليدوي لا يتوسّع مع سرعة الخط. مفتش مُدرَّب يُرهَق خلال نوبة عمل؛ نظام كاميرا يفحص مقابل نموذج عيب لا يُرهَق. النتيجة كشف أكثر ثباتاً دون إضافة موظفين لمرحلة الفحص.</p>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر في التصنيع</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الصيانة التنبؤية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج مبنية على المستشعرات تتنبأ بعطل المعدات قبل حدوثه، مانحة فرق الصيانة تدخلاً بجدول مخطط بدل رد فعل على عطل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُبلَّغ عن تخفيض توقف بنسبة ٣٠ إلى ٥٠٪ في التطبيقات الناضجة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">visibility</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ضبط جودة بالرؤية الحاسوبية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أنظمة كاميرا مُدرَّبة على أمثلة عيوب تلتقط تناقضات بسرعة الخط قد يُفوّتها مفتشون بشريون خلال نوبات طويلة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مُتبنّى على نطاق واسع عبر خطوط تجميع الإلكترونيات والسيارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">جدولة وتحسين الإنتاج</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تحسين توازن أولوية الطلب وتوفر الآلة وتكلفة التبديل أسرع بكثير من الجدولة اليدوية، خاصة عبر خطوط إنتاج متعددة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل الطاقة الخاملة ويُحسّن معدلات التسليم في الوقت المحدد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقّع الطلب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج توقّع تدمج الموسمية وتاريخ الطلبات وإشارات كلية لتخطيط الإنتاج وشراء المواد الخام بمفاجآت أقل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل نفاد المخزون وتكاليف الاحتفاظ الزائدة معاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">view_in_ar</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التوائم الرقمية والمحاكاة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج افتراضية لخطوط الإنتاج تتيح للمهندسين اختبار تغييرات العملية وتعديلات التخطيط قبل الالتزام برأس مال لتغيير فعلي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل مخاطر وتكلفة تغييرات العملية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">precision_manufacturing</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الروبوتات وأتمتة العمليات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">روبوتات موجَّهة بالذكاء الاصطناعي تتولى المهام المتكررة والمُجهدة جسدياً بمرونة متزايدة، متكيّفة مع تغيّر طفيف بالقطع دون إعادة برمجة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تُنشَر بشكل متزايد جنباً لجنب مع العمال البشريين، لا بمعزل عنهم</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" style="background:#e7eeff;" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعل ذكاء التصنيع يعمل فعلياً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">جاهزية المستشعرات والبيانات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">نماذج الصيانة التنبؤية وفحص الجودة تحتاج بيانات مستشعر أو كاميرا متسقة للتدريب عليها. نُقيّم ما تجمعونه بالفعل قبل التوصية بعتاد جديد.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع MES وERP</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أدوات الجدولة والتوقع تعمل فقط متصلة بالأنظمة التي تُدير مصنعكم فعلياً. لوحة مستقلة لا يفحصها أحد لا تُحدث فرقاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">سهولة استخدام أرضية المصنع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أدوات مبنية للمهندسين لا تعمل دائماً لمشغّلي الخط. الواجهات يجب أن تناسب طريقة عمل طاقم أرضية مصنعكم بالفعل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">السلامة والتصميم الآمن عند الفشل</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الأنظمة التي تؤثر على معدات فعلية تحتاج افتراضات آمنة عند الفشل. توصية ذكاء اصطناعي يجب ألا تفرض إجراءً غير آمن دون تأكيد بشري.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات حول الذكاء الاصطناعي في التصنيع</h2>
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٥٠ مليار$</p>
        <p style="color:#42474e; font-size:0.875rem;">تكلفة سنوية مقدّرة للتوقف غير المخطط للمصنّعين (Deloitte)</p>
      </div>
      <div class="card" style="text-align:center;">
