    [data-financebanking-tab-panel][hidden] { display:none; }
</style>

<script>
  const financebankingTabWrap = document.querySelector('.financebanking-tabs');
  if (financebankingTabWrap) {
    const btns = financebankingTabWrap.querySelectorAll('.financebanking-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('[data-financebanking-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-financebanking-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { p.hidden = p.getAttribute('data-financebanking-tab-panel') !== key; });
      });
    });
  }
</script>
