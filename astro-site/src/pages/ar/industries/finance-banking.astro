    .financebanking-tab-btn { padding:0.625rem 1.25rem; border-radius:100px; border:1px solid rgba(0,37,59,0.15); background:#fff; color:#42474e; font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
    .financebanking-tab-btn:hover { background:#e7eeff; }
    .financebanking-tab-btn.active { background:#006875; border-color:#006875; color:#fff; }
    .financebanking-tab-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
    @media(max-width:900px) { .apps-grid { grid-template-columns:1fr 1fr; } .eval-grid { grid-template-columns:1fr 1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr 1fr !important; } }
