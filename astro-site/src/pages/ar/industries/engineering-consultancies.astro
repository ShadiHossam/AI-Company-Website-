---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل يستطيع الذكاء الاصطناعي التعامل مع المخططات وملفات CAD، أم المستندات النصية فقط؟", answer: "يستطيع فهرسة المخططات والمستندات المشتقة من CAD (ملفات PDF، واللوحات المصدَّرة، ومستندات المواصفات) والبحث فيها بما يكفي للإجابة عن سؤال مثل أي مخطط يعرض توزيع التكييف في الطابق الثالث، أو استخراج قسم المواصفات المناسب لرد على مناقصة. هو لا يعدّل ملفات CAD ولا يجري تحليلاً إنشائياً. اعتبروه مساعد بحث سريعاً ودقيقاً جداً عبر أرشيف مشاريعكم، لا أداة تصميم." },
  { question: "كيف تُحمى سرية العملاء والمشاريع؟", answer: "الوصول محدد لكل مشروع ولكل عميل، بنفس الطريقة التي يُفترض أن يكون عليها خادم الملفات أو نظام إدارة المستندات لديكم، فلا يُظهر الذكاء الاصطناعي أبداً المستندات الفنية لعميل رداً على استفسار يخص عميلاً آخر. وفي الأعمال الحكومية أو الخاضعة للتنظيم الحساسة، نطبق أيضاً ضوابط وصول أشد، ونبقي المعالجة عند الحاجة ضمن بنية تحتية مستضافة في الإمارات بما يطابق متطلبات إقامة البيانات لديكم." },
  { question: "ما القدر الذي يستطيع الذكاء الاصطناعي تغطيته فعلاً من فحص متطلبات الجهات الرسمية؟", answer: "يكون في أقوى حالاته عند التقاط المتطلبات المتكررة والموثقة جيداً، مثل التنسيق المعتاد، ومجموعات المستندات الإلزامية، وأسباب الرفض الشائعة، لدى الجهات التي تقدمون إليها بانتظام. إنه فحص أولي يلتقط الثغرات الواضحة قبل المراجعة النهائية المتخصصة من شخص. ولا يحل محل تقدير المهندس الذي يعتمد التقديم." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي للاستشارات الهندسية",
    "url": "https://lenooai.com/ar/industries/engineering-consultancies",
    "description": "أنظمة ذكاء اصطناعي للاستشارات الهندسية في الإمارات: صياغة الردود على المناقصات، وتجهيز التقديمات للجهات الرسمية، وتتبع طلبات الاستيضاح، والبحث في المستندات عبر المشاريع.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للاستشارات الهندسية"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الاستشارات الهندسية", "item": "https://lenooai.com/ar/industries/engineering-consultancies" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للاستشارات الهندسية في الإمارات | Lenoo AI"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي للاستشارات الهندسية في الإمارات: صياغة الردود على المناقصات، وتجهيز التقديمات للجهات الرسمية، وتتبع طلبات الاستيضاح، والبحث في مستندات المشاريع."
  canonicalPath="/ar/industries/engineering-consultancies"
  enPath="/industries/engineering-consultancies"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/industries" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الاستشارات الهندسية</div>
    <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">للاستشارات الهندسية في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي للاستشارات الهندسية في الإمارات: صياغة الردود على المناقصات، وتجهيز التقديمات للجهات الرسمية، وتتبع طلبات الاستيضاح، والبحث في المستندات عبر كل مشروع نفذتموه. ثنائية اللغة، ومتوافقة مع لوائح الإمارات، ومبنية على السرية افتراضياً.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_engineering_consultancies_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في استشارتكم الهندسية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1600&q=80&auto=format&fit=crop" alt="مهندسون يراجعون المخططات والرسومات الفنية" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "قابل للتكرار", caption: "معظم مستندات المناقصات والتقديمات تعتمد على نفس البنية في كل مرة" },
      { value: "جهات متعددة", caption: "لكل منها متطلبات تقديم خاصة يجب تتبعها" },
      { value: "سنوات", caption: "من أرشيف المشاريع لدى معظم الاستشارات دون أن يُبحث فيه" },
    ]} />
  </div>
</div>

<!-- WHY THIS FITS -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا المناقصات والتقديمات للجهات الرسمية عمل متكرر متنكر في هيئة عمل مخصص</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>كل مشروع يبدو فريداً من الخارج.</strong> موقع مختلف، وعميل مختلف، ومواصفات مختلفة. لكن عملية الرد على مناقصة، أو تجهيز تقديم للبلدية أو الدفاع المدني، تتبع بنية كررتها شركتكم عشرات المرات: نفس مجموعات المستندات، ونفس البنود المعتادة، ونفس فئات المعلومات المطلوبة بترتيب مختلف قليلاً في كل مرة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>هذا التكرار بالضبط ما لا ينبغي أن يقضي مهندسو الشركة ساعاتهم المدفوعة في إعادة تجميعه يدوياً.</strong> المهندس الأول الذي يصيغ رداً على مناقصة من صفحة فارغة يعيد عملاً أنجزته الشركة فعلياً في آخر مشروع مماثل، فقط دون نظام يُظهره.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>وفي الأثناء، الأرشيف نفسه أصل غير مستغل.</strong> سنوات من المخططات والمواصفات والمراسلات السابقة تقبع في مجلدات قابلة للبحث تقنياً لكنها ليست كذلك عملياً، لأن العثور على المستند الصحيح يعني أن يتذكر أحدهم في أي مشروع كان ويبحث في بنية الملفات يدوياً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=800&q=80&auto=format&fit=crop" alt="فريق هندسي يراجع مستندات المشروع على حاسوب محمول" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للاستشارات الهندسية</h2>
      <p>ستة أنظمة مبنية حول واقع العمل الاستشاري الكثيف بالمستندات، كل منها متكامل مع أرشيف مشاريعكم الحالي.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">edit_document</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد صياغة الردود على المناقصات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع مسودة أولى للرد على المناقصة من تقديمات شركتكم السابقة ومحتواها المعتاد، فيبدأ المهندس من مسودة قوية بدلاً من صفحة فارغة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gavel</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تجهيز مستندات التقديم للجهات الرسمية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع مجموعة المستندات المطلوبة لتقديم إلى جهة معينة، وينبّه إلى البنود الناقصة مقابل قائمة التحقق المعتادة لتلك الجهة قبل التقديم.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">track_changes</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تتبع طلبات الاستيضاح والاستفسارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسجل كل طلب استيضاح مع حالته ومن يملك الرد والموعد النهائي، فلا يبقى شيء دون رد لأنه دُفن في صندوق وارد.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">البحث في المخططات والمستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجد المخطط أو قسم المواصفات أو المراسلة السابقة الصحيحة عبر أرشيف مشاريعكم كاملاً بوصف ما تبحثون عنه، لا بتذكر مسار الملف.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">checklist</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة قوائم التحقق من الامتثال</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يفحص التقديم مقابل قائمة التحقق المناسبة تلقائياً، فيلتقط صفحة توقيع ناقصة أو شهادة منتهية قبل أن يضطر المراجع لذلك.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">follow_the_signs</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت متابعة العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتابع العروض المعلقة وفق جدول محدد، فيبقي الصفقة حية دون أن يضطر الشريك لتذكر أي عميل كان عليه التواصل معه.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">مبني على السرية وضبط الوصول افتراضياً، ومتكامل مع نظام إدارة المستندات الحالي لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_engineering_consultancies_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في استشارتكم الهندسية</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">مناقصة واحدة، من طلب العروض حتى التقديم</h2>
      <p>ما يتولاه الذكاء الاصطناعي من لحظة وصول المناقصة حتى لحظة تقديم ردكم.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الرد يُجمع من قاعدة معارف</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">تصل مناقصة جديدة، فيسحب الذكاء الاصطناعي الأقسام المناسبة من تقديمات شركتكم السابقة ومحتواها المعتاد.</p>
        <ul class="journey-list">
          <li>يطابق متطلبات المناقصة مع مشاريع سابقة مماثلة</li>
          <li>يصيغ الأقسام المعتادة، كالمنهجية ومؤهلات الشركة والخبرات السابقة، تلقائياً</li>
          <li>يترك الأقسام الفنية والتسعير ليكملها مهندسوكم</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">التقديم يُفحص مقابل المتطلبات تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">قبل خروج أي شيء، يجري الذكاء الاصطناعي فحص امتثال مقابل المطلوب فعلاً.</p>
        <ul class="journey-list">
          <li>ينبّه إلى المستندات الناقصة مقابل قائمة تحقق الجهة أو المناقصة</li>
          <li>يتحقق من التنسيق والتوقيعات المطلوبة</li>
          <li>يُظهر أي شيء يبدو غير متسق مع النطاق المعلن للمناقصة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المتابعة التي تبقي الصفقة حية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بعد التقديم، يبقي الذكاء الاصطناعي العلاقة نشطة دون أن يضطر أحد للتذكر.</p>
        <ul class="journey-list">
          <li>يرسل متابعات مجدولة حتى صدور القرار</li>
          <li>يتتبع طلبات الاستيضاح المطروحة أثناء التقييم ويوجهها إلى المهندس المناسب</li>
          <li>يسجل النتيجة، فوزاً أو خسارة، في سجل الشركة للرجوع إليها مستقبلاً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">draw</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">صياغة المناقصات والعروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقليص الوقت للوصول إلى مسودة أولى قوية، فيقضي كبار المهندسين وقتهم في الجوهر الفني بدلاً من إعادة تجميع النصوص المعتادة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">rule_folder</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تجهيز التقديمات للجهات الرسمية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">التقاط المستندات الناقصة أو المنتهية قبل رفض التقديم لسبب شكلي، وهو ما يكلف دورة إعادة تقديم كان يمكن لقائمة تحقق أن تمنعها.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">manage_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">البحث في المستندات عبر المشاريع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تحويل سنوات من أرشيف المشاريع من مكان تذهب إليه الأشياء لتُنسى إلى مورد يستخدمه المهندسون فعلاً في الأعمال الجديدة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
