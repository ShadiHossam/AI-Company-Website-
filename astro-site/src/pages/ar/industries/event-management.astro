---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل سيفهم مولّد العروض بالذكاء الاصطناعي فعالياتنا تحديداً، أم أنه يملأ قالباً عاماً فقط؟", answer: "يعمل من عروضكم السابقة وبيانات فعالياتكم، لا من مكتبة عامة. تزودونه بهيكل أسعاركم، ومستويات الباقات، ومجموعة من الفعاليات التي نفذتموها سابقاً، فيصيغ نسخة أولى بمطابقة الاستفسار مع أقرب الأعمال المماثلة التي نفذتموها فعلاً. ويبقى منظم الفعاليات من يراجع كل عرض ويعدّله قبل إرساله. الذكاء الاصطناعي يزيل مشكلة الصفحة الفارغة، لا الحاجة إلى التقدير." },
  { question: "هل يستطيع روبوت تأكيد الحضور التعامل مع قائمة ضيوف بالمئات دون أن يتعطل؟", answer: "نعم، والأحجام الكبيرة هي بالضبط حيث يثبت قيمته. المنسق الذي يلاحق ٤٠٠ ضيف يدوياً عبر واتساب والبريد الإلكتروني والمكالمات هو حيث تضيع الأمور. يرسل الروبوت الدعوات، ويسجل الردود فور وصولها، ويتابع تلقائياً مع من لم يردوا وفق جدول تحددونه، ويحتفظ بعدد حضور حي يستطيع فريقكم مراجعته في أي وقت، بما فيه تفاصيل الأنظمة الغذائية والمرافقين." },
  { question: "ما القدر الذي يمكن أتمتته فعلاً من التنسيق مع الموردين، مقابل ما يحتاج شخصاً لإدارة العلاقات؟", answer: "تتولى الأتمتة طبقة التنسيق المتكررة: إرسال المتطلبات المؤكدة إلى متعهدي الطعام وموردي الصوت والصورة، وملاحقة التأكيدات المعلقة، والتنبيه إلى تعارض الجداول الزمنية بين الموردين، وإبقاء الجميع على اطلاع عند تغير أي تفصيل. أما التفاوض على الأسعار، واختيار المورد المناسب لكل عميل، والتعامل مع مورد ضعيف الأداء، فلا يزال يحتاج شخصاً. اعتبروها إزالة لملاحقة الحالة، لا لإدارة العلاقات." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات تنظيم الفعاليات في الإمارات",
    "url": "https://lenooai.com/ar/industries/event-management",
    "description": "أنظمة ذكاء اصطناعي مخصصة لشركات تنظيم الفعاليات في الإمارات: روبوتات استقبال الاستفسارات، وإنشاء العروض، والتنسيق مع الموردين، وأتمتة تأكيد الحضور.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي لتنظيم الفعاليات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لتنظيم الفعاليات", "item": "https://lenooai.com/ar/industries/event-management" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لشركات الفعاليات في الإمارات"
  description="كيف تستخدم شركات تنظيم الفعاليات في الإمارات الذكاء الاصطناعي لاستقبال الاستفسارات، وإنشاء العروض، والتنسيق مع الموردين، وأتمتة تأكيد الحضور. دليل من وكالة ذكاء اصطناعي في دبي."
  canonicalPath="/ar/industries/event-management"
  enPath="/industries/event-management"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>تنظيم الفعاليات</div>
    <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لشركات تنظيم الفعاليات في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لشركات تنظيم الفعاليات في الإمارات: روبوتات تأهيل الاستفسارات، وإنشاء العروض من فعالياتكم السابقة، والتنسيق مع الموردين، وأتمتة تأكيد الحضور التي تتسع من ٥٠ ضيفاً إلى ٥٠٠. ثنائية اللغة، ومتكاملة مع الأدوات التي تستخدمونها.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_event_management_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في تنظيم الفعاليات</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1600&q=80&auto=format&fit=crop" alt="قاعة فعاليات أنيقة مجهزة لحفل شركة في دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى للتحويل عند التواصل مع العميل المحتمل خلال ٥ دقائق، لا ٣٠ (MIT)" },
      { value: "24/7", caption: "تغطية للاستفسارات، بما فيها المساء وعطلات نهاية الأسبوع حين يصل معظمها فعلاً" },
      { value: "١", caption: "مكان واحد لرؤية كل تأكيد حضور وملاحظة غذائية وتأكيد مورد، بدلاً من خمسة صناديق وارد" },
    ]} />
  </div>
</div>

<!-- WHY EVERY EVENT DIFFERENT DOESN'T MEAN INTAKE HAS TO BE -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا «كل فعالية مختلفة» لا يعني أن عملية الاستقبال يجب أن تكون كذلك</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>لا تتشابه فعاليتان، لكن كل استفسار يطرح نفس الأسئلة الأولى.</strong> حفل شركة، وإطلاق منتج، وحفل زفاف أعمال مختلفة بموردين مختلفين وميزانيات مختلفة. لكن المحادثة الأولى مع كل منها تغطي نفس الأرضية: التاريخ، وعدد الضيوف، ونطاق الميزانية، وتفضيل المكان، والجدول الزمني. هذا الجزء من العملية قابل للتكرار، حتى حين لا تكون الفعالية نفسها كذلك.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>منظمو الفعاليات يخسرون ساعات على استفسارات لم تكن لتتحول إلى حجز أبداً.</strong> رسالة على إنستغرام، ونموذج على الموقع، ورسالة واتساب من إحالة، كل منها يحتاج رداً، وكل رد يأخذ وقتاً لا يملكه فريق صغير في موسم مزدحم. وفي الأثناء، الاستفسار الذي لديه ميزانية وتاريخ محدد فعلاً ينتظر في نفس الطابور مع من يتصفح الأسعار فقط، ولا يعرف الفريق أيهما أيهما إلا بعد مكالمة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>ما يتغير بعد ذلك التبادل الأول هو حيث يجب أن يبدأ عمل التخطيط الحقيقي.</strong> بمجرد وضع الميزانية والتاريخ والنطاق على الطاولة، يصبح تقدير المنظم مهماً: مطابقة العميل مع المكان المناسب، واختيار مزيج الموردين المناسب، وبناء فكرة تناسب المطلوب. يستطيع الذكاء الاصطناعي تولي الواجهة المتكررة من المسار وترك الجزء الذي يحتاج شخصاً فعلاً لذلك الشخص.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80&auto=format&fit=crop" alt="فريق تخطيط فعاليات يراجع مخطط القاعة وقائمة الموردين" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات تنظيم الفعاليات في دبي</h2>
      <p>ستة أنظمة محددة تبنيها وكالتنا للذكاء الاصطناعي في دبي لشركات الفعاليات في أنحاء الإمارات، كل منها متصل بنظام إدارة العملاء وقنوات التواصل الحالية لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت استقبال الاستفسارات وتأهيلها</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرد على كل استفسار جديد خلال دقائق على واتساب وإنستغرام ونموذج موقعكم. يسأل عن التاريخ ونطاق الميزانية وعدد الضيوف ونوع الفعالية، ثم يسلّم فريقكم ملخصاً مؤهلاً بدلاً من «أخبرونا المزيد» الباردة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المحتملون الذين يُتواصل معهم خلال ٥ دقائق أعلى احتمالاً للتحويل بـ ٩ مرات (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد إنشاء العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ عرضاً أولياً من الملخص المؤهل، ساحباً هيكل الباقات والأسعار والمشمولات من فعالياتكم السابقة. يعدّل المنظم ويرسل. ما كان يأخذ أمسية كاملة أصبح يأخذ عشرين دقيقة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني من سجل عروضكم، لا من مكتبة قوالب عامة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">handshake</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التنسيق مع الموردين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل المتطلبات المؤكدة إلى متعهدي الطعام وموردي الصوت والصورة وفرق الديكور، ويلاحق التأكيدات المعلقة تلقائياً، وينبّه إلى تعارض الجداول قبل أن يصبح مشكلة يوم الفعالية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي كل الموردين على نفس المتطلبات المؤكدة، دون محادثات واتساب منفصلة للمتابعة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">how_to_reg</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تأكيد الحضور والتواصل مع الضيوف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل الدعوات، ويسجل تأكيدات الحضور فور وصولها، ويجمع المتطلبات الغذائية وعدد المرافقين، ويتابع مع من لم يردوا وفق جدول تحددونه. عدد حضور حي يستطيع فريقكم مراجعته في أي ساعة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتعامل مع قوائم ضيوف بالمئات دون ملاحقة يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">timeline</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تتبع الجدول الزمني والمهام</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني جدول سير يوم الفعالية ويحدّثه من تأكيدات الموردين ومتطلبات العميل، ويرسل التذكيرات إلى الشخص المناسب قبل أن يفوت الموعد، لا بعده.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">جدول زمني حي واحد بدلاً من خمس نسخ في خمس محادثات مختلفة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">reviews</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">جامع الملاحظات بعد الفعالية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل طلب ملاحظات قصيراً إلى العميل، وإلى الضيوف عند الحاجة، خلال يوم من انتهاء الفعالية، بينما التجربة لا تزال حاضرة. وتدخل الردود مباشرة في مكتبة دراسات الحالة والشهادات لديكم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يلتقط الملاحظات وهي حاضرة، لا بعد أسابيع حين تُنسى</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام مبني حول فعالياتكم وباقاتكم وقائمة مورديكم، لا حول قالب عام.</p>
      <button onclick="openModal(this)" data-source="ar_event_management_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في تنظيم الفعاليات</button>
    </div>
  </div>
</section>

<!-- ONE EVENT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">فعالية واحدة، من الاستفسار حتى الختام</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، فيقضي منظموكم وقتهم في الأجزاء التي تحتاج شخصاً.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مؤهل بالميزانية والتاريخ قبل أي مكالمة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">استفسار جديد يصل على واتساب أو إنستغرام في وقت متأخر من المساء، والروبوت يرد بالفعل.</p>
        <ul class="journey-list">
          <li>يؤكد نوع الفعالية والتاريخ وعدد الضيوف ونطاق الميزانية في أول تبادل</li>
          <li>ينبّه إن كان التاريخ واقعياً مقارنة بتقويم حجوزاتكم الحالي</li>
          <li>يسلّم المنظم ملخصاً كاملاً، لا عميلاً بارداً عليه ملاحقته للأساسيات</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">العرض يُصاغ من قالب وفعاليات سابقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تأكيد الملخص، يصيغ الذكاء الاصطناعي النسخة الأولى من العرض، لا من الصفر.</p>
        <ul class="journey-list">
          <li>يطابق الاستفسار مع أقرب فعالية سابقة مماثلة لديكم</li>
          <li>يسحب الأسعار الحالية ومشمولات الباقات وخيارات الموردين تلقائياً</li>
          <li>يترك للمنظم المراجعة وتعديل الفكرة وإضافة اللمسات الشخصية التي تحسم الصفقة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">قائمة تأكيد الحضور التي تدير نفسها</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد حجز الفعالية، يبدأ التواصل مع الضيوف، ولا يتوقف حتى يصل آخر تأكيد حضور.</p>
        <ul class="journey-list">
          <li>الدعوات تخرج، والردود تُسجل، والملاحظات الغذائية والمرافقون يُلتقطون تلقائياً</li>
          <li>من لم يردوا يتلقون متابعة وفق جدول تحددونه، دون منسق يتتبع يدوياً من رد</li>
          <li>الفريق يراجع عدد حضور حياً واحداً بدلاً من مقارنة خمس محادثات منفصلة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاستقبال والتأهيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">شركات الفعاليات الأسرع رداً على الاستفسارات تفوز عادةً بالحجز، لأن العملاء الذين يخططون لزفاف أو إطلاق يتحدثون غالباً مع أكثر من شركة في الوقت نفسه. روبوت التأهيل بالذكاء الاصطناعي يعني أن الرد الأول يأتي خلال دقائق لا في الصباح التالي، ويأتي والأسئلة مُجابة أصلاً بدلاً من مطالبة العميل بإعادة شرح طلبه في مكالمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المحتملون الذين يُتواصل معهم خلال ٥ دقائق أعلى احتمالاً للتحويل بـ ٩ مرات (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة إعداد العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كتابة العروض من أكبر مستهلكات الوقت لفريق تخطيط صغير، خاصة في ذروة موسم الأعراس أو فعاليات الشركات حين تحتاج عدة استفسارات عروضاً في آن واحد. الصياغة من فعالية سابقة مطابقة بدلاً من مستند فارغ تقلص الوقت من ساعات إلى دقائق، وتتيح للشركة إرسال عرض أول في نفس يوم وصول الاستفسار.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العروض المرسلة في نفس اليوم هي التي يتذكرها العملاء بإيجابية باستمرار</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">how_to_reg</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التواصل مع الضيوف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">زفاف بـ ٣٠٠ ضيف أو حفل شركة بـ ٥٠٠ شخص يولّد حجماً من رسائل تأكيد الحضور وأسئلة الطعام والاستفسارات اللوجستية يُغرق سريعاً فريقاً صغيراً يعمل يدوياً. أتمتة مسار تأكيد الحضور تعني أن كل ضيف يحصل على رد سريع ويبقى عدد الحضور دقيقاً حتى يوم الفعالية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتسع بنفس الطريقة سواء كانت قائمة الضيوف ٥٠ أو ٥٠٠</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إنشاء عروض قائم على قوالب من فعاليات سابقة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">ذكاء العروض الاصطناعي جيد بقدر الفعاليات التي تدرّب عليها. يحتاج الوصول إلى فعالياتكم المنفذة فعلاً وأسعاركم وهيكل باقاتكم، لا إلى قالب عام للقطاع، لتبدو المسودة التي ينتجها كشيء سترسله شركتكم فعلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التنسيق مع موردين متعددين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الفعالية الواحدة تشمل عادةً على الأقل متعهد طعام ومكاناً وفريق صوت وصورة ومورد ديكور. والتنسيق الذي يتتبع محادثة مورد واحد يفوّت الجوهر. يحتاج النظام إلى الإحاطة بكامل قائمة الموردين للفعالية والتنبيه حين يتعارض جدول مورد مع آخر.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التواصل مع أعداد كبيرة من الضيوف</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قائمة المدعوين لزفاف وقائمة الحضور لفعالية شركة تتصرفان بشكل مختلف: الأولى تحتاج دفئاً ولمسات شخصية، والثانية تحتاج سرعة ووضوحاً. نظام تأكيد الحضور يحتاج إلى التعامل مع النبرتين دون أن يبدو كرسالة جماعية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع المواسم وأوقات الذروة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">موسم الفعاليات في الإمارات يتركز حول الأشهر الأبرد والأعياد الوطنية والحجوزات المحيطة برمضان. النظام الذي يعمل جيداً بحجم منخفض لكنه ينهار حين تصل عشرة استفسارات في ساعة واحدة ليس مبنياً لطريقة عمل هذا القطاع فعلاً.</p>
      </div>
    </div>
  </div>
</section>

