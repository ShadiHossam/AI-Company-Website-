---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات إدارة الفعاليات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/event-management",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "إدارة الفعاليات", "item": "https://lenooai.com/ar/industries/event-management" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات إدارة الفعاليات في الإمارات",
    "description": "بوت استقبال وتأهيل استفسارات، توليد عروض أسعار، تنسيق موردين، وأتمتة تأكيد الحضور لشركات إدارة الفعاليات في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل مولّد العروض بالذكاء الاصطناعي يفهم فعاليتنا الخاصة فعلاً، أم يملأ قالباً عاماً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يعمل من عروضكم وبيانات فعالياتكم السابقة، لا مكتبة عامة. تزوّدونه بهيكل التسعير وباقاتكم وفعاليات سابقة، ويُسوّد نسخة أولى بمطابقة الاستفسار مع أقرب عمل مماثل نفّذتموه فعلاً. المخطط يراجع ويُعدّل كل عرض قبل إرساله." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع بوت تأكيد الحضور التعامل مع قائمة ضيوف بالمئات دون تعطل؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، الحجم الكبير هو بالضبط مكان تميّزه. يرسل الدعوات، يُسجّل الردود فور وصولها، ويتابع تلقائياً مع من لم يردّ، ويُبقي عدداً حياً يتحقق منه فريقكم بأي وقت." }
      },
      {
        "@type": "Question",
        "name": "كم يمكن أتمتته فعلياً من تنسيق الموردين، مقابل ما يحتاج شخصاً لإدارة العلاقات؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الأتمتة تتولى طبقة التنسيق المتكررة: إرسال المتطلبات المؤكدة لموردي الطعام والصوتيات، ملاحقة التأكيدات المعلّقة، والتنبيه لتعارض الجداول الزمنية. التفاوض على الأسعار واختيار المورد المناسب وإدارة مورد متأخر الأداء لا يزال يحتاج شخصاً." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات إدارة الفعاليات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت تأهيل استفسارات وتوليد عروض وتنسيق موردين لشركات إدارة الفعاليات في الإمارات، من ٥٠ ضيفاً إلى ٥٠٠."
  canonicalPath="/ar/industries/event-management"
  enPath="/industries/event-management"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>إدارة الفعاليات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">celebration</span>
      إدارة الفعاليات
    </div>
    <h1>ذكاء اصطناعي لشركات إدارة الفعاليات في دبي<br><span class="gradient-text">كل فعالية مختلفة، لكن الاستقبال لا يجب أن يكون كذلك</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      حفل شركة وحفل زفاف وإطلاق منتج مشاريع مختلفة، لكن المحادثة الأولى مع كل منها تغطي نفس الأرض: التاريخ، عدد الضيوف، الميزانية. نبني لك بوتاً يؤهّل الاستفسارات فوراً، يُسوّد عروض أسعار من فعالياتكم السابقة، وينسّق الموردين تلقائياً.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_event_management_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1600&q=80&auto=format&fit=crop" alt="مكان فعالية أنيق مُجهّز لفعالية شركة في دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند الرد خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية استفسارات، حتى المساء وعطلة الأسبوع</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">مكان واحد</p>
        <p class="stat-lbl">لكل تأكيد حضور ومورد، بدل خمسة صناديق وارد</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة إدارة الفعاليات</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بنظام إدارة العملاء وقنوات التواصل لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">fact_check</span>
        <h3>بوت استقبال وتأهيل استفسارات</h3>
        <p style="color:#42474e;line-height:1.7;">يجيب على كل استفسار خلال دقائق على واتساب وإنستغرام وموقعك، يسأل عن التاريخ والميزانية وعدد الضيوف.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">description</span>
        <h3>مساعد توليد العروض</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد عرضاً أولياً من الملخص المؤهَّل، سحباً لهيكل الباقة والتسعير من فعالياتكم السابقة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">handshake</span>
        <h3>تنسيق الموردين</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل المتطلبات المؤكدة لموردي الطعام والصوتيات والديكور، ويلاحق التأكيدات المعلّقة تلقائياً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">how_to_reg</span>
        <h3>بوت تأكيد الحضور والتواصل</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل الدعوات، يُسجّل التأكيدات فور وصولها، يجمع المتطلبات الغذائية، ويتابع مع من لم يردّ.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">timeline</span>
        <h3>متابعة الجدول الزمني والمهام</h3>
        <p style="color:#42474e;line-height:1.7;">يبني ويُحدّث جدول يوم الفعالية من تأكيدات الموردين ومتطلبات العميل، ويُذكّر قبل تفلّت أي موعد.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">reviews</span>
        <h3>جامع ملاحظات ما بعد الفعالية</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل طلب ملاحظات مختصراً للعميل خلال يوم من انتهاء الفعالية، بينما التجربة لا تزال حاضرة.</p>
      </div>
    </div>
  </div>
</section>

<!-- ONE EVENT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">فعالية واحدة، من الاستفسار للختام</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، ليقضي مخططوك وقتهم على ما يحتاج فعلياً شخصاً.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مؤهَّل بالميزانية والتاريخ قبل أي مكالمة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">استفسار جديد يصل على واتساب أو إنستغرام مساءً. البوت يردّ بالفعل.</p>
        <ul class="journey-list">
          <li>يؤكد نوع الفعالية والتاريخ وعدد الضيوف ونطاق الميزانية في التبادل الأول</li>
          <li>يُنبّه إذا كان التاريخ واقعياً مقابل تقويم حجوزاتكم الحالي</li>
          <li>يُسلّم المخطط ملخصاً كاملاً، لا عميلاً محتملاً باهتاً يحتاج ملاحقة أساسيات</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عرض يُسوَّد من فعاليات سابقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تأكيد الملخص، يُسوّد الذكاء الاصطناعي النسخة الأولى من العرض، لا من الصفر.</p>
        <ul class="journey-list">
          <li>يطابق الاستفسار مع أقرب فعالية سابقة مماثلة نفّذتموها</li>
          <li>يسحب التسعير الحالي وتضمينات الباقة وخيارات الموردين تلقائياً</li>
          <li>يترك المخطط يراجع ويُضيف اللمسة الشخصية التي تُغلق الصفقة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">قائمة تأكيد الحضور التي تُدير نفسها</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد حجز الفعالية، يبدأ التواصل مع الضيوف ولا يتوقف حتى آخر تأكيد.</p>
        <ul class="journey-list">
          <li>الدعوات تُرسل، الردود تُسجّل، الملاحظات الغذائية تُلتقط تلقائياً</li>
          <li>من لم يردّ يحصل على متابعة بجدول محدد</li>
          <li>فريقكم يتحقق من عدد حي واحد بدل مقارنة خمس محادثات منفصلة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاستقبال والتأهيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">شركات الفعاليات التي تردّ أسرع تفوز بالحجز عادة، لأن العميل يتحدث دائماً مع أكثر من شركة معاً. بوت تأهيل يعني رداً أولاً خلال دقائق، لا الصباح التالي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">فرصة تحويل أعلى بـ٩ مرات عند الرد خلال ٥ دقائق (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">كتابة العروض من أكبر مستنزفات وقت فريق تخطيط صغير، خاصة بموسم الأعراس أو الفعاليات المزدحم. الصياغة من فعالية سابقة مطابقة بدل مستند فارغ تُقلّص الوقت من ساعات لدقائق.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العروض المُرسلة بنفس اليوم يتذكرها العملاء بشكل إيجابي باستمرار</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">how_to_reg</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تواصل الضيوف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">زفاف بـ٣٠٠ ضيف أو حفل شركة بـ٥٠٠ شخص يُولّد حجماً من رسائل التأكيد والأسئلة يُثقل فريقاً صغيراً يعمل يدوياً. أتمتة التدفق تعني رداً سريعاً لكل ضيف.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتوسّع بنفس الطريقة سواء كانت قائمة الضيوف ٥٠ أو ٥٠٠</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">توليد عروض من فعاليات سابقة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">ذكاء اصطناعي للعروض جيد بقدر الفعاليات المُدرَّب عليها. يحتاج وصولاً لفعالياتكم المُنجزة الفعلية وتسعيركم، لا قالباً صناعياً عاماً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تنسيق موردين متعددين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فعالية واحدة عادة تشمل مورد طعام وموقعاً وفريق صوتيات وديكور على الأقل. النظام يحتاج الاحتفاظ بقائمة الموردين الكاملة والتنبيه لتعارض جدول.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تواصل ضيوف عالي الحجم</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قائمة دعوة زفاف وقائمة حضور شركة تتصرفان بشكل مختلف: واحدة تحتاج دفئاً ولمسة شخصية، الأخرى سرعة ووضوحاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع الذروة الموسمية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">موسم الفعاليات في الإمارات يتركّز حول الأشهر الأبرد والعطلات الوطنية ورمضان. نظام يعمل جيداً بحجم منخفض لكن ينهار عند وصول عشرة استفسارات بساعة واحدة غير مناسب لهذه الصناعة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1200&q=80&auto=format&fit=crop" alt="منسّق فعالية يؤكد تفاصيل نهائية مع عميل في الموقع" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
