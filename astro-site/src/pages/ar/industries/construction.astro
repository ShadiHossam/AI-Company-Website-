---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "ما مدى دقة الذكاء الاصطناعي في قراءة الصور والملاحظات الصوتية من الموقع؟", answer: "تقارير الموقع المبنية من الصور والملاحظات الصوتية تذهب إلى مهندس المشروع للمراجعة قبل اعتمادها، تماماً كما يحدث مع تقرير يكتبه موظف مبتدئ. يصيغ الذكاء الاصطناعي البنية ويستخرج التفاصيل التي يستطيع تحديدها بثقة (الموقع، والتخصص، والكميات المذكورة)، وأي شيء غامض يُعلَّم بدلاً من تخمينه." },
  { question: "هل يستطيع التعامل مع عدة مقاولين من الباطن باحتياجات وصول مختلفة؟", answer: "نعم. الوصول محدد حسب التخصص والمشروع، فيرى المقاول من الباطن طلبات الاستيضاح والتقديمات والمخططات المتعلقة بنطاقه، لا ملف المشروع كاملاً. المقاولون الرئيسيون والاستشاريون يحصلون على الصورة الكاملة، والمقاولون من الباطن يحصلون بالضبط على ما يحتاجونه لأداء دورهم." },
  { question: "هل يحتاج هذا إلى اتصال إنترنت دائم في الموقع ليعمل؟", answer: "يمكن التقاط الصور والملاحظات الصوتية في الموقع وإرسالها فور توفر اتصال، سواء كان شبكة الموقع اللاسلكية، أو نقطة اتصال شخصية، أو بيانات الهاتف العادية حين يعود أحدهم قرب مكتب الموقع. هو مبني حول طريقة التواصل الفعلية في مواقع الإمارات، واتساب في الغالب، لا حول افتراض اتصال دائم." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات المقاولات في الإمارات",
    "url": "https://lenooai.com/ar/industries/construction",
    "description": "تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات المقاولات في الإمارات: تتبع طلبات الاستيضاح والتقديمات، وأتمتة تقارير الموقع، والتواصل مع المقاولين من الباطن، وتقارير التقدم.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي لشركات المقاولات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للمقاولات", "item": "https://lenooai.com/ar/industries/construction" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي للمقاولات في الإمارات"
  description="ذكاء اصطناعي لشركات المقاولات في الإمارات: تتبع طلبات الاستيضاح والتقديمات، وأتمتة تقارير الموقع، والتواصل مع المقاولين من الباطن، وتقارير التقدم."
  canonicalPath="/ar/industries/construction"
  enPath="/industries/construction"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>المقاولات</div>
    <h1>ذكاء اصطناعي لشركات<span class="h1-sep">: </span><br><span class="gradient-text">المقاولات في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات المقاولات في الإمارات: تتبع طلبات الاستيضاح والتقديمات، وأتمتة تقارير الموقع، والتواصل مع المقاولين من الباطن، وتقارير التقدم. مبنية حول واتساب وطريقة عمل فرق مواقعكم الحالية، لا منصة جديدة عليهم تعلّمها.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_construction_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في المقاولات</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="مدير موقع ينسق العمل في مشروع إنشائي في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "واتساب أولاً", caption: "الطريقة التي ترسل بها معظم فرق المواقع في الإمارات طلبات الاستيضاح والصور والتحديثات اليومية" },
      { value: "كل مشروع", caption: "يولّد طلبات استيضاح وتقديمات وتقارير تُدفن في المحادثات" },
      { value: "سجل كامل", caption: "لكل طلب استيضاح ومراجعة مخطط وموافقة، محفوظ في مكان واحد قابل للبحث" },
    ]} />
  </div>
</div>

<!-- WHY ADMIN BURIES SITE TEAMS -->
<section class="section" aria-labelledby="admin-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="admin-heading" style="margin-bottom:1.5rem;">لماذا تُغرق الأعمال الإدارية فريق الموقع</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>طلبات الاستيضاح والتقديمات تتنقل عبر محادثات واتساب وسلاسل بريد لا يملكها أحد.</strong> سؤال أُرسل إلى استشاري يوم الإثنين قد يبقى دون رد لأسبوع، مدفوناً تحت كل ما وصل عبر المحادثة نفسها ذلك اليوم. لا أحد يتتبعه لأن تتبعه لم يكن يوماً مهمة أحد فعلاً، كان يُفترض أن يحدث وحده.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تقارير الموقع تُكتب من الذاكرة في نهاية يوم طويل.</strong> الصور والملاحظات الصوتية الملتقطة في الموقع خلال اليوم هي السجل الحقيقي لما حدث، لكن حين يجلس أحدهم لكتابة التقرير الرسمي يكون نصف التفاصيل قد ضاع. وما يُحفظ هو ملخص لملخص.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>التنسيق مع المقاولين من الباطن يقوم على المكالمات والأسئلة المتكررة.</strong> نفس تحديث الحالة يطلبه ثلاثة أشخاص مختلفين لأن لا أحد لديه رؤية واحدة حالية لموقف عمل المقاول من الباطن فعلاً. هذه ليست مشكلة المقاول من الباطن، بل مشكلة تواصل يشعر بها المكتب والموقع معاً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop" alt="فريق الموقع يراجع مخططات المشروع وتقدمه معاً" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- AI SYSTEMS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات المقاولات</h2>
      <p>ستة أنظمة مبنية لفرق البناء والمقاولات في الإمارات، ومتصلة بواتساب ومسار العمل الحالي في مواقعكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متتبع طلبات الاستيضاح والتقديمات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسجل كل طلب استيضاح وتقديم، ويتتبع من عليه الرد، وينبّه إلى أي شيء تجاوز موعده فلا يُدفن شيء في محادثة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">لا شيء ينتظر أن يتذكر أحدهم المتابعة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">photo_camera</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تقارير الموقع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحوّل الصور والملاحظات الصوتية المرسلة من الموقع عبر واتساب إلى تقرير يومي منظم، جاهز ليراجعه مهندس الموقع ويعتمده.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">التقرير يكتب نفسه مما يُرسل أصلاً، لا من نموذج جديد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت التواصل مع المقاولين من الباطن</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل طلبات الحالة إلى المقاولين من الباطن ويتتبعها، ويجمع تحديثات التقدم، ويعطي المكتب رؤية حالية دون جولة من المكالمات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تحديث حالة واحد، مرئي لكل من يحتاجه</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">folder_open</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد البحث في المستندات والمخططات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجد المراجعة الحالية لمخطط أو قسم مواصفات أو بند عقد عند الطلب، بدلاً من أن يبحث أحدهم في المجلدات أو سلاسل البريد القديمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">المستند الصحيح، بالمراجعة الحالية، في ثوانٍ</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">checklist</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لقوائم الملاحظات والنواقص</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني قوائم الملاحظات من صور الموقع وملاحظاته ويتتبعها، ويسند البنود إلى التخصص المناسب، ويؤكد إغلاق كل منها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل بند مفتوح يُتتبع حتى إغلاقه، لا يضيع في ملاحظة جولة تفقدية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحة تقارير التقدم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تجمع تقارير الموقع وحالة طلبات الاستيضاح وإغلاق الملاحظات في عرض حي لمديري المشاريع والعملاء، يتحدث مع تحديث الموقع، لا مرة في الأسبوع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الإدارة ترى حالة اليوم، لا حالة الخميس الماضي</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام مبني حول واتساب ومسارات الصور والملاحظات الصوتية التي تستخدمها فرق مواقعكم أصلاً.</p>
      <button onclick="openModal(this)" data-source="ar_construction_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في المقاولات</button>
    </div>
  </div>
</section>

<!-- PROJECT CYCLE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cycle-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="cycle-heading">دورة مشروع واحدة، من البداية إلى النهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يركز مديرو مشاريعكم على البناء، لا على الأوراق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">طلب الاستيضاح الذي لا يضيع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">يصل سؤال من الموقع عن تفصيل غير واضح في المخططات.</p>
        <ul class="journey-list">
          <li>يسجل طلب الاستيضاح فوراً مع إرفاق المخطط ومرجع المواصفات المعنيين</li>
          <li>يوجهه إلى الاستشاري المناسب ويتتبع موعد الرد</li>
          <li>ينبّه إليه تلقائياً إذا بقي مفتوحاً بعد موعده</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير الموقع الذي يكتب نفسه</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">طوال اليوم، يرسل موظفو الموقع الصور والملاحظات الصوتية كما يفعلون أصلاً.</p>
        <ul class="journey-list">
          <li>يستخرج التخصص والموقع وتفاصيل التقدم من الصور والملاحظات الصوتية المرسلة</li>
          <li>يصيغ تقريراً يومياً منظماً ليراجعه مهندس الموقع ويؤكده</li>
          <li>ينبّه إلى أي شيء يبدو مشكلة سلامة أو جودة للاهتمام الفوري</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديث المقاول من الباطن الذي لا يحتاج مكالمة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">المكتب يحتاج معرفة حالة تقدم مقاول من الباطن.</p>
        <ul class="journey-list">
          <li>يرسل طلب الحالة عبر واتساب بدلاً من جولة مكالمات</li>
          <li>يسجل رد المقاول من الباطن مقابل الجدول الزمني تلقائياً</li>
          <li>يحدّث لوحة التقدم فيراه المكتب دون أن يسأل مجدداً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التحكم في المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">طلبات الاستيضاح والتقديمات ومراجعات المخططات هي السجل الورقي الذي يحدد المسؤول عن أي تأخير. المقاولون الذين نتحدث معهم يقولون الشيء نفسه باستمرار: النسخة الحالية فعلاً نادراً ما تكون أول ما يجده أحدهم في تمرير واتساب أو بريد قديم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">نسخة حالية واحدة، تُوجد في ثوانٍ بدلاً من دقائق من التمرير</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التواصل بين الموقع والمكتب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الصور والملاحظات الصوتية هي أصلاً طريقة تواصل موظفي الموقع. تنظيم هذا التدفق في تقارير وتحديثات حالة، بدلاً من مطالبة الموظفين بتعبئة نموذج منفصل أيضاً، هو حيث يضيف الذكاء الاصطناعي أكثر قيمة دون زيادة العمل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يستخدم التواصل الحاصل أصلاً، ولا يستبدله</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تتبع التقدم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التجميع الحي لحالة طلبات الاستيضاح وإغلاق الملاحظات وتقارير الموقع يعطي مديري المشاريع والعملاء صورة دقيقة دون تقرير أسبوعي منفصل على أحدهم تجميعه يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">حالة تتحدث وحدها بدلاً من انتظار التقرير الأسبوعي</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع واتساب وأدوات الموقع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">موظفو الموقع لن يعتمدوا تطبيقاً جديداً للتقارير والتحديثات. يجب أن يعمل النظام عبر واتساب وأي أدوات موقع مستخدمة أصلاً، وإلا فلن يُستخدم.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع الصور والملاحظات الصوتية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">معظم ما يحدث في مواقع الإمارات يُلتقط كصورة أو ملاحظة صوتية سريعة، لا كرسالة مكتوبة. النظام الذي يقرأ النص فقط يفوّت معظم السجل الفعلي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">الإلمام بمتطلبات التقديم للجهات (بلدية دبي/تراخيص)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">التقديمات والموافقات التي تمر عبر بلدية دبي أو مؤسسة تراخيص تتبع صيغاً وجداول زمنية محددة. النظام الذي يتجاهل هذا السياق يصنع إعادة عمل أكثر لا أقل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التحكم في وصول الأطراف المتعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المقاولون والاستشاريون والمقاولون من الباطن يحتاج كل منهم رؤية أجزاء مختلفة من المشروع. يجب تحديد الوصول حسب الدور والتخصص، لا مشاركته كملف واحد مفتوح.</p>
      </div>
    </div>
  </div>
</section>

