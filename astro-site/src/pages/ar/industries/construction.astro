---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات المقاولات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/construction",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "شركات المقاولات", "item": "https://lenooai.com/ar/industries/construction" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات المقاولات في الإمارات",
    "description": "أنظمة ذكاء اصطناعي لشركات المقاولات في الإمارات: متابعة طلبات المعلومات والمستندات، أتمتة تقارير الموقع، تواصل مع المقاولين الفرعيين، وتقارير التقدم.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "ما مدى دقة الذكاء الاصطناعي في قراءة صور وملاحظات صوتية من الموقع؟",
        "acceptedAnswer": { "@type": "Answer", "text": "تقارير الموقع المبنية من الصور والملاحظات الصوتية تذهب دائماً لمهندس المشروع للمراجعة قبل اعتمادها، تماماً كتقرير كتبه موظف مبتدئ. الذكاء الاصطناعي يُسوّد الهيكل ويستخرج التفاصيل الموثوقة، وأي شيء غامض يُنبَّه لا يُخمَّن." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع هذا التعامل مع عدة مقاولين فرعيين بصلاحيات مختلفة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم. الصلاحيات مقسّمة حسب التخصص والمشروع، فيرى المقاول الفرعي طلبات المعلومات والمستندات والرسومات المتعلقة بنطاقه فقط، لا ملف المشروع كاملاً. المقاولون الرئيسيون والاستشاريون يحصلون على الصورة الكاملة." }
      },
      {
        "@type": "Question",
        "name": "هل يحتاج هذا اتصال إنترنت دائم في الموقع ليعمل؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الصور والملاحظات الصوتية تُلتقط في الموقع وتُرسل فور توفر اتصال، سواء واي فاي الموقع أو نقطة اتصال شخصية أو بيانات الهاتف. النظام مبني حول طريقة تواصل مواقع الإمارات الفعلية، غالباً واتساب، لا افتراض اتصال دائم." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات المقاولات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أنظمة ذكاء اصطناعي لشركات المقاولات في الإمارات: متابعة طلبات معلومات، أتمتة تقارير موقع، وتواصل مع المقاولين الفرعيين."
  canonicalPath="/ar/industries/construction"
  enPath="/industries/construction"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>شركات المقاولات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">engineering</span>
      شركات المقاولات
    </div>
    <h1>ذكاء اصطناعي لشركات المقاولات في الإمارات<br><span class="gradient-text">لا مزيد من الردود الضائعة في واتساب</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      طلب معلومات يُرسل للاستشاري يوم الاثنين قد يبقى بلا رد أسبوعاً، مدفوناً في نفس محادثة واتساب. نبني لك أنظمة تتابع كل طلب ومستند، تحوّل صور وملاحظات الموقع الصوتية لتقرير منظّم، وتُبقي المكتب على اطلاع دون سلسلة مكالمات.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_construction_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="مدير موقع ينسّق العمل في مشروع إنشائي بالإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">واتساب أولاً</p>
        <p class="stat-lbl">طريقة إرسال معظم مواقع الإمارات للتقارير</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">كل مشروع</p>
        <p class="stat-lbl">يُولّد طلبات ومستندات تُدفن في المحادثات</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">سجل كامل</p>
        <p class="stat-lbl">لكل طلب ومراجعة رسم وموافقة، في مكان واحد</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة المقاولات</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية لفرق المقاولات في الإمارات، متصلة بواتساب وسير عملكم الحالي.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">assignment</span>
        <h3>متتبع طلبات المعلومات والمستندات</h3>
        <p style="color:#42474e;line-height:1.7;">يُسجّل كل طلب معلومات ومستند، يتابع من عليه الرد، ويُنبّه لأي شيء متأخر عن موعده.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">photo_camera</span>
        <h3>أتمتة تقارير الموقع</h3>
        <p style="color:#42474e;line-height:1.7;">يحوّل الصور والملاحظات الصوتية المُرسلة من الموقع عبر واتساب لتقرير يومي منظّم، جاهز لمراجعة مهندس الموقع.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">forum</span>
        <h3>بوت التواصل مع المقاولين الفرعيين</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل ويتابع طلبات حالة المقاولين الفرعيين، ويجمع تحديثات التقدم دون جولة مكالمات.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">folder_open</span>
        <h3>مساعد البحث في المستندات والرسومات</h3>
        <p style="color:#42474e;line-height:1.7;">يجد المراجعة الحالية لرسم أو بند مواصفات أو شرط عقد عند الطلب، بدل البحث في المجلدات.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">checklist</span>
        <h3>ذكاء اصطناعي لقوائم الملاحظات</h3>
        <p style="color:#42474e;line-height:1.7;">يبني ويتابع قوائم الملاحظات من صور وملاحظات الموقع، يُسندها للتخصص المناسب، ويؤكد الإغلاق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">monitoring</span>
        <h3>لوحة تقارير التقدم</h3>
        <p style="color:#42474e;line-height:1.7;">تُجمّع تقارير الموقع وحالة الطلبات وإغلاق الملاحظات في عرض حي لمديري المشروع والعملاء.</p>
      </div>
    </div>
  </div>
</section>

<!-- PROJECT CYCLE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cycle-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="cycle-heading">دورة مشروع واحد، من البداية للنهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يركّز مديرو مشاريعك على البناء لا الأوراق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">طلب المعلومات الذي لا يضيع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">سؤال يصل من الموقع عن تفصيلة غير واضحة في الرسومات.</p>
        <ul class="journey-list">
          <li>يُسجّل الطلب فوراً مع مرجع الرسم والمواصفات ذي الصلة</li>
          <li>يُحوّله للاستشاري المناسب ويتابع موعد الرد</li>
          <li>يُنبّه تلقائياً إذا بقي مفتوحاً بعد موعده</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير الموقع الذي يكتب نفسه</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">طوال اليوم، يُرسل فريق الموقع صوراً وملاحظات صوتية كالمعتاد.</p>
        <ul class="journey-list">
          <li>يستخرج التخصص والموقع وتفاصيل التقدم من الصور والملاحظات</li>
          <li>يُسوّد تقريراً يومياً منظماً ليراجعه مهندس الموقع ويعتمده</li>
          <li>يُنبّه فوراً لأي شيء يبدو مشكلة سلامة أو جودة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديث المقاول الفرعي دون مكالمة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">المكتب يحتاج تحقق حالة من تقدم مقاول فرعي.</p>
        <ul class="journey-list">
          <li>يرسل طلب الحالة عبر واتساب بدل جولة مكالمات</li>
          <li>يُسجّل رد المقاول الفرعي مقابل الجدول تلقائياً</li>
          <li>يُحدّث لوحة التقدم فيراها المكتب دون سؤال مجدداً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ضبط المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">طلبات المعلومات والمستندات ومراجعات الرسومات هي السجل الذي يحدد المسؤول عن أي تأخير. المقاولون الذين نتحدث معهم يقولون نفس الشيء باستمرار: النسخة الحالية فعلياً نادراً ما تكون أول ما يُعثر عليه في تمرير واتساب.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">نسخة واحدة حالية، يمكن إيجادها خلال ثوانٍ لا دقائق تمرير</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التواصل بين الموقع والمكتب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الصور والملاحظات الصوتية هي بالفعل كيفية تواصل فريق الموقع. تنظيم هذا التدفق في تقارير وتحديثات، بدل طلب نموذج منفصل، هو حيث يُضيف الذكاء الاصطناعي الأكثر دون عبء إضافي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يستخدم التواصل الحاصل بالفعل، لا يستبدله</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تتبع التقدم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">عرض حي لحالة الطلبات وإغلاق الملاحظات وتقارير الموقع يُعطي مديري المشروع والعملاء صورة دقيقة دون تقرير أسبوعي منفصل يُجمَّع يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">حالة تُحدَّث بنفسها بدل انتظار التقرير الأسبوعي</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع واتساب وأدوات الموقع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فريق الموقع لن يتبنى تطبيقاً جديداً للتقارير والتحديثات. النظام يجب أن يعمل عبر واتساب وأدوات الموقع المستخدمة بالفعل، وإلا لن يُستخدم.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع الصور والملاحظات الصوتية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">معظم ما يحدث في موقع إماراتي يُلتقط كصورة أو ملاحظة صوتية سريعة، لا رسالة مكتوبة. نظام يقرأ النص فقط يُفوّت معظم السجل الفعلي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">وعي بمتطلبات بلدية دبي وتراخيص</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">التقديمات والموافقات عبر بلدية دبي أو تراخيص تتبع صيغاً وجداول زمنية محددة. نظام يتجاهل هذا السياق يخلق عملاً إضافياً لا أقل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تحكم بالصلاحيات لأطراف متعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المقاولون والاستشاريون والمقاولون الفرعيون يحتاجون رؤية أجزاء مختلفة من المشروع. الصلاحيات يجب أن تُحدَّد حسب الدور والتخصص، لا ملفاً مفتوحاً مشتركاً.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1612130536441-95ece5dcbb86?w=1200&q=80&auto=format&fit=crop" alt="منسّق موقع يراجع حالة المشروع على جهاز لوحي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">واتساب</p>
        <p style="color:#42474e; font-size:0.875rem;">القناة الافتراضية لطلبات المعلومات والصور والتحديثات في معظم مواقع الإمارات</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">أطراف متعددة</p>
        <p style="color:#42474e; font-size:0.875rem;">مقاول رئيسي واستشاري ومقاولون فرعيون يحتاجون رؤية نفس الطلب</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">يومياً</p>
        <p style="color:#42474e; font-size:0.875rem;">حجم الصور والملاحظات الصوتية المُولّدة لكل موقع نشط</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">معلومات ضائعة</p>
          <p style="color:#42474e; line-height:1.7;">لا يوجد رقم موثّق واحد لحجم المعلومات الضائعة في محادثات واتساب في موقع إماراتي عادي. ما يصفه المقاولون باستمرار هو نفس المشكلة: النسخة الحالية من رسم أو رد على طلب نادراً ما تكون أول شيء يُعثر عليه.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">حِمل التواصل</p>
          <p style="color:#42474e; line-height:1.7;">مشروع نشط واحد يُولّد تدفقاً ثابتاً من طلبات المعلومات والمستندات والصور وأسئلة الحالة عبر أطراف متعددة يومياً. بدون نظام لتنظيم هذا التدفق، الحجم نفسه يصبح مصدر التأخير.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">الفجوة بين الموقع والمكتب</p>
          <p style="color:#42474e; line-height:1.7;">مديرو المشاريع الذين نتحدث معهم يقولون إن الفجوة الأكبر ليست نقص معلومات من الموقع، بل أنها تصل كصور وملاحظات صوتية خام تحتاج وقتاً لتحويلها لشيء قابل للتقرير.</p>
        </div>
      </div>
    </div>
