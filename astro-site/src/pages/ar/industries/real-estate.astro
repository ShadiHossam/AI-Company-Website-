---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "ما مدى دقة تقييمات العقارات بالذكاء الاصطناعي مقارنة بالمثمّنين البشريين؟", answer: "في الأسواق كثيفة المعاملات والغنية بالبيانات، أصبحت نماذج التقييم الآلي منافسة بقوة. أبرز هذه النماذج لديها متوسط خطأ ٢٫٤٪ للعقارات المعروضة، مقارنة بتباين يقارب ٥ إلى ٨٪ في التقييمات البشرية. لكنها تواجه صعوبة مع العقارات الفريدة، والأسواق قليلة المعاملات، والتحولات المفاجئة في السوق. النهج الأكثر موثوقية يجمع الذكاء الاصطناعي للتسعير الأولي مع مراجعة بشرية للقرار النهائي." },
  { question: "هل سيحل الذكاء الاصطناعي محل الوسطاء العقاريين؟", answer: "غير مرجح على المدى القريب، لكنه سيغيّر بشكل كبير ما يقضي فيه الوسطاء وقتهم. يتولى الذكاء الاصطناعي العمل كثيف الحجم ومنخفض التعقيد: الرد الأولي على الاستفسارات، وإدارة العروض، ومعالجة المستندات، وتأهيل العملاء المحتملين. هذا يفرّغ الوسطاء للاستشارة والتفاوض وبناء العلاقات. الوكالات الأسرع نمواً هي التي تستخدم الذكاء الاصطناعي لجعل وسطائها أكثر إنتاجية، لا لاستبدالهم." },
  { question: "كيف يعمل تقييم العملاء المحتملين بالذكاء الاصطناعي عملياً؟", answer: "يُدرَّب نموذج تقييم العملاء المحتملين على بيانات تاريخية: أي العملاء المحتملين أتموا صفقات في النهاية، وكيف كانت أنماط سلوكهم قبل ذلك. يتعلم إشارات مثل: عدد العروض التي شاهدوها، والوقت الذي قضوه في كل منها، وطلبات المعاينة، وسرعة الرد على المتابعة. يعطي النموذج درجة احتمالية لكل عميل محتمل جديد. يرى الوسطاء قائمة مرتبة تبدأ بأعلى الاحتمالات، ويتلقون تنبيهاً فورياً عندما ترتفع درجة أحد العملاء المحتملين." },
  { question: "هل يستطيع الذكاء الاصطناعي التعامل مع استفسارات العقارات بالعربية؟", answer: "نعم. نماذج الذكاء الاصطناعي الحديثة تتعامل مع العربية بطلاقة، بما في ذلك التنقل بين العربية والإنجليزية في منتصف المحادثة. في سوق العقارات الإماراتي هذا أمر حاسم: نسبة كبيرة من المشترين ذوي القيمة العالية يفضلون التواصل بالعربية. المهم هو اختبار جودة المخرجات العربية تحديداً، لأن بعض النماذج تنتج عربية فصحى صحيحة لكنها متكلفة بدلاً من لغة محادثة طبيعية." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_real_estate')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للعقارات في الإمارات",
    "url": "https://lenooai.com/ar/industries/real-estate",
    "description": "أنظمة ذكاء اصطناعي مخصصة للوكالات العقارية في الإمارات: روبوتات محادثة للعملاء المحتملين على منصات المراسلة، وأتمتة CRM، ومعالجة المستندات، ومساعدون عقاريون ثنائيو اللغة.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Real Estate"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للعقارات", "item": "https://lenooai.com/ar/industries/real-estate" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للعقارات في الإمارات: العملاء المحتملون وأتمتة CRM"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة للوكالات العقارية في الإمارات: روبوتات للعملاء المحتملين، وأتمتة CRM، ومعالجة المستندات، ومساعدون ثنائيو اللغة."
  canonicalPath="/ar/industries/real-estate"
  enPath="/industries/real-estate"
  ogImage="/assets/og-real-estate.jpg"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=1600&q=80&auto=format&fit=crop", alt: "منظر جوي للعقارات والتطوير العقاري في دبي", position: "center 60%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>العقارات</div>
  <h1>ذكاء اصطناعي لقطاع<br><span class="gradient-text">العقارات في دبي</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة للوكالات العقارية في دبي: مساعدون للعملاء المحتملين على منصات المراسلة، وأتمتة CRM، ومعالجة المستندات، وأدوات تحليل السوق. ثنائية اللغة (العربية والإنجليزية)، ومتوافقة مع أنظمة الإمارات، ومربوطة بسير عملكم الحالي.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_real_estate_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء العقارات</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "٤١ مليار $", caption: "استثمارات التقنية العقارية عالمياً في ٢٠٢٣ (KPMG)" },
      { value: "٦٣٪", caption: "من الشركات العقارية تجرّب الذكاء الاصطناعي أو تستخدمه (Deloitte ٢٠٢٤)" },
      { value: "±٣٪", caption: "متوسط خطأ التقييم الآلي مقابل ±١٠٪ للتقدير البشري" },
    ]} />
  </div>
</PageHero>

<!-- WHY REAL ESTATE & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا العقارات من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>فجوة المعلومات هائلة.</strong> قرارات العقارات تتضمن آلاف المتغيرات: اتجاهات دقيقة في كل موقع، والمبيعات المماثلة، ومشاريع البنية التحتية، والتحولات السكانية. لا يستطيع أي وسيط بمفرده معالجة كل ذلك. أنظمة الذكاء الاصطناعي تستطيع جمعه كله لتكشف رؤى تغيّر جذرياً طريقة اتخاذ المشترين والبائعين والمستثمرين لقراراتهم.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>اقتصاديات العملاء المحتملين قاسية.</strong> العقارات تولّد أعداداً هائلة من العملاء المحتملين لكنها تغلق نسبة ضئيلة منها. نماذج تقييم العملاء المحتملين بالذكاء الاصطناعي المدرَّبة على إشارات السلوك (الوقت على الموقع، والصفحات المشاهدة، وتكرار الاستفسار) تستطيع تمييز المشترين الجادين عن المتصفحين بدقة ٧٠ إلى ٨٥٪، مما يحسّن بشكل كبير توجيه وقت فريق المبيعات.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>المعاملات كثيفة الأوراق.</strong> صفقة عقارية واحدة تتضمن عشرات المستندات: سندات الملكية، وشهادات عدم الممانعة، واتفاقيات البيع والشراء، ووثائق الرهن، ونقل المرافق. معالجة المستندات بالذكاء الاصطناعي تستخرج المعلومات وتتحقق منها وتوجهها تلقائياً، فتختصر مدة المعاملة من أسابيع إلى أيام.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=800&q=80&auto=format&fit=crop" alt="واجهة فيلا حديثة في دبي معروضة على بوابة عقارية" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للوكالات العقارية في دبي</h2>
      <p>ستة أنظمة محددة نشرتها وكالتنا للذكاء الاصطناعي في دبي لوكالات في أنحاء الإمارات، كل منها مربوط بنظام CRM وأدواتكم الحالية.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي للعملاء المحتملين عبر المراسلة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرد على كل عميل محتمل وارد خلال أقل من دقيقتين، على مدار الساعة. يحدد النية، ويجمع تفضيلات العقار، ويحجز المعاينات، ويوجّه العملاء المحتملين الجادين إلى الوسطاء بالعربية والإنجليزية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المحتملون الذين يُتواصل معهم خلال ٥ دقائق أكثر احتمالاً للتحويل بـ ٩ مرات (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقييم العملاء المحتملين في CRM</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرتب كل عميل محتمل في نظام CRM حسب احتمال إتمامه صفقة خلال ٩٠ يوماً، بناءً على السلوك وسرعة الرد وأنماط الاستفسار. يعمل الوسطاء على العملاء المحتملين الصحيحين، لا الأحدث فقط.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتكامل مع نظام CRM وأنظمة إدارة العقارات لديكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لمعالجة المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج البيانات ويتحقق منها من سندات الملكية، وشهادات عدم الممانعة، واتفاقيات البيع والشراء، وعقود الإيجار، ووثائق الرهن. ينبّه تلقائياً إلى الحقول الناقصة ومشكلات الامتثال لمتطلبات مؤسسة التنظيم العقاري ودائرة الأراضي والأملاك. ما كان يأخذ أياماً أصبح يأخذ ساعات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على صيغ المستندات العقارية في الإمارات بما فيها نماذج دائرة الأراضي والأملاك ومؤسسة التنظيم العقاري</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد العروض العقارية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ذكاء اصطناعي مدرَّب على محفظتكم العقارية يجيب عن أسئلة المشترين عبر موقعكم والبوابات العقارية الرئيسية: تفاصيل العقار، والتوفر، والأسعار، وطلبات المعاينة، بالعربية والإنجليزية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتولى الاستفسارات عبر الويب وتطبيقات المراسلة والبوابات العقارية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحة تحليل السوق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تجمع بيانات معاملات دائرة الأراضي والأملاك، ومؤشرات أسعار REIDIN، ونشاط عروض المنافسين في لوحة مباشرة يستطيع وسطاؤكم وإدارتكم العمل بها يومياً. اعرفوا قبل منافسيكم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبنية على مصادر بيانات إماراتية، لا مؤشرات مرجعية عالمية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة سير عمل الوسطاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يؤتمت المهام اليدوية بين المعاينات والإغلاق: رسائل المتابعة، وطلبات المستندات، وتحديث العروض، ومزامنة حالة مسار المبيعات. يركز الوسطاء على العلاقات، لا الأعمال الإدارية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتكامل مع أدوات المراسلة والتقويم ونظام CRM لديكم</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة متوافقة مع أنظمة الإمارات (<a href="https://u.ae/en/about-the-uae/digital-uae/data/data-protection-laws" target="_blank" rel="noopener">قانون حماية البيانات الشخصية</a>، ومعايير DESC)، ثنائية اللغة، ومربوطة بأدواتكم الحالية.</p>
      <button onclick="openModal(this)" data-source="ar_real_estate_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء العقارات</button>
    </div>
  </div>
</section>

<!-- BUYER JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="re-journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="re-journey-heading">مشترٍ واحد، رحلة واحدة، دون أي فرصة ضائعة</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركز وسطاؤكم على الأشخاص، لا الأوراق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الرد الأول يحدد إن كان العميل المحتمل ما زال لكم</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">استفسار جديد يصل عبر بوابة عقارية أو واتساب أو موقعكم في أي ساعة. والذكاء الاصطناعي يتعامل معه بالفعل.</p>
        <ul class="journey-list">
          <li>يرد خلال أقل من دقيقتين بالعربية أو الإنجليزية، حسب اللغة التي بدأ بها المشتري</li>
          <li>يطرح أسئلة التأهيل التي كان سيطرحها الوسيط: الميزانية، والمنطقة، والجدول الزمني، ووضع التمويل</li>
          <li>يقيّم العميل المحتمل ويوجّهه للوسيط المناسب بينما اهتمامه في أعلى مستوياته</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المعاينات تُحجز دون عشر رسائل متبادلة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تأهيل العميل المحتمل، يحافظ الذكاء الاصطناعي على الزخم نحو معاينة مؤكدة.</p>
        <ul class="journey-list">
          <li>يتحقق من توفر الوسيط والوحدة ويقترح المواعيد تلقائياً</li>
          <li>يرسل التأكيدات والتذكيرات والاتجاهات فتقل حالات عدم الحضور</li>
          <li>يعرض عروضاً مماثلة يُرجَّح أن يرغب المشتري برؤيتها في نفس الزيارة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الإغلاق هو المكان الذي يثبت فيه ذكاء المستندات قيمته</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد قبول العرض، عادةً ما تبطئ الأوراق كل شيء. الذكاء الاصطناعي يبقيها تتحرك.</p>
        <ul class="journey-list">
          <li>يستخرج البيانات من اتفاقيات البيع والشراء وشهادات عدم الممانعة وسندات الملكية ويتحقق منها مقابل متطلبات مؤسسة التنظيم العقاري ودائرة الأراضي والأملاك</li>
          <li>ينبّه إلى الحقول الناقصة أو التفاصيل غير المتطابقة قبل أن تسبب تأخيراً عند النقل</li>
          <li>يبقي المشتري والبائع والوسيط على اطلاع بالحالة دون مكالمات متابعة يدوية</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في العقارات</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">home</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نماذج التقييم الآلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تعلم آلة مدرَّبة على سجل المعاملات وخصائص العقارات وبيانات المواقع تنتج تقييمات عقارية في ثوانٍ. أثبتت كبرى منصات العروض العقارية هذا النهج على نطاق واسع، بمتوسط أخطاء وصل إلى ±٣٪. المقرضون وشركات التأمين والمستثمرون يستخدمون الآن نماذج التقييم الآلي لقرارات التسعير الأولية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">دقة التقييم الآلي تنافس الآن المثمّنين البشريين في الأسواق الغنية بالبيانات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقييم العملاء المحتملين وتأهيلهم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تنبؤية تحلل إشارات السلوك (كيف يتفاعل العميل المحتمل مع العروض، وأي العقارات يحفظها، وما سرعة رده) لتقييم احتمال إتمامه صفقة خلال ٩٠ يوماً. تسجل الوكالات الرائدة تحسناً بنسبة ٤٠ إلى ٦٠٪ في معدلات التحويل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العملاء المحتملون الذين يُتواصل معهم خلال ٥ دقائق أكثر احتمالاً للتحويل بـ ٩ مرات (MIT)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعدون عقاريون بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">وكلاء محادثة يعملون بالذكاء الاصطناعي يتولون الاستفسارات العقارية عبر تطبيقات المراسلة ودردشة الموقع والبوابات بالعربية والإنجليزية، على مدار الساعة. يجيبون عن الأسئلة، ويحجزون المعاينات، ويجمعون التفضيلات، ويحددون النية قبل التوجيه إلى الوسطاء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">٧٤٪ من عمليات البحث عن العقارات تبدأ الآن على الهاتف المحمول (NAR)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">معالجة المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج الذكاء الاصطناعي البيانات ويتحقق منها من سندات الملكية، واتفاقيات البيع، وشهادات عدم الممانعة، ووثائق الرهن، وينبّه تلقائياً إلى التناقضات والحقول الناقصة ومشكلات الامتثال. ما كان يأخذ من الفرق القانونية ٣ إلى ٥ أيام يمكن الآن معالجته في ساعات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الذكاء الاصطناعي يقلل وقت معالجة المستندات بنسبة تصل إلى ٨٠٪ (Deloitte)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقع السوق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تجمع المؤشرات الاقتصادية الكبرى، وبيانات التصاريح، وحركة السكان، والمعاملات التاريخية لتوقع اتجاهات الأسعار على مستوى الحي قبل ٦ إلى ١٨ شهراً. يستخدمها المستثمرون المؤسسيون لقرارات اختيار المواقع والتوقيت.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">توقعات الأسعار بالذكاء الاصطناعي تتفوق على إجماع المحللين في ٧٠٪ من الحالات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">image</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الجولات الافتراضية والذكاء البصري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الرؤية الحاسوبية تحسّن صور العروض تلقائياً، وتولّد تأثيثاً افتراضياً، وتنشئ جولات ثلاثية الأبعاد من صور بسيطة. العروض ذات الصور المحسّنة بالذكاء الاصطناعي تحصل على مشاهدات أكثر بنسبة ٦٠٪ واستفسارات أكثر بنسبة ٢٠٪ على البوابات الرئيسية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">التأثيث الافتراضي بجودة احترافية بالذكاء الاصطناعي يكلف أقل بنسبة ٩٥٪ من التأثيث التقليدي</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعل ذكاء العقارات الاصطناعي يعمل فعلاً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">كثافة بيانات المعاملات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">دقة نماذج التقييم الآلي وتوقع الأسعار تعتمد على بيانات المعاملات المتاحة. الأسواق قليلة المعاملات أصعب في النمذجة. ندرة البيانات قيد حقيقي يحدد أي التطبيقات ممكنة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">القدرة على تعدد اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">في أسواق مثل دبي، حيث يأتي المشترون من أكثر من ١٩٠ جنسية، المساعدون العقاريون الذين يعملون بالإنجليزية فقط يفوتون شرائح كبيرة. دعم العربية والروسية والصينية والهندية ليس اختيارياً في سوق عقاري دولي حقيقي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">عمق الربط مع CRM</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تقييم العملاء المحتملين بالذكاء الاصطناعي لا يعمل إلا إذا كان مربوطاً بالمكان الذي توجد فيه بيانات العملاء فعلاً. أدوات الذكاء الاصطناعي المستقلة التي لا تتكامل مع CRM الوكالة تخلق أنظمة موازية لن يستخدمها الوسطاء. القيمة في الربط، لا في النموذج بمعزل عنه.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">الوعي بالأنظمة واللوائح</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">العقارات قطاع شديد التنظيم. أدوات الذكاء الاصطناعي للمستندات والتأهيل تحتاج أن تطبق المتطلبات المحلية، لا أن تعالج المعلومات فقط. في الإمارات، يشمل ذلك الامتثال لمؤسسة التنظيم العقاري والإبلاغ عن المعاملات لدائرة الأراضي والأملاك.</p>
      </div>
    </div>
  </div>
</section>

