---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "ما الذي يستطيع الذكاء الاصطناعي قوله للمريض فعلاً، وما الذي لا يُسمح له بقوله؟", answer: "يستطيع تأكيد مواعيد إعادة صرف الأدوية، وإخبار العميل إن كان صنف ما متوفراً، وشرح توقيت التوصيل، والتحقق من التغطية التأمينية لدى جهة إدارة المزايا الدوائية. ولا يستطيع التوصية بدواء، أو اقتراح بديل، أو تفسير أعراض، أو الإجابة عن أي سؤال يتطلب حكماً سريرياً. كل نظام نسلّمه يتضمن قاعدة تصعيد ثابتة: أي رسالة تمس الجرعة أو الآثار الجانبية أو طلب بديل تُحوَّل مباشرة إلى الصيدلي، مع سجل المحادثة مرفقاً فلا يحتاج أحد إلى تكرار شيء." },
  { question: "كيف يتحقق الروبوت من وصفة طبية مرسلة كصورة عبر واتساب؟", answer: "يقرأ الروبوت الصورة بما يكفي لاستخراج الأساسيات: اسم المريض، واسم الدواء، والطبيب الواصف، ثم ينشئ طلباً ليتحقق منه الصيدلي مقابل الأصل. لا يعتمد أي شيء ولا يصرفه بنفسه. اعتبروه رقمنة لخطوة الاستلام، لا بديلاً عن التحقق الذي يجب أن يجريه صيدلي مرخص قبل خروج أي شيء." },
  { question: "هل يستطيع مدقق التأمين إخبار العميل بحصته الدقيقة من الدفع قبل وصوله؟", answer: "مع شركات التأمين وجهات إدارة المزايا الدوائية التي لدى صيدليتكم اتصال فعّال بها، نعم، يستطيع إعطاء حالة تغطية تقديرية ونطاق لحصة العميل قبل أن يغادر منزله. أما مع شركات التأمين الأقل شيوعاً أو حين لا توفر الجهة بيانات الأهلية فورياً، فينبّه إلى الاستفسار للتحقق اليدوي بدلاً من التخمين، لأن إعطاء العميل رقماً خاطئاً عند الكاونتر أسوأ من عدم الإجابة فوراً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي للصيدليات في الإمارات",
    "url": "https://lenooai.com/ar/industries/pharmacies",
    "description": "أنظمة ذكاء اصطناعي مخصصة للصيدليات في الإمارات: تذكيرات إعادة الصرف، وروبوتات الاستفسار عن المخزون، ورفع الوصفات عبر واتساب، وتحديثات التوصيل، والتحقق من التغطية التأمينية، بمراسلة متوافقة مع وزارة الصحة ووقاية المجتمع.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للصيدليات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للصيدليات", "item": "https://lenooai.com/ar/industries/pharmacies" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي للصيدليات في الإمارات: الدليل الكامل"
  description="كيف تستخدم الصيدليات في الإمارات الذكاء الاصطناعي لتذكيرات إعادة الصرف، والاستفسار عن المخزون، وطلبات الوصفات عبر واتساب، والتحقق من التأمين."
  canonicalPath="/ar/industries/pharmacies"
  enPath="/industries/pharmacies"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الصيدليات</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لصيدليات دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة للصيدليات في الإمارات: تذكيرات إعادة الصرف، وروبوتات الاستفسار عن المخزون، وطلب الوصفات عبر واتساب، وتحديثات التوصيل، والتحقق من التأمين. مبنية ضمن حدود المراسلة لدى وزارة الصحة ووقاية المجتمع، مع تحويل كل سؤال سريري إلى الصيدلي.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_pharmacies_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في صيدليتكم</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1600&q=80&auto=format&fit=crop" alt="رفوف صيدلية ممتلئة بالأدوية في فرع في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٠", caption: "نصائح طبية يقدمها الروبوت، فكل سؤال سريري يُحوَّل إلى الصيدلي" },
      { value: "24/7", caption: "تغطية لاستفسارات إعادة الصرف والمخزون، حتى بعد إغلاق الفرع" },
      { value: "١", caption: "محادثة واتساب واحدة من صورة الوصفة حتى تسليم الطلب" },
    ]} />
  </div>
</div>

<!-- WHY PHARMACY AUTOMATION HAS TO WORK INSIDE HARD LINES -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا يجب أن تعمل أتمتة الصيدليات ضمن حدود تنظيمية صارمة</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم ما تتعامل معه الصيدلية يومياً ليس سريرياً.</strong> تذكيرات إعادة الصرف، وتوفر المخزون، وتوقيت التوصيل، والتحقق من التأمين تشكل الجزء الأكبر من التواصل الروتيني مع العملاء، ولا شيء منها يتطلب حكم الصيدلي. هذا هو الجزء الذي يستطيع الذكاء الاصطناعي تولّيه بوضوح، فيتفرغ الصيادلة لما يحتاج مختصاً مرخصاً فعلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الحد بين «اللوجستي» و«السريري» يجب أن يُبنى، لا أن يُفترض.</strong> روبوت الصيدلية المبني جيداً مصمم بحد صارم: يستطيع تأكيد جاهزية إعادة الصرف أو التحقق من توفر صنف، لكنه لا يستطيع التوصية بدواء أو اقتراح بديل أو الإجابة عن سؤال حول الأعراض. هذا الحد يجب أن يُفرض في طريقة بناء النظام، لا أن يُترك للأمل في حسن تصرف الذكاء الاصطناعي.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>التصعيد يجب أن يكون فورياً وكاملاً.</strong> لحظة أن تمس المحادثة أي أمر سريري، كالجرعة أو التداخلات الدوائية أو البدائل أو الآثار الجانبية، يجب أن تُسلَّم إلى صيدلي مع المحادثة كاملة، فلا يضطر العميل أبداً إلى التكرار ولا يضطر الصيدلي إلى تخمين ما نوقش.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1580746738099-79dda9d4c98f?w=800&q=80&auto=format&fit=crop" alt="صيدلي يراجع طلب وصفة عند الكاونتر" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للصيدليات في الإمارات</h2>
      <p>ستة أنظمة محددة تبنيها وكالتنا للذكاء الاصطناعي في دبي لمجموعات الصيدليات في أنحاء الإمارات، كل منها يبقى بصرامة ضمن الجانب اللوجستي ولا يقترب من النصائح السريرية.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">alarm</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تذكير إعادة الصرف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع دورة إعادة الصرف لكل مريض من سجل طلباته، ويرسل تذكيراً قبل نفاد الدواء ببضعة أيام، عبر واتساب أو الرسائل النصية، مع خيار إعادة الطلب بضغطة واحدة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُرسل قبل نفاد الدواء، لا بعد أن يفوّت المريض جرعة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد الاستفسار عن المخزون والتوفر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحقق من المخزون الحي عبر فروعكم ويخبر العميل فوراً إن كان الصنف متوفراً وفي أي فرع، دون اتصال بالفرع خلال وردية مزدحمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">متصل ببيانات المخزون الحية في نظام إدارة الصيدلية لديكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">upload_file</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت رفع الوصفات والطلب (واتساب)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصوّر العميل الوصفة ويرسلها عبر واتساب. يستخرج الروبوت الأساسيات وينشئ طلباً ليراجعه الصيدلي ويتحقق منه قبل صرف أي شيء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يرقمن الاستلام، ويبقى الصيدلي من يتحقق من كل طلب</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">local_shipping</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات حالة التوصيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تحديثات تلقائية من تأكيد الطلب إلى إرساله مع المندوب حتى التسليم، فيتوقف العملاء عن الاتصال للسؤال «أين طلبي؟» ويتوقف فريقكم عن تلقي السؤال نفسه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل مكالمات «أين طلبي؟» التي تستهلك وقت الاستقبال</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مدقق التغطية التأمينية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحقق من تغطية العميل لدى شركات التأمين وجهات إدارة المزايا الدوائية المتصلة، ويعطي تقديراً لحصة العميل قبل وصوله. وأي شيء لا تستطيع الجهة المتصلة تأكيده يُعلَّم للتحقق اليدوي بدلاً من التخمين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">لا أرقام مخمنة عند الكاونتر، فقط تغطية مؤكدة أو تنبيه للتحقق اليدوي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">loyalty</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متابعة الولاء وإعادة الطلب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع نقاط الولاء ويرسل تنبيهات إعادة طلب في وقتها للأدوية المزمنة والمشتريات المنتظمة، فيبقى العملاء المتكررون مع صيدليتكم بدلاً من منافس في الشارع نفسه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">توقيت مرتبط بدورة إعادة الطلب الفعلية لعملائكم، لا بجدول عام</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام يبقى ضمن الجانب اللوجستي ودعم إعادة الصرف. والأسئلة السريرية تذهب دائماً إلى الصيدلي.</p>
      <button onclick="openModal(this)" data-source="ar_pharmacies_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في صيدليتكم</button>
    </div>
  </div>
</section>

<!-- ONE REFILL JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">إعادة صرف واحدة، من التذكير حتى التسليم</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل خطوة، ضمن الجانب اللوجستي طوال الطريق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تذكير إعادة الصرف يُرسل قبل نفاد الدواء</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">قبل نفاد دواء مزمن ببضعة أيام، يخرج التذكير تلقائياً.</p>
        <ul class="journey-list">
          <li>توقيت مبني على سجل طلبات المريض الفعلي، لا على تخمين ثابت بـ ٣٠ يوماً</li>
          <li>يُرسل عبر واتساب أو الرسائل النصية مع رابط إعادة طلب بضغطة واحدة</li>
          <li>لا وقت للصيدلي يُصرف على تذكير روتيني يستطيع النظام إرساله وحده</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">استفسار المخزون يُجاب دون اتصال بالفرع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يسأل إن كان الصنف متوفراً قبل أن يأتي.</p>
        <ul class="journey-list">
          <li>تحقق حي من المخزون عبر الفروع، لا إجابة ثابتة تتقادم بحلول الظهيرة</li>
          <li>فرع بديل يُقترح تلقائياً إذا نفد الصنف في الأقرب</li>
          <li>موظفو الاستقبال لا يُسحبون من عملاء المتجر للرد على استفسار هاتفي</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الطلب يتم من صورة وصفة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يرسل صورة وصفة جديدة عبر واتساب بدلاً من زيارة الفرع.</p>
        <ul class="journey-list">
          <li>الروبوت يستخرج بيانات المريض والدواء ويفتح طلباً للمراجعة</li>
          <li>الصيدلي يتحقق من الوصفة قبل صرف أي شيء، تماماً كما هو مطلوب</li>
          <li>العميل يتلقى تحديثاً لحالة التوصيل بمجرد تأكيد الطلب وبدء تحركه</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">alarm</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تذكيرات إعادة الصرف والطلب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مرضى الأدوية المزمنة ينسون إعادة الطلب أكثر مما تحب الصيدليات أن تعترف، وإعادة الصرف الفائتة بيع ضائع يذهب غالباً إلى منافس أو تطبيق توصيل. التذكير المرسل قبل بضعة أيام، والمرتبط بنمط الاستخدام الفعلي للمريض، يلتقط إعادة الطلب قبل ضياعها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي عملاء الأدوية المزمنة يطلبون من نفس الصيدلية في كل دورة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استفسارات المخزون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أسئلة المخزون من أعلى المكالمات حجماً وأقلها قيمة التي تتلقاها الصيدلية، وتميل إلى الارتفاع تماماً حين يكون الموظفون في ذروة انشغالهم عند الكاونتر. الإجابة عنها فوراً عبر روبوت متصل بالمخزون الحي تزيل مقاطعة دائمة دون أن ينتظر العميل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحرر موظفي الاستقبال من الهاتف خلال ساعات ذروة المتجر</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">local_shipping</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات التوصيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التوصيل في الإمارات أصبح هو المتوقع لا الاستثناء في طلبات الصيدليات. العملاء الذين لا يتلقون تحديثاً للحالة يميلون إلى الاتصال والسؤال، فيُسحب الموظفون من أعمال أخرى. التحديثات التلقائية في كل مرحلة تسد هذه الفجوة دون أن يرفع أحد سماعة الهاتف.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مكالمات «أين طلبي؟» أقل، ونفس مدة التوصيل</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">مراسلة متوافقة مع وزارة الصحة ووقاية المجتمع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">لا نصائح طبية، ولا اقتراحات بدائل غير مصرح بها، أبداً. الردود المسموح بها للروبوت محددة وقت البناء في الجانب اللوجستي: إعادة الصرف، والمخزون، والتوصيل، والتغطية. وأي شيء خارج هذا النطاق يُرفض ويُصعَّد، لا يُرتجل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع نظام إدارة الصيدلية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إجابات المخزون وتوقيت إعادة الصرف مفيدة فقط إذا سُحبت من بيانات حية. يحتاج الروبوت إلى اتصال حقيقي بنظام إدارة الصيدلية لديكم، لا إلى قائمة تُحدَّث يدوياً وتصبح خاطئة بحلول الوردية التالية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إلمام بالتأمين وجهات إدارة المزايا الدوائية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مدقق التغطية جدير بالثقة فقط إذا عرف حدود ما يستطيع تأكيده. يجب أن يعطي إجابة مؤكدة حيث يدعم الاتصال بالجهة ذلك، وأن ينبّه للتحقق اليدوي في كل ما عدا ذلك، دون أي رقم مخمن لحصة العميل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تصعيد واضح إلى الصيدلي في الأسئلة السريرية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">محفز التصعيد يجب أن يكون واسعاً لا ضيقاً. أي شيء يمس ولو قليلاً الجرعة أو التداخلات أو طلب بديل يُحوَّل إلى صيدلي فوراً، مع السياق كاملاً، بدلاً من أن يحاول الروبوت إجابة جزئية.</p>
      </div>
    </div>
  </div>
</section>

