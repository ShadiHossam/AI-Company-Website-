---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للصيدليات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/pharmacies",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الصيدليات", "item": "https://lenooai.com/ar/industries/pharmacies" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للصيدليات في الإمارات",
    "description": "تذكير بإعادة الصرف، بوت استفسار مخزون، رفع وصفة عبر واتساب، تحديثات توصيل، وفحص تغطية تأمينية للصيدليات في الإمارات، بمراسلة متوافقة مع وزارة الصحة ووقاية المجتمع.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "ماذا يستطيع الذكاء الاصطناعي أن يقول للمريض، وماذا لا يُسمح له بقوله؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يستطيع تأكيد مواعيد إعادة الصرف، إخبار العميل إن كان الصنف متوفراً، شرح توقيت التوصيل، وفحص التغطية التأمينية. لا يستطيع التوصية بدواء أو اقتراح بديل أو تفسير أعراض أو الإجابة عن أي سؤال يحتاج حكماً سريرياً. أي رسالة تلمس الجرعة أو الآثار الجانبية تُحوَّل مباشرة للصيدلي." }
      },
      {
        "@type": "Question",
        "name": "كيف يتحقق البوت من وصفة مُرسَلة كصورة عبر واتساب؟",
        "acceptedAnswer": { "@type": "Answer", "text": "البوت يقرأ الصورة بما يكفي لاستخراج الأساسيات: اسم المريض، اسم الدواء، والطبيب الموصف، ثم يُنشئ طلباً ليراجعه صيدليكم مقابل الأصل. لا يعتمد أو يصرف شيئاً بنفسه." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع فاحص التأمين إخبار العميل بدفعه المشترك الدقيق قبل وصوله؟",
        "acceptedAnswer": { "@type": "Answer", "text": "لشركات التأمين التي تملك صيدليتكم اتصالاً نشطاً معها بالفعل، نعم، يستطيع إرجاع حالة تغطية تقديرية ونطاق دفع مشترك قبل مغادرة العميل منزله. لشركات أقل شيوعاً، يُنبّه للتحقق اليدوي بدل التخمين." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للصيدليات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت تذكير إعادة صرف واستفسار مخزون ورفع وصفة عبر واتساب للصيدليات في الإمارات، بمراسلة متوافقة مع الجهات الصحية."
  canonicalPath="/ar/industries/pharmacies"
  enPath="/industries/pharmacies"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الصيدليات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">local_pharmacy</span>
      الصيدليات
    </div>
    <h1>ذكاء اصطناعي للصيدليات في دبي<br><span class="gradient-text">لوجستيات فقط، لا نصيحة طبية أبداً</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      معظم ما تتعامل معه الصيدلية يومياً ليس سريرياً: تذكير إعادة صرف، توفر مخزون، توقيت توصيل، وفحص تأمين. نبني لك بوتاً يتولى هذا كله، وأي سؤال سريري يُحوَّل فوراً لصيدليكم.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_pharmacies_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1600&q=80&auto=format&fit=crop" alt="رفوف صيدلية مليئة بالأدوية في فرع إماراتي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">صفر</p>
        <p class="stat-lbl">نصيحة طبية يُقدّمها البوت، بالتصميم لا بالصدفة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية إعادة صرف واستفسار مخزون، حتى بعد إغلاق الفرع</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">محادثة واحدة</p>
        <p class="stat-lbl">من صورة الوصفة حتى تسليم الطلب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في صيدليتك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة تبقى بالكامل ضمن اللوجستيات، ولا تلمس النصيحة السريرية أبداً.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">alarm</span>
        <h3>بوت تذكير إعادة الصرف</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع دورة إعادة صرف كل مريض من سجل طلباته ويرسل تذكيراً قبل أيام من نفاد الدواء.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">inventory_2</span>
        <h3>مساعد استفسار المخزون والتوفر</h3>
        <p style="color:#42474e;line-height:1.7;">يتحقق من المخزون الحي عبر فروعكم ويُخبر العميل فوراً إن كان الصنف متوفراً وفي أي فرع.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">upload_file</span>
        <h3>بوت رفع الوصفة والطلب (واتساب)</h3>
        <p style="color:#42474e;line-height:1.7;">عميل يُصوّر وصفة ويرسلها عبر واتساب. البوت يستخرج الأساسيات وينشئ طلباً لمراجعة الصيدلي.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">local_shipping</span>
        <h3>تحديثات حالة التوصيل</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تحديثات تلقائية من تأكيد الطلب حتى التسليم، فيتوقف العملاء عن الاتصال ليسألوا.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">verified</span>
        <h3>فاحص التغطية التأمينية</h3>
        <p style="color:#42474e;line-height:1.7;">يتحقق من تغطية العميل مقابل شركات التأمين المتصلة، ويُرجع دفعاً مشتركاً تقديرياً قبل وصوله.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">loyalty</span>
        <h3>متابعة الولاء وإعادة الطلب</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع نقاط الولاء ويرسل تذكيراً بإعادة الطلب للدواء المزمن والمشتريات المنتظمة في وقتها.</p>
      </div>
    </div>
  </div>
</section>

<!-- ONE REFILL JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من تذكير إعادة صرف إلى التسليم</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل خطوة، باقياً ضمن اللوجستيات طوال الطريق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تذكير إعادة الصرف يُرسل قبل نفاد الدواء</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">قبل أيام من موعد نفاد دواء مزمن، يُرسل التذكير تلقائياً.</p>
        <ul class="journey-list">
          <li>موقّت مقابل سجل طلبات المريض الفعلي، لا تخمين ثابت لـ٣٠ يوماً</li>
          <li>يُرسل عبر واتساب أو رسالة نصية برابط إعادة طلب بلمسة واحدة</li>
          <li>لا وقت صيدلي يُنفَق على تذكير روتيني يستطيع نظام إرساله بنفسه</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">استفسار المخزون يُجاب دون اتصال بالفرع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يسأل إن كان صنف متوفراً قبل الذهاب.</p>
        <ul class="journey-list">
          <li>فحص مخزون حي عبر الفروع، لا إجابة ثابتة قديمة بحلول الظهيرة</li>
          <li>فرع بديل يُقترح تلقائياً إن نفد الصنف بالأقرب</li>
          <li>موظفو الاستقبال لا يُسحبون من العملاء في المتجر للرد على استفسار هاتفي</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">طلب يُقدَّم من صورة وصفة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يُرسل صورة وصفة جديدة عبر واتساب بدل زيارة الفرع.</p>
        <ul class="journey-list">
          <li>البوت يستخرج تفاصيل المريض والدواء ويفتح طلباً للمراجعة</li>
          <li>الصيدلي يتحقق من الوصفة قبل صرف أي شيء، تماماً كما يجب</li>
          <li>العميل يحصل على تحديث حالة توصيل بمجرد تأكيد الطلب وتحركه</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">alarm</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تذكيرات إعادة الصرف والطلب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مرضى الأدوية المزمنة ينسون إعادة الطلب أكثر مما تودّ الصيدليات الاعتراف به، وإعادة صرف فائتة غالباً تذهب لمنافس أو تطبيق توصيل بدلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُبقي عملاء الدواء المزمن يطلبون من نفس الصيدلية كل دورة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استفسارات المخزون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أسئلة المخزون من أعلى المكالمات حجماً وأقلها قيمة تستقبلها صيدلية، وتميل للارتفاع تماماً حين يكون الطاقم أكثر انشغالاً بالكاونتر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُحرّر طاقم الاستقبال من الهاتف خلال ساعات الذروة داخل المتجر</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">local_shipping</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات التوصيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التوصيل في الإمارات أصبح التوقع لا الاستثناء لطلبات الصيدلية. العملاء الذين لا يحصلون على تحديث حالة يميلون للاتصال والسؤال.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مكالمات "أين طلبي" أقل، نفس الجدول الزمني للتوصيل</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">مراسلة متوافقة مع الجهات الصحية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">لا نصيحة طبية، لا اقتراحات بديل غير مُصرَّح بها، أبداً. ردود البوت المسموحة محدودة النطاق منذ البناء: إعادة صرف، مخزون، توصيل، وتغطية فقط.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع نظام إدارة الصيدلية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إجابات المخزون وتوقيت إعادة الصرف مفيدة فقط إن كانت مسحوبة من بيانات حية. البوت يحتاج اتصالاً حقيقياً بنظامكم.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">وعي بالتأمين وشركات إدارة الصيدليات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فاحص التغطية موثوق فقط إن عرف حدود ما يستطيع تأكيده. يجب أن يُرجع إجابة مؤكدة حيث يدعمها اتصال شركة التأمين، ويُنبّه للفحص اليدوي في كل مكان آخر.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تصعيد واضح للصيدلي للأسئلة السريرية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مشغّل التصعيد يجب أن يكون واسعاً لا ضيقاً. أي شيء يلمس الجرعة أو التفاعلات أو طلب بديل يُحوَّل للصيدلي فوراً بسياق كامل.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1611746869696-d09bce200020?w=1200&q=80&auto=format&fit=crop" alt="عميل يستلم طلب توصيل من صيدلية إماراتية" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">صفر</p>
        <p style="color:#42474e; font-size:0.875rem;">توصيات سريرية يُقدّمها البوت، بالتصميم لا بالصدفة</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٢٤/٧</p>
