---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "هل يأخذ تحسين المسارات في الاعتبار سالك وزحام دبي وأنماط الطرق في الإمارات؟", answer: "نعم. يستخدم النظام بيانات حركة المرور المباشرة بما فيها أنماط الطرق الخاصة بالإمارات، وتكاليف بوابات سالك، وبيانات الازدحام التاريخية حسب وقت اليوم. ويأخذ في الاعتبار نوافذ التسليم الزمنية، وأوقات الصلاة، والفرق بين أنماط عطلة نهاية الأسبوع وأيام العمل الخاصة بسوق الإمارات. أنظمة تحسين المسارات المبنية لأمريكا أو أوروبا لا تنجح دائماً هنا. نظامنا مبني للإمارات." },
  { question: "هل يمكن ربطه بنظام إدارة النقل (TMS) أو ERP الحالي لدينا؟ لا نريد استبدال أنظمتنا الأساسية.", answer: "هكذا نعمل دائماً. نربط مع نظام إدارة النقل، وERP، وتتبع GPS، وبوابات العملاء لديكم بدلاً من استبدالها. بنينا عمليات ربط مع معظم منصات ERP واللوجستيات الرئيسية. إذا كنتم تستخدمون نظاماً مبنياً خصيصاً، سنطلب صلاحية الوصول إلى API ونعمل انطلاقاً منها. وفي الحالات النادرة التي لا يوجد فيها API، سنخبركم من البداية بدلاً من اكتشاف ذلك في منتصف المشروع." },
  { question: "ماذا عن اللوجستيات العابرة للحدود؟ نعمل بين الإمارات والسعودية وعُمان.", answer: "التوجيه العابر للحدود أكثر تعقيداً. أوقات التخليص الجمركي، وطوابير المنافذ الحدودية، ووثائق العبور كلها تؤثر على تخطيط التسليم. نبني هذا التعقيد داخل النموذج بدلاً من التظاهر بعدم وجوده. يستطيع النظام احتساب متوسط أوقات التخليص، والتنبيه لمشاكل الوثائق قبل المغادرة، وتعديل نوافذ التسليم للمسارات الدولية. هذا أمر نحدد نطاقه خصيصاً لحجم شحناتكم العابرة للحدود في المكالمة الأولى." },
  { question: "كيف يتعامل مع متطلبات التسليم في نفس اليوم؟", answer: "التسليم في نفس اليوم يتطلب إدراج الطلبات فورياً في المسارات الجارية، لا إعادة بناء المسارات من الصفر مع كل طلب جديد. يتولى النظام الإدراج الديناميكي، فيختار السائق الأنسب لاستلام الطلب الجديد حسب القرب والحمولة الحالية والوقت المتبقي في النافذة الزمنية. ويرسل للعملاء وقت وصول دقيقاً لحظة إرسال الطلب، مما يقلل مكالمات \"متى يصل طلبي؟\" بشكل كبير." },
  { question: "هل يساعد في إدارة أداء السائقين دون أن يكون تدخلياً؟", answer: "بيانات السائقين من أكثر المجالات حساسية في ذكاء اللوجستيات الاصطناعي. نبني لوحات تتابع مؤشرات الأداء (نسبة إتمام التسليم، وقت التوقف، استهلاك الوقود، الالتزام بالمسار) وتعرض الاتجاهات، لا مجرد لقطات. يرى المديرون البيانات مجمّعة حسب الفريق أولاً، ثم التفاصيل الفردية عند التحقيق في مشكلة محددة. ويرى السائقون بياناتهم الخاصة في واجهة منفصلة على الهاتف. ويمكننا تقديم المشورة حول كيفية تقديم ذلك لفريقكم بطريقة تبدو عادلة، لا رقابة." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_logistics')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

const faqLdJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const logisticsLdJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'الذكاء الاصطناعي للوجستيات وسلاسل الإمداد',
    url: 'https://lenooai.com/ar/industries/logistics',
    description: 'أنظمة ذكاء اصطناعي لشركات اللوجستيات في الإمارات: تحسين المسارات، إدارة الأساطيل، توقع الطلب، أتمتة المستودعات، وذكاء اصطناعي للتواصل مع العملاء.',
    inLanguage: 'ar',
    provider: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
    areaServed: 'UAE',
    serviceType: 'AI Consulting',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://lenooai.com/ar' },
      { '@type': 'ListItem', position: 2, name: 'القطاعات', item: 'https://lenooai.com/ar/industries/' },
      { '@type': 'ListItem', position: 3, name: 'الذكاء الاصطناعي للوجستيات', item: 'https://lenooai.com/ar/industries/logistics' },
    ],
  },
  faqLdJson,
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
---

<ArBaseLayout
  title="الذكاء الاصطناعي للوجستيات وسلاسل الإمداد في الإمارات"
  description="أدوات ذكاء اصطناعي للوجستيات في الإمارات: تحسين المسارات، توقع الطلب، أتمتة المستودعات، وإدارة الأساطيل. من Lenoo AI، وكالة ذكاء اصطناعي في دبي."
  canonicalPath="/ar/industries/logistics"
  enPath="/industries/logistics"
  ogImage="/assets/og-logistics.jpg"
  ldJson={logisticsLdJson}
>

<!-- HERO -->
<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>اللوجستيات وسلاسل الإمداد</div>
    <div class="logistics-hero-badge">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px;">local_shipping</span>
      ذكاء اصطناعي للوجستيات وسلاسل الإمداد
    </div>
    <h1>
      موظفو التوزيع لديكم يقضون ٤ ساعات في تخطيط المسارات.<br>
      <span class="gradient-text">الذكاء الاصطناعي ينجزها في ٤ دقائق.</span>
    </h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; line-height:1.8; max-width:680px; margin:1.5rem auto 2.5rem;">
      نبني أنظمة ذكاء اصطناعي لشركات اللوجستيات وسلاسل الإمداد في الإمارات: تحسين المسارات، ذكاء الأساطيل، أتمتة المستودعات، والتواصل مع العملاء. كلها مربوطة بأنظمة TMS وERP الحالية لديكم.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_logistics_hero" class="btn-primary">احجزوا استشارة مجانية في ذكاء اللوجستيات</button>
      <a href="#solutions" class="btn-outline">شاهدوا ما نعالجه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?w=1600&q=80&auto=format&fit=crop" alt="إدارة لوجستيات وسلاسل إمداد تعمل بالذكاء الاصطناعي في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٢٣٪", caption: "متوسط الانخفاض في تكلفة الوقود مع تحسين المسارات بالذكاء الاصطناعي" },
      { value: "٣١٪", caption: "تسليم أسرع مع التوجيه الديناميكي بالذكاء الاصطناعي" },
      { value: "٤٠ ساعة", caption: "من عمل التخطيط اليدوي الأسبوعي تُلغى لكل فريق عمليات" },
    ]} />
  </div>
</div>

<!-- WHY LOGISTICS -->
<section class="section">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 style="margin-bottom:1rem;">لماذا تُعد اللوجستيات من أكبر فرص الذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">سلاسل الإمداد العالمية تولّد تعقيداً هائلاً، والذكاء الاصطناعي يزدهر في التعقيد.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>حجم ضخم وبيانات كثيرة.</strong> تولّد اللوجستيات كميات هائلة من البيانات موزعة على أنظمة متفرقة، وهذا بالضبط نوع المشكلات التي تستطيع نماذج تعلم الآلة تحليلها وتحسينها بطرق لا يستطيعها البشر.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تعقيد بالغ.</strong> سلاسل الإمداد العالمية فيها متغيرات كثيرة جداً (الطقس، الموانئ، حركة المرور، الجمارك) لا يستطيع المخططون البشريون تحسينها بفعالية في الوقت الفعلي. الذكاء الاصطناعي يتعامل معها جميعاً في آن واحد.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>هوامش ربح ضيقة.</strong> في قطاع معروف بهوامشه الضيقة، حتى التحسينات الصغيرة في التوجيه أو الوقود أو التخزين تحقق عائداً كبيراً. الذكاء الاصطناعي يجعل هذه المكاسب قابلة للتكرار.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1553413077-190dd305871c?w=800&q=80&auto=format&fit=crop" alt="أرضية مستودع برفوف ممتلئة تُستخدم للتوزيع وتنفيذ الطلبات" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- UAE OPERATIONS PHOTO GRID -->
<section class="section" aria-labelledby="ops-photo-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="ops-photo-heading">عمليات الأساطيل والمستودعات في أنحاء الإمارات</h2>
      <p>نوع العناصر المتحركة التي صُممت أنظمتنا للتعامل معها كل يوم، بحجم دبي والشارقة.</p>
    </div>
    <div class="ops-photo-grid">
      <div class="ops-photo">
        <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=700&q=80&auto=format&fit=crop" alt="أسطول شاحنات توصيل يسير على طريق سريع قرب دبي" loading="lazy" width="700" height="500" />
        <p>أسطول على الطريق</p>
      </div>
      <div class="ops-photo">
        <img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=700&q=80&auto=format&fit=crop" alt="عامل مستودع يشغّل رافعة شوكية بين رفوف ممتلئة" loading="lazy" width="700" height="500" />
        <p>أرضية المستودع</p>
      </div>
      <div class="ops-photo">
        <img src="https://images.unsplash.com/photo-1580674285054-bed31e145f59?w=700&q=80&auto=format&fit=crop" alt="سائق توصيل الميل الأخير يمسح طرداً ضوئياً قبل تسليمه" loading="lazy" width="700" height="500" />
        <p>توصيل الميل الأخير</p>
      </div>
    </div>
  </div>
</section>

<!-- CHALLENGES -->
<section id="challenges" class="section" style="background:#e7eeff;">
  <div class="container">
    <div class="section-header">
      <h2>الأمور الثلاثة التي تكررها شركات اللوجستيات في الإمارات أمامنا</h2>
      <p>كل شركة لوجستيات مختلفة. لكن المشكلات التي تأتي بها إلينا هي عادةً نفس المشكلات الثلاث. ولكل منها حل.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card" style="padding:2.5rem;">
        <div class="challenge-icon" style="background:rgba(186,26,26,0.08);">
          <span class="material-symbols-outlined" aria-hidden="true" style="color:#ba1a1a;">schedule</span>
        </div>
        <h3 style="font-size:1.0625rem; font-weight:700; color:#00253b; margin-bottom:0.75rem;">"موظفو التوزيع لدينا يبدؤون كل صباح ببناء المسارات يدوياً على Excel."</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">أربعة أشخاص. ساعتان لكل منهم. كل يوم. هذه ٨ ساعات عمل تُصرف على مهمة ينجزها الذكاء الاصطناعي في ٤ دقائق، بينما ينتظر العملاء نوافذ التسليم ويبقى السائقون بلا عمل.</p>
        <p class="fix-lead">الحل: ذكاء اصطناعي لتحسين المسارات يخطط في دقائق، لا ساعات</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin:0;">يعيد الذكاء الاصطناعي حساب كل مسار كل صباح باستخدام حركة المرور المباشرة وتكاليف سالك ونوافذ التسليم. يراجع موظفو التوزيع ويوافقون بدلاً من البناء من الصفر.</p>
      </div>
      <div class="card" style="padding:2.5rem;">
        <div class="challenge-icon" style="background:rgba(245,158,11,0.10);">
          <span class="material-symbols-outlined" aria-hidden="true" style="color:#b45309;">visibility_off</span>
        </div>
        <h3 style="font-size:1.0625rem; font-weight:700; color:#00253b; margin-bottom:0.75rem;">"لا نملك رؤية مباشرة لأسطولنا بين الاستلام والتسليم."</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">سائق يختفي عن التواصل، تسليم يتأخر، عميل يتصل. وفريق العمليات لا يملك إجابة. فجوات الرؤية تكلفكم ثقة العملاء، وتكلفكم الوقود عندما يسلك السائقون مسارات غير مثالية لا يراها أحد.</p>
        <p class="fix-lead">الحل: ذكاء اصطناعي لإدارة الأسطول يعطيكم خريطة مباشرة</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin:0;">كل مركبة ترسل موقعها وحالتها ووقت وصولها المتوقع باستمرار. يرى فريق العمليات الاستثناءات لحظة حدوثها بدلاً من معرفتها من عميل غاضب.</p>
      </div>
      <div class="card" style="padding:2.5rem;">
        <div class="challenge-icon" style="background:rgba(0,37,59,0.08);">
          <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875;">chat</span>
        </div>
        <h3 style="font-size:1.0625rem; font-weight:700; color:#00253b; margin-bottom:0.75rem;">"فريق خدمة العملاء لدينا يجيب على سؤال 'أين طلبي؟' ٦٠ مرة يومياً."</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">موظفان. نفس السؤال. طوال اليوم. بالعربية والإنجليزية. هذه ليست خدمة عملاء. إنها وظيفة إبلاغ يستطيع الذكاء الاصطناعي تولّيها تلقائياً، فيتفرغ فريقكم للمحادثات التي تحتاج إنساناً فعلاً.</p>
        <p class="fix-lead">الحل: ذكاء اصطناعي للتواصل مع العملاء يجيب قبل أن يتصلوا</p>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin:0;">تُرسل تحديثات تلقائية بالعربية والإنجليزية عند الإرسال وأثناء النقل وعند التسليم. معظم العملاء لا يحتاجون للسؤال أبداً، لأن الإجابة وصلتهم مسبقاً.</p>
      </div>
    </div>
  </div>
</section>

<!-- KEY APPLICATIONS -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-4">
      <div class="card" style="padding:2rem;">
        <div class="key-app-icon">
          <span class="material-symbols-outlined" aria-hidden="true">route</span>
        </div>
        <h4 style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">تحسين المسارات الديناميكي</h4>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin-bottom:0.75rem;">تأخذ نماذج الذكاء الاصطناعي في الاعتبار حركة المرور المباشرة، وتكاليف بوابات سالك، وازدحام الموانئ، وسعة المركبات، ونوافذ التسليم لإعادة حساب أكفأ المسارات فوراً. مبنية لأنماط الطرق في الإمارات، لا نماذج عالمية عامة.</p>
        <span class="solution-tag">مثال: نظام ORION من UPS يوفر ٤٠٠ مليون دولار سنوياً من الوقود</span>
      </div>
      <div class="card" style="padding:2rem;">
        <div class="key-app-icon">
          <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
        </div>
        <h4 style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">توقع الطلب</h4>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.6; margin-bottom:0.75rem;">توقع ارتفاعات الطلب الإقليمية لتوزيع المخزون مسبقاً. قللوا المشتريات الطارئة والبحث المتسرع عن سعة في اللحظة الأخيرة.</p>
        <span class="solution-tag">DHL تتوقع الطلب على الشحن الجوي قبل ٣٠ يوماً</span>
      </div>
      <div class="card" style="padding:2rem;">
        <div class="key-app-icon">
          <span class="material-symbols-outlined" aria-hidden="true">precision_manufacturing</span>
        </div>
        <h4 style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">الصيانة التنبؤية</h4>
