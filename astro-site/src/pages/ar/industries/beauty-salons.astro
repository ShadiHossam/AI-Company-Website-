---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل هناك حد لعدد رسائل إنستغرام التي يستطيع الذكاء الاصطناعي التعامل معها في وقت واحد؟", answer: "لا يوجد حد عملي يهم صالوناً أو سبا. يتصل الروبوت عبر واجهات المراسلة الرسمية من Meta، فيستطيع إدارة مئات المحادثات المتزامنة دون تشكل طابور. الشيء الوحيد الذي يتغير مع الحجم هو طريقة ضبط قواعد التحويل، ليصل الطلب غير المعتاد فعلاً (شكوى، أو سؤال طبي عن علاج) إلى شخص بسرعة بدلاً من أن يعلق في حلقة آلية." },
  { question: "هل يستطيع الروبوت فعلاً الحجز على التقويم الحقيقي لمصففة محددة، لا على موعد عام فقط؟", answer: "نعم، وهذا هو الفرق بين روبوت حجز ومساعد جدولة حقيقي. يقرأ التوافر الحي لكل مصففة أو غرفة علاج من برنامج الحجز لديكم، ويراعي مدة الخدمة وأي وقت فاصل حددتموه، ولا يعرض إلا الأوقات المتاحة فعلاً للشخص أو الكرسي الذي طلبته العميلة. وإذا لم يكن لدى العميلة تفضيل، يمكنه أيضاً التحويل إلى من لديها الموعد المتاح التالي." },
  { question: "كيف يتعامل الذكاء الاصطناعي مع انتهاء الباقات والعضويات دون إزعاج العميلات؟", answer: "يتتبع الجلسات المتبقية وتواريخ الانتهاء لكل عميلة ويرسل تذكيرات وفق جدول تحددونه، عادةً تنبيه أول عندما تتبقى بضع جلسات أو أسابيع، وآخر أقرب إلى الموعد النهائي. النبرة والتوقيت قابلان للضبط، فيختلف تذكير تجديد عضوية شهرية عن تذكير باقة من ٦ جلسات على وشك الانتهاء. تحصل العميلات على تذكير مفيد، لا على ضغط بيعي." },
  { question: "هل نفقد اللمسة الشخصية إذا تمت الحجوزات عبر روبوت بدلاً من الاستقبال؟", answer: "معظم الصالونات تجد العكس. يتولى الروبوت الجزء المتكرر، مثل تأكيد موعد، وأخذ رقم هاتف، والإجابة عن «هل لديكم موعد مساء الجمعة؟»، فيوجه الاستقبال أو المصففات اهتمامهم إلى العميلات الجالسات فعلاً على الكرسي أو اللواتي يحتجن شيئاً لا يستطيعه الروبوت. صوت العلامة وأسلوب التحية وحتى استخدام الرموز التعبيرية كلها تحددونها قبل إطلاق الروبوت." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للصالونات ومراكز السبا في الإمارات",
    "url": "https://lenooai.com/ar/industries/beauty-salons",
    "description": "أنظمة ذكاء اصطناعي مخصصة للصالونات ومراكز السبا في الإمارات: روبوتات الحجز عبر إنستغرام وواتساب، وتقليل التغيب، والجدولة على مستوى المصففة، وأتمتة تجديد الباقات.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للصالونات ومراكز السبا"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للصالونات ومراكز السبا", "item": "https://lenooai.com/ar/industries/beauty-salons" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي للصالونات ومراكز السبا في الإمارات"
  description="ذكاء اصطناعي للصالونات في دبي: روبوتات الحجز عبر إنستغرام وواتساب، وتقليل التغيب، والجدولة على مستوى المصففة، وأتمتة تجديد الباقات لصالونات الإمارات."
  canonicalPath="/ar/industries/beauty-salons"
  enPath="/industries/beauty-salons"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الصالونات ومراكز السبا</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">للصالونات ومراكز السبا في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي للصالونات ومراكز السبا في الإمارات: روبوتات الحجز عبر إنستغرام وواتساب، والجدولة على مستوى المصففة، وتقليل التغيب، وتذكيرات تجديد الباقات. مبنية للساعات التي تراسلكم فيها عميلاتكم فعلاً، لا لساعات دوام الاستقبال فقط.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_beauty_salons_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لصالونكم</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1560184897-ae75f418493e?w=1600&q=80&auto=format&fit=crop" alt="صالون حديث في دبي مع كراسي التصفيف" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى للتحويل عند التواصل مع العميل المحتمل خلال ٥ دقائق بدلاً من ٣٠ (MIT)" },
      { value: "24/7", caption: "المدة التي يغطيها روبوت الحجز فعلاً، لا ساعات الاستقبال فقط" },
      { value: "+٢٠٠", caption: "جنسية تعيش في دبي، ومعظمها يفضل واتساب أو رسائل إنستغرام على المكالمات" },
    ]} />
  </div>
</div>

<!-- WHY SALONS & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا تصل أفضل حجوزاتكم عندما لا يكون أحد في الاستقبال</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>نافذة الحجز ويوم العمل لا يتداخلان.</strong> عميلة تتصفح إنستغرام في الحادية عشرة ليلاً ترى تسريحة تريدها فتراسل الصالون في تلك اللحظة. الاستقبال الذي يغلق في الثامنة مساءً ويفتح في العاشرة صباحاً يعني أن الرسالة تنتظر اثنتي عشرة ساعة، وحين يرد أحد تكون غالباً قد حجزت في مكان رد أولاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>إنستغرام وواتساب هما قناتا الحجز الحقيقيتان، لا الموقع الإلكتروني.</strong> معظم صالونات الإمارات تتلقى نية حجز حقيقية عبر الرسائل المباشرة أو واتساب أكثر مما تتلقاه عبر نموذج التواصل. العميلات يردن إرسال صورة مرجعية، أو السؤال إن كانت مصففة معينة متاحة، أو تأكيد السعر قبل الالتزام، ويردن هذه المحادثة على التطبيق الذي يستخدمنه أصلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>التغيب والإلغاء المتأخر يأكلان التقويم بهدوء.</strong> الكرسي الفارغ في الثالثة عصراً موعد خدمة لا يمكن عادةً بيعه مجدداً في وقت قصير. والتذكيرات اليدوية، إن حدثت أصلاً، تخرج بشكل غير منتظم. الصالونات ذات التقاويم الأكثر امتلاءً هي عادةً التي تُرسل فيها التذكيرات في كل مرة، لا فقط حين يتذكر الاستقبال.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80&auto=format&fit=crop" alt="مصففة تتفقد رسائل الحجز على هاتفها في صالون في دبي" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للصالونات ومراكز السبا في الإمارات</h2>
      <p>ستة أنظمة مبنية لطريقة الحجز الفعلية في الصالونات ومراكز السبا، ومتصلة ببرنامج الحجز الحالي لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الحجز عبر إنستغرام وواتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرد على رسائل الحجز المباشرة ورسائل واتساب لحظة وصولها، ليلاً أو نهاراً. يفهم طلباً مرفقاً بصورة مرجعية، ويتحقق من التوافر الفعلي، ويؤكد موعداً دون أن تنتظر العميلة فتح الاستقبال.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يغطي إنستغرام وواتساب ومحادثة موقعكم من نظام واحد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تذكير المواعيد وتقليل التغيب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل رسائل التأكيد والتذكير تلقائياً قبل كل موعد، مع رابط سهل لإعادة الجدولة، فتخبركم العميلة التي لا تستطيع الحضور فعلاً في وقت مبكر يكفي لملء الموعد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل موعد يحصل على تذكير، في كل مرة، دون قائمة يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد جدولة المصففات والغرف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحجز على التقويم الحقيقي للمصففة أو المعالجة أو غرفة العلاج التي طلبتها العميلة فعلاً، مع مراعاة مدة الخدمة والوقت الفاصل، فيتوقف الحجز المزدوج وتجاوز المواعيد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقرأ التوافر الحي لكل مصففة، لا موعداً عاماً مشتركاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">card_membership</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تجديد الباقات والعضويات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع الجلسات المتبقية وتواريخ الانتهاء لكل باقة وعضوية، ويتواصل بتذكير تجديد قبل أن تتركها العميلة تنتهي بهدوء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يرسل تنبيهات التجديد قبل الانتهاء، لا بعد أن تكون العميلة قد رحلت</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">rate_review</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">طلب التقييمات والإحالات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل طلب التقييم في اللحظة المناسبة، مباشرة بعد زيارة جيدة بوضوح، ويطلب من العميلات الراضيات إحالات عبر رابط مشاركة بسيط.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">توقيت مرتبط بالزيارة، لا رسالة جماعية لكل قائمة العملاء</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متابعة إعادة الحجز</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتواصل قرب الموعد الذي تحين فيه الدورة المعتادة للعميلة (تجديد صبغة، أو تنظيف بشرة، أو تعبئة أظافر)، مع رابط بضغطة واحدة لإعادة الحجز مع نفس المصففة والخدمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">توقيت مرتبط بدورة إعادة الحجز الخاصة بكل عميلة، لا بتاريخ ثابت</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">يتصل بـ Fresha وZenoti ومعظم برامج الحجز المستخدمة حالياً، بالعربية والإنجليزية.</p>
      <button onclick="openModal(this)" data-source="ar_beauty_salons_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لصالونكم</button>
    </div>
  </div>
</section>

<!-- ONE BOOKING JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">حجز واحد، من رسالة منتصف الليل إلى الكرسي</h2>
      <p>ما يتولاه الذكاء الاصطناعي من لحظة مراسلة العميلة حتى عودتها إلى الكرسي الشهر التالي.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">رسالة إنستغرام تُجاب في منتصف الليل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميلة ترسل صورة مرجعية وتطلب موعداً يوم الجمعة. الوقت متأخر، لكن الرد ليس كذلك.</p>
        <ul class="journey-list">
          <li>يفهم الطلب، بما فيه الصورة المرجعية أو اسم علاج محدد</li>
          <li>يتحقق من التوافر الفعلي فوراً بدلاً من تركها تنتظر حتى الصباح</li>
          <li>يؤكد الموعد في المحادثة نفسها، بالعربية أو الإنجليزية</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجز على تقويم المصففة الصحيحة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">الحجز لا يسقط في عمود مشترك فحسب، بل يصل إلى مكانه الصحيح فعلاً.</p>
        <ul class="journey-list">
          <li>يتحقق من التوافر الفعلي للمصففة أو الغرفة المحددة، لا من موعد عام</li>
          <li>يراعي مدة الخدمة والوقت الفاصل فلا يتجاوز اليوم وقته</li>
          <li>يرسل تأكيداً، ثم تذكيراً مع رابط إعادة الجدولة عند اقتراب الموعد</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تذكير إعادة الحجز الذي يملأ الشهر التالي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">تنتهي الزيارة، لكن العلاقة والتقويم يستمران في الحركة.</p>
        <ul class="journey-list">
          <li>يرسل طلب تقييم بعد أن تكون الزيارة قد سارت جيداً بوضوح</li>
          <li>يتواصل مجدداً مع اقتراب موعد إعادة الحجز المعتاد لها</li>
          <li>يقدم رابطاً بضغطة واحدة لإعادة الحجز مع نفس المصففة والخدمة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
