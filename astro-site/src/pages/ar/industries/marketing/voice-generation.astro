    .voice-toggle-btn.active { background:#006875; color:#fff; }
    .voice-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const voiceToggleWrap = document.querySelector('.voice-toggle');
  if (voiceToggleWrap) {
    const btns = voiceToggleWrap.querySelectorAll('.voice-toggle-btn');
    const panels = document.querySelectorAll('[data-voice-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-voice-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-voice-tier-panel') !== key; });
      });
    });
  }
</script>
