<script>
  const influencerTabWrap = document.querySelector('.influencer-tabs');
  if (influencerTabWrap) {
    const btns = influencerTabWrap.querySelectorAll('.influencer-tab-btn');
    const panels = document.querySelectorAll('[data-influencer-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-influencer-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-influencer-tab-panel') !== key; });
      });
    });
  }
</script>
