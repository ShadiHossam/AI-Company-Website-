    .email-toggle-btn.active { background:#006875; color:#fff; }
    .email-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const emailToggleWrap = document.querySelector('.email-toggle');
  if (emailToggleWrap) {
    const btns = emailToggleWrap.querySelectorAll('.email-toggle-btn');
    const panels = document.querySelectorAll('[data-email-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-email-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-email-tier-panel') !== key; });
      });
    });
  }
</script>
