    @media(max-width:900px) { .apps-grid { grid-template-columns:1fr 1fr; } .eval-grid { grid-template-columns:1fr 1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr 1fr !important; } }
    @media(max-width:600px) { .apps-grid { grid-template-columns:1fr; } .eval-grid { grid-template-columns:1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr !important; } }

.video-gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:0; }
.video-gallery-img { width:100%; height:220px; object-fit:cover; border-radius:16px; cursor:zoom-in; transition:transform 0.2s; display:block; }
.video-gallery-img:hover { transform:scale(1.02); }
.video-gallery-img:focus-visible { outline:2px solid #006875; outline-offset:3px; }
.video-lightbox { position:fixed; inset:0; background:rgba(0,19,32,0.9); display:flex; align-items:center; justify-content:center; z-index:1000; }
.video-lightbox[hidden] { display:none; }
.video-lightbox img { max-width:90vw; max-height:85vh; border-radius:8px; }
.video-lightbox-close { position:absolute; top:24px; right:32px; background:none; border:none; color:#fff; font-size:2rem; line-height:1; cursor:pointer; padding:4px 10px; border-radius:8px; }
.video-lightbox-close:focus-visible { outline:2px solid #fff; outline-offset:2px; }
@media(max-width:700px) { .video-gallery { grid-template-columns:1fr; } }

.video-card-toggle { display:flex; justify-content:space-between; align-items:center; width:100%; background:none; border:none; cursor:pointer; text-align:left; padding:0; gap:1rem; }
.video-card-toggle h3 { margin:0; }
.video-card-icon { font-size:1.25rem; color:#006875; transition:transform 0.2s; flex-shrink:0; }
.video-card-toggle[aria-expanded="true"] .video-card-icon { transform:rotate(45deg); }
.video-card-toggle:focus-visible { outline:2px solid #006875; outline-offset:2px; }
.video-card-panel { margin-top:0.75rem; }
</style>

<script>
  const videoGallery = document.querySelector('.video-gallery');
  const videoLightbox = document.querySelector('#video-lightbox');
  const videoLightboxImg = videoLightbox?.querySelector('img');
  const videoCloseBtn = videoLightbox?.querySelector('.video-lightbox-close');
  let videoLastFocused: HTMLElement | null = null;

  function videoOpenLightbox(img: HTMLImageElement) {
    if (videoLightboxImg) {
      (videoLightboxImg as HTMLImageElement).src = img.src;
      (videoLightboxImg as HTMLImageElement).alt = img.alt;
    }
    if (videoLightbox) {
      videoLastFocused = document.activeElement as HTMLElement;
      (videoLightbox as HTMLElement).hidden = false;
      (videoCloseBtn as HTMLElement)?.focus();
    }
  }

  function videoCloseLightbox() {
    if (videoLightbox) (videoLightbox as HTMLElement).hidden = true;
    videoLastFocused?.focus();
  }

  videoGallery?.querySelectorAll('.video-gallery-img').forEach((el) => {
    const img = el as HTMLImageElement;
    img.addEventListener('click', () => videoOpenLightbox(img));
    img.addEventListener('keydown', (e) => {
      const evt = e as KeyboardEvent;
      if (evt.key === 'Enter' || evt.key === ' ') {
        evt.preventDefault();
        videoOpenLightbox(img);
      }
    });
  });

  videoCloseBtn?.addEventListener('click', videoCloseLightbox);

  videoLightbox?.addEventListener('click', (e) => {
    if (e.target === videoLightbox) videoCloseLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!videoLightbox || (videoLightbox as HTMLElement).hidden) return;
    if (e.key === 'Escape') {
      videoCloseLightbox();
    } else if (e.key === 'Tab') {
      // The close button is the only focusable element in the dialog; keep focus trapped on it.
      e.preventDefault();
      (videoCloseBtn as HTMLElement)?.focus();
    }
  });

  document.querySelectorAll('[data-video-expand]').forEach((card) => {
    const btn = card.querySelector('.video-card-toggle');
    const panel = card.querySelector('.video-card-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) (panel as HTMLElement).hidden = expanded;
    });
  });
</script>
