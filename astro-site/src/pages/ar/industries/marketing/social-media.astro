<script>
  const socialGallery = document.querySelector('.social-gallery');
  const socialLightbox = document.querySelector('#social-lightbox');
  const socialLightboxImg = socialLightbox?.querySelector('img');
  const socialCloseBtn = socialLightbox?.querySelector('.social-lightbox-close');
  let socialLastFocused: HTMLElement | null = null;

  function socialOpenLightbox(img: HTMLImageElement) {
    if (socialLightboxImg) {
      (socialLightboxImg as HTMLImageElement).src = img.src;
      (socialLightboxImg as HTMLImageElement).alt = img.alt;
    }
    if (socialLightbox) {
      socialLastFocused = document.activeElement as HTMLElement;
      (socialLightbox as HTMLElement).hidden = false;
      (socialCloseBtn as HTMLElement)?.focus();
    }
  }

  function socialCloseLightbox() {
    if (socialLightbox) (socialLightbox as HTMLElement).hidden = true;
    socialLastFocused?.focus();
  }

  socialGallery?.querySelectorAll('.social-gallery-img').forEach((el) => {
    const img = el as HTMLImageElement;
    img.addEventListener('click', () => socialOpenLightbox(img));
    img.addEventListener('keydown', (e) => {
      const evt = e as KeyboardEvent;
      if (evt.key === 'Enter' || evt.key === ' ') {
        evt.preventDefault();
        socialOpenLightbox(img);
      }
    });
  });

  socialCloseBtn?.addEventListener('click', socialCloseLightbox);

  socialLightbox?.addEventListener('click', (e) => {
    if (e.target === socialLightbox) socialCloseLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!socialLightbox || (socialLightbox as HTMLElement).hidden) return;
    if (e.key === 'Escape') {
      socialCloseLightbox();
    } else if (e.key === 'Tab') {
      // The close button is the only focusable element in the dialog; keep focus trapped on it.
      e.preventDefault();
      (socialCloseBtn as HTMLElement)?.focus();
    }
  });

  const socialTabWrap = document.querySelector('.social-tabs');
  if (socialTabWrap) {
    const btns = socialTabWrap.querySelectorAll('.social-tab-btn');
    const panels = document.querySelectorAll('[data-social-tab-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-social-tab');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-social-tab-panel') !== key; });
      });
    });
  }
</script>
