---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

// أسئلة شائعة احتياطية
const fallbackFaqs = [
  { question: "هل يبدو الكونسيرج بالذكاء الاصطناعي غير شخصي للنزلاء؟", answer: "أنظمة الكونسيرج الحديثة بالذكاء الاصطناعي يمكن ضبطها لتطابق صوت علامة الفندق بدقة، سواء كان دافئاً وودوداً أو رسمياً ودقيقاً، حسب المنشأة. تُظهر أبحاث النزلاء (Oracle، ٢٠٢٤) أن ٦٥٪ من النزلاء يفضلون التواصل عبر الرسائل على المكالمات الهاتفية للطلبات الروتينية، بغض النظر عن كون الطرف الآخر ذكاءً اصطناعياً أو إنساناً. ما يهم النزلاء أن تكون الردود سريعة ودقيقة وبلغتهم." },
  { question: "كيف تختلف إدارة الإيرادات بالذكاء الاصطناعي عن أنظمة إدارة الإيرادات التقليدية؟", answer: "أنظمة إدارة الإيرادات التقليدية تستخدم قواعد ومنحنيات طلب تاريخية لاقتراح الأسعار. أما أنظمة الذكاء الاصطناعي فتستخدم تعلم الآلة لاكتشاف أنماط عبر متغيرات أكثر بكثير: ليس الحجوزات التاريخية فقط، بل تحركات أسعار المنافسين، وبيانات الفعاليات المحلية، ومؤشرات اتجاهات البحث، والعوامل الاقتصادية الكبرى. وتعدّل الأسعار في الوقت الفعلي (أحياناً كل ساعة) بدلاً من تحديثات ليلية مجمّعة. النتيجة تغييرات أسعار أكثر تكراراً ودقة تلتقط الطلب في ذروته تماماً." },
  { question: "ما بيانات النزلاء التي يستخدمها التخصيص بالذكاء الاصطناعي فعلياً؟", answer: "الأساس هو بيانات نظام إدارة المنشأة (PMS): تفضيلات نوع الغرفة، وسجل الإقامات السابقة، والطلبات الخاصة، ومصروفات الطعام والشراب. تُكمَّل هذه بالتفضيلات المعلنة التي تُجمع أثناء الحجز أو التواصل قبل الوصول، والتفضيلات المستنتجة من السلوك أثناء الإقامة. والأهم أن بيانات النزلاء يجب أن تُعالج بما يتوافق مع اللائحة الأوروبية لحماية البيانات، وقوانين حماية البيانات في الإمارات، وسياسة الخصوصية الخاصة بالفندق. الشفافية في استخدام البيانات أصبحت توقعاً متزايداً لدى النزلاء، لا مجرد متطلب قانوني." },
  { question: "ما سرعة نشر التواصل مع النزلاء بالذكاء الاصطناعي؟", answer: "الجدول الزمني يعتمد على تعقيد الربط مع نظام إدارة المنشأة، وإعداد المحتوى (قاعدة معرفة خاصة بالفندق، وقوائم الطعام والشراب، والتوصيات المحلية)، والاختبار باللغات المستهدفة. الذكاء الاصطناعي نفسه سريع الإعداد. العائق هو التأكد من دقة قاعدة المعرفة وضبط صوت العلامة بشكل صحيح قبل التشغيل مع النزلاء. سنعطيكم جدولاً زمنياً دقيقاً بعد مكالمة التدقيق الأولى." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_hospitality')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للضيافة والفنادق في الإمارات",
    "url": "https://lenooai.com/ar/industries/hospitality",
    "description": "أنظمة ذكاء اصطناعي مخصصة للفنادق ومجموعات الضيافة في الإمارات: كونسيرج ثنائي اللغة بالذكاء الاصطناعي، وأدوات تسعير ديناميكي، وإدارة الإيرادات، وأتمتة التواصل مع النزلاء.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Hospitality"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للضيافة", "item": "https://lenooai.com/ar/industries/hospitality" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للفنادق والضيافة في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لفنادق الإمارات: كونسيرج ثنائي اللغة، وتسعير ديناميكي، وإدارة الإيرادات، وأتمتة خدمة النزلاء."
  canonicalPath="/ar/industries/hospitality"
  enPath="/industries/hospitality"
  ogImage="/assets/og-hospitality.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الضيافة</div>
    <h1>ذكاء اصطناعي لفنادق دبي<br>و<span class="gradient-text">مجموعات الضيافة</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لفنادق دبي ومجموعات الضيافة: كونسيرج ثنائي اللغة بالذكاء الاصطناعي، ومحركات تسعير ديناميكي، وتخصيص تجربة النزلاء، وتحليل الإيرادات. مربوطة بنظام إدارة المنشأة، ومتعددة اللغات (العربية والإنجليزية)، ومدعومة بضمان الاسترداد ١٠٠٪.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_hospitality_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الضيافة</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1600&q=80&auto=format&fit=crop" alt="ردهة فندق فاخر تمثل الضيافة المدعومة بالذكاء الاصطناعي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 30%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "١٢٫٨ مليار $", caption: "حجم سوق الذكاء الاصطناعي في الضيافة بحلول ٢٠٣٠ (Grand View Research)" },
      { value: "+١٨٪", caption: "تحسن في الإيراد لكل غرفة متاحة من إدارة الإيرادات بالذكاء الاصطناعي (IDeaS)" },
      { value: "٧٤٪", caption: "من استفسارات النزلاء قابلة للأتمتة بالذكاء الاصطناعي (Oracle Hospitality)" },
    ]} />
  </div>
</div>

<!-- WHY HOSPITALITY & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الضيافة والذكاء الاصطناعي توافق طبيعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>توقعات النزلاء شخصية للغاية.</strong> المسافرون اليوم يتوقعون أن تتذكر الفنادق تفضيلاتهم من الإقامات السابقة، وأن تتواصل بلغتهم، وأن تتوقع احتياجاتهم قبل أن يعبّروا عنها. تقديم ذلك على نطاق واسع، عبر آلاف النزلاء ولغات متعددة وعشرات نقاط التواصل، ممكن فقط بعمليات يدعمها الذكاء الاصطناعي.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تحسين الإيرادات معقد رياضياً.</strong> تسعير الفنادق يتضمن عشرات المتغيرات: المدة بين الحجز والوصول، وأسعار المنافسين، والفعاليات المحلية، ومزيج أنواع الغرف، وأنماط الإلغاء، ورسوم وكالات السفر الإلكترونية. مديرو الإيرادات يستطيعون متابعة بضع إشارات، أما أنظمة الذكاء الاصطناعي فتتابعها جميعاً في آن واحد وتعدّل الأسعار في الوقت الفعلي، وتتفوق باستمرار على القرارات اليدوية.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>نسبة الموظفين إلى النزلاء تحت الضغط.</strong> تواجه الضيافة بعد الجائحة تحدياً هيكلياً في التوظيف: توقعات أعلى من النزلاء مع سوق عمل أضيق. يتولى الذكاء الاصطناعي عمل التواصل الروتيني كثيف الحجم ليركز الموظفون على التفاعل الحقيقي مع النزلاء الذي يصنع الولاء.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=800&q=80&auto=format&fit=crop" alt="سطح مسبح في منتجع شاطئي بدبي يصل إليه النزلاء لإقامتهم" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لفنادق دبي ومجموعات الضيافة</h2>
      <p>ستة أنظمة محددة تنشرها وكالتنا للذكاء الاصطناعي في دبي للفنادق ومجموعات الضيافة في أنحاء الإمارات، كل منها مربوط بنظام إدارة المنشأة وقنوات التواصل مع النزلاء لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كونسيرج ثنائي اللغة بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتولى طلبات النزلاء عبر تطبيقات المراسلة أو تطبيق الفندق أو دردشة الويب، قبل الوصول وأثناء الإقامة وبعد المغادرة. حجوزات المطاعم، وخدمة الغرف، والتوصيات المحلية، والشكاوى، بالعربية والإنجليزية والروسية والصينية وغيرها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">٧٤٪ من استفسارات النزلاء الروتينية تُعالج تلقائياً، فيتفرغ الموظفون للخدمة الشخصية (Oracle)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">price_change</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">محرك التسعير الديناميكي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تحسين فوري للأسعار يعالج أسعار المنافسين، ووتيرة الحجوزات، وتقويم الفعاليات المحلية، وبيانات قنوات وكالات السفر الإلكترونية لتعديل أسعار الغرف تلقائياً. يتصل بنظام إدارة المنشأة ومدير القنوات لديكم دون الحاجة لتحديث الأسعار يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">متوسط تحسن ١٠ إلى ١٨٪ في الإيراد لكل غرفة متاحة مقارنة بالتسعير اليدوي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_pin</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تخصيص تجربة النزلاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني ملفات دائمة للنزلاء من بيانات نظام إدارة المنشأة والتفضيلات وسجل الإقامات. تفضيلات الغرف، والمتطلبات الغذائية، ومؤشرات المناسبات الخاصة تُطبق تلقائياً عند تسجيل الوصول وطوال الإقامة، دون أن يحتاج الموظفون لتذكر أي شيء أو البحث عنه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">النزلاء الذين يحصلون على خدمة مخصصة ينفقون ٢٣٪ أكثر على الطعام والشراب والخدمات الإضافية (Hyatt)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحة تحليل الإيرادات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تجمع بيانات نظام إدارة المنشأة، وأداء وكالات السفر الإلكترونية، وتحركات أسعار المنافسين، ومؤشرات الطلب في لوحة مباشرة يستطيع فريق الإيرادات والإدارة العمل بها يومياً. توقعات الطلب، وتنبيهات وتيرة الحجز، وتوصيات مزيج القنوات في شاشة واحدة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبنية على بيانات منشأتكم الفعلية، لا مؤشرات مرجعية عامة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">reviews</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أداة تحليل التقييمات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نموذج معالجة لغة طبيعية يحلل تقييماتكم عبر المنصات الرئيسية لكشف المواضيع المتكررة، واتجاهات الانطباعات، والمشكلات التشغيلية المحددة. يتلقى المديرون العامون ملخصاً أسبوعياً منظماً: نتائج قابلة للتنفيذ، لا بيانات خام.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تحسن نقطة واحدة على TripAdvisor يرتبط بزيادة ١١٪ في متوسط سعر الغرفة اليومي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">restaurant</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقع الطلب على الطعام والشراب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتوقع أعداد رواد المطاعم، وحجم خدمة الغرف، والطلب على تموين الفعاليات باستخدام بيانات الإشغال وأنماط الحجوزات والاتجاهات الموسمية. يقلل هدر الطعام والشراب، ويمنع زيادة عدد الموظفين عن الحاجة، ويحسن نسبة تكلفة الطعام. يُحدَّث تلقائياً كل أسبوع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الذكاء الاصطناعي يقلل هدر الطعام والشراب في الفنادق بنسبة ٢٠ إلى ٣٥٪ (Winnow Solutions)</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9375rem;margin-bottom:1.25rem;">كل نظام مبني لمنشأتكم، ومربوط بنظام إدارة المنشأة لديكم، ومدرَّب على صوت علامتكم.</p>
      <button onclick="openModal(this)" data-source="ar_hospitality_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الضيافة</button>
    </div>
  </div>
</section>

<!-- GUEST JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">رحلة نزيل واحدة، من البداية إلى النهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يعمل فريقكم في الميدان.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجز يتحول إلى علاقة قبل تسجيل الوصول</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">من رسالة التأكيد إلى الاستقبال في المطار، يفتح الكونسيرج بالذكاء الاصطناعي المحادثة مبكراً، بلغة النزيل نفسه.</p>
        <ul class="journey-list">
          <li>إجابات فورية عن أوقات تسجيل الوصول، والتنقلات، وخطابات التأشيرة، وقواعد اللباس، دون الاتصال بمكتب الاستقبال</li>
          <li>عروض تسجيل وصول مبكر وترقية غرفة تُرسل في وقت تخطيط النزلاء، لا عند المكتب</li>
          <li>التفضيلات والحساسيات والمناسبات الخاصة تُجمع قبل وصول النزيل، ثم تُسجل في ملفه على نظام إدارة المنشأة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الطلبات تُجاب في ثوانٍ، لا بعد الرنة الثالثة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">أثناء الإقامة، الذكاء الاصطناعي هو أول من يستجيب للطلبات الروتينية، وأسرع طريق للوصول إلى إنسان عندما يهم الأمر.</p>
        <ul class="journey-list">
          <li>خدمة الغرف، وحجوزات السبا، وحجوزات المطاعم تُعالج عبر الدردشة، مربوطة بنظام إدارة المنشأة ونقاط البيع</li>
          <li>طلبات التدبير المنزلي والصيانة تُوجَّه للفريق المناسب مع تتبع الحالة، فلا يضيع شيء في ورقة مكالمات</li>
          <li>الشكاوى تُبلَّغ لمدير المناوبة فوراً، بينما النزيل ما زال في المنشأة والمشكلة ما زالت قابلة للإصلاح</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المغادرة بداية الحجز التالي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">معظم الفنادق تصمت بعد الفاتورة. أما الذكاء الاصطناعي فيستمر في بناء العلاقة.</p>
        <ul class="journey-list">
          <li>طلبات التقييم تُرسل في الوقت المناسب للنزلاء الذين كانت إقامتهم جيدة، فتحمي تقييماتكم على TripAdvisor وGoogle</li>
          <li>ملاحظات ما بعد الإقامة تُحلل لاكتشاف المشكلات التشغيلية المتكررة وتُرفع للمدير العام أسبوعياً</li>
          <li>عروض الإقامة المتكررة تُطابق تفضيلات كل نزيل السابقة ونمط سفره، وتُرسل عندما يُرجَّح أن يحجز مجدداً</li>
        </ul>
      </div>
    </div>
