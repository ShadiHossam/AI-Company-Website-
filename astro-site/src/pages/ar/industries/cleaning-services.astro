---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "كيف يتعامل النظام مع حجز متكرر حين يحتاج العميل إعادة جدولة زيارة واحدة؟", answer: "يعامل الزيارة المنفردة والجدول المتكرر كأمرين منفصلين. يستطيع العميل نقل زيارة واحدة أو تخطيها برسالة واتساب دون إلغاء الخطة المتكررة كلها، وتبقى الزيارة المجدولة التالية في مكانها تماماً. وينبّه النظام تلقائياً أيضاً إلى أي تعارض إذا اصطدمت الزيارة المنقولة بعمل آخر محجوز لنفس عامل النظافة." },
  { question: "هل يحتاج عمال النظافة لدينا إلى تثبيت تطبيق أو تعلم برنامج جديد؟", answer: "معظم الإعدادات تعمل عبر واتساب، لأنه ما يستخدمه عمال النظافة في الإمارات يومياً أصلاً. تفاصيل التوزيع والعناوين وملاحظات العمل تُرسل كرسالة، ويؤكد العامل برد بسيط. وإذا كنتم تستخدمون تطبيق توزيع أصلاً، فنتصل به بدلاً من استبداله." },
  { question: "ما طرق تحصيل المدفوعات التي يدعمها هذا فعلاً؟", answer: "يعتمد ذلك على طريقة تحصيلكم الحالية: نقداً عند الإنجاز، أو ببطاقة محفوظة، أو برابط دفع يُرسل برسالة. يرسل الذكاء الاصطناعي التذكير، والرابط حين تقبلون الدفع الإلكتروني، في النقطة المناسبة من دورة العمل. هو لا يعالج المدفوعات بنفسه، بل يضمن أن التذكير يخرج فعلاً وأن الرابط يُرسل فعلاً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات التنظيف والخدمات المنزلية في الإمارات",
    "url": "https://lenooai.com/ar/industries/cleaning-services",
    "description": "أنظمة ذكاء اصطناعي مخصصة لشركات التنظيف والخدمات المنزلية في الإمارات: الحجز عبر واتساب، وتوزيع عمال النظافة، وتقليل التغيب، وإدارة الحجوزات المتكررة، وتذكيرات الدفع.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للتنظيف والخدمات المنزلية"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لخدمات التنظيف", "item": "https://lenooai.com/ar/industries/cleaning-services" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لشركات التنظيف في الإمارات"
  description="ذكاء اصطناعي لشركات التنظيف في دبي: الحجز عبر واتساب، وتوزيع عمال النظافة، وتقليل التغيب، وإدارة الحجوزات المتكررة."
  canonicalPath="/ar/industries/cleaning-services"
  enPath="/industries/cleaning-services"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>خدمات التنظيف</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">للتنظيف والخدمات المنزلية في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات التنظيف والخدمات المنزلية في الإمارات: الحجز عبر واتساب، وتوزيع عمال النظافة، وتقليل التغيب، وإدارة الحجوزات المتكررة. مبنية لعمل يدور حول محادثة واتساب واحدة فوضوية، لا حول مركز اتصال.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_cleaning_services_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في خدمات التنظيف</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="فريق تنظيف محترف يجهز المستلزمات قبل عمل في دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى للتحويل عند التواصل مع العميل المحتمل خلال ٥ دقائق بدلاً من ٣٠ (MIT)" },
      { value: "١", caption: "محادثة واتساب هي عادةً حيث تتصادم اليوم الحجوزات والتوزيع والشكاوى معاً" },
      { value: "+٢٠٠", caption: "جنسية تعيش في دبي، ومعظمها يفضل واتساب على المكالمات" },
    ]} />
  </div>
</div>

<!-- WHY CLEANING & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا تعيش الحجوزات والتوزيع والتغيب كلها في محادثة واتساب واحدة فوضوية</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>كل شيء يمر عبر القناة نفسها.</strong> طلب حجز جديد، وتغيير عنوان، وعامل يسأل عن رمز البوابة، وعميل يسأل أين الفريق: كلها تصل إلى نفس رقم واتساب، الذي يديره عادةً من يكون متفرغاً في تلك اللحظة. لا شيء مفصول حسب النوع أو الأولوية.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>التوزيع يدوي وسهل الخطأ.</strong> مطابقة العامل المناسب مع العنوان المناسب في الوقت المناسب، مع مراعاة الزحام، والأعمال السابقة التي تطول، وتوافر الموظفين، أمر معقد فعلاً. والقيام به من الذاكرة أو جدول بيانات مشترك يعني أن الأخطاء تحدث تماماً حين يكون اليوم في ذروة ازدحامه.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>التغيب يحدث من الطرفين.</strong> العميل الذي ينسى الحجز ولا يكون في المنزل يضيّع موعد العامل لذلك اليوم. والعامل الذي لا يحضر يضيّع صباح العميل وكثيراً ما يكلف الشركة عميلاً متكرراً. التذكيرات المنتظمة للطرفين هي ما يمنع ذلك.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop" alt="منسق توزيع في شركة تنظيف يدير الحجوزات على الهاتف" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات التنظيف والخدمات المنزلية في الإمارات</h2>
      <p>ستة أنظمة مبنية حول واتساب والتوزيع والجداول المتكررة، ومتصلة بطريقة عمل فريقكم الحالية.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الحجز والجدولة عبر واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستقبل طلب الحجز الجديد مباشرة من واتساب: يجمع العنوان ونوع الخدمة والوقت المفضل، ويتحقق من التوافر الفعلي، ويؤكد الموعد دون أخذ ورد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحجز مباشرة في القناة التي يراسلكم عليها العملاء أصلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">route</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد توزيع العمال والمسارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يطابق كل عمل مع العامل المتاح المناسب حسب الموقع والجدول، ويرسل تفاصيل العمل والعنوان وملاحظات الدخول مباشرة إلى هاتفه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يرسل العمل الصحيح إلى العامل الصحيح دون إعادة ترتيب يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التذكير وتقليل التغيب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكيراً للعميل قبل كل زيارة، ويؤكد مع العامل المكلف، فلا يفوت العمل من أي طرف.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يؤكد طرفي العمل، العميل والعامل، في كل مرة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مدير الحجوزات المتكررة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبقي الحجز الأسبوعي أو نصف الشهري يتجدد تلقائياً، مع السماح للعميل بتخطي زيارة واحدة أو إعادة جدولتها دون إلغاء الخطة كلها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الزيارة المتخطاة لا تلغي الجدول المتكرر كله</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">payments</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تذكير تحصيل المدفوعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكير الدفع أو الرابط في النقطة المناسبة من دورة العمل، سواء كان التحصيل نقداً أو ببطاقة أو برابط إلكتروني، فلا يقع على المكتب عبء الملاحقة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">توقيت مرتبط بموعد إنجاز العمل فعلاً، لا بتاريخ فوترة ثابت</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">rate_review</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متابعة الجودة والتقييم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتواصل بعد إنجاز العمل ليلتقط أي مشكلة جودة مبكراً، ويطلب من العملاء الراضين تقييماً في اللحظة التي يكونون فيها الأكثر استعداداً لكتابته.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يلتقط الشكوى قبل أن تتحول إلى خسارة عميل متكرر</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">يعمل على واتساب، بالعربية والإنجليزية واللغات التي يتحدثها موظفوكم فعلاً.</p>
      <button onclick="openModal(this)" data-source="ar_cleaning_services_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في خدمات التنظيف</button>
    </div>
  </div>
</section>

<!-- ONE BOOKING JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">حجز واحد، من الطلب حتى إنجاز العمل</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول رسالة واتساب حتى التقييم بعد إنجاز العمل.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">يُؤكد ويُجدول تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يراسل طالباً تنظيفاً هذا الأسبوع، والروبوت يتولى الأمر من هناك.</p>
        <ul class="journey-list">
          <li>يجمع العنوان ونوع الخدمة والوقت المفضل في المحادثة نفسها</li>
          <li>يتحقق من التوافر الفعلي ويؤكد الموعد دون أخذ ورد يدوي</li>
          <li>يرسل رسالة تأكيد ليعرف العميل أن الموعد ثابت</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">العامل يُرسل بالتفاصيل الصحيحة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">خلف الكواليس، يُطابق العمل ويُرسل إلى الشخص المناسب تلقائياً.</p>
        <ul class="journey-list">
          <li>يطابق العمل مع عامل متاح حسب الموقع والجدول</li>
          <li>يرسل العنوان وملاحظات الدخول وتفاصيل العمل مباشرة إلى هاتفه</li>
          <li>يؤكد مع العامل والعميل قبل الزيارة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجز المتكرر الذي يجدد نفسه</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إذا كان العميل أسبوعياً أو نصف شهري، تستمر الدورة كاملة دون أعمال إدارية من المكتب.</p>
        <ul class="journey-list">
          <li>يجدد الجدول المتكرر تلقائياً دون حجز جديد في كل مرة</li>
          <li>يرسل تذكير الدفع أو الرابط بعد إنجاز العمل</li>
          <li>يتابع لطلب تقييم سريع، أو ينبّه إلى مشكلة جودة مبكراً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الحجز والجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تأكيد الحجز فوراً، دون انتظار أن يراجع أحدهم جدول بيانات أو يعاود الاتصال، هو غالباً أكبر فرق بين شركة تفوز بالعمل وأخرى تخسره أمام رد أسرع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">من يؤكد أولاً يحصل عادةً على الحجز</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">route</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تنسيق التوزيع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">المطابقة الآلية تقلل إعادة الترتيب اليومية التي تحدث حين يطول عمل أو يعتذر عامل بسبب المرض، لأن النظام يستطيع إعادة الإسناد وإبلاغ كل المعنيين أسرع بكثير من منسق يدوي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يعيد إسناد العمل خلال دقائق بدلاً من سلسلة مكالمات يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_busy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقليل التغيب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التذكيرات المنتظمة للطرفين، العميل والعامل، تسد معظم الفجوة التي تسبب رحلة ضائعة. إنه حل بسيط، لكن فقط إذا حدث في كل مرة، وهذا بالضبط ما تعجز عنه التذكيرات اليدوية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">التذكير الذي يحدث في كل مرة أفضل من الذي يحدث أحياناً</p>
      </div>
    </div>
