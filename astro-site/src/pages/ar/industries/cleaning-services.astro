---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات التنظيف والخدمات المنزلية في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/cleaning-services",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "شركات التنظيف", "item": "https://lenooai.com/ar/industries/cleaning-services" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات التنظيف والخدمات المنزلية في الإمارات",
    "description": "بوت حجز عبر واتساب لشركات التنظيف في الإمارات، توزيع عمال، تقليل الغياب، إدارة الحجوزات المتكررة، وتذكير بالدفع.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "كيف يتعامل النظام مع حجز متكرر عندما يحتاج العميل تأجيل زيارة واحدة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يعامل الزيارة الواحدة والجدول المتكرر كشيئين منفصلين. يستطيع العميل تأجيل أو تخطي زيارة واحدة عبر رسالة واتساب دون إلغاء الخطة المتكررة كلها، وتبقى الزيارة التالية في موعدها. النظام يُنبّه تلقائياً عند تعارض زيارة مؤجَّلة مع عمل آخر لنفس العامل." }
      },
      {
        "@type": "Question",
        "name": "هل يحتاج عمال التنظيف لدينا تثبيت تطبيق أو تعلّم برنامج جديد؟",
        "acceptedAnswer": { "@type": "Answer", "text": "معظم الإعدادات تعمل عبر واتساب، فهو ما يستخدمه عمال التنظيف في الإمارات بالفعل يومياً. تفاصيل التوزيع والعناوين وملاحظات العمل تُرسل كرسالة، ويؤكد العامل برد بسيط. إن كنتم تستخدمون تطبيق توزيع بالفعل، نتصل به بدل استبداله." }
      },
      {
        "@type": "Question",
        "name": "ما طرق تحصيل الدفع التي يدعمها هذا فعلياً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يعتمد على كيفية تحصيلكم الحالية: نقداً عند الإنجاز، بطاقة محفوظة، أو رابط دفع بالرسالة. الذكاء الاصطناعي يرسل التذكير، وحيث تقبلون دفعاً إلكترونياً، الرابط، في الوقت المناسب من دورة العمل. لا يُعالج الدفعات بنفسه، بل يضمن وصول التذكير والرابط فعلياً." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات التنظيف والخدمات المنزلية في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت حجز عبر واتساب لشركات التنظيف في الإمارات: توزيع عمال، تقليل غياب، وإدارة حجوزات متكررة. ضمان استرداد 100%."
  canonicalPath="/ar/industries/cleaning-services"
  enPath="/industries/cleaning-services"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>شركات التنظيف</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">cleaning_services</span>
      شركات التنظيف والخدمات المنزلية
    </div>
    <h1>ذكاء اصطناعي لشركات التنظيف في الإمارات<br><span class="gradient-text">محادثة واتساب واحدة لا تكفي بعد الآن</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      الحجز الجديد، تغيير العنوان، سؤال عامل عن كود البوابة، كلها تصل لنفس رقم واتساب. نبني لك بوتاً يحجز، يوزّع العمال حسب الموقع والجدول، ويرسل تذكيراً لكلا الطرفين قبل كل زيارة.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_cleaning_services_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="فريق تنظيف محترف يجهّز المستلزمات قبل عمل في دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند الرد خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">محادثة واحدة</p>
        <p class="stat-lbl">حيث تتصادم الحجوزات والتوزيع والشكاوى اليوم</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">+٢٠٠</p>
        <p class="stat-lbl">جنسية في دبي، أغلبها يفضّل واتساب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة التنظيف</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية حول واتساب والتوزيع والجداول المتكررة، متصلة بطريقة عمل فريقك بالفعل.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">chat</span>
        <h3>بوت حجز وجدولة عبر واتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يستقبل طلب حجز جديد مباشرة من واتساب: يجمع العنوان ونوع الخدمة والوقت المفضّل، ويؤكد الموعد دون مراسلات طويلة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">route</span>
        <h3>مساعد توزيع العمال والمسارات</h3>
        <p style="color:#42474e;line-height:1.7;">يطابق كل عمل مع العامل المتاح المناسب حسب الموقع والجدول، ويرسل التفاصيل والعنوان مباشرة لهاتفه.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">notifications_active</span>
        <h3>تذكير وتقليل الغياب</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تذكيراً للعميل قبل كل زيارة، ويؤكد مع العامل المُسند، فلا يفوت العمل من أي جانب.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_repeat</span>
        <h3>إدارة الحجوزات المتكررة</h3>
        <p style="color:#42474e;line-height:1.7;">يُبقي الحجز الأسبوعي أو نصف الشهري يتجدد تلقائياً، مع السماح بتخطي أو تأجيل زيارة واحدة دون إلغاء الخطة كلها.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">payments</span>
        <h3>تذكير بتحصيل الدفع</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تذكير دفع أو رابطاً في الوقت المناسب من دورة العمل، سواء نقداً أو بطاقة أو رابط إلكتروني.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">rate_review</span>
        <h3>متابعة الجودة والتقييم</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع بعد إنجاز العمل لرصد أي مشكلة جودة مبكراً، ويطلب تقييماً من العملاء الراضين في الوقت المناسب.</p>
      </div>
    </div>
  </div>
</section>

<!-- ONE BOOKING JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من طلب الحجز إلى إنجاز العمل</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول رسالة واتساب حتى التقييم بعد انتهاء العمل.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تأكيد وجدولة تلقائية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل يراسل طالباً تنظيفاً هذا الأسبوع. البوت يتولى الباقي.</p>
        <ul class="journey-list">
          <li>يجمع العنوان ونوع الخدمة والوقت المفضّل في نفس المحادثة</li>
          <li>يتحقق من التوفر الفعلي ويؤكد موعداً دون مراسلات يدوية</li>
          <li>يرسل رسالة تأكيد ليعرف العميل أن الموعد محجوز</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">العامل يُوزَّع بالتفاصيل الصحيحة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">خلف الكواليس، يُطابَق العمل ويُرسل للشخص المناسب تلقائياً.</p>
        <ul class="journey-list">
          <li>يطابق العمل مع عامل متاح حسب الموقع والجدول</li>
          <li>يرسل العنوان وملاحظات الوصول والتفاصيل مباشرة لهاتفه</li>
          <li>يؤكد مع العامل والعميل معاً قبل الزيارة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجز المتكرر الذي يتجدد بنفسه</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إن كان عميلاً أسبوعياً أو نصف شهري، تستمر الدورة كاملة دون تدخل إداري.</p>
        <ul class="journey-list">
          <li>يجدد الجدول المتكرر تلقائياً دون حجز جديد كل مرة</li>
          <li>يرسل تذكير دفع أو رابطاً بمجرد اكتمال العمل</li>
          <li>يتابع لطلب تقييم سريع، أو يُنبّه لمشكلة جودة مبكراً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الحجز والجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تأكيد الحجز فوراً، دون انتظار مراجعة جدول أو معاودة اتصال، غالباً هو الفارق الأكبر بين شركة تفوز بعمل وأخرى تخسره لرد أسرع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">من يؤكد أولاً يحصل على الحجز عادة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">route</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تنسيق التوزيع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">المطابقة الآلية تُقلّل إعادة الترتيب اليومي عند تأخر عمل أو غياب عامل مريض، فالنظام يعيد التوزيع ويُبلغ الجميع أسرع بكثير من موزّع بشري.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">إعادة توزيع خلال دقائق بدل سلسلة مكالمات يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_busy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقليل الغياب عن المواعيد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تذكيرات ثابتة لكلا الطرفين، العميل والعامل، تُغلق معظم الفجوة التي تُسبّب رحلة ضائعة. حل بسيط، لكن فقط إذا حدث في كل مرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكير يحدث دائماً يفوز على تذكير يحدث أحياناً</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">منطق توفر العمال والتوزيع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">يفهم أي عمال متاحون فعلياً، وأين هم، وما هو مُدرج على جدولهم بالفعل، فيصل العمل لمن يستطيع إنجازه فعلياً، لا مجرد أول اسم في القائمة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع الجداول المتكررة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">يفصل الزيارة الواحدة عن الخطة المتكررة الأساسية، فلا يُلغي تخطي أو تأجيل زيارة كل الحجوزات المستقبلية في السلسلة بالخطأ.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل تحصيل الدفع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">يرسل التذكير أو رابط الدفع الصحيح في الوقت المناسب، مطابقاً لطريقة تحصيلكم الفعلية، نقداً أو بطاقة أو رابط برسالة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">قاعدة عملاء وموظفين متعددة اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">يدير المحادثات باللغات التي يستخدمها عملاؤكم وعمال التنظيف لديكم فعلياً، فنادراً ما يعمل فريق تنظيف إماراتي بلغة واحدة فقط.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1605810230434-7631ac76ec81?w=1200&q=80&auto=format&fit=crop" alt="عامل تنظيف يراجع تفاصيل العمل على الهاتف" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">×٩</p>
        <p style="color:#42474e; font-size:0.875rem;">فرصة تحويل أعلى عند الرد خلال ٥ دقائق بدل ٣٠ (MIT)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">الرد الأول</p>
        <p style="color:#42474e; font-size:0.875rem;">عادة يفوز بالحجز حين يراسل العميل أكثر من شركة</p>
      </div>
      <div class="card" style="text-align:center;">
