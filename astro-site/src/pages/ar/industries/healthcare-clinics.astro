---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للعيادات الطبية في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/healthcare-clinics",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "العيادات الطبية", "item": "https://lenooai.com/ar/industries/healthcare-clinics" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للعيادات الطبية في الإمارات",
    "description": "موظف استقبال ذكاء اصطناعي عبر المكالمات وواتساب، حجز مواعيد، مساعد موافقة تأمينية مسبقة، ونظام استدعاء لعيادات صغيرة ومتوسطة في الإمارات، متوافق مع هيئة الصحة بدبي ودائرة الصحة أبوظبي.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يستطيع الذكاء الاصطناعي مناقشة أمور سريرية أو تقديم نصيحة طبية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "لا. الذكاء الاصطناعي مُبرمج للبقاء ضمن النطاق الإداري: الحجز، التذكير، حالة التأمين، ومعلومات العيادة العامة. أي سؤال يلمس الأعراض أو التشخيص أو العلاج يُصعَّد فوراً لطاقمكم السريري، بتحويل المحادثة لا الإجابة عليها من البوت." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق الموافقة التأمينية المسبقة بعد إشراك الذكاء الاصطناعي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الذكاء الاصطناعي لا يُقصّر وقت معالجة شركة التأمين نفسها، بل يُزيل التأخير من جانبكم: جمع تفاصيل بوليصة المريض وأكواد الإجراء والمستندات المطلوبة قبل إرسال الطلب أصلاً." }
      },
      {
        "@type": "Question",
        "name": "هل يعمل هذا مع نظام إدارة العيادة أو السجل الطبي الحالي لدينا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نتكامل مع أنظمة إدارة العيادات والسجلات الطبية الشائعة في عيادات الإمارات بدل طلب تبديل المنصة. قبل بناء أي شيء، نُحدّد إعدادكم الخاص ونؤكد ما هو ممكن عبر خيارات التكامل الحالية لنظامكم." }
      },
      {
        "@type": "Question",
        "name": "هل هذا نفس منتج الذكاء الاصطناعي بمستوى المستشفى؟",
        "acceptedAnswer": { "@type": "Answer", "text": "لا. أنظمة المستشفيات عادة مبنية حول أكوام تقنية معلوماتية سريرية كبيرة بعشرات الأقسام وطبقات امتثال. هذا مبني لعيادة واحدة أو مجموعة صغيرة: استقبال واحد، وحسابا نظام أو اثنان، وخط هاتف ورقم واتساب يصمتان لحظة انشغال الطاقم بمريض." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق تشغيل هذا فعلياً لعيادة واحدة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "موظف استقبال بالمكالمات وواتساب مع الحجز والتذكير ينطلق عادة خلال ثلاثة لخمسة أسابيع. يشمل ذلك الاتصال بنظامكم، وكتابة نص متوافق مع هيئة الصحة بدبي أو دائرة الصحة أبوظبي، واختباره." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للعيادات الطبية في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني موظف استقبال ذكاء اصطناعي، حجز مواعيد، موافقة تأمينية مسبقة، ونظام استدعاء لعيادات الإمارات، متوافق مع هيئة الصحة بدبي."
  canonicalPath="/ar/industries/healthcare-clinics"
  enPath="/industries/healthcare-clinics"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>العيادات الطبية</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">medical_services</span>
      العيادات الطبية
    </div>
    <h1>ذكاء اصطناعي للعيادات الطبية في الإمارات<br><span class="gradient-text">الاستقبال هو حيث تخسر العيادات المرضى</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      الهاتف يرن بينما الموظف مشغول بمريض. نبني لعيادتك موظف استقبال ذكياً يردّ عبر المكالمات وواتساب بالعربي والإنجليزي، يحجز مباشرة في نظامكم، ويُحوّل أي سؤال سريري لطاقمكم فوراً.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_healthcare_clinics_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1600&q=80&auto=format&fit=crop" alt="مكتب استقبال عيادة حيث يسجّل المرضى مواعيدهم" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">٣٠٪</p>
        <p class="stat-lbl">معدل غياب متوسط دون نظام تذكير آلي</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢:١</p>
        <p class="stat-lbl">نسبة عمل مكتبي لكل ساعة مع مريض (Annals of Internal Medicine)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة حجز أعلى عند الرد خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في عيادتك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية خصيصاً للعيادات الصغيرة والمتوسطة، متوافقة مع هيئة الصحة بدبي ودائرة الصحة أبوظبي.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">call</span>
        <h3>موظف استقبال ذكاء اصطناعي بالمكالمات وواتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يردّ على الهاتف وواتساب حين يكون استقبالكم مع مريض، بالعربي أو الإنجليزي، ويُحوّل أي سؤال سريري لطاقمكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">calendar_month</span>
        <h3>حجز المواعيد والتذكيرات</h3>
        <p style="color:#42474e;line-height:1.7;">يحجز مباشرة في تقويم نظام إدارة عيادتكم، يؤكد عبر واتساب أو رسالة نصية، ويرسل تذكيراً قبل الزيارة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">fact_check</span>
        <h3>مساعد الموافقة التأمينية المسبقة</h3>
        <p style="color:#42474e;line-height:1.7;">يجمع تفاصيل البوليصة ومعلومات الإجراء من المريض، ويُحضّر طلب الموافقة المسبقة ليرسله طاقمكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">schedule_send</span>
        <h3>متابعة واستدعاء المرضى</h3>
        <p style="color:#42474e;line-height:1.7;">يتواصل لزيارات المراجعة وفحوصات الأمراض المزمنة ومواعيد الاستدعاء حسب جدول تحدده عيادتكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_busy</span>
        <h3>نظام تقليل الغياب</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تذكيرات متدرجة قبل كل موعد ويطلب تأكيداً سريعاً. موعد مرجّح فوته يُنبَّه له مبكراً لعرضه على مريض آخر.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">translate</span>
        <h3>بوت استقبال متعدد اللغات</h3>
        <p style="color:#42474e;line-height:1.7;">يجمع بيانات المريض الجديد والتاريخ الطبي وأوراق الموافقة قبل الزيارة، بالعربي أو الإنجليزي.</p>
      </div>
    </div>
  </div>
</section>

<!-- PATIENT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">رحلة مريض واحد، من البداية للنهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يبقى أطباؤكم مركّزين على المريض في الغرفة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المكالمة التي كانت تذهب للبريد الصوتي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مريض يتصل أو يُراسل بينما موظف الاستقبال الوحيد يُسجّل شخصاً آخر.</p>
        <ul class="journey-list">
          <li>يردّ فوراً بالعربي أو الإنجليزي، لا بريد صوتي، لا استفسار ضائع</li>
          <li>يجيب عن أسئلة الساعات والأسعار والتوفر دون انتظار الطاقم</li>
          <li>يُنبّه لأي شيء سريري ويُسلّمه لموظف بدل التخمين</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز بلا مراسلات طويلة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد رغبة المريض بموعد، يُبقي الذكاء الاصطناعي الحجز يتحرك دون عشر رسائل متبادلة.</p>
        <ul class="journey-list">
          <li>يتحقق من تقويم النظام لحظياً ويقترح مواعيد متاحة</li>
          <li>يؤكد الحجز عبر واتساب أو رسالة نصية مع تذكير مرفق</li>
          <li>يجمع تفاصيل التأمين مسبقاً فتبدأ الموافقة المسبقة مبكراً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">متابعة تحدث فعلياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بعد الزيارة، يُبقي الذكاء الاصطناعي العلاقة مستمرة بدل تركها لمن يتذكر فحص القائمة.</p>
        <ul class="journey-list">
          <li>يرسل تذكيرات استدعاء للمراجعات وفحوصات الأمراض المزمنة</li>
          <li>يتواصل مجدداً إن لم يُعد المريض حجزاً بعد نصيحة بذلك</li>
          <li>يحتفظ بسجل كل متابعة أُرسلت، فلا شيء يعتمد على الذاكرة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">call</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الرد على المكالمات والرسائل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العيادات التي نتحدث معها تقول باستمرار نفس الشيء: الاستقبال يفوّت مكالمات ورسائل واتساب في ساعات الذروة لأن شخصاً واحداً يتعامل مع المرضى في الغرفة وكل شيء آخر معاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل مكالمة ورسالة تحصل على رد، حتى في أكثر الساعات ازدحاماً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الإدارة التأمينية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الموافقة المسبقة متكررة بطبيعتها: نفس حقول البوليصة، نفس أكواد الإجراء، نفس نماذج شركة التأمين، مراراً وتكراراً. هذا بالضبط نوع العمل الذي يُتقنه نظام ذكاء اصطناعي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الطلبات تنتقل من كومة آخر اليوم لتقديم بنفس اليوم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاستدعاء والاحتفاظ بالمرضى</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">قوائم الاستدعاء عادة أول ما يتفلّت حين تنشغل العيادة، لأن ملاحقة مريض لزيارة مراجعة لا تبدو عاجلة بجانب المرضى في غرفة الانتظار.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">المرضى يسمعون من العيادة مجدداً بدل الانجراف لمنافس</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعل ذكاء العيادة يعمل فعلياً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">نص متوافق مع هيئة الصحة بدبي/دائرة الصحة أبوظبي</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">النص مكتوب للبقاء ضمن الحدود من أول جملة: لا تشخيص، لا نصيحة علاجية، قواعد تصعيد واضحة. هذا يُصمَّم قبل الإطلاق، لا يُرقَّع لاحقاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع نظام إدارة العيادة أو السجل الطبي</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحجز والتذكير والاستدعاء تعمل فقط إن قرأت وكتبت في التقويم الذي تستخدمه عيادتكم بالفعل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">ثنائي اللغة (عربي/إنجليزي)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المرضى يُبدّلون بين العربية والإنجليزية منتصف المحادثة، والذكاء الاصطناعي يجب أن يتبع ذلك بشكل طبيعي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تصعيد بشري للأسئلة السريرية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أي شيء يلمس الأعراض أو التشخيص أو العلاج يُسلَّم للطاقم، مع السياق مُجمَّعاً بالفعل فلا يحتاج المريض تكرار كلامه.</p>
