---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const faqItems = [
  { question: "هل يستطيع الذكاء الاصطناعي مناقشة الأمور السريرية أو تقديم نصائح طبية؟", answer: "لا. نص الذكاء الاصطناعي مكتوب ليبقى في النطاق الإداري: الحجز، والتذكيرات، وحالة التأمين، ومعلومات العيادة العامة. أي سؤال يمس الأعراض أو التشخيص أو العلاج يُصعَّد فوراً إلى طاقمكم الطبي مع تسليم المحادثة، ولا يجيب عنه الروبوت. هذا الحد مبني في النص نفسه، لا متروك لتقدير النموذج." },
  { question: "كم تستغرق الموافقة المسبقة من التأمين عند استخدام الذكاء الاصطناعي؟", answer: "الذكاء الاصطناعي لا يختصر مدة المعالجة لدى شركة التأمين، فهي من تحددها. ما يزيله هو التأخير من جهتكم: جمع تفاصيل وثيقة المريض ورموز الإجراءات والمستندات المطلوبة قبل إرسال الطلب أصلاً. معظم العيادات ترى الطلبات تخرج في نفس اليوم بدلاً من انتظارها في طابور حتى يتفرغ لها الموظفون." },
  { question: "هل يعمل هذا مع نظام إدارة العيادة أو السجل الطبي الإلكتروني الحالي لدينا؟", answer: "نتكامل مع أنظمة إدارة العيادات والسجلات الطبية الإلكترونية الشائعة في عيادات الإمارات بدلاً من مطالبتكم بتغيير المنصة. قبل بناء أي شيء، نحدد نطاق إعدادكم الخاص ونتأكد مما هو ممكن عبر خيارات التكامل المتاحة في نظامكم. وإذا لم يكن لنظامكم أي واجهة برمجية، فسنخبركم مسبقاً بدلاً من أن نعد بشيء لا نستطيع تقديمه." },
  { question: "هل هذا نفس منتج أنظمة الذكاء الاصطناعي المخصصة للمستشفيات؟", answer: "لا. أنظمة المستشفيات مبنية عادةً حول بنى تقنية سريرية كبيرة بعشرات الأقسام وطبقات الامتثال. أما هذا فمبني لعيادة واحدة أو مجموعة صغيرة: مكتب استقبال واحد، وحساب أو حسابان في نظام إدارة العيادة، وخط هاتف ورقم واتساب يصمتان لحظة انشغال الموظفين بمريض. والنطاق والسعر يعكسان ذلك." },
  { question: "ما مدى سرعة تشغيل هذا فعلياً في عيادة واحدة؟", answer: "موظف الاستقبال الآلي للمكالمات وواتساب مع الحجز والتذكيرات ينطلق عادةً خلال ثلاثة إلى خمسة أسابيع. يشمل ذلك الربط بنظام إدارة العيادة، وكتابة نص مناسب لمتطلبات هيئة الصحة بدبي أو دائرة الصحة في أبوظبي حسب تخصصكم، واختباره على أنماط مكالمات حقيقية قبل الإطلاق. مساعد الموافقة المسبقة من التأمين وأتمتة الاستدعاء يُضافان عادةً في مرحلة ثانية بعد إثبات نظام الاستقبال." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي للعيادات الطبية في الإمارات",
    "url": "https://lenooai.com/ar/industries/healthcare-clinics",
    "description": "تبني Lenoo AI موظفي استقبال آليين للمكالمات وواتساب، وأنظمة الحجز والموافقة المسبقة من التأمين والاستدعاء للعيادات الطبية الصغيرة والمتوسطة في الإمارات، متوافقة مع هيئة الصحة بدبي ودائرة الصحة في أبوظبي.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للعيادات الطبية"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للعيادات الطبية", "item": "https://lenooai.com/ar/industries/healthcare-clinics" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي للعيادات الطبية في الإمارات"
  description="ذكاء اصطناعي للعيادات في الإمارات: موظفو استقبال آليون للمكالمات وواتساب، وأنظمة الحجز والموافقة المسبقة من التأمين والاستدعاء للعيادات الصغيرة والمتوسطة، متوافقة مع هيئة الصحة بدبي ودائرة الصحة في أبوظبي."
  canonicalPath="/ar/industries/healthcare-clinics"
  enPath="/industries/healthcare-clinics"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1600&q=80&auto=format&fit=crop", alt: "مكتب استقبال عيادة يسجل فيه المرضى حضورهم للمواعيد", position: "center 40%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>العيادات الطبية</div>
  <h1>ذكاء اصطناعي للعيادات الطبية<span class="h1-sep">: </span><br><span class="gradient-text">في الإمارات</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI موظفي استقبال آليين، وأنظمة الحجز والموافقة المسبقة من التأمين والاستدعاء للعيادات الصغيرة والمتوسطة في أنحاء الإمارات. مبنية لمكتب استقبال عيادة واحدة، لا لقسم تقنية معلومات في مستشفى، ونصوصها مكتوبة ضمن حدود هيئة الصحة بدبي ودائرة الصحة في أبوظبي من اليوم الأول.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_healthcare_clinics_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في عيادتكم</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "٣٠٪", caption: "متوسط نسبة التغيب في العيادات الخارجية دون تذكيرات آلية" },
      { value: "٢:١", caption: "ساعات العمل المكتبي مقابل كل ساعة مع المرضى (Annals of Internal Medicine)" },
      { value: "٩×", caption: "احتمال أعلى للحجز عند التواصل خلال ٥ دقائق بدلاً من ٣٠ (MIT)" },
    ]} />
  </div>
</PageHero>

<!-- WHY THE FRONT DESK LOSES PATIENTS -->
<section class="section" aria-labelledby="front-desk-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="front-desk-heading" style="margin-bottom:1.5rem;">لماذا مكتب الاستقبال هو حيث تخسر العيادات مرضاها</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الهاتف يرن بينما الموظفون مع مريض.</strong> العيادة التي فيها طبيب أو طبيبان ليس لديها موظف استقبال إضافي ينتظر اللحظات الهادئة. عندما ينشغل الاستقبال بتسجيل مريض أو سحب عينة دم أو معالجة دفعة، تذهب المكالمة التالية إلى البريد الصوتي، ومعظم المتصلين لا يتركون رسالة. بل يتصلون بالعيادة التالية في القائمة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>استفسارات واتساب تتراكم أسرع مما يُرد عليها.</strong> المرضى يراسلون العيادات اليوم كما يراسلون أي أحد، ويتوقعون رداً سريعاً. محادثة واحدة دون رد لا تبدو عاجلة في لحظتها، لكن بنهاية الأسبوع قد تجد العيادة نفسها أمام عشرات الأسئلة دون رد عن المواعيد المتاحة والأسعار والتغطية التأمينية.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>كل عيادة في الإمارات تعمل ضمن قواعد هيئة الصحة بدبي أو دائرة الصحة في أبوظبي، وهذا يحدد ما هو ممكن.</strong> أي شيء يرد على مكالمة أو رسالة واتساب نيابة عن عيادة يجب أن يبقى ضمن حدود صارمة: لا تشخيص، ولا نصائح علاجية، ولا حكم سريري. هذا ليس قيداً تلتفون عليه لاحقاً، بل شرط يجب أن يُبنى النظام حوله من أول سطر في النص.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1758691461957-13aff0c37c6f?w=800&q=80&auto=format&fit=crop" alt="طبيب يراجع ملف مريض على جهاز لوحي بين المواعيد" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- AI SYSTEMS BUILT FOR CLINICS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية للعيادات</h2>
      <p>ستة أنظمة مبنية خصيصاً للعيادات الصغيرة والمتوسطة، بنصوص ضمن حدود هيئة الصحة بدبي ودائرة الصحة في أبوظبي، ومتصلة بنظام إدارة العيادة الذي تستخدمونه.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">call</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">موظف استقبال آلي للمكالمات وواتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرد على الهاتف وواتساب عندما يكون الاستقبال مع مريض، بالعربية أو الإنجليزية. يتولى أسئلة المواعيد والموقع والأسعار والتوافر، ثم يحوّل أي أمر سريري مباشرة إلى الموظفين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">لن يذهب أي متصل إلى البريد الصوتي في ساعات الذروة بعد الآن</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">حجز المواعيد والتذكيرات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحجز مباشرة في تقويم نظام إدارة العيادة، ويؤكد عبر واتساب أو الرسائل النصية، ويرسل تذكيرات قبل الزيارة. ويستطيع المرضى إعادة الجدولة بأنفسهم دون مكالمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يملأ المواعيد التي كانت ستبقى فارغة في تقويم ممتلئ</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد الموافقة المسبقة من التأمين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع تفاصيل الوثيقة ومعلومات الإجراء من المريض، ويطابقها مع متطلبات شركات التأمين لديكم، ويجهز طلب الموافقة المسبقة ليرسله الموظفون.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الطلبات تخرج من العيادة في نفس اليوم بدلاً من أن تتكدس</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">schedule_send</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متابعة المرضى واستدعاؤهم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتواصل من أجل زيارات المراجعة، ومتابعات الأمراض المزمنة، ومواعيد الاستدعاء وفق الجدول الذي تحدده عيادتكم، فلا يختفي المرضى بهدوء من السجلات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي مرضى الاستدعاء على جدولهم دون موظف يتابع قائمة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_busy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تقليل التغيب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكيرات متدرجة قبل كل موعد ويطلب تأكيداً سريعاً. والموعد المرجح أن يفوت يُنبَّه إليه مبكراً بما يكفي لعرضه على مريض آخر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل المواعيد الفارغة إلى فرصة لملئها، لا إلى زيارة ضائعة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">translate</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تسجيل متعدد اللغات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع بيانات المرضى الجدد، ونماذج التاريخ الطبي، وأوراق الموافقة قبل الزيارة، بالعربية أو الإنجليزية، فيبدأ الموعد الأول بالفحص لا بالأوراق.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلص الوقت المصروف على النماذج في غرفة الانتظار إلى ما يقارب الصفر</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام مكتوب ضمن حدود هيئة الصحة بدبي ودائرة الصحة في أبوظبي، ثنائي اللغة، ومتصل بنظام إدارة العيادة الحالي لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_healthcare_clinics_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في عيادتكم</button>
    </div>
  </div>
</section>

<!-- PATIENT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">رحلة مريض واحد، من البداية إلى النهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يبقى أطباؤكم مركزين على المريض الذي أمامهم.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المكالمة التي كانت تذهب إلى البريد الصوتي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مريض يتصل أو يراسل بينما موظف الاستقبال الوحيد لديكم يسجل مريضاً آخر.</p>
        <ul class="journey-list">
          <li>يرد فوراً بالعربية أو الإنجليزية، دون بريد صوتي ودون استفسار ضائع</li>
          <li>يجيب عن أسئلة المواعيد والأسعار والتوافر دون انتظار الموظفين</li>
          <li>ينبّه إلى أي أمر سريري ويسلّمه لموظف بدلاً من التخمين</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز دون أخذ ورد</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد أن يريد المريض موعداً، يدفع الذكاء الاصطناعي الحجز للأمام دون عشر رسائل متبادلة.</p>
        <ul class="journey-list">
          <li>يراجع تقويم نظام إدارة العيادة فورياً ويقترح المواعيد المتاحة</li>
          <li>يؤكد الحجز عبر واتساب أو الرسائل النصية مع تذكير مرفق</li>
          <li>يجمع تفاصيل التأمين مسبقاً ليبدأ طلب الموافقة المسبقة مبكراً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">متابعة تحدث فعلاً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بعد الزيارة، يحافظ الذكاء الاصطناعي على العلاقة بدلاً من تركها لمن يتذكر مراجعة القائمة.</p>
        <ul class="journey-list">
          <li>يرسل تذكيرات الاستدعاء للمراجعات ومتابعات الأمراض المزمنة والفحوصات الدورية</li>
          <li>يتواصل مجدداً إذا لم يحجز المريض بعد أن نُصح بذلك</li>
          <li>يحتفظ بسجل لكل متابعة أُرسلت، فلا يعتمد شيء على الذاكرة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">call</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الرد على المكالمات والرسائل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العيادات التي نتحدث معها تقول الشيء نفسه باستمرار: الاستقبال يفوّت المكالمات ورسائل واتساب في ساعات الذروة لأن شخصاً واحداً يتعامل مع المرضى الحاضرين ومع كل شيء آخر في الوقت نفسه. هذا هو المكان الأعلى أثراً لوضع موظف استقبال آلي، لأنه اللحظة التي يقرر فيها المريض الجديد أو العائد إما أن يواصل المحاولة أو يتصل بالعيادة التالية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل مكالمة ورسالة تحصل على رد، حتى في أكثر الساعات ازدحاماً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الأعمال الإدارية للتأمين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الموافقة المسبقة من التأمين متكررة بطبيعتها: نفس حقول الوثيقة، ونفس رموز الإجراءات، ونفس نماذج شركات التأمين، مرة بعد مرة. وهذا بالضبط نوع العمل الذي يتقنه نظام الذكاء الاصطناعي، فيجمع المعلومات ويجهز الطلب ليراجعه الموظفون ويرسلوه بدلاً من كتابته من الصفر كل مرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الطلبات تنتقل من كومة في نهاية اليوم إلى إرسال في نفس اليوم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاستدعاء والاحتفاظ بالمرضى</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">قوائم الاستدعاء عادةً أول ما يُهمل عندما تنشغل العيادة، لأن ملاحقة المرضى لزيارة مراجعة لا تبدو عاجلة أمام المرضى الموجودين في غرفة الانتظار. الاستدعاء الآلي يمنع ذلك الإيراد وتلك العلاقة مع المريض من الاختفاء بهدوء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">المرضى يسمعون من العيادة مجدداً بدلاً من الانجراف إلى منافس</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعل الذكاء الاصطناعي في العيادات ينجح فعلاً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">نصوص متوافقة مع هيئة الصحة بدبي ودائرة الصحة في أبوظبي</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">النص مكتوب ليبقى ضمن حدود هيئة الصحة بدبي ودائرة الصحة في أبوظبي من أول سطر: لا تشخيص، ولا نصائح علاجية، وقواعد تصعيد واضحة. هذا مصمم قبل الإطلاق، لا مرقّع بعده.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع نظام إدارة العيادة والسجل الطبي الإلكتروني</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحجز والتذكيرات والاستدعاء لا تعمل إلا إذا كانت تقرأ وتكتب في التقويم الذي تستخدمه عيادتكم أصلاً. النظام الذي يعيش خارج نظام إدارة العيادة يصنع تقويماً ثانياً لا يثق به أحد.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">ثنائي اللغة (العربية والإنجليزية)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المرضى ينتقلون بين العربية والإنجليزية في منتصف المحادثة، والذكاء الاصطناعي يحتاج أن يتبعهم بشكل طبيعي، لا أن يلتزم باللغة التي بدأ بها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تصعيد الأسئلة السريرية إلى موظف</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أي شيء يمس الأعراض أو التشخيص أو العلاج يُسلَّم إلى الموظفين، مع السياق مجموعاً مسبقاً فلا يضطر أحد لتكرار شيء.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تقوله البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1200&q=80&auto=format&fit=crop" alt="طبيب وموظف استقبال يراجعان جدول مواعيد العيادة" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
