---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل بيانات عملائنا آمنة إذا مر جزء من العملية عبر الذكاء الاصطناعي؟", answer: "كل نظام يُحدَّد نطاقه حول صلاحيات الوصول الحالية لديكم، لا حول صندوق بريد مشترك يراه الجميع. روبوتات جمع المستندات لا تتعامل إلا مع المستندات المطلوب منها جمعها، وذكاء إدخال البيانات لا يلمس إلا الدفتر المربوط به، ولا نمرر البيانات المالية الحساسة عبر أدوات لم تُبنَ للتعامل معها. متطلبات السرية جزء من النطاق الأولي، لا أمر لاحق." },
  { question: "هل يعمل هذا مع البرامج التي نستخدمها أصلاً؟", answer: "نبني حول برامج المحاسبة الشائعة لدى مكاتب المحاسبة في الإمارات، بما فيها Zoho Books وXero وTally، بدلاً من مطالبتكم بالانتقال. قبل بدء أي بناء، نتأكد بالضبط مما تدعمه أدواتكم الحالية ونصمم الربط حولها. وإذا لم يكن ربط معين ممكناً، نخبركم بذلك من البداية." },
  { question: "ما مدى دقة الذكاء الاصطناعي في متابعة مواعيد ضريبة القيمة المضافة وضريبة الشركات؟", answer: "يعمل المتتبع وفق تقويم الإقرارات الخاص بتسجيل كل عميل، لا وفق جدول عام لكل الإمارات، لأن تكرار الإقرارات ومواعيد استحقاقها تختلف من كيان لآخر. ينبّه إلى المواعيد القادمة مبكراً بما يكفي ليحضّر فريقكم ويراجع، وكل إقرار يمر بمراجعة بشرية قبل تقديمه للهيئة الاتحادية للضرائب." },
  { question: "هل سيحل هذا محل المحاسبين أو موظفي خدمة العملاء لدينا؟", answer: "لا. إنه يزيل الأجزاء المتكررة من العمل: ملاحقة نفس المستندات كل شهر، وإعادة كتابة بيانات الفواتير، والإجابة عن نفس أسئلة العملاء. يستمر موظفوكم في مراجعة الأرقام، واتخاذ القرارات التقديرية، والتعامل مع أي شيء يحتاج إنساناً. ومعظم المكاتب تستخدم الوقت الذي يوفره ذلك لتولي عملاء أكثر دون زيادة عدد الموظفين." },
];

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لمكاتب المحاسبة في الإمارات",
    "url": "https://lenooai.com/ar/industries/accounting-firms",
    "description": "تبني Lenoo AI أنظمة ذكاء اصطناعي لمكاتب المحاسبة في الإمارات: جمع مستندات العملاء، ومتابعة مواعيد ضريبة القيمة المضافة وضريبة الشركات، وإدخال بيانات مسك الدفاتر، وروبوتات الرد على استفسارات العملاء.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Accounting Firms"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لمكاتب المحاسبة", "item": "https://lenooai.com/ar/industries/accounting-firms" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لمكاتب المحاسبة في الإمارات"
  description="ذكاء اصطناعي لمكاتب المحاسبة في الإمارات: جمع المستندات، ومتابعة مواعيد ضريبة القيمة المضافة وضريبة الشركات، وإدخال بيانات مسك الدفاتر، وأتمتة الرد على استفسارات العملاء."
  canonicalPath="/ar/industries/accounting-firms"
  enPath="/industries/accounting-firms"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>مكاتب المحاسبة</div>
    <h1>ذكاء اصطناعي لمكاتب المحاسبة<span class="h1-sep">: </span><br><span class="gradient-text">في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لمكاتب المحاسبة في الإمارات: جمع المستندات، ومتابعة مواعيد ضريبة القيمة المضافة وضريبة الشركات، وإدخال بيانات مسك الدفاتر، وأتمتة الرد على استفسارات العملاء. مبنية حول متطلبات الهيئة الاتحادية للضرائب وبرامج المحاسبة التي تستخدمونها أصلاً.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_accounting_firms_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء مكاتب المحاسبة</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1707762890671-52ef6d6f51e7?w=1600&q=80&auto=format&fit=crop" alt="محلل مالي يراجع لوحة معلومات برسوم بيانية وأرقام" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٥٪", caption: "نسبة ضريبة القيمة المضافة في الإمارات على معظم السلع والخدمات الخاضعة للنسبة الأساسية" },
      { value: "٩٪", caption: "نسبة ضريبة الشركات الاتحادية في الإمارات على الأرباح الخاضعة للضريبة التي تتجاوز ٣٧٥ ألف درهم" },
      { value: "٤", caption: "مواعيد إقرارات ضريبة القيمة المضافة تتعامل معها معظم الشركات في الإمارات سنوياً" },
    ]} />
  </div>
</div>

<!-- WHY FIRMS ARE DROWNING -->
<section class="section" aria-labelledby="drowning-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="drowning-heading" style="margin-bottom:1.5rem;">لماذا تغرق مكاتب المحاسبة في نفس الأعمال الإدارية كل شهر</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>ملاحقة المستندات لا تتوقف أبداً.</strong> كل دورة مسك دفاتر لكل عميل تبدأ بنفس الطريقة: فواتير، وكشوف حسابات بنكية، وإيصالات، وسجلات رواتب يجب طلبها والتذكير بها ومتابعتها قبل أن يستطيع أحد بدء العمل الحقيقي. ضاعفوا ذلك بعدد العملاء فيصبح وظيفة كاملة بحد ذاتها، تستهلك الساعات التي يجب أن يقضيها المكتب في العمل الذي يدفع العملاء مقابله فعلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>مواعيد ضريبة القيمة المضافة وضريبة الشركات تتكرر كل ربع سنة، لكل عميل، وبجداول مختلفة.</strong> منذ أن انضمت ضريبة الشركات إلى ضريبة القيمة المضافة كالتزام دائم على الشركات في الإمارات، أصبحت المكاتب تتابع تقويمي إقرارات منفصلين لكامل قاعدة عملائها، لكل منهما تاريخ تسجيل وفترة إقرار خاصة. موعد واحد فائت ليس مجرد إزعاج، بل علاقة عميل وتعرّض لغرامة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>إدخال البيانات هو المكان الذي يختفي فيه وقت الموظفين المبتدئين.</strong> إعادة كتابة بنود الفواتير ومطابقة الحركات البنكية يدوياً هو بالضبط نوع العمل المتكرر القائم على القواعد الذي لا يحتاج شخصاً يؤديه يدوياً. يحتاج فقط أن يُبنى بشكل صحيح مع إبقاء مراجع بشري في الحلقة.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1573167507387-6b4b98cb7c13?w=800&q=80&auto=format&fit=crop" alt="فريق مكتب مالي في اجتماع لمراجعة مشروع" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- AI SYSTEMS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لمكاتب المحاسبة</h2>
      <p>ستة أنظمة مبنية لمكاتب المحاسبة في الإمارات، مربوطة بالبرامج التي تستخدمونها أصلاً ومبنية حول متطلبات الهيئة الاتحادية للضرائب.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">upload_file</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت جمع مستندات العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يطلب المستندات الشهرية المستحقة على كل عميل ويتتبعها ويلاحقها، عبر واتساب أو البريد الإلكتروني، دون أن يرسل موظف نفس التذكير يدوياً في كل دورة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل عميل يرى بالضبط ما هو متأخر عليه، تلقائياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متتبع مواعيد ضريبة القيمة المضافة وضريبة الشركات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع مواعيد إقرارات ضريبة القيمة المضافة وضريبة الشركات لكل عميل حسب تسجيله وفترة إقراره الخاصة، وينبّه إلى المستحق قبل الموعد بوقت كافٍ.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">لوحة واحدة لتقويم إقرارات كل العملاء، لا جدول بيانات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">receipt_long</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لإدخال بيانات مسك الدفاتر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج البنود من الفواتير والإيصالات ويرحّلها إلى دفتركم، فيراجع الموظفون القيود بدلاً من كتابة كل منها من الصفر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل كومة إيصالات إلى قيود مرحّلة في دقائق، لا ساعات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة لاستفسارات العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب فوراً عن أسئلة العملاء الشائعة حول حالة الإقرارات، والأرصدة المستحقة، ومتطلبات المستندات، ويحوّل أي شيء يحتاج إجابة حقيقية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل مكالمات الاستفسار الروتينية التي تقاطع العمل المدفوع</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد المطابقة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يطابق حركات الحساب البنكي مع القيود المرحّلة وينبّه إلى الاختلافات للمراجعة، بدلاً من أن يتصفح موظف بنداً بنداً في نهاية الشهر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُظهر الاستثناءات التي تحتاج فعلاً نظرة بشرية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إعداد التقارير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعدّ مسودات القوائم المالية وتقارير الإدارة من الدفتر المطابَق، جاهزة لمراجعة الشريك بدلاً من أن يجمعها موظف مبتدئ يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقارير قياسية تُصاغ في دقائق، ويراجعها شريك قبل إرسالها</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام يحترم ضوابط سرية العملاء لديكم ويُبقي خطوة مراجعة بشرية قبل تقديم أي إقرار.</p>
      <button onclick="openModal(this)" data-source="ar_accounting_firms_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء مكاتب المحاسبة</button>
    </div>
  </div>
</section>

<!-- MONTHLY CYCLE -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="cycle-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="cycle-heading">الدورة الشهرية لعميل واحد، من البداية إلى النهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يركز فريقكم على القرارات التقديرية، لا ملاحقة الأوراق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">جمع المستندات دون ملاحقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">كل شهر يبدأ بنفس قائمة الطلبات. الذكاء الاصطناعي يرسلها ويتابعها تلقائياً.</p>
        <ul class="journey-list">
          <li>يرسل لكل عميل قائمة بالمستحق عليه، مصممة حسب حسابه</li>
          <li>يتابع تلقائياً أي شيء ما زال ناقصاً بعد عدد محدد من الأيام</li>
          <li>يبلغ فريقكم لحظة اكتمال ملف العميل وجاهزيته للعمل</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مواعيد إقرارات لا تفوت أبداً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد اكتمال الملف، يبقي متتبع المواعيد الإقرار يسير وفق الجدول.</p>
        <ul class="journey-list">
          <li>ينبّه إلى مواعيد ضريبة القيمة المضافة وضريبة الشركات لكل عميل قبلها بوقت كافٍ</li>
          <li>يسند الإقرار إلى عضو الفريق المناسب تلقائياً</li>
          <li>يتأكد أن مراجعاً بشرياً وافق قبل وصول أي شيء إلى الهيئة الاتحادية للضرائب</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">أسئلة العملاء تُجاب قبل أن يتصلوا</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد بدء الإقرارات، معظم أسئلة العملاء تكون عن الحالة، لا الاستراتيجية.</p>
        <ul class="journey-list">
          <li>يجيب فوراً عن أسئلة حالة الإقرار والأرصدة المستحقة</li>
          <li>يرسل ملخصاً بلغة واضحة بمجرد تقديم الإقرار</li>
          <li>يصعّد أي شيء يحتاج تقدير الشريك، لا مجرد تحديث للحالة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
