---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل يتكامل هذا مع نظام CAFM أو CMMS الحالي لدينا؟", answer: "في معظم الحالات، نعم. يعمل الذكاء الاصطناعي بجانب نظام إدارة المرافق أو نظام إدارة الصيانة المحوسب لديكم بدلاً من استبداله، فيقرأ أوامر العمل ويكتب تحديثات الحالة عبر واجهة النظام البرمجية حيث توجد. وإذا لم توفر منصتكم واجهة برمجية قابلة للاستخدام، فسنخبركم بصراحة قبل البدء بدلاً من أن نعد بتكامل غير موجود فعلاً." },
  { question: "ما مدى دقة تتبع غرامات اتفاقيات مستوى الخدمة مقابل عقودنا الفعلية؟", answer: "بقدر دقة شروط اتفاقيات الخدمة التي نعمل عليها. نبني مهل الاستجابة والحل المحددة من عقود عملائكم الفعلية، لا من افتراضات عامة في القطاع، فينبّه النظام إلى خطر الإخلال بناءً على المهلة الحقيقية في عقدكم، لا على تقدير تقريبي." },
  { question: "هل يستطيع هذا التعامل مع تطبيق عبر عدة مواقع بفرق مختلفة؟", answer: "نعم، وهذه حالة الاستخدام الأكثر شيوعاً لا الاستثناء. يرى فريق كل موقع أوامر العمل والفنيين الخاصين به، بينما تحصل الإدارة على عرض مجمع لكل المواقع والعملاء. وتعدد المواقع هو حيث يثبت هذا النوع من الأنظمة قيمته أسرع، لأن منسقاً واحداً يحاول تتبع خمسة مواقع يدوياً هو بالضبط عنق الزجاجة الذي بُني النظام لإزالته." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات إدارة المرافق",
    "url": "https://lenooai.com/ar/industries/facilities-management",
    "description": "أنظمة ذكاء اصطناعي لشركات إدارة المرافق في الإمارات: فرز أوامر العمل، وتوزيع الفنيين، ومراقبة الالتزام باتفاقيات مستوى الخدمة، وجدولة الصيانة الوقائية.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي لإدارة المرافق"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "إدارة المرافق", "item": "https://lenooai.com/ar/industries/facilities-management" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات إدارة المرافق في الإمارات | Lenoo AI"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات إدارة المرافق في الإمارات: فرز أوامر العمل، وتوزيع الفنيين، ومراقبة الالتزام باتفاقيات مستوى الخدمة."
  canonicalPath="/ar/industries/facilities-management"
  enPath="/industries/facilities-management"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/industries" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>إدارة المرافق</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لإدارة المرافق في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات إدارة المرافق في الإمارات: فرز أوامر العمل، وتوزيع الفنيين، وتتبع الالتزام باتفاقيات مستوى الخدمة، وجدولة الصيانة الوقائية عبر مواقع وعملاء متعددين. ثنائية اللغة، ومصممة للهاتف أولاً، ومتكاملة مع نظام CAFM أو CMMS لديكم.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_facilities_management_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في إدارة المرافق</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="فني صيانة مرافق في الموقع" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "مواقع متعددة", caption: "معظم شركات إدارة المرافق تنسق الفنيين عبر عدة مواقع عملاء في آن واحد" },
      { value: "مقيد باتفاقية الخدمة", caption: "كل أمر عمل يسير مقابل مهلة الاستجابة في عقد العميل" },
      { value: "متنقل", caption: "قوة الفنيين العاملة في الميدان، لا على المكاتب" },
    ]} />
  </div>
</div>

<!-- WHY THIS FITS -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا التوزيع هو حيث تنزف شركات إدارة المرافق الوقت وغرامات اتفاقيات الخدمة</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>أمر العمل المرفوع ليس كأمر العمل المُنجز.</strong> بين إبلاغ مستأجر عن مكيف معطل ووصول الفني فعلاً، هناك منسق يقرأ الطلب يدوياً، ويبحث عن المتاح والأقرب، ويتصل به أو يراسله، بينما مهلة اتفاقية الخدمة للعميل تسير أصلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تلك الخطوة اليدوية الوسطى هي حيث تحدث التأخيرات والغرامات فعلاً.</strong> الفني ليس عنق الزجاجة بعد إرساله، بل الفجوة بين وصول الطلب وإسناده فعلاً إلى أحد. المنسق الذي يوازن بين عدة مواقع وعشرات الأوامر المفتوحة سيفوّت الأمر الأقرب إلى الإخلال باتفاقيته، لا لأنه مهمل، بل لأن لا شيء يرتب له الأولويات.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>الصيانة الوقائية تعاني المشكلة نفسها بحركة بطيئة.</strong> الصيانة المجدولة التي يجب أن تحدث بوتيرة ثابتة تُؤجل للتعامل مع الطلبات الطارئة، حتى تصبح الصيانة «الوقائية» مجرد صيانة «في وقت ما»، وتبدأ الأعطال التي كان يُفترض منعها بالحدوث على أي حال.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80&auto=format&fit=crop" alt="فني مرافق يجري أعمال صيانة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات إدارة المرافق</h2>
      <p>ستة أنظمة مبنية حول سرعة التوزيع والمساءلة في اتفاقيات الخدمة، كل منها متكامل مع نظام CAFM أو CMMS الحالي لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت استقبال أوامر العمل وفرزها</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسجل الطلبات الواردة من المستأجرين أو العملاء أو البلاغات الداخلية ويصنفها حسب الأولوية والتخصص تلقائياً، فلا يبقى شيء في صندوق وارد مشترك دون قراءة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">engineering</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد توزيع الفنيين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يطابق الفني المناسب مع العمل المناسب حسب المهارة والموقع وحجم العمل الحالي، ويرسل له تفاصيل العمل مباشرة، فيلغي خطوة سلسلة المكالمات اليدوية بالكامل.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">timer</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة الالتزام باتفاقيات مستوى الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع كل أمر عمل مفتوح مقابل مهلة الاستجابة والحل المتعاقد عليها، وينبّه إلى أي أمر يقترب من الإخلال قبل حدوثه فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات الحالة للعملاء والمستأجرين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تحديثات حالة تلقائية مع انتقال أمر العمل من التسجيل إلى الإسناد إلى الحل، فلا يتصل المستأجرون والعملاء فقط ليسألوا عما يحدث.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مجدول الصيانة الوقائية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبقي الصيانة المجدولة على وتيرتها الفعلية وينبّه حين تتكرر تأجيلات مهمة دورية، قبل أن تتعطل المعدات التي تحميها.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">groups</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت التنسيق مع الموردين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يدير الطلبات إلى الموردين المتخصصين الخارجيين، ويتتبع عروض الأسعار والموافقات والإنجاز، فلا يقع العمل المسند للغير خارج نظام التتبع الرئيسي.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">مبني للهاتف أولاً من أجل الفنيين الميدانيين، ومتكامل مع نظام CAFM أو CMMS الحالي لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_facilities_management_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في إدارة المرافق</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">أمر عمل واحد، من الرفع حتى الإغلاق</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركز فريقكم على العمل نفسه لا على التنسيق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">يُسجل ويُفرز تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مستأجر يبلّغ عن مشكلة أو عميل يرفع طلباً، فيسجله الذكاء الاصطناعي ويصنفه قبل أن يراه أي منسق.</p>
        <ul class="journey-list">
          <li>يلتقط الطلب عبر واتساب أو البريد الإلكتروني أو البوابة، أياً كانت القناة التي استخدمها العميل</li>
          <li>يصنفه حسب التخصص والأولوية تلقائياً</li>
          <li>يبدأ عدّاد اتفاقية الخدمة وفق شروط العقد الصحيحة فوراً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الفني يُرسل بتفاصيل العمل الصحيحة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بعد الفرز، يجد الذكاء الاصطناعي الفني المناسب ويرسل له كل ما يحتاجه للتحرك فوراً.</p>
        <ul class="journey-list">
          <li>يطابق حسب المهارة والقرب وحجم العمل الحالي</li>
          <li>يرسل تفاصيل العمل وتعليمات الدخول مباشرة إلى هاتف الفني</li>
          <li>يؤكد القبول والوصول، ويغلق الحلقة دون مكالمة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">اتفاقية الخدمة تُتتبع فلا يفلت شيء</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">يواصل النظام مراقبة المهلة حتى يُغلق العمل فعلاً، لا حتى يُسند فقط.</p>
        <ul class="journey-list">
          <li>ينبّه إلى أي عمل يقترب من موعد اتفاقيته قبل الإخلال</li>
          <li>يرسل للعميل تحديث الحالة عند الحل</li>
          <li>يسجل الجدول الزمني كاملاً لتقارير اتفاقية الخدمة الشهرية</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">low_priority</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز أوامر العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقليص الوقت بين وصول الطلب وإسناده إلى فني، وهو حيث يكمن معظم خطر الإخلال باتفاقيات الخدمة فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الالتزام باتفاقيات مستوى الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إظهار الأعمال المعرضة للخطر مبكراً بما يكفي للتصرف فعلاً، بدلاً من اكتشاف الإخلال بعد أن ينبّه إليه العميل.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_available</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">جدولة الصيانة الوقائية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إبقاء العمل المجدول على وتيرته الفعلية بدلاً من تأجيله الدائم بسبب الطلبات الطارئة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع CAFM وCMMS</h3>
