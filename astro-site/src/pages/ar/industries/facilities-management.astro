---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات إدارة المرافق في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/facilities-management",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "إدارة المرافق", "item": "https://lenooai.com/ar/industries/facilities-management" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات إدارة المرافق في الإمارات",
    "description": "فرز أوامر عمل، توزيع فنيين، متابعة امتثال اتفاقيات مستوى الخدمة، وجدولة صيانة وقائية لشركات إدارة المرافق في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يتكامل هذا مع نظام CAFM أو CMMS الحالي لدينا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "في معظم الحالات نعم. الذكاء الاصطناعي يعمل بجانب نظام إدارة المرافق بمساعدة الحاسوب لديكم بدل استبداله، يقرأ أوامر العمل ويكتب تحديثات الحالة عبر واجهة النظام حيث توجد. إن لم تُوفّر منصتكم واجهة قابلة للاستخدام، سنُخبركم بصراحة قبل البدء." }
      },
      {
        "@type": "Question",
        "name": "ما مدى دقة متابعة عقوبات اتفاقيات مستوى الخدمة مقابل عقودنا الفعلية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "بدقة شروط اتفاقية مستوى الخدمة المُزوَّدة لنا. نبني نوافذ الرد والحل الفعلية من عقود عملائكم الحقيقية، لا افتراضات صناعية عامة، فيُنبّه النظام بمخاطر الخرق حسب الساعة الفعلية التي يعمل بها عقدكم." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع هذا التعامل مع نشر عبر مواقع متعددة بفرق مختلفة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، هذا هو حالة الاستخدام الأكثر شيوعاً لا الاستثناء. فريق كل موقع يرى أوامر العمل والفنيين الخاصين به، بينما تحصل الإدارة على عرض مُجمَّع عبر كل موقع وعميل." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات إدارة المرافق في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أنظمة ذكاء اصطناعي لشركات إدارة المرافق في الإمارات: فرز أوامر عمل، توزيع فنيين، ومتابعة اتفاقيات مستوى الخدمة."
  canonicalPath="/ar/industries/facilities-management"
  enPath="/industries/facilities-management"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>إدارة المرافق</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">handyman</span>
      إدارة المرافق
    </div>
    <h1>ذكاء اصطناعي لشركات إدارة المرافق في الإمارات<br><span class="gradient-text">التوزيع هو حيث يُهدَر الوقت وتُدفع الغرامات</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      بين إبلاغ مستأجر عن عطل وسائق فني يصل فعلياً، هناك مُوزّع يقرأ الطلب يدوياً ويبحث عن الأقرب المتاح، بينما ساعة اتفاقية مستوى الخدمة تدور. نبني لك نظاماً يفرز أوامر العمل، يوزّع الفنيين تلقائياً، ويُنبّه قبل خرق أي اتفاقية.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_facilities_management_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1600&q=80&auto=format&fit=crop" alt="فني صيانة مرافق في الموقع" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">مواقع متعددة</p>
        <p class="stat-lbl">معظم شركات إدارة المرافق تُنسّق عبر عدة مواقع معاً</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">مقيّد باتفاقية</p>
        <p class="stat-lbl">كل أمر عمل يعمل وفق ساعة استجابة تعاقدية</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">ميداني</p>
        <p class="stat-lbl">القوى العاملة الفنية في الميدان، لا خلف مكتب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة إدارة المرافق</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية حول سرعة التوزيع ومساءلة اتفاقية مستوى الخدمة، متصلة بنظام CAFM/CMMS لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">assignment</span>
        <h3>بوت استقبال وفرز أوامر العمل</h3>
        <p style="color:#42474e;line-height:1.7;">يُسجّل الطلبات الواردة من المستأجرين أو العملاء ويُصنّفها حسب الأولوية والتخصص تلقائياً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">engineering</span>
        <h3>مساعد توزيع الفنيين</h3>
        <p style="color:#42474e;line-height:1.7;">يطابق الفني المناسب مع العمل المناسب حسب المهارة والموقع وحمل العمل الحالي، ويرسل التفاصيل مباشرة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">timer</span>
        <h3>متابعة امتثال اتفاقية مستوى الخدمة</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع كل أمر عمل مفتوح مقابل نافذة الرد والحل التعاقدية، ويُنبّه لأي شيء يقترب من الخرق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">notifications</span>
        <h3>تحديثات حالة للعملاء والمستأجرين</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تحديثات تلقائية مع تقدّم أمر العمل من التسجيل للإسناد للحل، فلا يتصل المستأجرون ليسألوا فقط.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_repeat</span>
        <h3>جدولة الصيانة الوقائية</h3>
        <p style="color:#42474e;line-height:1.7;">يُبقي الصيانة المجدولة على وتيرتها الفعلية ويُنبّه عند تأجيل مهمة متكررة، قبل فشل المعدات.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">groups</span>
        <h3>بوت تنسيق الموردين</h3>
        <p style="color:#42474e;line-height:1.7;">يُدير طلبات موردي التخصص من طرف ثالث، متابعاً عروض الأسعار والموافقات والإنجاز.</p>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من أمر عمل مُبلَّغ إلى إغلاقه</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركّز فريقك على العمل نفسه لا التنسيق.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تسجيل وفرز تلقائي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مستأجر يُبلغ عن مشكلة أو عميل يرفع طلباً. الذكاء الاصطناعي يُسجّله ويُصنّفه قبل أن يراه المُوزّع أصلاً.</p>
        <ul class="journey-list">
          <li>يلتقط الطلب عبر واتساب أو البريد أو البوابة، أياً كانت وسيلة العميل</li>
          <li>يُصنّفه حسب التخصص والأولوية تلقائياً</li>
          <li>يُشغّل ساعة اتفاقية مستوى الخدمة مقابل شروط العقد الصحيحة فوراً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">فني يُوزَّع بتفاصيل العمل الصحيحة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد الفرز، يجد الذكاء الاصطناعي الفني المناسب ويرسل له كل ما يحتاجه للتصرف فوراً.</p>
        <ul class="journey-list">
          <li>يطابق حسب المهارة والقرب وحمل العمل الحالي</li>
          <li>يرسل تفاصيل العمل وتعليمات الوصول مباشرة لهاتف الفني</li>
          <li>يؤكد القبول والوصول، مُغلقاً الحلقة دون مكالمة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">اتفاقية مستوى الخدمة تُتابَع دون تفلّت</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">النظام يستمر بمراقبة الساعة حتى إغلاق العمل فعلياً، لا مجرد إسناده.</p>
        <ul class="journey-list">
          <li>يُنبّه لأي عمل يقترب من موعد اتفاقيته قبل الخرق</li>
          <li>يرسل تحديث حالة للعميل بمجرد الحل</li>
          <li>يُسجّل الجدول الزمني الكامل لتقرير اتفاقية مستوى الخدمة الشهري</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">low_priority</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز أوامر العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقليص الوقت بين وصول طلب وإسناد فني، حيث تكمن معظم مخاطر اتفاقية مستوى الخدمة فعلياً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">verified</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">امتثال اتفاقية مستوى الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إظهار الأعمال المُهدَّدة مبكراً بما يكفي للتصرف، بدل معرفة الخرق بعد تنبيه العميل له.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_available</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">جدولة الصيانة الوقائية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إبقاء العمل المجدول على وتيرته الفعلية بدل تأجيله باستمرار بسبب الطلبات التفاعلية العاجلة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع CAFM/CMMS</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قراءة وكتابة أوامر العمل عبر منصتكم الحالية بدل أن يصبح نظاماً ثانياً منفصلاً يفحصه فريقكم بشكل مستقل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تواصل ميداني على الهاتف أولاً</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مبني للفنيين في الميدان على هواتفهم، لا موظفين خلف مكتب، لأن هذا مكان حدوث العمل فعلياً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تنسيق مواقع وعملاء متعددين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">التعامل مع عدة مواقع وعقود عملاء معاً دون خلط شروط اتفاقية أي عميل بأخرى.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">متابعة اتفاقية مستوى الخدمة لحظياً</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المتابعة مقابل الساعة الفعلية في عقد كل عميل، لا متوسط استجابة صناعي عام.</p>
      </div>
    </div>
  </div>
</section>

<!-- DATA -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1200&q=80&auto=format&fit=crop" alt="فريق إدارة مرافق ينسّق أعمال صيانة" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="research-panel">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">لا نملك مرجعاً منشوراً وموثَّقاً خاصاً بأوقات توزيع إدارة المرافق أو معدلات خرق اتفاقيات مستوى الخدمة في الإمارات نثق بذكره هنا. ما يُخبرنا به مشغّلو المرافق باستمرار هو أن الفجوة بين رفع أمر عمل وإسناد فني له، لا عمل الإصلاح نفسه، هي حيث تُكتسب عقوبات اتفاقية مستوى الخدمة غالباً، وهي الجزء من العملية الذي يستطيع نظام توزيع تقليصه أسرع.</p>
    </div>
  </div>
</section>

<!-- GUARANTEE -->
<section class="section" style="background:#e7eeff;padding:4rem 0;text-align:center;">
  <div class="container">
    <div class="guarantee-badge" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:18px;direction:ltr;" aria-hidden="true">shield</span>
      ضمان الاسترداد الكامل، الوحيد في الإمارات
    </div>
    <h2 style="margin-bottom:1rem;">إذا لم تكن راضياً، لا تدفع أي شيء.</h2>
    <p style="color:#42474e;max-width:560px;margin:0 auto 2rem;line-height:1.8;">نبني، تختبر، وإذا لم تكن راضياً تماماً نردّ ١٠٠٪ خلال ٣٠ يوماً من التسليم. بدون أسئلة.</p>
    <button onclick="openModal(this)" data-source="ar_facilities_management_guarantee" class="btn-primary">ابدأ بدون مخاطرة</button>
  </div>
</section>

<!-- FAQ -->
