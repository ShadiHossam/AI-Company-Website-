---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لمراكز صيانة السيارات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/auto-service",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "مراكز صيانة السيارات", "item": "https://lenooai.com/ar/industries/auto-service" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لمراكز صيانة السيارات في الإمارات",
    "description": "أنظمة ذكاء اصطناعي لمراكز الصيانة والكراجات في الإمارات: حجز المواعيد، تحديثات حالة السيارة، اعتماد عروض الأسعار عبر واتساب، وتوفر قطع الغيار.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يتصل مدقق توفر قطع الغيار بنظام المخزون الفعلي لدينا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، مبني ليقرأ مباشرة من نظام مخزون القطع أو إدارة الورشة لديكم، فيحصل العميل أو المستشار على إجابة حقيقية لا تخميناً. إذا لم تكن القطعة متوفرة، يتحقق من مدة التوريد من موردكم المعتاد إن كانت البيانات متاحة." }
      },
      {
        "@type": "Question",
        "name": "كيف تختلف إدارة حسابات الأسطول عن العميل العادي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "حسابات الأسطول والشركات لها مسار منفصل: عدة مركبات تحت حساب واحد، جدولة صيانة موحدة، وفوترة تطابق طريقة تفضيل مدير الأسطول، سواء لكل مركبة أو كشف شهري موحد. تحديثات الحالة تصل لمنسق واحد بدل ملاحقة كل سائق." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق رد العميل على اعتماد عرض السعر؟",
        "acceptedAnswer": { "@type": "Answer", "text": "النظام لا يغيّر وقت تشخيص فنييكم للسيارة، بل يغيّر سرعة وصول طلب الاعتماد للعميل وسرعة وصول رده للورشة. إرسال عرض السعر مع صور المشكلة عبر واتساب فور انتهاء التشخيص، بدل انتظار موعد مكالمة، هو ما يُختصر فيه معظم التأخير." }
      },
      {
        "@type": "Question",
        "name": "هل يحتاج العملاء لتثبيت تطبيق لتلقي تحديثات الحالة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "لا. كل شيء يعمل عبر واتساب، الموجود بالفعل على هاتف كل عميل تقريباً. لا تطبيق يُحمَّل ولا بوابة يُتذكر تسجيل دخولها، وهذا جزء من سبب ارتفاع معدلات الرد والاعتماد مقارنة بالبريد أو بوابة العملاء." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لمراكز صيانة السيارات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أنظمة ذكاء اصطناعي لمراكز صيانة السيارات في الإمارات: حجز مواعيد، تحديثات حالة، واعتماد عروض أسعار عبر واتساب. ضمان استرداد 100%."
  canonicalPath="/ar/industries/auto-service"
  enPath="/industries/auto-service"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>مراكز صيانة السيارات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">directions_car</span>
      مراكز صيانة السيارات
    </div>
    <h1>ذكاء اصطناعي لمراكز الصيانة في الإمارات<br><span class="gradient-text">السيارة لا تنتظر على الرافعة</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      كل مرحلة من مراحل الصيانة تعني مكالمة: الحجز، الاستفسار عن الحالة، اعتماد عرض سعر إضافي. نبني لمركزك بوتاً يحجز عبر واتساب، يرسل تحديثات الحالة تلقائياً، ويحصل على اعتماد عروض الأسعار خلال دقائق لا ساعات.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_auto_service_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1600&q=80&auto=format&fit=crop" alt="ورشة مركز صيانة سيارات في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 50%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة اعتماد أعلى عند الرد خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">+٢٠٠</p>
        <p class="stat-lbl">جنسية في الإمارات، أغلبها يفضّل واتساب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية للحجز والتحديثات والاعتمادات</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في مركز الصيانة</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة تُبقي هاتف الاستقبال هادئاً وتُبقي الرافعات تعمل.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_repeat</span>
        <h3>بوت حجز وتذكير بالمواعيد</h3>
        <p style="color:#42474e;line-height:1.7;">يتيح للعميل التحقق من التوفر وحجز موعد عبر واتساب، ويرسل تذكيراً قبل الموعد وعند اقتراب صيانة دورية.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">directions_car</span>
        <h3>مساعد تحديث حالة السيارة</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل للعميل تحديثاً كلما تقدمت السيارة في مراحل التشخيص والاعتماد والإصلاح، دون أن يحتاج للاتصال ليسأل.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">receipt_long</span>
        <h3>اعتماد عرض السعر عبر واتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل عرض السعر مع صور المشكلة فور انتهاء التشخيص، ويتيح الموافقة أو الرفض مباشرة داخل المحادثة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">inventory_2</span>
        <h3>مدقق توفر قطع الغيار</h3>
        <p style="color:#42474e;line-height:1.7;">يتحقق من مخزون القطع لحظياً ليحصل المستشار والعميل على إجابة دقيقة عن التوفر والمدة، لا تخميناً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">star</span>
        <h3>متابعة وطلب تقييم</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع بعد الاستلام للتأكد من رضا العميل، ويطلب تقييماً في لحظة أعلى رضا، يحمي تقييم مركزك على جوجل.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">local_shipping</span>
        <h3>منسق خدمة الأسطول (B2B)</h3>
        <p style="color:#42474e;line-height:1.7;">يدير الجدولة والتحديثات والفوترة لحسابات الأسطول عبر منسق واحد بدل مكالمات فردية لكل سائق.</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICE JOB JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="as-journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="as-journey-heading">من استلام السيارة إلى تسليمها</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركّز فنيوك على السيارة لا الهاتف.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز بدون مكالمة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">العميل يحتاج موعداً في أي وقت، دون انتظار رد الاستقبال.</p>
        <ul class="journey-list">
          <li>يتحقق من توفر الرافعة ويؤكد الموعد مباشرة عبر واتساب</li>
          <li>يجمع بيانات السيارة وسبب الزيارة قبل الاستلام</li>
          <li>يرسل تذكيراً قبل يوم من الموعد، فيقل عدد المواعيد الفائتة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديث الحالة قبل أن يسأل العميل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بينما السيارة على الرافعة، الذكاء الاصطناعي يُبقي العميل مطلعاً دون اتصال من الاستقبال.</p>
        <ul class="journey-list">
          <li>يؤكد الاستلام ويعطي تقديراً أولياً للوقت</li>
          <li>يرسل تحديثاً عند انتهاء التشخيص وبدء العمل</li>
          <li>يُبلغ العميل لحظة جهوزية السيارة للاستلام</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">اعتماد عرض السعر من رسالة واتساب</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إذا وجد الفني مشكلة إضافية، الذكاء الاصطناعي يُبقي السيارة تتحرك بدل الانتظار على الرافعة.</p>
        <ul class="journey-list">
          <li>يرسل عرض السعر مع صور المشكلة فور انتهاء التشخيص</li>
          <li>يتيح للعميل الموافقة أو الرفض مباشرة داخل المحادثة</li>
          <li>يُبلغ الفني لحظة وصول القرار، فلا تبقى الرافعة عاطلة</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الحجز والتذكيرات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الحجز هو أكثر مكالمة حجماً وأقلها تعقيداً يستقبلها الاستقبال، ما يجعله الأسهل لإخراجه من الهاتف كلياً. التذكيرات الآلية حسب المسافة المقطوعة وتاريخ الصيانة تُرجع العملاء استباقياً بدل انتظار تذكرهم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل حجز يُسجَّل، حتى خارج ساعات العمل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">directions_car</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحديثات الحالة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">حصة كبيرة من المكالمات الواردة لورشة نشطة هي عملاء يسألون أين وصلت سيارتهم. إرسال تحديثات استباقية في كل مرحلة يُزيل معظم هذا الحجم قبل أن يحدث.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تحديثات استباقية بدل مكالمة "هل السيارة جاهزة؟"</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">receipt_long</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">اعتماد عروض الأسعار</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الفجوة بين اكتشاف الفني للمشكلة وموافقة العميل على العمل الإضافي هي أكبر مضيعة لوقت الرافعة. تقليص هذه الفجوة من ساعات لدقائق هو أكبر تحسين إنتاجية تحققه معظم الورش.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">طلب الاعتماد يصل العميل لحظة انتهاء التشخيص</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع نظام إدارة الورشة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحجز وحالة العمل وعروض الأسعار تحتاج قراءة وكتابة مباشرة في النظام الذي يستخدمه مستشاروك وفنيوك بالفعل. أداة حجز منفصلة عن نظام الورشة تخلق نسخة ثانية من الجدول لا يثق بها أحد.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تحديثات بالصور والفيديو</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">عرض سعر مرفق بصورة القطعة التالفة يُعتمد أسرع ويُنازَع فيه أقل من رقم مجرد. تحديثات الحالة المرفقة بصورة السيارة تبني ثقة لا تبنيها رسالة نصية وحدها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">دعم متعدد اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قاعدة عملاء الورشة في الإمارات تمتد عبر جنسيات ولغات كثيرة. الحجز والتحديثات والاعتماد بالعربي والإنجليزي يغطي عملاء الورشة الفعليين أكثر بكثير من الإنجليزية وحدها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع حسابات الأسطول</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">حسابات الأسطول تحتاج جدولة وفوترة موحدة تصل لمنسق واحد، لا نفس المسار المبني لعميل فردي. معاملة الاثنين بنفس الطريقة يُزعج الحسابات التي تُولّد أكبر قدر من التكرار.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
