---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "بأي منصات إعلانات يتصل الذكاء الاصطناعي فعلاً؟", answer: "نبني على دوبيزل ويلا موتور، المنصتين اللتين تحملان معظم حركة إعلانات السيارات المستعملة والجديدة في الإمارات. عندما يصل عميل محتمل عبر أي منهما، يستقبله الذكاء الاصطناعي كما يستقبله فريق مبيعاتكم، ويرد ضمن نظام المراسلة في المنصة نفسها أو بالمتابعة عبر بيانات التواصل المقدمة." },
  { question: "ما مدى دقة التأهيل المسبق للتمويل فعلاً؟", answer: "الروبوت لا يوافق على التمويل، بل يفحص الأساسيات: نطاق الدخل، وحالة التوظيف، والالتزامات القائمة، والاحتمال العام لاجتياز المشتري فحص البنك أو جهة التمويل المعتاد. هذا يكفي ليعرف فريق مبيعاتكم هل يعطي العميل أولوية أم يعلّمه لمحادثة أطول. والموافقة النهائية دائماً لدى البنك أو شريك التمويل، لا لدى الذكاء الاصطناعي." },
  { question: "كم مرة تتحدث مزامنة المخزون؟", answer: "بأقرب ما يسمح به نظام إدارة الوكالة لديكم من الوقت الفعلي، وعادةً تتزامن مع كل تغيير: وحدة جديدة أُضيفت، أو تحديث سعر، أو سيارة بيعت وسُحبت من الإعلانات. الهدف ألا يُقال أبداً لعميل يسأل عن سيارة إنها متاحة وقد بيعت فعلاً ذلك الصباح." },
  { question: "هل يستطيع الذكاء الاصطناعي التعامل مع مشترٍ يتحدث الهندية أو الأردية فقط؟", answer: "نعم. الذكاء الاصطناعي مبني للتواصل بالعربية والإنجليزية والهندية والأردية، ويتنقل بينها حسب لغة كتابة العميل، دون أن يحتاج العميل لاختيار لغة أولاً. ونظراً لاتساع قاعدة المشترين في الإمارات، فهذه التغطية أهم هنا منها في معظم الأسواق الأخرى." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لوكالات السيارات في الإمارات",
    "url": "https://lenooai.com/ar/industries/car-dealerships",
    "description": "أنظمة ذكاء اصطناعي مخصصة لوكالات السيارات في الإمارات: روبوتات الرد على العملاء المحتملين من دوبيزل والمنصات، وجدولة تجارب القيادة عبر واتساب، وتقييم السيارات المستبدلة، والتأهيل المسبق للتمويل، وتذكيرات الصيانة.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي لوكالات السيارات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لوكالات السيارات", "item": "https://lenooai.com/ar/industries/car-dealerships" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لوكالات السيارات في الإمارات"
  description="ذكاء اصطناعي لوكالات السيارات في دبي: روبوتات الرد على العملاء المحتملين من دوبيزل والمنصات، وجدولة تجارب القيادة عبر واتساب، وتقييم السيارات المستبدلة، والتأهيل المسبق للتمويل."
  canonicalPath="/ar/industries/car-dealerships"
  enPath="/industries/car-dealerships"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكالات السيارات</div>
    <h1>الأتمتة بالذكاء الاصطناعي<br><span class="gradient-text">لوكالات السيارات</span> في الإمارات</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السيارات في الإمارات: الرد على العملاء المحتملين من المنصات، وجدولة تجارب القيادة عبر واتساب، وتقييم السيارات المستبدلة، والتأهيل المسبق للتمويل. مبنية لسوق يفوز فيه الرد الأول بالصفقة.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_car_dealerships_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في وكالتكم</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1542744173-05336fcc7ad4?w=1600&q=80&auto=format&fit=crop" alt="صالة عرض وكالة سيارات مع سيارات معروضة للبيع في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى للتحويل عند التواصل مع العميل المحتمل خلال ٥ دقائق مقابل ٣٠ (MIT)" },
      { value: "أقل من ساعة", caption: "المهلة التي يبرد بعدها عادةً العميل المحتمل القادم من دوبيزل أو المنصات" },
      { value: "٤", caption: "لغات تغطيها عادةً قاعدة مشتري وكالة سيارات في الإمارات: العربية والإنجليزية والهندية والأردية" },
    ]} />
  </div>
</div>

<!-- WHY THE FIRST REPLY DECIDES THE SALE -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا يحسم الرد الأول الصفقة</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>المشتري الذي يتصفح دوبيزل أو إعلانات المنصات ينظر إلى عدة وكلاء في آن واحد، لا إليكم فقط.</strong> في اللحظة التي يراسل فيها بشأن سيارة، يكون غالباً قد راسل اثنين أو ثلاثة آخرين أيضاً. من يرد أولاً بمعلومات حقيقية يكسب المحادثة، والبقية يتنافسون على عميل ذهب نصفه أصلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>وجدت أبحاث MIT حول سرعة الاستجابة أن التواصل مع العميل المحتمل خلال ٥ دقائق يجعل احتمال تحوله أعلى بنحو ٩ مرات من الانتظار ٣٠ دقيقة.</strong> هذه النتيجة لم تُبنَ على مبيعات السيارات تحديداً، لكنها تنطبق مباشرة على سلوك عملاء المنصات: سريعو الحركة، يقارنون الأسعار، ويختفون لحظة وصول رد أسرع من مكان آخر.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>فريق المبيعات البشري لا يستطيع تغطية كل ساعة قد يصل فيها عميل من المنصات.</strong> العميل الذي يصل في الحادية عشرة ليلاً أو أثناء صلاة الجمعة يبقى دون رد حتى يعود أحد إلى مكتبه، وبحلول ذلك يكون المشتري قد وجد سيارته عادةً. الذكاء الاصطناعي يسد هذه الفجوة دون إضافة وردية ليلية.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1502810190503-8303352d0dd1?w=800&q=80&auto=format&fit=crop" alt="مندوب مبيعات يعرض سيارة على عميل في صالة العرض" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لوكالات السيارات في الإمارات</h2>
      <p>ستة أنظمة محددة ننشرها لوكالات السيارات في الإمارات، كل منها متكامل مع نظام إدارة الوكالة والمنصات التي يأتي منها عملاؤكم فعلاً.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">directions_car</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الرد على عملاء دوبيزل والمنصات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرد على كل استفسار من المنصات خلال دقائق، ويجيب عن الأسئلة الأساسية حول السيارة، ويحجز مكالمة أو زيارة بينما لا يزال المشتري يقارن بين الوكلاء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الإجابات تصل والعميل لا يزال يقارن، لا بعد أن يقرر</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_available</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مجدول تجارب القيادة عبر واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحجز تجارب القيادة مباشرة على واتساب، ويتحقق من توفر السيارة والموظفين، ويرسل تذكيرات ليحضر أصحاب المواعيد المؤكدة فعلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">موعد مؤكد بدلاً من الأخذ والرد عبر الهاتف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">request_quote</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد تقييم السيارات المستبدلة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع تفاصيل السيارة المراد استبدالها وعدد الكيلومترات وحالتها عبر محادثة موجهة، ويعطي نطاق تقييم تقديرياً قبل أن يزور العميل أصلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقدير أولي قبل أن يلتزم المشتري بالزيارة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">account_balance</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت التأهيل المسبق للتمويل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يفحص المشترين حسب نطاق الدخل والتوظيف والالتزامات القائمة ليحدد من يُرجح تأهله للتمويل، فيعطي فريق مبيعاتكم الأولوية للعملاء القادرين على إتمام الصفقة فعلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">خطوة فحص لا موافقة نهائية، تتم قبل زيارة صالة العرض</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تذكير الصيانة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع فترات الصيانة ويرسل تذكيرات عبر واتساب عندما يحين موعد صيانة سيارة العميل، فيبقي إيراد مركز الصيانة مستمراً دون قائمة اتصالات يدوية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكيرات تلقائية بدلاً من جدول بيانات على أحدهم أن يتذكر مراجعته</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لمطابقة المخزون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يطابق ميزانية المشتري وتفضيلاته المعلنة مع المخزون الحي في معرضكم، ويقترح بدائل عندما لا يكون الإعلان الذي راسل بشأنه هو الأنسب.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُظهر السيارة المناسبة في المعرض، لا فقط التي ضغط عليها</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة متوافقة مع لوائح الإمارات، متعددة اللغات، ومتكاملة مع نظام إدارة الوكالة والمنصات التي يأتي منها عملاؤكم.</p>
      <button onclick="openModal(this)" data-source="ar_car_dealerships_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في وكالتكم</button>
    </div>
  </div>
</section>

<!-- LEAD JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">عميل محتمل واحد، من البداية حتى البيع</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول رسالة عبر المنصة حتى متابعة لا تستسلم بعد محاولة واحدة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">استفسار المنصة يُجاب في أقل من دقيقة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مشترٍ يراسل بشأن إعلان على دوبيزل في أي ساعة من اليوم.</p>
        <ul class="journey-list">
          <li>يرد فوراً بمواصفات السيارة وسعرها وتوفرها الحالي</li>
          <li>يطرح أسئلة التأهيل التي يطرحها مندوب المبيعات: الميزانية، والإطار الزمني، والاستبدال، والاهتمام بالتمويل</li>
          <li>يحوّل العميل الجاد إلى مندوب المبيعات المناسب بينما لا يزال المشتري متفاعلاً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تجربة القيادة تُحجز دون أخذ ورد</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد اهتمام المشتري، ينتقل الذكاء الاصطناعي مباشرة إلى حجز زيارة.</p>
        <ul class="journey-list">
          <li>يتحقق من توفر السيارة والموظفين ويقترح موعداً على واتساب</li>
          <li>يؤكد تفاصيل السيارة المراد استبدالها إن وُجدت، قبل الزيارة</li>
          <li>يرسل تذكيراً قبل الموعد لتتم الزيارة فعلاً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المتابعة التي لا تتوقف بعد رسالة واحدة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">المشتري الذي لا يحجز فوراً ليس عميلاً ميتاً، بل سلسلة متابعة.</p>
        <ul class="journey-list">
          <li>يرسل متابعات مدروسة التوقيت بمخزون مناسب بدلاً من رسالة واحدة ثم صمت</li>
          <li>ينبّه إلى العميل البارد فعلاً فيتوقف فريقكم عن ملاحقته يدوياً</li>
          <li>يبقي التأهيل المسبق للتمويل وتقييم الاستبدال مرفقين بالعميل لحين يكون جاهزاً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر لوكالات السيارات في الإمارات</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة الرد على العملاء المحتملين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تضع أبحاث MIT العملاء المحتملين الذين يُتواصل معهم خلال ٥ دقائق عند احتمال تحويل أعلى بنحو ٩ مرات من الذين يُتواصل معهم بعد ٣٠ دقيقة. وعلى منصة يراسل فيها المشتري عدة وكلاء في آن واحد، غالباً ما تحسم سرعة الرد وحدها من يفوز بالصفقة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">ردود فورية على مدار الساعة، لا خلال ساعات صالة العرض فقط</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">account_balance</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تأهيل الاستبدال والتمويل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">إنجاز تقدير الاستبدال وفحص التمويل قبل دخول المشتري يقصّر زيارة صالة العرض، ويتيح لموظفي المبيعات تركيز وقتهم على المشترين القريبين من القرار فعلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الفحص يتم قبل الزيارة، لا أثناءها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاحتفاظ بعملاء الصيانة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تذكيرات الصيانة التلقائية تبقي العملاء عائدين إلى مركز الصيانة لديكم بدلاً من ورشة خارجية، فتحمي مصدر إيراد يسهل فقدانه دون نظام متابعة منتظم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكير يُرسل تلقائياً، في كل مرة يحين فيها موعد صيانة</p>
      </div>
    </div>
  </div>
