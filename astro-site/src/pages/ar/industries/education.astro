---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل سيحل التصحيح بالذكاء الاصطناعي محل المعلمين في تقييم الأعمال؟", answer: "يتولى المرحلة الأولى في الأعمال الموضوعية وشبه المنظمة، فيصيغ الدرجات والملاحظات ليراجعها المعلم ويعدّلها. يبقى المعلمون المرجع النهائي للدرجات ولأي شيء يتطلب تقديراً لفهم الطالب." },
  { question: "هل بيانات الطلاب آمنة مع نظام ذكاء اصطناعي، خصوصاً للقاصرين؟", answer: "حماية بيانات الطلاب تُعامل كشرط أساسي، لا كميزة. نحدد نطاق كل نظام وفق سياسات البيانات في مؤسستكم ومتطلبات حماية البيانات في الإمارات قبل بناء أي شيء، ونقلل البيانات التي يحتاج الذكاء الاصطناعي رؤيتها فعلاً إلى الحد الأدنى." },
  { question: "هل يعمل روبوت محادثة القبول مع أولياء الأمور الناطقين بالعربية؟", answer: "نعم. مساعدو القبول واستفسارات أولياء الأمور يُبنون ويُختبرون بالعربية والإنجليزية، لأن مدارس وجامعات الإمارات تخدم عائلات تفضل إحدى اللغتين، وأحياناً داخل نفس الأسرة." },
  { question: "كم يستغرق إطلاق مساعد للقبول أو لاستفسارات أولياء الأمور؟", answer: "معظم روبوتات المحادثة للقبول أو الموجهة لأولياء الأمور تُطلق خلال ٣ إلى ٥ أسابيع. أما الأدوات التي تتكامل مع نظام معلومات الطلاب للتصحيح أو متابعة الحضور فتستغرق عادةً ٦ إلى ٨ أسابيع." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_education')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للمدارس والجامعات في الإمارات",
    "url": "https://lenooai.com/ar/industries/education",
    "description": "أنظمة ذكاء اصطناعي مخصصة لمدارس وجامعات الإمارات: روبوتات محادثة للقبول، ودعم التصحيح الآلي، وأدوات التعلم المخصص، وأتمتة المستندات الإدارية.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Education"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للتعليم", "item": "https://lenooai.com/ar/industries/education" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للمدارس والجامعات في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لمدارس وجامعات الإمارات: روبوتات محادثة للقبول، ودعم التصحيح، وأدوات التعلم المخصص."
  canonicalPath="/ar/industries/education"
  enPath="/industries/education"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التعليم</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لمدارس وجامعات الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لمدارس وجامعات الإمارات: روبوتات محادثة للقبول، ودعم التصحيح الآلي، وأدوات التعلم المخصص، وأتمتة المستندات الإدارية. ثنائية اللغة، ومبنية حول نظام معلومات الطلاب لديكم.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="ar_education_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التعليم</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
    <StatStrip stats={[
      { value: "+٨ ساعات", caption: "من العمل الإداري الأسبوعي يذكرها المعلمون عادةً" },
      { value: "٢٤/٧", caption: "رد على استفسارات القبول وأولياء الأمور عبر روبوت محادثة ثنائي اللغة" },
      { value: "عربي + إنجليزي", caption: "دعم كامل ثنائي اللغة مبني لمجتمعات المدارس والجامعات في الإمارات" },
    ]} />
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px;">
  <img src="https://images.unsplash.com/photo-1758270705290-62b6294dd044?w=1400&h=280&q=80&auto=format&fit=crop" alt="طلاب يستخدمون حواسيب محمولة معاً في فصل دراسي" loading="lazy" width="1400" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHY EDUCATION & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا التعليم من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>العمل الإداري يستهلك وقت التدريس.</strong> يذكر المعلمون باستمرار أنهم يقضون ساعات كثيرة أسبوعياً في التصحيح والجدولة والأوراق التي تسحب تركيزهم بعيداً عن التدريس الفعلي. أتمتة الأجزاء المتكررة تعيد ذلك الوقت.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>استفسارات القبول وأولياء الأمور تصل على مدار الساعة.</strong> أولياء الأمور الذين يبحثون عن مدارس أو جامعات يسألون في كل الأوقات، وغالباً بالعربية. روبوت محادثة ثنائي اللغة يلتقط ذلك الاهتمام فوراً بدلاً من خسارته بسبب رد بريد بطيء.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>كل طالب يتعلم بوتيرة مختلفة.</strong> أدوات التعلم التكيفي التي تعدّل الصعوبة والوتيرة لكل طالب أظهرت مكاسب قابلة للقياس في التفاعل والنتائج مقارنة بالتدريس الموحد للجميع.</p>
      </div>
      <div class="split-media" style="display:flex; align-items:stretch;">
        <div class="card" style="display:flex; flex-direction:column; justify-content:center; text-align:center; width:100%; padding:2.5rem;">
          <p class="stat-number" style="font-size:3rem; margin-bottom:0.75rem;">+٨ ساعات</p>
          <p style="color:#42474e; font-size:1rem; line-height:1.7;">من العمل الإداري الأسبوعي يذكرها المعلمون عادةً، ومعظمها قابل للأتمتة دون المساس بجودة التدريس.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لمدارس وجامعات الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي للمدارس والجامعات، مربوطة بنظام معلومات الطلاب لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة للقبول والتسجيل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب فوراً عن أسئلة العائلات المحتملة حول البرامج والرسوم والمواعيد النهائية، بالعربية والإنجليزية، ويوجّه الاستفسارات الجادة إلى موظفي القبول.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يلتقط الاهتمام لحظة حدوثه، ليلاً أو نهاراً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">family_restroom</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد استفسارات أولياء الأمور والطلاب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتولى الأسئلة الروتينية حول الجداول والرسوم وسياسات المدرسة، فيتفرغ موظفو الاستقبال للمسائل التي تحتاج شخصاً فعلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل حجم المكالمات والرسائل على مكتب الاستقبال بشكل كبير</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">grading</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد التصحيح والملاحظات الآلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ الدرجات والملاحظات المكتوبة على الواجبات الموضوعية وشبه المنظمة لمراجعة المعلم، فيختصر وقت التصحيح بشكل كبير.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">المعلمون يراجعون كل درجة ويعتمدونها قبل تسجيلها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">auto_stories</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توصيات مسارات التعلم المخصصة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يوصي بمواد التدريب والوتيرة حسب بيانات أداء كل طالب، فيدعم المعلمين بدلاً من أن يحل محل تخطيط الدروس.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتكيف مع الأداء الفعلي لكل طالب، لا مع منهج ثابت</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة المستندات الإدارية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعالج نماذج التسجيل وطلبات كشوف الدرجات وأوراق القيد تلقائياً، فيقل إدخال البيانات اليدوي على الموظفين الإداريين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يختصر وقت إنجاز طلبات المستندات الروتينية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">warning</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الحضور والإنذار المبكر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينبّه إلى أنماط الحضور والأداء التي تشير إلى أن طالباً معرض للتأخر، مبكراً بما يكفي ليتدخل الموظفون.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُظهر الطلاب المعرضين للخطر قبل أن تتفاقم المشكلات</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة مبنية مع خصوصية بيانات الطلاب كشرط أساسي، ثنائية اللغة، ومربوطة بأدواتكم الحالية.</p>
      <button onclick="openModal(this)" data-source="ar_education_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التعليم</button>
    </div>
  </div>
</section>

<!-- CLEARER PICTURE OF EVERY STUDENT -->
<section class="section" aria-labelledby="picture-heading">
  <div class="container">
    <div class="split-grid split-media-right">
      <div>
        <h2 id="picture-heading" style="margin-bottom:1.5rem;">صورة أوضح لكل طالب، دون أوراق إضافية</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>حالياً، تُبنى تلك الصورة يدوياً.</strong> يسحب المعلمون والإداريون بيانات الحضور والدرجات والتفاعل من أنظمة منفصلة لمعرفة وضع الطالب أو الفصل فعلاً، ثم يعيدون بناء ذلك الملخص مرة أخرى للتقرير التالي أو اجتماع أولياء الأمور.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">نظام ذكاء اصطناعي يعمل فوق نظام معلومات الطلاب لديكم يجمع تلك البيانات في شاشة واحدة يستطيع المعلم مراجعتها في دقائق، على جهاز لوحي أو حاسوب محمول، مع إظهار الطلاب الذين يحتاجون اهتماماً أولاً تلقائياً بدلاً من دفنهم في جدول بيانات.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1758685848174-e061c6486651?w=800&h=600&q=80&auto=format&fit=crop" alt="معلمة تراجع أعمال الطلاب على حاسوب محمول في الفصل" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في التعليم</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">auto_stories</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">منصات التعلم التكيفي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">المنصات التي تعدّل صعوبة المحتوى ووتيرته حسب أداء كل طالب أظهرت تحسناً قابلاً للقياس في التفاعل والنتائج عبر البرامج التجريبية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">جُرّبت على نطاق واسع في مؤسسات التعليم المدرسي والعالي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">grading</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التصحيح الآلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات التصحيح بالذكاء الاصطناعي تتولى التقييمات الموضوعية وشبه المنظمة على نطاق واسع، فيركز المعلمون وقت المراجعة على المقالات والأعمال المفتوحة التي تحتاج تقديراً أعمق.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يوفر ساعات تصحيح كثيرة لكل معلم أسبوعياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">school</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أنظمة التدريس الذكية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">المعلمون الافتراضيون بالذكاء الاصطناعي يقدمون دعماً فردياً عند الطلب خارج ساعات الدراسة، وهو مورد لم يكن كثير من الطلاب ليحصلوا عليه على نطاق واسع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">ينمو بسرعة في التعليم العالي والتحضير للاختبارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الأتمتة الإدارية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أتمتة معالجة القيد، وإصدار كشوف الدرجات، والجدولة تقلل العبء الإداري الذي ينافس التدريس على انتباه الموظفين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل إدخال البيانات اليدوي في مكاتب التسجيل والقبول</p>
      </div>
      <div class="card">
