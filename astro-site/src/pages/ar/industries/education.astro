    .education-toggle-btn.active { background:#006875; color:#fff; }
    .education-toggle-btn:focus-visible { outline:2px solid #006875; outline-offset:2px; }
</style>

<script>
  const educationToggleWrap = document.querySelector('.education-toggle');
  if (educationToggleWrap) {
    const btns = educationToggleWrap.querySelectorAll('.education-toggle-btn');
    const panels = document.querySelectorAll('[data-education-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-education-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-education-tier-panel') !== key; });
      });
    });
  }
</script>
