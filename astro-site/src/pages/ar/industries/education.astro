---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للمدارس والجامعات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/education",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "المدارس والجامعات", "item": "https://lenooai.com/ar/industries/education" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للمدارس والجامعات في الإمارات",
    "description": "بوت قبول وتسجيل، دعم تصحيح آلي، أدوات تعلّم شخصية، وأتمتة مستندات إدارية للمدارس والجامعات في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل سيحل التصحيح الآلي محل تصحيح المعلمين؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يتولى المرور الأول على الأعمال الموضوعية وشبه المنظمة، يُسوّد الدرجات والملاحظات ليراجعها المعلم ويُعدّلها. المعلمون يبقون السلطة النهائية على الدرجات وأي شيء يحتاج حكماً على فهم الطالب." }
      },
      {
        "@type": "Question",
        "name": "هل بيانات الطلاب آمنة مع نظام ذكاء اصطناعي، خاصة للقُصّر؟",
        "acceptedAnswer": { "@type": "Answer", "text": "حماية بيانات الطلاب متطلب صارم، لا ميزة إضافية. نُحدّد نطاق كل نظام حسب سياسات مؤسستكم ومتطلبات حماية البيانات في الإمارات قبل بناء أي شيء، ونُقلّل ما يحتاج الذكاء الاصطناعي رؤيته فعلياً." }
      },
      {
        "@type": "Question",
        "name": "هل يعمل بوت القبول لأولياء الأمور الناطقين بالعربية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم. مساعدو القبول واستفسارات أولياء الأمور مبنيون ومُختبَرون بالعربية والإنجليزية، لأن مدارس وجامعات الإمارات تخدم عائلات تفضّل إحدى اللغتين، أحياناً في نفس الأسرة." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق إطلاق مساعد قبول أو استفسارات أولياء أمور؟",
        "acceptedAnswer": { "@type": "Answer", "text": "معظم بوتات القبول أو استفسارات أولياء الأمور تنطلق خلال ٣ إلى ٥ أسابيع. الأدوات المتكاملة مع نظام معلومات الطلاب للتصحيح أو تتبع الحضور تستغرق عادة ٦ إلى ٨ أسابيع." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للمدارس والجامعات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت قبول وتصحيح آلي وأدوات تعلّم شخصية للمدارس والجامعات في الإمارات، بالعربي والإنجليزي."
  canonicalPath="/ar/industries/education"
  enPath="/industries/education"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>المدارس والجامعات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">school</span>
      المدارس والجامعات
    </div>
    <h1>ذكاء اصطناعي للمدارس والجامعات في الإمارات<br><span class="gradient-text">وقت أكثر للتعليم، وقت أقل للأوراق</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      المعلمون يقضون ساعات أسبوعياً في التصحيح والجدولة والأوراق. نبني لمؤسستك بوت قبول واستفسارات ثنائي اللغة، دعم تصحيح آلي، وأتمتة مستندات إدارية، تحترم خصوصية بيانات الطلاب من البداية.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_education_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1758270705290-62b6294dd044?w=1600&q=80&auto=format&fit=crop" alt="طلاب يستخدمون أجهزة حاسوب محمولة معاً في صف دراسي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">+٨ ساعات</p>
        <p class="stat-lbl">عمل إداري أسبوعياً يُبلغ عنه المعلمون عادة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">رد على استفسارات القبول وأولياء الأمور</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">لغتان</p>
        <p class="stat-lbl">عربي وإنجليزي في كل أداة نبنيها</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في مدرستك أو جامعتك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بنظام معلومات الطلاب لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">forum</span>
        <h3>بوت قبول وتسجيل</h3>
        <p style="color:#42474e;line-height:1.7;">يجيب فوراً عن أسئلة العائلات المحتملة حول البرامج والرسوم والمواعيد، بالعربي والإنجليزي.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">family_restroom</span>
        <h3>مساعد استفسارات أولياء الأمور والطلاب</h3>
        <p style="color:#42474e;line-height:1.7;">يتولى الأسئلة الروتينية عن الجداول والرسوم وسياسات المدرسة، ويُفرّغ موظفي الاستقبال للمسائل التي تحتاج فعلياً إنساناً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">grading</span>
        <h3>مساعد تصحيح وملاحظات آلي</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد الدرجات والملاحظات المكتوبة على الواجبات الموضوعية وشبه المنظمة لمراجعة المعلم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">auto_stories</span>
        <h3>توصيات مسار تعلّم شخصي</h3>
        <p style="color:#42474e;line-height:1.7;">يوصي بمواد تدريب ووتيرة بناءً على بيانات أداء كل طالب، داعماً المعلم لا بديلاً عن التخطيط.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">description</span>
        <h3>أتمتة مستندات إدارية</h3>
        <p style="color:#42474e;line-height:1.7;">يُعالج نماذج التسجيل وطلبات الشهادات وأوراق الالتحاق تلقائياً، مُقلّلاً الإدخال اليدوي.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">warning</span>
        <h3>تنبيه حضور وإنذار مبكر</h3>
        <p style="color:#42474e;line-height:1.7;">يُنبّه لأنماط حضور وأداء تُشير لخطر تراجع طالب، بوقت كافٍ لتدخّل الطاقم.</p>
      </div>
    </div>
  </div>
</section>

<!-- MANUAL VS AI -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="education-toggle-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="education-toggle-heading">الإدارة اليدوية مقابل الذكاء الاصطناعي</h2>
      <p>ما الذي يتغيّر في التصحيح والتسجيل والتقارير الإدارية حين يتولى الذكاء الاصطناعي المرور الأول.</p>
    </div>
    <div class="bento-grid" style="grid-template-columns:1fr 1fr; gap:1.5rem;">
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الإدارة اليدوية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">تصحيح كومة واجبات يدوياً يستغرق عادة عدة ساعات أسبوعياً، إضافة لوقت تجميع تقارير الحضور والتسجيل والأداء للإدارة. موسم التسجيل يُضيف نماذج وطلبات شهادات يُعالجها موظفو التسجيل ملفاً بملف.</p>
      </div>
      <div class="card">
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مع الذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">يُسوّد الذكاء الاصطناعي الدرجات والملاحظات على الأعمال الموضوعية خلال ثوانٍ، ليراجع المعلمون ويعتمدوا بدل البدء من صفحة فارغة. نماذج التسجيل تُقرأ وتُفحَص وتُوجَّه تلقائياً، وتقارير الإدارة تُسحب مباشرة من بيانات موجودة بالفعل في نظامكم.</p>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر في التعليم</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">auto_stories</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">منصات تعلّم متكيفة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">منصات تُعدّل صعوبة المحتوى ووتيرته حسب أداء كل طالب أظهرت تحسناً ملموساً في المشاركة والنتائج عبر برامج تجريبية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مُختبَرة على نطاق واسع عبر التعليم الأساسي والعالي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">grading</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التصحيح الآلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات التصحيح بالذكاء الاصطناعي تتولى التقييمات الموضوعية وشبه المنظمة على نطاق واسع، لتركّز المعلمون وقت مراجعتهم على المقالات والأعمال المفتوحة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُحرّر ساعات تصحيح معتبرة لكل معلم أسبوعياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">school</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أنظمة تدريس ذكية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">المدرّسون الذكاء الاصطناعي يوفّرون دعماً فردياً عند الطلب خارج ساعات الصف، مورد لا يستطيع كثير من الطلاب الوصول إليه على نطاق واسع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">ينمو بسرعة في التعليم العالي والتحضير للاختبارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الأتمتة الإدارية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">معالجة التسجيل وإصدار الشهادات وأتمتة الجدولة تُقلّل العبء الإداري الذي ينافس وقت التدريس على انتباه الطاقم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل الإدخال اليدوي عبر مكاتب التسجيل والقبول</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوتات دعم الطلاب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تتولى بوتات الدردشة أسئلة الخدمات الطلابية الروتينية على مدار الساعة، من مواعيد التسجيل لموارد الحرم الجامعي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">نشر أول شائع للجامعات التي تُجرّب الذكاء الاصطناعي</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">warning</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التدخل المبكر وتوقّع الاستبقاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تنبؤية تُنبّه لأنماط حضور ومشاركة مرتبطة بخطر التسرب، مانحة المرشدين الأكاديميين فرصة تدخل مبكر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تستخدمها الجامعات لتحسين معدلات استبقاء الطلاب</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعل ذكاء التعليم يعمل فعلياً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">سلامة تربوية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أداة التعلّم يجب أن تُبنى حول كيفية تعلّم الطلاب فعلياً، لا فقط ما هو ممكن تقنياً. نعمل مع فريقكم الأكاديمي لا حوله.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">خصوصية بيانات القُصّر</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">بيانات الطلاب، خاصة القُصّر منهم، تحتاج تعاملاً أكثر صرامة من بيانات الأعمال المعتادة. هذا يُشكّل بنية النظام من البداية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">دعم منهجي ثنائي اللغة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مؤسسات الإمارات تخدم مجتمعات عربية وإنجليزية معاً. الأدوات يجب أن تعمل بطلاقة في كلتا اللغتين، لا مجرد ترجمة سطحية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">قبول المعلمين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أداة تصحيح أو إدارية لا يثق بها المعلمون تُلتف حولها، لا تُتَبنّى. نُشرك طاقم التدريس في المراجعة منذ مرحلة التجربة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات حول الذكاء الاصطناعي في التعليم</h2>
    </div>
