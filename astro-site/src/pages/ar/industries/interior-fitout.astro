---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات التصميم الداخلي والتشطيب في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/interior-fitout",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "التصميم الداخلي والتشطيب", "item": "https://lenooai.com/ar/industries/interior-fitout" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات التصميم الداخلي والتشطيب في الإمارات",
    "description": "تأهيل عملاء محتملين، توليد عروض أسعار وجداول كميات، متابعة تعديلات العميل، وتقارير تقدم لشركات التصميم الداخلي والتشطيب في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "كيف يتابع الذكاء الاصطناعي تعديلات العميل دون فقدان نسخ سابقة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "كل طلب تعديل، سواء وصل كملاحظة صوتية واتساب أو بريد أو PDF مُعلَّم، يُسجَّل مقابل المشروع بختم زمني ومرتبطاً بالغرفة أو العنصر المحدد. لا شيء يُستبدَل بصمت؛ تستطيعون دائماً رؤية ما تغيّر ومتى ومن طلبه." }
      },
      {
        "@type": "Question",
        "name": "ما مدى دقة توليد جدول الكميات بمساعدة الذكاء الاصطناعي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "دقيق لتجميع جدول كميات أولي من قاعدة بيانات المواد والأسعار لديكم، وهو عادة الجزء البطيء والمتكرر من إعداد عرض السعر. ليس بديلاً عن اعتماد مساح كميات نهائي لأي شيء إنشائي مهم أو غير معتاد." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع عدة أطراف (عميل، مقاول، مورّد) الوصول لتحديثات المشروع عبر نفس النظام؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، بمستويات وصول مختلفة لكل طرف. العميل يرى تقدم مشروعه والتعديلات والجدول الزمني. المقاول يرى النطاق الفني وتعليمات الموقع ذات الصلة بتخصصه. المورّد يرى فقط تفاصيل الطلب التي تخصه." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للتصميم الداخلي والتشطيب في دبي | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أنظمة ذكاء اصطناعي لشركات التصميم الداخلي والتشطيب في الإمارات: تأهيل عملاء، توليد عروض وجداول كميات، ومتابعة تعديلات."
  canonicalPath="/ar/industries/interior-fitout"
  enPath="/industries/interior-fitout"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التصميم الداخلي والتشطيب</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">chair</span>
      التصميم الداخلي والتشطيب
    </div>
    <h1>ذكاء اصطناعي للتصميم الداخلي والتشطيب في دبي<br><span class="gradient-text">مشروع مرئي، كثير التعديلات، طويل الأمد</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      دورة مبيعات التشطيب تمتد أشهراً، ومعظم التواصل صور وملاحظات صوتية لا نص. نبني لك بوتاً يؤهّل الاستفسارات، يُسوّد عروض أسعار وجداول كميات، ويتابع كل تعديل عميل بختم زمني لا يضيع.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_interior_fitout_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1600&q=80&auto=format&fit=crop" alt="صالة عرض مشروع تصميم داخلي وتشطيب حديث" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">أشهر</p>
        <p class="stat-lbl">مدة دورة مبيعات تشطيب نموذجية من الاستفسار للعقد</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">مرئي</p>
        <p class="stat-lbl">معظم التواصل صور ولوحات إلهام ورسومات مُعلَّمة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">جولات كثيرة</p>
        <p class="stat-lbl">من التعديلات يمرّ بها مشروع نموذجي</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة التصميم الداخلي</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية لوتيرة وتفاصيل مشروع تشطيب، متصلة بأدواتكم الحالية.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">fact_check</span>
        <h3>تأهيل استفسارات وفحص ميزانية</h3>
        <p style="color:#42474e;line-height:1.7;">يفحص الاستفسارات الجديدة من حيث الميزانية والجدول الزمني والنطاق قبل حجز زيارة موقع.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">request_quote</span>
        <h3>مساعد توليد عروض وجداول كميات</h3>
        <p style="color:#42474e;line-height:1.7;">يُجمّع جدول كميات أولي من قاعدة بيانات المواد والأسعار لديكم، مُقلّصاً وقت الصياغة من ساعات لدقائق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">history</span>
        <h3>متتبع تعديلات العميل</h3>
        <p style="color:#42474e;line-height:1.7;">يُسجّل كل طلب تعديل مقابل الغرفة أو العنصر المحدد بختم زمني، فلا يضيع شيء في محادثة بريد.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">update</span>
        <h3>بوت تحديث الجدول الزمني للمشروع</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل للعملاء تحديثات تقدم مجدولة عن المعالم والجدول الزمني، فلا يتصلون بمدير المشروع أسبوعياً فقط ليسألوا.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">local_shipping</span>
        <h3>تنسيق الموردين</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع طلبات المواد ومدد التوريد وتأكيدات التسليم عبر موردين متعددين، مُنبّهاً لأي خطر تأخير.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">photo_camera</span>
        <h3>تقارير صور تقدم الموقع</h3>
        <p style="color:#42474e;line-height:1.7;">صور الموقع المُرسلة عبر واتساب تُنظَّم في سجل تقدم مُوجَّه للعميل تلقائياً، بلا كتابة يدوية إضافية.</p>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من استفسار إلى تسليم المشروع</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركّز مصمموكم على التصميم لا الإدارة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مؤهَّل قبل حجز زيارة موقع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">استفسار جديد يصل عبر الموقع أو واتساب في أي ساعة. الذكاء الاصطناعي يفحصه قبل إشغال تقويم مصمم.</p>
        <ul class="journey-list">
          <li>يسأل عن الميزانية والجدول الزمني والنطاق في محادثة طبيعية، لا نموذج جامد</li>
          <li>يُنبّه للاستفسارات التي لا تطابق حجم أو نوع مشروعكم المعتاد</li>
          <li>يحجز زيارة الموقع مباشرة في تقويم المصمم المناسب بمجرد التأهيل</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سجل تعديلات لا يضيع في البريد</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد بدء المشروع، التعديلات تصل باستمرار، وكل واحدة منها تُتابَع بدقة.</p>
        <ul class="journey-list">
          <li>يُسجّل كل طلب تغيير مقابل العنصر أو الغرفة المحددة</li>
          <li>يحتفظ بسجل نسخ واضح فلا يختلف أحد حول ما اعتُمِد فعلياً</li>
          <li>يُنبّه للتعديلات التي تؤثر على جدول الكميات فيبقى التسعير دقيقاً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديثات تقدم دون مكالمة موقع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مع تقدم المشروع بالتنفيذ، يبقى العميل مطلعاً دون حاجة لملاحقة أحد.</p>
        <ul class="journey-list">
          <li>يرسل تحديثات معالم بجدول محدد، لا فقط عند حدوث خطأ</li>
          <li>يحوّل صور الموقع لسجل تقدم منظم ومؤرَّخ</li>
          <li>يُنبّه لتأخيرات الموردين مبكراً بما يكفي لإدارة توقعات العميل</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">filter_alt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تأهيل العملاء المحتملين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">فحص الاستفسارات من حيث الميزانية وتناسب النطاق قبل إشغال وقت مصمم بزيارة موقع، فيبقى خط الأنابيب مليئاً بمشاريع تستحق المتابعة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">edit_note</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إدارة التعديلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">حفظ سجل نظيف ومحصّن من النزاع لكل طلب تغيير عبر مشروع قد يستمر أشهراً، ما يحمي علاقة العميل وهامشكم معاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">chat_bubble</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تواصل العملاء عبر مشاريع طويلة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تحديثات منتظمة واستباقية تُقلّل مكالمات "فقط أتحقق" التي تستهلك أسبوع مدير المشروع وتُبقي العملاء أكثر هدوءاً خلال بناء طويل.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع تواصل كثيف بالمرفقات المرئية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">القدرة على قبول وتنظيم والإشارة لصور ولوحات إلهام ورسومات مُعلَّمة، لا فقط رسائل نصية عادية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع أداة إدارة المشروع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الاتصال بأي نظام يتتبع فريقكم الجداول والمهام فيه بالفعل، بدل أن يصبح مصدر حقيقة ثانياً منفصلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تنسيق أطراف متعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إدارة تواصل العميل والمقاول والمورّد في نفس النظام دون أن يرى أي طرف أكثر مما يجب.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تتبع الجدول الزمني والمعالم</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">حفظ صورة دقيقة ومُحدَّثة لموقع المشروع مقابل جدوله المخطط، فتبقى التحديثات المُرسلة للعملاء حديثة دائماً.</p>
      </div>
    </div>
  </div>
</section>

<!-- DATA -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1200&q=80&auto=format&fit=crop" alt="مشروع تصميم داخلي وتشطيب مكتمل" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="research-panel">
      <p style="color:#42474e; font-size:0.9375rem; line-height:1.8;">لا نملك مرجعاً صناعياً منشوراً خاصاً بدورات تعديل التشطيب أو أوقات إنجاز جداول الكميات نثق بذكره هنا. ما نسمعه باستمرار من عملاء هذا القطاع نوعي لكنه حقيقي: نزاعات التعديلات وتأخيرات إنجاز العرض هما الشيئان الأكثر تكليفاً للوقت وثقة العميل في مشروع يُدار جيداً بخلاف ذلك، وكلاهما الجزء الذي يُتقن الذكاء الاصطناعي تحسينه.</p>
    </div>
  </div>
</section>

<!-- GUARANTEE -->
<section class="section" style="background:#e7eeff;padding:4rem 0;text-align:center;">
  <div class="container">
    <div class="guarantee-badge" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:18px;direction:ltr;" aria-hidden="true">shield</span>
      ضمان الاسترداد الكامل، الوحيد في الإمارات
    </div>
    <h2 style="margin-bottom:1rem;">إذا لم تكن راضياً، لا تدفع أي شيء.</h2>
    <p style="color:#42474e;max-width:560px;margin:0 auto 2rem;line-height:1.8;">نبني، تختبر، وإذا لم تكن راضياً تماماً نردّ ١٠٠٪ خلال ٣٠ يوماً من التسليم. بدون أسئلة.</p>
    <button onclick="openModal(this)" data-source="ar_interior_fitout_guarantee" class="btn-primary">ابدأ بدون مخاطرة</button>
  </div>
