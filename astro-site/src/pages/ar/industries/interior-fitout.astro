---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "كيف يتتبع الذكاء الاصطناعي تعديلات العملاء دون فقدان النسخ السابقة؟", answer: "كل طلب تعديل، سواء وصل كملاحظة صوتية على واتساب أو بريد إلكتروني أو ملف PDF عليه ملاحظات، يُسجل في المشروع مع ختم زمني ويُربط بالغرفة أو البند المحدد الذي يخصه. لا شيء يستبدل النسخة السابقة بصمت، وتستطيعون دائماً رؤية ما تغير ومتى ومن طلبه، وهذا مهم حين يصر عميل على أنه لم يوافق أبداً على تغيير موجود في سجل رسائله نفسه." },
  { question: "ما مدى دقة إعداد جدول الكميات بمساعدة الذكاء الاصطناعي؟", answer: "هو دقيق في تجميع جدول كميات أولي من قاعدة بيانات المنتجات والمواد لديكم، بالكميات والأسعار المعتادة والبنود الشائعة، وهذا عادةً الجزء البطيء والمتكرر من إعداد عرض السعر. لكنه ليس بديلاً عن الاعتماد النهائي من مهندس الكميات في أي شيء مهم إنشائياً أو بمواصفات غير معتادة. الذكاء الاصطناعي يسرّع المسودة، والإنسان يبقى من يراجع الرقم الذي يخرج." },
  { question: "هل يستطيع عدة أطراف (العميل، والمقاول، والمورد) الوصول إلى تحديثات المشروع عبر النظام نفسه؟", answer: "نعم، بمستويات وصول مختلفة لكل منهم. يرى العميل تقدم مشروعه وتعديلاته وجدوله الزمني. ويرى المقاول النطاق الفني وتعليمات الموقع المتعلقة بتخصصه. ويرى المورد تفاصيل الطلب التي تخصه فقط. لا أحد يرى أكثر مما يحتاج، وهذا يبقي النظام صالحاً للتنسيق دون أن يتحول إلى صداع في إدارة الصلاحيات." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات التصميم الداخلي والتشطيبات",
    "url": "https://lenooai.com/ar/industries/interior-fitout",
    "description": "أنظمة ذكاء اصطناعي لشركات التصميم الداخلي والتشطيبات في الإمارات: تأهيل العملاء المحتملين، وإعداد عروض الأسعار وجداول الكميات، وتتبع تعديلات العملاء، وتقارير التقدم.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للتصميم الداخلي والتشطيبات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "التصميم الداخلي والتشطيبات", "item": "https://lenooai.com/ar/industries/interior-fitout" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات التصميم الداخلي والتشطيبات في دبي"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات التصميم الداخلي والتشطيبات في الإمارات: تأهيل العملاء المحتملين، وإعداد عروض الأسعار وجداول الكميات، وتتبع التعديلات، وتقارير التقدم."
  canonicalPath="/ar/industries/interior-fitout"
  enPath="/industries/interior-fitout"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/industries" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التصميم الداخلي والتشطيبات</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">للتصميم الداخلي والتشطيبات في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات التصميم الداخلي والتشطيبات في الإمارات: تأهيل الاستفسارات، وإعداد عروض الأسعار وجداول الكميات، وتتبع التعديلات، وتحديثات العملاء عبر مشاريع طويلة يغلب عليها الطابع البصري. ثنائية اللغة، ومتوافقة مع لوائح الإمارات، ومتكاملة مع أدواتكم الحالية.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_interior_fitout_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في التصميم الداخلي والتشطيبات</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1600&q=80&auto=format&fit=crop" alt="صالة عرض حديثة لمشروع تصميم داخلي وتشطيبات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "أشهر", caption: "المدة المعتادة لدورة بيع التشطيبات من أول استفسار حتى توقيع العقد" },
      { value: "بصري", caption: "معظم التواصل صور ولوحات إلهام ومخططات عليها ملاحظات، لا نصوص" },
      { value: "كثيرة", caption: "جولات التعديل التي يمر بها مشروع سكني أو تجاري معتاد" },
    ]} />
  </div>
</div>

<!-- WHY THIS FITS -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا دورة البيع طويلة وبصرية وكثيرة التعديلات، وأين يناسب الذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>دورات بيع التشطيبات تمتد لأشهر لا لأيام.</strong> يتحول الاستفسار إلى زيارة موقع، ثم فكرة تصميمية، ثم عرض سعر، ثم عدة جولات تعديل، وأخيراً عقد موقّع، مع مئات القرارات الصغيرة على الطريق. وفقدان أثر أي منها يكلف مالاً حقيقياً حين يبدأ التنفيذ ويصر العميل على أنه طلب شيئاً مختلفاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم التواصل بصري لا مكتوب.</strong> العملاء يرسلون صوراً ملهمة، أو يضعون ملاحظات على المخططات بالقلم، أو يرسلون ملاحظة صوتية تصف تغييراً يريدونه. الأنظمة النصية فقط تفوّت معظم ما يحدث فعلاً في المشروع، لأن المعلومات المهمة نادراً ما تصل كتعليمات مكتوبة واضحة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>التسعير متكرر تحت سطح التخصيص.</strong> كل مشروع يبدو فريداً للعميل، لكن عملية التسعير وجدول الكميات الأساسية تعتمد على نفس المواد والأسعار والبنود في كل مرة. وهذا التكرار بالضبط ما يجيد الذكاء الاصطناعي تسريعه، دون أن تفقد تجربة العميل طابعها الخاص.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&q=80&auto=format&fit=crop" alt="مصممة داخلية تراجع المخططات والمواد مع عميل" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات التصميم الداخلي والتشطيبات</h2>
      <p>ستة أنظمة مبنية لوتيرة مشاريع التشطيبات وتفاصيلها، كل منها متكامل مع أدواتكم الحالية.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تأهيل الاستفسارات وفحص الميزانية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يفحص الاستفسارات الجديدة من حيث نطاق الميزانية والجدول الزمني والنطاق قبل حجز زيارة الموقع، فيذهب وقت فريق التصميم لديكم إلى المشاريع التي تناسب ما تقبلونه فعلاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">request_quote</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد إعداد عروض الأسعار وجداول الكميات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع جدول كميات أولياً من قاعدة بيانات المواد والأسعار لديكم، فيقلص وقت صياغة عرض السعر المعتاد من ساعات إلى دقائق، جاهزاً ليراجعه شخص ويعتمده.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">history</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متتبع تعديلات العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسجل كل طلب تعديل مقابل الغرفة أو البند المحدد الذي يخصه، مع ختم زمني، فلا يضيع شيء في سلسلة بريد ولا يُنسى بين زيارات الموقع.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">update</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تحديثات الجدول الزمني للمشروع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل للعملاء تحديثات تقدم مجدولة عن المراحل والجدول الزمني، فلا يتصلون بمدير المشروع أسبوعياً فقط ليسألوا في أي مرحلة وصل العمل.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">local_shipping</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التنسيق مع الموردين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع طلبات المواد ومدد التوريد وتأكيدات التسليم عبر موردين متعددين، وينبّه إلى أي شيء قد يؤخر جدول التركيب.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">photo_camera</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير التقدم بالصور من الموقع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">صور الموقع المرسلة عبر واتساب تُنظم تلقائياً في سجل تقدم موجه للعميل، فيبقى السجل كاملاً دون أن يكتبه مدير الموقع بشكل منفصل.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">ثنائي اللغة، ومتوافق مع لوائح الإمارات، ومتكامل مع أدوات إدارة المشاريع الحالية لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_interior_fitout_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في التصميم الداخلي والتشطيبات</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">مشروع واحد، من الاستفسار حتى التسليم</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة من مشروع التشطيب، بينما يركز مصمموكم على التصميم لا على الأعمال الإدارية.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">مؤهل قبل حجز زيارة الموقع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">يصل استفسار جديد عبر الموقع أو واتساب في أي ساعة، ويفحصه الذكاء الاصطناعي قبل أن يدخل في تقويم أي مصمم.</p>
        <ul class="journey-list">
          <li>يسأل عن نطاق الميزانية والجدول الزمني والنطاق في محادثة طبيعية، لا نموذج جامد</li>
          <li>ينبّه إلى الاستفسارات التي لا تناسب حجم أو نوع مشاريعكم المعتادة</li>
          <li>يحجز زيارة الموقع مباشرة في تقويم المصمم المناسب بعد التأهيل</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سجل تعديلات لا يضيع في البريد</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد بدء المشروع، تتوالى التعديلات باستمرار، وكل منها يُتتبع كما يجب.</p>
        <ul class="journey-list">
          <li>يسجل كل طلب تغيير مقابل البند أو الغرفة المحددة</li>
          <li>يحتفظ بسجل نسخ واضح فلا يختلف أحد على ما تمت الموافقة عليه فعلاً</li>
          <li>ينبّه إلى التعديلات التي تؤثر في جدول الكميات فيبقى التسعير دقيقاً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تحديثات التقدم تُرسل دون مكالمة من الموقع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مع تقدم المشروع في التنفيذ، يبقى العميل على اطلاع دون حاجة لملاحقة أحد.</p>
        <ul class="journey-list">
          <li>يرسل تحديثات المراحل وفق جدول محدد، لا فقط حين يحدث خطأ</li>
          <li>يحوّل صور الموقع إلى سجل تقدم منظم ومؤرخ</li>
          <li>ينبّه إلى تأخيرات الموردين مبكراً بما يكفي لإدارة توقعات العميل استباقياً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">filter_alt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تأهيل العملاء المحتملين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">فحص الاستفسارات من حيث ملاءمة الميزانية والنطاق قبل تخصيص وقت مصمم لزيارة موقع، فيبقى المسار ممتلئاً بمشاريع تستحق المتابعة.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">edit_note</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إدارة التعديلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الاحتفاظ بسجل واضح لا يقبل الجدل لكل طلب تغيير على مدى مشروع قد يستمر لأشهر، وهذا يحمي العلاقة مع العميل وهامشكم معاً.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat_bubble</span></div>
