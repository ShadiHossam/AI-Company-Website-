---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لمزودي خدمات تقنية المعلومات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/it-msp",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "مزودو خدمات تقنية المعلومات", "item": "https://lenooai.com/ar/industries/it-msp" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لمزودي خدمات تقنية المعلومات في الإمارات",
    "description": "فرز وتوجيه تذاكر، بوت دعم من المستوى الأول، متابعة اتفاقيات مستوى الخدمة، وأتمتة تقارير العملاء لمزودي خدمات إدارة تقنية المعلومات في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "مع أي منصات PSA/RMM يتكامل هذا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نتكامل مع منصات PSA وRMM الرئيسية التي يعمل عليها مزودو الخدمات، بما فيها ConnectWise وAutotask، نقرأ بيانات التذاكر والأصول وتغذيات التنبيهات مباشرة بدل تكرارها في نظام منفصل." }
      },
      {
        "@type": "Question",
        "name": "ما مدى دقة بوت المستوى الأول فعلياً، وماذا يحدث حين يخطئ؟",
        "acceptedAnswer": { "@type": "Answer", "text": "البوت يتولى المشاكل المعروفة والمتكررة من قاعدة معرفتكم: إعادة تعيين كلمة مرور، أخطاء تطبيقات شائعة، فحص اتصال. مبني ليُصعّد بدل التخمين حين يخرج الطلب عن نطاق ثقته، مع تسليم المحادثة كاملة لمهندس." }
      },
      {
        "@type": "Question",
        "name": "ندير عشرات بيئات العملاء، كيف يعمل الأمان متعدد المستأجرين؟",
        "acceptedAnswer": { "@type": "Answer", "text": "كل بيئة عميل معزولة تماماً: بيانات اعتماد منفصلة، وصول بيانات منفصل، لا رؤية عبر المستأجرين في طبقة الفرز أو البوت. هذا مبني في البنية منذ اليوم الأول." }
      },
      {
        "@type": "Question",
        "name": "هل سيحل هذا محل مهندسينا أم فقط يُغيّر ما يعملون عليه؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يُغيّر ما يعملون عليه. الذكاء الاصطناعي يستوعب الفرز والتوجيه وأسئلة المستوى الأول المتكررة التي تستهلك وقت المهندس دون حاجة لحكمه. المهندسون يقضون وقتاً أكثر بالعمل التقني الفعلي والتصعيدات." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لمزودي خدمات تقنية المعلومات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني فرز تذاكر وبوت دعم مستوى أول ومتابعة اتفاقيات مستوى الخدمة لمزودي خدمات إدارة تقنية المعلومات في الإمارات."
  canonicalPath="/ar/industries/it-msp"
  enPath="/industries/it-msp"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>مزودو خدمات تقنية المعلومات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">dns</span>
      مزودو خدمات تقنية المعلومات
    </div>
    <h1>ذكاء اصطناعي لمزودي خدمات تقنية المعلومات<br><span class="gradient-text">أنتم تبيعون الأتمتة، لكن نادراً ما تُطبّقونها على طابور تذاكركم</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      كل عميل جديد يزيد حجم التذاكر، لا عدد المهندسين تلقائياً. نبني لك ذكاء اصطناعي يفرز التذاكر ويوجّهها، يحل مشاكل المستوى الأول المعروفة، ويُنبّه لخطر خرق اتفاقية مستوى الخدمة قبل أن يسأل العميل.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_it_msp_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=1600&q=80&auto=format&fit=crop" alt="مهندس دعم تقني يراقب أنظمة على عدة شاشات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">فرز تلقائي</p>
        <p class="stat-lbl">كل تذكرة تُصنَّف وتُوجَّه قبل أن يفتحها مهندس</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية مستوى أول للمشاكل المعروفة والمتكررة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">معزول</p>
        <p class="stat-lbl">فصل بيانات لكل عميل عبر كل بيئة تديرونها</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركتك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بمنظومة PSA وRMM لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">low_priority</span>
        <h3>فرز وتوجيه أولوية التذاكر</h3>
        <p style="color:#42474e;line-height:1.7;">يقرأ التذاكر الواردة، يُصنّف الإلحاح والفئة، ويُوجّه للطابور أو المهندس المناسب تلقائياً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">smart_toy</span>
        <h3>بوت دعم مستوى أول</h3>
        <p style="color:#42474e;line-height:1.7;">يحل المشاكل المعروفة والمتكررة مباشرة من قاعدة معرفتكم، ويُصعّد بسياق كامل حين يخرج عن نطاق ثقته.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">notifications_active</span>
        <h3>متابعة وتنبيه اتفاقية مستوى الخدمة</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع كل تذكرة مفتوحة مقابل ساعتها التعاقدية، ويُنبّه لأي شيء يقترب من الخرق للمدير المناسب.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">summarize</span>
        <h3>أتمتة تقارير العملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يبني تقارير خدمة شهرية من بيانات PSA لديكم تلقائياً: تذاكر محلولة، أداء اتفاقية مستوى الخدمة، مشاكل متكررة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">badge</span>
        <h3>بوت سير الالتحاق والمغادرة</h3>
        <p style="color:#42474e;line-height:1.7;">يُشغّل قوائم تحقق موظف جديد ومغادر عبر بيئات العملاء تلقائياً: حسابات، صلاحيات، أجهزة، تراخيص.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">menu_book</span>
        <h3>مساعد قاعدة المعرفة</h3>
        <p style="color:#42474e;line-height:1.7;">يمنح المهندسين إجابات فورية من توثيقكم الداخلي والتذاكر المحلولة سابقاً.</p>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من تذكرة مُقدَّمة إلى محلولة</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، ليعمل المهندسون على المشكلة التقنية لا إدارة التذاكر حولها.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">فرز وتوجيه قبل لمسة بشرية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">تذكرة تصل من عميل، والذكاء الاصطناعي يُصنّفها بالفعل قبل فتح المُوزّع للطابور.</p>
        <ul class="journey-list">
          <li>الإلحاح والفئة يُعيَّنان تلقائياً حسب محتوى التذكرة</li>
          <li>تُوجَّه للطابور أو المهندس المناوب المناسب دون توزيع يدوي</li>
          <li>تُعلَّم كأولوية VIP أو تعاقدية تلقائياً حين يستحق العميل ذلك</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سؤال المستوى الأول يُحلّ دون مهندس</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إن كانت مشكلة معروفة ومتكررة، يتولاها البوت مباشرة من قاعدة المعرفة.</p>
        <ul class="journey-list">
          <li>خطوات الحل تُرسل فوراً، مطابقة لإصلاحاتكم الموثقة</li>
          <li>يُصعّد بسياق كامل لحظة خروج المشكلة عن نمط معروف</li>
          <li>التذكرة تُغلَق أو تُسلَّم لمهندس، لا تبقى غامضة بينهما</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">خرق اتفاقية مستوى الخدمة يُنبَّه له قبل ملاحظة العميل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">للتذاكر التي تحتاج وقتاً هندسياً فعلياً، ساعة اتفاقية مستوى الخدمة تُراقَب باستمرار.</p>
        <ul class="journey-list">
          <li>تنبيهات اقتراب الخرق تُرسل للمدير المسؤول، لا اكتشافها بعد الفوات</li>
          <li>مسار التصعيد يُفعَّل تلقائياً إن توقفت تذكرة قرب موعدها</li>
          <li>بيانات الحل تُغذّي تقرير العميل التالي مباشرة دون إدخال يدوي</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">low_priority</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز وتحويل التذاكر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوقت الذي يقضيه المهندسون بقراءة وتصنيف وتوجيه التذاكر قبل أي عمل تقني فعلي عبء صرف. أتمتة الفرز وتحويل حجم المستوى الأول المتكرر هو حيث يرى مزودو الخدمات أسرع وقت مُستعاد.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">امتثال اتفاقية مستوى الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">اتفاقية مستوى خدمة فائتة مشكلة ثقة عميل، لا مقياساً داخلياً فقط. المراقبة الآلية التي تُنبّه للخطر مبكراً تحمي العلاقة بطريقة لا يستطيعها تقرير شهري بعد الفوات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">التقارير الشهرية المبنية يدوياً من تصدير PSA تستهلك جزءاً ثابتاً من وقت مدير الحساب كل شهر. أتمتة هذا التقرير توفير وقت منخفض المخاطر يتراكم عبر كل عميل.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع PSA/RMM (ConnectWise، Autotask)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الفرز والتقارير جيدة بقدر بيانات التذاكر والأصول التي تستطيع قراءتها. اتصال حي بنظامكم، لا عملية تصدير يدوية، هو ما يُبقي النظام دقيقاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع بيئات عملاء متعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">كل عميل لديه اتفاقيات وجهات تصعيد وأنظمة مختلفة. الذكاء الاصطناعي يحتاج تطبيق القواعد الصحيحة لكل عميل تلقائياً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تأسيس تقني على قاعدة معرفة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">بوت المستوى الأول موثوق بقدر التوثيق وسجل التذاكر المحلولة التي يعتمد عليها. قاعدة معرفة رقيقة تعني تصعيدات أكثر لا أقل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">منطق تصعيد للمهندسين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">معرفة متى يجب التوقف والتسليم مهمة بقدر حل الحالات الروتينية. مسار التصعيد يحتاج حمل السياق الكامل، فلا يضطر مهندس لطلب تكرار الكلام.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1200&q=80&auto=format&fit=crop" alt="مهندسو تقنية معلومات يعملون في مركز عمليات شبكة" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.5rem; margin-bottom:4px;">فرز أولاً</p>
        <p style="color:#42474e; font-size:0.875rem;">كل تذكرة تُصنَّف وتُوجَّه قبل استلام المهندس لها</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.5rem; margin-bottom:4px;">فوات أقل</p>
