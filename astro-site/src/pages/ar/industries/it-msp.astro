---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "ما منصات PSA وRMM التي يتكامل معها هذا النظام؟", answer: "نتكامل مع منصات PSA وRMM الرئيسية التي يعمل عليها مزودو الخدمات المُدارة، ومنها ConnectWise وAutotask، فنقرأ بيانات التذاكر ومعلومات الأصول وتدفقات التنبيهات مباشرة بدلاً من تكرارها في نظام منفصل. إذا كنتم على منصة أقل شيوعاً، فسنفحص واجهتها البرمجية خلال مكالمة التقييم ونخبركم مسبقاً بما هو ممكن قبل تحديد أي نطاق." },
  { question: "ما مدى دقة روبوت الدعم من المستوى الأول فعلاً، وماذا يحدث عندما يخطئ؟", answer: "يتعامل الروبوت مع المشكلات المعروفة والمتكررة من قاعدة معارفكم: إعادة تعيين كلمات المرور، وأخطاء التطبيقات الشائعة، وفحوصات الاتصال. وهو مبني ليصعّد بدلاً من أن يخمّن عندما يقع الطلب خارج ما هو واثق منه، مع تسليم المحادثة كاملة إلى مهندس حتى لا يضيع شيء. الدقة في أنواع المشكلات المحددة نختبرها على بيانات تذاكركم السابقة قبل الإطلاق، لا نقدّرها تقديراً." },
  { question: "ندير عشرات بيئات العملاء، كيف يعمل الأمان متعدد المستأجرين؟", answer: "كل بيئة عميل تبقى معزولة بالكامل: بيانات دخول منفصلة، وصلاحيات وصول منفصلة للبيانات، ولا رؤية بين المستأجرين في طبقة الفرز أو الروبوت. هذه ممارسة معتادة لأي شيء يلمس البنية التحتية للعملاء، وهي مبنية في التصميم من اليوم الأول، لا مضافة بعد أن تنبّه إليها مراجعة أمنية." },
  { question: "هل سيحل هذا محل مهندسينا أم سيغير فقط ما يعملون عليه؟", answer: "يغير ما يعملون عليه. يتولى الذكاء الاصطناعي الفرز والتوجيه وأسئلة المستوى الأول المتكررة التي تستهلك وقت المهندسين دون أن تحتاج حكماً هندسياً. يقضي المهندسون وقتاً أطول في العمل التقني الفعلي والتصعيدات، ووقتاً أقل في إدارة التذاكر. ومزودو الخدمات الذين يحاولون استخدامه لتقليص الموظفين قبل إثبات سير العمل يرون فجوات التغطية أولاً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لمزودي خدمات تقنية المعلومات في الإمارات",
    "url": "https://lenooai.com/ar/industries/it-msp",
    "description": "أنظمة ذكاء اصطناعي لمزودي الخدمات المُدارة وخدمات تقنية المعلومات في الإمارات: فرز التذاكر وتوجيهها بالذكاء الاصطناعي، وروبوتات دعم المستوى الأول، ومراقبة اتفاقيات مستوى الخدمة، وأتمتة تقارير العملاء.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "الأتمتة بالذكاء الاصطناعي لمزودي خدمات تقنية المعلومات"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لمزودي خدمات تقنية المعلومات", "item": "https://lenooai.com/ar/industries/it-msp" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لمزودي خدمات تقنية المعلومات في الإمارات | Lenoo AI"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لمزودي الخدمات المُدارة وخدمات تقنية المعلومات في الإمارات: فرز التذاكر، وروبوتات دعم المستوى الأول، ومراقبة اتفاقيات مستوى الخدمة، وأتمتة تقارير العملاء."
  canonicalPath="/ar/industries/it-msp"
  enPath="/industries/it-msp"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>مزودو خدمات تقنية المعلومات</div>
    <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لمزودي خدمات تقنية المعلومات في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لمزودي الخدمات المُدارة وخدمات تقنية المعلومات في الإمارات: فرز التذاكر وتوجيهها، وروبوتات دعم المستوى الأول، ومراقبة اتفاقيات مستوى الخدمة، وتقارير العملاء. متكاملة مع PSA وRMM ومبنية للبيئات متعددة المستأجرين.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_it_msp_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لمزودي الخدمات</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1518186285589-2f7649de83e0?w=1600&q=80&auto=format&fit=crop" alt="مهندس دعم تقني يراقب الأنظمة على عدة شاشات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "فرز تلقائي", caption: "التذاكر تُوجَّه وتُرتَّب أولويتها قبل أن يفتحها مهندس" },
      { value: "24/7", caption: "تغطية المستوى الأول للمشكلات المعروفة والمتكررة" },
      { value: "معزول", caption: "فصل بيانات كل عميل عبر كل بيئة تديرونها" },
    ]} />
  </div>
</div>

<!-- WHY MSPs DON'T AUTOMATE THEMSELVES -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا يبيع مزودو الخدمات الأتمتة لكنهم نادراً ما يؤتمتون طابور تذاكرهم</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>كنتم مشغولين ببيع النتيجة للجميع.</strong> مزودو الخدمات المُدارة يعرضون على عملائهم الكفاءة والمراقبة والدعم الاستباقي باستمرار، ونادراً ما يوجهون نفس النظرة إلى مكتب الخدمة لديهم. طابور التذاكر الذي نما مع قائمة العملاء لا يزال غالباً يعمل بنفس عملية الفرز اليدوي منذ أن كان الفريق ثلاثة مهندسين.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>كل عميل جديد يضيف حجماً من التذاكر، لا مهندسين إضافيين تلقائياً.</strong> النمو لدى مزود الخدمات يعني بيئات أكثر للمراقبة، وتذاكر أكثر تتدفق، ونفس الفريق يحاول فرزها كلها يدوياً قبل لمس أي مشكلة تقنية. وعبء الفرز هذا يتضاعف أسرع مما يزيد عدد الموظفين عادةً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>الحل هو نفس ما تبيعونه.</strong> إذا كان فرز التذاكر وتخفيف المستوى الأول ومراقبة اتفاقيات الخدمة يستحق الأتمتة لعملائكم، فهو يستحقها لمكتب الخدمة لديكم أولاً. إنه نفس التصميم موجهاً إلى الداخل، وهو عادةً أسرع عائد على الاستثمار يراه مزود الخدمات من الذكاء الاصطناعي، لأنه يحل مشكلة تفهمونها بالتفصيل أصلاً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&q=80&auto=format&fit=crop" alt="مهندس تقنية معلومات يعالج طابور تذاكر الدعم على حاسوب محمول" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لمزودي خدمات تقنية المعلومات في الإمارات</h2>
      <p>ستة أنظمة محددة نشرناها لمزودي الخدمات المُدارة في أنحاء الإمارات، كل منها متصل بمنصات PSA وRMM لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">low_priority</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لفرز التذاكر وتوجيهها حسب الأولوية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقرأ التذاكر الواردة، ويصنف درجة الإلحاح والفئة، ويوجهها إلى الطابور أو المهندس المناسب تلقائياً، فلا تبقى تذكرة دون تعيين بينما يعالج المنسق التراكم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تُفرز وتُوجَّه قبل أن يفتح أي شخص التذكرة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">smart_toy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت دعم المستوى الأول</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحل المشكلات المعروفة والمتكررة (إعادة تعيين كلمات المرور، وأخطاء التطبيقات الشائعة، وفحوصات الاتصال) مباشرة من قاعدة معارفكم، ويصعّد بوضوح مع السياق كاملاً عندما تخرج الحالة عن نطاق ثقته.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يتولى الأسئلة التي يجيب عنها المهندسون بنفس الطريقة في كل مرة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة اتفاقيات مستوى الخدمة والتنبيه</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتابع كل تذكرة مفتوحة مقابل مهلة اتفاقية الخدمة الخاصة بها، وينبّه المدير المناسب إلى أي تذكرة تقترب من الإخلال قبل أن يضطر العميل للسؤال عن تذكرته.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">ينبّه إلى خطر الإخلال بينما لا يزال هناك وقت للتصرف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تقارير العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني تقارير الخدمة الشهرية من بيانات PSA لديكم تلقائياً: التذاكر المحلولة، وأداء اتفاقيات الخدمة، والمشكلات المتكررة، جاهزة للإرسال بدلاً من أن يجمعها مدير حساب يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مسحوبة مباشرة من PSA، لا يُعاد بناؤها يدوياً كل شهر</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت سير عمل التعيين وإنهاء الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينفذ قوائم التحقق التقنية للموظفين الجدد والمغادرين عبر بيئات العملاء تلقائياً: الحسابات، والصلاحيات، والأجهزة، والتراخيص، فلا يفوت شيء كما يحدث في القوائم اليدوية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تنفيذ ثابت لقوائم التحقق عبر كل بيئة عميل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">menu_book</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد قاعدة المعارف</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعطي المهندسين إجابات فورية مأخوذة من وثائقكم الداخلية والتذاكر المحلولة سابقاً، فلا يعيد المهندسون المبتدئون اختراع حل وثّقه مهندس أقدم قبل ستة أشهر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل التذاكر السابقة إلى معرفة حلول قابلة للبحث وإعادة الاستخدام</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">متكامل مع PSA وRMM، وآمن متعدد المستأجرين، ومبني لطريقة عمل مكتب الخدمة لديكم فعلاً.</p>
      <button onclick="openModal(this)" data-source="ar_it_msp_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لمزودي الخدمات</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">تذكرة واحدة، من الإرسال إلى الحل</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، فيعمل المهندسون على المشكلة التقنية، لا على الأعمال الإدارية حول التذكرة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تُفرز وتُوجَّه قبل أن يلمسها أي شخص</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">تصل تذكرة من عميل، والذكاء الاصطناعي يصنفها قبل أن يفتح المنسق الطابور.</p>
        <ul class="journey-list">
          <li>درجة الإلحاح والفئة تُحددان تلقائياً بناءً على محتوى التذكرة</li>
          <li>تُوجَّه إلى الطابور المناسب أو المهندس المناوب دون توزيع يدوي</li>
          <li>تُعلَّم كأولوية كبار العملاء أو أولوية تعاقدية تلقائياً عندما يستدعي العميل ذلك</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سؤال المستوى الأول يُحل دون مهندس</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إذا كانت مشكلة معروفة ومتكررة، يتولاها الروبوت مباشرة من قاعدة المعارف.</p>
        <ul class="journey-list">
          <li>خطوات الحل تُرسل فوراً، مطابقة للحلول الموثقة لديكم</li>
          <li>يصعّد مع السياق كاملاً لحظة خروج الحالة عن نمط معروف</li>
          <li>التذكرة تُغلق أو تُسلَّم لمهندس، ولا تبقى معلقة بين الحالتين</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">خطر الإخلال باتفاقية الخدمة يُنبَّه إليه قبل أن يلاحظ العميل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">للتذاكر التي تحتاج وقتاً هندسياً فعلياً، تُراقب مهلة اتفاقية الخدمة باستمرار.</p>
        <ul class="journey-list">
          <li>تنبيهات الاقتراب من الإخلال تُرسل للمدير المسؤول، لا تُكتشف بعد وقوعه</li>
          <li>مسار التصعيد يُفعَّل تلقائياً إذا تعثرت تذكرة قرب موعدها النهائي</li>
          <li>بيانات الحل تدخل مباشرة في تقرير العميل التالي دون إدخال يدوي</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">low_priority</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز التذاكر وتخفيف الضغط</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوقت الذي يقضيه المهندسون في قراءة التذاكر وتصنيفها وتوجيهها قبل أي عمل تقني فعلي هو عبء خالص. أتمتة الفرز وتخفيف حجم المستوى الأول المتكرر هو حيث يرى مزودو الخدمات أسرع استعادة للوقت وأكثرها قابلية للقياس.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الالتزام باتفاقيات مستوى الخدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الإخلال باتفاقية الخدمة مشكلة في ثقة العميل، لا مجرد مؤشر داخلي. المراقبة الآلية التي تنبّه إلى الخطر مبكراً، بينما لا يزال هناك وقت للتصرف، تحمي العلاقة بطريقة لا يستطيعها تقرير شهري بعد وقوع الأمر.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">تقارير الخدمة الشهرية المبنية يدوياً من ملفات PSA المصدّرة تستهلك جزءاً متوقعاً من وقت مديري الحسابات كل شهر. أتمتة هذه التقارير توفير للوقت منخفض المخاطر ومتكرر، يتراكم أثره عبر كل عميل في القائمة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع PSA وRMM (ConnectWise وAutotask وغيرها)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الفرز والتقارير جيدان بقدر بيانات التذاكر والأصول التي يستطيعان قراءتها. الاتصال الحي بمنصات PSA وRMM لديكم، لا عملية تصدير يدوية، هو ما يبقي النظام دقيقاً مع تحرك التذاكر.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع بيئات متعددة العملاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">لكل عميل اتفاقيات خدمة مختلفة، وجهات تصعيد مختلفة، وأنظمة مختلفة. يحتاج الذكاء الاصطناعي إلى تطبيق القواعد الصحيحة لكل عميل تلقائياً، لا معاملة كل تذكرة بنفس الطريقة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">الاستناد إلى قاعدة معارف تقنية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">روبوت المستوى الأول موثوق بقدر الوثائق وسجل التذاكر المحلولة الذي يستند إليه. قاعدة معارف ضعيفة أو قديمة تعني تصعيدات أكثر لا أقل، لذلك تحتاج إلى صيانة حقيقية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">منطق التصعيد إلى المهندسين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">معرفة متى يتوقف ويسلّم لا تقل أهمية عن حل الحالات الروتينية. مسار التصعيد يجب أن يحمل سياق التذكرة كاملاً، فلا يضطر المهندس أبداً إلى أن يطلب من العميل تكرار ما قاله.</p>
      </div>
    </div>
  </div>
</section>

