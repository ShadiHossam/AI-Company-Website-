---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { isReleased } from "../../../lib/arRollout";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "هل سيحل المحتوى المولَّد بالذكاء الاصطناعي محل فريق الإبداع والتسويق لدينا؟", answer: "لا. يتولى الذكاء الاصطناعي المسودة الأولى وأعمال الإنتاج المتكررة، مثل نسخ النصوص المتعددة، وتوليد الصور والفيديو، والجدولة، فيقضي فريقكم وقتاً أكثر في الاستراتيجية، والحكم على العلامة، والحملات التي تحتاج منظوراً بشرياً. كل ما يصل إلى العملاء يمر بمراجعة فريقكم قبل النشر." },
  { question: "هل يستطيع الذكاء الاصطناعي الحفاظ على ثبات صوت علامتنا عبر القنوات؟", answer: "نعم، إذا كان مدرَّباً على إرشادات علامتكم الفعلية، وحملاتكم السابقة، ونبرة تواصلكم، لا على قالب عام. نبني ملفاً لصوت العلامة في كل نظام محتوى وإبداع، فتبدو المخرجات كأنها منكم، لا بأسلوب الذكاء الاصطناعي الافتراضي." },
  { question: "هل يعمل هذا مع المحتوى التسويقي العربي، لا الإنجليزي فقط؟", answer: "نعم. كتابة المحتوى، ونصوص وسائل التواصل، والتعليق الصوتي، وتوطين الفيديو كلها تُختبر تحديداً من حيث جودة العربية، لا مجرد ترجمة من الإنجليزية. الجمهور الإماراتي يلاحظ الفرق بين نص عربي طبيعي وترجمة متكلفة." },
  { question: "بأي منها يجب أن نبدأ إذا كنا جدداً على الذكاء الاصطناعي في التسويق؟", answer: "معظم الفرق تحقق أسرع مكسب وأوضحه من كتابة المحتوى أو أتمتة وسائل التواصل، لأن المخرجات فورية وسهلة التقييم. أما تحسين محركات البحث والتحليلات فتأخذ وقتاً أطول لإظهار النتائج لأنها تعتمد على تراكم البيانات عبر أسابيع. سنوصي بنقطة بداية حسب المكان الذي يخسر فيه فريقكم أكبر قدر من الوقت اليوم." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_marketing')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لفرق التسويق في الإمارات",
    "url": "https://lenooai.com/ar/industries/marketing",
    "description": "أنظمة ذكاء اصطناعي مخصصة لفرق ووكالات التسويق في الإمارات: تحسين محركات البحث، ووسائل التواصل، وتوليد الصور والفيديو، وتوليد الصوت، والتسويق عبر البريد، وكتابة المحتوى، والتحليلات، والتسويق عبر المؤثرين، والإعلانات المدفوعة.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للتسويق", "item": "https://lenooai.com/ar/industries/marketing" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لفرق ووكالات التسويق في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لفرق التسويق في الإمارات: تحسين محركات البحث، ووسائل التواصل، وتوليد الصور والفيديو، وكتابة المحتوى، والتحليلات."
  canonicalPath="/ar/industries/marketing"
  enPath="/industries/marketing"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1758873268745-dd2cf0d677b5?w=1600&h=260&q=80&auto=format&fit=crop", alt: "فريق تسويق يراجع لوحة حملة معاً على حاسوب محمول", position: "center 40%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التسويق</div>
  <h1>ذكاء اصطناعي لفرق<br><span class="gradient-text">ووكالات التسويق في الإمارات</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة عبر كامل منظومة التسويق: تحسين محركات البحث، ووسائل التواصل، وتوليد الصور والفيديو، وتوليد الصوت، والبريد الإلكتروني، وكتابة المحتوى، والتحليلات، والتسويق عبر المؤثرين، والإعلانات المدفوعة. مبنية حول صوت علامتكم، لا قالب عام.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
    <button onclick="openModal(this)" data-source="ar_marketing_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التسويق</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>
  <StatStrip stats={[
    { value: "+٧٠٪", caption: "من المسوقين يستخدمون الذكاء الاصطناعي في عملهم اليومي (HubSpot)" },
    { value: "+١٢ ساعة", caption: "يوفرها المسوقون أسبوعياً باستخدام الذكاء الاصطناعي لإنتاج المحتوى (HubSpot)" },
    { value: "١٠", caption: "أنظمة ذكاء اصطناعي للتسويق نغطيها أدناه، لكل منها صفحة تفصيلية" },
  ]} />

</PageHero>

<!-- WHY MARKETING & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا التسويق من أعلى الوظائف تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>حجم الإنتاج انفجر، وعدد الموظفين لم يتغير.</strong> كل قناة، من تحسين محركات البحث إلى وسائل التواصل والبريد والإعلانات المدفوعة، تتوقع الآن تدفقاً مستمراً من محتوى جديد ومخصص. أدوات الإنتاج بالذكاء الاصطناعي تتيح لفريق صغير إنتاج الحجم الذي كان يتطلب فريقاً أكبر بكثير.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>البحث نفسه يتغير.</strong> نتائج البحث المدعومة بالذكاء الاصطناعي ومحركات الإجابة تعيد تشكيل طريقة عثور الناس على الشركات، أي أن استراتيجية تحسين محركات البحث يجب أن تأخذ الظهور في الذكاء الاصطناعي في الاعتبار، لا الترتيب التقليدي فقط.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>القياس يلحق أخيراً بالإنفاق.</strong> نماذج الإسناد والتوقع بالذكاء الاصطناعي تكشف أي الحملات تحقق الإيرادات فعلاً، فتنتقل الميزانية نحو ما ينجح بدلاً مما هو أسهل في القياس.</p>
      </div>
      <div class="split-media" style="display:flex; align-items:stretch;">
        <div class="card" style="display:flex; flex-direction:column; justify-content:center; text-align:center; width:100%; padding:2.5rem;">
          <p class="stat-number" style="font-size:3rem; margin-bottom:0.75rem;">+١٢ ساعة</p>
          <p style="color:#42474e; font-size:1rem; line-height:1.7;">يوفرها المسوقون أسبوعياً باستخدام الذكاء الاصطناعي لإنتاج المحتوى (HubSpot)، وقت يعود إلى الاستراتيجية وجودة الحملات.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لفرق التسويق في الإمارات</h2>
      <p>عشر قدرات ذكاء اصطناعي تبنيها وكالتنا في دبي لفرق ووكالات التسويق. لكل منها صفحة تفصيلية بحالات استخدام محددة ومعايير تقييم وبيانات.</p>
    </div>
    <div class="bento-grid bento-grid-4">
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-1" id="marketinghub-toggle-1">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">تحسين محركات البحث بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">بحث الكلمات المفتاحية، وتحسين المحتوى، والظهور في محركات إجابة الذكاء الاصطناعي.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-1" role="region" aria-labelledby="marketinghub-toggle-1" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">بحث الكلمات المفتاحية، وتحسين المحتوى، والتدقيق التقني، وتحسين محركات الإجابة للبحث المدعوم بالذكاء الاصطناعي.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">مبني حول طريقة بحث الناس اليوم فعلاً، لا الترتيب التقليدي فقط.</p>
          {isReleased('/ar/industries/marketing/seo') && <a href="/ar/industries/marketing/seo" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-2" id="marketinghub-toggle-2">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">share</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">وسائل التواصل بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">كتابة التعليقات، والجدولة، والرصد، وإدارة المجتمع.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-2" role="region" aria-labelledby="marketinghub-toggle-2" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">توليد التعليقات والمحتوى، وأتمتة الجدولة، ورصد وسائل التواصل، وإدارة المجتمع.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">مدرَّب على صوت علامتكم، مع خطوة مراجعة بشرية قبل نشر أي شيء.</p>
          {isReleased('/ar/industries/marketing/social-media') && <a href="/ar/industries/marketing/social-media" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-3" id="marketinghub-toggle-3">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">image</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">توليد الصور بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">صور المنتجات، والمواد الإعلانية، ورسومات وسائل التواصل على نطاق واسع.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-3" role="region" aria-labelledby="marketinghub-toggle-3" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">صور المنتجات، ونسخ متعددة من المواد الإعلانية، ورسومات وسائل التواصل، ومواد متوافقة مع العلامة.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">تُنتج في أيام بدلاً من أسابيع.</p>
          {isReleased('/ar/industries/marketing/image-generation') && <a href="/ar/industries/marketing/image-generation" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-4" id="marketinghub-toggle-4">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">movie</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">توليد الفيديو بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">إعلانات قصيرة، وعروض منتجات، ودبلجة بلغات متعددة.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-4" role="region" aria-labelledby="marketinghub-toggle-4" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">إعلانات قصيرة، وعروض منتجات، وشخصيات رقمية بالذكاء الاصطناعي، ودبلجة بلغات متعددة.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">تُنتج أسرع من دورة التصوير والمونتاج التقليدية.</p>
          {isReleased('/ar/industries/marketing/video-generation') && <a href="/ar/industries/marketing/video-generation" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-5" id="marketinghub-toggle-5">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">graphic_eq</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">توليد الصوت بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">تعليق صوتي للإعلانات، ومساعدون صوتيون للعلامة، ودبلجة متعددة اللغات.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-5" role="region" aria-labelledby="marketinghub-toggle-5" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">تعليق صوتي للإعلانات، ودبلجة متعددة اللغات، ومساعدون صوتيون للعلامة، وإنتاج إعلانات صوتية.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">مختبر تحديداً لنطق عربي طبيعي.</p>
          {isReleased('/ar/industries/marketing/voice-generation') && <a href="/ar/industries/marketing/voice-generation" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-6" id="marketinghub-toggle-6">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">mail</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">التسويق عبر البريد بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">نصوص مخصصة، وتحسين توقيت الإرسال، وحملات متسلسلة.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="marketinghub-card-panel" id="marketinghub-panel-6" role="region" aria-labelledby="marketinghub-toggle-6" hidden>
          <p style="color:#42474e; font-size:0.8125rem; line-height:1.65; margin-bottom:0.5rem;">توليد النصوص، وتحسين توقيت الإرسال، والتقسيم حسب السلوك، وحملات متسلسلة تلقائية.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875; margin-bottom:0.75rem;">مدرَّب على صوت علامتكم ومربوط ببيانات عملائكم الفعلية.</p>
          {isReleased('/ar/industries/marketing/email-marketing') && <a href="/ar/industries/marketing/email-marketing" class="learn-link">اعرفوا المزيد ←</a>}
        </div>
      </div>
      <div class="card" data-marketinghub-expand>
        <button type="button" class="marketinghub-card-toggle" aria-expanded="false" aria-controls="marketinghub-panel-7" id="marketinghub-toggle-7">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">edit_note</span></div>
            <h3 style="font-weight:700; font-size:1rem; color:#00253b; margin-bottom:0.35rem;">كتابة المحتوى بالذكاء الاصطناعي</h3>
            <p class="marketinghub-teaser">مقالات المدونة، ونصوص الإعلانات، وأوصاف المنتجات بصوت علامتكم.</p>
          </div>
          <span class="marketinghub-card-icon" aria-hidden="true">+</span>
