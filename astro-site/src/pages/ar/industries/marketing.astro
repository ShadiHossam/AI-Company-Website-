    <p style="font-size:.875rem; margin-top:1rem; color:#94a3b8;">مكالمة ٣٠ دقيقة · دون ضغط بيعي</p>
  </div>
</div>

</ArBaseLayout>

<style>
.icon-box { width:48px; height:48px; border-radius:14px; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; margin-bottom:1rem; flex-shrink:0; }
    .num-circle { width:48px; height:48px; border-radius:50%; background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.25); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:1.125rem; font-weight:800; color:#006875; }
    .research-panel { background:#fff; border:1px solid rgba(0,37,59,0.10); border-radius:20px; padding:2rem; margin-top:2rem; }
    .eval-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
    .learn-link { font-size:0.8125rem; font-weight:600; color:#006875; }
    @media(max-width:900px) { .eval-grid { grid-template-columns:1fr 1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr 1fr !important; } }
    @media(max-width:600px) { .eval-grid { grid-template-columns:1fr; } .ind-stats-grid, .ind-text-grid { grid-template-columns:1fr !important; } }
    .marketinghub-card-toggle { display:flex; justify-content:space-between; align-items:flex-start; width:100%; background:none; border:none; cursor:pointer; text-align:start; padding:0; gap:1rem; }
    .marketinghub-card-toggle h3 { margin:0 0 0.35rem; }
    .marketinghub-teaser { color:#42474e; font-size:0.8125rem; line-height:1.65; margin:0; }
    .marketinghub-card-icon { font-size:1.25rem; color:#006875; transition:transform 0.2s; flex-shrink:0; }
    .marketinghub-card-toggle[aria-expanded="true"] .marketinghub-card-icon { transform:rotate(45deg); }
    .marketinghub-card-toggle:focus-visible { outline:2px solid #006875; outline-offset:2px; }
    .marketinghub-card-panel { margin-top:0.75rem; }
</style>

<script>
  document.querySelectorAll('[data-marketinghub-expand]').forEach((card) => {
    const btn = card.querySelector('.marketinghub-card-toggle');
    const panel = card.querySelector('.marketinghub-card-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) (panel as HTMLElement).hidden = expanded;
    });
  });
</script>
