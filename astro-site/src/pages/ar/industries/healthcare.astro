---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "هل يستطيع الذكاء الاصطناعي أن يحل محل الأطباء أو التقدير السريري؟", answer: "لا، ولا نبنيه لذلك. كل نظام ننشره لعملائنا في الرعاية الصحية يدعم الكادر السريري بدلاً من اتخاذ قرارات التشخيص أو العلاج. يتولى الذكاء الاصطناعي الاستقبال، والجدولة، ومسودات التوثيق، والمعالجة الإدارية، ويراجع الطبيب ويعتمد أي شيء يمس رعاية المريض. الهدف إعادة الساعات لموظفيكم، لا استبدال تقديرهم." },
  { question: "كيف تتعاملون مع خصوصية بيانات المرضى والامتثال؟", answer: "تُعالج بيانات المرضى وفق متطلبات حماية البيانات في الإمارات (قانون حماية البيانات الشخصية)، ووفق معايير هيئة الصحة بدبي ودائرة الصحة في أبوظبي حيثما ينطبق ذلك. نحدد نطاق كل مشروع وفق وضع الامتثال القائم لديكم قبل بناء أي شيء، ونتجنب تخزين البيانات الصحية الحساسة في أنظمة غير مبنية لذلك. وإذا كانت عيادتكم تعمل وفق متطلبات ترخيص محددة، نصمم حولها من اليوم الأول." },
  { question: "هل يعمل الذكاء الاصطناعي بالعربية في الأدوات الموجهة للمرضى؟", answer: "نعم. مساعدو استقبال المرضى، وتذكيرات المواعيد، وروبوتات الأسئلة الشائعة تُدرَّب وتُختبر بالعربية والإنجليزية، لأن عيادات الإمارات تخدم مرضى باللغتين يومياً. ونختبر المصطلحات الطبية بالعربية تحديداً، لأن نماذج اللغة العربية العامة كثيراً ما تنتج صياغات متكلفة أو غير دقيقة للمصطلحات السريرية." },
  { question: "كم يستغرق نشر نظام ذكاء اصطناعي في عيادة أو مستشفى؟", answer: "معظم مساعدي استقبال المرضى أو الجدولة يُطلقون خلال ٣ إلى ٥ أسابيع. أما الأنظمة التي تمس التوثيق السريري أو الموافقات المسبقة من التأمين فتستغرق وقتاً أطول، عادةً ٦ إلى ١٠ أسابيع، لأنها تتطلب تكاملاً أعمق مع نظام إدارة العيادة واختباراً أدق قبل التشغيل." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_healthcare')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لمقدمي الرعاية الصحية في الإمارات",
    "url": "https://lenooai.com/ar/industries/healthcare",
    "description": "أنظمة ذكاء اصطناعي مخصصة لعيادات ومقدمي الرعاية الصحية في الإمارات: مساعدو استقبال المرضى، وأتمتة الموافقات المسبقة من التأمين، ودعم التوثيق السريري، وروبوتات محادثة ثنائية اللغة للمرضى.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Healthcare"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للرعاية الصحية", "item": "https://lenooai.com/ar/industries/healthcare" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لمقدمي الرعاية الصحية في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لعيادات ومقدمي الرعاية الصحية في الإمارات: مساعدو استقبال المرضى، وأتمتة التأمين."
  canonicalPath="/ar/industries/healthcare"
  enPath="/industries/healthcare"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1758691461957-13aff0c37c6f?w=1600&h=320&q=80&auto=format&fit=crop", alt: "طبيب يراجع صورة أشعة على جهاز لوحي في مكتب بالمستشفى", position: "center 35%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الرعاية الصحية</div>
  <h1>ذكاء اصطناعي لمقدمي<span class="h1-sep">: </span><br><span class="gradient-text">الرعاية الصحية في دبي</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لعيادات ومقدمي الرعاية الصحية في الإمارات: مساعدو استقبال المرضى، وأتمتة الموافقات المسبقة من التأمين، ودعم التوثيق السريري، وروبوتات محادثة ثنائية اللغة للمرضى. مبنية حول نظام إدارة العيادة لديكم، لا حول قالب عام.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
    <button onclick="openModal(this)" data-source="ar_healthcare_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الرعاية الصحية</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>
  <StatStrip stats={[
    { value: "١٥٠ مليار $", caption: "وفورات سنوية يمكن أن تحققها تطبيقات الذكاء الاصطناعي للرعاية الصحية الأمريكية بحلول ٢٠٢٦ (Accenture)" },
    { value: "٢:١", caption: "ساعات تُقضى في السجلات الطبية الإلكترونية والعمل المكتبي مقابل كل ساعة مع المرضى (Annals of Internal Medicine)" },
    { value: "٣٠٪", caption: "متوسط معدل عدم الحضور للمواعيد الخارجية دون تذكيرات آلية" },
  ]} />

</PageHero>

<!-- WHY HEALTHCARE & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الرعاية الصحية من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>العبء الإداري يزاحم رعاية المرضى.</strong> يقضي الأطباء ما يقارب ساعتين في التوثيق والعمل المكتبي مقابل كل ساعة مع المريض. وموظفو الاستقبال يقضون يومهم في الجدولة والتذكيرات وأوراق التأمين بدلاً من المرضى الواقفين أمامهم.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>عدم الحضور مكلف ويمكن تفاديه.</strong> معدلات عدم الحضور للمواعيد الخارجية تتراوح عادةً بين ١٥ و٣٠٪ دون أنظمة تذكير فعالة. مساعدو الجدولة بالذكاء الاصطناعي الذين يؤكدون ويذكّرون ويعيدون الجدولة تلقائياً يسدون معظم هذه الفجوة دون زيادة عدد الموظفين.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>أوراق التأمين تبطئ كل شيء.</strong> طلبات الموافقة المسبقة والمطالبات ووثائق الفوترة تتضمن استخراج بيانات متكرراً وقواعد خاصة بكل جهة دافعة. أتمتة الذكاء الاصطناعي تتولى الجزء المتكرر وتنبّه إلى الاستثناءات لمراجعة الموظفين، فتختصر المدة من أيام إلى ساعات.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&h=600&q=80&auto=format&fit=crop" alt="مكتب استقبال في مستشفى يسجل فيه المرضى وصولهم لمواعيدهم" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لعيادات ومقدمي الرعاية الصحية في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي للعيادات ومقدمي الرعاية الصحية، مربوطة بنظام إدارة العيادة لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد استقبال المرضى والجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يحجز المواعيد ويؤكدها ويعيد جدولتها عبر واتساب وموقعكم، بالعربية والإنجليزية. ويرسل التذكيرات تلقائياً فتبقى مواعيد فارغة أقل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يخفض مباشرة معدل عدم الحضور الذي يكلف العيادات أكبر قدر من الإيرادات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">دعم التوثيق السريري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ ملخصات زيارة منظمة من ملاحظات الاستشارة ليراجعها الطبيب ويعتمدها. يقلل الوقت المستهلك في الكتابة على السجل الطبي الإلكتروني بعد ساعات الدوام.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل مسودة يراجعها الطبيب المعالج ويعتمدها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة الموافقات المسبقة من التأمين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج بيانات المريض والإجراء، ويتحقق منها وفق متطلبات الجهة الدافعة، ويصيغ طلبات الموافقة المسبقة. يراجع الموظفون ويرسلون، لا يعيدون الكتابة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني حول صيغ الجهات الدافعة في الإمارات وقواعد التقديم لدى <a href="https://www.dha.gov.ae/" target="_blank" rel="noopener">هيئة الصحة بدبي</a> و<a href="https://www.doh.gov.ae/ar/" target="_blank" rel="noopener">دائرة الصحة في أبوظبي</a></p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة للأسئلة الشائعة وما قبل الزيارة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن الأسئلة الشائعة حول ساعات العمل والتحضير والتغطية التأمينية، ويجمع معلومات ما قبل الزيارة. ويصعّد أي أمر عاجل مباشرة إلى الموظفين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">قواعد تحويل واضحة فلا ينتظر أي أمر عاجل على روبوت</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">receipt_long</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">معالجة مستندات المطالبات والفوترة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج البيانات من الفواتير ونماذج المطالبات، ويتحقق منها وفق قواعد الجهة الدافعة، وينبّه إلى الأخطاء قبل التقديم، فتقل المطالبات المرفوضة وإعادة العمل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مطالبات مرفوضة أقل تعني دورات تعويض أسرع</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">schedule_send</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة الاستدعاء والمتابعة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكيرات تلقائية لزيارات المتابعة، ومراجعات الرعاية المزمنة، وجداول التطعيم، فلا يضيع المرضى بين الزيارات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي مرضى الرعاية المزمنة على جدولهم دون متابعة يدوية</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة مبنية بمراجعة بشرية لأي شيء سريري، ومتوافقة مع أنظمة الإمارات، وثنائية اللغة، ومربوطة بأدواتكم الحالية.</p>
      <button onclick="openModal(this)" data-source="ar_healthcare_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الرعاية الصحية</button>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في الرعاية الصحية</h2>
    </div>
    <div class="healthcare-tabs" role="tablist" aria-label="فئات التطبيقات">
      <button type="button" id="healthcare-tab-clinical" class="healthcare-tab-btn active" data-healthcare-tab="clinical" role="tab" aria-selected="true" aria-controls="healthcare-panel-clinical">سريرية</button>
      <button type="button" id="healthcare-tab-administrative" class="healthcare-tab-btn" data-healthcare-tab="administrative" role="tab" aria-selected="false" aria-controls="healthcare-panel-administrative">إدارية</button>
    </div>
    <div class="bento-grid bento-grid-3" id="healthcare-panel-clinical" data-healthcare-tab-panel="clinical" role="tabpanel" aria-labelledby="healthcare-tab-clinical">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitor_heart</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التصوير الطبي والتشخيص</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أجازت إدارة الغذاء والدواء الأمريكية مئات الأجهزة الطبية المدعومة بالذكاء الاصطناعي وتعلم الآلة، يتركز معظمها في الأشعة، حيث تساعد النماذج في رصد النتائج وترتيب أولوياتها للمراجعة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">حصة متزايدة من أجهزة الذكاء الاصطناعي المجازة تدعم التصوير التشخيصي (FDA)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">warning</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقييم المخاطر التنبؤي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تستخدم أنظمة المستشفيات نماذج تنبؤية لخطر إعادة الدخول والإنذار المبكر بتدهور الحالة، فتنبّه إلى المرضى المعرضين للخطر لمراقبة أدق قبل حدوث أزمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">نماذج الإنذار المبكر أصبحت معتادة في كثير من وحدات العناية المركزة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة المرضى عن بُعد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الأجهزة القابلة للارتداء والأجهزة المتصلة تغذي نماذج بيانات مستمرة تنبّه إلى الاتجاهات غير الطبيعية لمرضى الأمراض المزمنة بين الزيارات الحضورية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تدعم إدارة استباقية للرعاية المزمنة خارج العيادة</p>
      </div>
    </div>
    <div class="bento-grid bento-grid-3" id="healthcare-panel-administrative" data-healthcare-tab-panel="administrative" role="tabpanel" aria-labelledby="healthcare-tab-administrative" hidden>
      <div class="card">
