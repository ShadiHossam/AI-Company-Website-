---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل يتكامل هذا مع نظام الأسطول أو التوجيه الحالي لدينا؟", answer: "نعم، وهذه نقطة البداية. نتصل بأي أداة تستخدمونها حالياً في التوزيع، سواء كانت نظام إدارة نقل، أو أداة توزيع مبنية خصيصاً، أو جداول بيانات مع تطبيق للسائقين. يقرأ الذكاء الاصطناعي الحالة الحية من نظام التوجيه ويكتب التحديثات فيه، فيرى المنسقون صورة واحدة بدلاً من مراجعة نظامين. إذا كانت منصة التوجيه لديكم توفر واجهة برمجية فسنستخدمها، وإن لم تكن كذلك فسنخبركم بذلك مسبقاً قبل تحديد أي نطاق." },
  { question: "هل يتحمل ارتفاع الحجم في مواسم التخفيضات وفترات التسوق المزدحمة؟", answer: "هذا بالضبط حين يثبت قيمته. تحديثات الحالة وإعادة الجدولة عبر واتساب تتعامل مع المحادثات المتزامنة دون طابور انتظار، فلا يتحول ارتفاع الطلبات في الجمعة البيضاء أو ١١.١١ أو عروض التاجر السريعة إلى تراكم في الدعم. العبء الذي كان يتطلب موظفي مركز اتصال مؤقتين يتحمله الذكاء الاصطناعي، مع تحويل الحالات الغامضة فعلاً إلى موظف." },
  { question: "ما مدى تفصيل تقارير التجار؟", answer: "بالقدر الذي يحتاجه التاجر. معظم العملاء يريدون على الأقل حالة كل طلب، وأسباب فشل التوصيل، ووقت الحل. وبعضهم يريدها مقسمة حسب السائق أو المنطقة أو نمط أوقات اليوم. نبني لوحة المتابعة حول ما يطلبه تجاركم فعلاً من مديري الحسابات، لا حول قالب عام، وتتحدث من نفس البيانات الحية التي تغذي روبوت العملاء." },
  { question: "هل يعمل روبوت واتساب مع السائقين الذين لا يتحدثون الإنجليزية؟", answer: "نعم. التنسيق مع السائقين وتحديثات الحالة للعملاء يعملان بالعربية والإنجليزية والأردية ولغات أخرى شائعة في أساطيل التوصيل في الإمارات. يرى العميل الرسائل باللغة التي راسل بها أول مرة، ويمكن إرسال تعليمات التوزيع للسائقين بلغتهم المفضلة أيضاً." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات توصيل الميل الأخير في الإمارات",
    "url": "https://lenooai.com/ar/industries/last-mile-delivery",
    "description": "أنظمة ذكاء اصطناعي لشركات توصيل الميل الأخير في الإمارات: روبوتات حالة التوصيل ووقت الوصول عبر واتساب، وإعادة جدولة التوصيل الفاشل، وتنسيق توزيع السائقين، وتأكيد الدفع عند الاستلام.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "الأتمتة بالذكاء الاصطناعي لتوصيل الميل الأخير"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لتوصيل الميل الأخير", "item": "https://lenooai.com/ar/industries/last-mile-delivery" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لشركات توصيل الميل الأخير في الإمارات"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لشركات توصيل الميل الأخير في الإمارات: روبوتات الحالة عبر واتساب، وإعادة جدولة التوصيل الفاشل، وتوزيع السائقين، وتأكيد الدفع عند الاستلام."
  canonicalPath="/ar/industries/last-mile-delivery"
  enPath="/industries/last-mile-delivery"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>توصيل الميل الأخير</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لتوصيل الميل الأخير في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي تعتمد واتساب أولاً لشركات توصيل الميل الأخير في الإمارات: روبوتات الحالة ووقت الوصول، وإعادة جدولة التوصيل الفاشل، وتنسيق توزيع السائقين، وتأكيد الدفع عند الاستلام. مبنية لتتحمل حجم مواسم التخفيضات دون مركز اتصال أكبر.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_last_mile_delivery_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في التوصيل</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=1600&q=80&auto=format&fit=crop" alt="سائق توصيل يراجع المسار على هاتفه في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "24/7", caption: "حالة التوصيل وإعادة الجدولة، دون التقيد بساعات مركز الاتصال" },
      { value: "٩×", caption: "احتمال أعلى لبقاء العميل متفاعلاً عند التواصل خلال ٥ دقائق (MIT)" },
      { value: "محادثة واحدة", caption: "تتولى وقت الوصول والتوصيل الفاشل وتأكيد الدفع عند الاستلام من البداية للنهاية" },
    ]} />
  </div>
</div>

<!-- WHY WHATSAPP NOT PHONE -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا مكان التوصيل الفاشل هو واتساب، لا الهاتف</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>التوصيل الفاشل ليس حالة طارئة، بل مشكلة جدولة.</strong> العميل لم يكن في المنزل، أو رمز دخول المبنى لم يعمل، أو الطلب يحتاج الذهاب إلى عنوان آخر. لا شيء من ذلك يتطلب مكالمة هاتفية. يتطلب رسالة يرد عليها العميل في وقته، من فريق سائقين غير منشغل بإجراء مكالمات صادرة لشرح نفس الأسباب الثلاثة لعدم وصول الطلب.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>مراكز الاتصال لا تتوسع مع حجم الطلبات، أما محادثات واتساب فتتوسع.</strong> موظف الدعم يستطيع التعامل مع مكالمة واحدة في كل مرة. ونفس الموظف، مدعوماً بنظام ذكاء اصطناعي يتولى المرحلة الأولى، يمكنه فعلياً أن يكون حاضراً في مئات محادثات واتساب في آن واحد، لأن معظمها نفس الأسئلة القليلة: أين طلبي، ولماذا فات، ومتى سيصل مجدداً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>العملاء يتوقعون ذلك أصلاً.</strong> لا أحد يريد الرد على رقم مجهول في منتصف اجتماع ليسمع تحديثاً عن التوصيل. رسالة واتساب بوقت وصول حي، أو خطوة بسيطة «اضغطوا لإعادة الجدولة»، تناسب طريقة إدارة الناس ليومهم فعلاً. شركات التوصيل التي لا تزال تعتمد المكالمات الصادرة تطلب من العملاء قطع يومهم من أجل معلومات كان يجب أن تصلهم كرسالة قبل أن يسألوا.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=800&q=80&auto=format&fit=crop" alt="مندوب توصيل يمسح طرداً قبل تسليمه في دبي" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات توصيل الميل الأخير في الإمارات</h2>
      <p>ستة أنظمة محددة نشرناها لعمليات التوصيل في أنحاء الإمارات، كل منها متصل بأدوات الأسطول والتوجيه الحالية لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">pin_drop</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت حالة التوصيل ووقت الوصول</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل حالة الطلب ووقت الوصول الحي عبر واتساب تلقائياً، من لحظة التوزيع حتى الباب. يحصل العملاء على التحديث قبل أن يفكروا في السؤال، فيتوقف «أين طلبي» عن أن يكون أكثر رسالة واردة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يسحب الحالة الحية مباشرة من نظام التوجيه أو التوزيع لديكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد إعادة جدولة التوصيل الفاشل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">عندما تفشل محاولة التوصيل، يتلقى العميل رسالة بالسبب ومجموعة من خيارات إعادة الجدولة، دون أي طابور في مركز الاتصال. يختار وقتاً، فيعود الطلب إلى نظام التوجيه للمحاولة التالية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل المحاولة الفاشلة إلى موعد جديد مؤكد في محادثة واحدة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">alt_route</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توزيع السائقين وتنسيق المسارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل للسائقين محطتهم التالية وتعليمات الدخول وأي ملاحظات من العميل مباشرة، وينبّه قسم التوزيع فوراً إلى الاستثناءات (بوابة مغلقة، عنوان خاطئ، عميل طلب التأجيل) بدلاً من نهاية الوردية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يعمل بالعربية والإنجليزية والأردية ولغات أخرى يفضلها السائقون</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">payments</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تأكيد الدفع عند الاستلام</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يؤكد طلبات الدفع عند الاستلام برسالة قبل إرسال السائق، فيلتقط تغييرات الطلب والإلغاءات ومشكلات العنوان قبل أن يضيّع السائق رحلة على طلب لم يكن ليكتمل أصلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل الرحلات الضائعة على طلبات الدفع عند الاستلام الملغاة أو غير المؤكدة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تخفيف ضغط دعم العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتولى الأسئلة المتكررة (حالة الطلب، ونوافذ التوصيل، وسياسة الإرجاع، وطلبات تغيير العنوان) مباشرة في المحادثة، ولا يحوّل إلى موظف إلا عندما تحتاج الحالة ذلك فعلاً، مع السياق كاملاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يستوعب ذروة مواسم التخفيضات دون إضافة موظفي دعم مؤقتين</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">لوحة تقارير العملاء (التجار)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تمنح التجار رؤية حية لأداء التوصيل لديهم: نسبة النجاح، وأسباب فشل التوصيل، ومتوسط وقت الحل، مقسمة حسب المنطقة أو النافذة الزمنية، دون أن يجمعها مدير حساب يدوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبنية من نفس البيانات الحية التي تشغّل روبوت العملاء</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">متكامل مع نظام الأسطول والتوجيه لديكم، ثنائي اللغة، ومبني لأحجام الطلبات في الإمارات.</p>
      <button onclick="openModal(this)" data-source="ar_last_mile_delivery_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في التوصيل</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">توصيلة واحدة، من التوزيع حتى الباب</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، فتعمل فرق الدعم والتوزيع على الاستثناءات، لا على الحالات الروتينية.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">وقت الوصول يُرسل قبل أن يسأل العميل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">من لحظة توزيع الطلب، يبقى العميل متقدماً على التوصيل، لا يلاحقه.</p>
        <ul class="journey-list">
          <li>حالة توزيع الطلب ووقت الوصول الحي يُرسلان تلقائياً عبر واتساب</li>
          <li>وقت الوصول يتحدث مع تغير مسار السائق، لا تقدير ثابت يُحدد عند التوزيع</li>
          <li>نافذة توصيل قصيرة قبل الوصول، ليكون هناك من يستلم فعلاً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">التوصيل الفاشل يُعاد جدولته دون طابور مركز اتصال</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">إذا لم تنجح المحاولة الأولى، يحدث الاستدراك في نفس المحادثة، لا في مكالمة هاتفية جديدة.</p>
        <ul class="journey-list">
          <li>سبب الفشل ومجموعة من أوقات إعادة الجدولة تُرسل لحظة تسجيل السائق للفشل</li>
          <li>العميل يختار نافذة جديدة مباشرة في واتساب، دون انتظار على الخط ودون حاجة لموظف</li>
          <li>الموعد المحدث يُكتب مباشرة في نظام التوجيه للمحاولة التالية</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الدفع عند الاستلام يُؤكد تلقائياً قبل التوزيع</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">طلبات الدفع عند الاستلام تُؤكد قبل أن يُكلَّف بها أي سائق.</p>
        <ul class="journey-list">
          <li>رسالة تأكيد تُرسل قبل التوزيع، فتلتقط الإلغاءات مبكراً</li>
          <li>تغييرات العنوان والطلب تُلتقط في المحادثة بدلاً من اكتشافها عند الباب</li>
          <li>الطلبات المؤكدة والحالية فقط تدخل مسار السائق</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استدراك التوصيل الفاشل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">التوصيل الفاشل الذي يبقى دون حل ليوم كامل يتحول عادةً إلى طلب ملغى أو تقييم سيئ. وضع خيار إعادة الجدولة أمام العميل خلال دقائق من المحاولة الفاشلة، بينما الطلب لا يزال حاضراً في ذهنه، هو حيث يصنع الاستدراك بالذكاء الاصطناعي أوضح فرق في نسب الإتمام.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تخفيف ضغط دعم العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">معظم حجم الدعم الوارد في التوصيل سؤال واحد يتكرر آلاف المرات: أين طلبي. التعامل معه تلقائياً، وتصعيد الاستثناءات الحقيقية فقط، هو ما يسمح لعدد موظفي الدعم بالبقاء ثابتاً بينما يزيد حجم الطلبات في فترات التخفيضات.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">alt_route</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تنسيق السائقين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">السائقون الذين يستطيعون الإبلاغ عن مشكلة (بوابة مغلقة، وحدة خاطئة، عميل لا يرد) في رسالة واحدة ويحصلون على الخطوة التالية فوراً، يقضون وقتاً أقل في الانتظار وفي الاتصال بقسم التوزيع لسؤاله عما يفعلون. ويتضاعف هذا الأثر عبر أسطول يمر بعشرات المحطات يومياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع نظام الأسطول والتوجيه</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الذكاء الاصطناعي جيد بقدر بيانات الحالة التي يستطيع قراءتها وكتابتها. دون اتصال حي بنظام التوجيه أو التوزيع لديكم، فهو يخمّن أوقات الوصول بدلاً من الإبلاغ عن الوقت الحقيقي، ولا تصل إعادات الجدولة إلى المسار الفعلي للسائق.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إشعارات حالة فورية عبر webhooks</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تحديثات الحالة يجب أن تنطلق لحظة تغير أي شيء على الأرض، لا عبر مهمة مجمّعة تعمل كل بضع ساعات. إشعار webhook من نظام التوزيع لديكم هو ما يحوّل «السائق سجّل الفشل» إلى رسالة للعميل خلال ثوانٍ بدلاً من اليوم التالي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع أحجام كبيرة على واتساب</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">موسم التخفيضات لا يتوزع بالتساوي على اليوم. يحتاج النظام إلى التعامل مع دفعة من آلاف المحادثات المتزامنة دون تباطؤ أو فقدان رسائل، وهذه مشكلة هندسية مختلفة عن التعامل مع حجم يومي ثابت ومنخفض.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تقارير موجهة للتجار</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إذا كنتم توصلون نيابة عن تجار، فهم يريدون رؤية أدائهم دون طلب ذلك من مديري حساباتكم. لوحة متابعة مبنية على نفس البيانات الحية لروبوت العملاء تحافظ على دقة هذه التقارير دون عمل يدوي إضافي.</p>
      </div>
    </div>
  </div>
</section>

