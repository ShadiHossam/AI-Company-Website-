---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "ماذا تعني العلامة البيضاء هنا فعلاً؟ هل يعرف العميل أن Lenoo بنت النظام؟", answer: "العلامة البيضاء تعني أن النظام يعمل بالكامل تحت علامة وكالتكم: شعاركم، ونطاقكم، واسم فريقكم في كل محادثة. العميل النهائي يرى وكالتكم تقدم الأتمتة، لا نحن. وما يحدث خلف الكواليس بين وكالتكم وLenoo محادثة منفصلة، نكون دائماً واضحين فيها ضمن اتفاقية الشراكة." },
  { question: "كيف يعمل هيكل الهامش إذا كنا نعيد بيع هذا لعملائنا؟", answer: "نسعّر البناء والدعم المستمر لوكالتكم بسعر الشركاء، وأنتم تحددون السعر لعميلكم النهائي وتحتفظون بالفرق كهامش. معظم الوكالات الشريكة تسعّره كبند شهري ضمن عقد الخدمة بجانب خدماتها الحالية. سنستعرض الأرقام الفعلية في مكالمة بمجرد أن نفهم الحجم المعتاد لعملائكم وعدد الحسابات التي تخططون لتطبيقه عليها." },
  { question: "إذا كنا ندير الأتمتة لعدة عملاء، هل تبقى بياناتهم منفصلة؟", answer: "نعم، أتمتة كل عميل تعمل في بيئتها المعزولة: مخازن بيانات منفصلة، وبيانات دخول منفصلة، ولا سياق مشترك بين الحسابات. هذا مهم لمسؤولية وكالتكم بقدر أهميته لثقة العميل النهائي، وهو جزء غير قابل للتفاوض في طريقة تصميمنا لأي نشر متعدد العملاء." },
  { question: "هل نستطيع البدء بعميل واحد قبل تعميمه على كل عملائنا؟", answer: "هكذا نوصي بالبدء. معظم الوكالات الشريكة تجرّب مع عميل أو عميلين، وتعتاد على طريقة تقديمه وتسعيره، ثم تعممه على نطاق أوسع بعد أن تراه يعمل في حساب حقيقي. سنساعدكم في تحديد نطاق تلك التجربة الأولى لتكون دليلاً حقيقياً، لا عرضاً توضيحياً يُرمى بعده." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لوكالات التسويق في الإمارات",
    "url": "https://lenooai.com/ar/industries/marketing-agencies",
    "description": "أتمتة بالذكاء الاصطناعي بعلامة بيضاء لوكالات التسويق في الإمارات: إعادة بيع الذكاء الاصطناعي للعملاء، ومسارات إنتاج المحتوى، وأتمتة تقارير العملاء، واستقطاب العملاء المحتملين للوكالة.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Automation for Marketing Agencies"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لوكالات التسويق", "item": "https://lenooai.com/ar/industries/marketing-agencies" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لوكالات التسويق في الإمارات | Lenoo AI"
  description="تتشارك Lenoo AI مع وكالات التسويق في الإمارات في أتمتة بالذكاء الاصطناعي بعلامة بيضاء: مسارات المحتوى، وتقارير العملاء، واستقطاب العملاء المحتملين، وتسعير جاهز لإعادة البيع."
  canonicalPath="/ar/industries/marketing-agencies"
  enPath="/industries/marketing-agencies"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكالات التسويق</div>
    <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لوكالات التسويق في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تتشارك Lenoo AI مع وكالات التسويق في الإمارات لبناء أتمتة بالذكاء الاصطناعي بعلامة بيضاء تعيدون بيعها لعملائكم: مسارات المحتوى، والتقارير، وتأهيل العملاء المحتملين، بتسعير يحافظ على هامشكم.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_marketing_agencies_hero" class="btn-primary">تحدثوا معنا عن ترتيب شراكة</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80&auto=format&fit=crop" alt="فريق وكالة تسويق يراجع أداء الحملات على شاشة مشتركة" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "علامة بيضاء", caption: "يعمل بالكامل تحت علامة وكالتكم، لا علامتنا" },
      { value: "خدمة جديدة", caption: "خط خدمة ذكاء اصطناعي قابل لإعادة البيع، مسعّر ليحفظ هامشكم" },
      { value: "معزول", caption: "فصل بيانات كل عميل عبر كل حساب تديرونه" },
    ]} />
  </div>
</div>

<!-- WHY AGENCIES ARE A DIFFERENT BUYER -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الوكالات نوع مختلف من المشترين: إنها تعيد بيع ما تؤتمته</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الوكالة لا تشتري الأتمتة لتستخدمها مرة واحدة.</strong> العلامة التي تؤتمت تسويقها الخاص تريد الكفاءة لنفسها. أما الوكالة فتريد خط خدمة تعرضه على كل عميل في قائمتها، مسعّراً ليحفظ هامشاً، وباسم الوكالة كقدرة خاصة بها. هذه محادثة بيع مختلفة جذرياً، وهي التي كُتبت هذه الصفحة من أجلها.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>العمل الموجه للعملاء يجب أن يصمد أمام التدقيق.</strong> عندما تضع الوكالة اسمها على عرض تقارير أو مسار محتوى يعمل بالذكاء الاصطناعي، تكون سمعة الوكالة على المحك إذا تعطل أو أنتج شيئاً لا يتوافق مع العلامة. هذا يرفع المعيار في الموثوقية وفي سلاسة تسليم النظام لمدير حساب غير تقني.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>تعدد العملاء هو الأصل، لا الاستثناء.</strong> وكالة تدير الأتمتة لخمسة عشر عميلاً تحتاج أن يكون كل حساب معزولاً، وكل تقرير يحمل العلامة الصحيحة، ولا شيء يتسرب إلى بيانات عميل آخر. الأدوات المبنية لشركة واحدة نادراً ما تصمد عندما تحاول وكالة تشغيلها عبر قائمة عملاء حقيقية.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1552581234-26160f608093?w=800&q=80&auto=format&fit=crop" alt="فريق إبداعي في وكالة يخطط المحتوى لعدة حسابات عملاء" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لوكالات التسويق في الإمارات</h2>
      <p>ستة أنظمة محددة نبنيها مع الوكالات الشريكة في أنحاء الإمارات، كل منها مُعدّ ليعمل بعلامة بيضاء عبر قائمة عملائكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">hub</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة بالذكاء الاصطناعي بعلامة بيضاء للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">العرض الأساسي: روبوتات محادثة، وأتمتة سير العمل، وأدوات تقارير مبنية وفق مواصفاتكم وتُقدَّم تحت علامة وكالتكم، فتبدو قدرتكم الخاصة لكل عميل يراها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">منشورة على نطاقكم، وباسمكم، وعبر مديري حساباتكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">edit_note</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لمسار إنتاج المحتوى</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ المحتوى والملخصات ويعيد توظيفها عبر الصيغ وأصوات علامات العملاء، فيحرر فريقكم الإبداعي ويعتمد بدلاً من بدء كل مادة من صفحة فارغة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على إرشادات علامة كل عميل، لا على صوت عام واحد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تقارير العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسحب بيانات الأداء من منصاتكم الإعلانية وأدوات التحليل إلى تقرير شهري يحمل علامتكم، مكتوب بلغة واضحة، جاهز للإرسال دون أن يقضي مخطط استراتيجي يوماً في إعداد الشرائح.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يفرّغ ساعات المخططين للعمل الذي يدفع العملاء مقابله سعراً أعلى فعلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت استقطاب العملاء المحتملين وتأهيلهم (لمسار الوكالة نفسها)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يؤهل العملاء المحتملين الواردين إلى وكالتكم ويحجز معهم المكالمات قبل أن يصلوا إلى مسؤول تطوير الأعمال، فيقضي فريقكم وقته مع من هم مستعدون للحديث فعلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني لمسار وكالتكم، لا لإعادة البيع للعملاء</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة أداء الحملات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يراقب مؤشرات الحملات الحية عبر الحسابات، وينبّه فريق الحساب فوراً إلى ضعف الأداء أو مشكلات وتيرة الإنفاق، بدلاً من اكتشافها في المراجعة المجدولة التالية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يلتقط الحملة المتعثرة قبل أيام من أن يلاحظ العميل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">handshake</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة استقبال العملاء الجدد</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرشد العميل الجديد خلال مواد العلامة وصلاحيات الوصول والتفضيلات عبر محادثة موجهة، بدلاً من التبادل المعتاد لمكالمات الانطلاق ورسائل المتابعة لجمع نفس المعلومات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يجهز الحساب الجديد للإنتاج دون ثلاثة اجتماعات داخلية</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">بعلامة بيضاء، وجاهز لتعدد العملاء، ومسعّر ليبقى الهامش لكم.</p>
      <button onclick="openModal(this)" data-source="ar_marketing_agencies_mid" class="btn-primary">تحدثوا معنا عن ترتيب شراكة</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">مشروع عميل واحد، من الاستقبال إلى التقارير</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، فيدير فريق الحساب لديكم العلاقة، لا الأعمال الإدارية.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">استقبال لا يحتاج ثلاثة اجتماعات داخلية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل جديد يوقّع، ويبدأ الإعداد بالتحرك قبل اجتماع التخطيط التالي لفريقكم.</p>
        <ul class="journey-list">
          <li>مسار استقبال موجه يجمع مواد العلامة وصلاحيات الوصول والتفضيلات من العميل مباشرة</li>
          <li>هيكل الحساب ووتيرة التقارير يُضبطان تلقائياً من إجابات الاستقبال</li>
          <li>مدير حسابكم يراجع ويعتمد، بدلاً من ملاحقة كل تفصيل يدوياً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عرض التقارير الذي يبني نفسه شهرياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تشغيل الحساب، تتدفق بيانات الأداء باستمرار وتتوقف التقارير عن أن تكون سباقاً شهرياً.</p>
        <ul class="journey-list">
          <li>بيانات الأداء تُسحب من المنصات الإعلانية والتحليلات إلى تقرير واحد يحمل العلامة</li>
          <li>ملخصات مكتوبة بلغة واضحة، لا مجرد رسوم بيانية خام يضطر العميل لتفسيرها</li>
          <li>يُرسل في موعده، مع مراجعة المخطط للتفاصيل الدقيقة قبل إرساله</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سؤال العميل يُجاب دون مكالمة متابعة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بين المراجعات الرسمية، معظم أسئلة العملاء روتينية ولا تحتاج مكالمة مجدولة.</p>
        <ul class="journey-list">
          <li>أسئلة حالة الحملة والأداء الأساسي تُجاب مباشرة في المحادثة</li>
          <li>أسئلة الاستراتيجية الحقيقية تُحوَّل إلى فريق الحساب مع السياق كاملاً</li>
          <li>يحصل العميل على إجابة خلال دقائق بدلاً من انتظار الاجتماع المجدول التالي</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">hub</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إعادة بيع الذكاء الاصطناعي كخط خدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوكالات التي تضيف الأتمتة بالذكاء الاصطناعي كخط خدمة جديد تستطيع زيادة الإيراد لكل عميل دون زيادة متناسبة في عدد الموظفين، لأن التكلفة الإضافية لتشغيل نفس النظام لحساب آخر أقل بكثير من توظيف فريق لعقد خدمة آخر.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">settings</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كفاءة العمليات الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إلى جانب ما يُعاد بيعه، تؤتمت الوكالات تأهيل عملائها المحتملين، واستقبال العملاء، وتحديثات الحالة الداخلية. والوقت المستعاد هناك هو غالباً ما يموّل نمو الوكالة فعلاً، لا هامش إعادة البيع.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة التقارير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">التقارير باستمرار هي المهمة المتكررة الأكثر استهلاكاً للوقت عبر حسابات العملاء، والأقل تميزاً. أتمتتها تفرّغ المخططين لقضاء ذلك الوقت في التحليل والتوصيات التي يقدّرها العملاء فعلاً.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إعداد بعلامة بيضاء ومناسب للشركاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">كل نقطة تواصل، من اسم روبوت المحادثة إلى عنوان المرسل في التقرير، يجب أن تبدو كوكالتكم، لا كمورد خارجي. هذا قرار إعداد مقصود، لا أمر لاحق.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إدارة حسابات متعددة العملاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إضافة عميل جديد يجب أن تكون خطوة إعداد، لا بناءً جديداً. النظام يحتاج بنية تتوسع مع قائمة عملائكم دون إعادة هندسة الإعداد لكل حساب تضيفونه.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">الربط مع أدوات الوكالة الحالية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فريقكم يعمل أصلاً على منصات إعلانية وأدوات إدارة مشاريع ولوحات تحليلات محددة. الأتمتة تحتاج أن تندمج مع هذه الأدوات، لا أن تطلب من فريقكم تعلم أدوات جديدة بجانبها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">هيكل تسعير يحفظ الهامش</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">علاقة إعادة البيع لا تنجح على المدى الطويل إلا إذا كانت الأرقام مجدية للطرفين. التسعير يحتاج أن يترك لوكالتكم مساحة لإضافة هامشها مع البقاء منافساً أمام ما قد يجده العميل في مكان آخر.</p>
      </div>
    </div>
  </div>
</section>

