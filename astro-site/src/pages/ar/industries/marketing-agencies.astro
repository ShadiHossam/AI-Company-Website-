---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لوكالات التسويق في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/marketing-agencies",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "وكالات التسويق", "item": "https://lenooai.com/ar/industries/marketing-agencies" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لوكالات التسويق في الإمارات",
    "description": "أتمتة ذكاء اصطناعي بعلامة بيضاء تُعيد بيعها لعملائك، خط إنتاج محتوى، تقارير عملاء آلية، وتأهيل عملاء محتملين لوكالة التسويق نفسها في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "ماذا تعني العلامة البيضاء هنا فعلياً؟ هل يعرف العميل أن Lenoo بنتها؟",
        "acceptedAnswer": { "@type": "Answer", "text": "العلامة البيضاء تعني أن النظام يعمل بالكامل تحت علامة وكالتكم: شعاركم، نطاقكم، اسم فريقكم في كل محادثة. العميل النهائي يرى وكالتكم تُقدّم الأتمتة، لا نحن." }
      },
      {
        "@type": "Question",
        "name": "كيف يعمل هيكل الهامش إذا كنا نُعيد بيع هذا للعملاء؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نُسعّر البناء والدعم المستمر لوكالتكم بسعر شريك، وأنتم تُحدّدون السعر لعميلكم النهائي، محتفظين بالفرق كهامش. معظم الوكالات الشريكة تُسعّره كبند اشتراك شهري ضمن خدماتها الحالية." }
      },
      {
        "@type": "Question",
        "name": "إذا كنا ندير أتمتة لعدة عملاء، هل بياناتهم منفصلة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، أتمتة كل عميل تعمل في بيئتها المعزولة الخاصة: تخزين بيانات منفصل، بيانات اعتماد منفصلة، لا سياق مشترك بين الحسابات." }
      },
      {
        "@type": "Question",
        "name": "هل نستطيع البدء بعميل واحد قبل نشرها على قائمة عملائنا كاملة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "هذا ما نُوصي به للبدء. معظم الوكالات الشريكة تُجرّب مع عميل أو اثنين، تعتاد على طريقة العرض والتسعير، ثم تنشر على نطاق أوسع بعد رؤيتها تعمل في حساب حقيقي." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لوكالات التسويق في الإمارات | Lenoo AI"
  description="Lenoo AI تشارك وكالات التسويق في الإمارات ببناء أتمتة ذكاء اصطناعي بعلامة بيضاء تُعيد بيعها للعملاء: خط محتوى، تقارير، وتأهيل عملاء محتملين، بتسعير يحفظ هامشكم."
  canonicalPath="/ar/industries/marketing-agencies"
  enPath="/industries/marketing-agencies"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكالات التسويق</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">campaign</span>
      وكالات التسويق
    </div>
    <h1>ذكاء اصطناعي لوكالات التسويق في دبي<br><span class="gradient-text">خط خدمة جديد قابل لإعادة البيع، لا أداة داخلية فقط</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      وكالتكم لا تشتري أتمتة لاستخدامها مرة واحدة، بل خط خدمة تُقدّمه لكل عميل، بعلامتكم الخاصة، بسعر يحفظ هامشكم. نبني معكم أتمتة بعلامة بيضاء، خط إنتاج محتوى، وتقارير عملاء آلية.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_marketing_agencies_hero" class="btn-primary">تحدّث معنا عن شراكة ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80&auto=format&fit=crop" alt="فريق وكالة تسويق يراجع أداء حملة على شاشة مشتركة" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">علامة بيضاء</p>
        <p class="stat-lbl">تعمل بالكامل تحت علامة وكالتكم، لا علامتنا</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">خط جديد</p>
        <p class="stat-lbl">خدمة ذكاء اصطناعي قابلة لإعادة البيع، مُسعَّرة لهامشكم</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">معزول</p>
        <p class="stat-lbl">فصل بيانات لكل عميل عبر كل حساب تديرونه</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما نبنيه معك كوكالة</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مُعدَّة للعمل بعلامة بيضاء عبر قائمة عملائكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">hub</span>
        <h3>أتمتة ذكاء اصطناعي بعلامة بيضاء للعملاء</h3>
        <p style="color:#42474e;line-height:1.7;">العرض الأساسي: بوتات دردشة وأتمتة سير عمل وأدوات تقارير مبنية حسب مواصفاتكم ومُسلَّمة بعلامة وكالتكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">edit_note</span>
        <h3>ذكاء اصطناعي لخط إنتاج المحتوى</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد ويُعيد استخدام المحتوى عبر التنسيقات وأصوات علامات العملاء، فيراجع فريقكم الإبداعي بدل البدء من صفحة فارغة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">summarize</span>
        <h3>أتمتة تقارير العملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يسحب بيانات الأداء من منصات إعلاناتكم وتحليلاتكم لتقرير شهري بعلامتكم، بلغة واضحة، جاهز للإرسال.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">person_search</span>
        <h3>بوت تأهيل عملاء محتملين (لخط أنابيب وكالتكم)</h3>
        <p style="color:#42474e;line-height:1.7;">يؤهّل ويحجز مكالمات مع عملاء وكالتكم الواردين قبل وصولهم لممثل تطوير أعمال.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">monitoring</span>
        <h3>مراقبة أداء الحملات</h3>
        <p style="color:#42474e;line-height:1.7;">يراقب مقاييس الحملة الحية عبر الحسابات ويُنبّه لضعف الأداء أو مشاكل وتيرة الميزانية فوراً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">handshake</span>
        <h3>أتمتة استقبال العملاء الجدد</h3>
        <p style="color:#42474e;line-height:1.7;">يُرشد عميلاً جديداً عبر أصول العلامة والصلاحيات والتفضيلات بمحادثة موجَّهة، مُستبدلاً مراسلات الانطلاق المعتادة.</p>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من استقبال عميل إلى التقرير</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، ليُدير فريق حساباتكم العلاقة لا الإدارة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">استقبال بلا ثلاث اجتماعات داخلية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">عميل جديد يوقّع، والإعداد يبدأ بالتحرك قبل اجتماع تخطيط فريقكم القادم.</p>
        <ul class="journey-list">
          <li>تدفق استقبال موجَّه يجمع أصول العلامة والصلاحيات والتفضيلات مباشرة من العميل</li>
          <li>هيكل الحساب ووتيرة التقارير يُهيَّآن تلقائياً من إجابات الاستقبال</li>
          <li>مدير حسابكم يراجع ويعتمد، بدل ملاحقة كل تفصيلة يدوياً</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عرض التقرير يبني نفسه شهرياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تفعيل الحساب، تتدفق بيانات الأداء باستمرار ويتوقف التقرير عن كونه سباقاً شهرياً.</p>
        <ul class="journey-list">
          <li>بيانات الأداء تُسحب من منصات الإعلانات والتحليلات لتقرير واحد بعلامتكم</li>
          <li>ملخصات مكتوبة بلغة واضحة، لا رسوماً خام يفسّرها العميل بنفسه</li>
          <li>تُرسل حسب الجدول، مع مراجعة الاستراتيجي للدقة قبل الإرسال</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">سؤال العميل يُجاب دون مكالمة حالة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بين المتابعات الرسمية، معظم أسئلة العملاء روتينية ولا تحتاج مكالمة مجدولة.</p>
        <ul class="journey-list">
          <li>حالة الحملة وأسئلة الأداء الأساسية تُجاب مباشرة في المحادثة</li>
          <li>أسئلة الاستراتيجية الحقيقية تُوجَّه لفريق الحساب بسياق كامل</li>
          <li>العميل يحصل على إجابة خلال دقائق بدل انتظار المزامنة المجدولة التالية</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">hub</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إعادة بيع الذكاء الاصطناعي كخط خدمة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوكالات التي تُضيف أتمتة ذكاء اصطناعي كخط خدمة جديد تستطيع تنمية الإيراد لكل عميل دون زيادة موظفين متناسبة، لأن التكلفة الإضافية لتشغيل نفس النظام لحساب آخر أقل بكثير من توظيف مدير حساب آخر.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">settings</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كفاءة العمليات الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">إضافة لما يُعاد بيعه، الوكالات تُؤتمت تأهيل عملائها المحتملين واستقبال العملاء وتحديثات الحالة الداخلية. الوقت المُستعاد هناك غالباً هو ما يُموّل نمو الوكالة الفعلي.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة التقارير</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">التقارير باستمرار أكثر مهمة متكررة تستهلك وقتاً عبر حسابات العملاء، وأقلها تمايزاً. أتمتتها تُحرّر الاستراتيجيين للتحليل والتوصيات التي يُقدّرها العملاء فعلياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إعداد ودود بعلامة بيضاء وشريك</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">كل نقطة تواصل، من اسم بوت الدردشة لعنوان مُرسل التقرير، يجب أن تُقرأ كوكالتكم، لا بائعاً خارجياً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إدارة حسابات متعددة العملاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">إضافة عميل جديد يجب أن تكون خطوة تهيئة، لا بناءً جديداً. النظام يحتاج هيكلاً يتوسّع لقائمتكم دون إعادة هندسة الإعداد لكل حساب.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع منظومة الوكالة الحالية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">فريقكم يعمل بالفعل في منصات إعلانات وأدوات إدارة مشاريع ولوحات تحليل محددة. الأتمتة تحتاج التوصيل بتلك المنظومة، لا طلب تعلّم واحدة جديدة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">هيكل تسعير يحفظ الهامش</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">علاقة إعادة البيع تعمل على المدى الطويل فقط إن كانت الاقتصاديات تصح لكلا الطرفين. التسعير يحتاج ترك مساحة لوكالتكم للترميز والبقاء تنافسياً.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?w=1200&q=80&auto=format&fit=crop" alt="فريق وكالة يتعاون حول طاولة بأجهزة محمولة ولوحات حملات" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.5rem; margin-bottom:4px;">إيراد جديد</p>
