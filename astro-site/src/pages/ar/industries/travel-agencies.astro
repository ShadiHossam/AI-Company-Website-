---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const faqItems = [
  { question: "من أي أنظمة حجز عالمية وأنظمة موردين يستطيع مساعد التسعير سحب البيانات؟", answer: "نتكامل مع أي نظام تحجز عبره وكالتكم أصلاً، سواء كان نظام حجز عالمياً مثل Amadeus أو Sabre أو Galileo، أو تغذيات مباشرة من الموردين وشركات إدارة الوجهات للفنادق والتنقلات والباقات. يقرأ المساعد التوافر والأسعار الحية من هذه الأنظمة بدلاً من العمل على قائمة أسعار ثابتة، فتبقى عروض الأسعار دقيقة مع تغير الأسعار." },
  { question: "من يتحمل المسؤولية إذا قدّم الذكاء الاصطناعي متطلب تأشيرة خاطئاً؟", answer: "يذكر الذكاء الاصطناعي متطلبات التأشيرة والدخول بناءً على قاعدة المعارف التي نبنيها معكم، وكل عرض سعر نعدّه يتضمن تنبيهاً واضحاً يوجه المسافرين للتحقق من السفارة أو القنصلية المعنية قبل الحجز، تماماً كما يفعل نص الموظف البشري عادةً. نتعامل مع معلومات التأشيرة كنقطة بداية للمسافر، لا كبديل عن التأكيد الرسمي، ونكون واضحين بشأن هذا الحد أثناء الإعداد." },
  { question: "هل يتحمل الحجم في موسم الذروة دون تباطؤ؟", answer: "نعم، هذا تحديداً ما بُني من أجله. ذروة الصيف والعطلات هي حين ترتفع استفسارات البرامج السياحية بأشد صورة، وهي أيضاً حين تنهار عملية التسعير اليدوية بأوضح شكل. يتعامل المساعد مع الاستفسارات المتزامنة دون تراكم، فيقضي الموظفون موسم الذروة في إتمام الحجوزات بدلاً من كتابة نفس بنية البرنامج مراراً." },
  { question: "هل يعمل بلغات غير الإنجليزية والعربية؟", answer: "نعم. نظراً للتنوع الدولي الكبير في قواعد عملاء وكالات السفر في الإمارات، نعدّه عادةً للتعامل بالعربية والإنجليزية وأي لغات أخرى تأتي بها استفساراتكم فعلاً، وغالباً الروسية أو الهندية أو الأردية. يحصل المسافر على عرض السعر باللغة التي راسل بها، دون الحاجة إلى موظف ثنائي اللغة متفرغ في تلك اللحظة." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لوكالات السفر في الإمارات",
    "url": "https://lenooai.com/ar/industries/travel-agencies",
    "description": "أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعدو تسعير البرامج السياحية، وروبوتات الحجز عبر واتساب، وتذكيرات الدفعات والمستندات، وفاحصو متطلبات التأشيرة.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "الأتمتة بالذكاء الاصطناعي لوكالات السفر"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لوكالات السفر", "item": "https://lenooai.com/ar/industries/travel-agencies" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لوكالات السفر في الإمارات | Lenoo AI"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعدو تسعير البرامج السياحية، وروبوتات الحجز عبر واتساب، وتذكيرات المستندات، وفاحصو متطلبات التأشيرة."
  canonicalPath="/ar/industries/travel-agencies"
  enPath="/industries/travel-agencies"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.pexels.com/photos/39075595/pexels-photo-39075595.jpeg", alt: "مسافرة تحمل جواز سفرها في صالة مطار مزدحمة" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/industries" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكالات السفر</div>
  <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لوكالات السفر في دبي</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعدو تسعير البرامج السياحية، وروبوتات الحجز عبر واتساب، وتذكيرات المستندات والدفعات، وفاحصو متطلبات التأشيرة. متصلة بأنظمة الحجز العالمية، ومتعددة اللغات، ومبنية لحجم موسم الذروة.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_travel_agencies_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لوكالة السفر</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "دقائق", caption: "لا ساعات، لتحويل الاستفسار إلى عرض سعر" },
      { value: "٩×", caption: "احتمال أعلى لحجز المسافر عند التواصل خلال ٥ دقائق (MIT)" },
      { value: "24/7", caption: "تسعير وتذكيرات بالمستندات، حتى في موسم الذروة" },
    ]} />
  </div>
</PageHero>

<!-- WHY QUOTING IS THE BOTTLENECK -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا تسعير نفس بنية البرنامج مئة مرة أسبوعياً هو عنق الزجاجة الحقيقي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم الاستفسارات تتبع نفس الشكل.</strong> باقة المالديف لخمس ليالٍ، أو رحلة أوروبية متعددة المدن، أو باقة عمرة عائلية: الوجهات تختلف، لكن بنية عرض السعر (الطيران، وفئة الفندق، والتنقلات، والإضافات الاختيارية) تتكرر باستمرار. يقضي الموظفون ساعات في إعادة بناء نفس قالب العرض بأرقام مختلفة بدلاً من التحدث مع مسافرين مستعدين للحجز.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>السرعة تحدد من يفوز بالحجز.</strong> المسافر الذي يقارن ثلاث وكالات على واتساب يحجز مع أول من يرد بعرض سعر حقيقي. وإذا كانت وكالتكم تستغرق ساعات لتحويل الاستفسار إلى تسعير لأن الموظف يتحقق يدوياً من أسعار الطيران والفنادق والتوافر، فأنتم تخسرون الحجوزات لمن رد أسرع، لا لمن قدم سعراً أفضل.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>الأوراق بعد الحجز هي حيث تتعثر الرحلات.</strong> نسخ جوازات السفر، ومستندات التأشيرة، والعربون والدفعات المتبقية، كلها يلاحقها يدوياً موظف يحاول في الوقت نفسه تسعير استفسارات جديدة. وتذكير دفع فائت أو بيانات جواز متأخرة قد تعرّض الحجز للخطر قبل المغادرة بأيام.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=800&q=80&auto=format&fit=crop" alt="مسافر يتحقق من تفاصيل رحلته على الهاتف قبل السفر" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لوكالات السفر في الإمارات</h2>
      <p>ستة أنظمة محددة نشرناها لوكالات السفر في أنحاء الإمارات، كل منها متصل بأنظمة الحجز والموردين لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">quiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد استفسارات البرامج السياحية وتسعيرها</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع تفاصيل الرحلة (الوجهة، والتواريخ، وعدد المسافرين، والميزانية) عبر واتساب أو محادثة الموقع، ويعيد عرض سعر منظماً يسحب الأسعار الحية، بدلاً من أن يبنيه موظف من الصفر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل الاستفسار المعتاد إلى عرض سعر خلال دقائق، لا ساعات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت الحجز عبر واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينقل المسافر من عرض سعر مؤكد إلى رحلة محجوزة داخل المحادثة نفسها: رابط الدفع والتأكيد ورقم الحجز تُرسل تلقائياً، دون سلسلة بريد منفصلة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحجز مباشرة في القناة التي استخدمها المسافر للاستفسار أصلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تذكير الدفعات والمستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يلاحق العربون والدفعات المتبقية ومستندات الجواز أو التأشيرة تلقائياً وفق جدول مرتبط بتاريخ الرحلة، فلا يفوت شيء لأن الموظف منشغل بتسعير مسافرين آخرين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">التذكيرات تتبع مواعيد الرحلة، لا جدولاً عاماً ثابتاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فاحص متطلبات التأشيرة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن أسئلة متطلبات التأشيرة والدخول حسب الوجهة والجنسية مباشرة في المحادثة، مع إشارة واضحة إلى التحقق الرسمي، فيقلص الوقت الذي يقضيه الموظفون في الإجابة عن نفس الأسئلة يومياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني من قاعدة معارف وكالتكم حول الوجهات والجنسيات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">update</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت التحديثات بعد الحجز</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تغييرات الرحلات وتأكيدات الفنادق ومعلومات ما قبل المغادرة تلقائياً فور حدوثها، فيسمع المسافرون الخبر من وكالتكم أولاً، لا من تطبيق شركة الطيران.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي المسافرين على اطلاع دون مكالمة متابعة مخصصة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">star</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">طلب التقييمات والإحالات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يوقّت طلب التقييم والإحالة لما بعد نجاح الرحلة فعلاً، بناءً على ردود المتابعة بعد العودة، فيحمي تقييمات وكالتكم ويحوّل المسافرين الراضين إلى استفسارات جديدة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُرسل فقط بعد إشارة إيجابية بعد الرحلة، لا وفق جدول شامل</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">متصل بأنظمة الحجز العالمية، ومتعدد اللغات، ومبني لتحمل حجم استفسارات موسم الذروة.</p>
      <button onclick="openModal(this)" data-source="ar_travel_agencies_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي لوكالة السفر</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">رحلة واحدة، من الاستفسار حتى الحجز</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركز موظفوكم على الرحلات التي تحتاج تقديراً حقيقياً.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عرض سعر خلال دقائق بدلاً من ساعات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مسافر يراسل بالتواريخ والوجهة والميزانية، والذكاء الاصطناعي لديه البنية الجاهزة للرد.</p>
        <ul class="journey-list">
          <li>يسحب الأسعار الحية بدلاً من التسعير من قائمة قديمة</li>
          <li>يبني برنامجاً منظماً بخيارات الطيران والفندق والتنقل جاهزاً للإرسال</li>
          <li>يصعّد إلى موظف فقط حين يحتاج الطلب تقديراً لا يوفره القالب</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الحجز يُؤكد والمستندات تُلاحق تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد قبول عرض السعر، يدفع الذكاء الاصطناعي الحجز للأمام دون موظف يلاحق كل خطوة.</p>
        <ul class="journey-list">
          <li>رابط الدفع يُرسل ويُؤكد داخل محادثة واتساب نفسها</li>
          <li>طلبات مستندات الجواز والتأشيرة تُرسل وفق جدول مرتبط بتاريخ المغادرة</li>
          <li>تذكيرات الدفعة المتبقية تُرسل تلقائياً مع اقتراب الموعد</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المسافر يبقى على اطلاع دون مكالمة مخصصة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بين الحجز والمغادرة، وأثناء الرحلة نفسها، يبقي الذكاء الاصطناعي المسافر على اطلاع.</p>
        <ul class="journey-list">
          <li>تغييرات الطيران والفندق تُبلَّغ لحظة تأكيدها من المورد</li>
          <li>معلومات ما قبل المغادرة تُرسل تلقائياً قبل السفر بعدد محدد من الأيام</li>
          <li>متابعة بعد الرحلة تُرسل لالتقاط المشكلات مبكراً وتوقيت طلبات التقييم جيداً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">bolt</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة إصدار عروض الأسعار</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الوكالة التي تسعّر أولاً تفوز عادةً بالحجز، خاصة على واتساب حيث يراسل المسافر غالباً وكالتين أو ثلاثاً في آن واحد. تقليص وقت التسعير من ساعات إلى دقائق هو التغيير الأكثر أثراً مباشراً على التحويل.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ملاحقة المستندات والدفعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">الحجز المؤكد الذي تنقصه نسخة جواز أو دفعة متبقية قرب المغادرة خطر حقيقي على الرحلة. التذكيرات الآلية المرتبطة بالمواعيد تلتقط ذلك قبل أن يصبح مشكلة عاجلة قبل السفر بأيام.</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">update</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التحديثات بعد الحجز</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7;">المسافرون الذين يعرفون بتغيير رحلتهم من وكالتهم، لا باكتشافه في المطار، يثقون بتلك الوكالة في رحلتهم التالية. التحديثات الآلية الفورية تحمي هذه العلاقة دون الحاجة إلى مدير حساب مخصص لكل مسافر.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع أنظمة الحجز العالمية والموردين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">عرض السعر مفيد فقط إذا كانت الأسعار خلفه حية. الاتصال بنظام الحجز العالمي أو تغذيات الموردين لديكم، بدلاً من قائمة أسعار تُحدَّث يدوياً، هو ما يبقي العروض المولّدة بالذكاء الاصطناعي دقيقة بما يكفي للحجز منها فعلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تعدد العملات واللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">وكالات السفر في الإمارات تسعّر بالدرهم والدولار وغالباً بعملة بلد المسافر، وتصل الاستفسارات بالعربية والإنجليزية وعدة لغات أخرى. يحتاج المساعد إلى التعامل مع الأمرين دون أن يلاحظ المسافر أي فاصل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">المعرفة بمتطلبات التأشيرة والمستندات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قواعد التأشيرة تختلف حسب الجنسية والوجهة وتتغير كثيراً. قاعدة المعارف خلف الفاحص تحتاج مراجعة منتظمة، والمساعد يحتاج أن يكون واضحاً في توجيه المسافرين إلى التحقق الرسمي، لا أن يقدم نفسه كالكلمة الأخيرة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع أحجام موسم الذروة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">ذروة الصيف والعطلات تجلب حجماً من الاستفسارات قد يفوق ما يستطيع فريق يدوي تسعيره في الوقت المناسب. يحتاج النظام إلى الصمود أمام المحادثات المتزامنة تماماً حين يحتاجه العمل أكثر، لا في أسبوع عادي فقط.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تقوله البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1200&q=80&auto=format&fit=crop" alt="مسافر يحمل حقيبة وبطاقة صعود في المطار" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.75rem; margin-bottom:4px;">العرض الأسرع</p>
        <p style="color:#42474e; font-size:0.875rem;">يفوز بالحجز حين يقارن المسافرون الوكالات على واتساب في الوقت نفسه</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.75rem; margin-bottom:4px;">لا مواعيد فائتة</p>
        <p style="color:#42474e; font-size:0.875rem;">تذكيرات المستندات والدفعات مرتبطة بتاريخ المغادرة الفعلي لكل رحلة</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:1.75rem; margin-bottom:4px;">جاهز للذروة</p>
        <p style="color:#42474e; font-size:0.875rem;">يتعامل مع ذروات الاستفسارات المتزامنة دون تراكم في التسعير</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">سرعة التسعير والتحويل</p>
          <p style="color:#42474e; line-height:1.7;">وجدت أبحاث MIT حول سرعة الاستجابة للعملاء المحتملين أن التواصل خلال ٥ دقائق يحقق تحويلاً أفضل بكثير من الانتظار حتى ٣٠ دقيقة. واستفسارات السفر تتصرف بالطريقة نفسها: الوكالات التي نتحدث معها تقول باستمرار إن العرض الأسرع، لا الأرخص بالضرورة، هو ما يفوز بالحجز حين يراسل المسافر عدة وكالات في آن واحد.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">ملاحقة المستندات</p>
          <p style="color:#42474e; line-height:1.7;">الموظفون الذين نتحدث معهم يصفون ملاحقة الجوازات والدفعات بأنها من أكثر أجزاء أسبوعهم استهلاكاً للوقت وأقلها قيمة، وأكثرها عرضة للإهمال في فترات التسعير المزدحمة. التذكيرات الآلية المرتبطة بالمواعيد تلغي هذه المفاضلة بالكامل.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">ضغط موسم الذروة</p>
          <p style="color:#42474e; line-height:1.7;">فترات الصيف والعطلات المدرسية تجلب أشد ذروات الاستفسارات التي تشهدها وكالات السفر في الإمارات طوال العام. والوكالات التي لا تستطيع التسعير بسرعة كافية في هذه الفترات تخسر الحجوزات لا لمنافسين بأسعار أفضل، بل لمنافسين ردوا أولاً ببساطة.</p>
        </div>
      </div>
    </div>
  </div>
</section>

