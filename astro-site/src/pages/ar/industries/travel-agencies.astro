---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "أتمتة الذكاء الاصطناعي لوكالات السفر في الإمارات",
    "url": "https://lenooai.com/ar/industries/travel-agencies",
    "description": "تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعد تسعير الرحلات، بوت حجز عبر واتساب، تذكير بالمستندات والدفعات، وفاحص متطلبات التأشيرة."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "الصناعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "وكالات السفر", "item": "https://lenooai.com/ar/industries/travel-agencies" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "أتمتة الذكاء الاصطناعي لوكالات السفر في الإمارات",
    "url": "https://lenooai.com/ar/industries/travel-agencies",
    "description": "أنظمة ذكاء اصطناعي لوكالات السفر: تسعير فوري، حجز عبر واتساب، تذكير بالمستندات والدفعات، وفحص متطلبات التأشيرة.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Automation for Travel Agencies"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "ما أنظمة الحجز وموردي السفر التي يمكن لمساعد التسعير الاتصال بها؟", "acceptedAnswer": { "@type": "Answer", "text": "نتكامل مع أي نظام تحجزون من خلاله فعلياً، سواء كان نظام حجز عالمي مثل Amadeus أو Sabre أو Galileo، أو تغذية مباشرة من موردين ومشغلي رحلات للفنادق والنقل والباقات. يقرأ المساعد الأسعار والتوفر الفعلي من هذه الأنظمة بدلاً من الاعتماد على قائمة أسعار ثابتة، فتبقى العروض دقيقة مع تحرك الأسعار." } },
      { "@type": "Question", "name": "من المسؤول إذا أعطى الذكاء الاصطناعي متطلب تأشيرة غير صحيح؟", "acceptedAnswer": { "@type": "Answer", "text": "يعرض الذكاء الاصطناعي متطلبات التأشيرة والدخول بناءً على قاعدة المعرفة التي نبنيها معكم، وكل عرض سعر نجهزه يتضمن إخلاء مسؤولية واضحاً يوجّه المسافر للتحقق من السفارة أو القنصلية المعنية قبل الحجز، تماماً كما يفعل موظف بشري عادة. نتعامل مع معلومات التأشيرة كنقطة بداية للمسافر وليس بديلاً عن التأكيد الرسمي، ونوضح هذا الحد منذ الإعداد." } },
      { "@type": "Question", "name": "هل يتحمل حجم الاستفسارات في موسم الذروة دون تباطؤ؟", "acceptedAnswer": { "@type": "Answer", "text": "نعم، هذا بالضبط ما صُمم من أجله. مواسم الصيف والعطلات هي الأوقات التي ترتفع فيها استفسارات الرحلات بشدة، وهي أيضاً الأوقات التي تنهار فيها عملية التسعير اليدوي بأوضح صورة. يتعامل المساعد مع استفسارات متزامنة دون تراكم، فيقضي الوكلاء موسم الذروة في إغلاق الحجوزات بدلاً من كتابة نفس هيكل الرحلة مراراً." } },
      { "@type": "Question", "name": "هل يعمل بلغات أخرى غير العربية والإنجليزية؟", "acceptedAnswer": { "@type": "Answer", "text": "نعم. نظراً لتنوع قاعدة عملاء وكالات السفر الإماراتية دولياً، نجهز هذا النظام عادة ليتعامل مع العربية والإنجليزية وأي لغات أخرى يرد بها حجم استفساراتكم فعلياً، غالباً الروسية أو الهندية أو الأردية. يحصل المسافر على عرض بنفس اللغة التي راسل بها، دون حاجة لتوفر وكيل ثنائي اللغة في تلك اللحظة." } }
    ]
  }
];
---

<ArBaseLayout
  title="أتمتة الذكاء الاصطناعي لوكالات السفر في الإمارات | Lenoo AI"
  description="تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعد تسعير الرحلات، بوت حجز عبر واتساب، تذكير بالمستندات، وفاحص متطلبات التأشيرة."
  canonicalPath="/ar/industries/travel-agencies"
  enPath="/industries/travel-agencies"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar/#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">الصناعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>وكالات السفر</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لوكالات السفر</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات: مساعد تسعير فوري، بوت حجز عبر واتساب، تذكير بالمستندات والدفعات، وفاحص متطلبات التأشيرة. متصل بأنظمة الحجز، متعدد اللغات، ومبني لتحمل حجم موسم الذروة.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="travel_agencies_hero_ar" class="btn-primary">احجز تقييماً مجانياً لوكالة السفر</button>
      <a href="#what-we-build" class="btn-outline">شاهد ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1600&q=80&auto=format&fit=crop" alt="وكيل سفر يراجع خط رحلة مع عميل" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <div class="hosp-stats-grid">
      <div class="stat-item">
        <p class="stat-num">دقائق</p>
        <p class="stat-lbl">لا ساعات، لتحويل الاستفسار إلى عرض سعر</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة أعلى للحجز عند التواصل خلال ٥ دقائق (MIT)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تسعير وتذكير بالمستندات، حتى في موسم الذروة</p>
      </div>
    </div>
  </div>
</div>

<!-- WHY QUOTING IS THE BOTTLENECK -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا تكرار نفس هيكل العرض مئة مرة أسبوعياً هو عنق الزجاجة الحقيقي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم الاستفسارات تتبع نفس النمط.</strong> باقة إلى المالديف لخمس ليالٍ، رحلة أوروبية متعددة المدن، باقة عمرة عائلية: الوجهات تختلف، لكن هيكل العرض (طيران، فئة فندق، نقل، إضافات اختيارية) يتكرر باستمرار. يقضي الوكلاء ساعات في إعادة بناء نفس قالب العرض بأرقام مختلفة بدلاً من التحدث مع مسافرين جاهزين للحجز.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>السرعة تحدد من يحصل على الحجز.</strong> المسافر الذي يقارن ثلاث وكالات على واتساب يحجز مع أول من يرد بعرض حقيقي. إذا استغرقت وكالتكم ساعات لتحويل استفسار إلى تسعير لأن الوكيل يتحقق يدوياً من الأسعار وتوفر الفنادق، فأنتم تخسرون الحجوزات لصالح من رد أسرع، ليس بالضرورة من عرض سعراً أفضل.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>الأوراق بعد الحجز هي حيث تتعثر الرحلات.</strong> نسخ جوازات السفر، مستندات التأشيرة، دفعات العربون والرصيد، كلها تُلاحق يدوياً من وكيل يحاول في نفس الوقت تسعير استفسارات جديدة. تذكير دفعة فائت أو تفاصيل جواز سفر تُقدم متأخرة قد يعرّض الحجز للخطر قبل أيام من السفر.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=800&q=80&auto=format&fit=crop" alt="مسافر يتحقق من تفاصيل رحلة على هاتفه قبل السفر" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي لوكالات السفر في الإمارات</h2>
      <p>ستة أنظمة محددة نشرناها لوكالات سفر في جميع أنحاء الإمارات، كل منها متصل بأنظمة الحجز والموردين لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">quiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد استفسار وتسعير الرحلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع تفاصيل الرحلة (الوجهة، التواريخ، عدد الأشخاص، الميزانية) عبر واتساب أو الدردشة، ويعيد عرض سعر منظم بأسعار وتوافر فعلي، بدلاً من أن يبنيه وكيل من الصفر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحوّل استفساراً روتينياً إلى عرض سعر خلال دقائق لا ساعات</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت الحجز عبر واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينقل المسافر من عرض سعر مؤكد إلى رحلة محجوزة داخل نفس محادثة واتساب: رابط دفع، تأكيد، ورقم حجز يُرسل تلقائياً، دون سلسلة بريد إلكتروني منفصلة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحجز مباشرة في نفس القناة التي استفسر منها المسافر</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">notifications_active</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تذكير الدفعات والمستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يلاحق العربون ودفعات الرصيد ومستندات جواز السفر أو التأشيرة تلقائياً بجدول مرتبط بتاريخ الرحلة، فلا يفوت شيء لأن الوكيل مشغول بتسعير مسافرين آخرين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكيرات تتناسب مع مواعيد الرحلة، لا جدولاً عاماً ثابتاً</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فاحص متطلبات التأشيرة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن أسئلة متطلبات التأشيرة والدخول حسب الوجهة والجنسية مباشرة في المحادثة، مع توجيه واضح للتحقق الرسمي، مما يقلل الوقت الذي يقضيه الوكلاء في الإجابة عن نفس أسئلة المتطلبات يومياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني من قاعدة معرفة الوجهات والجنسيات الخاصة بوكالتكم</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">update</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">بوت تحديثات ما بعد الحجز</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تغييرات الرحلات وتأكيدات الفنادق ومعلومات ما قبل السفر تلقائياً فور حدوثها، فيسمعها المسافر من وكالتكم أولاً، لا من تطبيق شركة الطيران.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي المسافرين على اطلاع دون مكالمة متابعة مخصصة</p>
      </div>
      <div class="card feature-ledger">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px; direction:ltr;">star</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">طلب التقييم والإحالة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يوقّت طلب التقييم والإحالة بعد أن تسير الرحلة فعلاً بشكل جيد، بناءً على ردود متابعة ما بعد العودة، فيحمي تقييمات وكالتكم بينما يحوّل المسافرين السعداء إلى استفسارات جديدة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُرسل فقط بعد إشارة إيجابية بعد الرحلة، لا بجدول عام</p>
      </div>
    </div>
    <div class="guarantee-badge" style="text-align:center;margin-top:2.5rem;padding:2rem;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان استرداد كامل ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">متصل بأنظمة الحجز، متعدد اللغات، ومبني لتحمل حجم استفسارات موسم الذروة.</p>
      <button onclick="openModal(this)" data-source="travel_agencies_mid_ar" class="btn-primary">احجز تقييماً مجانياً لوكالة السفر</button>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">رحلة واحدة، من الاستفسار إلى الحجز</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، بينما يركز وكلاؤكم على الرحلات التي تحتاج حكماً بشرياً فعلياً.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">عرض سعر خلال دقائق بدلاً من ساعات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">يراسل المسافر بالتواريخ والوجهة والميزانية. الذكاء الاصطناعي لديه الهيكل جاهزاً للرد.</p>
        <ul class="journey-list">
          <li>يسحب الأسعار والتوفر الفعلي بدلاً من التسعير من قائمة قديمة</li>
          <li>يبني خط رحلة منظماً بخيارات طيران وفندق ونقل جاهزة للإرسال</li>
          <li>يصعّد إلى وكيل فقط عندما يحتاج الطلب حكماً لا يقدمه القالب</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز مؤكد مع ملاحقة تلقائية للمستندات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد قبول العرض، يبقي الذكاء الاصطناعي الحجز يتحرك دون أن يلاحق وكيل كل خطوة.</p>
        <ul class="journey-list">
          <li>رابط الدفع يُرسل ويُؤكد داخل نفس محادثة واتساب</li>
          <li>طلبات مستندات جواز السفر والتأشيرة تُرسل بجدول مرتبط بتاريخ المغادرة</li>
          <li>تذكيرات دفعة الرصيد تُرسل تلقائياً مع اقتراب الموعد النهائي</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المسافر يبقى على اطلاع دون مكالمة مخصصة</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بين الحجز والسفر، وأثناء الرحلة نفسها، يبقي الذكاء الاصطناعي المسافر على اطلاع.</p>
        <ul class="journey-list">
          <li>تغييرات الطيران والفندق تُنقل لحظة تأكيدها من المورّد</li>
