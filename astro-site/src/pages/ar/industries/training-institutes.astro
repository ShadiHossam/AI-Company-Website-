---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const faqItems = [
  { question: "هل يعمل روبوت الاستفسارات مع نظام إدارة التعلم الحالي لدينا؟", answer: "مبني ليتصل بنظام إدارة التعلم أو منصة إدارة الطلاب التي تستخدمونها أصلاً، فيقرأ جداول الدورات والمقاعد المتاحة ويسجل التسجيلات عند تحوّل العميل المحتمل. وحيث لا يتوفر ربط مباشر مع منصتكم تحديداً، نبني طبقة مزامنة لتبقى بيانات الدورات وسجلات التسجيل في مكان واحد." },
  { question: "هل يتعامل مع استفسارات المتعلمين الأفراد والتدريب المؤسسي معاً؟", answer: "نعم، ويتعامل معهما بشكل مختلف. استفسارات الأفراد تُؤهَّل حسب الاهتمام بالدورة، وملاءمة الجدول، وطريقة الدفع المفضلة. واستفسارات الشركات تُؤهَّل حسب حجم المجموعة، والميزانية، والجدول الزمني، وجهة اتخاذ القرار، ثم تُوجَّه إلى مسار مبيعات الشركات لديكم بدلاً من مسار التسجيل المعتاد، لأن الاثنين نادراً ما يُغلقان بنفس الطريقة." },
  { question: "ماذا يحدث عندما يفوت طالب قسطاً في خطة الدفع؟", answer: "يرسل روبوت تذكير خطط الدفع تذكيراً قبل كل موعد استحقاق، وسلسلة متابعة إذا فات الدفع، ويصعّد الأمر إلى فريق المالية لديكم إذا لم يُحل بعد عدد محدد من المحاولات. هذا يلتقط حالات التعثر مبكراً بدلاً من أن يتأخر الطالب ثلاثة أقساط بصمت قبل أن يلاحظ أحد." },
  { question: "هل هذا مناسب إذا كنا خاضعين لهيئة المعرفة والتنمية البشرية؟", answer: "للمعاهد الخاضعة لهيئة المعرفة والتنمية البشرية أو جهة تنظيمية أخرى في الإمارات، تُبنى الأنظمة لتحترم متطلبات جهتكم التنظيمية بشأن سجلات التسجيل، والإفصاح عن اعتماد الدورات، والتعامل مع بيانات الطلاب. نراجع نقاط الامتثال المحددة معكم قبل تشغيل أي شيء، لأن المتطلبات تختلف حسب نوع المعهد والجهة التنظيمية." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لمعاهد التدريب في الإمارات",
    "url": "https://lenooai.com/ar/industries/training-institutes",
    "description": "أنظمة ذكاء اصطناعي مخصصة لمعاهد التدريب في الإمارات: تأهيل استفسارات الدورات، والتسجيل عبر واتساب، وتذكيرات الحصص، ومتابعة الشهادات، ومتابعة خطط الدفع.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Training Institutes"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي لمعاهد التدريب", "item": "https://lenooai.com/ar/industries/training-institutes" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لمعاهد التدريب في الإمارات"
  description="كيف تستخدم معاهد التدريب في الإمارات الذكاء الاصطناعي لتأهيل استفسارات الدورات، والتسجيل عبر واتساب، وتذكيرات الحصص، ومتابعة الشهادات، ومتابعة خطط الدفع."
  canonicalPath="/ar/industries/training-institutes"
  enPath="/industries/training-institutes"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.pexels.com/photos/3184328/pexels-photo-3184328.jpeg", alt: "مدرب يقدم عرضاً لمجموعة من المتدربين البالغين" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>معاهد التدريب</div>
  <h1>الأتمتة بالذكاء الاصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لمعاهد التدريب</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي لمعاهد التدريب في الإمارات: تأهيل استفسارات الدورات، والتسجيل عبر واتساب، وتذكيرات الحصص، ومتابعة خطط الدفع. ثنائية اللغة، ومربوطة بنظام إدارة التعلم، ومدعومة بضمان الاسترداد ١٠٠٪.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
    <button onclick="openModal(this)" data-source="ar_training_institutes_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء معاهد التدريب</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>

  <div slot="stats">
    <StatStrip stats={[
      { value: "٩×", caption: "احتمال أعلى لتحوّل الاستفسار عندما يُجاب خلال ٥ دقائق (MIT)" },
      { value: "+٢٠٠", caption: "جنسية تعيش في الإمارات، ومعظمهم يلجؤون إلى واتساب للاستفسار" },
      { value: "٢٤/٧", caption: "تغطية بالذكاء الاصطناعي لاستفسارات الدورات والتذكيرات ومتابعة الدفع" },
    ]} />
  </div>
</PageHero>

<!-- WHY TRAINING INSTITUTES & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا تتسرب استفسارات الدورات قبل التسجيل</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معظم الاستفسارات تصل عندما لا يكون أحد على المكتب للرد.</strong> طالب محتمل يتصفح الدورات مساءً، ويرسل رسالة واتساب أو يعبّئ نموذجاً، وينتظر. إذا جاء الرد صباح اليوم التالي، تكون لحظة الاهتمام قد مرت، ويكون جزء من هدف ملء الفصل قد ذهب إلى منافس رد أسرع.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>مسار الاستفسار إلى التسجيل فيه خطوات أكثر من اللازم.</strong> تفاصيل الدورة، وتأكيد الجدول، وهيكل الرسوم، وخيارات خطط الدفع، وجمع المستندات: كل خطوة فرصة لأن يصمت العميل المحتمل، خصوصاً عندما تتطلب مكالمة أو زيارة للمعهد بدلاً من رسالة يرد عليها من هاتفه.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>استفسارات الشركات والأفراد تحتاج تعاملاً مختلفاً تماماً.</strong> ولي أمر يسأل عن دورة نهاية الأسبوع ومدير موارد بشرية يبحث عن تدريب لثلاثين موظفاً ليسا نفس المحادثة، والتعامل معهما بنفس الطريقة يخسر الاثنين: الفرد يريد إجابة سريعة وبسيطة، والعميل المؤسسي يحتاج عملية تأهيل وعرض سعر مناسبة.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80&auto=format&fit=crop" alt="طلاب في فصل دراسي بمعهد تدريب في الإمارات أثناء جلسة دورة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لمعاهد التدريب</h2>
      <p>ستة أنظمة محددة تنشرها وكالتنا للذكاء الاصطناعي في دبي لمعاهد التدريب في أنحاء الإمارات، كل منها مربوط بنظام إدارة التعلم وسجلات التسجيل لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">quiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تأهيل استفسارات الدورات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن أسئلة الدورات فوراً ويطرح أسئلة التأهيل التي كان سيطرحها المرشد: ملاءمة الجدول، والميزانية، والخبرة السابقة، وتاريخ البدء المفضل، قبل توجيه العميل المحتمل إلى التسجيل أو إلى مرشد بشري.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">إجابة بمعلومات الدورة الصحيحة فوراً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد التسجيل عبر واتساب</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرشد العميل المحتمل المؤهل خلال هيكل الرسوم وخيارات خطط الدفع وجمع المستندات عبر واتساب، فيكتمل التسجيل دون زيارة للمعهد أو مكالمة هاتفية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تسجيل مكتمل دون زيارة للمعهد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نظام تذكير الحصص والحضور</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكيرات قبل كل جلسة، ويتابع الحضور مقابل سجلات التسجيل، وينبّه إلى الطلاب المتأخرين في الحضور قبل أن يتحول ذلك إلى خطر انسحاب.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تراجع الحضور يُلتقط مبكراً، لا في نهاية الفصل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">workspace_premium</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متابعة الشهادات وإتمام الدورات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبلغ الخريجين عند جاهزية شهاداتهم، ويتابع أي متطلبات متبقية، ويتواصل معهم لاحقاً بدورات المستوى التالي ذات الصلة بما أتموه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الخريجون يسمعون منكم مجدداً قبل أن ينسوا وجودكم</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">payments</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تذكير خطط الدفع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يرسل تذكيرات قبل موعد كل قسط، وسلسلة متابعة لحظة فوات الدفع، ويصعّد الأمر إلى المالية إذا بقي دون حل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الدفعات الفائتة تُلتقط بعد قسط واحد، لا ثلاثة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">business_center</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مؤهّل العملاء المحتملين للتدريب المؤسسي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يوجّه استفسارات الشركات عبر مسار تأهيل منفصل: حجم المجموعة، والميزانية، والجدول الزمني، وجهة اتخاذ القرار، ويسلّم فريق مبيعات الشركات لديكم ملخصاً محدد النطاق بدلاً من عميل محتمل عام.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">استفسارات الشركات تصل إلى المبيعات مع ملخص حقيقي مرفق</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة ثنائية اللغة ومربوطة بنظام إدارة التعلم وسجلات التسجيل لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_training_institutes_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء معاهد التدريب</button>
    </div>
  </div>
</section>

<!-- ENQUIRY JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="ti-journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="ti-journey-heading">استفسار واحد، من البداية حتى التسجيل</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول سؤال حتى تأكيد المقعد، بينما يركز فريقكم على تقديم الدورة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">إجابة بمعلومات الدورة الصحيحة فوراً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">طالب محتمل يرسل سؤالاً عن دورة، في أي ساعة، على أي قناة. والذكاء الاصطناعي جاهز بالفعل.</p>
        <ul class="journey-list">
          <li>يرد بتفاصيل الدورة والجدول والرسوم بدقة، بالعربية أو الإنجليزية</li>
          <li>يطرح الأسئلة التي تحدد الجدية: الجدول الزمني، والخبرة السابقة، والميزانية</li>
          <li>يوجّه استفسارات الأفراد والشركات إلى المسار الصحيح من الرسالة الأولى</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تسجيل مكتمل دون زيارة للمعهد</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تأكيد الاهتمام، يحافظ الذكاء الاصطناعي على الزخم نحو مقعد محجوز بدلاً من محادثة متوقفة.</p>
        <ul class="journey-list">
          <li>يشارك خيارات خطط الدفع ويجمع المستندات المطلوبة عبر واتساب</li>
          <li>يؤكد المقعد ويرسل تعليمات الانضمام لحظة إتمام الدفع</li>
          <li>يحوّل فوراً إلى مرشد بشري أي شيء خارج المسار المعتاد</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">التذكير الذي يحافظ على الحضور</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">التسجيل ليس خط النهاية. الذكاء الاصطناعي يستمر في العمل طوال الدورة نفسها.</p>
        <ul class="journey-list">
          <li>يرسل تذكيراً قبل كل جلسة، مرفقاً بتفاصيل الانضمام</li>
          <li>ينبّه إلى الطلاب الذين يتراجع حضورهم قبل أن يتحول ذلك إلى انسحاب</li>
          <li>يتابع أقساط الدفع فلا تلاحق المالية الأرصدة يدوياً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">quiz</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحويل الاستفسارات إلى تسجيلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">هذا هو المسار الذي تخسر فيه معظم المعاهد أكبر قدر من الإيرادات. كل خطوة تتطلب مكالمة هاتفية أو زيارة للمعهد بدلاً من رسالة سريعة هي خطوة قد يختفي فيها العميل المحتمل بصمت. سد هذه الفجوة هو التغيير الأعلى أثراً الذي تستطيع معظم المعاهد إجراءه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل استفسار يحصل على إجابة فورية ودقيقة، دون استثناء</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الحضور</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التذكيرات المنتظمة والتنبيهات المبكرة بتراجع الحضور تُحدث فرقاً قابلاً للقياس في عدد الطلاب المسجلين الذين يتمون الدورة فعلاً، وهذا مهم للنتائج ولأرقام الإتمام الخاصة بالمعهد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكيرات الجلسات تُرسل تلقائياً، لكل حصة ولكل طالب</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">workspace_premium</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التسجيل المتكرر والإحالات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الخريج الذي يسمع من المعهد مجدداً، بدورة تالية مناسبة أو حافز للإحالة، أكثر احتمالاً بكثير للتسجيل مجدداً أو إرسال شخص آخر من خريج لا يسمع من المعهد أبداً بعد حصوله على شهادته.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الخريجون يُتابَعون تلقائياً بدلاً من أن يسقطوا من القائمة</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">الربط مع نظام إدارة التعلم</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">جداول الدورات والمقاعد المتاحة وسجلات التسجيل يجب أن تكون في نظام إدارة التعلم لديكم، والذكاء الاصطناعي يقرأ منه ويكتب فيه مباشرة. نظام حجز يعمل منفصلاً عن نظام إدارة التعلم يخلق إدخالاً مزدوجاً ويُهمل في النهاية.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">مراعاة هيئة المعرفة أو الجهة التنظيمية حيث ينطبق</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">المعاهد العاملة تحت هيئة المعرفة والتنمية البشرية أو جهة تنظيمية أخرى في الإمارات تحتاج أن يعكس التسجيل وحفظ السجلات المتطلبات المحددة لتلك الجهة. يُضبط الذكاء الاصطناعي حول وضع الاعتماد الفعلي لمعهدكم، لا حول قالب عام.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">قاعدة متعلمين متعددة اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">استفسارات معهد التدريب تأتي من مجتمع متنوع فعلاً في الإمارات. روبوت لا يتعامل إلا مع الاستفسارات بالإنجليزية يخسر حصة معتبرة من الاهتمام قبل أن يُؤهَّل أصلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">متابعة خطط الدفع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">كثير من الطلاب يسجلون بخطط تقسيط. متابعة مواعيد استحقاق كل خطة والتقاط الدفعة الفائتة بعد قسط واحد، لا ثلاثة، هو الفرق بين وضع قابل للاسترداد ورصيد يُشطب.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تقوله البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=1200&q=80&auto=format&fit=crop" alt="طلاب يدرسون في معهد تدريب بالإمارات" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٩×</p>
        <p style="color:#42474e; font-size:0.875rem;">احتمال أعلى لتحوّل الاستفسار عندما يُجاب خلال ٥ دقائق (MIT)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">+٢٠٠</p>
        <p style="color:#42474e; font-size:0.875rem;">جنسية تعيش في الإمارات، وينعكس ذلك في قاعدة المتعلمين لدى معظم المعاهد</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٢٤/٧</p>
        <p style="color:#42474e; font-size:0.875rem;">تغطية للاستفسارات وتذكيرات الحصص ومتابعة الدفع</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">تسرب الاستفسارات</p>
          <p style="color:#42474e; line-height:1.7;">المعاهد التي نتحدث معها تصف باستمرار نفس الانسحاب: زيارات قوية من الإعلانات أو الإحالات إلى مرحلة الاستفسار، ثم تراجع حقيقي قبل التسجيل، يتركز تحديداً في النقاط التي تتطلب مكالمة أو زيارة بدلاً من رسالة سريعة. نتيجة MIT حول سرعة الرد خلال ٥ دقائق تنطبق مباشرة على ذلك: الاهتمام الذي لا يُجاب بسرعة يتلاشى قبل أن يتحول.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">الحضور والإتمام</p>
          <p style="color:#42474e; line-height:1.7;">معدلات إتمام الدورات ترتبط ارتباطاً وثيقاً بالحضور، والحضور يرتبط ارتباطاً وثيقاً بالتذكيرات. المعاهد التي تشغّل تذكيرات جلسات آلية ومنتظمة تصف اختفاء عدد أقل بشكل ملحوظ من الطلاب بصمت في منتصف الدورة مقارنة بالاعتماد على تذكر الطلاب لجداولهم بأنفسهم.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">القناة المفضلة</p>
          <p style="color:#42474e; line-height:1.7;">واتساب هو القناة الافتراضية التي يلجأ إليها معظم الطلاب المحتملين في الإمارات أولاً، قبل المكالمة الهاتفية أو نموذج البريد الإلكتروني. استقبال الاستفسارات على تلك القناة، وباللغة التي بدؤوا بها، يلغي خطوة لا تدرك معظم المعاهد أنها تكلفها عملاء محتملين.</p>
        </div>
      </div>
    </div>
  </div>
</section>

