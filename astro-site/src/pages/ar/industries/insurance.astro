---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "هل يمكن تفسير قرارات الاكتتاب بالذكاء الاصطناعي للجهة الرقابية؟", answer: "يجب أن يكون ذلك ممكناً، ولهذا نبنيها على هذا الأساس. كل نموذج اكتتاب ننشره ينتج سبباً موثقاً لمخرجاته، لا درجة فقط، فيستطيع فريقكم الدفاع عن القرار وفق متطلبات الجهات المنظمة للتأمين في الإمارات." },
  { question: "كيف يكشف الذكاء الاصطناعي احتيال التأمين فعلياً؟", answer: "تُدرَّب النماذج على بيانات المطالبات التاريخية لرصد الأنماط المرتبطة بالمطالبات الاحتيالية: تفاصيل غير متسقة، أو توقيت غير معتاد، أو أنماط مطالبات تطابق أنواع احتيال معروفة. المطالبات المنبَّه إليها تذهب إلى محقق بشري، فالذكاء الاصطناعي يضيّق المجموعة ولا يتخذ القرار النهائي." },
  { question: "هل ستبطئ أتمتة المطالبات المطالبات الشرعية أثناء التحقق من الاحتيال؟", answer: "لا، بل تسرّعها. غالبية المطالبات شرعية وبسيطة، فتعالجها الأتمتة أسرع بينما توجّه العدد الأصغر من المطالبات المنبَّه إليها أو غير المعتادة إلى مراجعة أدق. معظم العملاء يحصلون على تعويضاتهم أسرع، لا أبطأ." },
  { question: "هل يتعامل روبوت محادثة خدمة العملاء مع أسئلة الوثائق بالعربية؟", answer: "نعم. استفسارات الوثائق، وتذكيرات التجديد، وتحديثات حالة المطالبات تُعالج بالعربية والإنجليزية، بما يطابق طريقة تواصل شركات التأمين في الإمارات مع عملائها فعلاً." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_insurance')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات التأمين في الإمارات",
    "url": "https://lenooai.com/ar/industries/insurance",
    "description": "أنظمة ذكاء اصطناعي مخصصة لشركات التأمين في الإمارات: أتمتة معالجة المطالبات، والاكتتاب بالذكاء الاصطناعي، وكشف الاحتيال، وروبوتات محادثة ثنائية اللغة لخدمة العملاء.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Insurance"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للتأمين", "item": "https://lenooai.com/ar/industries/insurance" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات التأمين في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لشركات التأمين في الإمارات: أتمتة المطالبات، والاكتتاب بالذكاء الاصطناعي، وكشف الاحتيال، وروبوتات محادثة للعملاء."
  canonicalPath="/ar/industries/insurance"
  enPath="/industries/insurance"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.unsplash.com/photo-1642522029686-5485ea7e6042?w=1600&h=320&q=80&auto=format&fit=crop", alt: "مسوّي مطالبات تأمين يراجع نموذج مطالبة على مكتب", position: "center 35%" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التأمين</div>
  <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">لشركات التأمين في الإمارات</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لشركات التأمين في الإمارات: أتمتة معالجة المطالبات، والاكتتاب بالذكاء الاصطناعي، وكشف الاحتيال، وخدمة عملاء ثنائية اللغة. مبنية لترضي فريق الامتثال لديكم وتسرّع المطالبات الصادقة في الوقت نفسه.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
    <button onclick="openModal(this)" data-source="ar_insurance_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التأمين</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>
  <StatStrip stats={[
    { value: "من أسابيع إلى أيام", caption: "التحسن المعتاد في مدة معالجة المطالبات مع الأتمتة بالذكاء الاصطناعي" },
    { value: "+٣٠٠ مليار $", caption: "التكلفة السنوية المقدّرة لاحتيال التأمين عبر كل الفروع على مستوى القطاع (Coalition Against Insurance Fraud)" },
    { value: "٢٤/٧", caption: "دعم لاستفسارات الوثائق وحالة المطالبات عبر روبوت محادثة ثنائي اللغة" },
  ]} />

</PageHero>

<!-- WHY INSURANCE & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا التأمين من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>معالجة المطالبات كثيفة المستندات وبطيئة بطبيعتها.</strong> مطالبة واحدة قد تتضمن نماذج وصوراً وتقارير شرطة وسجلات طبية. أدوات الاستخراج والتحقق بالذكاء الاصطناعي تعالج الغالبية البسيطة تلقائياً، فتختصر المدة من أسابيع إلى أيام.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الاحتيال تكلفة ضخمة ومستمرة.</strong> يُقدَّر أن احتيال التأمين يكلف القطاع مئات المليارات من الدولارات سنوياً عبر كل الفروع. نماذج الذكاء الاصطناعي المدرَّبة على أنماط المطالبات تكشف مؤشرات احتيال لا تستطيع المراجعة اليدوية على نطاق واسع كشفها ببساطة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>سرعة الاكتتاب ميزة تنافسية.</strong> يتوقع العملاء بشكل متزايد عرض سعر خلال دقائق، لا أيام. تقييم المخاطر بمساعدة الذكاء الاصطناعي يسرّع الاكتتاب مع إبقاء كل قرار قابلاً للتفسير للجهة الرقابية.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1773126378915-793b5c48fb38?w=800&q=80&auto=format&fit=crop" alt="زوجان يراجعان وثيقة تأمين ويوقعانها على مكتب" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات التأمين في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي لشركات التأمين، مربوطة بأنظمة إدارة الوثائق والمطالبات لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استقبال المطالبات ومعالجة المستندات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يستخرج البيانات ويتحقق منها من نماذج المطالبات والصور والمستندات الداعمة تلقائياً، ويوجّه المطالبات البسيطة للموافقة السريعة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل إدخال البيانات اليدوي لغالبية المطالبات الروتينية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقييم مخاطر الاكتتاب الآلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقيّم مخاطر المتقدمين باستخدام بيانات الوثيقة، والبيانات البديلة حيث تتوفر، مع توثيق كل مخرج لمراجعة الامتثال.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مخرجات قابلة للتفسير يستطيع فريق الاكتتاب الدفاع عنها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gpp_maybe</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كشف الاحتيال في المطالبات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينبّه إلى المطالبات ذات الخصائص المرتبطة بأنماط احتيال معروفة، ويوجهها إلى المحققين بينما تمر المطالبات الشرعية أسرع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على بيانات مطالباتكم التاريخية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة لخدمة العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب عن أسئلة الوثائق، ويقدم تحديثات حالة المطالبات، ويتولى تذكيرات التجديد بالعربية والإنجليزية، على مدار الساعة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل حجم الاتصالات بمركز الخدمة لأسئلة الوثائق الروتينية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إصدار مستندات الوثائق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصدر مستندات الوثائق والملاحق من قرارات الاكتتاب تلقائياً، فيقل الإعداد اليدوي والأخطاء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">صياغة وثائق ثابتة ودقيقة في كل مرة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">trending_down</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقع التجديد والاحتفاظ بالعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينبّه إلى حاملي الوثائق الذين تظهر عليهم علامات خطر المغادرة قبل التجديد، فيمنح فريق الاحتفاظ وقتاً للتدخل قبل رحيلهم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يوجّه جهود الاحتفاظ حيث تهم فعلاً</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة متوافقة مع أنظمة الإمارات، ثنائية اللغة، ومربوطة بأنظمة إدارة الوثائق والمطالبات لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_insurance_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء التأمين</button>
    </div>
  </div>
</section>

<!-- HOW WE WORK WITH YOUR TEAM -->
<section class="section" aria-labelledby="insurance-team-heading">
  <div class="container">
    <div class="split-grid split-media-right">
      <div>
        <h2 id="insurance-team-heading" style="margin-bottom:1.5rem;">مبني مع فريق المطالبات والامتثال لديكم، لا من حوله</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">كل مشروع يبدأ مع مسوّي المطالبات والمكتتبين ومسؤولي الامتثال المسؤولين عن سير العمل الذي نغيّره. يشاركون في جلسات التصميم من الأسبوع الأول، لا عند الموافقة النهائية فقط، فيعكس النظام طريقة اتخاذ قرارات المطالبات فعلاً في شركتكم.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">يشمل ذلك توثيق منطق النموذج بلغة يستطيع فريق الامتثال لديكم الدفاع عنها أمام الجهة الرقابية، لا مجرد كود يقرؤه مهندسوكم. إنها طريقة أبطأ للبدء، وطريقة أسرع بكثير للوصول إلى نظام يثق به موظفو المطالبات ويستخدمونه فعلاً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1775163024488-e88e4a71179f?w=800&h=600&q=80&auto=format&fit=crop" alt="فريق مكتب يراجع المستندات معاً على طاولة" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في التأمين</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">assignment</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">معالجة المطالبات الآلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الاستخراج والتحقق بالذكاء الاصطناعي تعالج غالبية المطالبات الروتينية تلقائياً، وتُبقي وقت المسوّين البشريين للحالات المعقدة أو المتنازع عليها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">من أوسع استخدامات الذكاء الاصطناعي تبنّياً في التأمين</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">verified</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الاكتتاب بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تقييم المخاطر تعالج الطلبات أسرع من الاكتتاب اليدوي مع دمج نطاق أوسع من إشارات المخاطر ذات الصلة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تختصر مدة الاكتتاب من أيام إلى دقائق للوثائق القياسية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gpp_maybe</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">كشف الاحتيال</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج مطابقة الأنماط تنبّه إلى المطالبات التي تحمل مؤشرات احتيال للتحقيق فيها، فتعالج تكلفة يقدّرها القطاع بمئات المليارات سنوياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقدَّر أن احتيال التأمين يكلف أكثر من ٣٠٠ مليار دولار سنوياً عبر كل الفروع (CAIF)</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">query_stats</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">نماذج تقييم المخاطر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">النماذج التنبؤية تقيّم مخاطر الممتلكات والصحة والمسؤولية بتفصيل أدق من الجداول الاكتوارية التقليدية وحدها، فتتحسن دقة التسعير.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تحسّن دقة التسعير في معظم فروع التأمين الرئيسية</p>
