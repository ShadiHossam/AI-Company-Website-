<script>
  const insuranceToggleWrap = document.querySelector('.insurance-toggle');
  if (insuranceToggleWrap) {
    const btns = insuranceToggleWrap.querySelectorAll('.insurance-toggle-btn');
    const panels = document.querySelectorAll('[data-insurance-tier-panel]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-insurance-tier');
        btns.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
        panels.forEach((p) => { (p as HTMLElement).hidden = p.getAttribute('data-insurance-tier-panel') !== key; });
      });
    });
  }
</script>
