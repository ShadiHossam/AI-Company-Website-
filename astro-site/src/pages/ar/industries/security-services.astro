---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const faqItems = [
  { question: "هل يتتبع النظام فعلاً انتهاء ترخيص SIRA، أم يخزن الشهادة كملف فقط؟", answer: "يتتبع تاريخ الانتهاء كبيانات منظمة، لا كملف PDF ممسوح موضوع في مجلد. ينبّه النظام إلى التجديدات قبل ٣٠ و١٤ و٧ أيام، ويستطيع منع إدراج حارس في جدول موقع بعد انتهاء ترخيصه، فلا تمر شهادة منتهية بهدوء إلى وردية. ويرى مدير العمليات لديكم كل التجديدات القادمة بنظرة واحدة بدلاً من ملاحقة الأوراق يدوياً." },
  { question: "ما مدى دقة تحويل الصوت إلى تقرير عندما يبلّغ الحارس من الميدان، ربما في ظروف صاخبة أو بلغة ثانية؟", answer: "الدقة تعتمد على جودة الصوت وطريقة صياغة الحارس للتقرير، لذلك نبني توجيهاً منظماً: يُرشد الحارس خلال ما يجب تغطيته (ماذا حدث، ومتى، وأين، ومن المعني) بدلاً من الإملاء الحر. ومسودة التقرير تُراجع دائماً قبل اعتمادها وإرسالها للعميل، فتُلتقط الكلمة المسموعة خطأً قبل أن تصل إلى تقرير مستوى الخدمة، لا بعده." },
  { question: "من يستطيع فعلاً رؤية بوابة تقارير مستوى الخدمة الموجهة للعملاء، وهل يرى عميل بيانات عميل آخر؟", answer: "الوصول محدد لكل حساب عميل، ومرتبط بقائمة عملائكم الحالية، فلا يرى كل عميل إلا مواقعه وحوادثه وتقاريره. وداخلياً، الوصول مبني على الأدوار أيضاً: مشرف الموقع يرى مواقعه، ومدير الحساب يرى محفظته، وقيادة العمليات وحدها ترى كل شيء. هذا يعكس بنية علاقاتكم الحالية مع العملاء، ولا ينشئ نموذج وصول جديداً من الصفر." },
];

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الأتمتة بالذكاء الاصطناعي لشركات الأمن والقوى العاملة في الإمارات",
    "url": "https://lenooai.com/ar/industries/security-services",
    "description": "أنظمة ذكاء اصطناعي مخصصة لشركات الأمن والقوى العاملة في الإمارات: جدولة الحراس، وأتمتة تقارير الحوادث، وتقارير مستوى الخدمة للعملاء، وتتبع تراخيص SIRA.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "تطوير الذكاء الاصطناعي للخدمات الأمنية"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للخدمات الأمنية", "item": "https://lenooai.com/ar/industries/security-services" }
    ]
  }
];
---

<ArBaseLayout
  title="الأتمتة بالذكاء الاصطناعي لشركات الأمن في الإمارات"
  description="كيف تستخدم شركات الأمن والقوى العاملة في الإمارات الذكاء الاصطناعي لجدولة الحراس، وتقارير الحوادث، وتقارير مستوى الخدمة للعملاء، وتتبع تراخيص SIRA."
  canonicalPath="/ar/industries/security-services"
  enPath="/industries/security-services"
  ogImage="/assets/og-home.jpg"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الخدمات الأمنية</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لشركات الأمن والقوى العاملة في دبي</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لشركات الأمن والقوى العاملة في الإمارات: جدولة الحراس، وأتمتة تقارير الحوادث من الصوت أو الصور، وتقارير مستوى الخدمة للعملاء، وتتبع تراخيص SIRA. مبنية للعمليات متعددة المواقع والورديات.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_security_services_hero" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في الخدمات الأمنية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
  </div>
</header>

<!-- HERO IMAGE -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1600&q=80&auto=format&fit=crop" alt="فريق أمن ينسق توزيع الورديات في موقع في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.15) 55%),linear-gradient(135deg,rgba(0,104,117,0.15),rgba(0,37,59,0.25));"></div>
  <div style="position:relative; padding:3.25rem 2rem;">
    <StatStrip stats={[
      { value: "٠", caption: "رسائل جماعية مطلوبة لسد فجوة في الجدول، فالنظام يجد المتاح بنفسه" },
      { value: "24/7", caption: "الإبلاغ عن الحوادث من الميدان، بالصوت أو الصورة، لا أوراق بعد الوردية" },
      { value: "١", caption: "بوابة عملاء تُبنى فيها تقارير مستوى الخدمة تلقائياً من البيانات المسجلة" },
    ]} />
  </div>
</div>

<!-- WHY ROSTERING AND REPORTING ARE WHERE COMPANIES LOSE MARGIN -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الجدولة والتقارير هي حيث تخسر شركات الأمن هامشها فعلاً</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الجدولة عبر مواقع وورديات متعددة مشكلة جدولة لا مشكلة تواصل، لكن معظم الشركات لا تزال تديرها كأنها كذلك.</strong> المشرف الذي يبث فجوة في وردية إلى مجموعة واتساب ويأمل أن يتطوع أحد يعمل ببطء، ويعرّض موقعاً غير مغطى للخطر بينما الرسالة لم تُقرأ. القيد الفعلي هو معرفة من المرخص والمتاح والقريب بما يكفي من الموقع، ومطابقة ذلك تلقائياً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تقارير الحوادث المكتوبة بعد ساعات تفقد دقتها، والدقة هي الغاية كلها من تقرير الحادث.</strong> الحارس الذي ينتظر نهاية الوردية ليكتب الحادث على الورق يعيد بناء التفاصيل من ذاكرته. أما النظام الذي يلتقط التقرير في اللحظة، من ملاحظة صوتية أو صورة في الموقع، فيبقي السجل أقرب إلى ما حدث فعلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>تقارير مستوى الخدمة للعملاء عمل إداري يدوي يستهلك وقت مديري الحسابات كل شهر.</strong> تجميع سجلات الحضور وسجلات الحوادث وأوقات الاستجابة في تقرير لكل عميل عمل متكرر ومستهلك للوقت، وهو بالضبط نوع تحويل البيانات المنظمة إلى مستند الذي يجب أن يؤديه النظام تلقائياً بدلاً من مدير حساب يدوياً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=800&q=80&auto=format&fit=crop" alt="مشرف أمن يراجع تغطية المواقع على جهاز لوحي" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات الأمن والقوى العاملة في الإمارات</h2>
      <p>ستة أنظمة محددة تبنيها وكالتنا للذكاء الاصطناعي في دبي لشركات الأمن في أنحاء الإمارات، كل منها مبني للعمليات متعددة المواقع والورديات.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد جدولة الحراس والورديات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبني الجدول ويملؤه عبر كل موقع ووردية، مطابقاً ترخيص الحراس وتوافرهم تلقائياً، ويسد الفجوات الطارئة دون رسالة جماعية للفريق كله.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يطابق الحراس المرخصين والمتاحين مع الورديات الشاغرة تلقائياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">mic</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تقارير الحوادث (من الصوت أو الصورة إلى تقرير)</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يسجل الحارس ملاحظة صوتية أو يلتقط صورة في الموقع، فيصيغ النظام تقرير حادث منظماً خلال دقائق، يُراجع قبل اعتماده ومشاركته مع العميل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُلتقط في الموقع، لا يُعاد بناؤه من الذاكرة بعد ساعات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت تقارير مستوى الخدمة للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينشئ تقرير مستوى الخدمة الشهري لكل عميل تلقائياً من بيانات الحضور والحوادث وأوقات الاستجابة المسجلة أصلاً في نظامكم، دون حاجة لتجميع يدوي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُبنى من البيانات المسجلة، لا من جدول بيانات يُجمع يدوياً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">how_to_reg</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التحقق من الحضور وتسجيل الدخول إلى المواقع</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتحقق من أن الحارس سجّل حضوره فعلاً في الموقع والوقت الصحيحين، باستخدام الموقع الجغرافي وتأكيد الصورة، فتكون سجلات الحضور دقيقة قبل أن تدخل في الرواتب أو فواتير العملاء.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">بيانات الحضور الموثقة تدخل مباشرة في الرواتب والفوترة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">متتبع تجديد التراخيص والشهادات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتتبع تراخيص SIRA والشهادات الأخرى كبيانات منظمة، وينبّه إلى التجديدات القادمة قبل وقت كافٍ، ويستطيع منع إدراج حارس في الجدول بعد انتهاء ترخيصه.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">ينبّه إلى التجديدات قبل ٣٠ و١٤ و٧ أيام، قبل انتهائها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت التواصل مع العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتولى طلبات العملاء الروتينية، مثل تأكيدات التغطية وطلبات تغيير الجدول وتحديثات الحالة، عبر قناة يستخدمها عملاؤكم أصلاً، فيتفرغ مديرو الحسابات للمحادثات الأعلى قيمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الطلبات الروتينية تُنجز فوراً، دون مدير حساب في كل محادثة</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل نظام مبني للعمليات متعددة المواقع والورديات، مع تتبع تراخيص SIRA مدمج من اليوم الأول.</p>
      <button onclick="openModal(this)" data-source="ar_security_services_mid" class="btn-primary">احجزوا تقييماً مجانياً للذكاء الاصطناعي في الخدمات الأمنية</button>
    </div>
  </div>
</section>

<!-- ONE SHIFT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">وردية واحدة، من الجدول إلى التقرير</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، فيقضي المشرفون وقتاً أقل في الملاحقة ووقتاً أكثر في إدارة المواقع.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الجدول يُبنى ويُبلَّغ دون عاصفة رسائل جماعية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">جدول الأسبوع القادم يُبنى تلقائياً، مطابقاً للتراخيص والتوافر، قبل أن يصل إلى أي مجموعة محادثة.</p>
        <ul class="journey-list">
          <li>كل حارس يرى وردياته، مرسلة إليه منفرداً، لا مدفونة في رسالة جماعية</li>
          <li>الفجوات الطارئة تُسد بمطابقة الحراس المتاحين والمرخصين القريبين، لا ببث رسالة وانتظار</li>
          <li>المشرفون يرون تغطية المواقع كاملة بنظرة واحدة بدلاً من مراجعة جدول بيانات</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير الحادث يُقدَّم من ملاحظة صوتية في الميدان</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">يحدث شيء في الموقع، فيبلّغ عنه الحارس في المكان نفسه، لا في نهاية الوردية.</p>
        <ul class="journey-list">
          <li>التقاط موجه بالصوت أو الصورة في الموقع، منظم حول ماذا ومتى وأين ومن</li>
          <li>مسودة التقرير تُنشأ خلال دقائق، ويراجعها مشرف قبل اعتمادها</li>
          <li>العميل يُبلَّغ فوراً إذا بلغ الحادث حد الإبلاغ في اتفاقية مستوى الخدمة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير العميل الذي يُنشئ نفسه شهرياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">في نهاية الشهر، يكون تقرير مستوى الخدمة مجمعاً أصلاً مما سُجل خلال الشهر.</p>
        <ul class="journey-list">
          <li>الحضور وأعداد الحوادث وأوقات الاستجابة تُسحب من البيانات المسجلة تلقائياً</li>
          <li>مدير الحساب يراجع ويضيف السياق قبل إرساله للعميل</li>
          <li>العميل يستطيع أيضاً مراجعة بوابته مباشرة، بدلاً من انتظار البريد الشهري</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الجدولة عبر عشرات المواقع وأنماط الورديات هي حيث يظهر الضغط التشغيلي أولاً. الغياب الطارئ الذي لا يُسد بسرعة كافية يعني موقعاً غير مغطى ومحادثة مع العميل لا يريدها أحد. المطابقة الآلية مع التراخيص والتوافر تسد هذه الفجوة أسرع من مشرف يعمل على قائمة هواتف.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يسد الفجوات بمطابقة الحراس المرخصين والمتاحين، لا بالبث والأمل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">mic</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الإبلاغ عن الحوادث</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تقارير الحوادث المكتوبة من الذاكرة بعد ساعات أضعف باستمرار من التي تُلتقط في الموقع. الالتقاط بالصوت والصورة في الميدان يبقي التفاصيل أقرب إلى ما حدث فعلاً، ويوصل التقرير إلى العميل أسرع حين يكون الأمر أهم.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقارير تُصاغ خلال دقائق من الموقع، لا بعد ساعات على الورق</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير مستوى الخدمة للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تقارير مستوى الخدمة الشهرية هي أكثر مهمة إدارية تكراراً يتولاها مدير الحساب، وهي بالضبط نوع تحويل البيانات المنظمة إلى مستند الذي يؤديه النظام أسرع وبثبات أكبر من شخص يجمع من ثلاثة سجلات مختلفة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يفرّغ مديري الحسابات لإدارة العلاقات، لا جداول البيانات</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما يجعلها تنجح</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">١</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تعقيد المواقع والورديات المتعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">شركة أمن تدير عشرين موقعاً عبر ثلاثة أنماط ورديات لديها مشكلة جدولة أعقد بكثير من نشاط في موقع واحد. نظام الجدولة يحتاج أن يحيط بكل موقع ووردية ومتطلب ترخيص في آن واحد، لا بتكليفات اليوم التالي فقط.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٢</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إدخال مناسب للميدان (صوت، صورة، مناسب لمحدودي القراءة والكتابة)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحراس في الميدان لا يجلسون إلى مكتب، وليس كل حارس مرتاحاً لكتابة تقرير مفصل بلغته الثانية أو الثالثة. الالتقاط بالصوت والصورة، بتوجيه من أسئلة منظمة بسيطة، يستخرج تقريراً قابلاً للاستخدام من شخص كان سيجد صعوبة في كتابته من نموذج فارغ.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٣</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تتبع تراخيص SIRA والتراخيص التنظيمية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تشغيل حارس في الجدول بترخيص SIRA منتهٍ خطر امتثال تتحمله الشركة، لا مجرد سهو إداري. تتبع التجديد يجب أن يكون مبنياً في منطق الجدولة نفسه، فيمنع الترخيص المنتهي إسناد الوردية تلقائياً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">٤</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">بوابة تقارير موجهة للعملاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">العملاء يتوقعون أكثر فأكثر أن يراجعوا التغطية وحالة الحوادث بأنفسهم، بدلاً من انتظار بريد شهري. البوابة المحصورة بدقة في مواقع كل عميل وبياناته تبني الثقة وتقلل مكالمات الاستفسار عن الحالة إلى فريق حساباتكم.</p>
      </div>
    </div>
  </div>
</section>

