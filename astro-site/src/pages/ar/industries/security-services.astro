---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات الأمن والقوى العاملة في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/security-services",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "خدمات الأمن", "item": "https://lenooai.com/ar/industries/security-services" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات الأمن والقوى العاملة في الإمارات",
    "description": "جدولة حراس، أتمتة تقارير حوادث، تقارير اتفاقية مستوى خدمة للعملاء، ومتابعة تراخيص هيئة الأمن الخاصة لشركات الأمن في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يتابع النظام فعلياً انتهاء ترخيص هيئة الأمن الخاصة، أم يُخزّن الشهادة كملف فقط؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يتابع تاريخ الانتهاء كبيانات منظّمة، لا مجرد PDF ممسوح في مجلد. النظام يُنبّه للتجديد قبل ٣٠ و١٤ و٧ أيام، ويستطيع منع جدولة حارس بمجرد انتهاء ترخيصه، فلا تنزلق شهادة منتهية بصمت لدوام." }
      },
      {
        "@type": "Question",
        "name": "ما مدى دقة تحويل الصوت لتقرير حين يُبلّغ حارس من الميدان؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الدقة تعتمد على جودة الصوت وصياغة الحارس، لذا نبني موجّهاً منظماً: يُرشَد الحارس لما يجب تغطيته (ماذا حدث، متى، أين، من كان متورطاً) بدل إملاء حر. المسودة تُراجَع دائماً قبل اعتمادها وإرسالها للعميل." }
      },
      {
        "@type": "Question",
        "name": "من يستطيع رؤية بوابة تقارير اتفاقية مستوى الخدمة، وهل يرى عميل بيانات عميل آخر؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الوصول محدد حسب حساب العميل، مرتبط بقائمة عملائكم الحالية، فيرى كل عميل مواقعه وحوادثه وتقاريره فقط. داخلياً، الوصول أيضاً حسب الدور: مشرف الموقع يرى مواقعه، مدير الحساب يرى محفظته." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات الأمن والقوى العاملة في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني جدولة حراس وأتمتة تقارير حوادث ومتابعة تراخيص هيئة الأمن الخاصة لشركات الأمن في الإمارات، مبنية لعمليات متعددة المواقع."
  canonicalPath="/ar/industries/security-services"
  enPath="/industries/security-services"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>خدمات الأمن</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">security</span>
      خدمات الأمن والقوى العاملة
    </div>
    <h1>ذكاء اصطناعي لشركات الأمن في الإمارات<br><span class="gradient-text">الجدولة والتقارير هما حيث يُفقَد الهامش فعلياً</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      رسالة بث لمجموعة واتساب بأمل تطوّع أحد بطيئة وتُعرّض الموقع للخطر. نبني لك نظاماً يُجدول الحراس تلقائياً حسب الترخيص والتوفر، يُسوّد تقرير حادث من ملاحظة صوتية، ويُتابع تجديد تراخيص هيئة الأمن الخاصة.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_security_services_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1600&q=80&auto=format&fit=crop" alt="فريق أمن ينسّق تعيينات الدوام في موقع إماراتي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">صفر</p>
        <p class="stat-lbl">رسائل بث مطلوبة لسد فجوة جدولة، النظام يجد المتاح</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">إبلاغ حوادث من الميدان، صوت أو صورة، لا أوراق بعد الدوام</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">بوابة واحدة</p>
        <p class="stat-lbl">تقارير اتفاقية مستوى الخدمة تبني نفسها من البيانات المُسجَّلة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة الأمن</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية لعمليات متعددة المواقع ومتعددة الدوامات.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">calendar_month</span>
        <h3>مساعد جدولة الحراس والدوامات</h3>
        <p style="color:#42474e;line-height:1.7;">يبني ويملأ الجدول عبر كل موقع ودوام، مطابقاً شهادة الحارس وتوفره تلقائياً، ويملأ الفجوات دون رسالة بث.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">mic</span>
        <h3>أتمتة تقارير الحوادث (صوت/صورة لتقرير)</h3>
        <p style="color:#42474e;line-height:1.7;">حارس يُسجّل ملاحظة صوتية أو يلتقط صورة بالموقع، والنظام يُسوّد تقرير حادث منظماً خلال دقائق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">monitoring</span>
        <h3>بوت تقارير اتفاقية مستوى خدمة للعملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يُولّد تقرير اتفاقية مستوى الخدمة الشهري لكل عميل تلقائياً من بيانات الحضور والحوادث المُسجَّلة بالفعل.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">how_to_reg</span>
        <h3>التحقق من الحضور وتسجيل الدخول بالموقع</h3>
        <p style="color:#42474e;line-height:1.7;">يتحقق أن الحارس سجّل دخوله بالموقع والوقت الصحيحين، باستخدام الموقع الجغرافي وتأكيد الصورة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">badge</span>
        <h3>متتبع تجديد التراخيص والشهادات</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع تراخيص هيئة الأمن الخاصة والشهادات الأخرى كبيانات منظّمة، ويُنبّه للتجديد القادم بوقت كافٍ.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">forum</span>
        <h3>بوت تواصل العملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يتولى طلبات العملاء الروتينية، تأكيدات التغطية، طلبات تغيير الجدول، وتحديثات الحالة، عبر قناة يستخدمونها بالفعل.</p>
      </div>
    </div>
  </div>
</section>

<!-- ONE SHIFT JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">دوام واحد، من الجدولة للتقرير</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة، ليقضي المشرفون وقتاً أقل بالملاحقة وأكثر بإدارة المواقع.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">جدول يُبنى ويُبلَّغ دون عاصفة رسائل بث</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">جدول الأسبوع القادم يُبنى تلقائياً، مطابقاً للشهادة والتوفر، قبل وصوله لمحادثة جماعية.</p>
        <ul class="journey-list">
          <li>كل حارس يرى دواماته الخاصة، مُرسلة فردياً، لا مدفونة برسالة جماعية</li>
          <li>الفجوات اللحظية تُملأ بمطابقة حراس متاحين ومُرخَّصين قريبين، لا رسالة بث وانتظار</li>
          <li>المشرفون يرون تغطية الموقع الكاملة بلمحة بدل مقارنة جدول بيانات</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير حادث يُقدَّم من ملاحظة صوتية بالميدان</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">شيء يحدث بالموقع. الحارس يُبلغ عنه فوراً، لا في نهاية الدوام.</p>
        <ul class="journey-list">
          <li>التقاط صوتي أو صورة موجَّه بالموقع، منظّم حول ماذا ومتى وأين ومن</li>
          <li>مسودة التقرير تُولَّد خلال دقائق، يراجعها مشرف قبل اعتمادها</li>
          <li>العميل يُبلَّغ فوراً إن كان الحادث يستوفي حد إشعار اتفاقيته</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تقرير العميل يُولّد نفسه شهرياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">في نهاية الشهر، تقرير اتفاقية مستوى الخدمة مُجمَّع بالفعل مما سُجّل خلال الشهر.</p>
        <ul class="journey-list">
          <li>الحضور وعدد الحوادث وأوقات الاستجابة تُسحَب من البيانات المُسجَّلة تلقائياً</li>
          <li>مدير الحساب يراجع ويُضيف السياق قبل إرساله للعميل</li>
          <li>العميل يستطيع أيضاً فحص بوابته مباشرة، لا انتظار البريد الشهري</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الجدولة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الجدولة عبر عشرات المواقع وأنماط الدوام هي حيث يظهر الضغط التشغيلي أولاً. تعويض لحظي غير مملوء بسرعة كافية يعني موقعاً غير مُغطى.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يملأ الفجوات بمطابقة حراس مُرخَّصين ومتاحين، لا بث وأمل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">mic</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير الحوادث</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تقارير الحوادث المكتوبة من الذاكرة بعد ساعات أضعف باستمرار من التي تُلتقط في الموقع. التقاط بالصوت والصورة بالميدان يُبقي التفاصيل أقرب لما حدث فعلياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تقارير مُسوَّدة خلال دقائق من الموقع، لا ساعات على الورق لاحقاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">monitoring</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تقارير اتفاقية مستوى الخدمة للعملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تقارير اتفاقية مستوى الخدمة الشهرية أكثر مهمة إدارية متكررة يتولاها مدير حساب، وهي بالضبط نوع العمل الذي يُنجزه نظام أسرع وأثبت من شخص يُجمّع من ثلاثة سجلات مختلفة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُحرّر مدراء الحسابات لإدارة العلاقات، لا جداول البيانات</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تعقيد متعدد المواقع والدوامات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">شركة أمن تُدير عشرين موقعاً عبر ثلاثة أنماط دوام لديها مشكلة جدولة أعقد بكثير من عمل بموقع واحد. نظام الجدولة يحتاج الاحتفاظ بكل موقع ودوام ومتطلب ترخيص معاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">إدخال ودود للميدان (صوت، صورة)</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحراس بالميدان ليسوا خلف مكتب، وليس كل حارس مرتاحاً بكتابة تقرير مفصل بلغته الثانية أو الثالثة. التقاط صوتي وصوري موجَّه بموجّهات بسيطة يُنتج تقريراً قابلاً للاستخدام.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">متابعة تراخيص هيئة الأمن الخاصة والتنظيمية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">العمل بترخيص هيئة أمن خاصة منتهٍ على حارس مُجدوَل مخاطرة امتثال تتحملها الشركة. متابعة التجديد يجب أن تُبنى في منطق الجدولة نفسه.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">بوابة تقارير موجَّهة للعملاء</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">العملاء يتوقعون بشكل متزايد فحص التغطية وحالة الحوادث بأنفسهم. بوابة محددة بدقة لمواقع وبيانات كل عميل تبني الثقة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
