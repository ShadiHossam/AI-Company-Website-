<!-- FAQ -->
<section class="section">
  <div class="container" style="max-width:760px;">
    <h2 style="text-align:center;margin-bottom:2.5rem;">أسئلة شائعة</h2>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          هل يتكامل النظام مع إيجاري وبرنامج إدارة العقارات لدينا؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">نعم. نظام تذكير التجديد وإيجاري مبني ليتابع تاريخ تسجيل وتجديد كل عقد إيجار، ويستطيع سحب هذه البيانات من معظم منصات إدارة العقارات الشائعة في الإمارات.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          كيف يتعامل توزيع الموردين مع اتفاقية مستوى الخدمة؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">كل عمل مُوزَّع يحمل ختماً زمنياً ونافذة استجابة متوقعة بناءً على التخصص ومستوى الإلحاح. النظام يتابع إن أكّد المورّد واستكمل العمل ضمن تلك النافذة.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          هل يتوسّع هذا لمحفظة كبيرة؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">هذا بالضبط عبء العمل الذي بُني له النظام. فرز الصيانة ومتابعة التجديد ومراسلة المستأجرين تعمل لكل وحدة ومبنى، فمحفظة ٥٠ وحدة أو ٥٠٠٠ تحصل على نفس المعالجة الثابتة.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          هل يعرف المستأجرون أنهم يراسلون مساعداً ذكياً؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">نعم. نُوصي بالوضوح منذ البداية، وكل محادثة لها مسار واضح لمنسق بشري، سواء بطلب المستأجر مباشرة أو تقدير الذكاء الاصطناعي لضرورة التصعيد.</div>
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
