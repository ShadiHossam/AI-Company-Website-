---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات إدارة العقارات في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/property-management",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "إدارة العقارات", "item": "https://lenooai.com/ar/industries/property-management" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات إدارة العقارات في الإمارات",
    "description": "فرز طلبات صيانة، مساعد مستأجرين عبر واتساب، تذكير تجديد وإيجاري، توزيع موردين، ومتابعة تحصيل إيجار لشركات إدارة العقارات في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يتكامل النظام مع إيجاري وبرنامج إدارة العقارات لدينا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم. نظام تذكير التجديد وإيجاري مبني ليتابع تاريخ تسجيل وتجديد كل عقد إيجار، ويستطيع سحب هذه البيانات من معظم منصات إدارة العقارات الشائعة في الإمارات." }
      },
      {
        "@type": "Question",
        "name": "كيف يتعامل توزيع الموردين مع متابعة اتفاقية مستوى الخدمة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "كل عمل مُوزَّع يحمل ختماً زمنياً ونافذة استجابة متوقعة بناءً على التخصص ومستوى الإلحاح الذي تحددونه. النظام يتابع إن أكّد المورّد واستكمل العمل ضمن تلك النافذة." }
      },
      {
        "@type": "Question",
        "name": "ندير مئات الوحدات عبر مبانٍ متعددة. هل يتوسّع هذا لمحفظة كبيرة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "هذا بالضبط عبء العمل الذي بُني له النظام. فرز الصيانة، متابعة التجديد، ومراسلة المستأجرين تعمل جميعها لكل وحدة ومبنى، فمحفظة ٥٠ وحدة أو ٥٠٠٠ تحصل على نفس المعالجة الثابتة." }
      },
      {
        "@type": "Question",
        "name": "هل سيعرف المستأجرون أنهم يراسلون مساعداً ذكياً، وهل يستطيعون الوصول لإنسان؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم لكلا السؤالين. نُوصي بالوضوح منذ البداية أن المستأجرين يراسلون مساعداً ذكياً، وكل محادثة لها مسار واضح لمنسق بشري، سواء بطلب المستأجر مباشرة أو بتقدير الذكاء الاصطناعي لضرورة التصعيد." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لشركات إدارة العقارات في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني فرز طلبات صيانة ومساعد مستأجرين عبر واتساب وتذكير تجديد وإيجاري لشركات إدارة العقارات في الإمارات."
  canonicalPath="/ar/industries/property-management"
  enPath="/industries/property-management"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>إدارة العقارات</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">apartment</span>
      إدارة العقارات
    </div>
    <h1>ذكاء اصطناعي لشركات إدارة العقارات في الإمارات<br><span class="gradient-text">الصيانة والتجديدات تستهلك أسبوع كل مدير عقارات</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      طلب صيانة واحد يصل بثلاث طرق مختلفة، وتجديد إيجار يحمل موعد تسجيل إيجاري لا يجب تفويته. نبني لك بوتاً يفرز طلبات الصيانة، يوزّع الموردين، ويتابع مواعيد التجديد وإيجاري عبر محفظتكم كاملة.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_property_management_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1502810190503-8303352d0dd1?w=1600&q=80&auto=format&fit=crop" alt="مبنى سكني تُديره شركة إدارة عقارات إماراتية" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة رد أعلى للمستأجر عند التواصل خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">+٢٠٠</p>
        <p class="stat-lbl">جنسية في الإمارات، أغلبها يفضّل واتساب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية لطلبات الصيانة وتذكيرات التجديد ورسائل المستأجرين</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة إدارة العقارات</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة ببرنامج إدارة العقارات وقائمة الموردين لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">build</span>
        <h3>بوت فرز طلبات الصيانة</h3>
        <p style="color:#42474e;line-height:1.7;">يُسجّل كل طلب من الهاتف أو واتساب أو بوابة المستأجرين، يُصنّفه حسب التخصص والإلحاح، ويُوجّهه تلقائياً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">chat</span>
        <h3>مساعد مستأجرين عبر واتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يجيب فوراً عن أسئلة المستأجرين الروتينية: مواعيد الإيجار، قواعد المبنى، كيفية رفع طلب، تخصيص المواقف.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_repeat</span>
        <h3>نظام تذكير التجديد وإيجاري</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع موعد تجديد كل عقد إيجار وتسجيل إيجاري المرتبط به، مُرسلاً تذكيرات للمستأجرين والملاك.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">local_shipping</span>
        <h3>أتمتة توزيع الموردين</h3>
        <p style="color:#42474e;line-height:1.7;">بمجرد فرز الطلب، يُبلَّغ المورّد المناسب من قائمتكم المعتمدة بتفاصيل العمل والصور.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">payments</span>
        <h3>متابعة تحصيل الإيجار</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تذكيرات دفع قبل موعد الاستحقاق ومتابعات متصاعدة مهذبة عند تأخر الدفع.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">checklist</span>
        <h3>بوت قائمة تحقق الانتقال</h3>
        <p style="color:#42474e;line-height:1.7;">يُرشد المستأجرين والمفتشين عبر قائمة تحقق الدخول والخروج، جامعاً صوراً وتوقيعاً في كل خطوة.</p>
      </div>
    </div>
  </div>
</section>

<!-- MAINTENANCE JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="pm-journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="pm-journey-heading">طلب صيانة واحد، من البداية للنهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول رسالة حتى إغلاق التذكرة، بينما يتولى فريقكم قرارات الحكم.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">تسجيل وفرز خلال ثوانٍ</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مستأجر يُراسل عن مشكلة بأي ساعة، عبر واتساب أو البوابة. الذكاء الاصطناعي يُصنّفها بالفعل.</p>
        <ul class="journey-list">
          <li>يحدد التخصص (تكييف، سباكة، كهرباء) ومستوى الإلحاح من الوصف والصور المُرسلة</li>
          <li>يُنشئ التذكرة تلقائياً ويؤكد الاستلام للمستأجر خلال أقل من دقيقة</li>
          <li>يُنبّه لأي شيء متعلق بالسلامة لمراجعة بشرية فورية</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المورّد يُوزَّع دون سلسلة مكالمات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تصنيف التذكرة، يعمل الذكاء الاصطناعي مع قائمة الموردين المعتمدين بدل عمل منسقكم على الهاتف.</p>
        <ul class="journey-list">
          <li>يرسل تفاصيل العمل وملاحظات الوصول والصور للمورّد المناسب تلقائياً</li>
          <li>يتابع التأكيد ووقت الوصول المتوقع مقابل اتفاقية مستوى الخدمة لذلك التخصص</li>
          <li>يُصعّد لمورّد احتياطي تلقائياً إن لم يرد الأول في الوقت</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المستأجر يُبقى مُحدَّثاً تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">لحظة توزيع أو إغلاق أو تأخير عمل، يسمع المستأجر عنه دون أن يسأل.</p>
        <ul class="journey-list">
          <li>يرسل رسالة للمستأجر عند تحرك المورّد، لا فقط بعد إنجاز العمل</li>
          <li>يُغلق الحلقة بتأكيد إنجاز وفحص رضا قصير</li>
          <li>يحتفظ بسجل كامل للوحدة، فالطلب التالي لا يبدأ من صفر</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">build</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز الصيانة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أكبر محرّك حجم واحد في إدارة العقارات هو طلبات الصيانة، وهو المجال الذي يُثمر فيه الفرز بالذكاء الاصطناعي أسرع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل طلب يُسجَّل ويُصنَّف لحظة وصوله</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إدارة التجديد وإيجاري</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">متابعة التجديد وإيجاري متكررة ومرتبطة بتواريخ صارمة. أنظمة التذكير بالذكاء الاصطناعي تتابع الجدول الزمني لكل عقد مقابل فترات الإشعار الصحيحة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">فترات الإشعار ومواعيد إيجاري تُحسب تلقائياً لكل عقد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">chat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تواصل المستأجرين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">معظم رسائل المستأجرين روتينية ومتكررة عبر المحفظة: مواعيد الإيجار، قواعد المبنى، تقدّم طلب. التعامل معها فوراً على واتساب يُزيل أكبر مصدر مقاطعة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">أسئلة روتينية تُجاب فوراً، بالعربي أو الإنجليزي</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع برنامج إدارة العقارات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">نظام لا يكتب مرة أخرى في منصتكم يخلق مصدر حقيقة ثانياً لا يثق به أحد. حالة التذكرة وسجلات المستأجرين وتواريخ العقود يجب أن تعيش في مكان واحد.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">وعي بإيجاري ومؤسسة التنظيم العقاري</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">تذكيرات التجديد وإشعارات زيادة الإيجار ليست عامة؛ يجب أن تعكس الجداول الزمنية الصحيحة لإيجاري وفترات الإشعار المنظَّمة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تنسيق شبكة الموردين</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أتمتة التوزيع جيدة بقدر قائمة الموردين خلفها. تحتاج تخصص كل مورّد ومنطقة تغطيته ووقت استجابته المعتاد مسجَّلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">قاعدة مستأجرين متعددة اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">محفظة إماراتية تضم مستأجرين من عشرات الجنسيات. مساعد يردّ بالإنجليزية فقط يُفوّت حصة كبيرة من المستأجرين الفعليين.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1600880292089-90a7e086ee0c?w=1200&q=80&auto=format&fit=crop" alt="مدير عقارات ينسّق أعمال صيانة في مبنى سكني إماراتي" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">×٩</p>
        <p style="color:#42474e; font-size:0.875rem;">فرصة رد أو تحويل أعلى عند التواصل خلال ٥ دقائق (MIT)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">+٢٠٠</p>
        <p style="color:#42474e; font-size:0.875rem;">جنسية تعيش في الإمارات، تمتد عبرها قاعدة مستأجري معظم المحافظ</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٢٤/٧</p>
        <p style="color:#42474e; font-size:0.875rem;">تغطية لفرز الصيانة ورسائل المستأجرين وتذكيرات التجديد</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">سرعة الرد</p>
          <p style="color:#42474e; line-height:1.7;">نتيجة MIT بأن التواصل خلال ٥ دقائق يُحوّل بمعدل ٩ أضعاف تنطبق على مستأجر يُبلغ عن تسرّب بقدر ما تنطبق على عميل محتمل. مدراء العقارات يقولون إن نفس الطلبات تُكرَّر مرتين أو ثلاثاً عبر واتساب قبل تأكيد استلامها.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">نمو المحفظة دون نمو الموظفين</p>
          <p style="color:#42474e; line-height:1.7;">شركات إدارة العقارات التي تُوسّع عدد وحداتها تُبلغ أن عدد المنسقين هو السقف الحقيقي للنمو، لا عدد المباني التي تستطيع إدارتها تقنياً.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">ملاءمة اللغة والقناة</p>
          <p style="color:#42474e; line-height:1.7;">واتساب هو القناة الافتراضية التي يستخدمها معظم سكان الإمارات للتواصل اليومي مع الشركات وإدارة المباني معاً. مساعد يعيش حيث يُراسل المستأجرون بالفعل يُزيل الاحتكاك.</p>
        </div>
      </div>
    </div>
