---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لعيادات التجميل والجلدية في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/aesthetic-clinics",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "عيادات التجميل", "item": "https://lenooai.com/ar/industries/aesthetic-clinics" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لعيادات التجميل والجلدية في الإمارات",
    "description": "بوت رد على رسائل إنستغرام وواتساب لعيادات التجميل في الإمارات، يحجز الاستشارات، يتابع الجلسات، ويحافظ على لغة متوافقة مع هيئة الصحة بدبي.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "كيف تُحفظ خصوصية المريض في محادثة رسائل خاصة آلية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "المحادثات تمر عبر واجهات ميتا الرسمية المشفّرة، والذكاء الاصطناعي مُهيّأ لإبقاء تفاصيل العلاج الحساسة خارج ما لا حاجة له، فيعرض حجز استشارة خاصة بدل مناقشة حالة العميل بالتفصيل عبر الرسائل. أي موضوع حساس أو سؤال طبي حقيقي يُحوَّل لممارس بشري." }
      },
      {
        "@type": "Question",
        "name": "هل يمكن للذكاء الاصطناعي تقديم وعود علاجية، وهل هذا يخلق مخاطرة قانونية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "البوت مبني على لغة متوافقة مع هيئة الصحة بدبي: يصف العلاج، يشارك السعر والمواعيد، ويحجز استشارة، لكنه لا يقدّم ضمانات نتائج محددة أو وعوداً طبية. أي سؤال يحتاج إجابة سريرية يُحوَّل لممارس." }
      },
      {
        "@type": "Question",
        "name": "كيف تعمل متابعة الجلسات والباقات للعلاجات المتعددة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يتابع عدد الجلسات المستخدمة والمتبقية لكل مريض ولكل باقة، سواء كانت كورس ليزر من ٦ جلسات أو باقة فيلر فصلية، ويرسل تذكيراً عند اقتراب الجلسة التالية أو التجديد." }
      },
      {
        "@type": "Question",
        "name": "هل الرد الآلي يبدو غير شخصي لعيادة تعتمد على الثقة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نبرة الحديث ودرجة الرسمية تحددها عيادتك قبل الإطلاق، ومعظم من يكتب في الساعة ١١ مساءً يريد فقط رداً سريعاً ودقيقاً عن السعر والمواعيد. أي شيء أكثر حساسية يُحوَّل لممارس فوراً." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لعيادات التجميل والجلدية في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت رد على إنستغرام وواتساب لعيادات التجميل في الإمارات: حجز استشارات، متابعة باقات، ولغة متوافقة مع هيئة الصحة بدبي."
  canonicalPath="/ar/industries/aesthetic-clinics"
  enPath="/industries/aesthetic-clinics"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>عيادات التجميل</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">spa</span>
      عيادات التجميل والجلدية
    </div>
    <h1>ذكاء اصطناعي لعيادات التجميل في دبي<br><span class="gradient-text">الرد يأتي قبل أن يبرد الاهتمام</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      الباب الحقيقي لعيادتك هو رسائل إنستغرام، لا الهاتف. معظم الاستفسارات الجادة تصل مساءً، حين لا يوجد أحد للرد. نبني لك بوتاً يرد فوراً بلباقة واحترافية، يحجز الاستشارات، ويتابع باقات العلاج، بلغة متوافقة مع هيئة الصحة بدبي.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_aesthetic_clinics_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80&auto=format&fit=crop" alt="غرفة علاج داخل عيادة تجميل حديثة" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 55%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند الرد خلال ٥ دقائق لا ٣٠</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١١ م</p>
        <p class="stat-lbl">وقت وصول أغلب الاستفسارات الجادة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">رد مستمر حتى بعد إغلاق العيادة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في عيادة التجميل</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة مبنية حول رسائل إنستغرام، الخصوصية، وباقات العلاج المتعددة الجلسات.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">chat</span>
        <h3>بوت رد على إنستغرام وواتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يرد على استفسارات العلاج لحظة وصولها، بنبرة لبقة واحترافية، يشارك السعر والمواعيد، ويوجّه نحو حجز استشارة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event</span>
        <h3>مساعد حجز الاستشارات</h3>
        <p style="color:#42474e;line-height:1.7;">يحجز الاستشارة على تقويم الممارس الحقيقي، ويجمع بيانات الاستقبال الأساسية قبل الزيارة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_repeat</span>
        <h3>متابعة العلاج وإعادة الحجز</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع حال المريض بعد العلاج، ويتواصل مجدداً عند اقتراب الجلسة التالية في كورسه أو خطته.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">healing</span>
        <h3>بوت تعليمات ما قبل وبعد العلاج</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل تعليمات التحضير والعناية بعد العلاج المعتمدة من العيادة تلقائياً وفي الوقت المناسب.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">payments</span>
        <h3>تذكير بالباقات وخطط الدفع</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع الجلسات المستخدمة والمتبقية على أي باقة، ويُرسل تذكيراً بالتجديد قبل انتهاء الصلاحية بصمت.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">rate_review</span>
        <h3>طلب تقييم وموافقة قبل/بعد</h3>
        <p style="color:#42474e;line-height:1.7;">يطلب تقييماً في الوقت المناسب، ويطلب موافقة واضحة قبل استخدام أي صور قبل وبعد، دون افتراض أو دمج مع رسالة أخرى.</p>
      </div>
    </div>
  </div>
</section>

<!-- ONE DM JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من رسالة منتصف الليل إلى استشارة محجوزة</h2>
      <p>ما يتولاه الذكاء الاصطناعي من رسالة إنستغرام متأخرة إلى مريض يعود للعناية.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">رد فوري بدل انتظار الصباح</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">رسالة متأخرة تسأل عن علاج شاهدته على صفحة العيادة. الرد لا ينتظر ساعات العمل.</p>
        <ul class="journey-list">
          <li>يرد بنبرة لبقة واحترافية في نفس المحادثة</li>
          <li>يشارك السعر والمواعيد بدون تأخير طويل</li>
          <li>يوجّه المحادثة نحو استشارة محجوزة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز مع الممارس المناسب</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">تُحجز الاستشارة على تقويم حقيقي، لا موعد افتراضي.</p>
        <ul class="journey-list">
          <li>يتحقق من توفر الممارس المطلوب فعلياً</li>
          <li>يجمع بيانات الاستقبال الأساسية قبل الزيارة</li>
          <li>يرسل تعليمات ما قبل الزيارة وتذكيراً قرب التاريخ</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">المتابعة التي تُرجع العميل</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">الزيارة تنتهي، لكن خطة العلاج غالباً ليست مرة واحدة.</p>
        <ul class="journey-list">
          <li>يرسل تعليمات العناية بعد العلاج تلقائياً</li>
          <li>يتابع حال المريض بعد العلاج لرصد أي مشكلة مبكراً</li>
          <li>يتواصل مجدداً عند اقتراب الجلسة التالية أو التجديد</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">nightlight</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">استقبال العملاء بعد ساعات العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">حصة كبيرة من استفسارات إنستغرام عن علاجات التجميل تصل خارج ساعات العمل. رد لبق واحترافي يصل فوراً، لا في الصباح، يحفظ الاهتمام من أن يبرد أو يذهب لمنافس ردّ أولاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">الفارق بين رسالة مسائية ورد صباحي هو مكان ضياع الاستفسارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">حجز الاستشارات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">تحويل محادثة الرسائل مباشرة إلى استشارة محجوزة، دون حاجة لمكالمة أو نموذج منفصل، يزيل العقبات في لحظة أعلى اهتمام.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">خطوات أقل بين الاهتمام والموعد المحجوز تعني تسرّباً أقل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إعادة حجز الباقات والكورسات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">خطط العلاج المتعددة الجلسات تعتمد على عودة المريض فعلياً لكل جلسة. تذكير موقّت على كورس المريض بالذات، لا رسالة تسويقية عامة، هو ما يُبقي الخطة في مسارها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كورس يُتابَع بالكامل يساوي أكثر بكثير من كورس ينتهي دون استكمال</p>
      </div>
    </div>
  </div>
</section>

<!-- CASE STUDY -->
<section class="section" style="background:#f0f4ff;padding:4rem 0;">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:2.5rem;">قصة نجاح حقيقية</h2>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200&q=80&auto=format&fit=crop" alt="منطقة استقبال هادئة وخاصة في عيادة تجميل" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="case-study-card">
      <div class="case-section">
        <span class="case-label">المشكلة</span>
        <p>عيادة تجميل في دبي كانت تفقد استفسارات جدية تصل عبر إنستغرام مساءً وبعد الإغلاق، وكان فريقها يفتح المحادثات صباحاً ليجد أن الزبون تواصل مع عيادة أخرى ردّت أولاً.</p>
      </div>
      <div class="case-section">
        <span class="case-label">ما بنيناه</span>
        <p>بوت رد فوري على إنستغرام وواتساب بلغة متوافقة مع هيئة الصحة بدبي، يحجز الاستشارات على تقويم الممارس الحقيقي، ويتابع الباقات تلقائياً ليذكّر بالجلسة التالية قبل انتهاء صلاحيتها.</p>
      </div>
      <div class="case-results">
        <div class="result-metric">
          <span class="result-num">أقل من دقيقة</span>
          <span class="result-lbl">وقت الرد على استفسارات ما بعد ساعات العمل</span>
        </div>
        <div class="result-metric">
          <span class="result-num">أعلى استكمال</span>
          <span class="result-lbl">للباقات بفضل تذكير موقّت لكل مريض</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOW WE WORK -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">كيف نعمل معك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:2.5rem;">من جلسة التشخيص إلى إطلاق البوت بشكل تدريجي ومحكوم.</p>
    <div class="steps-grid">
      <div class="step-item">
        <div class="step-num">١</div>
        <h3>تحليل استفسارات عيادتك</h3>
        <p style="color:#42474e;line-height:1.7;">نحلل أكثر الأسئلة تكراراً، أوقات وصولها، والعلاجات الأكثر طلباً، ونبني البوت على هذه البيانات.</p>
      </div>
      <div class="step-item">
        <div class="step-num">٢</div>
        <h3>بناء بلغة متوافقة مع هيئة الصحة بدبي</h3>
        <p style="color:#42474e;line-height:1.7;">ندرّب البوت على خدماتك وأسعارك بلغة تصف العلاج دون وعود طبية، ويرد بصوت عيادتك لا كروبوت عام.</p>
      </div>
      <div class="step-item">
        <div class="step-num">٣</div>
        <h3>إطلاق تدريجي مع مراقبة</h3>
        <p style="color:#42474e;line-height:1.7;">إطلاق تدريجي مع مراقبة مستمرة في الأسابيع الأولى، نضبط الأداء بناءً على محادثات المرضى الفعلية.</p>
      </div>
    </div>
  </div>
</section>

