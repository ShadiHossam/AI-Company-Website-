---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للمطاعم في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/restaurants",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "المطاعم", "item": "https://lenooai.com/ar/industries/restaurants" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للمطاعم في الإمارات",
    "description": "بوت حجز وانتظار، توحيد طلبات تطبيقات التوصيل، طلب عبر واتساب، وأتمتة الرد على التقييمات لمطاعم الإمارات المستقلة ومتعددة الفروع.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "مع أي تطبيقات توصيل يتصل الذكاء الاصطناعي فعلياً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نبني على طلبات وديليفرو وزوماتو، الثلاثة التي تحمل معظم حجم طلبات التوصيل في الإمارات. حيث تدعم واجهة التطبيق ذلك، تتزامن الطلبات تلقائياً في عرض موحّد واحد بجانب طلبات الصالة وواتساب." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع الذكاء الاصطناعي التعامل مع حجم مكالمات وطلبات ساعة الذروة دون تعطل؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم. على عكس خط هاتف بعدد موظفين ثابت، الذكاء الاصطناعي يتوسّع مع الحجم، فازدحام عشاء الجمعة لا يعني وقت انتظار أطول أو مكالمات فائتة." }
      },
      {
        "@type": "Question",
        "name": "هل نتحكم بكيفية رد الذكاء الاصطناعي على التقييمات، أم ينشر ردوداً عامة تلقائياً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "أنتم تحددون النبرة والحدود. التقييمات الإيجابية تحصل على رد تلقائي بصوت علامتكم. أي شيء سلبي، أو يذكر سلامة غذائية أو مخاوف صحية، يُسوَّد ليعتمده فريقكم أو يُصعَّد مباشرة." }
      },
      {
        "@type": "Question",
        "name": "هل يتكامل بوت الحجز مع نظام نقاط البيع الحالي لدينا؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، هذا هو المغزى. حجز أو طلب يتخذه الذكاء الاصطناعي يجب أن يصل نفس النظام الذي يستخدمه طاقم الصالة والمطبخ بالفعل، لا تطبيق منفصل يحتاجون فحصه." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للمطاعم في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني بوت حجز وتوحيد طلبات تطبيقات التوصيل وطلب عبر واتساب وأتمتة رد على التقييمات لمطاعم الإمارات."
  canonicalPath="/ar/industries/restaurants"
  enPath="/industries/restaurants"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>المطاعم</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">restaurant</span>
      المطاعم
    </div>
    <h1>ذكاء اصطناعي للمطاعم في الإمارات<br><span class="gradient-text">خمس قنوات لطلب واحد</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      طلبات، ديليفرو، زوماتو، صالة، واتساب، كل قناة لها شاشتها. نبني لك بوتاً يحجز الطاولات ويوحّد الطلبات في طابور واحد، يستقبل طلبات واتساب المباشرة، ويردّ على التقييمات بنفس اليوم.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_restaurants_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80&auto=format&fit=crop" alt="مطبخ وخدمة صالة مطعم في الإمارات" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">+٣</p>
        <p class="stat-lbl">قنوات طلب يُوفّق بينها مطعم إماراتي نموذجي يدوياً كل نوبة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٩٨٪</p>
        <p class="stat-lbl">معدل فتح واتساب المعتاد، القناة التي يردّ عليها الزبائن فعلاً</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">تغطية حجز وطلب، حتى في ساعات عدم وجود موظف استقبال</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في مطعمك</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بنظام نقاط البيع وقنوات الطلب الحالية لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">event_seat</span>
        <h3>بوت حجز وانتظار</h3>
        <p style="color:#42474e;line-height:1.7;">يستقبل الحجوزات بالهاتف أو واتساب، يتحقق من توفر الطاولة الفعلي مقابل نظامكم، ويدير قائمة الانتظار.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">restaurant</span>
        <h3>توحيد طلبات تطبيقات التوصيل</h3>
        <p style="color:#42474e;line-height:1.7;">يسحب طلبات طلبات وديليفرو وزوماتو في طابور واحد بجانب طلبات الصالة وواتساب.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">chat</span>
        <h3>مساعد طلب عبر واتساب</h3>
        <p style="color:#42474e;line-height:1.7;">يستقبل طلبات مباشرة عبر واتساب، القناة التي يحتفظ بها الزبائن بالفعل، دون عمولة تطبيق توصيل.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">reviews</span>
        <h3>الرد على التقييمات ومراقبة السمعة</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع التقييمات الجديدة عبر المنصات الرئيسية ويُسوّد رداً بنفس اليوم بصوت علامتكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">forum</span>
        <h3>جامع ملاحظات العملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل رسالة ملاحظات قصيرة بعد وجبة، ويُحوّل أي شيء سلبي لمديركم فوراً قبل أن يصبح تقييماً عاماً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">schedule</span>
        <h3>مساعد جدولة الطاولات والموظفين</h3>
        <p style="color:#42474e;line-height:1.7;">يطابق عدد الضيوف المتوقع من الحجوزات والأنماط التاريخية مع احتياج التوظيف.</p>
      </div>
    </div>
  </div>
</section>

<!-- JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="journey-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="journey-heading">من حجز إلى تقييم، من البداية للنهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي من أول رسالة حجز حتى التقييم الذي يتبع الوجبة.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">حجز دون مكالمة هاتفية</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">ضيف يُراسل عبر واتساب يريد طاولة لأربعة ليلة الجمعة.</p>
        <ul class="journey-list">
          <li>يتحقق من توفر الطاولة الفعلي مقابل نظامكم ويؤكد موعداً خلال ثوانٍ</li>
          <li>يجمع عدد الضيوف والمناسبة وأي ملاحظات غذائية تستحق تمريرها للمطبخ</li>
          <li>يرسل تذكيراً قبل الحجز فلا تبقى الطاولة فارغة بسبب غياب</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">طلب لا يضيع في فوضى التطبيقات</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">طلب توصيل يصل على طلبات بينما المطبخ منشغل بثلاث شاشات أخرى.</p>
        <ul class="journey-list">
          <li>يسحب الطلب لنفس الطابور الموحّد كباقي القنوات، لا جهاز منفصل للفحص</li>
          <li>يُنبّه لتعارض توقيت الطلبات قبل تأخر المطبخ عن نافذة توصيل موعودة</li>
          <li>يؤكد حالة الطلب للعميل تلقائياً إن تابع</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">التقييم يحصل على رد بنفس اليوم</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">ضيف يترك تقييماً ذلك المساء، جيداً أو سيئاً.</p>
        <ul class="journey-list">
          <li>يُسوّد رداً بصوت علامتكم خلال ساعات، لا حين يتذكر أحد الفحص</li>
          <li>يُصعّد أي شيء جاد، مخاوف صحية أو شكوى حقيقية، لكم قبل أي رد عام</li>
          <li>يُسجّل الملاحظات فتظهر المشاكل المتكررة للإدارة بدل الضياع بالضجيج</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر لمطاعم الإمارات</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">restaurant</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فوضى طلبات التطبيقات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">توحيد طلبات وديليفرو وزوماتو في عرض واحد يُزيل أكبر مصدر خطأ في المطبخ: طلب فائت لأن الجهاز الذي وصل عليه لم يكن ما يفحصه أحد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">طابور واحد، لا جهاز لكل منصة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">reviews</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة التقييمات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الزبائن الذين يقارنون بين مطاعم متشابهة يفحصون التقييمات قبل الحجز باستمرار. مطعم يردّ بسرعة وثبات يُقرأ كمُهتم؛ مطعم بأسابيع من تقييمات دون رد يُقرأ كلامبالٍ.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">رد بنفس اليوم، كل مرة، لا حين يتذكر أحد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">event_seat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">الغياب عن الحجوزات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">غياب واحد بساعة ذروة يعني طاولة كانت ستُشغَل مرتين. تأكيدات وتذكيرات آلية تُرسل بالوقت المناسب تستعيد حصة معتبرة من الحجوزات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تذكير آلي لا يُكلّف شيئاً ويُنقذ الطاولة</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع طلبات/ديليفرو/زوماتو</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">توحيد الطلبات يعمل فقط إن اتصل بالتطبيقات التي تستخدمونها فعلياً. نبني على الثلاثة التي تحمل معظم حجم التوصيل بالإمارات.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع نقاط البيع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الحجوزات وحالة الطاولات وبيانات الطلبات يجب أن تعيش في نفس النظام الذي يستخدمه طاقم الصالة والمطبخ بالفعل.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">قائمة وطلب متعدد اللغات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">قاعدة زبائن الإمارات تتنقل بين العربية والإنجليزية، وغالباً تتوقع شرح القائمة لا فقط سردها.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع ضغط ساعة الذروة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">خدمة عشاء الجمعة والسبت تجلب ارتفاعاً بطلبات الحجز والطلبات والرسائل معاً. النظام يحتاج الصمود دون فوات حجز أو طلب.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1517840901100-8179e982acb7?w=1200&q=80&auto=format&fit=crop" alt="طاقم مطعم يُجهّز طلبات خلال خدمة ذروة" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">+٣</p>
        <p style="color:#42474e; font-size:0.875rem;">قنوات طلب منفصلة يُوفّق بينها مطعم إماراتي يدوياً كل نوبة</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٩٨٪</p>
        <p style="color:#42474e; font-size:0.875rem;">معدل فتح رسائل واتساب المعتاد، مقابل ٢٠٪ تقريباً للبريد</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٢٤/٧</p>
        <p style="color:#42474e; font-size:0.875rem;">تغطية حجز، بما فيها ساعات عدم وجود موظف استقبال</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">ضغط عمولة التطبيقات</p>
          <p style="color:#42474e; line-height:1.7;">تطبيقات التوصيل تفرض عمولة على كل طلب يمر عبر منصتها، ولهذا المطاعم التي تبني قناة طلب مباشرة قوية عبر واتساب تحمي هامشاً أكبر لكل طلب.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">توقيت الرد على التقييمات</p>
          <p style="color:#42474e; line-height:1.7;">المطاعم التي نتحدث معها تقول نفس الشيء: تقييم يُردّ عليه بنفس اليوم يبدو كمطعم يهتم، وواحد يُردّ عليه بعد أسبوع، أو لا يُردّ أبداً، يُقرأ كلامبالاة.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">استعادة الغياب</p>
          <p style="color:#42474e; line-height:1.7;">تذكير مؤكد يُرسل قرب موعد الحجز هو الحل القياسي الذي يستخدمه مشغّلو الضيافة عبر الصناعة للغياب. لمطعم بمقاعد ثابتة، استعادة ولو جزء من هذه الطاولات بساعات الذروة يتراكم خلال شهر.</p>
        </div>
      </div>
    </div>
  </div>
</section>

