---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل ستحل مراجعة العقود بالذكاء الاصطناعي محل المحامين المساعدين أو المساعدين القانونيين لدينا؟", answer: "لا. مراجعة العقود بالذكاء الاصطناعي تنبّه إلى البنود التي تخالف دليل المكتب وتُظهر الأجزاء التي تحتاج تقدير محامٍ، لكن كل بند منبَّه إليه يذهب إلى شخص لاتخاذ القرار القانوني الفعلي. إنها تلغي وقت القراءة الأولى، لا العمل القانوني نفسه." },
  { question: "هل يمكن الوثوق بأدوات البحث القانوني بالذكاء الاصطناعي بألا تختلق إحالات لقضايا؟", answer: "هذا أكبر خطر منفرد في الذكاء الاصطناعي القانوني، وهو سبب بنائنا للتحقق من الإحالات في أي مساعد بحث ننشره: كل إشارة لقضية ينتجها النظام يُتحقق منها مقابل مصدر حقيقي قبل عرضها عليكم. الأداة التي لا تستطيع ضمان ذلك لا يجب أن تكون في سير عمل قانوني أصلاً." },
  { question: "كيف تتعاملون مع سرية العملاء والامتياز القانوني؟", answer: "تجري معالجة المستندات في بيئات معزولة مخصصة لمكتبكم، ولا يُستخدم أي شيء لتدريب نماذج مشتركة خارج مشروعكم. نصمم تدفق البيانات حول التزامات السرية القائمة لديكم قبل أن يلمس أي مستند النظام." },
  { question: "هل هذا مبني للقانون المدني في الإمارات، أم أنه أداة ذكاء اصطناعي قانونية غربية عامة؟", answer: "ندرّب مساعدي المستندات والبحث على الاختصاص القضائي الذي تمارسون فيه فعلاً. الأداة المدرَّبة فقط على السوابق القضائية الأمريكية أو البريطانية تنتج إجابات خاطئة بثقة في سياق القانون المدني الإماراتي، لذلك التدريب الخاص بالاختصاص القضائي شرط أساسي، لا إضافة." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_legal')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لمكاتب المحاماة في الإمارات",
    "url": "https://lenooai.com/ar/industries/legal",
    "description": "أنظمة ذكاء اصطناعي مخصصة لمكاتب المحاماة والإدارات القانونية في الإمارات: مراجعة العقود، وأتمتة المستندات، ومساعدو البحث القانوني، ومراقبة الامتثال.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Legal Services"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي القانوني", "item": "https://lenooai.com/ar/industries/legal" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي لمكاتب المحاماة في الإمارات: مراجعة العقود"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لمكاتب المحاماة في الإمارات: مراجعة العقود، وأتمتة المستندات، ومساعدو البحث القانوني."
  canonicalPath="/ar/industries/legal"
  enPath="/industries/legal"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>القانون</div>
    <h1>ذكاء اصطناعي<br><span class="gradient-text">لمكاتب المحاماة في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لمكاتب المحاماة والإدارات القانونية في الإمارات: مراجعة العقود، وأتمتة المستندات القانونية، ومساعدو البحث، ومراقبة الامتثال. كل مخرج يبقى قابلاً للمراجعة والإسناد، وتحت الموافقة النهائية لمحامٍ.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="ar_legal_hero" class="btn-primary">احجزوا تدقيقاً مجانياً للذكاء القانوني</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
    <StatStrip stats={[
      { value: "٣٠٪", caption: "من وقت المحامين يُقضى عادةً في مراجعة المستندات، وفق استطلاعات العمليات القانونية" },
      { value: "٥٠-٩٠٪", caption: "انخفاض معتاد في وقت المراجعة الأولى للعقود بمساعدة الذكاء الاصطناعي" },
      { value: "١٠٠٪", caption: "من الإحالات المولَّدة بالذكاء الاصطناعي يُتحقق منها مقابل مصادر حقيقية قبل التسليم" },
    ]} />
  </div>
</header>

<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1758518731462-d091b0b4ed0d?w=1600&h=320&q=80&auto=format&fit=crop" alt="محامون يراجعون عقداً ويوقعونه على مكتب في مكتب محاماة" loading="lazy" width="1600" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- WHY LEGAL & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا القانون من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>مراجعة المستندات متكررة بطبيعتها.</strong> تجد استطلاعات العمليات القانونية باستمرار أن المحامين يقضون ما يقارب ثلث وقتهم في قراءة المستندات ومقارنتها. أدوات مراجعة العقود بالذكاء الاصطناعي تنبّه إلى الاختلافات عن الدليل المعتمد في ثوانٍ، وتترك القرارات التقديرية للمحامي.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>الدقة تهم هنا أكثر من أي مكان تقريباً.</strong> أداة ذكاء اصطناعي قانونية تختلق إحالة لقضية ليست خاطئة فقط، بل مسؤولية مهنية. كل مساعد بحث نبنيه يتحقق من كل إحالة مقابل مصدر حقيقي قبل أن تصل إلى المستخدم.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>استقبال العملاء والأعمال الإدارية تستهلك الساعات القابلة للفوترة.</strong> أتمتة فرز العملاء، وصياغة المستندات، وتسجيل الوقت تعيد للمحامين ساعات كانت ستذهب إلى الأوراق بدلاً من القضايا.</p>
      </div>
      <div class="split-media" style="display:flex; align-items:stretch;">
        <div class="card" style="display:flex; flex-direction:column; justify-content:center; text-align:center; width:100%; padding:2.5rem;">
          <p class="stat-number" style="font-size:3rem; margin-bottom:0.75rem;">٥٠-٩٠٪</p>
          <p style="color:#42474e; font-size:1rem; line-height:1.7;">انخفاض معتاد في وقت المراجعة الأولى للعقود عندما يتولى الذكاء الاصطناعي القراءة الأولى مقابل دليل مكتبكم.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لمكاتب المحاماة في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي لمكاتب المحاماة والإدارات القانونية، مع تحقق مدمج من الإحالات ومراجعة بشرية.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد مراجعة العقود واقتراح التعديلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقارن العقود الواردة بدليل مكتبكم، وينبّه إلى البنود غير المعتادة، ويقترح تعديلات لمراجعة المحامي.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">كل تعديل مقترح يتطلب موافقة محامٍ قبل إرساله</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة المستندات القانونية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ الاتفاقيات والخطابات والمذكرات الروتينية من نماذج مكتبكم الخاصة، ويملأ تفاصيل كل قضية تلقائياً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني من نماذجكم الحالية، لا من صيغ عامة جاهزة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gavel</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد البحث في القضايا والسوابق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبحث في السوابق القضائية وسوابق المكتب عن المراجع ذات الصلة، مع التحقق من كل إحالة مقابل مصدرها قبل عرضها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على الاختصاص القضائي الذي تمارسون فيه فعلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة لاستقبال العملاء وفرزهم</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع تفاصيل القضايا من استفسارات العملاء الجدد بالعربية والإنجليزية، ويوجّهها إلى مجال الممارسة المناسب قبل المكالمة الأولى.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يوفر على المحامين المكالمات الأولية غير المؤهلة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">policy</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مراقبة الامتثال للتغيرات التنظيمية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يتابع التحديثات التنظيمية ذات الصلة وينبّه إلى القضايا النشطة أو الاستشارات المقدمة للعملاء التي قد تتأثر بها.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي العمل الاستشاري محدّثاً دون مراقبة يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">receipt_long</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة الفوترة وتسجيل الوقت</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ قيود الوقت من نشاط التقويم والمستندات، فيقضي المحامون وقتاً أقل في إعادة بناء يومهم في نهاية الشهر.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل الوقت غير المفوتر الضائع بسبب عادات التسجيل غير المنتظمة</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة تبقي المحامي صاحب القرار النهائي، مع ضوابط سرية مخصصة لمكتبكم.</p>
      <button onclick="openModal(this)" data-source="ar_legal_mid" class="btn-primary">احجزوا تدقيقاً مجانياً للذكاء القانوني</button>
    </div>
  </div>
</section>

<!-- HOW WE WORK WITH YOUR FIRM -->
<section class="section" aria-labelledby="legal-team-heading">
  <div class="container">
    <div class="split-grid split-media-right">
      <div>
        <h2 id="legal-team-heading" style="margin-bottom:1.5rem;">مبني مع محاميكم، لا من حولهم</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;">كل مشروع يبدأ مع المحامين المساعدين والمساعدين القانونيين والشركاء الذين يؤدون فعلاً مراجعة المستندات والبحث الذي نهدف إلى تسريعه. يشاركون في جلسات التصميم من الأسبوع الأول، فيكون الدليل الذي يتحقق النظام مقابله هو الدليل الذي يستخدمه مكتبكم فعلاً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;">يشمل ذلك توثيق طريقة تنبيه النظام إلى البنود والإحالات بلغة يستطيع شركاء المخاطر والامتثال لديكم الدفاع عنها، لا مجرد كود يقرؤه مهندسوكم. البدء بهذه الطريقة يأخذ وقتاً أطول، وهو السبب في أن الأنظمة التي نسلّمها تُستخدم فعلاً بدلاً من أن تُهجر بصمت.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1562564055-71e051d33c19?w=800&h=600&q=80&auto=format&fit=crop" alt="محامٍ يراجع المستندات مع عميل على مكتب" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في الخدمات القانونية</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card" data-legal-expand>
        <button type="button" class="legal-card-toggle" aria-expanded="false" aria-controls="legal-panel-1" id="legal-toggle-1">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">fact_check</span></div>
            <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b;">تحليل العقود ومراجعتها</h3>
          </div>
          <span class="legal-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="legal-card-panel" id="legal-panel-1" role="region" aria-labelledby="legal-toggle-1" hidden>
          <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الذكاء الاصطناعي تقارن العقود بدليل المكتب أو بالمعيار السائد في السوق، وتُظهر الاختلافات للمراجعة في جزء بسيط من وقت القراءة اليدوية.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875;">من أسرع فئات الذكاء الاصطناعي القانوني تبنّياً لدى الفرق القانونية في الشركات</p>
        </div>
      </div>
      <div class="card" data-legal-expand>
        <button type="button" class="legal-card-toggle" aria-expanded="false" aria-controls="legal-panel-2" id="legal-toggle-2">
          <div>
            <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">gavel</span></div>
            <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b;">البحث القانوني بالذكاء الاصطناعي</h3>
          </div>
          <span class="legal-card-icon" aria-hidden="true">+</span>
        </button>
        <div class="legal-card-panel" id="legal-panel-2" role="region" aria-labelledby="legal-toggle-2" hidden>
          <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مساعدو البحث يبحثون في السوابق القضائية والتشريعات أسرع بكثير من المراجعة اليدوية، لكن التحقق من الإحالات يبقى ضرورياً في ظل حالات موثقة لسوابق قضائية اختلقها الذكاء الاصطناعي.</p>
          <p style="font-size:0.8125rem; font-weight:600; color:#006875;">التحقق من الإحالات أصبح ممارسة معتادة في تطبيقات الذكاء الاصطناعي القانونية</p>
        </div>
      </div>
      <div class="card" data-legal-expand>
        <button type="button" class="legal-card-toggle" aria-expanded="false" aria-controls="legal-panel-3" id="legal-toggle-3">
