---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "هل يُدخل فرز السير الذاتية بالذكاء الاصطناعي تحيزاً في التوظيف؟", answer: "قد يحدث ذلك إذا بُني دون عناية. نختبر نماذج الفرز للتأكد من التكافؤ بين الفئات السكانية قبل النشر، ونستبعد من معايير التقييم أي مؤشرات غير مباشرة للخصائص المحمية. خطر التحيز سبب للبناء بعناية، لا سبب لتجنب الأتمتة كلياً." },
  { question: "هل سيشعر المرشحون أنهم يتحدثون مع روبوت بدلاً من مسؤول توظيف حقيقي؟", answer: "يتولى روبوت المحادثة الجدولة والأسئلة الشائعة وتحديثات الحالة، وهي الأمور التي يريد المرشحون إجابتها بسرعة. وأي شيء يتضمن تقديراً فعلياً، مثل ملاحظات المقابلة أو محادثة العرض الوظيفي، يذهب إلى فريق التوظيف لديكم. معظم المرشحين يفضلون إجابة آلية سريعة على انتظار ثلاثة أيام لإجابة بشرية." },
  { question: "هل يتعامل مساعد التعيين مع أوراق التأشيرة وبطاقة الهوية الإماراتية؟", answer: "نعم. أتمتة مستندات التعيين مبنية حول الأوراق الفعلية التي يعالجها أصحاب العمل في الإمارات: خطابات العرض، وعقود العمل، ووثائق بطاقة الهوية الإماراتية والتأشيرة، والإقرار بسياسات الشركة." },
  { question: "كم يستغرق إطلاق الفرز بالذكاء الاصطناعي أو مساعد التعيين؟", answer: "فرز السير الذاتية يُطلق عادةً خلال ٣ إلى ٥ أسابيع بعد تحديد معايير التقييم لديكم. وأتمتة التعيين التي تشمل أوراق التأشيرة والعقود تستغرق ٥ إلى ٧ أسابيع بسبب أنواع المستندات الإضافية." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_hr_recruitment')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للموارد البشرية والتوظيف في الإمارات",
    "url": "https://lenooai.com/ar/industries/hr-recruitment",
    "description": "أنظمة ذكاء اصطناعي مخصصة لفرق الموارد البشرية والتوظيف في الإمارات: فرز المرشحين، وأتمتة جدولة المقابلات، ومعالجة مستندات التعيين، وروبوتات محادثة لاستفسارات الموظفين.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for HR & Recruitment"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للموارد البشرية والتوظيف", "item": "https://lenooai.com/ar/industries/hr-recruitment" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للموارد البشرية والتوظيف في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لفرق الموارد البشرية والتوظيف في الإمارات: فرز المرشحين، وجدولة المقابلات، وأتمتة التعيين."
  canonicalPath="/ar/industries/hr-recruitment"
  enPath="/industries/hr-recruitment"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الموارد البشرية والتوظيف</div>
    <h1>ذكاء اصطناعي لفرق<span class="h1-sep">: </span><br><span class="gradient-text">الموارد البشرية والتوظيف في الإمارات</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لفرق الموارد البشرية والتوظيف في الإمارات: فرز المرشحين، وأتمتة جدولة المقابلات، ومعالجة مستندات التعيين، وروبوتات محادثة لاستفسارات الموظفين. ثنائية اللغة، ومبنية حول متطلبات قانون العمل في الإمارات.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="ar_hr_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الموارد البشرية</button>
      <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
    </div>
    <StatStrip stats={[
      { value: "٤٬٧٠٠ $", caption: "متوسط تكلفة التوظيف الواحد عبر القطاعات (SHRM)" },
      { value: "٤٢ يوماً", caption: "متوسط مدة شغل وظيفة على مستوى القطاعات (SHRM)" },
      { value: "عربي + إنجليزي", caption: "دعم كامل ثنائي اللغة للمرشحين والموظفين" },
    ]} />
  </div>
</header>

<!-- WHY HR & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الموارد البشرية والتوظيف من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>فرز مئات السير الذاتية يدوياً لا يتوسع.</strong> يقضي مسؤولو التوظيف ساعات في قراءة سير ذاتية لا تستوفي المتطلبات الأساسية. أدوات الفرز بالذكاء الاصطناعي تُظهر المرشحين المؤهلين أسرع، فيقضي مسؤولو التوظيف وقتهم في المقابلات، لا في فرز البريد.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>تبادل الرسائل لتحديد المواعيد يهدر أياماً.</strong> تنسيق مواعيد المقابلات بين المرشحين ومديري التوظيف وأعضاء اللجان عبر البريد يضيف أياماً لجدول التوظيف بشكل معتاد. أتمتة الجدولة تلغي هذا التبادل تماماً.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>أوراق التعيين كثيرة في الإمارات.</strong> خطابات العرض، وعقود العمل، ووثائق بطاقة الهوية الإماراتية والتأشيرة، والإقرار بالسياسات، كلها يجب أن تُعالج بشكل صحيح وفي موعدها. أتمتة المستندات تقلل عبء العمل ومعدل الأخطاء معاً.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1690378820474-b468b8ee64d3?w=800&h=600&fit=crop&auto=format&q=80" alt="موظفة موارد بشرية ترشد موظفاً جديداً خلال إجراءات التعيين على مكتبه" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لفرق الموارد البشرية والتوظيف في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي لفرق الموارد البشرية والتوظيف، مربوطة بنظام تتبع المتقدمين ونظام معلومات الموارد البشرية لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز المرشحين ومطابقة السير الذاتية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يقيّم الطلبات الواردة ويرتبها وفق متطلبات الوظيفة الفعلية، مع اختبار التكافؤ بين الفئات السكانية قبل النشر لتقليل خطر التحيز.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُظهر المرشحين المؤهلين في دقائق، لا أيام</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة جدولة المقابلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">ينسّق مواعيد المقابلات بين المرشحين ومديري التوظيف وأعضاء اللجان تلقائياً، فيلغي تبادل الرسائل تماماً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يختصر أياماً من دورة الجدولة المعتادة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">روبوت محادثة لأسئلة المرشحين والتعيين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب فوراً عن أسئلة المرشحين حول الإجراءات والجداول الزمنية والخطوات التالية بالعربية والإنجليزية، فيبقى المرشحون متفاعلين بدلاً من التخمين.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحسّن تجربة المرشحين دون زيادة عبء عمل مسؤولي التوظيف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة مستندات التعيين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يعالج خطابات العرض وعقود العمل وأوراق بطاقة الهوية الإماراتية والتأشيرة تلقائياً، وينبّه إلى المعلومات الناقصة قبل أن تؤخر موعد بدء العمل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مبني حول متطلبات مستندات التوظيف الفعلية في الإمارات</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد استفسارات الموظفين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجيب فوراً عن أسئلة الموظفين حول رصيد الإجازات والسياسات والمزايا، فيقل عدد الطلبات الروتينية على فريق الموارد البشرية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يفرّغ موظفي الموارد البشرية للحالات التي تحتاج شخصاً فعلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">rate_review</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد صياغة تقييمات الأداء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ ملخصات تقييم أداء منظمة من ملاحظات المديرين وبيانات متابعة الأهداف، ليراجعها المديرون ويضيفوا لمستهم الشخصية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يختصر دورة التقييم دون فقدان مساهمة المدير</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة مختبرة من حيث التحيز، ومتوافقة مع قانون العمل في الإمارات، وثنائية اللغة، ومربوطة بنظام تتبع المتقدمين ونظام معلومات الموارد البشرية لديكم.</p>
      <button onclick="openModal(this)" data-source="ar_hr_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الموارد البشرية</button>
    </div>
  </div>
</section>

<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1573497620053-ea5300f94f21?w=1400&h=280&fit=crop&auto=format&q=80" alt="مسؤولة توظيف تجري مقابلة مع مرشح لوظيفة في مكتب مشرق" loading="lazy" width="1400" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في الموارد البشرية والتوظيف</h2>
    </div>
    <div class="hrrecruitment-tabs" role="tablist" aria-label="فئات التطبيقات">
      <button type="button" id="hrrecruitment-tab-recruiting" class="hrrecruitment-tab-btn active" data-hrrecruitment-tab="recruiting" role="tab" aria-selected="true" aria-controls="hrrecruitment-panel-recruiting">التوظيف</button>
      <button type="button" id="hrrecruitment-tab-support" class="hrrecruitment-tab-btn" data-hrrecruitment-tab="support" role="tab" aria-selected="false" aria-controls="hrrecruitment-panel-support">دعم الموظفين</button>
    </div>
    <div class="bento-grid bento-grid-3" id="hrrecruitment-panel-recruiting" data-hrrecruitment-tab-panel="recruiting" role="tabpanel" aria-labelledby="hrrecruitment-tab-recruiting">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز السير الذاتية بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الفرز ترتب المرشحين وفق متطلبات الوظيفة أسرع بكثير من المراجعة اليدوية، لكن اختبار التحيز ضروري لتجنب تكرار أنماط التوظيف السابقة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يختصر وقت الفرز الأولي من ساعات إلى دقائق لكل طلب توظيف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">التواصل مع المرشحين عبر روبوتات المحادثة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">روبوتات المحادثة تبقي المرشحين على اطلاع بحالة إجراءاتهم، وهو عامل رئيسي في رضا المرشحين لا يستطيع مسؤولو التوظيف مجاراته يدوياً مع الأعداد الكبيرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يعالج مباشرة إحدى أكثر شكاوى المرشحين شيوعاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة جدولة المقابلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الجدولة الآلية تلغي أحد أكثر مصادر التأخير ثباتاً في مسار التوظيف: تنسيق التقاويم بين عدة أطراف.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">أول تطبيق شائع للذكاء الاصطناعي لدى فرق التوظيف</p>
      </div>
    </div>
    <div class="bento-grid bento-grid-3" id="hrrecruitment-panel-support" data-hrrecruitment-tab-panel="support" role="tabpanel" aria-labelledby="hrrecruitment-tab-support" hidden>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة التعيين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">معالجة المستندات وإسناد المهام تلقائياً أثناء التعيين يقللان العبء الإداري وخطر تفويت خطوات الامتثال معاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يقلل أخطاء أوراق الموظفين الجدد وتأخيراتها</p>
      </div>
      <div class="card">
