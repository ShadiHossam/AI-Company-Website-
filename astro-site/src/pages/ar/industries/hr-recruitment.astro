---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي للموارد البشرية والتوظيف في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/hr-recruitment",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الموارد البشرية والتوظيف", "item": "https://lenooai.com/ar/industries/hr-recruitment" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي للموارد البشرية والتوظيف في الإمارات",
    "description": "فرز مرشحين، أتمتة جدولة مقابلات، معالجة مستندات الالتحاق، وبوت استفسارات موظفين لفرق الموارد البشرية في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يُدخل فرز السير الذاتية بالذكاء الاصطناعي تحيّزاً في التوظيف؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يمكن ذلك إن بُني بإهمال. نختبر نماذج الفرز مقابل التكافؤ الديموغرافي قبل النشر ونستبعد أي بديل لخصائص محمية من معايير التقييم. خطر التحيّز سبب للبناء بعناية، لا سبب لتجنب الأتمتة كلياً." }
      },
      {
        "@type": "Question",
        "name": "هل سيشعر المرشحون أنهم يتحدثون مع روبوت بدل موظف توظيف حقيقي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "البوت يتولى الجدولة والأسئلة الشائعة وتحديثات الحالة، الأشياء التي يريد المرشحون إجابتها بسرعة. أي شيء يتضمن حكماً فعلياً، كملاحظات المقابلة أو محادثة عرض عمل، يذهب لفريق التوظيف." }
      },
      {
        "@type": "Question",
        "name": "هل يتعامل مساعد الالتحاق مع أوراق التأشيرة والهوية الإماراتية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم. أتمتة مستندات الالتحاق مبنية حول الأوراق الفعلية التي يعالجها أصحاب العمل في الإمارات: خطابات العرض، العقود العمالية، وثائق الهوية الإماراتية والتأشيرة، وإقرارات سياسة الشركة." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق إطلاق الفرز الذكي أو مساعد الالتحاق؟",
        "acceptedAnswer": { "@type": "Answer", "text": "فرز السير الذاتية ينطلق عادة خلال ٣ إلى ٥ أسابيع بعد تحديد معايير التقييم. أتمتة الالتحاق التي تلمس أوراق التأشيرة والعقود تستغرق ٥ إلى ٧ أسابيع." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للموارد البشرية والتوظيف في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أنظمة فرز مرشحين وجدولة مقابلات وأتمتة التحاق لفرق الموارد البشرية في الإمارات، ثنائية اللغة ومتوافقة مع قانون العمل."
  canonicalPath="/ar/industries/hr-recruitment"
  enPath="/industries/hr-recruitment"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الموارد البشرية والتوظيف</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">groups</span>
      الموارد البشرية والتوظيف
    </div>
    <h1>ذكاء اصطناعي للموارد البشرية في الإمارات<br><span class="gradient-text">فرز مئات السير الذاتية يدوياً لا يتوسّع</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      موظفو التوظيف يقضون ساعات بقراءة سير ذاتية لا تلبي المتطلبات الأساسية. نبني لك أدوات فرز، جدولة مقابلات آلية، وأتمتة مستندات التحاق تُغطي التأشيرة والهوية الإماراتية، ثنائية اللغة.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_hr_recruitment_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1573497620053-ea5300f94f21?w=1600&q=80&auto=format&fit=crop" alt="موظف توظيف يُقابل مرشحاً لوظيفة في مكتب مضيء" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">٤٧٠٠$</p>
        <p class="stat-lbl">متوسط تكلفة التوظيف عبر الصناعات (SHRM)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٤٢ يوماً</p>
        <p class="stat-lbl">متوسط وقت شغل وظيفة عبر الصناعة (SHRM)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">لغتان</p>
        <p class="stat-lbl">دعم كامل ثنائي اللغة للمرشحين والموظفين</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في فريق الموارد البشرية</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بنظام تتبع المتقدمين ونظام معلومات الموارد البشرية لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">person_search</span>
        <h3>فرز مرشحين ومطابقة سير ذاتية</h3>
        <p style="color:#42474e;line-height:1.7;">يُقيّم ويُرتّب الطلبات الواردة مقابل متطلبات الوظيفة الفعلية، مُختبَراً مقابل التكافؤ الديموغرافي قبل النشر.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">calendar_month</span>
        <h3>أتمتة جدولة المقابلات</h3>
        <p style="color:#42474e;line-height:1.7;">ينسّق أوقات المقابلات عبر المرشحين ومديري التوظيف وأعضاء اللجنة تلقائياً، مُزيلاً المراسلات المتبادلة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">forum</span>
        <h3>بوت أسئلة المرشحين والالتحاق</h3>
        <p style="color:#42474e;line-height:1.7;">يجيب فوراً عن أسئلة المرشحين حول العملية والمواعيد والخطوات التالية، بالعربي والإنجليزي.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">badge</span>
        <h3>أتمتة مستندات الالتحاق</h3>
        <p style="color:#42474e;line-height:1.7;">يُعالج خطابات العرض والعقود العمالية وأوراق الهوية الإماراتية والتأشيرة تلقائياً، مُنبّهاً للمعلومات الناقصة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">support_agent</span>
        <h3>مساعد استفسارات الموظفين</h3>
        <p style="color:#42474e;line-height:1.7;">يجيب فوراً عن أسئلة الموظفين حول رصيد الإجازات والسياسات والمزايا، مُقلّلاً تذاكر الموارد البشرية الروتينية.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">rate_review</span>
        <h3>مساعد صياغة تقييمات الأداء</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد ملخصات تقييم أداء منظمة من ملاحظات المدير وبيانات تتبع الأهداف، ليراجعها المدير ويُخصّصها.</p>
      </div>
    </div>
  </div>
</section>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر في الموارد البشرية والتوظيف</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">person_search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">فرز السير الذاتية بالذكاء الاصطناعي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الفرز تُرتّب المرشحين مقابل متطلبات الوظيفة أسرع بكثير من المراجعة اليدوية، رغم أن اختبار التحيّز ضروري لتجنب تكرار أنماط توظيف سابقة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل وقت الفرز الأولي من ساعات لدقائق لكل طلب توظيف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">forum</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إشراك المرشحين عبر بوت</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">البوتات تُبقي المرشحين مُطّلعين على حالة العملية، محرّك رئيسي لرضا المرشحين لا يستطيع موظفو التوظيف مجاراته يدوياً بحجم كبير.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُعالج مباشرة أحد أكثر شكاوى المرشحين شيوعاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">calendar_month</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة جدولة المقابلات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الجدولة الآلية تُزيل أحد أكثر مصادر التأخير ثباتاً في قمع التوظيف: تنسيق التقاويم عبر أطراف متعددة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">أول نشر شائع للذكاء الاصطناعي لفرق التوظيف</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">badge</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة الالتحاق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">معالجة المستندات وتوزيع المهام الآلي أثناء الالتحاق تُقلّل العبء الإداري وخطر خطوات امتثال فائتة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل أخطاء وتأخيرات أوراق الموظفين الجدد</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">support_agent</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعدو الخدمة الذاتية للموظفين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">بوتات تتولى أسئلة الموارد البشرية الروتينية وطلبات الإجازة وأسئلة السياسات تُقلّل حجم التذاكر لفرق الموارد البشرية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّل حجم تذاكر الموارد البشرية الروتينية بشكل ملحوظ</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">trending_down</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توقّع الاستنزاف والاحتفاظ بالموظفين</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">نماذج تنبؤية تُنبّه لأنماط مشاركة وأداء مرتبطة بمخاطر استقالة، مانحة المدراء فرصة تدخل قبل الاستقالة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تُستخدم لتحديد أولويات محادثات الاحتفاظ استباقياً</p>
      </div>
    </div>
  </div>
</section>

<!-- EVALUATION CRITERIA -->
<section class="section" style="background:#e7eeff;" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعل ذكاء الموارد البشرية يعمل فعلياً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">اختبار التحيّز والعدالة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">نماذج الفرز المُدرَّبة على بيانات توظيف تاريخية قد ترث تحيّزاً تاريخياً. الاختبار مقابل التكافؤ الديموغرافي قبل الإطلاق متطلب، لا خيار.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">امتثال قانون العمل الإماراتي</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أتمتة الالتحاق تحتاج التعامل مع متطلبات العقد والتأشيرة والهوية الإماراتية المحددة التي يواجهها أصحاب العمل، لا عملية موارد بشرية غربية عامة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">أثر تجربة المرشح</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الأتمتة يجب أن تجعل المرشحين يشعرون بمعرفة أكثر لا تجاهل أكثر. بوت يجيب فوراً يفوز على نموذج يختفي في فراغ.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع نظام التتبع والموارد البشرية</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">أدوات الفرز والالتحاق تُضيف قيمة فقط متصلة بأنظمة تتبع المتقدمين والموارد البشرية الفعلية لديكم، لا عملية جانبية منفصلة.</p>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRY RESEARCH -->
<section class="section" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات حول الذكاء الاصطناعي في الموارد البشرية والتوظيف</h2>
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٤٧٠٠$</p>
        <p style="color:#42474e; font-size:0.875rem;">متوسط تكلفة التوظيف عبر الصناعات (SHRM)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٤٢ يوماً</p>
        <p style="color:#42474e; font-size:0.875rem;">متوسط وقت شغل وظيفة عبر الصناعة (SHRM)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٢</p>
        <p style="color:#42474e; font-size:0.875rem;">لغتان مدعومتان أصلياً في كل أداة نبنيها للمرشحين والموظفين</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">تكلفة التوظيف</p>
          <p style="color:#42474e; line-height:1.7;">بحث SHRM المرجعي يضع متوسط تكلفة التوظيف باستمرار في الآلاف من الدولارات، مدفوعاً بشدة بالوقت المُنفَق على الفرز والجدولة والتنسيق عبر عملية توظيف طويلة.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">وقت الشغل</p>
          <p style="color:#42474e; line-height:1.7;">المعايير الصناعية تضع متوسط وقت شغل وظيفة عند نحو ستة أسابيع. تأخيرات الجدولة والفرز اليدوي تُذكَر باستمرار كمساهمين رئيسيين، مجالان للأتمتة فيهما أثر مباشر وقابل للقياس.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">تجربة المرشح</p>
          <p style="color:#42474e; line-height:1.7;">أبحاث التوظيف تُحدّد باستمرار نقص التواصل وتحديثات الحالة كأحد أكبر إحباطات المرشحين خلال عملية التوظيف، فجوة تُغلقها بوتات الحالة الآلية مباشرة.</p>
        </div>
      </div>
    </div>
  </div>
</section>

