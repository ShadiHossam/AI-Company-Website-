---
export const prerender = false;
import ArBaseLayout from "../../../layouts/ArBaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";
import PageHero from '../../../components/PageHero.astro';

const fallbackFaqs = [
  { question: "كيف تفصلون بيانات العملاء عندما يبحث الذكاء الاصطناعي عبر المشاريع؟", answer: "صلاحيات الوصول تتبع صلاحيات المشاريع القائمة لديكم. مساعد المعرفة لا يعرض إلا المستندات المسموح للمستخدم برؤيتها أصلاً، ولا تُستخدم بيانات أي عميل لتدريب نموذج يستطيع فريق عميل آخر الاستعلام منه." },
  { question: "هل سيوفر مساعد المعرفة الداخلي الوقت فعلاً، أم سيضيف أداة أخرى فقط؟", answer: "لا يستحق مكانه إلا إذا كان أسرع من سؤال زميل أو البحث يدوياً، وهذا هو المعيار الذي نلتزم به خلال المرحلة التجريبية. إذا لم يستخدمه المستشارون خلال الأسابيع الأولى، نعتبر ذلك إشارة لإصلاح الإعداد، لا سبباً لإعلان النجاح على أي حال." },
  { question: "هل يستطيع الذكاء الاصطناعي صياغة تقارير جاهزة للعملاء، أم ينتج شيئاً عاماً جداً؟", answer: "يصيغ من نماذج مكتبكم الفعلية ونبرته ومخرجاته السابقة، لا من صيغة عامة. يبقى المستشار يراجع ويحسّن قبل أن يصل أي شيء للعميل، لكن المسودة الأولى تبدأ من مرحلة أكثر تقدماً بكثير." },
  { question: "كم يستغرق تشغيل مساعد معرفة داخلي؟", answer: "المرحلة التجريبية العاملة المحددة لمجال ممارسة واحد أو مجموعة مستندات واحدة تُطلق عادةً خلال ٤ إلى ٦ أسابيع. أما التعميم على مستوى المكتب عبر عدة مجالات ممارسة فيستغرق وقتاً أطول، حسب مدى تشتت أنظمة المستندات الحالية لديكم." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'ar_consulting')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // الرجوع إلى المحتوى الثابت عند حدوث خطأ
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات الخدمات المهنية والاستشارات في الإمارات",
    "url": "https://lenooai.com/ar/industries/consulting",
    "description": "أنظمة ذكاء اصطناعي مخصصة لشركات الاستشارات والخدمات المهنية في الإمارات: مساعدو المعرفة الداخلية، وأتمتة العروض، وتقارير العملاء، وتحليل الاجتماعات.",
    "inLanguage": "ar",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Professional Services"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الذكاء الاصطناعي للخدمات المهنية", "item": "https://lenooai.com/ar/industries/consulting" }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للاستشارات والخدمات المهنية في الإمارات"
  description="Lenoo AI، وكالة ذكاء اصطناعي في دبي، تبني أنظمة ذكاء اصطناعي مخصصة لشركات الاستشارات والخدمات المهنية في الإمارات: مساعدو المعرفة الداخلية، وصياغة العروض."
  canonicalPath="/ar/industries/consulting"
  enPath="/industries/consulting"
  ldJson={ldJson}
>

<PageHero image={{ src: "https://images.pexels.com/photos/5833349/pexels-photo-5833349.jpeg", alt: "مستشار وعميل يناقشان خطة على طاولة اجتماع" }}>
  <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التصفح"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الخدمات المهنية</div>
  <h1>ذكاء اصطناعي<span class="h1-sep">: </span><br><span class="gradient-text">للاستشارات والخدمات المهنية في الإمارات</span></h1>
  <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">تبني Lenoo AI أنظمة ذكاء اصطناعي مخصصة لشركات الاستشارات والخدمات المهنية في الإمارات: مساعدو المعرفة الداخلية، وصياغة العروض، وأتمتة تقارير العملاء، وتحليل الاجتماعات. مبنية حول طريقة عمل مستشاريكم الفعلية.</p>
  <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
    <button onclick="openModal(this)" data-source="ar_consulting_hero" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الاستشارات</button>
    <a href="#what-we-build" class="btn-outline">شاهدوا ما نبنيه ↓</a>
  </div>
  <StatStrip stats={[
    { value: "٩٫٣ ساعات", caption: "يقضيها العاملون في مجال المعرفة أسبوعياً في البحث عن المعلومات وجمعها (McKinsey Global Institute)" },
    { value: "٢٤/٧", caption: "توفر مساعد المعرفة الداخلي عبر المناطق الزمنية والمكاتب" },
    { value: "٠", caption: "بيانات عملاء تُشارك عبر حدود المشاريع" },
  ]} />

</PageHero>

<!-- WHY CONSULTING & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">لماذا الخدمات المهنية من أعلى القطاعات تأثراً بالذكاء الاصطناعي</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>المعرفة مبعثرة في أرجاء شركتكم.</strong> وجدت أبحاث McKinsey Global Institute أن العاملين في مجال المعرفة يقضون نحو ٩٫٣ ساعات أسبوعياً في البحث عن معلومات وجمعها، وكثيراً ما تكون موجودة أصلاً في مكان ما داخل المؤسسة. مساعد المعرفة الداخلي يعيد هذا الوقت إلى العمل القابل للفوترة.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>العروض والتقارير تتبع أنماطاً، لكن نادراً ما يُعاد استخدامها بكفاءة.</strong> معظم الشركات تعيد كتابة أقسام متشابهة من الصفر لكل عرض أو تقرير جديد. أدوات الصياغة بالذكاء الاصطناعي المدرَّبة على نماذجكم وأعمالكم السابقة تنتج مسودة أولى قوية في دقائق.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>مخرجات الاجتماعات تضيع.</strong> المهام والقرارات التي نوقشت في اجتماعات العملاء غالباً ما تبقى في ملاحظات شخص واحد فقط. أدوات تحليل الاجتماعات تلتقطها وتوزعها تلقائياً، فلا يعتمد شيء على الذاكرة.</p>
      </div>
      <div class="split-media">
        <img src="https://images.unsplash.com/photo-1757405944970-dfca42373629?w=800&q=80&auto=format&fit=crop" alt="مستشار يقدم عرضاً لزملائه خلال اجتماع عمل في مكتب" loading="lazy" width="800" height="600" />
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">أنظمة ذكاء اصطناعي مبنية لشركات الاستشارات والخدمات المهنية في الإمارات</h2>
      <p>ستة أنظمة تبنيها وكالتنا للذكاء الاصطناعي في دبي لشركات الاستشارات والخدمات المهنية، مربوطة بأنظمة المستندات وإدارة الممارسة لديكم.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد المعرفة الداخلي</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يبحث في مستندات شركتكم والمشاريع السابقة والويكي الداخلي ليجيب عن الأسئلة فوراً، مع احترام نفس صلاحيات الوصول التي يملكها فريقكم أصلاً.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">لا يعرض إلا ما يُسمح للمستخدم برؤيته أصلاً</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة صياغة العروض ونطاقات العمل</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ العروض ووثائق نطاق العمل من نماذج شركتكم والعروض الفائزة السابقة، فيبدأ فريقكم من نقطة قوية بدلاً من صفحة فارغة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مدرَّب على نبرة شركتكم وبنيتها الخاصة، لا على نماذج عامة</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">summarize</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تقارير العملاء</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع بيانات المشاريع ونتائجها في مسودات تقارير جاهزة للعملاء وفق جدول دوري، فيقل الوقت الذي يقضيه المحللون في التنسيق بدلاً من التحليل.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">المستشارون يراجعون ويعتمدون قبل أن يصل أي شيء للعميل</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">groups</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">محاضر الاجتماعات واستخراج المهام</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يلتقط القرارات والمهام من اجتماعات العملاء تلقائياً ويوزعها على الأشخاص المعنيين، فلا يعتمد شيء على ملاحظات شخص واحد.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يبقي كل مشروع منضبطاً دون متابعة يدوية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">insights</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">مساعد البحث وتحليل السوق</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يجمع بيانات السوق ومعلومات المنافسين والأبحاث الداخلية في ملخص منظم، فيختصر وقت بحث المحللين في المراحل الأولى من المشاريع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يفرّغ وقت المحللين للتفسير، لا للجمع فقط</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">schedule</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">أتمتة تسجيل الوقت والفوترة</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">يصيغ قيود الوقت من نشاط التقويم والمستندات، فيقل الوقت غير المفوتر الضائع بسبب عادات التسجيل اليدوي غير المنتظمة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يحسّن معدلات التحصيل دون إضافة عبء إداري</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:2.5rem;padding:2rem;background:#f9f9ff;border-radius:20px;">
      <p style="color:#00253b;font-weight:700;font-size:1.0625rem;margin-bottom:0.5rem;">مشمول بضمان الاسترداد ١٠٠٪</p>
      <p style="color:#42474e;font-size:0.9rem;margin-bottom:1.5rem;">كل الأنظمة تحترم صلاحيات المشاريع وحدود السرية القائمة، وتتكامل مع أدواتكم الحالية.</p>
      <button onclick="openModal(this)" data-source="ar_consulting_mid" class="btn-primary">احجزوا تدقيقاً مجانياً لذكاء الاستشارات</button>
    </div>
  </div>
</section>

<div style="position:relative; overflow:hidden; height:280px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1758873269035-aae0e1fd3422?w=1400&q=80&auto=format&fit=crop" alt="فريق استشارات يراجع خطة مشروع لعميل معاً حول لوح أبيض" loading="lazy" width="1400" height="280" style="width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.35) 0%,transparent 55%);"></div>
</div>

<!-- KEY AI APPLICATIONS -->
<section id="applications" class="section" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يحقق الذكاء الاصطناعي أكبر أثر في الخدمات المهنية</h2>
    </div>
    <div class="consulting-tabs" role="tablist" aria-label="فئات التطبيقات">
      <button type="button" id="consulting-tab-client" class="consulting-tab-btn active" data-consulting-tab="client" role="tab" aria-selected="true" aria-controls="consulting-panel-client">موجهة للعملاء</button>
      <button type="button" id="consulting-tab-internal" class="consulting-tab-btn" data-consulting-tab="internal" role="tab" aria-selected="false" aria-controls="consulting-panel-internal">العمليات الداخلية</button>
    </div>
    <div class="bento-grid bento-grid-3" id="consulting-panel-client" data-consulting-tab-panel="client" role="tabpanel" aria-labelledby="consulting-tab-client">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">إعداد العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الصياغة بالذكاء الاصطناعي المدرَّبة على عروض الشركة السابقة تنتج مسودات أولى قوية، فتركز فرق تطوير الأعمال جهدها على التخصيص واستراتيجية الفوز.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">تختصر وقت إعداد العروض بشكل كبير</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">groups</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تحليل الاجتماعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">الأدوات التي تنسخ الاجتماعات وتلخصها وتستخرج منها المهام من أسرع فئات الذكاء الاصطناعي في بيئة العمل تبنّياً عبر الخدمات المهنية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">متبناة على نطاق واسع في شركات الاستشارات والمحاماة والاستشارات المالية</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">psychology</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تجميع الأبحاث</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مساعدو البحث بالذكاء الاصطناعي يجمعون المعلومات من مصادر متعددة وينظمونها في ملخصات قابلة للاستخدام، فتختصر مرحلة البحث الأولى في معظم المشاريع.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يسرّع تحديد نطاق المشاريع وتحليلها في مراحلها الأولى</p>
      </div>
    </div>
    <div class="bento-grid bento-grid-3" id="consulting-panel-internal" data-consulting-tab-panel="internal" role="tabpanel" aria-labelledby="consulting-tab-internal" hidden>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">search</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء اصطناعي لإدارة المعرفة الداخلية</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مساعدو البحث الذين يعرضون الأعمال السابقة والخبرات والمعرفة المؤسسية يعالجون استنزافاً موثقاً جيداً للإنتاجية: موظفون يبحثون عن معلومات موجودة أصلاً في مكان ما داخل الشركة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">العاملون في مجال المعرفة يقضون ما يُقدَّر بـ ٩٫٣ ساعات أسبوعياً في البحث عن المعلومات (McKinsey Global Institute)</p>
      </div>
      <div class="card">
