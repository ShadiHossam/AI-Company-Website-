---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات الاستشارات والخدمات المهنية في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/consulting",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "الاستشارات والخدمات المهنية", "item": "https://lenooai.com/ar/industries/consulting" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات الاستشارات والخدمات المهنية في الإمارات",
    "description": "مساعد معرفة داخلي، أتمتة عروض ومقترحات، تقارير عملاء، وذكاء اجتماعات لشركات الاستشارات والخدمات المهنية في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "كيف تُبقون بيانات العملاء منفصلة حين يبحث الذكاء الاصطناعي عبر المشاريع؟",
        "acceptedAnswer": { "@type": "Answer", "text": "الصلاحيات تتبع صلاحيات المشاريع الحالية لديكم. مساعد المعرفة يُظهر فقط المستندات التي يملك المستخدم صلاحية رؤيتها بالفعل، ولا شيء من بيانات عميل يُدرَّب عليه نموذج يستطيع فريق عميل آخر استعلامه." }
      },
      {
        "@type": "Question",
        "name": "هل مساعد المعرفة الداخلي سيوفر وقتاً فعلياً أم مجرد أداة إضافية؟",
        "acceptedAnswer": { "@type": "Answer", "text": "لا يستحق مكانه إلا إذا كان أسرع من سؤال زميل أو البحث يدوياً، وهذا هو المعيار الذي نُقيّمه به خلال التجربة. إن لم يستخدمه الاستشاريون خلال الأسابيع الأولى، نعتبرها إشارة لإصلاح الإعداد." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع الذكاء الاصطناعي صياغة تقارير جاهزة للعميل، أم شيء عام جداً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يُسوّد من قوالب شركتكم الفعلية ونبرتها ومنجزاتها السابقة، لا صيغة عامة. الاستشاري يراجع ويُحسّن قبل وصول أي شيء للعميل، لكن المسودة الأولى تبدأ أبعد بكثير." }
      },
      {
        "@type": "Question",
        "name": "كم يستغرق تشغيل مساعد معرفة داخلي؟",
        "acceptedAnswer": { "@type": "Answer", "text": "تجربة عاملة محدودة بمجال ممارسة أو مجموعة مستندات واحدة تنطلق عادة خلال ٤ إلى ٦ أسابيع. الانتشار على مستوى الشركة عبر مجالات متعددة يستغرق وقتاً أطول حسب تشتت أنظمة مستنداتكم الحالية." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للاستشارات والخدمات المهنية في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني مساعد معرفة داخلي وأتمتة تقارير وعروض لشركات الاستشارات والخدمات المهنية في الإمارات."
  canonicalPath="/ar/industries/consulting"
  enPath="/industries/consulting"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>الاستشارات والخدمات المهنية</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">work</span>
      الاستشارات والخدمات المهنية
    </div>
    <h1>ذكاء اصطناعي لشركات الاستشارات في الإمارات<br><span class="gradient-text">وقت أقل بحثاً، وقت أكثر تحليلاً</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      استشاريوك يقضون ساعات أسبوعياً في البحث عن معلومة موجودة بالفعل في مكان ما بالشركة. نبني لك مساعد معرفة داخلياً، أتمتة صياغة العروض والتقارير، واستخلاص قرارات الاجتماعات، دون خلط بيانات عميل بآخر.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_consulting_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1757405944970-dfca42373629?w=1600&q=80&auto=format&fit=crop" alt="استشاري يعرض لزملائه خلال اجتماع عمل في مكتب" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 35%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">٩.٣ ساعة</p>
        <p class="stat-lbl">أسبوعياً يقضيها موظفو المعرفة بالبحث (McKinsey)</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">٢٤/٧</p>
        <p class="stat-lbl">توفر مساعد المعرفة عبر المناطق الزمنية والمكاتب</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">صفر</p>
        <p class="stat-lbl">بيانات عميل مشتركة عبر حدود المشاريع</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة الاستشارات</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بأنظمة مستنداتكم وإدارة المشاريع لديكم.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">search</span>
        <h3>مساعد معرفة داخلي</h3>
        <p style="color:#42474e;line-height:1.7;">يبحث عبر مستندات شركتكم ومشاريعكم السابقة وويكي داخلي ليجيب فوراً، مع احترام نفس صلاحيات فريقكم.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">description</span>
        <h3>أتمتة صياغة العروض والمقترحات</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد العروض ووثائق نطاق العمل من قوالب شركتكم وعروضكم الفائزة السابقة، فتبدأون من نقطة متقدمة لا صفحة فارغة.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">summarize</span>
        <h3>أتمتة تقارير العملاء</h3>
        <p style="color:#42474e;line-height:1.7;">يُجمّع بيانات المشروع والنتائج في مسودات تقارير جاهزة للعميل بجدول متكرر، ويُقلّص وقت التنسيق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">groups</span>
        <h3>استخلاص ملاحظات وقرارات الاجتماعات</h3>
        <p style="color:#42474e;line-height:1.7;">يلتقط القرارات ونقاط العمل من اجتماعات العملاء تلقائياً ويوزّعها على الأشخاص المناسبين.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">insights</span>
        <h3>مساعد بحث وتحليل سوق</h3>
        <p style="color:#42474e;line-height:1.7;">يُلخّص بيانات السوق ومعلومات المنافسين والبحث الداخلي في موجز منظم، يُقلّص وقت بحث المحللين.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">schedule</span>
        <h3>أتمتة الوقت والفوترة</h3>
        <p style="color:#42474e;line-height:1.7;">يُسوّد قيود الوقت من نشاط التقويم والمستندات، ويُقلّل الوقت غير المفوتَر بسبب عادات إدخال يدوية غير متسقة.</p>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="apps-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="apps-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر في الخدمات المهنية</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">description</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">توليد العروض</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات الصياغة المُدرَّبة على عروض الشركة السابقة تُنتج مسودات أولى قوية، فيركّز فريق التطوير التجاري جهده على التخصيص واستراتيجية الفوز.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُقلّص وقت إعداد العرض بشكل ملحوظ</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">groups</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">ذكاء الاجتماعات</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">أدوات تُفرّغ وتُلخّص وتستخرج نقاط العمل من الاجتماعات هي من أسرع فئات الذكاء الاصطناعي المكتبي انتشاراً عبر الخدمات المهنية.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">منتشرة على نطاق واسع عبر شركات الاستشارات والقانون</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">psychology</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تجميع البحث</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">مساعدو البحث بالذكاء الاصطناعي يُجمّعون وينظّمون المعلومات من مصادر متعددة في موجزات قابلة للاستخدام، ما يُختصر مرحلة البحث المبكرة.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">يُسرّع تحديد نطاق المشاريع الجديدة وتحليلها</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعل ذكاء الخدمات المهنية يعمل فعلياً</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">جودة قاعدة المعرفة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مساعد المعرفة مفيد بقدر ما يستطيع البحث فيه. مستندات غير منظمة أو قديمة أو مكررة تُنتج إجابات غير منظمة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">السرية عبر المشاريع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">عمل العميل يجب أن يبقى منفصلاً حسب صلاحيات المشروع، تماماً كما في أي نظام آخر لديكم. صلاحيات الذكاء الاصطناعي يجب أن تعكس هذا الواقع.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التكامل مع الأدوات</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">مساعد معرفة لا يتصل بـ SharePoint أو نظام إدارة العملاء أو أين تعيش مستنداتكم فعلياً يخلق عزلة إضافية، لا حلاً.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التبني وإدارة التغيير</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">الاستشاريون مشغولون ومتشككون تجاه الأدوات الجديدة افتراضياً. تجربة بحضور صريح ونتيجة سريعة وواضحة تدفع التبني أفضل من إلزام على مستوى الشركة.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات حول الذكاء الاصطناعي في الخدمات المهنية</h2>
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">٩.٣ ساعة</p>
        <p style="color:#42474e; font-size:0.875rem;">أسبوعياً يقضيها موظفو المعرفة بالبحث وجمع المعلومات (McKinsey Global Institute)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">١.٨ ساعة</p>
        <p style="color:#42474e; font-size:0.875rem;">منها يومياً للبحث فقط، قبل بدء أي تحليل فعلي (McKinsey Global Institute)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">صفر</p>
        <p style="color:#42474e; font-size:0.875rem;">وصول نموذج مشترك عبر مشاريع عملاء منفصلة في أي نظام نبنيه</p>
      </div>
    </div>
    <div class="research-panel">
      <div class="ind-text-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; font-size:0.875rem;">
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">تكلفة البحث عن معلومة</p>
          <p style="color:#42474e; line-height:1.7;">بحث McKinsey Global Institute الشهير وجد أن موظفي المعرفة يقضون قرابة ربع أسبوع عملهم بالبحث وجمع معلومات، تكلفة تتراكم عبر الشركات الكبيرة ذات أنظمة المستندات المتشتتة.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">كفاءة التقارير</p>
          <p style="color:#42474e; line-height:1.7;">الشركات التي تستخدم صياغة تقارير بمساعدة الذكاء الاصطناعي تُبلغ عن تخفيض ملموس في وقت التنسيق والمسودة الأولى، فيقضي كبار الموظفين وقتاً أكبر نسبياً في التحليل.</p>
        </div>
        <div>
          <p style="font-weight:700; color:#00253b; margin-bottom:0.5rem;">أنماط التبني</p>
          <p style="color:#42474e; line-height:1.7;">عبر شركات الخدمات المهنية، أدوات ذكاء الاجتماعات والبحث الداخلي تُظهر باستمرار أسرع وأوسع تبني لأي فئة ذكاء اصطناعي، لأن القيمة فورية ولا تتطلب تغييراً في طريقة تسليم عمل العميل.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- GUARANTEE -->
<section class="section" style="background:#e7eeff;padding:4rem 0;text-align:center;">
  <div class="container">
    <div class="guarantee-badge" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:18px;direction:ltr;" aria-hidden="true">shield</span>
      ضمان الاسترداد الكامل، الوحيد في الإمارات
    </div>
    <h2 style="margin-bottom:1rem;">إذا لم تكن راضياً، لا تدفع أي شيء.</h2>
    <p style="color:#42474e;max-width:560px;margin:0 auto 2rem;line-height:1.8;">نبني، تختبر، وإذا لم تكن راضياً تماماً نردّ ١٠٠٪ خلال ٣٠ يوماً من التسليم. بدون أسئلة.</p>
    <button onclick="openModal(this)" data-source="ar_consulting_guarantee" class="btn-primary">ابدأ بدون مخاطرة</button>
  </div>
</section>

<!-- FAQ -->
<section class="section">
  <div class="container" style="max-width:760px;">
    <h2 style="text-align:center;margin-bottom:2.5rem;">أسئلة شائعة</h2>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          كيف تُبقون بيانات العملاء منفصلة حين يبحث الذكاء الاصطناعي عبر المشاريع؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">الصلاحيات تتبع صلاحيات المشاريع الحالية لديكم. مساعد المعرفة يُظهر فقط المستندات التي يملك المستخدم صلاحية رؤيتها بالفعل، ولا شيء من بيانات عميل يُدرَّب عليه نموذج يستطيع فريق عميل آخر استعلامه.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          هل مساعد المعرفة الداخلي سيوفر وقتاً فعلياً أم مجرد أداة إضافية؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">لا يستحق مكانه إلا إذا كان أسرع من سؤال زميل أو البحث يدوياً، وهذا هو المعيار الذي نُقيّمه به خلال التجربة. إن لم يستخدمه الاستشاريون خلال الأسابيع الأولى، نعتبرها إشارة لإصلاح الإعداد.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          هل يستطيع الذكاء الاصطناعي صياغة تقارير جاهزة للعميل، أم شيء عام؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">يُسوّد من قوالب شركتكم الفعلية ونبرتها ومنجزاتها السابقة، لا صيغة عامة. الاستشاري يراجع ويُحسّن قبل وصول أي شيء للعميل، لكن المسودة الأولى تبدأ أبعد بكثير.</div>
      </div>
      <div class="faq-item">
        <button class="faq-btn" onclick="toggleFaq(this)" aria-expanded="false">
          كم يستغرق تشغيل مساعد معرفة داخلي؟
          <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg></span>
        </button>
        <div class="faq-body">تجربة عاملة محدودة بمجال ممارسة أو مجموعة مستندات واحدة تنطلق عادة خلال ٤ إلى ٦ أسابيع. الانتشار على مستوى الشركة يستغرق وقتاً أطول حسب تشتت أنظمة مستنداتكم الحالية.</div>
      </div>
    </div>
  </div>
</section>

