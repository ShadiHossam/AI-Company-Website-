---
export const prerender = false;
import ArBaseLayout from '../../../layouts/ArBaseLayout.astro';

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "الذكاء الاصطناعي لشركات التجارة والتوزيع في الإمارات | Lenoo AI",
    "url": "https://lenooai.com/ar/industries/trading-distribution",
    "inLanguage": "ar",
    "isPartOf": { "@type": "WebSite", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://lenooai.com/ar" },
      { "@type": "ListItem", "position": 2, "name": "القطاعات", "item": "https://lenooai.com/ar/industries" },
      { "@type": "ListItem", "position": 3, "name": "التجارة والتوزيع", "item": "https://lenooai.com/ar/industries/trading-distribution" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "الذكاء الاصطناعي لشركات التجارة والتوزيع في الإمارات",
    "description": "أتمتة عروض أسعار، معالجة طلبات، تنبيهات مخزون، وتذكير إعادة طلب للعملاء لشركات التجارة والتوزيع في الإمارات.",
    "areaServed": {"@type": "Country", "name": "United Arab Emirates"},
    "provider": { "name": "Lenoo AI", "url": "https://lenooai.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "هل يعمل هذا مع نظام ERP أو المخزون الذي نستخدمه بالفعل؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نبني حول أدوات ERP والمخزون التي تُشغّل عملكم بالفعل بدل طلب استبدالها. قبل بدء أي بناء، نُحدّد إعدادكم الخاص ونؤكد ما تدعمه خيارات التكامل في نظامكم." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع إبقاء المخزون متزامناً عبر فروع أو مستودعات متعددة؟",
        "acceptedAnswer": { "@type": "Answer", "text": "نعم، حين يتابع نظام مخزونكم المخزون حسب الموقع بالفعل. الذكاء الاصطناعي يقرأ ويُحدّث مقابل نفس مصدر الحقيقة، فيعكس تنبيه إعادة الطلب أو المخزون الفرع أو المستودع الصحيح." }
      },
      {
        "@type": "Question",
        "name": "هل يستطيع الذكاء الاصطناعي التعامل مع شروط الائتمان ومتابعة الدفع تلقائياً؟",
        "acceptedAnswer": { "@type": "Answer", "text": "يستطيع متابعة أي الفواتير تقترب أو تجاوزت شروطها المتفق عليها، وإرسال التذكير المناسب تلقائياً حسب قواعد يضعها فريقكم لكل مستوى عميل. أي استثناء، نزاع أو طلب تمديد، يُوجَّه لفريقكم." }
      }
    ]
  }
];
---

<ArBaseLayout
  title="الذكاء الاصطناعي للتجارة والتوزيع في الإمارات | Lenoo AI"
  description="Lenoo AI، وكالة الذكاء الاصطناعي في دبي، تبني أتمتة عروض أسعار ومعالجة طلبات وتنبيهات مخزون لشركات التجارة والتوزيع في الإمارات، متصلة بنظام ERP لديكم."
  canonicalPath="/ar/industries/trading-distribution"
  enPath="/industries/trading-distribution"
  ldJson={ldJson}
>

<!-- HERO -->
<header class="page-hero">
  <div class="container">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/ar#industries-heading" style="color:inherit;text-decoration:none;opacity:0.65;">القطاعات</a><span style="opacity:0.4;padding:0 4px;"> / </span>التجارة والتوزيع</div>
    <div class="badge badge-cyan" style="margin-bottom:1.5rem;">
      <span class="material-symbols-outlined" style="font-size:16px;direction:ltr;" aria-hidden="true">inventory_2</span>
      التجارة والتوزيع
    </div>
    <h1>ذكاء اصطناعي لشركات التجارة والتوزيع في الإمارات<br><span class="gradient-text">أكثر نشاط تجاري شيوعاً بلا محتوى تقريباً</span></h1>
    <p style="max-width:640px;margin:1.5rem auto;line-height:1.8;color:rgba(255,255,255,0.72);">
      استفسار يصل عبر واتساب، أحدهم يفحص المخزون والسعر، عرض سعر يُرسل، طلب يُؤكَّد. نبني لك بوتاً يفحص المخزون والسعر ويُرسل عرض السعر خلال دقائق، يُحدّث المخزون تلقائياً، ويُذكّر بإعادة الطلب.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_trading_distribution_hero" class="btn-primary">احجز استشارة مجانية ←</button>
    </div>
  </div>
</header>

<!-- IMAGE BANNER + STATS -->
<div style="position:relative; overflow:hidden;">
  <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=1600&q=80&auto=format&fit=crop" alt="أسطول شاحنات توصيل يتحرك على طريق سريع قرب دبي" loading="eager" fetchpriority="high" width="1600" height="320" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 45%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.55) 0%,rgba(0,19,32,0.18) 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.40));"></div>
  <div style="position:relative; padding:3rem 2rem;">
    <div class="glass-dark hosp-stats-grid" style="max-width:920px; margin:0 auto; border-radius:20px; padding:2rem 2.5rem;">
      <div class="stat-item">
        <p class="stat-num">الأكثر شيوعاً</p>
        <p class="stat-lbl">نوع نشاط تجاري مُسجَّل عبر رخص البر الرئيسي والمناطق الحرة</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">×٩</p>
        <p class="stat-lbl">فرصة تحويل أعلى عند وصول عرض سعر خلال ٥ دقائق</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">واتساب أولاً</p>
        <p class="stat-lbl">كيف يُرسل معظم مشتري B2B إماراتيين استفساراتهم</p>
      </div>
      <div class="stat-item">
        <p class="stat-num">١٠٠٪</p>
        <p class="stat-lbl">ضمان استرداد إذا لم ترضَ</p>
      </div>
    </div>
  </div>
</div>

<!-- AI USE CASES -->
<section class="section">
  <div class="container">
    <h2 style="text-align:center;margin-bottom:0.75rem;">ما يفعله الذكاء الاصطناعي في شركة التجارة</h2>
    <p style="text-align:center;color:#42474e;margin-bottom:3rem;max-width:560px;margin-inline:auto;">ستة أنظمة متصلة بنظام ERP والمخزون الذي تُشغّلونه بالفعل.</p>
    <div class="feature-ledger">
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">request_quote</span>
        <h3>أتمتة الاستفسارات وعروض الأسعار</h3>
        <p style="color:#42474e;line-height:1.7;">يردّ على استفسارات المنتج عبر واتساب أو البريد، يفحص المخزون والسعر الحالي، ويرسل عرض سعر خلال دقائق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">shopping_cart</span>
        <h3>ذكاء اصطناعي لمعالجة الطلبات</h3>
        <p style="color:#42474e;line-height:1.7;">يُحوّل عرض السعر المؤكد لطلب في نظامكم، يتحقق من توفر المخزون، ويرسل تأكيداً للعميل دون إعادة إدخال يدوية.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">inventory_2</span>
        <h3>بوت تنبيهات المخزون</h3>
        <p style="color:#42474e;line-height:1.7;">يراقب مستويات المخزون مقابل نقاط إعادة الطلب وينبّه للنقص قبل أن يصبح نفاداً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">local_shipping</span>
        <h3>تواصل الموردين</h3>
        <p style="color:#42474e;line-height:1.7;">يرسل أوامر الشراء، يتابع تأكيدات الموردين، ويتابع حالة الشحن فلا يلاحق فريقكم كل مورّد بالهاتف منفرداً.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">repeat</span>
        <h3>متابعة العملاء وتذكير إعادة الطلب</h3>
        <p style="color:#42474e;line-height:1.7;">يتواصل مع العملاء حين تمر نافذة إعادة الطلب المعتادة، بناءً على نمط طلبهم السابق.</p>
      </div>
      <div class="card">
        <span class="material-symbols-outlined" style="color:#2563eb;direction:ltr;" aria-hidden="true">receipt_long</span>
        <h3>متابعة الفواتير والدفع</h3>
        <p style="color:#42474e;line-height:1.7;">يتابع الفواتير مقابل شروط الائتمان المتفق عليها لكل عميل ويرسل تذكيرات تلقائياً حسب قواعدكم.</p>
      </div>
    </div>
  </div>
</section>

<!-- ORDER JOURNEY -->
<section class="section" style="background:#f0f3ff;" aria-labelledby="order-heading">
  <div class="container" style="max-width:1040px;">
    <div class="section-header">
      <h2 id="order-heading">طلب واحد، من البداية للنهاية</h2>
      <p>ما يتولاه الذكاء الاصطناعي في كل مرحلة بينما يركّز فريقكم على علاقات الموردين والهوامش.</p>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الاستفسار يحصل على عرض سعر خلال دقائق</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">مشترٍ يُراسل يسأل عن السعر والتوفر لخط منتجات.</p>
        <ul class="journey-list">
          <li>يتحقق من المخزون والسعر الحالي مقابل نظامكم لحظياً</li>
          <li>يرسل عرض سعر مُنسَّق خلال دقائق، بلغة المشتري وعملته المفضلة</li>
          <li>يتابع تلقائياً إن لم يرد المشتري بعد نافذة محددة</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">الطلب يُحدّث المخزون تلقائياً</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بمجرد تأكيد المشتري، يحتاج الطلب الانتقال لنظامكم دون إعادة إدخال يدوية.</p>
        <ul class="journey-list">
          <li>يُنشئ الطلب في نظام ERP لديكم ويُعدّل مستويات المخزون فوراً</li>
          <li>يرسل للعميل تأكيداً وتفاصيل التسليم المتوقعة</li>
          <li>يُنبّه لنقص مخزون تلقائياً إن دفع الطلب صنفاً قرب نقطة إعادة الطلب</li>
        </ul>
      </div>
      <div class="card">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.75rem;">إعادة الطلب تُذكّر نفسها</h3>
        <p style="color:#42474e; font-size:0.9375rem; line-height:1.7; margin-bottom:1rem;">بعد أسابيع، وبناءً على نمط شراء ذلك العميل، غالباً حان وقت طلب آخر.</p>
        <ul class="journey-list">
          <li>يتواصل استباقياً عند اقتراب نافذة إعادة الطلب المعتادة</li>
          <li>يرسل تذكيرات دفع بالتوازي إن اقتربت فاتورة سابقة من موعد استحقاقها</li>
          <li>يُوجّه الرد للمبيعات لحظة رغبة العميل بالمضي قدماً</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIGGEST IMPACT -->
<section id="applications" class="section" style="background:#e7eeff;" aria-labelledby="impact-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="impact-heading">أين يُحدث الذكاء الاصطناعي أكبر أثر</h2>
    </div>
    <div class="bento-grid bento-grid-3">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">request_quote</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">سرعة إنجاز عرض السعر</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">بحث MIT حول سرعة الرد على العملاء المحتملين ينطبق مباشرة هنا: مشترٍ يُتواصَل معه خلال دقائق أكثر احتمالاً للتحويل من ينتظر ساعات.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">دقائق بدل ساعات بين الاستفسار والعرض</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">inventory_2</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">رؤية المخزون</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">التجار الذين نتحدث معهم يقولون نفس الشيء باستمرار: يكتشفون نقص المخزون حين يطلب عميل شيئاً غير موجود، لا قبل ذلك. تنبيه آلي قبل نقطة إعادة الطلب يُحوّل هذا لقرار شراء مجدول.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">مشاكل المخزون تُكتشف قبل شعور العميل بها</p>
      </div>
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" style="direction:ltr;color:#006875; font-size:24px;" aria-hidden="true">repeat</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">تكرار الأعمال</h3>
        <p style="color:#42474e; font-size:0.875rem; line-height:1.7; margin-bottom:0.75rem;">معظم إيراد التجارة يأتي من عملاء متكررين لا جدد، وطلبات إعادة الطلب تتفلّت حين لا يُتابع أحد بالوقت المناسب.</p>
        <p style="font-size:0.8125rem; font-weight:600; color:#006875;">إعادة طلب تحدث حسب جدول، لا بالصدفة</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT MAKES IT WORK -->
<section class="section" aria-labelledby="eval-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="eval-heading">ما الذي يجعله يعمل</h2>
    </div>
    <div class="eval-grid">
      <div class="card" style="text-align:center;">
        <div class="num-circle">1</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تكامل مع ERP والمخزون</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">عرض السعر أو تنبيه المخزون مفيد فقط إن كان يقرأ أرقاماً حقيقية من نظامكم الفعلي. أداة تعمل على جدول بيانات منفصل تُضيف نسخة ثانية من الحقيقة.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">2</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">عملات ولغات متعددة</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">شركات التجارة الإماراتية تتعامل مع مشترين وموردين عبر عملات ولغات متعددة كأمر روتيني. عروض الأسعار والطلبات يجب أن تعكس ذلك دون تحويل يدوي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">3</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">تواصل B2B على واتساب أولاً</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">معظم مشتري B2B إماراتيين يُرسلون الاستفسارات وأوامر الشراء عبر واتساب، لا بوابة أو نظام طلب رسمي.</p>
      </div>
      <div class="card" style="text-align:center;">
        <div class="num-circle">4</div>
        <h3 style="font-weight:700; font-size:0.9375rem; color:#00253b; margin-bottom:0.5rem;">التعامل مع شروط الائتمان والدفع</h3>
        <p style="color:#42474e; font-size:0.8125rem; line-height:1.6;">علاقات التجارة تعمل بشروط ائتمان تختلف حسب العميل. متابعة الدفع يجب أن تحترم شروط كل عميل الفعلية.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHAT THE DATA SHOWS -->
<section class="section" style="background:#e7eeff;" aria-labelledby="research-heading">
  <div class="container" style="max-width:860px;">
    <div class="section-header">
      <h2 id="research-heading">ما تُظهره البيانات</h2>
    </div>
    <div style="border-radius:24px; overflow:hidden; margin-bottom:2.5rem; box-shadow:0 24px 56px rgba(0,59,92,0.10);">
      <img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1200&q=80&auto=format&fit=crop" alt="عامل مستودع يُشغّل رافعة شوكية بين رفوف مخزون" loading="lazy" width="1200" height="380" style="width:100%; height:clamp(200px, 30vw, 380px); object-fit:cover; display:block;" />
    </div>
    <div class="ind-stats-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; margin-bottom:2rem;">
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">×٩</p>
        <p style="color:#42474e; font-size:0.875rem;">فرصة تحويل أعلى عند التواصل خلال ٥ دقائق بدل ٣٠ (MIT)</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">الأكثر شيوعاً</p>
        <p style="color:#42474e; font-size:0.875rem;">نوع نشاط تجاري عبر تسجيلات الشركات في البر الرئيسي والمناطق الحرة</p>
      </div>
      <div class="card" style="text-align:center;">
        <p class="stat-number" style="font-size:2.25rem; margin-bottom:4px;">متكرر</p>
