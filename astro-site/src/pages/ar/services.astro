---
export const prerender = false;
import ArBaseLayout from '../../layouts/ArBaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

const servicesFaqs = [
  { question: "بأي خدمة يجب أن نبدأ؟", answer: "بالنسبة لمعظم الشركات، نوصي بجلسة استراتيجية سريعة للذكاء الاصطناعي. تُخطط سير عملك، وتُرتّب الفرص حسب العائد على الاستثمار، وتخبرك بالضبط بأي خدمة تبدأ. إذا كنت تعرف بالفعل ما تحتاجه، فمكالمة استكشافية تكفي لنحدد نطاق المشروع مباشرة." },
  { question: "هل يمكننا دمج عدة خدمات في مشروع واحد؟", answer: "نعم، معظم المشاريع تفعل ذلك. قد يشمل التعاون النموذجي جلسة استراتيجية، وبناء مخصص، وتدريب الفريق ليُستخدم الأداة فعلياً. نُحدد نطاق المشاريع المدمجة كحزمة واحدة بجدول زمني واحد." },
  { question: "هل تعملون مع شركات خارج الإمارات؟", answer: "نعم. مقرنا في دبي ونخدم شركات الإمارات أولاً، لكننا نُقدّم الاستراتيجية والبناء والتدريب عن بُعد لعملاء في الشرق الأوسط وأوروبا وخارجها." },
  { question: "كيف يتم تحديد الأسعار عبر الخدمات؟", answer: "يتم تحديد نطاق كل خدمة بشكل فردي حسب التعقيد والنطاق. جلسات الاستراتيجية وبرامج التدريب لها أسعار أكثر توحيداً؛ أما البناء والأتمتة وعمليات الدمج فيُقدَّم لها عرض سعر بعد مكالمة استكشافية بمجرد فهمنا احتياجاتك." },
  { question: "ما الذي يغطيه ضمان الاسترداد 100% فعلياً؟", answer: "إذا لم تكن راضياً تماماً عما نُسلّمه، فلن تدفع. بدون شروط، بدون نزاعات. ينطبق على كل خدمة في هذه الصفحة." },
];

const servicesFaqLdJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: servicesFaqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const servicesLdJson = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "خدمات الذكاء الاصطناعي من Aegis AI",
    url: "https://lenooai.com/ar/services",
    description: "تطوير ذكاء اصطناعي مخصص، أتمتة، وكلاء ذكاء اصطناعي، أدوات داخلية، تدريب الفرق، واستشارات استراتيجية للشركات في الإمارات وخارجها.",
    publisher: { "@type": "Organization", name: "Aegis AI", url: "https://lenooai.com" },
    hasPart: [
      { "@type": "Service", name: "تطوير ذكاء اصطناعي مخصص", url: "https://lenooai.com/ar/services/custom-ai-development" },
      { "@type": "Service", name: "وكلاء الذكاء الاصطناعي", url: "https://lenooai.com/ar/services/ai-agents" },
      { "@type": "Service", name: "أتمتة الذكاء الاصطناعي", url: "https://lenooai.com/ar/services/ai-automation" },
      { "@type": "Service", name: "التدريب على الذكاء الاصطناعي وورش العمل", url: "https://lenooai.com/ar/services/ai-training" },
      { "@type": "Service", name: "استشارات استراتيجية للذكاء الاصطناعي", url: "https://lenooai.com/ar/services/ai-strategy" },
      { "@type": "Service", name: "دمج الذكاء الاصطناعي", url: "https://lenooai.com/ar/services/ai-integration" },
      { "@type": "Service", name: "أدوات ذكاء اصطناعي داخلية", url: "https://lenooai.com/ar/services/internal-ai-tools" },
      { "@type": "Service", name: "تطوير نماذج ذكاء اصطناعي مخصصة", url: "https://lenooai.com/ar/services/custom-gpt-development" },
      { "@type": "Service", name: "فايب كودينج", url: "https://lenooai.com/ar/services/vibe-coding" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "الرئيسية", item: "https://lenooai.com/ar" },
      { "@type": "ListItem", position: 2, name: "الخدمات", item: "https://lenooai.com/ar/services" },
    ],
  },
  servicesFaqLdJson,
];
---

<ArBaseLayout
  title="خدمات الذكاء الاصطناعي في الإمارات: بناء وأتمتة وتدريب واستشارات | Aegis AI"
  description="Aegis AI وكالة ذكاء اصطناعي في دبي، تقدّم 12 خدمة للشركات في الإمارات: تطوير مخصص، أتمتة، وكلاء ذكاء اصطناعي، أدوات داخلية، تدريب الفرق، واستشارات استراتيجية."
  canonicalPath="/ar/services"
  enPath="/services"
  ogImage="/assets/og-services.jpg"
  ldJson={servicesLdJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="مسار التنقل"><a href="/ar" style="color:inherit;text-decoration:none;opacity:0.65;">الرئيسية</a><span style="opacity:0.4;padding:0 4px;"> / </span>الخدمات</div>
    <h1>ثماني خدمات. مهمة واحدة.</h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.125rem; max-width:600px; margin:1.5rem auto 2.5rem;">
      نحن لا نكتفي ببناء أدوات ذكاء اصطناعي. نجعل عملك جاهزاً فعلياً للذكاء الاصطناعي. من الاستراتيجية إلى البناء إلى تمكين الفريق، نُغطي الرحلة الكاملة.
    </p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <button onclick="openModal(this)" data-source="ar_services_hero" class="btn-primary">احجز استشارة مجانية</button>
      <a href="#services-list" class="btn-outline">استعرض الخدمات ↓</a>
    </div>
  </div>
</header>

<!-- CORE SERVICES -->
<section id="services-list" class="section">
  <div class="container">

    <!-- Service 1 — Custom AI Development -->
    <div class="service-split">
      <div class="service-img-wrap">
        <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&q=80&auto=format&fit=crop" alt="تطوير ذكاء اصطناعي مخصص: واجهة روبوت محادثة وأتمتة" loading="lazy" />
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.35));"></div>
        <div class="service-img-caption">★ ضمان رضا 100%</div>
      </div>
      <div>
        <div class="service-eyebrow" style="background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.28); color:#004f58;">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size:14px;">code</span>
          تطوير ذكاء اصطناعي مخصص
        </div>
        <h2 style="font-size:clamp(1.5rem,3vw,2.25rem); font-weight:800; color:#00253b; letter-spacing:-0.03em; margin-bottom:1rem;">ذكاء اصطناعي يُبنى حول سير عملك، لا العكس</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.8; margin-bottom:1.5rem;">الذكاء الاصطناعي الجاهز لا يناسب عملك. بصفتنا وكالة ذكاء اصطناعي مقرها دبي، نبني أنظمة ذكاء اصطناعي تُنجز بالضبط ما يحتاجه فريقك: روبوتات محادثة، خطوط أتمتة، لوحات تحليلية، وأدوات تنبؤية، مدمجة مع برمجياتك الحالية.</p>
        <div style="margin-bottom:1.75rem;">
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>روبوتات محادثة ومساعدون ذكيون للتعامل مع العملاء المحتملين والدعم</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>خطوط أتمتة تُلغي المهام اليدوية</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>لوحات تحليلية وأدوات تنبؤية بالذكاء الاصطناعي</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>مدمجة مع أنظمتك البرمجية الحالية</span></div>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="/ar/services/custom-ai-development" class="btn-primary" style="font-size:0.9375rem;">اقرأ المزيد</a>
          <button onclick="openModal(this)" data-source="ar_services_custom_ai" class="btn-outline-sky" style="font-size:0.9375rem;">احصل على عرض سعر</button>
        </div>
      </div>
    </div>

    <!-- Service 2 — AI Training & Workshops -->
    <div class="service-split">
      <div class="service-img-wrap reverse" style="order:2;">
        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&q=80&auto=format&fit=crop" alt="ورشة تدريب على الذكاء الاصطناعي لفريق عمل" loading="lazy" />
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.35));"></div>
        <div class="service-img-caption">حسب الدور الوظيفي · حضوري أو عن بُعد · تسليم عالمي</div>
      </div>
      <div style="order:1;">
        <div class="service-eyebrow" style="background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.28); color:#004f58;">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size:14px;">group</span>
          التدريب على الذكاء الاصطناعي وورش العمل
        </div>
        <h2 style="font-size:clamp(1.5rem,3vw,2.25rem); font-weight:800; color:#00253b; letter-spacing:-0.03em; margin-bottom:1rem;">فريقك يحتاج لاستخدام الذكاء الاصطناعي. نتأكد من أنه يفعل.</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.8; margin-bottom:1.5rem;">بناء الذكاء الاصطناعي نصف المعركة فقط. نُدرّب موظفيك على استخدامه بثقة، عبر ورش عمل عملية مصممة حسب قطاعك وسير العمل المحدد الذي يتبعه فريقك.</p>
        <div style="margin-bottom:1.75rem;">
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>ورش عمل مخصصة لكل عضو في فريقك حسب دوره</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>تسليم حضوري أو عن بُعد، في أي مكان في العالم</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>مواد تدريبية مخصصة لقطاعك</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>دعم متابعة بعد ورشة العمل مشمول</span></div>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="/ar/services/ai-training" class="btn-primary" style="font-size:0.9375rem;">اقرأ المزيد</a>
          <button onclick="openModal(this)" data-source="ar_services_training" class="btn-outline-sky" style="font-size:0.9375rem;">احجز ورشة عمل</button>
        </div>
      </div>
    </div>

    <!-- Service 3 — AI Strategy -->
    <div class="service-split">
      <div class="service-img-wrap">
        <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&q=80&auto=format&fit=crop" alt="جلسة استشارات استراتيجية للذكاء الاصطناعي" loading="lazy" />
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.35));"></div>
        <div class="service-img-caption">نهج يركّز على العائد أولاً · خارطة طريق لـ 12 شهراً مشمولة</div>
      </div>
      <div>
        <div class="service-eyebrow" style="background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.28); color:#004f58;">
          <span class="material-symbols-outlined" aria-hidden="true" style="font-size:14px;">bar_chart</span>
          استشارات استراتيجية للذكاء الاصطناعي
        </div>
        <h2 style="font-size:clamp(1.5rem,3vw,2.25rem); font-weight:800; color:#00253b; letter-spacing:-0.03em; margin-bottom:1rem;">اعرف بالضبط أي ذكاء اصطناعي تبنيه قبل أن تُنفق درهماً واحداً</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.8; margin-bottom:1.5rem;">نُخطط سير عملك، ونحدد فرص الذكاء الاصطناعي الأعلى عائداً، ونُسلّمك خطة تنفيذ واضحة لـ 12 شهراً. بدون تخمين. بدون هدر في الميزانية. مجرد مسار واضح للأمام.</p>
        <div style="margin-bottom:1.75rem;">
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>تدقيق كامل لسير العمل لاكتشاف فرص الذكاء الاصطناعي</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>توقعات العائد على الاستثمار لكل حالة استخدام</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>خارطة طريق لتنفيذ الذكاء الاصطناعي لمدة 12 شهراً</span></div>
          <div class="check-item"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:20px; flex-shrink:0; margin-top:2px;">check</span><span>توصيات بالموردين والأدوات المناسبة لأنظمتك</span></div>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="/ar/services/ai-strategy" class="btn-primary" style="font-size:0.9375rem;">اقرأ المزيد</a>
          <button onclick="openModal(this)" data-source="ar_services_strategy" class="btn-outline-sky" style="font-size:0.9375rem;">احصل على جلسة استراتيجية</button>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- DUBAI BANNER -->
<div style="width:100%; height:300px; overflow:hidden; position:relative;">
  <div style="width:100%; height:100%; background:#00192a; display:flex; align-items:center; justify-content:center; position:relative;">
    <div style="position:absolute; inset:0; background-image:radial-gradient(circle, rgba(0,227,253,0.07) 1px, transparent 1px); background-size:24px 24px;"></div>
    <div class="glass-dark dubai-stat-grid" style="position:relative; z-index:1; text-align:center; max-width:800px; margin:0 2rem; border-radius:20px; padding:2.25rem 2.5rem;">
      <div>
        <p style="color:#00e3fd; font-size:2.25rem; font-weight:800; line-height:1;">دبي</p>
        <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; margin-top:0.375rem;">مقرنا في الإمارات، نعمل مع عملاء حول العالم</p>
      </div>
      <div>
        <p style="color:#00e3fd; font-size:2.25rem; font-weight:800; line-height:1;">9</p>
        <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; margin-top:0.375rem;">خدمات تغطي الاستراتيجية والبناء وتمكين الفريق</p>
      </div>
      <div>
        <p style="color:#00e3fd; font-size:2.25rem; font-weight:800; line-height:1;">100%</p>
        <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; margin-top:0.375rem;">ضمان الرضا على كل مشروع نعمل عليه</p>
      </div>
    </div>
  </div>
</div>

<!-- MORE SERVICES GRID -->
<section class="section" style="background:#f0f3ff;">
  <div class="container">
    <div class="section-header">
      <h2>طرق أخرى نساعدك بها على التفوق بالذكاء الاصطناعي</h2>
      <p style="color:#42474e; font-size:1.0625rem; max-width:560px; margin:0 auto;">من الوكلاء المستقلين إلى فايب كودينج إلى عمليات الدمج العميقة، نُغطي كل طبقة من رحلتك مع الذكاء الاصطناعي.</p>
    </div>
    <div class="service-filter" data-service-filter role="tablist" aria-label="تصفية الخدمات حسب الفئة">
      <button type="button" class="filter-btn active" role="tab" aria-selected="true" data-filter="all">كل الخدمات</button>
      <button type="button" class="filter-btn" role="tab" aria-selected="false" data-filter="automation-agents">الأتمتة والوكلاء</button>
      <button type="button" class="filter-btn" role="tab" aria-selected="false" data-filter="build">البناء والإنشاء</button>
      <button type="button" class="filter-btn" role="tab" aria-selected="false" data-filter="integrate">الدمج والتحسين</button>
    </div>
    <div class="more-services-grid" data-service-grid>

      <!-- AI Automation -->
      <div class="service-card" data-cat="automation-agents">
        <div class="service-card-icon">
          <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:26px;">settings_suggest</span>
        </div>
        <div class="service-card-body">
          <h3>أتمتة الذكاء الاصطناعي</h3>
          <p>توقف عن فعلها يدوياً. نبني خطوط أتمتة ذكية تُلغي العمل المتكرر في المبيعات والعمليات والإدارة، دون تغيير أدواتك الحالية.</p>
          <ul class="service-card-list">
            <li>معالجة البريد الإلكتروني والمستندات</li>
            <li>سير عمل موافقات متعدد الخطوات</li>
            <li>مزامنة البيانات عبر أنظمتك</li>
            <li>توجيه العملاء المحتملين وأتمتة المتابعة</li>
          </ul>
        </div>
        <div class="service-card-footer">
          <a href="/ar/services/ai-automation" class="btn-primary" style="font-size:0.875rem;">اقرأ المزيد</a>
          <button onclick="openModal(this)" data-source="ar_services_automation" class="btn-outline-sky" style="font-size:0.875rem;">احصل على عرض سعر</button>
        </div>
      </div>

      <!-- AI Agents -->
      <div class="service-card" data-cat="automation-agents">
        <div class="service-card-icon">
          <span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:26px;">smart_toy</span>
        </div>
        <div class="service-card-body">
          <h3>وكلاء الذكاء الاصطناعي والأنظمة الوكيلة</h3>
