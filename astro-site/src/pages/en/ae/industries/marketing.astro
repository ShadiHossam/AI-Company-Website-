<script>
  document.querySelectorAll('[data-marketinghub-expand]').forEach((card) => {
    const btn = card.querySelector('.marketinghub-card-toggle');
    const panel = card.querySelector('.marketinghub-card-panel');
    btn?.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (panel) (panel as HTMLElement).hidden = expanded;
    });
  });
</script>
