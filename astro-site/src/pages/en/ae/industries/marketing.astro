---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../lib/supabase";
import FaqAccordion from "../../components/FaqAccordion.astro";
import StatStrip from "../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "Will AI-generated content replace our creative and marketing team?", answer: "No. AI handles the first draft and the repetitive production work, copy variations, image and video generation, scheduling, so your team spends more time on strategy, brand judgment, and the campaigns that need a human perspective. Everything customer-facing goes through your team's review before it publishes." },
  { question: "Can AI keep our brand voice consistent across channels?", answer: "Yes, if it's trained on your actual brand guidelines, past campaigns, and tone of voice, not a generic template. We build a brand voice profile into every content and creative system so output sounds like you, not like a default AI style." },
  { question: "Does this work for Arabic marketing content, not just English?", answer: "Yes. Content writing, social copy, voiceover, and video localization are all tested specifically for Arabic quality, not just translated from English. UAE audiences notice the difference between natural Arabic copy and a stilted translation." },
  { question: "Which of these should we start with if we're new to marketing AI?", answer: "Most teams get the fastest, most visible win from content writing or social media automation, since the output is immediate and easy to evaluate. SEO and analytics take longer to show results because they depend on data accumulating over weeks. We'll recommend a starting point based on where your team is losing the most time today." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'marketing')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI for Marketing Teams & Agencies in the UAE",
    "url": "https://lenooai.com/industries/marketing",
    "description": "Custom AI systems for UAE marketing teams and agencies: SEO, social media, image and video generation, voice generation, email marketing, content writing, analytics, influencer marketing, and paid ads.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Marketing"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://lenooai.com/industries" },
      { "@type": "ListItem", "position": 3, "name": "Marketing AI", "item": "https://lenooai.com/industries/marketing" }
    ]
  }
];
