---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getSupabaseAdmin } from "../../../lib/supabase";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import StatStrip from "../../../components/StatStrip.astro";

const fallbackFaqs = [
  { question: "Does AI-written content get flagged as plagiarism or low quality?", answer: "Generic, unedited AI output can read as thin, but that's a quality issue, not something unique to AI. We run every draft through plagiarism and originality checks, and a human editor reviews for accuracy and voice before anything publishes." },
  { question: "Can AI actually write in our specific brand voice?", answer: "Yes, when it's trained on your existing content, style guide, and examples of what good looks like for your brand. We build a voice profile from your material first, rather than starting from a generic AI writing style." },
  { question: "Is AI-generated Arabic copywriting as good as English?", answer: "It requires more careful handling. Arabic has more dialect and register variation than English, and generic AI tools sometimes produce overly formal or awkward phrasing. We test and tune Arabic content generation specifically, rather than treating it as a straight translation of the English process." },
  { question: "How much editorial review does AI content still need?", answer: "Every piece gets a human review pass for factual accuracy, brand voice, and quality before publishing, no exceptions. AI handles the first draft and structure; a person still owns what goes out under your name." },
];

let faqItems = fallbackFaqs;

try {
  const supabase = getSupabaseAdmin();
  const { data, error } = await supabase
    .from('faq_items')
    .select('question, answer, sort_order')
    .eq('section', 'marketing_content_writing')
    .eq('published', true)
    .order('sort_order');

  if (!error && data && data.length > 0) {
    faqItems = data;
  }
} catch (err) {
  // Fallback to hardcoded content on error
}

Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');

const ldJson = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Content Writing & Copywriting in the UAE",
    "url": "https://lenooai.com/industries/marketing/content-writing",
    "description": "Custom AI content writing systems for UAE businesses: blog drafting, ad copy, product descriptions, and website copy in your brand voice.",
    "provider": { "@type": "Organization", "name": "Lenoo AI", "url": "https://lenooai.com" },
    "areaServed": "United Arab Emirates",
    "serviceType": "AI Development for Content Writing"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lenooai.com/" },
      { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://lenooai.com/industries" },
      { "@type": "ListItem", "position": 3, "name": "Marketing", "item": "https://lenooai.com/industries/marketing" },
      { "@type": "ListItem", "position": 4, "name": "Content Writing AI", "item": "https://lenooai.com/industries/marketing/content-writing" }
    ]
  }
];
---

<BaseLayout
  title="AI Content Writing & Copywriting in the UAE: Blog, Ad Copy & Product Content | Lenoo AI"
  description="Lenoo AI, a Dubai AI agency, builds AI content writing systems for UAE businesses: blog drafting, ad copy, product descriptions, and website copy."
  canonicalPath="/industries/marketing/content-writing"
  ldJson={ldJson}
>

<header class="hero-section">
  <div class="container" style="text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,227,253,0.12);border:1px solid rgba(0,227,253,0.28);border-radius:100px;padding:6px 16px;color:#a8f2ff;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem;" aria-label="Breadcrumb"><a href="/" style="color:inherit;text-decoration:none;opacity:0.65;">Home</a><span style="opacity:0.4;padding:0 4px;"> / </span><a href="/industries/marketing" style="color:inherit;text-decoration:none;opacity:0.65;">Marketing</a><span style="opacity:0.4;padding:0 4px;"> / </span>Content Writing</div>
    <h1>AI Content Writing<br><span class="gradient-text">&amp; Copywriting for the UAE</span></h1>
    <p style="color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:640px; margin:1.5rem auto 2rem; line-height:1.8;">Lenoo AI builds AI content writing systems for UAE businesses: blog posts, ad copy, product descriptions, and website copy, drafted in your brand voice and reviewed by a human before it publishes.</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:2.5rem;">
      <button onclick="openModal(this)" data-source="marketing_content_hero" class="btn-primary">Book Free Content AI Audit</button>
      <a href="#what-we-build" class="btn-outline">See What We Build ↓</a>
    </div>
    <StatStrip stats={[
      { value: "3–5x", caption: "faster first-draft production with AI-assisted writing" },
      { value: "62%", caption: "of marketers have integrated AI into their content strategy (Content Marketing Institute)" },
      { value: "Arabic + English", caption: "content generation tuned for both languages, not a direct translation" },
    ]} />
  </div>
</header>

<div style="position:relative; overflow:hidden; height:260px; margin:0 0 -1px;">
  <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=1600&h=260&q=80&auto=format&fit=crop" alt="Writer's desk with a laptop, coffee, and a notepad" loading="lazy" width="1600" height="260" style="width:100%; height:100%; object-fit:cover; object-position:center 40%;" />
  <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,19,32,0.45) 0%,transparent 55%),linear-gradient(135deg,rgba(0,104,117,0.20),rgba(0,37,59,0.45));"></div>
</div>

<!-- WHY CONTENT WRITING & AI FIT -->
<section class="section" aria-labelledby="shift-heading">
  <div class="container">
    <div class="split-grid">
      <div>
        <h2 id="shift-heading" style="margin-bottom:1.5rem;">Why content writing is one of AI's highest-impact marketing tools</h2>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>Every channel needs a constant stream of copy.</strong> Blog posts, ads, product pages, and website copy all compete for a marketing team's limited writing hours. AI drafting tools handle the first pass, letting your team edit rather than start from a blank page.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85; margin-bottom:1.25rem;"><strong>Product catalogs outgrow manual writing capacity.</strong> E-commerce businesses with hundreds or thousands of SKUs can't write unique descriptions for each one manually. AI generates consistent, on-brand descriptions at that scale.</p>
        <p style="color:#42474e; font-size:1.0625rem; line-height:1.85;"><strong>Brand voice consistency is hard across a growing team.</strong> As more people write for a brand, voice drifts. AI trained on your style guide keeps output consistent regardless of who's requesting it.</p>
      </div>
      <div class="split-media" style="display:flex; align-items:stretch;">
        <div class="card" style="display:flex; flex-direction:column; justify-content:center; text-align:center; width:100%; padding:2.5rem;">
          <p class="stat-number" style="font-size:3rem; margin-bottom:0.75rem;">3&ndash;5x</p>
          <p style="color:#42474e; font-size:1rem; line-height:1.7;">faster first-draft production with AI-assisted writing, giving your team more time for editing and strategy instead of a blank page.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WHAT LENOO BUILDS -->
<section id="what-we-build" class="section" style="background:#e7eeff;" aria-labelledby="build-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="build-heading">AI Content Systems Built for UAE Businesses</h2>
      <p>Six systems our Dubai AI agency builds for content production, with brand voice training and human review built in.</p>
    </div>
    <div class="apps-grid">
      <div class="card">
        <div class="icon-box"><span class="material-symbols-outlined" aria-hidden="true" style="color:#006875; font-size:24px;">article</span></div>
        <h3 style="font-weight:700; font-size:1.0625rem; color:#00253b; margin-bottom:0.5rem;">Blog &amp; Article Drafting Assistant</h3>
