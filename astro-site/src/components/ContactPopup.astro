---
// Booking / WhatsApp prompt, centered on screen. Ported from New Golden
// Office's ContactPopup. It opens after 15 seconds of *visible* time on the
// page or once the visitor scrolls to 80% of it, whichever comes first. After
// it has shown, it comes back on the 3rd page after that (same 15s / 80%
// trigger) or after 2 more minutes on the site, whichever comes first. A
// visitor who opens WhatsApp or the booking form, clicks email or phone, or
// sends a form doesn't see it again for 24 hours.
// Copy comes from lib/popupCopy.ts, in the page's language (en / ar).
//
// Tracking: "Book" is a button carrying data-source="popup" that opens the
// sitewide booking modal (openModal() in scripts/site.ts records that source
// with the lead), and WhatsApp is a plain wa.me link with the same attribute,
// so the sitewide click trackers record both like any other button. The card
// itself only announces show/dismiss, via gtag and an `ln:popup` DOM event
// that ln-track.js records.
import { COMPANY } from '../config/company';
import { POPUP_UI, type PopupCopy, type PopupLang } from '../lib/popupCopy';

interface Props {
  copy: PopupCopy;
  lang: PopupLang;
  delaySeconds?: number;
  scrollPercent?: number;
  /** After a show: pages until it may show again. */
  repeatPages?: number;
  /** After a show: visible seconds on the site until it shows again. */
  repeatSeconds?: number;
}

const { copy, lang, delaySeconds = 15, scrollPercent = 80, repeatPages = 3, repeatSeconds = 120 } = Astro.props;
const ui = POPUP_UI[lang];
const waHref = `https://wa.me/${COMPANY.whatsapp}?text=${encodeURIComponent(copy.waMessage)}`;
---

<div
  id="lnPopup"
  class="ln-popup"
  dir={lang === 'ar' ? 'rtl' : 'ltr'}
  data-nosnippet
  data-section={copy.section}
  data-primary={copy.primary}
  data-delay={delaySeconds}
  data-scroll={scrollPercent}
  data-repeat-pages={repeatPages}
  data-repeat-seconds={repeatSeconds}
  hidden
>
  <div class="ln-popup-backdrop" data-dismiss="backdrop"></div>
  <div
    class="ln-popup-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lnPopupTitle"
    aria-describedby="lnPopupSub"
    tabindex="-1"
  >
    <button type="button" class="ln-popup-x" data-dismiss="x" aria-label={ui.close}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>

    <p class="ln-popup-status" data-open-only><span class="ln-popup-dot" aria-hidden="true"></span> {ui.status}</p>
    <p class="ln-popup-title" id="lnPopupTitle">{copy.headline}</p>
    <p class="ln-popup-sub" id="lnPopupSub">{copy.sub}</p>

    <div class="ln-popup-actions">
      <button type="button" class="ln-popup-btn ln-popup-book" data-source="popup">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3.75 8.25h16.5M5.25 6h13.5a1.5 1.5 0 0 1 1.5 1.5v11.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V7.5a1.5 1.5 0 0 1 1.5-1.5Z" /></svg>
        {ui.book}
      </button>
      <a class="ln-popup-btn ln-popup-wa" href={waHref} target="_blank" rel="noopener" data-source="popup">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.4 5.83c0 4.55-3.7 8.25-8.25 8.25a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.25-8.24zm-4.52 4.71c-.16 0-.42.06-.64.31-.22.25-.85.83-.85 2.02s.87 2.35.99 2.51c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28-.25-.13-1.44-.71-1.66-.79-.22-.08-.38-.13-.55.13-.16.25-.63.79-.77.95-.14.16-.28.18-.53.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.28.38-.42.13-.14.17-.25.25-.41.08-.16.04-.31-.02-.44-.06-.13-.55-1.33-.76-1.82-.2-.48-.4-.42-.55-.42h-.47z" /></svg>
        {ui.wa}
      </a>
    </div>
    <p class="ln-popup-hours" data-closed-only>{ui.closed}</p>

    <p class="ln-popup-trust">{ui.trust}</p>
    <button type="button" class="ln-popup-later" data-dismiss="later">{ui.later}</button>
  </div>
</div>

<style>
  .ln-popup {
    position: fixed;
    inset: 0;
    z-index: 1001; /* above the navbar, the booking modal (100) and the floats (999) */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .ln-popup[hidden] { display: none; }

  .ln-popup-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 37, 59, 0.55);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .ln-popup-card {
    position: relative;
    width: min(420px, 100%);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    padding: 24px 24px 16px;
    font-family: var(--ui);
    color: var(--ink);
    text-align: start;
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .ln-popup-card:focus { outline: none; }
  .ln-popup.is-in .ln-popup-backdrop { opacity: 1; }
  .ln-popup.is-in .ln-popup-card { opacity: 1; transform: none; }

  .ln-popup-x {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--muted);
    cursor: pointer;
  }
  .ln-popup-x svg { width: 16px; height: 16px; }
  .ln-popup-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--green);
  }
  .ln-popup-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.25);
  }
  .ln-popup-title {
    margin: 0 0 10px;
    padding-inline-end: 36px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.22rem;
    line-height: 1.4;
    color: var(--navy);
  }
  .ln-popup-sub {
    margin: 0 0 18px;
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .ln-popup-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ln-popup-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 50px;
    padding: 10px 16px;
    border-radius: 999px;
    font: inherit;
    font-family: var(--ui);
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    text-align: center;
    width: 100%;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .ln-popup-btn svg { width: 20px; height: 20px; flex-shrink: 0; }
  .ln-popup-btn:focus-visible,
  .ln-popup-x:focus-visible,
  .ln-popup-later:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  /* Primary = filled, secondary = outline. data-primary is set per page. */
  .ln-popup .ln-popup-btn { background: transparent; color: var(--teal); border: 2px solid var(--teal); cursor: pointer; }
  .ln-popup[data-primary='book'] .ln-popup-book,
  .ln-popup[data-primary='wa'] .ln-popup-wa {
    color: #fff;
    border-color: transparent;
    min-height: 56px;
    font-size: 1.04rem;
  }
  .ln-popup[data-primary='book'] .ln-popup-book { background: var(--grad-cta); box-shadow: 0 8px 20px -6px rgba(0, 138, 154, 0.5); }
  .ln-popup[data-primary='book'] .ln-popup-book:hover { filter: brightness(1.06); }
  .ln-popup[data-primary='wa'] .ln-popup-wa { background: #25d366; box-shadow: 0 4px 18px rgba(37, 211, 102, 0.35); }
  .ln-popup[data-primary='wa'] .ln-popup-wa:hover { background: #1ebe5a; }
  .ln-popup[data-primary='wa'] .ln-popup-actions { flex-direction: column-reverse; }

  .ln-popup-hours {
    margin: 10px 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    text-align: center;
  }
  .ln-popup-trust {
    margin: 14px 0 4px;
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
  }
  .ln-popup-later {
    display: block;
    margin: 0 auto;
    padding: 6px 12px;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.86rem;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
  }

  .ln-popup:not(.is-closed) [data-closed-only],
  .ln-popup.is-closed [data-open-only] { display: none; }

  /* Floats would peek out from under the backdrop; hide them while it's open. */
  :global(body.ln-popup-open #whatsapp-float),
  :global(body.ln-popup-open #form-float) { display: none; }

  @media (max-width: 600px) {
    .ln-popup-card { padding: 22px 18px 14px; }
    .ln-popup-title { font-size: 1.1rem; }
    .ln-popup-hours {
    margin: 10px 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    text-align: center;
  }
  .ln-popup-trust { font-size: 0.72rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ln-popup-backdrop, .ln-popup-card { transition: none; }
    .ln-popup-card { transform: none; }
  }
</style>

<script>
  (function () {
    const root = document.getElementById('lnPopup');
    if (!root) return;
    const card = root.querySelector('.ln-popup-card') as HTMLElement;

    const delayMs = Math.max(3, Number(root.dataset.delay) || 15) * 1000;
    const scrollTarget = Math.min(100, Math.max(10, Number(root.dataset.scroll) || 80));
    const repeatPages = Math.max(1, Number(root.dataset.repeatPages) || 3);
    const repeatMs = Math.max(30, Number(root.dataset.repeatSeconds) || 120) * 1000;
    const CONVERTED_PAUSE = 24 * 60 * 60 * 1000;
    const section = root.dataset.section || 'default';

    // Cross-page state, one small JSON blob:
    //   vt     visible ms spent on the site, summed across pages
    //   shown  true once the popup has shown at least once
    //   sv     vt at the moment it last showed
    //   pg     pages loaded since it last showed
    //   conv   timestamp of the last contact click or form submit
    // localStorage first; if that's blocked, a cookie; last resort memory.
    type St = { vt: number; shown: boolean; sv: number; pg: number; conv: number };
    const KEY = 'ln_pp';
    let mem: St | null = null;
    function load(): St {
      let raw: string | null = null;
      try { raw = localStorage.getItem(KEY); } catch { /* blocked */ }
      if (!raw) { try { const m = document.cookie.match(/(?:^|; )ln_pp=([^;]*)/); raw = m ? decodeURIComponent(m[1]) : null; } catch { /* blocked */ } }
      try { if (raw) { const v = JSON.parse(raw); if (v && typeof v.vt === 'number') return v; } } catch { /* corrupt */ }
      return mem ?? { vt: 0, shown: false, sv: 0, pg: 0, conv: 0 };
    }
    function save(v: St) {
      mem = v;
      const raw = JSON.stringify(v);
      try { localStorage.setItem(KEY, raw); return; } catch { /* blocked */ }
      try {
        document.cookie = KEY + '=' + encodeURIComponent(raw) + '; Max-Age=31536000; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
      } catch { /* blocked */ }
    }

    const st = load();
    if (st.shown) { st.pg += 1; save(st); }

    const paused = () => Date.now() - (load().conv || 0) < CONVERTED_PAUSE;

    function emit(action: string, extra: Record<string, string> = {}) {
      const detail = { action, section, ...extra };
      try { document.dispatchEvent(new CustomEvent('ln:popup', { detail })); } catch { /* old browser */ }
      const g = (window as any).gtag;
      if (typeof g === 'function') g('event', 'contact_popup_' + action, { page_path: location.pathname, popup_section: section, ...extra });
    }

    // Working hours: Sun-Thu 09:00-18:00 Dubai time (COMPANY.hours). Use Intl
    // with Asia/Dubai, not the device clock, so visitors abroad come out
    // right. If Intl can't do it, assume open.
    function isOpenNow() {
      try {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Dubai', weekday: 'short', hour: 'numeric', hourCycle: 'h23' }).formatToParts(new Date());
        const wd = parts.find(p => p.type === 'weekday')?.value;
        const h = Number(parts.find(p => p.type === 'hour')?.value);
        return wd !== 'Fri' && wd !== 'Sat' && h >= 9 && h < 18;
      } catch { return true; }
    }

    // ── Someone who just reached out gets a 24h break
    function markConverted() {
      const v = load(); v.conv = Date.now(); save(v);
      if (!root!.hidden) hide('converted');
    }
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href*="wa.me"], a[href^="tel:"], a[href^="mailto:"], a[href*="calendly.com"]');
      if (a) markConverted();
    }, true);
    document.addEventListener('submit', markConverted, true);
    document.addEventListener('ln:lead', markConverted);

    // ── Visible time, on this page and summed across the site
    let pageMs = 0;
    let lastTick = Date.now();
    let unsaved = 0;
    function accrue() {
      const now = Date.now();
      // Cap the step so a sleeping laptop or throttled tab can't jump the clock.
      const d = Math.min(now - lastTick, 2000);
      lastTick = now;
      if (document.hidden) return;
      pageMs += d;
      unsaved += d;
      if (unsaved >= 2000) flush();
    }
    function flush() {
      if (!unsaved) return;
      const v = load(); v.vt += unsaved; unsaved = 0; save(v);
    }
    document.addEventListener('visibilitychange', () => { accrue(); if (document.hidden) flush(); });
    window.addEventListener('pagehide', () => { accrue(); flush(); });

    // ── Scroll trigger: 80% of the page, after a real scroll (a page short
    // enough to be 80% visible on load doesn't pop instantly).
    let reachedScroll = false;
    window.addEventListener('scroll', () => {
      if (reachedScroll || window.scrollY <= 0) return;
      const h = document.documentElement.scrollHeight;
      if (h > 0 && ((window.scrollY + window.innerHeight) / h) * 100 >= scrollTarget) reachedScroll = true;
    }, { passive: true });

    // Why it's due now, or '' if it isn't.
    function dueReason(): string {
      const v = load();
      const onPage = pageMs >= delayMs || reachedScroll;
      if (!v.shown) return onPage ? (reachedScroll && pageMs < delayMs ? 'scroll' : 'time') : '';
      if (v.vt + unsaved - v.sv >= repeatMs) return 'repeat_time';
      if (v.pg >= repeatPages && onPage) return 'repeat_pages';
      return '';
    }

    const isTyping = () => {
      const el = document.activeElement as HTMLElement | null;
      return !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable);
    };
    // Booking modal or mobile menu open, or a Calendly widget on screen.
    const busy = () => !!document.querySelector('#modal.open, #mobile-menu.open, .calendly-overlay, .calendly-popup');
    // Cookie banner (public/cookie-consent.js): let the visitor answer it
    // first, but don't wait forever for someone ignoring it (15s more at most).
    let dueSince = 0;
    const bannerUp = () => !!document.getElementById('cookie-consent') && Date.now() - dueSince < 15000;

    let typingSince = 0;
    window.setInterval(() => {
      accrue();
      if (!root.hidden || paused()) { dueSince = 0; return; }
      const reason = dueReason();
      if (!reason) { dueSince = 0; return; }
      if (!dueSince) dueSince = Date.now();
      // Typing in a form: wait until they've left the field for 3s.
      if (isTyping()) { typingSince = Date.now(); return; }
      if (typingSince && Date.now() - typingSince < 3000) return;
      if (busy() || bannerUp() || document.hidden) return;
      show(reason);
    }, 400);

    let lastFocus: HTMLElement | null = null;

    function show(trigger: string) {
      flush();
      const v = load(); v.shown = true; v.sv = v.vt; v.pg = 0; save(v);
      // A second trigger on this same page needs the 2-minute rule, not the
      // 15s/80% one, so reset the in-page triggers.
      pageMs = 0; reachedScroll = false; dueSince = 0;

      const open = isOpenNow();
      const desktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      root!.classList.toggle('is-closed', !open);
      lastFocus = document.activeElement as HTMLElement | null;
      root!.hidden = false;
      document.body.classList.add('ln-popup-open');
      requestAnimationFrame(() => requestAnimationFrame(() => root!.classList.add('is-in')));
      try { card.focus({ preventScroll: true }); } catch { /* old browser */ }
      emit('shown', { hours: open ? 'open' : 'closed', device: desktop ? 'desktop' : 'mobile', trigger });
    }

    function hide(how: string) {
      root!.classList.remove('is-in');
      root!.hidden = true;
      document.body.classList.remove('ln-popup-open');
      try { lastFocus?.focus?.({ preventScroll: true }); } catch { /* gone */ }
      if (how !== 'converted') emit('dismissed', { how });
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('[data-dismiss]') as HTMLElement | null;
      if (btn) hide(btn.dataset.dismiss || 'x');
    });
    // "Book" opens the sitewide booking modal; that counts as reaching out.
    const book = root.querySelector('.ln-popup-book') as HTMLElement | null;
    book?.addEventListener('click', () => {
      markConverted();
      (window as unknown as { openModal?: (el: HTMLElement) => void }).openModal?.(book);
    });
    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') { hide('esc'); return; }
      // Keep Tab inside the dialog while it's open.
      if (e.key === 'Tab') {
        const f = Array.from(card.querySelectorAll<HTMLElement>('a[href], button'));
        if (!f.length) return;
        const first = f[0], lastEl = f[f.length - 1];
        if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) { e.preventDefault(); lastEl.focus(); }
        else if (!e.shiftKey && document.activeElement === lastEl) { e.preventDefault(); first.focus(); }
      }
    });

    // Back/forward cache: a restored page may still show the card from
    // before the visitor left (usually to WhatsApp).
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) { lastTick = Date.now(); if (!root.hidden) hide('converted'); }
    });
  })();
</script>
