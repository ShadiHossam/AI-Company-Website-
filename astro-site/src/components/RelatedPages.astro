---
import { getRelatedLinks, isPageLive } from '../lib/internalLinks';
import { INDUSTRY_SERVICE_RELATIONS } from '../data/pageRelations';

interface Props {
  path: string;
}

const { path } = Astro.props;
const result = getRelatedLinks(path, INDUSTRY_SERVICE_RELATIONS);
// Pending pages would render as greyed-out dead pills, so leave them out here.
const links = result ? result.links.filter((link) => isPageLive(link.path)) : [];
---
{result && links.length > 0 && (
  <section class="section related-pages" aria-labelledby="related-pages-heading">
    <div class="container">
      <h2 id="related-pages-heading" style="font-size:1.375rem; margin-bottom:1.25rem;">{result.heading}</h2>
      <div class="related-pages-list">
        {links.map((link) => (
          <a href={link.path} class="related-pages-link">{link.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .related-pages { padding: 3rem 0; border-top: 1px solid var(--border); }
  .related-pages-list { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .related-pages-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: rgba(0,104,117,0.05);
    border: 1px solid rgba(0,104,117,0.15);
    border-radius: 999px;
    color: #00253b;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .related-pages-link:hover { background: rgba(0,104,117,0.12); border-color: #006875; color: #006875; }
</style>
