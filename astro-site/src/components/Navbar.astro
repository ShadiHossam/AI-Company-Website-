---
import { COMPANY } from '../config/company';
import SafeLink from './SafeLink.astro';

interface Props {
  arPath?: string;
}
const { arPath } = Astro.props;
---

<nav id="navbar" role="navigation" aria-label="Main navigation">
  <div class="container flex items-center justify-between h-18 py-3">
    <a href="/en/ae" class="flex items-center cursor-pointer" aria-label="Home">
      <img src="/assets/brand/logo-white.png" alt={COMPANY.name} class="navbar-logo" width="1000" height="175" />
    </a>
    <div class="hidden md:flex items-center gap-7">
      <div class="nav-dropdown">
        <button class="nav-dropdown-btn" id="services-btn" onclick="toggleServicesDropdown()" aria-expanded="false" aria-haspopup="true">
          Services
          <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav-dropdown-menu services-mega" id="services-menu" role="menu">
          <div class="services-col">
            <p class="services-col-label">Build &amp; Automate</p>
            <a href="/en/ae/services/custom-ai-development" class="nav-dropdown-item" role="menuitem">Custom AI Development</a>
            <a href="/en/ae/services/ai-automation"         class="nav-dropdown-item" role="menuitem">AI Automation</a>
            <a href="/en/ae/services/ai-agents"             class="nav-dropdown-item" role="menuitem">AI Agents</a>
            <a href="/en/ae/services/vibe-coding"           class="nav-dropdown-item" role="menuitem">Vibe Coding</a>
          </div>
          <div class="services-divider"></div>
          <div class="services-col">
            <p class="services-col-label">Systems &amp; Advise</p>
            <a href="/en/ae/services/internal-ai-tools"     class="nav-dropdown-item" role="menuitem">Internal AI Tools</a>
            <a href="/en/ae/services/ai-integration"        class="nav-dropdown-item" role="menuitem">AI Integration</a>
            <a href="/en/ae/services/ai-strategy"           class="nav-dropdown-item" role="menuitem">AI Strategy Consulting</a>
            <a href="/en/ae/services/ai-training"           class="nav-dropdown-item" role="menuitem">AI Training &amp; Workshops</a>
          </div>
          <div style="height:1px;background:#E2E8F0;margin:.4rem .9rem;grid-column:1/-1;"></div>
          <a href="/en/ae/services" class="nav-dropdown-item" role="menuitem" style="color:#006875;grid-column:1/-1;">View All Services →</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-btn" id="industries-btn" onclick="toggleIndustriesDropdown()" aria-expanded="false" aria-haspopup="true">
          Industries
          <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="nav-dropdown-menu services-mega" id="industries-menu" role="menu">
          <div class="services-col">
            <a href="/en/ae/industries/real-estate"     class="nav-dropdown-item" role="menuitem">Real Estate</a>
            <a href="/en/ae/industries/retail"          class="nav-dropdown-item" role="menuitem">Retail &amp; E-commerce</a>
            <a href="/en/ae/industries/hospitality"     class="nav-dropdown-item" role="menuitem">Hospitality</a>
            <a href="/en/ae/industries/logistics"       class="nav-dropdown-item" role="menuitem">Logistics</a>
            <a href="/en/ae/industries/healthcare"      class="nav-dropdown-item" role="menuitem">Healthcare</a>
            <a href="/en/ae/industries/finance-banking" class="nav-dropdown-item" role="menuitem">Finance &amp; Banking</a>
          </div>
          <div class="services-divider"></div>
          <div class="services-col">
            <a href="/en/ae/industries/manufacturing"   class="nav-dropdown-item" role="menuitem">Manufacturing</a>
            <a href="/en/ae/industries/legal"           class="nav-dropdown-item" role="menuitem">Legal</a>
            <a href="/en/ae/industries/education"       class="nav-dropdown-item" role="menuitem">Education</a>
            <a href="/en/ae/industries/insurance"       class="nav-dropdown-item" role="menuitem">Insurance</a>
            <a href="/en/ae/industries/consulting"      class="nav-dropdown-item" role="menuitem">Professional Services</a>
            <a href="/en/ae/industries/hr-recruitment"  class="nav-dropdown-item" role="menuitem">HR &amp; Recruitment</a>
          </div>
          <div class="services-divider"></div>
          <div class="services-col">
            <a href="/en/ae/industries/marketing" class="nav-dropdown-item" role="menuitem" style="font-weight:700;">Marketing</a>
            <a href="/en/ae/industries/marketing/seo"                    class="nav-dropdown-item" role="menuitem" style="padding-left:1.4rem; font-size:0.8125rem;">SEO</a>
            <a href="/en/ae/industries/marketing/social-media"           class="nav-dropdown-item" role="menuitem" style="padding-left:1.4rem; font-size:0.8125rem;">Social Media</a>
            <a href="/en/ae/industries/marketing/image-generation"       class="nav-dropdown-item" role="menuitem" style="padding-left:1.4rem; font-size:0.8125rem;">Image Generation</a>
            <a href="/en/ae/industries/marketing/video-generation"       class="nav-dropdown-item" role="menuitem" style="padding-left:1.4rem; font-size:0.8125rem;">Video Generation</a>
            <a href="/en/ae/industries/marketing" class="nav-dropdown-item" role="menuitem" style="padding-left:1.4rem; font-size:0.8125rem; color:#006875;">More marketing AI →</a>
          </div>
          <div style="height:1px;background:#E2E8F0;margin:.4rem .9rem;grid-column:1/-1;"></div>
          <SafeLink href="/en/ae/industries" class="nav-dropdown-item" role="menuitem" style="color:#006875;grid-column:1/-1;">View All Industries →</SafeLink>
        </div>
      </div>
      <a href="/en/ae/about"      class="nav-link text-sm">About</a>
      <a href="/en/ae/blog"       class="nav-link text-sm">Blog</a>
      <a href="/en/ae/careers"    class="nav-link text-sm">Careers</a>
    </div>
    <div class="hidden md:flex items-center gap-3">
      {arPath && (
        <a href={arPath} class="lang-switch" lang="ar" hreflang="ar-ae" aria-label="عرض الموقع بالعربية">ع</a>
      )}
      <button onclick="openModal(this)" data-source="navbar" class="btn-primary text-sm py-2.5 px-5">Book Free Consultation</button>
    </div>
    <button id="hamburger" onclick="toggleMenu()" class="md:hidden p-2 rounded-lg cursor-pointer" style="background:rgba(255,255,255,0.12);" aria-label="Open menu" aria-expanded="false">
      <svg id="ham-icon" viewBox="0 0 24 24" fill="none" class="w-6 h-6" stroke="#fff" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="close-icon" viewBox="0 0 24 24" fill="none" class="w-6 h-6 hidden" stroke="#fff" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="md:hidden" style="border-top:1px solid rgba(0,37,59,0.10);background:#f9f9ff;">
    <div class="container py-4 flex flex-col gap-4">
      <div>
        <button type="button" class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-services-sub" onclick="toggleMobileSection(this)">
          Services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="mobile-nav-sub" id="mobile-services-sub">
          <a href="/en/ae/services/custom-ai-development" onclick="toggleMenu()">Custom AI Development</a>
          <a href="/en/ae/services/ai-automation"         onclick="toggleMenu()">AI Automation</a>
          <a href="/en/ae/services/ai-agents"             onclick="toggleMenu()">AI Agents</a>
          <a href="/en/ae/services/vibe-coding"           onclick="toggleMenu()">Vibe Coding</a>
          <a href="/en/ae/services/internal-ai-tools"     onclick="toggleMenu()">Internal AI Tools</a>
          <a href="/en/ae/services/ai-integration"        onclick="toggleMenu()">AI Integration</a>
          <a href="/en/ae/services/ai-strategy"           onclick="toggleMenu()">AI Strategy Consulting</a>
          <a href="/en/ae/services/ai-training"           onclick="toggleMenu()">AI Training &amp; Workshops</a>
        </div>
      </div>
      <div>
        <button type="button" class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-industries-sub" onclick="toggleMobileSection(this)">
          Industries
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="mobile-nav-sub" id="mobile-industries-sub">
          <a href="/en/ae/industries/real-estate"     onclick="toggleMenu()">Real Estate</a>
          <a href="/en/ae/industries/retail"          onclick="toggleMenu()">Retail &amp; E-commerce</a>
          <a href="/en/ae/industries/hospitality"     onclick="toggleMenu()">Hospitality</a>
          <a href="/en/ae/industries/logistics"       onclick="toggleMenu()">Logistics</a>
          <a href="/en/ae/industries/healthcare"      onclick="toggleMenu()">Healthcare</a>
          <a href="/en/ae/industries/finance-banking" onclick="toggleMenu()">Finance &amp; Banking</a>
          <a href="/en/ae/industries/manufacturing"   onclick="toggleMenu()">Manufacturing</a>
          <a href="/en/ae/industries/legal"           onclick="toggleMenu()">Legal</a>
          <a href="/en/ae/industries/education"       onclick="toggleMenu()">Education</a>
          <a href="/en/ae/industries/insurance"       onclick="toggleMenu()">Insurance</a>
          <a href="/en/ae/industries/consulting"      onclick="toggleMenu()">Professional Services</a>
          <a href="/en/ae/industries/hr-recruitment"  onclick="toggleMenu()">HR &amp; Recruitment</a>
          <a href="/en/ae/industries/marketing"       onclick="toggleMenu()" style="font-weight:700;">Marketing</a>
          <a href="/en/ae/industries/marketing/seo"                    onclick="toggleMenu()" style="padding-inline-start:1rem;">SEO</a>
          <a href="/en/ae/industries/marketing/social-media"           onclick="toggleMenu()" style="padding-inline-start:1rem;">Social Media</a>
          <a href="/en/ae/industries/marketing/image-generation"       onclick="toggleMenu()" style="padding-inline-start:1rem;">Image Generation</a>
          <a href="/en/ae/industries/marketing/video-generation"       onclick="toggleMenu()" style="padding-inline-start:1rem;">Video Generation</a>
          <a href="/en/ae/industries/marketing/voice-generation"       onclick="toggleMenu()" style="padding-inline-start:1rem;">Voice Generation</a>
          <a href="/en/ae/industries/marketing/email-marketing"        onclick="toggleMenu()" style="padding-inline-start:1rem;">Email Marketing</a>
          <a href="/en/ae/industries/marketing/content-writing"        onclick="toggleMenu()" style="padding-inline-start:1rem;">Content Writing</a>
          <a href="/en/ae/industries/marketing/analytics-attribution"  onclick="toggleMenu()" style="padding-inline-start:1rem;">Analytics &amp; Attribution</a>
          <a href="/en/ae/industries/marketing/influencer-marketing"   onclick="toggleMenu()" style="padding-inline-start:1rem;">Influencer Marketing</a>
          <a href="/en/ae/industries/marketing/paid-ads"               onclick="toggleMenu()" style="padding-inline-start:1rem;">Paid Ad Optimization</a>
          <SafeLink href="/en/ae/industries" onclick="toggleMenu()" style="color:#006875; font-weight:700;">View All Industries →</SafeLink>
        </div>
      </div>
      <a href="/en/ae/about"    onclick="toggleMenu()" class="mobile-nav-link">About</a>
      <a href="/en/ae/blog"     onclick="toggleMenu()" class="mobile-nav-link">Blog</a>
      <a href="/en/ae/careers"  onclick="toggleMenu()" class="mobile-nav-link">Careers</a>
      {arPath && (
        <a href={arPath} onclick="toggleMenu()" class="mobile-nav-link" lang="ar" style="color:#5a616b;">النسخة العربية</a>
      )}
      <div class="flex gap-3 pt-2">
        <button onclick="openModal(this)" data-source="navbar_mobile" class="flex-1 btn-primary justify-center text-sm py-2.5">Book Free Consultation</button>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-link { position: relative; color: rgba(255,255,255,0.88); font-weight: 600; transition: color .2s, background .2s; text-decoration: none; font-size: .875rem; padding: .5rem .7rem; border-radius: 99px; }
  .nav-link:hover { color: #00e3fd; background: rgba(255,255,255,0.08); }
  .nav-link:focus-visible, .nav-dropdown-btn:focus-visible {
    outline: 2px solid #00e3fd; outline-offset: 2px; border-radius: 4px;
  }
  .mobile-nav-link { color: #00253b; font-weight: 600; text-decoration: none; font-size: 1rem; display: block; }
  .mobile-nav-link:hover { color: #006875; }
  .mobile-nav-toggle {
    display: flex; align-items: center; justify-content: space-between; width: 100%;
    background: none; border: none; padding: 0; cursor: pointer;
    color: #00253b; font-weight: 600; font-size: 1rem; font-family: inherit; text-align: start;
  }
  .mobile-nav-toggle svg { width: 18px; height: 18px; flex-shrink: 0; color: #72787e; transition: transform .2s var(--ease); }
  .mobile-nav-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .mobile-nav-toggle:focus-visible {
    outline: 2px solid #006875; outline-offset: 4px; border-radius: 4px;
  }
  .nav-dropdown { position: relative; }
  .nav-dropdown-btn { display:flex; align-items:center; gap:.3rem; color:rgba(255,255,255,0.88); font-weight:600; font-size:.875rem; background:none; border:none; cursor:pointer; padding:.5rem .7rem; border-radius:99px; transition:color .2s, background .2s; }
  .nav-dropdown-btn:hover { color:#00e3fd; background: rgba(255,255,255,0.08); }
  .nav-dropdown-btn svg { transition: transform .2s var(--ease); }
  .nav-dropdown-btn.open svg { transform: rotate(180deg); }
  .nav-dropdown-menu {
    display:none; position:absolute; top:calc(100% + 14px); left:50%; transform:translateX(-50%) translateY(-6px); min-width:220px;
    background:#ffffff;
    border:1px solid var(--border); border-radius:16px; padding:.5rem;
    box-shadow: var(--shadow-card-hover);
    z-index:100;
    opacity: 0; transition: opacity .2s var(--ease), transform .2s var(--ease);
  }
  .nav-dropdown-menu.open { display:block; opacity: 1; transform: translateX(-50%) translateY(0); }
  .nav-dropdown-item { display:block; padding:.6rem .9rem; color:#42474e; font-size:.875rem; font-weight:500; text-decoration:none; border-radius:10px; transition:background .15s, color .15s; }
  .nav-dropdown-item:hover { background:rgba(0,104,117,0.08); color:#00253b; }
  .mobile-nav-sub { padding-inline-start:1rem; display:none; flex-direction:column; gap:.6rem; margin-top:.6rem; }
  .mobile-nav-sub.open { display:flex; }
  .mobile-nav-sub a { color:#72787e; font-size:.9rem; font-weight:500; text-decoration:none; }
  .mobile-nav-sub a:hover { color:#006875; }
  .services-mega { min-width:480px; grid-template-columns:1fr 1px 1fr; gap:0; padding:.75rem .75rem .5rem; }
  .services-mega.open { display:grid; }
  #industries-menu.services-mega { min-width:680px; grid-template-columns:1fr 1px 1fr 1px 1fr; }
  .services-col { display:flex; flex-direction:column; gap:.1rem; padding:0 .25rem; }
  .services-col-label { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#72787e; padding:.4rem .9rem .5rem; }
  .services-divider { background:#E2E8F0; width:1px; margin:.25rem 0; }
  @media(max-width:860px) { .services-mega, #industries-menu.services-mega { min-width:260px; grid-template-columns:1fr; } .services-divider { display:none; } }

  .navbar-logo { height: 30px; width: auto; display: block; transition: transform .3s var(--ease); }
  #navbar a[aria-label="Home"]:hover .navbar-logo { transform: scale(1.05); }
</style>
