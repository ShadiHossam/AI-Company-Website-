---
/**
 * Index of a post section (e.g. /abu-dhabi, /ar/abu-dhabi). The page loads the
 * cards with loadSectionCards() and 404s when there are none, then hands them
 * here to render.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ArBaseLayout from '../layouts/ArBaseLayout.astro';
import PageHero from './PageHero.astro';
import { SECTION_META, type PostSection } from '../lib/postPaths';
import type { SectionCard } from '../lib/sectionHub';

interface Props {
  section: PostSection;
  lang: 'en' | 'ar';
  title: string;
  description: string;
  heading: string;
  intro: string;
  heroImage: { src: string; alt: string; position?: string };
  cards: SectionCard[];
  /** Whether the other language's hub has posts; hreflang only points at a live twin. */
  hasTwin: boolean;
}

const { section, lang, title, description, heading, intro, heroImage, cards, hasTwin } = Astro.props;
const ar = lang === 'ar';

const selfPath = ar ? `/ar/${section}` : `/${section}`;
const home = ar ? { name: 'الرئيسية', path: '/ar' } : { name: 'Home', path: '/' };
const sectionName = SECTION_META[section][lang];

const ldJson = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: heading,
    url: `https://lenooai.com${selfPath}`,
    inLanguage: ar ? 'ar' : 'en-AE',
    publisher: { '@type': 'Organization', name: 'Lenoo AI', url: 'https://lenooai.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: home.name, item: `https://lenooai.com${home.path}` },
      { '@type': 'ListItem', position: 2, name: sectionName, item: `https://lenooai.com${selfPath}` },
    ],
  },
];

const Layout = ar ? ArBaseLayout : BaseLayout;
const layoutProps = ar
  ? { title, description, canonicalPath: selfPath, enPath: hasTwin ? `/${section}` : null, ogImage: '/assets/og-blog.jpg', ldJson }
  : { title, description, canonicalPath: selfPath, arPath: hasTwin ? `/ar/${section}` : null, ogImage: '/assets/og-blog.jpg', ldJson };
---

<Layout {...layoutProps}>
  <PageHero image={heroImage}>
    <div class="crumb" aria-label={ar ? 'مسار التنقل' : 'Breadcrumb'}>
      <a href={home.path}>{home.name}</a><span class="crumb-sep"> / </span>{sectionName}
    </div>
    <h1>{heading}</h1>
    <p class="hub-intro">{intro}</p>
  </PageHero>

  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <div class="hub-grid">
        {cards.map((c) => (
          <article class="hub-card">
            {c.image ? (
              <div class="hub-card-media">
                <img src={c.image} alt={c.imageAlt} loading="lazy" decoding="async" width="1200" height="630" />
              </div>
            ) : (
              <div class="hub-card-placeholder" aria-hidden="true"></div>
            )}
            <div class="hub-card-body">
              <div class="hub-card-meta">
                <span class="hub-tag">{c.category}</span>
                {c.date && (
                  <span class="hub-date">
                    {c.date.toLocaleDateString(ar ? 'ar-AE' : 'en-AE', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                )}
              </div>
              <h2 class="hub-card-title"><a href={c.href}>{c.title}</a></h2>
              {c.excerpt && <p class="hub-card-excerpt">{c.excerpt}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.crumb {
  display:inline-flex; align-items:center; gap:4px;
  background:rgba(0,227,253,0.12); border:1px solid rgba(0,227,253,0.28); border-radius:100px;
  padding:6px 16px; color:#a8f2ff; font-size:0.875rem; font-weight:600; margin-bottom:1.5rem;
}
.crumb a { color:inherit; text-decoration:none; opacity:0.65; }
.crumb-sep { opacity:0.4; padding:0 4px; }
.hub-intro { color:rgba(255,255,255,0.72); font-size:1.0625rem; max-width:560px; margin:1rem auto 0; }
.hub-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:28px; }
.hub-card {
  background:#fff; border:1px solid rgba(0,37,59,0.08); border-radius:var(--radius-lg);
  overflow:hidden; display:flex; flex-direction:column; box-shadow:var(--shadow-card);
  transition:transform .3s var(--ease), box-shadow .3s var(--ease);
}
.hub-card:hover { transform:translateY(-5px); box-shadow:var(--shadow-card-hover); }
.hub-card-media { height:200px; overflow:hidden; }
.hub-card-media img { width:100%; height:100%; object-fit:cover; display:block; }
.hub-card-placeholder { height:200px; background:linear-gradient(135deg,#e7eeff,#f0f8ff); }
.hub-card-body { padding:1.625rem 1.625rem 1.5rem; flex:1; display:flex; flex-direction:column; }
.hub-card-meta { margin-bottom:0.875rem; display:flex; align-items:center; gap:8px; justify-content:space-between; }
.hub-tag {
  display:inline-flex; padding:3px 12px; border-radius:100px; font-size:0.75rem; font-weight:600;
  background:rgba(0,104,117,0.10); color:#004f58; border:1px solid rgba(0,104,117,0.20);
}
.hub-date { font-size:0.75rem; color:#72787e; font-variant-numeric:tabular-nums; }
.hub-card-title { font-size:1.0625rem; font-weight:700; color:#00253b; margin-bottom:0.625rem; line-height:1.42; }
.hub-card-title a { color:inherit; text-decoration:none; }
.hub-card-title a:hover { color:#006875; }
.hub-card-excerpt { color:#72787e; font-size:0.875rem; line-height:1.65; margin:0; }
</style>
