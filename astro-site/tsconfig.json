{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": [
    "coverage",
    "node_modules",
    "dist",
    // Underscore-prefixed, so Astro's router already ignores it as dead code —
    // not part of the build. Its imports point at paths that no longer exist,
    // which is why it's archived rather than fixed.
    "src/_archived-pages"
  ]
}
